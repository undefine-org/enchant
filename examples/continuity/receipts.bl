;; Business storage code is part of EACH sealed candidate's dependency graph.
(ns continuity.receipts (:require [datom :as d] [datom.conn :as conn] [datom.query.read-only :as observation]))
(def schema
 [{:db/ident :order/id :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :order/cents :db/valueType :db.type/long}
  {:db/ident :receipt/reference :db/valueType :db.type/string}])
(defn totals [c]
 (let [rows (d/q '[:find ?id ?cents :where [?e :order/id ?id] [?e :order/cents ?cents]] (d/db c))]
  {:orders (count rows) :cents (reduce + 0 (map second rows))}))
(defn record! [c id cents]
 (conn/serialized! c
  (fn []
   (let [prior (d/q '[:find ?cents :in $ ?id :where [?e :order/id ?id] [?e :order/cents ?cents]] (d/db c) id)]
    (when (and (seq prior) (not= cents (first (first prior))))
     (throw (ex-info "Order identity conflict" {:kind :order-identity-conflict})))
    (when (empty? prior)
     (d/transact! c [(cond-> {:db/id -1 :order/id id :order/cents cents}
                       (contains? (d/schema c) :order/currency) (assoc :order/currency "USD"))]))
    (totals c)))))

(defn recover-state [s]
 ;; The fixed SDK reader validates a literal stored-data plan and actual live
 ;; native Conn/Db, then executes under an empty closed query vocabulary.
 ;; No snapshot rewind, callback query or caller-nominated provider is used.
 (let [rows (observation/read! '[:find (count ?id) (sum ?cents) :with ?id
                                :where [?e :order/id ?id] [?e :order/cents ?cents]]
                              (maps/get :store s nil))
       row (or (first rows) [0 0])]
  (maps/put :orders (nth row 0) (maps/put :gross-cents (nth row 1) s))))
