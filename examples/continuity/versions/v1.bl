(ns continuity.orders (:require [proc.evolve :as evolve] [continuity.receipts :as receipts]))
(defn finish-job [job] {:id (:demo/id job) :version 1})
(defn job-handler [] finish-job)
(defn accepts [m]
 (and (vector? m) (= 3 (count m)) (= :order (first m))
      (erlang/is_binary (nth m 1)) (erlang/is_integer (nth m 2)) (> (nth m 2) 0)))
(defn check-state [s]
 (and (erlang/is_map s) (maps/get :store s nil)
      (erlang/is_integer (maps/get :orders s nil)) (erlang/is_integer (maps/get :cents s nil))
      (>= (maps/get :cents s nil) 0)))
(defn check-reply [r] (erlang/is_integer r))
(defn handler [m s]
 (let [t (receipts/record! (maps/get :store s nil) (nth m 1) (nth m 2))]
  {:reply (:orders t) :state (maps/put :orders (:orders t) (maps/put :cents (:cents t) s))}))
(defn definition [digest]
 (evolve/prepare-spec {:version 1 :digest digest :accept? accepts :check-state check-state
                      :check-reply check-reply :handler handler}))
