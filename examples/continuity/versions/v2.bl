(ns continuity.orders (:require [proc.evolve :as evolve] [continuity.receipts :as receipts]))
(defn finish-job [job] {:id (:demo/id job) :version 2})
(defn job-handler [] finish-job)
(defn accepts [m]
 (and (erlang/is_map m)
      (or (= :inspect (maps/get :op m nil))
          (and (= :order (maps/get :op m nil)) (erlang/is_binary (maps/get :id m nil))
               (erlang/is_integer (maps/get :cents m nil)) (> (maps/get :cents m nil) 0)))))
(defn check-state [s]
 (and (erlang/is_map s) (maps/get :store s nil)
      (erlang/is_integer (maps/get :orders s nil)) (erlang/is_integer (maps/get :gross-cents s nil))
      (>= (maps/get :gross-cents s nil) 0) (= "USD" (maps/get :currency s nil))))
(defn check-reply [r]
 (and (erlang/is_map r) (erlang/is_integer (maps/get :orders r nil))
      (erlang/is_integer (maps/get :gross-cents r nil))))
(defn migrate-state [s]
 (maps/put :currency "USD" (maps/put :gross-cents (maps/get :cents s nil) (maps/remove :cents s))))
(defn upcast [m] {:op :order :id (nth m 1) :cents (nth m 2)})
(defn downcast [r] (maps/get :orders r nil))
(defn handler [m s]
 (if (= :inspect (maps/get :op m nil))
  {:reply {:orders (maps/get :orders s nil) :gross-cents (maps/get :gross-cents s nil)} :state s}
  (let [t (receipts/record! (maps/get :store s nil) (maps/get :id m nil) (maps/get :cents m nil))
        next (maps/put :orders (:orders t) (maps/put :gross-cents (:cents t) s))]
   {:reply {:orders (:orders t) :gross-cents (:cents t)} :state next})))
(defn spec [digest]
 {:version 2 :digest digest :accept? accepts :check-state check-state :check-reply check-reply
                      :migrate-state migrate-state :upcast upcast :downcast downcast :handler handler})
(defn definition [digest] (evolve/prepare-spec (spec digest)))
(defn wrong-upcast [_] {:op :order :cents "wrong"})
(defn wrong-state [s] (maps/put :orders -1 (maps/put :gross-cents "wrong" s)))
(defn definition-with-fault [digest kind]
 (evolve/prepare-spec (assoc (spec digest) (case kind :message :upcast :state :migrate-state)
                                (case kind :message wrong-upcast :state wrong-state))))
