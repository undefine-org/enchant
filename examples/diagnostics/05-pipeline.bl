(ns examples.diagnostics.pipeline
  (:require [diagnostics :as diag] [proc.pipeline :as pipeline]))
(def observed (atom []))
(def completed (atom []))
(def topology
  (diag/with-options {:sink #(swap! observed conj %)}
    (pipeline/arm-first
      (pipeline/spec :example-diagnostics :block :fail
        [(pipeline/from-node 1 [1 2 3])
         (pipeline/stage-node 2 :check
           (fn [n]
             (if (= 3 n) (throw (ex-info "private fixture" {:kind :transport}))
               (do (swap! completed conj n) n))) 1)]))))
(try
  (loop [remaining 200]
    (when (and (> remaining 0)
               (not (some #(= :proc.pipeline/failed (:diagnostics/event %)) @observed)))
      (Process/sleep 5) (recur (dec remaining))))
  (let [failure (first (filter #(= :proc.pipeline/failed (:diagnostics/event %)) @observed))]
    (assert (= [1 2] @completed))
    (assert (= :proc.pipeline/failed (:diagnostics/event failure)))
    (assert (not (String/contains? (pr-str @observed) "private fixture")))
    {:completed @completed :failure (:diagnostics/error-kind failure)})
  (finally (pipeline/stop-topology topology)))
