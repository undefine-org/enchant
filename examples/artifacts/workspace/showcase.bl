;; Run from this project's root. Normal discovery reads env.bl, with no native
;; backend flags or workspace parameters passed to the build command.
(ns artifacts.workspace-demo (:require [build :as build]))
(let [root (BeamLisp/cwd)
      expected (String/to_integer (or (System/get_env "BL_WORKSPACE_EXPECTED") "42"))
      prepared (build/build-native root println)]
  (when (seq (:errors prepared))
    (throw (ex-info "Workspace showcase preparation failed" prepared)))
  (BeamLisp.Env/add_search_path root)
  (BeamLisp.Env/add_search_path (Path/join root "src"))
  (BeamLisp.Loader/ensure_loaded "artifact.workspace")
  (let [answer ((BeamLisp.Env/fetch_exact! "artifact.workspace" "answer"))
        message ((BeamLisp.Env/fetch_exact! "artifact.workspace" "support-message"))
        selected (File/read_link! (Path/join root "priv/native/workspace_demo.so"))]
    (assert (= expected answer))
    (println (Jason/encode! {"answer" answer "supportMessage" message
                           "library" selected "crate" "workspace_demo"
                           "package" "artifact-workspace-engine"
                           "cargoLibrary" "workspace_engine_nif"}))))
