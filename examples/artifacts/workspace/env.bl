{:name "artifact-workspace-showcase"
 :paths ["src"]
 :tasks {:showcase {:run "showcase.bl"
                    :doc "build a declared Cargo workspace and call its aliased NIF"}}
 :build {:paths ["src"]
         :native [{:source "rust"
                   :member "crates/engine"
                   :package "artifact-workspace-engine"
                   :crate "workspace_demo"
                   :abi "beam-lisp-native-workspace-demo-v1"}]}}
