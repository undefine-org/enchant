;; Prepare a real NIF with Nix, select its immutable bytes, then call it.
(ns artifacts.demo (:require [build :as build] [artifact :as artifact]))
(let [platform (System/fetch_env! "BL_ARTIFACT_PLATFORM")
      source-root (or (System/get_env "BL_ARTIFACT_SOURCE_ROOT") (BeamLisp/cwd))
      root (if (File/regular? (Path/join source-root "native/artifact_demo/Cargo.toml"))
             source-root (Path/join source-root "examples/artifacts"))
      previous (System/get_env "BL_NATIVE_PROVIDER")]
  (try
    (System/put_env "BL_NATIVE_PROVIDER" "nix")
    (let [prepared (build/build-native-crate root "artifact_demo" println)]
      (when (seq (:errors prepared)) (throw (ex-info "Showcase preparation failed" prepared)))
      (BeamLisp.Env/add_search_path root)
      (BeamLisp.Env/add_search_path (Path/join root "src"))
      (BeamLisp.Loader/ensure_loaded "artifact.showcase")
      (let [answer ((BeamLisp.Env/fetch_exact! "artifact.showcase" "answer"))
            selected (File/read_link! (Path/join root "priv/native/artifact_demo.so"))]
        (assert (= 42 answer))
        (println (Jason/encode! {"answer" answer "library" selected "provider" "nix"}))))
    (finally (if previous (System/put_env "BL_NATIVE_PROVIDER" previous) (System/delete_env "BL_NATIVE_PROVIDER")))))
