(ns scene-demo.metamorphosis-build
  (:require [scene-demo.metamorphosis :as art] [scene.core :as scene] [interop]))
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(def sources ["examples/scene-renderer/metamorphosis.bl" "examples/scene-renderer/scene_demo/metamorphosis.bl"
              "examples/scene-renderer/motion_worker.py" "examples/scene-renderer/camera_worker.py"
              "examples/scene-renderer/raster.py" "priv/lib/scene/text_worker.py" "priv/lib/scene/text.bl"
              "priv/lib/scene/geometry.bl" "priv/lib/scene/camera.bl" "priv/lib/scene/choreo.bl"
              "priv/lib/scene/core.bl" "priv/lib/scene/material.bl" "priv/lib/scene/atelier.bl" "priv/lib/live/hiccup.bl"])
(defn command! [program args]
  (let [result (System/cmd program (to-list args) (list (tuple :stderr_to_stdout true)))]
    (when (not= 0 (erlang/element 2 result)) (scene/fail "Metamorphosis graphics failed" {:output (erlang/element 1 result)}))
    (erlang/element 1 result)))
(let [args (clojure.io/current-command-line-args) out (Path/expand (or (first args) "/tmp/bl-metamorphosis"))
      mode (or (second args) "review")
      _ (when (not (contains? #{"review" "film"} mode)) (scene/fail "Choose review or film" {}))
      captured (mapv (fn [p] [p (File/read! p)]) sources)
      fonts (mapv (fn [p] [p (File/read! (str "examples/scene-renderer/assets/fonts/" p))])
                  ["DMSans.ttf" "InstrumentSerif-Regular.ttf" "InstrumentSerif-Italic.ttf" "PatrickHand-Regular.ttf"
                   "DMSans-OFL.txt" "InstrumentSerif-OFL.txt" "PatrickHand-OFL.txt"])
      rsvg (or (System/get_env "SCENE_RSVG") "rsvg-convert")
      identity {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                :fonts (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) fonts)
                :backend (String/trim (command! rsvg ["--version"])) :mode mode
                :quality "cached native vector paths / world-local paper / opaque 1080p BGRA"}
      revision (digest (interop/->json identity)) final-dir (str out "/" revision)
      dir (str out "/.pending-" revision "-" (System/pid))]
  (when (not (File/dir? final-dir))
    (File/mkdir_p! (str dir "/font")) (File/mkdir_p! (str dir "/sources"))
    (doseq [[p bytes] fonts] (File/write! (str dir "/font/" p) bytes))
    (doseq [[p bytes] captured] (File/write! (str dir "/sources/" (replace-str p "/" "__")) bytes))
    (let [prepared (art/prepare {:font-dir (str dir "/font") :worker (str dir "/sources/priv__lib__scene__text_worker.py")})
          plan {:version 1 :viewport [1920 1080] :fps [24 1] :duration 48 :assets (:assets prepared)
                :frames (mapv (fn [k] (assoc (art/frame prepared (scene/frame-time k 24 1)) :frame k)) (range 1152))}]
      (File/write! (str dir "/motion.json") (interop/->json plan))
      (File/write! (str dir "/paper.svg") (scene/svg (art/paper)))
      (File/write! (str dir "/provenance.json")
        (interop/->json (assoc identity :shaping (:shaping prepared) :camera-track art/camera-track
                              :formation-identities (mapv :id (:nodes art/bloom))
                              :motion "persistent identities; geometry and attachment morphs; semantic camera following; no slide panels or entrance/exit opacity"
                              :capture "startup environment; existing load-before-capture qualification remains")))
      (when (not= (art/frame prepared 23) (last (mapv (fn [t] (art/frame prepared t)) [47 0 36 12 23])))
        (scene/fail "Transformation depends on seek history" {})))
    (command! "python3" (into [(str dir "/sources/examples__scene-renderer__motion_worker.py") dir
                              "--rsvg" rsvg "--camera-worker" (str dir "/sources/examples__scene-renderer__camera_worker.py")
                              "--text-worker" (str dir "/sources/priv__lib__scene__text_worker.py")
                              "--raster-worker" (str dir "/sources/examples__scene-renderer__raster.py")]
                             (if (= mode "film") ["--film"] [])))
    (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources))
      (scene/fail "Sources changed during transformation render; publication held" {}))
    (File/rename! dir final-dir))
  (when (= mode "film")
    (File/cp! (str final-dir "/experience.mp4") (str out "/.experience.mp4.tmp"))
    (File/rename! (str out "/.experience.mp4.tmp") (str out "/experience.mp4")))
  (File/write! (str out "/manifest.json.tmp")
    (interop/->json {:revision revision :frames 1152 :fps [24 1] :duration 48 :width 1920 :height 1080
                    :mode mode :selected [0 168 360 552 720 864 1128] :quality (:quality identity)}))
  (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
  (println (str "Published " mode " / continuous metamorphosis: " final-dir)))
