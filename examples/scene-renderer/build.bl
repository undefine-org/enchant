(ns scene-demo.build (:require [scene.core :as s] [scene-demo.film :as film] [interop]))
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(defn command! [program args]
  (let [result (System/cmd program (to-list args))]
    (when (not= 0 (erlang/element 2 result))
      (s/fail "Scene worker failed" {:program program :output (erlang/element 1 result)}))
    (erlang/element 1 result)))
(def sources ["examples/scene-renderer/scene_demo/film.bl" "priv/lib/scene/core.bl"
              "priv/lib/scene/material.bl" "priv/lib/live/hiccup.bl" "examples/scene-renderer/build.bl"
              "examples/scene-renderer/raster.py" "examples/scene-renderer/preview.html"])
(defn -main [& args]
  (let [out (Path/expand (or (first args) "/tmp/bl-scene"))
        captured (mapv (fn [p] [p (File/read! p)]) sources)
        font-path (String/trim (command! "fc-match" ["-f" "%{file}" "DejaVu Sans"]))
        font (File/read! font-path)
        rsvg (or (System/get_env "SCENE_RSVG") "rsvg-convert")
        backend (String/trim (command! rsvg ["--version"]))
        revision (digest (str (pr-str captured) (digest font) backend))
        final-dir (str out "/" revision)
        dir (str out "/.pending-" revision "-" (System/pid))
        fps 30
        count (* film/duration fps)]
    (when (not (File/dir? final-dir))
    (File/mkdir_p! (str dir "/font"))
    (File/write! (str dir "/font/DejaVuSans.ttf") font)
    (File/write! (str dir "/sources.edn") (pr-str captured))
    (File/write! (str dir "/provenance.json")
      (interop/->json {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                      :font {:path font-path :sha256 (digest font)} :backend backend
                      :runtime (System/version) :alpha "SVG straight alpha; opaque sRGB PNG frames"}))
    (doseq [k (range count)]
      (File/write! (str dir "/" k ".svg") (s/svg (film/scene (s/frame-time k fps 1)))))
    (File/write! (str dir "/scene.json") (interop/->json (film/scene 1)))
    (command! "python3" ["examples/scene-renderer/raster.py" "raster" dir "--count" (str count)
                         "--font" (str dir "/font/DejaVuSans.ttf") "--rsvg" rsvg])
    (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources))
      (s/fail "Source changed during build; retaining previous revision, rebuild required" {}))
    (File/rename! dir final-dir))
    (File/write! (str out "/index.html") (File/read! "examples/scene-renderer/preview.html"))
    (File/write! (str out "/manifest.json.tmp")
      (interop/->json {:version 1 :revision revision :width 800 :height 450 :fps [fps 1]
                      :frames count :duration film/duration :backend backend :seed 0
                      :scenes [0 120 240]}))
    (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
    (println (str "Published " count " canonical PNG + SVG frames: " final-dir))))
(apply -main (clojure.io/current-command-line-args))
