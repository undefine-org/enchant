(ns scene-demo.hello-build
 (:require [scene-demo.hello :as art] [scene-demo.frame-plan :as frame-plan] [scene.core :as scene] [interop]))
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(def sources ["examples/scene-renderer/hello.bl" "examples/scene-renderer/scene_demo/hello.bl"
 "examples/scene-renderer/hello_worker.py" "examples/scene-renderer/showcase_worker.py"
 "examples/scene-renderer/frame_plan.py" "examples/scene-renderer/scene_demo/frame_plan.bl"
 "examples/scene-renderer/hello/flat.vert" "examples/scene-renderer/hello/base.frag"
 "examples/scene-renderer/hello/seed.vert" "examples/scene-renderer/hello/seed.frag"
 "priv/lib/scene/core.bl" "priv/lib/scene/geometry.bl" "priv/lib/scene/text.bl" "priv/lib/scene/text_worker.py"
 "priv/lib/scene/score.bl" "priv/lib/scene/camera.bl" "priv/lib/scene/choreo.bl" "priv/lib/live/hiccup.bl"])
(let [args (clojure.io/current-command-line-args) out (Path/expand (or (first args) "/tmp/bl-hello-film"))
      selection (frame-plan/selection args 3600 [0 120 360 660 990 1260 1560 1800 1860 1980 2100 2430 2520 2610 2850 3150 3420 3599])
      captured (mapv (fn [p] [p (File/read! p)]) sources)
      names ["DMSans.ttf" "InstrumentSerif-Regular.ttf" "InstrumentSerif-Italic.ttf" "PatrickHand-Regular.ttf"
             "DMSans-OFL.txt" "InstrumentSerif-OFL.txt" "PatrickHand-OFL.txt"]
      fonts (mapv (fn [name] [name (File/read! (str "examples/scene-renderer/assets/fonts/" name))]) names)
      identity {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                :fonts (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) fonts)
                :clock [3600 60 1] :selection selection :seed 7331 :font "DM Sans" :kind "authored product narrative / reconstructed concept interface"}
      revision (digest (interop/->json identity)) dir (str out "/" revision)]
 (File/mkdir_p! (str dir "/sources")) (File/mkdir_p! (str dir "/font")) (File/mkdir_p! (str dir "/shaders"))
 (doseq [[p bytes] captured]
  (File/write! (str dir "/sources/" (replace-str p "/" "__")) bytes)
  (when (= (Path/basename p) "frame_plan.py") (File/write! (str dir "/sources/frame_plan.py") bytes))
  (when (or (String/ends_with? p ".vert") (String/ends_with? p ".frag")) (File/write! (str dir "/shaders/" (Path/basename p)) bytes)))
 (doseq [[p bytes] fonts] (File/write! (str dir "/font/" p) bytes))
 (let [prepared (art/prepare {:font-dir (str dir "/font") :worker (str dir "/sources/priv__lib__scene__text_worker.py")})
       base {:version (if (= "film" (:mode selection)) 1 2) :viewport [1920 1080] :fps [60 1] :duration 60 :assets (:assets prepared)
             :audio (art/soundtrack) :frames (mapv (fn [k] (assoc (art/frame prepared (/ k 60)) :frame k)) (:indices selection))}
       plan (if (= "film" (:mode selection)) base (assoc base :selection (:indices selection)))]
  (when (not= (art/frame prepared 32.8) (last (mapv (fn [t] (art/frame prepared t)) [59 0 43 12 32.8])))
   (scene/fail "Hello scene has seek history" {}))
  (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources)) (scene/fail "Sources changed during capture" {}))
  (File/write! (str dir "/plan.json.tmp") (interop/->json plan)) (File/rename! (str dir "/plan.json.tmp") (str dir "/plan.json"))
  (File/write! (str dir "/provenance.json") (interop/->json (assoc identity :revision revision :shaping (:shaping prepared)
   :capture "Explicit leaf/source/font capture; existing load-before-capture qualification; external native libraries remain backend dependencies"
   :interface "Cinematic reconstruction labeled Interface concept. No shipping source editor, direct manipulation, universal material UI or generic export claim.")))
  (File/write! (str out "/manifest.json.tmp") (interop/->json {:revision revision :directory dir :frames 3600 :captured-frames (count (:indices selection)) :mode (:mode selection) :fps [60 1] :duration 60 :font "DM Sans"}))
  (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
  (println (str "Captured Hello world narrative: " dir))))
