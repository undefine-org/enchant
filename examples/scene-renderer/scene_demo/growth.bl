(ns scene-demo.growth
  (:require [scene.core :as s] [scene.clip :as clip] [scene.motion :as motion]
            [scene.atelier :as a] [scene.material :as m] [scene.geometry :as g] [scene.text :as text]))

(def duration 12)
(def forest "#173f36")
(def sage "#b8c99a")
(def rose "#de795d")
(def schedule
  (clip/schedule
    (clip/parallel {:id "growth" :cues {"diagram" 2 "detail" 6 "settle" 10}}
      [(clip/clip {:id "plate" :duration 12} :plate)
       (clip/delay {:id "germination" :by 2}
         (clip/retime {:id "unfold" :duration 7.5}
           (clip/clip {:id "plant" :duration 6 :cues {"branch" 1 "flower" 4.5}} :plant)))
       (clip/delay {:id "closing" :by 9.5}
         (clip/clip {:id "hold" :duration 2.5} :closing))])))

(def specimens
  [{:id "masthead" :text "FIELD NOTES   /   BOTANICAL MOTION" :family "DM Sans" :size 14}
   {:id "edition" :text "NO. 002   /   BEAM LISP" :family "DM Sans" :size 13}
   {:id "title" :text "Every idea" :family "Instrument Serif" :size 110}
   {:id "title-italic" :text "wants to grow." :family "Instrument Serif" :size 110 :italic true}
   {:id "deck" :text "A study in branching, rhythm, and a little wildness." :family "DM Sans" :size 19}
   {:id "note-seed" :text "one small beginning" :family "Patrick Hand" :size 27}
   {:id "note-branch" :text "room to branch" :family "Patrick Hand" :size 29}
   {:id "note-flower" :text "a little wildness" :family "Patrick Hand" :size 29}
   {:id "figure" :text "FIG. 02  /  AN IDEA IS A LIVING STRUCTURE" :family "DM Sans" :size 12}
   {:id "closing" :text "Compose the conditions. Let it unfold." :family "Instrument Serif" :size 40}
   {:id "footer" :text "GEOMETRY · MATERIAL · LOCAL CLOCKS     /     AUTHORED IN LISP" :family "DM Sans" :size 12}])
(defn prepare [opts]
  (let [shaped (text/measure! specimens opts)]
    {:runs (into {} (mapv (fn [[id run]] [id (assoc run :path (g/path-data (:commands run)))]) (:runs shaped)))
     :shaping (dissoc shaped :runs)}))
(defn type-at [prepared id x baseline color]
  (let [run (get (:runs prepared) id)]
    (a/shape id :path {:d (:path run) :fill color
                       :transform (g/svg-transform (g/translate x (- baseline (:baseline run))))})))
(defn progress [t at d] (motion/tween {:at at :duration d} t))
(defn draw
  "Conservative dash reveal: budget must exceed this authored path's length.
   This is not a general measured path-trimming API."
  [id path budget p attrs]
  (a/ink-line id path (merge {:stroke-dasharray (str budget " " budget)
                             :stroke-dashoffset (* budget (- 1 p)) :opacity (if (> p 0) 1 0)} attrs)))
(defn leaf [id x y angle length width p color]
  (let [path (str "M 0 0 C " (- 0 width) " " (- 0 (* length 0.38)) " " (- 0 width)
                  " " (- 0 (* length 0.8)) " 0 " (- 0 length)
                  " C " width " " (- 0 (* length 0.8)) " " width " " (- 0 (* length 0.38)) " 0 0 Z")]
    (a/group id {:opacity p :transform (str "translate(" x " " y ") rotate(" angle ") scale(" p ")")}
      [(a/shape (str id "/stock") :path {:d path :fill color :stroke forest :stroke-width 1.8})
       (a/shape (str id "/hatch") :path {:d path :fill (m/ref "leaf-hatch") :opacity 0.23})
       (a/ink-line (str id "/vein") (str "M 0 0 Q 4 " (- 0 (* length 0.5)) " 0 " (- 0 (* length 0.91)))
                   {:stroke forest :stroke-width 1.2})])))
(def branches
  [{:id "west-low" :path "M 541 805 Q 489 771 435 704" :at 0.7 :x 435 :y 704 :angle -56 :length 124 :width 36 :color sage}
   {:id "east-low" :path "M 544 768 Q 601 737 645 678" :at 1.1 :x 645 :y 678 :angle 58 :length 135 :width 38 :color "#d8dca6"}
   {:id "west-mid" :path "M 543 712 Q 493 681 475 627" :at 1.65 :x 475 :y 627 :angle -58 :length 117 :width 31 :color "#e4b657"}
   {:id "east-mid" :path "M 545 659 Q 594 631 614 580" :at 2.2 :x 614 :y 580 :angle 55 :length 126 :width 33 :color sage}
   {:id "west-high" :path "M 544 608 Q 513 582 500 539" :at 2.8 :x 500 :y 539 :angle -39 :length 104 :width 28 :color "#d8dca6"}
   {:id "east-high" :path "M 543 562 Q 578 535 584 505" :at 3.2 :x 584 :y 505 :angle 42 :length 95 :width 27 :color "#e4b657"}])
(defn flower [t]
  (let [p (progress t 4.2 1.1)]
    (a/group "plant/flower" {:opacity p :transform (str "translate(540 447) scale(" p ") rotate(" (* 16 (- 1 p)) ")")}
      (into (mapv (fn [i]
                    (a/shape (str "plant/flower/petal-" i) :ellipse
                      {:cx 0 :cy -23 :rx 12 :ry 29 :fill rose :stroke forest :stroke-width 1.2
                       :transform (str "rotate(" (* i 45) ")")})) (range 8))
            [(a/disc "plant/flower/heart" 0 0 18 a/yellow)
             (a/shape "plant/flower/pollen" :circle {:cx 0 :cy 0 :r 15 :fill (m/ref "dots")})]))))
(defn plant [t]
  (a/group "plant" {}
    (into [(draw "plant/stem" "M 540 838 C 548 729 541 567 540 447" 430 (progress t 0 3.5)
                  {:stroke "#dfdcb5" :stroke-width 5})]
      (into (vec (mapcat (fn [b]
               [(draw (str "plant/" (:id b) "/stem") (:path b) 180 (progress t (:at b) 0.65)
                      {:stroke "#dfdcb5" :stroke-width 2.5})
                (leaf (str "plant/" (:id b) "/leaf") (:x b) (:y b) (:angle b) (:length b) (:width b)
                      (progress t (+ (:at b) 0.3) 0.9) (:color b))]) branches))
            [(flower t)]))))
(defn scene [prepared t]
  (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Growth time outside [0,12)" {:time t}))
  (let [active (clip/sample schedule t)
        growing (first (filter (fn [v] (= :plant (:content v))) active))
        plant-time (if growing (:local-time growing) (if (>= t 9.5) 6 0))
        camera (+ 0.83 (* 0.17 (progress t 2 3)) (* 0.12 (progress t 6 2)) (* -0.12 (progress t 9 1.5)))
        reveal (s/lerp 0 850 (progress t 0.5 1.5))
        intro (progress t 0 0.7) diagram (progress t 2.8 0.8) detail (progress t 6 0.8)
        closing (progress t 9.5 0.8)]
    {:width 1080 :height 1080 :time t :scene "a-seed-of-possibility" :seed 73
     :materials [(m/paper "grain" 73) (m/halftone "dots" 5 0.9 forest)
                 (m/hatch "leaf-hatch" 6 forest) (m/grid "grid" 36 "#a7bfa4")]
     :clips [(a/paper "viewport" 56 350 968 590 "white")
             (a/disc "iris" 540 700 reveal "white")]
     :objects
     [(a/paper "stock" 0 0 1080 1080 a/cream)
      (type-at prepared "masthead" 56 52 a/ink)
      (type-at prepared "edition" 801 52 a/ink)
      (a/ink-line "top-rule" "M 56 75 L 1024 75" {:stroke-width 1 :opacity 0.6})
      (a/group "heading" {:opacity intro :transform (str "translate(0 " (* 16 (- 1 intro)) ")")}
        [(type-at prepared "title" 52 178 a/ink)
         (type-at prepared "title-italic" 52 281 forest)
         (type-at prepared "deck" 57 323 "#666453")])
      (a/paper "hero-shadow" 63 358 968 590 "#cfc8b1")
      (a/group "hero" {:clip-path "url(#viewport-clip)"}
        [(a/paper "hero-paper" 56 350 968 590 "#d9ddba")
         (a/group "field-reveal" {:clip-path "url(#iris-clip)"}
           [(a/paper "field" 56 350 968 590 forest)
            (a/shape "field-grid" :rect {:x 56 :y 350 :width 968 :height 590 :fill (m/ref "grid") :opacity 0.12})
            (a/disc "sun" 842 450 143 "#d6b95d")
            (a/shape "sun-halftone" :circle {:cx 842 :cy 450 :r 143 :fill (m/ref "dots") :opacity 0.65})
            (a/disc "sun-clear" 842 450 110 "#d6b95d")
            (a/group "camera" {:transform (str "translate(540 730) scale(" camera ") translate(-540 -730)")}
              [(a/shape "orbit" :ellipse {:cx 540 :cy 730 :rx 264 :ry 150 :fill "none"
                       :stroke "#a9b99b" :stroke-width 1 :stroke-dasharray "3 8" :opacity 0.4})
               (a/ink-line "ground" "M 340 856 Q 540 847 735 856" {:stroke "#819776" :stroke-width 1})
               (plant plant-time)
               (a/shape "seed" :ellipse {:cx 540 :cy 838 :rx 14 :ry 20 :fill rose
                                         :stroke a/cream :stroke-width 1.5 :transform "rotate(25 540 838)"})])
            (a/group "seed-note" {:opacity diagram}
              [(type-at prepared "note-seed" 97 738 a/cream)
               (draw "seed-leader" "M 186 755 Q 249 843 479 838" 360 diagram {:stroke a/cream :stroke-width 1.3})])
            (a/group "branch-note" {:opacity detail}
              [(type-at prepared "note-branch" 792 650 a/cream)
               (draw "branch-leader" "M 847 668 Q 832 710 750 695" 200 detail {:stroke a/cream :stroke-width 1.3})])
            (a/group "flower-note" {:opacity closing}
              [(type-at prepared "note-flower" 115 447 a/cream)
               (draw "flower-leader" "M 281 454 Q 355 427 469 449" 250 closing {:stroke a/yellow :stroke-width 1.4})])
            (type-at prepared "figure" 80 916 a/cream)
            (a/texture "field-grain" 56 350 968 590 "grain")])])
      (a/group "closing-line" {:opacity closing}
        [(type-at prepared "closing" 56 995 forest)])
      (a/ink-line "bottom-rule" "M 56 1021 L 1024 1021" {:stroke-width 1 :opacity 0.6})
      (type-at prepared "footer" 56 1048 a/ink)
      (a/texture "stock-grain" 0 0 1080 1080 "grain")]}))
