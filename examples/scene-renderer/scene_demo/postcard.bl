(ns scene-demo.postcard
  (:require [scene.core :as s] [scene.atelier :as a] [scene.material :as material]
            [scene.geometry :as geo] [scene.layout :as layout] [scene.text :as text]
            [scene.motion :as motion] [scene.inspect :as inspect] [scene.styles.editorial :as art]))
(def duration 6)
(def defaults
  {:title "A little world of your own."
   :subtitle "A living postcard, composed from ordinary Lisp values."
   :theme :warm :seed 41 :cue 0.65 :step 0.18
   :cards [{:id :compose :title "Compose the idea."
            :body "A thought becomes a small set of values. Give each one a name."}
           {:id :evaluate :title "Let the picture follow."
            :body "Change the words. The paper grows, the ink follows, and the connections stay attached."}
           {:id :see :title "Make something worth seeing."
            :body "Choose a material, find a rhythm, and make the little world your own."}]})
(defn concept-card [{:keys [id title body]}]
  (art/cutout {:id id :padding 24 :grain "paper-grain"}
    (layout/column {:gap 7}
      [(text/block {:id :kicker :role :label} (str "STUDY / " (String/upcase (layout/id-part id))))
       (text/paragraph {:id :title :role :heading} title)
       (text/paragraph {:id :body :role :body} body)])))
(defn authored [config]
  (layout/column {:id :postcard :width 884 :gap 25 :max-height 880}
    [(text/paragraph {:id :heading :role :display} (:title config))
     (text/paragraph {:id :subtitle :role :body} (:subtitle config))
     (layout/column {:id :cards :gap 22}
       (vec (map-indexed (fn [i item]
         (motion/enter {:cue :explanation :delay (* i (:step config)) :duration 0.6 :effect :rise}
                       (concept-card item))) (:cards config))))]))
(defn prepare
  "One batch shapes text once. The returned immutable value can be sampled at
   arbitrary times; preview/export never need preceding frames."
  ([config] (prepare config {}))
  ([config opts]
   (let [config (merge defaults config)
         theme (if (= :blueprint (:theme config)) art/blueprint art/warm)
         root (authored config)
         requests (layout/requests root 884 theme)
         shape-key (select-keys config [:title :subtitle :theme :cards])
         previous (:previous opts)
         shaped (if (= shape-key (:shape-key previous)) (:shaped previous)
                   (text/measure! requests (merge {:font-dir "examples/scene-renderer/assets/fonts"} opts)))
         base (layout/place (layout/evaluate root 884 theme (:runs shaped)) 94 118)]
     {:config config :theme theme :base base :shape-key shape-key :shaped shaped :shaping (dissoc shaped :runs)})))
(defn links [index config color]
  (vec (map-indexed (fn [i pair]
    (let [from (:east (:anchors (inspect/object index ["postcard" "cards" (:id (first pair))])))
          to (:east (:anchors (inspect/object index ["postcard" "cards" (:id (second pair))])))
          [x1 y1] from [x2 y2] to bend 1010]
      (a/ink-line (str "$link-" i)
        (str "M " (+ x1 10) " " y1 " C " bend " " y1 " " bend " " y2 " " (+ x2 10) " " y2
             " M " (+ x2 19) " " (- y2 5) " L " (+ x2 10) " " y2 " " (+ x2 19) " " (+ y2 5))
        {:stroke color :stroke-width 2 :opacity 0.7})))
      (partition 2 1 (:cards config)))))
(defn frame
  ([prepared t] (frame prepared t nil))
  ([prepared t selected]
   (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Postcard time outside [0,6)" {:time t}))
   (let [{:keys [config theme base]} prepared
         sampled (motion/sample base t {:explanation (:cue config)})
         index (layout/index sampled)
         materials [(material/paper "paper-grain" (:seed config))
                    (material/grid "paper-grid" 28 (:field theme))]
         scene {:width 1080 :height 1080 :time t :scene "living-postcard" :seed (:seed config)
                :materials materials
                :objects (into
                  [(a/paper "paper" 0 0 1080 1080 (:paper theme))
                   (a/shape "grid" :rect {:x 0 :y 0 :width 1080 :height 1080 :fill (material/ref "paper-grid") :opacity 0.06})
                   (a/texture "grain" 0 0 1080 1080 "paper-grain")
                   (a/label "masthead" 94 56 14 "FIELD NOTES     /     THE LIVING POSTCARD"
                            {:fill (:ink theme) :letter-spacing 1.5})
                   (a/ink-line "top-rule" "M 94 78 L 978 78" {:stroke (:ink theme) :opacity 0.6 :stroke-width 1})
                   (:render sampled)
                   (a/ink-line "bottom-rule" "M 94 1020 L 978 1020" {:stroke (:ink theme) :opacity 0.6 :stroke-width 1})
                   (a/label "footer" 94 1048 12 "CONTENT → MEASUREMENT → PICTURE     /     BUILT IN BL"
                            {:fill (:ink theme) :letter-spacing 1.1})]
                  (into (links index config (:accent theme))
                        (if selected [(inspect/overlay index selected)] [])))}]
     {:scene (s/validate scene) :objects index :shaping (:shaping prepared)})))
