(ns scene-demo.studio-export
  (:require [scene-demo.postcard :as postcard] [scene.core :as scene] [interop]))
(defn command! [args]
  (let [result (System/cmd "python3" (to-list args) (list (tuple :stderr_to_stdout true)))]
    (when (not= 0 (erlang/element 2 result))
      (scene/fail "Studio export worker failed" {:diagnostic (erlang/element 1 result)}))))
(defn status! [context revision value]
  (ets/insert (:jobs context) (tuple revision (merge {:revision revision} value))))
(defn run! [context prepared revision]
  (let [{:keys [out snapshot font-dir renderer code-id backend source-hashes font-hashes]} context
        root (str out "/exports/" revision) final-dir (str root "/" revision)
        dir (str root "/.pending-" (System/pid))
        worker (str snapshot "/examples__scene-renderer__raster.py")]
    (status! context revision {:state "rendering" :frames 144 :completed nil})
    (when (not (File/dir? final-dir))
      (File/mkdir_p! dir)
      (File/write! (str dir "/provenance.json")
        (interop/->json {:revision revision :code-id code-id :config (:config prepared)
                        :sources source-hashes :fonts font-hashes :shaping (:shaping prepared)
                        :backend backend :quality "2x Lanczos / canonical outlined Pango / paper tile v1"
                        :executable-capture "startup environment; documented load-before-capture qualification remains"}))
      (doseq [k (range 144)]
        (File/write! (str dir "/" k ".svg")
          (scene/svg (:scene (postcard/frame prepared (scene/frame-time k 24 1))))))
      (command! [worker "raster" dir "--count" "144" "--font-dir" font-dir
                 "--font" (str font-dir "/InstrumentSerif-Regular.ttf") "--scale" "2" "--rsvg" renderer])
      (File/rename! dir final-dir))
    (File/write! (str root "/manifest.json.tmp")
      (interop/->json {:revision revision :code-id code-id :frames 144 :fps [24 1] :duration 6
                      :width 1080 :height 1080 :backend backend :seed (:seed (:config prepared))
                      :quality "2x Lanczos / canonical outlined Pango / paper tile v1"}))
    (File/rename! (str root "/manifest.json.tmp") (str root "/manifest.json"))
    (status! context revision {:state "encoding" :frames 144 :completed 144})
    (command! [worker "export" root "--out" (str root "/living-postcard.mp4")])
    (status! context revision {:state "ready" :frames 144 :completed 144
                               :url (str "/api/export/video?revision=" revision)
                               :path (str root "/living-postcard.mp4")})))
