(ns scene-demo.metamorphosis
  (:require [scene.core :as s] [scene.geometry :as g] [scene.camera :as camera]
            [scene.choreo :as choreo] [scene.text :as text] [scene.atelier :as a]
            [scene.material :as material]))
(def duration 48)
(def count-nodes 48)
(def ink "#25364a")
(def palette ["#b9c99b" "#e9c45e" "#dd8067" "#b3c9d1" "#e8dfc6" "#496b59"])
; These are OTP math calls even when an ordinary namespace named math is loaded.
(defn radians [degrees] (* degrees (/ (erlang/apply :math :pi (list)) 180)))
(defn polar [r angle] [(* r (erlang/apply :math :cos (list (radians angle)))) (* r (erlang/apply :math :sin (list (radians angle))))])
(defn key [i] (str "idea/" i))
(defn node [i at angle scale parent] {:id (key i) :at at :angle angle :scale scale :parent (when parent (key parent))})
(def bloom
  (choreo/formation (mapv (fn [i]
    (if (= i 0) (node i [0 0] 0 1 nil)
      (let [ring (quot (- i 1) 8) arm (mod (- i 1) 8) angle (+ (* arm 45) (* ring 4))]
        (node i (polar (+ 160 (* ring 52)) angle) (+ angle 90) (+ 0.65 (* ring 0.1)) (if (= ring 0) 0 (- i 8)))))) (range count-nodes))))
(def tree
  (choreo/formation (mapv (fn [i]
    (let [depth (erlang/apply :math :floor (list (/ (erlang/apply :math :log (list (+ i 1))) (erlang/apply :math :log (list 2))))) first (- (erlang/apply :math :pow (list 2 depth)) 1)
          local (- i first) size (erlang/apply :math :pow (list 2 depth))]
      (node i [(- (* (/ (+ local 0.5) size) 1400) 700) (- 360 (* depth 150))]
            (if (= 0 (mod i 2)) 28 -28) (if (= i 0) 1 (+ 0.5 (* 0.04 depth)))
            (when (> i 0) (quot (- i 1) 2))))) (range count-nodes))))
(def ribbon
  (choreo/formation (mapv (fn [i]
    (node i [(* (- i 23.5) 34) (* 170 (erlang/apply :math :sin (list (* i 0.21))))]
          (+ 90 (* 22 (erlang/apply :math :cos (list (* i 0.21))))) (if (= i 0) 1 0.52) (when (> i 0) (- i 1)))) (range count-nodes))))
(def cosmos
  (choreo/formation (mapv (fn [i]
    (if (= i 0) (node i [0 0] 0 1 nil)
      (let [ring (quot (- i 1) 16) angle (+ (* (mod (- i 1) 16) 22.5) (* ring 18))
            [x y] (polar (+ 340 (* ring 245)) angle)]
        (node i [x (* 0.64 y)] (+ 90 angle) (+ 0.7 (* ring 0.12)) (if (= ring 0) 0 (- i 16)))))) (range count-nodes))))
(def camera-track
  (let [pose (fn [zoom roll] {:center [0 0] :zoom zoom :roll roll})
        a (pose 4.2 -5) b (pose 4.5 0) c (pose 0.92 -11) d (pose 0.8 5)
        e (pose 2.6 -5) f (pose 0.68 12) h (pose 3.5 0) i (pose 0.48 -8) j (pose 0.52 0)]
    (camera/track [{:id "seed" :duration 4 :from a :to b}
                   {:id "unfold" :duration 6 :from b :to c}
                   {:id "branch" :duration 8 :from c :to d}
                   {:id "inside-an-instance" :duration 6 :from d :to e}
                   {:id "time-ribbon" :duration 8 :from e :to f}
                   {:id "inside-the-picture" :duration 7 :from f :to h}
                   {:id "a-connected-world" :duration 7 :from h :to i}
                   {:id "settle" :duration 2 :from i :to j}])))
(def specimens
  [{:id "idea" :text "an idea." :family "Instrument Serif" :size 32 :italic true}
   {:id "seed-tag" :text "VALUE / 001" :size 10}
   {:id "instances" :text "one definition,\nmany instances." :family "Instrument Serif" :size 26}
   {:id "identity" :text "a name survives a change of place" :family "Patrick Hand" :size 15}
   {:id "time" :text "time is a coordinate." :family "Instrument Serif" :size 26 :italic true}
   {:id "inspect" :text "ask the picture." :family "Instrument Serif" :size 28}
   {:id "bounds" :text "LOGICAL / INK / ANCHOR" :size 10}
   {:id "glyph" :text "a" :family "Instrument Serif" :size 48 :italic true}
   {:id "function" :text "f" :family "Instrument Serif" :size 42 :italic true}
   {:id "closing" :text "The program is\nthe sketchbook." :family "Instrument Serif" :size 82}
   {:id "faithful" :text "One scene. Many faithful views." :size 24}
   {:id "footer" :text "Lisp authors the rules. The picture follows." :family "Patrick Hand" :size 25}])
(defn circle [r]
  (let [k (* r 0.55228475)]
    [["M" r 0] ["C" r k k r 0 r] ["C" (- 0 k) r (- 0 r) k (- 0 r) 0]
     ["C" (- 0 r) (- 0 k) (- 0 k) (- 0 r) 0 (- 0 r)] ["C" k (- 0 r) r (- 0 k) r 0] ["Z"]]))
(def leaf [["M" 0 26] ["C" -36 6 -28 -30 0 -42] ["C" 28 -30 36 6 0 26] ["Z"]])
(def seed-leaf [["M" 24 0] ["C" 24 18 8 37 0 48] ["C" -8 37 -24 18 -24 0]
                ["C" -24 -18 -8 -37 0 -48] ["C" 8 -37 24 -18 24 0] ["Z"]])
(def seed-lens [["M" 38 0] ["C" 38 8 20 14 0 14] ["C" -20 14 -38 8 -38 0]
                ["C" -38 -8 -20 -14 0 -14] ["C" 20 -14 38 -8 38 0] ["Z"]])
(defn seed-path [t]
  (cond (< t 4) (circle 15)
        (< t 10) (choreo/path-morph (circle 15) seed-leaf (choreo/progress t 4 6))
        (< t 18) (choreo/path-morph seed-leaf (circle 24) (choreo/progress t 10 8))
        (< t 24) (circle 24)
        (< t 32) (choreo/path-morph (circle 24) seed-lens (choreo/progress t 24 8))
        (< t 39) seed-lens
        :else (choreo/path-morph seed-lens (circle 15) (choreo/progress t 39 7))))
(defn rectangle [[x y w h]] [["M" x y] ["L" (+ x w) y] ["L" (+ x w) (+ y h)] ["L" x (+ y h)] ["Z"]])
(defn prepare [opts]
  (let [shaped (text/measure! specimens opts) runs (:runs shaped)
        glyph (get runs "glyph") [x y w h] (:logical glyph) [ix iy iw ih] (:ink glyph)]
    {:shaping (dissoc shaped :runs) :runs runs
     :assets (merge
       (into {} (mapv (fn [[id run]] [(str "text/" id) (merge {:commands (:commands run) :fill ink} (when (not (contains? #{"glyph" "function"} id)) {:halo "#eee7d3" :halo-width 2.5}))]) runs))
       (into {} (mapv (fn [i] [(str "leaf/" i) {:commands leaf :fill (nth palette i) :stroke ink :width 1.1 :hatch true}]) (range 6)))
       {"seed" {:commands (circle 15) :fill "#d66f53" :stroke ink :width 1.2}
        "component" {:commands (circle 33) :fill "#e6c66e" :stroke ink :width 1}
        "inspector" {:commands (circle 43) :fill "#e9e2cf" :stroke ink :width 0.8}
        "orbit" {:commands (circle 106) :stroke "#8c998a" :width 0.65 :dash [2 5]}
        "logical" {:commands (rectangle [(- x 14) (- y (:baseline glyph) -18) w h]) :stroke "#c8664c" :width 0.6 :dash [2 2]}
        "ink" {:commands (rectangle [(- ix 14) (- iy (:baseline glyph) -18) iw ih]) :stroke "#3d8977" :width 0.6 :dash [2 2]}})}))
(defn posed [t]
  (cond (< t 10) (choreo/morph bloom bloom 0)
        (< t 18) (choreo/morph bloom tree (choreo/progress t 10 8))
        (< t 24) (choreo/morph tree tree 0)
        (< t 32) (choreo/morph tree ribbon (choreo/progress t 24 8))
        (< t 39) (choreo/morph ribbon ribbon 0)
        :else (choreo/morph ribbon cosmos (choreo/progress t 39 7))))
(defn focus [t index pose]
  (let [zero [0 0] instance (:at (get index (key 31))) detail (:at (get index (key 47)))]
    (cond (< t 18) (assoc pose :center zero)
          (< t 24) (choreo/follow pose zero instance (choreo/progress t 18 6))
          (< t 32) (choreo/follow pose instance zero (choreo/progress t 24 8))
          (< t 39) (choreo/follow pose zero detail (choreo/progress t 32 7))
          :else (choreo/follow pose detail zero (choreo/progress t 39 7)))))
(defn object [cam id asset at angle scale]
  {:id id :asset asset :matrix (g/multiply cam (g/transform [[:scale [scale scale]] [:rotate angle] [:translate at]]))})
(defn label [prepared cam id text at angle scale]
  (let [baseline (:baseline (get (:runs prepared) text))
        local (g/transform [[:translate [0 (- 0 baseline)]] [:scale [scale scale]] [:rotate angle] [:translate at]])]
    {:id id :asset (str "text/" text) :matrix (g/multiply cam local)}))
(defn frame [prepared t]
  (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Metamorphosis time outside [0,48)" {:time t}))
  (let [nodes (posed t) index (into {} (mapv (fn [node] [(:id node) node]) nodes))
        pose (focus t index (camera/sample camera-track t)) cam (camera/matrix pose [1920 1080])
        seed (:at (get index (key 0))) [sx sy] seed [ax ay] (:at (get index (key 31))) [bx by] (:at (get index (key 47)))
        edges (mapv (fn [node]
          (let [[x y] (:at node) [px py] (:attachment node) dx (- x px) dy (- y py)]
            {:id (str (:id node) "/attachment") :curve [px py (+ px (* 0.33 dx) (* -0.12 dy)) (+ py (* 0.33 dy) (* 0.12 dx))
                            (+ px (* 0.66 dx) (* -0.12 dy)) (+ py (* 0.66 dy) (* 0.12 dx)) x y] :stroke "#929681" :width 0.85})) (rest nodes))
        objects (mapv (fn [node]
          (let [id (:id node) i (Integer/parse (replace-str id "idea/" "")) i (erlang/element 1 i)
                asset (cond (= i 0) "seed" (= i 31) "component" (= i 47) "inspector" :else (str "leaf/" (mod i 6)))]
            (let [value (object cam id asset (:at node) (if (contains? #{0 31 47} i) 0 (:angle node)) (if (contains? #{0 31 47} i) 1 (:scale node)))]
              (if (= i 0) (assoc value :commands (seed-path t)) value)))) nodes)
        objects (into objects
          [(object cam "instance/orbit" "orbit" [ax ay] 0 1)
           (label prepared cam "instance/function" "function" [(- ax 8) (+ ay 13)] 0 1)
           (label prepared cam "instance/phrase" "instances" [(- ax 175) (- ay 128)] 0 1)
           (label prepared cam "instance/identity" "identity" [(- ax 170) (+ ay 132)] 0 1)
           (label prepared cam "inspect/glyph" "glyph" [(- bx 14) (+ by 18)] 0 1)
           (object cam "inspect/logical" "logical" [bx by] 0 1)
           (object cam "inspect/ink" "ink" [bx by] 0 1)
           (label prepared cam "inspect/time" "time" [(- bx 175) (- by 118)] 0 1)
           (label prepared cam "inspect/question" "inspect" [(- bx 125) (+ by 125)] 0 1)
           (label prepared cam "inspect/bounds" "bounds" [(- bx 65) (+ by 70)] 0 1)
           (label prepared cam "seed/idea" "idea" [(- sx 64) (- sy 46)] 0 1)
           (label prepared cam "seed/tag" "seed-tag" [(+ sx 28) (+ sy 6)] 0 1)
           (label prepared cam "world/title" "closing" [-1550 -850] 0 1)
           (label prepared cam "world/meaning" "faithful" [-1550 -580] 0 1)
           (label prepared cam "world/footer" "footer" [-300 950] 0 1)])]
    {:time t :camera pose :matrix cam :edges edges :objects objects :semantic-ids (mapv :id nodes)}))
(defn paper []
  {:width 512 :height 512 :time 0 :scene "world-paper" :materials [(material/paper "grain" 73)]
   :objects [(a/paper "paper" 0 0 512 512 "#eee7d3") (a/texture "grain-layer" 0 0 512 512 "grain")]})
