(ns scene-demo.showcase
  (:require [scene.core :as s] [scene.score :as score] [scene.camera :as camera]))
(def duration 30)
(def fps 60)
(def beat (/ 60 128))
(defn clamp [x a b] (max a (min b x)))
(defn blend [t at d] (camera/ease (s/progress t at d)))
(defn curve [keys] (score/track (mapv (fn [[t v]] {:at t :value v}) keys)))
;; Distance / azimuth / elevation / roll / focus-x / focus-y.
;; Deliberately asymmetric intervals; continuous tangents, quick moves, no slideshow holds.
(def lens (curve [[0 [3.0 -0.7 0.23 -0.24 0 0.1]] [0.6 [3.3 -0.4 0.1 -0.1 0 0.2]]
 [1.15 [8.8 0.1 0.24 0.1 0 0]] [2.8 [9.3 0.33 0.18 0.08 0 0]]
 [3.75 [7.8 1.1 0.4 -0.25 0 0]] [5.625 [9.4 1.9 0.15 0.15 0 0]]
 [7.5 [10.3 2.9 0.3 -0.08 0 0]] [8.1 [4.5 3.4 0.16 0.26 0 0]]
 [9.375 [6.4 4.2 -0.13 0.35 0 0]] [11.25 [10.2 5.1 0.25 -0.1 0 0]]
 [13.125 [7.4 6.0 0.35 -0.28 0 0.2]] [14.1 [3.8 6.6 -0.15 0.2 0 0.2]]
 [15 [10.8 7.1 0.38 0.1 0 0]] [16.875 [9.1 7.5 0.25 -0.15 0 0]]
 [18.75 [6.8 8.0 -0.2 0.3 0 0.3]] [19.4 [4.0 8.5 0.15 0.05 0 0]]
 [20.625 [10.5 9.1 0.4 -0.1 0 0]] [22.5 [11.2 10.0 0.15 0.2 0 0]]
 [24.375 [10.0 11.1 0.2 -0.18 0 0]] [26.25 [11.8 12.566 0.05 0 -1.5 0]]
 [28.125 [12.2 12.566 0.05 0 -1.5 0]] [30 [11.8 12.566 0.05 0 -1.5 0]]]))
(def geometry (curve [[0 [1 0 0 0]] [2.8 [1 0 0 0]] [4.2 [0 1 0 0]]
 [6.5 [0 1 0 0]] [7.7 [0 0 1 0]] [10 [0 0 1 0]] [11.6 [0 0 0 1]]
 [14 [0 0 0 1]] [15.5 [0 1 0 0]] [18 [0 1 0 0]] [19.1 [0 0 1 0]]
 [21 [0 0 1 0]] [23 [0 1 0 0]] [25.8 [1 0 0 0]] [30 [1 0 0 0]]]))
(def width (curve [[0 [0.22]] [3 [0.24]] [5 [0.18]] [7.5 [0.11]] [10 [0.21]] [12 [0.15]]
 [14 [0.1]] [16 [0.24]] [18 [0.12]] [20 [0.16]] [23 [0.23]] [26 [0.17]] [30 [0.17]]]))
(def stock (curve [[0 [0 0 0.85 0.15 1 0.18 0.045]] [4 [0 0 1 0.5 1 0.12 0.03]]
 [7.5 [0.3 0.4 0.4 0.3 0.95 0.42 0.05]] [11.25 [0.7 1 0.1 0.1 0.76 0.96 0.36]]
 [15 [1 0.85 0.1 0.1 0.12 0.21 0.18]] [18.75 [0.5 0.1 1 0.8 0.75 0.2 0.08]]
 [22.5 [0 0 1 0.5 1 0.3 0.08]] [26.25 [0 0 0.75 0.15 1 0.25 0.055]] [30 [0 0 0.75 0.15 1 0.25 0.055]]]))
(defn dot [a b] (reduce + 0 (mapv * a b)))
(defn minus [a b] (mapv - a b))
(defn norm [v] (let [d (erlang/apply :math :sqrt (list (dot v v)))] (mapv (fn [x] (/ x d)) v)))
(defn cross [[a b c] [d e f]] [(- (* b f) (* c e)) (- (* c d) (* a f)) (- (* a e) (* b d))])
(defn mul4 [a b]
 (mapv (fn [k] (let [col (quot k 4) row (mod k 4)]
   (reduce + 0 (mapv (fn [i] (* (nth a (+ (* i 4) row)) (nth b (+ (* col 4) i)))) (range 4))))) (range 16)))
(defn camera3 [t]
 (let [[d yaw pitch roll tx ty] (score/sample lens t) d (max 2.5 d)
       eye [(+ tx (* d (erlang/apply :math :sin (list yaw)) (erlang/apply :math :cos (list pitch)))) (+ ty (* d (erlang/apply :math :sin (list pitch)))) (* d (erlang/apply :math :cos (list yaw)) (erlang/apply :math :cos (list pitch)))]
       target [tx ty 0] f (norm (minus target eye))
       r (norm (cross f [(erlang/apply :math :sin (list roll)) (erlang/apply :math :cos (list roll)) 0])) u (cross r f)
       [rx ry rz] r [ux uy uz] u [fx fy fz] f
       view [rx ux (- 0 fx) 0 ry uy (- 0 fy) 0 rz uz (- 0 fz) 0 (- 0 (dot r eye)) (- 0 (dot u eye)) (dot f eye) 1]
       q (/ 1 (erlang/apply :math :tan (list (* 21 (/ (erlang/apply :math :pi (list)) 180))))) n 0.1 far 100
       projection [(/ q (/ 16 9)) 0 0 0 0 q 0 0 0 0 (/ (+ far n) (- n far)) -1 0 0 (/ (* 2 far n) (- n far)) 0]]
   {:eye eye :view-projection (mul4 projection view)}))
(def typography
 [{:id "make" :text "MAKE" :family "DM Sans" :size 260 :weight 900}
  {:id "rules" :text "RULES" :family "DM Sans" :size 260 :weight 900}
  {:id "move" :text "MOVE" :family "Instrument Serif" :size 300 :italic true}
  {:id "worlds" :text "WORLDS" :family "DM Sans" :size 260 :weight 900}
  {:id "brand" :text "BEAM LISP" :family "DM Sans" :size 200 :weight 800}
  {:id "tagline" :text "The program is the medium." :family "Instrument Serif" :size 100 :italic true}
  {:id "signature" :text "BEAM LISP  /  SCENE RENDERER" :family "DM Sans" :size 25}
  {:id "edition" :text "MAKE WORLDS.   /   A PROCEDURAL MOTION STUDY" :family "DM Sans" :size 18}])
(defn typography-pose [id t light]
 (let [finish (blend t 24 2.25) ink (if (> light 0.6) [0.025 0.045 0.04] [0.88 0.88 0.8])
       fly (fn [at speed] (* (- t at) speed))
       [x y w z bend phase shear]
       (cond (= id "make") [(fly 2.5 -5) 0.05 13 -2 0.15 t 0.1]
             (= id "rules") [(fly 6 -5) 0 14 -2 0.22 t -0.3]
             (= id "move") [(fly 11.6 -5) 0.2 13 -2 0.35 t 0.5]
             (= id "worlds") [(fly 21.4 -5) 0 16 -2 0.24 t -0.1]
             (= id "brand") [(s/lerp 34 -4.7 finish) 0.5 7.5 1 0 0 0]
             (= id "tagline") [(s/lerp 34 -4.7 finish) -0.65 7.5 1 0 0 0]
             (= id "signature") [-6.3 4.75 5.6 1 0 0 0]
             :else [-4.9 -4.8 8.4 1 0 0 0])]
   {:id id :rect [x y w 1] :gesture [z bend phase shear] :ink ink :plane (if (contains? #{"signature" "edition"} id) "front" "back")}))
(defn sample [t]
 (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Showcase time outside [0,30)" {:time t}))
 (let [weights (mapv (fn [v] (max 0 v)) (score/sample geometry t)) total (reduce + 0 weights)
       [light woven spectral emission r g b] (score/sample stock t)
       light (clamp light 0 1) finish (blend t 24 2.25)
       ;; Beat emphasis deforms material width; it does not restart the motion clock.
       pulse (* 0.018 (erlang/apply :math :pow (list (max 0 (erlang/apply :math :cos (list (* (/ t beat) (erlang/apply :math :pi (list)))))) 8)))]
   (merge (camera3 t)
     {:time t :shape (mapv (fn [v] (/ v total)) weights)
      :gesture [(* t 1.6) (+ 0.3 (* t 0.7)) (+ 1.3 (* 0.7 (erlang/apply :math :sin (list (* t 0.45))))) (+ (first (score/sample width t)) pulse)]
      :placement [(+ 0.2 (* 0.22 (erlang/apply :math :sin (list (* t 0.4))))) (* 0.12 t) (* 0.15 (erlang/apply :math :sin (list (* t 0.7)))) (* finish 2.5)]
      :material [(* t 0.045) (clamp woven 0 1) (clamp spectral 0 1) (clamp emission 0 1)]
      :accent [(clamp r 0 1) (clamp g 0 1) (clamp b 0 1)]
      :atmosphere [light 0.6 0 0] :finish [0.25 0.2 0 0]
      :types (mapv (fn [spec] (typography-pose (:id spec) t light)) typography)})))
(defn score []
 (vec (mapcat (fn [i]
  (let [t (* i beat) bar (quot i 4) note (nth [55 65.406 73.416 49] (mod (quot bar 2) 4))]
   (into [{:at t :voice "kick" :duration 0.3 :frequency 54 :gain (if (< i 56) 0.7 0.48)}
          {:at t :voice "bass" :duration (* beat 0.82) :frequency note :gain 0.19}
          {:at (+ t (* beat 0.5)) :voice "hat" :duration 0.09 :frequency 6500 :gain 0.10}]
     (if (= (mod i 4) 2) [{:at t :voice "snare" :duration 0.18 :frequency 180 :gain 0.24}]
       (if (= (mod i 8) 0) [{:at t :voice "chord" :duration 2.3 :frequency (* note 4) :gain 0.12}] []))))) (range 64))))
