(ns scene-demo.frame-plan (:require [scene.core :as scene]))

(defn selection [args total defaults]
 (let [mode (or (second args) "review") raw (first (drop 2 args))]
  (when-not (contains? #{"review" "film"} mode)
   (scene/fail "Choose review or film" {}))
  (when (and (= mode "film") raw)
   (scene/fail "A film requires its complete frame clock" {}))
  (when (and raw (or (> (count raw) 4096)
                    (not (Regex/match? #"^[0-9]+(,[0-9]+)*$" raw))))
   (scene/fail "Review selection must contain comma-separated frame numbers" {}))
  (let [indices (if (= mode "film") (vec (range total))
                  (if raw (mapv (fn [value] (erlang/binary_to_integer value)) (String/split raw ",")) defaults))]
   (when-not (and (seq indices) (or (= mode "film") (<= (count indices) 64))
                 (= (count indices) (count (set indices)))
                 (every? #(and (int? %) (<= 0 %) (< % total)) indices))
    (scene/fail "Review selection must contain 1–64 distinct frames inside the clock" {}))
   {:mode mode :indices (vec (sort indices))})))
