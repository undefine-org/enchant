(ns scene-demo.hello
 (:require [scene.core :as s] [scene.geometry :as g] [scene.camera :as camera]
           [scene.score :as score] [scene.choreo :as choreo] [scene.text :as text]))
(def duration 60)
(def fps 60)
(def ink "#233d36")
(def cream "#f4f0e4")
(def coral "#e88d74")
(def gold "#e5c95f")
(def blue "#658fa8")
(def ideas (mapv (fn [i] {:id (str "world/" i) :i i}) (range 24)))
(defn ease [t at d] (camera/ease (s/progress t at d)))
(defn lerp [a b p] (s/lerp a b p))
(defn mix-color [a b p] (mapv (fn [i] (lerp (nth a i) (nth b i) p)) [0 1 2]))
(defn curve [keys] (score/track (mapv (fn [[t v]] {:at t :value v}) keys)))
(def screen-score (curve [[0 [2.9 1240 510 0]] [0.8 [2.6 1190 500 -0.02]]
 [2.4 [1.37 1135 515 0]] [3.5 [1.37 1135 515 0]] [5.2 [1 960 540 0]]
 [12.7 [1 960 540 0]] [14.5 [1.03 980 520 0]] [18.2 [1 960 540 0]]
 [20.4 [1.37 1135 515 0]] [27.8 [1.37 1135 515 0]] [29.8 [1 960 540 0]]
 [37.7 [1 960 540 0]] [40.5 [4.5 1135 515 -0.12]] [42.7 [4.8 1135 515 0.08]]
 [44.5 [3.5 1135 515 -0.05]] [47.5 [1.37 1135 515 0]] [49.7 [1.37 1135 515 0]]
 [51.2 [1 960 540 0]] [54.3 [1 960 540 0]] [55.5 [1.37 1135 515 0]] [60 [1.37 1135 515 0]]]))
(def specimens
 [{:id "hello" :text "Hello." :size 136 :weight 650}
  {:id "world" :text "Hello, world." :size 136 :weight 650}
  {:id "mini" :text "Hello." :size 72 :weight 650}
  {:id "brand" :text "Beam Lisp" :size 54 :weight 750}
  {:id "brand-large" :text "Beam Lisp" :size 116 :weight 750}
  {:id "category" :text "Motion graphics." :size 31 :weight 550}
  {:id "language" :text "Written in Lisp." :size 31 :weight 550}
  {:id "cta" :text "Make your first scene." :size 32 :weight 650}
  {:id "file" :text "hello-world.bl" :size 25 :weight 550}
  {:id "concept" :text "Interface concept" :size 20 :weight 600}
  {:id "title-label" :text "Title" :size 25 :weight 650}
  {:id "hello-field" :text "Hello." :size 29 :weight 600}
  {:id "world-field" :text "Hello, world." :size 29 :weight 600}
  {:id "stock-label" :text "Shared material" :size 23 :weight 650}
  {:id "ivory" :text "Ivory" :size 24 :weight 600}
  {:id "coral" :text "Coral" :size 24 :weight 600}
  {:id "code-1" :text "(defn world [idea]" :size 22}
  {:id "code-2" :text "  (specimen idea stock))" :size 22}
  {:id "code-3" :text "(mapv world ideas)" :size 24 :weight 650}
  {:id "selection" :text "world/original" :size 25 :weight 650}
  {:id "font-label" :text "Font" :size 23 :weight 650}
  {:id "font" :text "DM Sans · 650" :size 24 :weight 600}
  {:id "anchor-label" :text "Anchor" :size 23 :weight 650}
  {:id "anchor" :text "baseline / east" :size 23}
  {:id "mat-label" :text "Material" :size 23 :weight 650}
  {:id "paper" :text "Paper" :size 24}
  {:id "weave" :text "Weave" :size 24}
  {:id "metal" :text "Spectral metal" :size 24}
  {:id "export" :text "Export film" :size 24 :weight 700}
  {:id "output" :text "hello-world.mp4" :size 24 :weight 600}
  {:id "ready" :text "Ready to play" :size 23 :weight 600}
  {:id "rendering" :text "Rendering…" :size 23}
  {:id "ellipsis" :text "A little later" :size 20}
  {:id "time-8" :text "00:08.000" :size 24 :weight 650}
  {:id "time-3" :text "00:03.000" :size 24 :weight 650}
  {:id "time-12" :text "00:12.000" :size 24 :weight 650}])
(def clock-specimens (mapv (fn [i] {:id (str "digit-" i) :text (str i) :size 24 :weight 650}) (range 10)))
(defn prepare [opts]
 (let [requests (mapv (fn [v] (assoc v :family "DM Sans")) (into specimens clock-specimens))
       shaped (text/measure! requests opts)]
  {:runs (:runs shaped) :shaping (dissoc shaped :runs)
   :assets (into {} (mapv (fn [[id run]] [id {:commands (:commands run)}]) (:runs shaped)))}))
(defn rect [id box fill radius] {:id id :kind "rect" :box box :fill fill :radius radius})
(defn outline [id box color width radius] {:id id :kind "rect" :box box :stroke color :width width :radius radius})
(defn line [id points color width] {:id id :kind "curve" :points points :stroke color :width width})
(defn label [prepared id asset x y scale fill]
 (let [baseline (:baseline (get (:runs prepared) asset))]
  {:id id :kind "asset" :asset asset :matrix (g/transform [[:translate [0 (- 0 baseline)]] [:scale [scale scale]] [:translate [x y]]]) :fill fill}))
(defn transform-items [items matrix clip]
 (mapv (fn [item] (assoc item :matrix (g/multiply matrix (get item :matrix g/identity)) :clip clip)) items))
(defn project-time [t]
 (cond (< t 24) 0
       (< t 29) (* 1.6 (- t 24))
       (< t 30.4) 8
       (< t 31.4) (lerp 8 3 (ease t 30.4 1))
       (< t 31.9) 3
       (< t 32.4) 12
       (< t 33.8) 8
       :else 8))
(defn node-position [i formation phase]
 (let [grid [(* (- (mod i 6) 2.5) 240) (* (- (quot i 6) 1.5) 180)]
       depth (math/floor (/ (math/log (+ i 1)) (math/log 2))) first (- (math/pow 2 depth) 1)
       tree [(* (- (/ (+ (- i first) 0.5) (math/pow 2 depth)) 0.5) 1250) (- 340 (* depth 175))]
       ribbon [(* (- i 11.5) 57) (* 125 (math/sin (+ (* i 0.3) phase)))]
       helix [(* 460 (math/sin (+ (* i 0.42) phase))) (* (- i 11.5) 31)]
       initial (cond (= i 0) [0 0] (= i 1) [1400 0] (= i 2) [-1400 0]
                     :else [(+ 5000 (* (mod i 6) 500)) (* (- (quot i 6) 1.5) 200)])]
  (cond (= formation :initial) initial (= formation :grid) grid (= formation :tree) tree
        (= formation :ribbon) ribbon :else helix)))
(defn formations [t]
 (let [q (project-time t)
       [from to p] (cond (< t 18.8) [:initial :initial 0]
                    (< t 21) [:initial :grid (ease t 18.8 2.2)]
                    (< t 24) [:grid :tree (ease t 22 1.5)]
                    (< t 29) [:tree :helix (ease q 3 5)]
                    (< t 34) [:tree :helix (ease q 3 5)]
                    (< t 38) [:helix :helix 1]
                    (< t 46) [:helix :helix 1]
                    :else [:helix :initial (ease t 46 2)])
       phase (* 0.06 q)]
  (mapv (fn [i]
   (let [a (node-position i from phase) b (node-position i to phase)]
    {:id (str "world/" i) :i i :at (choreo/point a b p)})) (range 24))))
(defn world [prepared node config]
 (let [{:keys [i at]} node [x y] at
       leader (= i 0) depth (math/floor (/ (math/log (+ i 1)) (math/log 2)))
       scale (* (if leader (:leader-scale config)
              (lerp (if (< i 3) 1 (+ 0.14 (* 0.015 (mod i 4)))) (+ 0.14 (* 0.015 (mod i 4))) (:family config)))
               (lerp 1 (/ 1 (+ 1 (* 0.5 depth))) (:branch config)))
       title (if (:long config) "world" "hello") run (get (:runs prepared) title)
       measured (first (rest (rest (:logical run))))
       title-width (nth (:logical run) 2)
       width (lerp (:short-width config) (:long-width config) (:layout config))
       left (- 0 (/ width 2))
       base (g/transform [[:scale [scale scale]] [:rotate (if leader 0 (* 4 (math/sin (+ i (:phase config)))))] [:translate [(+ 640 x) (+ 360 y)]]])
       stock (if (:coral config) coral "#e7e0cc")
       items [(rect "shadow" [(+ left 9) -147 (+ width 12) 324] "#d4cebe" 34)
              (rect "stock" [left -162 width 324] stock 32)
              (rect "surface" [(+ left 8) -170 width 320] cream 31)
              (outline "edge" [(+ left 8) -170 width 320] "#9caa98" 1.3 31)
              (label prepared "title" title (+ left 52) 32 1 ink)]
       sx (+ left width 25) sy 30
       seed {:id "seed" :kind "seed" :center [sx sy] :radius 80 :angle (* 0.16 (:phase config))
             :material (:material config) :seed i :phase (:phase config)}
       line1 (line "attachment" [(+ left width -60) 30 (+ sx -120) 165 (+ sx -65) -80 sx sy] "#c9765e" 3)
       small [(line "branch-a" [sx sy (+ sx 45) -40 (+ sx 72) -120 (+ sx 30) -174] "#91a28e" 1.7)
              (line "branch-b" [sx sy (+ sx 55) 140 (+ sx 90) 150 (+ sx 45) 202] "#91a28e" 1.7)
              {:id "satellite-a" :kind "seed" :center [(+ sx 30) -174] :radius 24 :angle 0 :seed (+ i 31) :phase (:phase config) :material (:material config)}
              {:id "satellite-b" :kind "seed" :center [(+ sx 45) 202] :radius 31 :angle 0 :seed (+ i 71) :phase (:phase config) :material (:material config)}]
       items (into (conj items line1 seed) (if leader small []))]
  {:items (mapv (fn [item] (assoc item :id (str (:id node) "/" (:id item))
                  :matrix (g/multiply base (get item :matrix g/identity)))) items)
   :seed (g/point base [sx sy]) :base base :box [left -170 width 320]
   :inlet (g/point base [left 0])
   :baseline-end (g/point base [(+ left 52 title-width) 32])
   :title-baseline (g/point base [(+ left 52) 32]) :title-width title-width}))
(defn artwork [prepared t]
 (let [long? (>= t 9.6) layout (ease t 9.2 1.0)
       short (+ 170 (nth (:logical (get (:runs prepared) "hello")) 2))
       long (+ 170 (nth (:logical (get (:runs prepared) "world")) 2))
       mat (cond (< t 40.2) [1 0 0] (< t 42.5) [(- 1 (ease t 40.2 1.2)) (ease t 40.2 1.2) 0]
                 :else [0 (- 1 (ease t 42.5 1.4)) (ease t 42.5 1.4)])
       config {:long long? :layout layout :short-width short :long-width long :coral (>= t 16.1) :material mat
               :phase (project-time t)
               :family (ease t 18.8 2.2)
               :branch (if (and (>= t 24) (< t 34)) (- 1 (ease (project-time t) 3 5)) (if (< t 24) (ease t 22 1.5) 0))
               :leader-scale (lerp 1 0.22 (* (ease t 18.8 2.2) (- 1 (ease t 38 1.8))))}
       nodes (formations t) worlds (mapv (fn [n] (world prepared n config)) nodes)
       leader (first worlds)
       family (ease t 18.8 2.2)
       zoom (cond (< t 14) 1 (< t 18.8) (lerp 1 0.30 (ease t 14 1.6)) (< t 38) (lerp 0.30 0.84 family)
                  (< t 46) (lerp 0.84 1.2 (ease t 38.5 1)) :else (lerp 1.2 1 (ease t 46 1.8)))
       art-center (if (and (>= t 38.5) (< t 46)) (:seed leader) [640 360])
       am (camera/matrix {:center art-center :zoom zoom :roll (if (and (> t 24) (< t 29)) (* 4 (math/sin (* t 0.7))) 0)} [1280 720])
       network-progress (* (ease t 22 1.5) (- 1 (ease t 38 1)))
       network (mapv (fn [i]
          (let [child (nth worlds i) parent (nth worlds (quot (- i 1) 2)) previous (nth worlds (- i 1))
                end (:inlet child) from (choreo/point (:seed parent) (:seed previous) (ease (project-time t) 3 5))
                [px py] (choreo/point end from network-progress) [ex ey] end]
           (line (str "network/" i) [px py (+ px (* 70 network-progress)) py (- ex (* 70 network-progress)) ey ex ey] "#91a28e" 1.7))) (range 1 24))
       art-items (into (into [(rect "art/paper" [0 0 1280 720] cream 0)] network)
          (mapcat :items worlds))
       inspection (if (and (>= t 34.5) (< t 38.8))
          [(assoc (outline "inspect/bounds" (:box leader) blue 2 4) :matrix (:base leader))
           (let [[bx by] (:title-baseline leader) [ex ey] (:baseline-end leader)] (line "inspect/baseline" [bx by bx by ex ey ex ey] blue 2))] [])]
  {:items (into [(assoc (rect "art/paper" [0 0 1280 720] cream 0) :matrix g/identity :clip [0 0 1280 720])]
                (transform-items (into (rest art-items) inspection) am [0 0 1280 720]))
   :seed (g/point am (:seed leader)) :material mat :worlds worlds :matrix am :config config}))
(defn ui [prepared t]
 (let [fg "#eeeedd" muted "#aebcaf" field "#293e36"
       val (if (>= t 9.1) "world-field" "hello-field") selected (and (> t 7) (< t 13))
       stock (>= t 16.1) inspector (and (>= t 34) (< t 39)) material (and (>= t 38.5) (< t 46))]
  (into [(rect "ui/background" [0 0 1920 1080] "#182d27" 0)
         (label prepared "ui/brand" "brand" 42 78 0.64 fg)
         (label prepared "ui/file" "file" 465 68 1 muted)
         (label prepared "ui/concept" "concept" 1375 65 1 "#c4caba")
         (rect "ui/left" [24 125 398 908] "#20372f" 22)
         (label prepared "ui/title-label" "title-label" 51 184 1 fg)
         (rect "ui/title-field" [47 203 351 66] field (if selected 5 12))
         (label prepared "ui/value" val 61 247 0.93 fg)
         (outline "ui/field-border" [47 203 351 66] (if selected gold "#536a5b") (if selected 2.5 1) 12)
         (label prepared "ui/stock-label" "stock-label" 51 330 1 fg)
         (rect "ui/swatch" [49 352 36 36] (if stock coral cream) 10)
         (label prepared "ui/stock" (if stock "coral" "ivory") 103 381 1 fg)
         (label prepared "ui/code1" "code-1" 47 478 1 muted)
         (label prepared "ui/code2" "code-2" 47 510 1 muted)
         (label prepared "ui/code3" "code-3" 47 561 1 fg)
         (label prepared "ui/category" "category" 48 821 0.88 fg)
         (label prepared "ui/language" "language" 48 865 0.88 fg)
         (rect "ui/timeline" [465 932 1360 101] "#20372f" 18)
         (line "ui/ruler" [496 997 800 997 1300 997 1792 997] "#607562" 2)
         (rect "ui/clock-bg" [505 939 240 37] "#20372f" 0)
         (assoc (rect "ui/playhead" [(+ 495 (* 85 (max 0 (min 15 (project-time t))))) 976 3 44] blue 0) :grain false)
         (rect "ui/export-button" [1630 44 196 53] gold 16)
         (label prepared "ui/export" "export" 1656 80 1 ink)]
   (into
    (if inspector
      [(rect "ui/inspector-bg" [35 610 375 328] "#30473a" 16)
       (label prepared "ui/selection" "selection" 52 652 0.92 fg)
       (label prepared "ui/font-label" "font-label" 52 700 0.86 muted)
       (label prepared "ui/font" "font" 52 737 1 fg)
       (label prepared "ui/anchor-label" "anchor-label" 52 793 0.86 muted)
       (label prepared "ui/anchor" "anchor" 52 831 1 fg)] [])
    (into (if material
      [(rect "ui/material-bg" [35 610 375 130] "#30473a" 16)
       (label prepared "ui/mat-label" "mat-label" 52 652 1 fg)
       (label prepared "ui/material" (cond (< t 40.2) "paper" (< t 42.5) "weave" :else "metal") 52 698 1 fg)] [])
      (if (>= t 51.8)
       [(rect "ui/export-job" [35 614 375 160] "#30473a" 16)
        (label prepared "ui/output" "output" 52 657 1 fg)
        (label prepared "ui/job" (if (< t 53.2) "rendering" "ready") 52 704 1 fg)
        (label prepared "ui/ellipsis" "ellipsis" 52 746 0.8 muted)] []))))))
(defn clock-items [prepared t]
 (let [q (max 0 (project-time t)) sec (math/floor q) ms (math/floor (* 1000 (- q sec)))
       nums [0 0 (quot (int sec) 10) (mod (int sec) 10) (quot (int ms) 100) (mod (quot (int ms) 10) 10) (mod (int ms) 10)]
       xs [518 534 562 578 606 622 638]]
  (into (mapv (fn [i] (label prepared (str "ui/clock/" i) (str "digit-" (nth nums i)) (nth xs i) 972 0.9 "#eeeedd")) (range 7))
        [(rect "ui/clock/colon-a" [553 955 3 3] "#eeeedd" 1) (rect "ui/clock/colon-b" [553 966 3 3] "#eeeedd" 1) (rect "ui/clock/dot" [600 969 3 3] "#eeeedd" 1)])))
(def cursor-track (curve [[0 [270 240]] [6 [270 240]] [7.8 [211 237]] [10.6 [211 237]]
 [14.8 [64 370]] [17.2 [64 370]] [19 [310 553]] [28.8 [310 553]]
 [30.1 [1175 995]] [31.3 [750 995]] [31.9 [1515 995]] [32.5 [1175 995]] [34 [1175 995]]
 [35.1 [170 792]] [37 [170 792]] [39 [150 687]] [49.9 [150 687]] [51.7 [1721 71]] [60 [1721 71]]]))
(defn frame [prepared t]
 (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Hello film time outside [0,60)" {:time t}))
 (let [art (artwork prepared t) [z x y roll] (if (and (>= t 29) (< t 38)) [1 960 540 0] (score/sample screen-score t))
       ;; The camera follows the actual selected object during the material dive.
       [sx sy] (:seed art) base-map (g/transform [[:scale [1.0625 1.0625]] [:translate [465 128]]])
       dive (if (< t 46) (ease t 38.5 1.8) 0) [cx cy] (g/point base-map [sx sy])
       focus [(lerp x cx dive) (lerp y cy dive)]
       root (camera/matrix {:center focus :zoom (max 0.8 z) :roll (* roll 57.2958)} [1920 1080])
       clip (g/bounds root [465 128 1360 765])
       art-items (mapv (fn [v] (assoc v :matrix (g/multiply root (g/multiply base-map (:matrix v))) :clip clip)) (:items art))
       chrome (transform-items (into (ui prepared t) (clock-items prepared t)) root [0 0 1920 1080])
       final? (>= t 55)
       end-p (ease t 55 1.2)
       end-map [(lerp 1 0.55 end-p) 0 0 (lerp 1 0.55 end-p) (* 850 end-p) (* 235 end-p)]
       art-items (if final? (mapv (fn [v] (assoc v :matrix (g/multiply end-map (:matrix v)) :clip [0 0 1920 1080])) art-items) art-items)
       cursor (score/sample cursor-track t) [px py] (g/point root cursor)
       pointer {:id "ui/cursor" :kind "path" :commands [["M" px py] ["L" (+ px 6) (+ py 29)] ["L" (+ px 13) (+ py 21)]
               ["L" (+ px 23) (+ py 19)] ["Z"]] :fill "#faf9ef" :stroke ink :width 1.7 :matrix g/identity :clip [0 0 1920 1080]}
       final-items (if final?
         [(rect "close/paper" [0 0 1920 1080] cream 0)
          (label prepared "close/brand" "brand-large" 95 425 1 ink)
          (label prepared "close/category" "category" 100 502 1.45 ink)
          (label prepared "close/language" "language" 100 561 1.45 ink)
          (label prepared "close/cta" "cta" 100 765 1.1 ink)] [])
       ;; End-lockup keeps the original component as the artwork at right.
       items (if final? (into final-items (filter (fn [v] (or (= "art/paper" (:id v)) (String/starts_with? (:id v) "world/0/"))) art-items))
                        (into (into chrome art-items) [pointer]))]
  {:time t :items (mapv (fn [v] (assoc v :matrix (get v :matrix g/identity) :clip (get v :clip [0 0 1920 1080]))) items)
   :shot (cond (< t 4) 1 (< t 8) 2 (< t 14) 3 (< t 19) 4 (< t 24) 5 (< t 29) 6 (< t 34) 7 (< t 39) 8 (< t 46) 9 (< t 51) 10 (< t 55) 11 :else 12)
   :project-time (project-time t) :semantic-ids (mapv :id ideas)}))
(defn musical-bed []
 (let [beat 0.5]
  (vec (mapcat (fn [i]
    (let [at (* i beat) note (nth [65.406 82.407 73.416 55] (mod (quot i 16) 4))
          gain (cond (< at 8) 0.35 (< at 24) 0.65 (< at 29) 0.85 (< at 39) 0.3 (< at 51) 0.85 :else 0.45)]
      (into [{:at at :voice "bass" :duration 0.38 :frequency note :gain (* 0.17 gain)}]
        (into (if (and (> at 5) (< at 55)) [{:at at :voice "kick" :duration 0.28 :frequency 54 :gain (* 0.63 gain)}] [])
          (into (if (= (mod i 8) 0) [{:at at :voice "chord" :duration 3.5 :frequency (* note 4) :gain 0.14}] [])
            (if (and (> at 12) (< at 54)) [{:at (+ at 0.25) :voice "hat" :duration 0.08 :frequency 6500 :gain (* 0.1 gain)}] [])))))) (range 120)))))

(defn soundtrack []
 (into (musical-bed)
  (into (mapv (fn [at] {:at at :voice "tick" :duration 0.075 :frequency 1500 :gain 0.14})
       [7.8 9.1 10.3 16.1 19 30.1 31.9 32.5 35.1 39 42.5 51.7 53.2])
   (mapv (fn [at] {:at at :voice "sweep" :duration 1.2 :frequency 240 :gain 0.045}) [3.4 20 24.1 39.1 44.4 46]))))
