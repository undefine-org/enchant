(ns scene-demo.film (:require [scene.core :as s]))
(def duration 12)
(defn rect [id x y w h fill]
  {:id id :kind :rect :attrs {:x x :y y :width w :height h :rx 14 :fill fill}})
(defn label [id x y size text]
  {:id id :kind :text :attrs {:x x :y y :font-size size :fill "#183b42"} :text text})
(defn scene [t]
  (when (not (and (s/finite? t) (>= t 0) (< t duration)))
    (s/fail "Time outside film [0,12)" {:time t}))
  (let [section (cond (< t 4) 0 (< t 8) 1 :else 2)
        local (- t (* section 4))
        p (s/ease (s/progress local 0 3))
        x (s/lerp -90 640 p)]
    {:width 800 :height 450 :time t :scene section :local-time local :seed 0
     :clips [(rect "stage-mask" 48 140 704 262 "white")]
     :objects
     [{:id "paper" :kind :rect :attrs {:x 0 :y 0 :width 800 :height 450 :fill "#f4efdf"}}
      {:id "transition" :kind :group
       :attrs {:opacity (min (s/progress local 0 0.35) (- 1 (s/progress local 3.65 0.35)))}
       :children [
      (label "eyebrow" 48 48 16 "BEAM LISP / SCENE STUDIES")
      (label "heading" 48 104 34 (nth ["Ideas in motion" "One clock. Any frame." "Small parts, clear stories."] section))
      (rect "stage" 48 140 704 262 "#dce8de")
      {:id "clipped-motion" :kind :group :attrs {:clip-path "url(#stage-mask-clip)"}
       :children
       [{:id "orbit" :kind :group :attrs {:transform (str "translate(" x " 260) rotate(" (* p 80) ")")}
         :children [(rect "tile" -65 -65 130 130 "#e49a54")
                    {:id "center" :kind :circle :attrs {:cx 0 :cy 0 :r 24 :fill "#183b42"}}]}
        {:id "connector" :kind :line :attrs {:x1 120 :y1 340 :x2 680 :y2 340 :stroke "#183b42" :stroke-width 3}}
        (label "stage-label" 92 200 22 (nth ["source → scene → frame" "Seek without replay" "Compose. Inspect. Revise."] section))]}
      (label "footer" 48 430 14 (str "0" (+ section 1) " / 03     •     deterministic scene study"))]}]}))
