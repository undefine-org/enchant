(ns scene-demo.atlas
  (:require [scene.core :as s] [scene.atelier :as a] [scene.material :as m]
            [scene.geometry :as g] [scene.text :as text] [scene.camera :as camera]
            [scene-demo.growth :as growth]))
(def width 5600)
(def height 2400)
(def viewport [1920 1080])
(def plates
  [{:id "language" :x 96 :y 96 :bg a/cream :ink a/ink :accent growth/forest :read 6
    :number "01 / THE PROGRAM AS SKETCHBOOK" :first "A language for" :second "little worlds."
    :body "Build the rules of a picture. Keep the freedom of a program. A scene can be composed, measured, inspected, and sampled."
    :code "(map picture ideas)" :note "ordinary functions, extraordinary pictures"
    :source "PICT / FUNCTIONAL PICTURES"}
   {:id "meaning" :x 1948 :y 96 :bg a/blue :ink a/cream :accent a/yellow :read 7
    :number "02 / CONTENT KNOWS ITS SHAPE" :first "Meaning before" :second "coordinates."
    :body "A heading stays a heading. Measured words give a card its size. Named anchors keep its connections attached."
    :code "words → metrics → layout → anchors" :note "change the sentence; let the picture follow"
    :source "PICT + TYPST / MEASUREMENT & SEMANTICS"}
   {:id "family" :x 3800 :y 96 :bg "#dfc4ac" :ink a/ink :accent growth/forest :read 7
    :number "03 / REUSE WITHOUT REPETITION" :first "One idea." :second "A family of forms."
    :body "Functions turn one definition into many instances. Stable names keep each object distinct; seeds keep its material character."
    :code "(map concept-card ideas)" :note "same grammar, different voices"
    :source "HOUDINI + OPENUSD / ATTRIBUTES & INSTANCES"}
   {:id "time" :x 3800 :y 1296 :bg growth/forest :ink a/cream :accent a/yellow :read 7
    :number "04 / A CLOCK INSIDE A CLOCK" :first "Time is a place" :second "you can visit."
    :body "Choose any moment. Clips carry local clocks. Retiming changes the rhythm without replaying everything that came before."
    :code "(clip/sample film 3/2)" :note "same time, same world, whichever way you arrive"
    :source "MOTION CANVAS + TIDAL / TEMPORAL COMPOSITION"}
   {:id "inspect" :x 1948 :y 1296 :bg "#e5e4ca" :ink a/ink :accent growth/forest :read 7
    :number "05 / A PICTURE YOU CAN QUESTION" :first "Ask the picture" :second "how it works."
    :body "Inspect bounds, anchors, and where a font or color came from. Keep the last good frame when an edit fails."
    :code "font → metrics → card → anchor" :note "the image has structure you can inspect"
    :source "VEGA + SALSA / QUERIES & DEPENDENCIES"}
   {:id "medium" :x 96 :y 1296 :bg "#292c48" :ink a/cream :accent a/yellow :read 8
    :number "06 / FROM LANGUAGE TO LIGHT" :first "A living medium." :second "An open horizon."
    :body "Lisp authors the scene. Graphics libraries shape and rasterize it. Preview and export share the same scene meaning."
    :code "The program is the sketchbook." :note "next: richer materials, diagrams, typography"
    :source "ONE SCENE / MANY FAITHFUL OUTPUTS"}])
(defn pose [plate end?]
  {:center [(+ (:x plate) 852 (if end? 12 -16)) (+ (:y plate) 504 (if end? -7 8))]
   :zoom (if end? 1.08 1.02) :roll (if end? 0.12 -0.18)})
(def camera-track
  (camera/track
    (vec (mapcat (fn [i]
      (let [plate (nth plates i) next (get plates (+ i 1))
            start (pose plate false) end (pose plate true)
            target (when next (pose next false)) [x y] (:center end) [nx ny] (:center target)]
        (into [{:id (str (:id plate) "/read") :duration (:read plate) :from start :to end}]
          (if next [{:id (str (:id plate) "/travel") :duration 2.8 :from end :to target :pullback 0.23
                     :controls (if (= i 2) [[(+ x 140) (+ y 300)] [(+ nx 140) (- ny 300)]]
                                  [[(s/lerp x nx 0.32) (+ y 65)] [(s/lerp x nx 0.72) (- ny 65)]])}] []))))
      (range (count plates))))))
(def duration (:duration camera-track))
(def extras
  [{:id "measure-a" :text "measure the words" :family "Instrument Serif" :size 38}
   {:id "measure-b" :text "give them room" :family "Instrument Serif" :size 38}
   {:id "measure-c" :text "follow the anchors" :family "Instrument Serif" :size 38}
   {:id "type-label" :text "A little world" :family "Instrument Serif" :size 72}
   {:id "logical-label" :text "LOGICAL" :size 15} {:id "ink-label" :text "INK" :size 15}
   {:id "effect-label" :text "EFFECT" :size 15}
   {:id "time-label" :text "LOCAL TIME / 0 → 6 SECONDS" :size 18}
   {:id "sample-label" :text "sample(t)" :family "Instrument Serif" :size 40}
   {:id "bl-label" :text "LISP" :size 22} {:id "scene-label" :text "SCENE" :size 22}
   {:id "frame-label" :text "FRAME" :size 22}])
(defn requests []
  (into extras
    (vec (mapcat (fn [plate]
      (mapv (fn [[key family size width]]
        (merge {:id (str (:id plate) "/" (name key)) :text (get plate key) :family family :size size}
               (when width {:width width}) (when (= key :second) {:italic true})))
        [[:number "DM Sans" 16 nil] [:first "Instrument Serif" 106 nil]
         [:second "Instrument Serif" 106 nil] [:body "DM Sans" 29 785]
         [:code "Instrument Serif" 44 nil] [:note "Patrick Hand" 28 780] [:source "DM Sans" 13 nil]])) plates))))
(defn prepare [opts]
  (let [shaped (text/measure! (requests) opts)]
    {:runs (into {} (mapv (fn [[id run]] [id (assoc run :path (g/path-data (:commands run)))]) (:runs shaped)))
     :shaping (dissoc shaped :runs)}))
(defn type-at [prepared instance key x baseline color]
  (let [run (get (:runs prepared) key)]
    (when (nil? run) (s/fail "Missing atlas typography" {:id key}))
    (a/shape instance :path {:d (:path run) :fill color
                             :transform (g/svg-transform (g/translate x (- baseline (:baseline run))))})))
(defn label [prepared id x baseline color] (type-at prepared id id x baseline color))
(defn arrow [id x y length color] (a/arrow id x y length color))
(defn language-art []
  [(a/paper "language/field" 970 140 650 720 growth/forest)
   (a/disc "language/sun" 1475 280 110 a/yellow)
   (a/shape "language/sun-dots" :circle {:cx 1475 :cy 280 :r 110 :fill (m/ref "dots") :opacity 0.5})
   (a/group "language/botany" {:transform "translate(804 -7) scale(0.9)"} [(growth/plant 6)])
   (a/shape "language/seed" :ellipse {:cx 1290 :cy 747 :rx 12 :ry 18 :fill growth/rose})
   (a/texture "language/field-grain" 970 140 650 720 "grain")])
(defn meaning-art [prepared]
  (vec (mapcat (fn [i]
    (let [y (+ 170 (* i 235)) id (str "meaning/card-" i)]
      (into [(a/paper (str id "/shadow") 1040 (+ y 9) 520 170 "#172449")
             (a/rough-box (str id "/paper") 1032 y 520 170 a/cream)
             (type-at prepared (str id "/title") (nth ["measure-a" "measure-b" "measure-c"] i) 1060 (+ y 94) a/ink)
             (a/disc (str id "/anchor") 1292 (+ y 170) 5 a/vermilion)]
        (if (< i 2) [(a/ink-line (str id "/link") (str "M 1292 " (+ y 175) " L 1292 " (+ y 226))
                                  {:stroke a/yellow :stroke-width 2})] [])))) (range 3))))
(defn family-art []
  (mapv (fn [i]
    (let [id (str "family/instance-" i) x (+ 990 (* (mod i 2) 305)) y (+ 190 (* (quot i 2) 225))
          color (nth [a/cream "#b8c99a" "#e4b657" "#b8c9d8" "#de795d" a/cream] i)]
      (a/group id {:transform (str "translate(" x " " y ") rotate(" (if (= 0 (mod i 2)) -3 3) ")")}
        [(a/paper (str id "/shadow") 5 8 270 185 "#b59880")
         (a/rough-box (str id "/paper") 0 0 270 185 color)
         (growth/leaf (str id "/leaf") 136 154 (if (= 0 (mod i 2)) -23 23) (+ 103 (* i 3)) 35 1
                      (nth [growth/sage a/yellow a/cream "#dfc4ac" "#e5e4ca" "#b8c9d8"] i))
         (a/shape (str id "/dots") :circle {:cx 220 :cy 42 :r 23 :fill (m/ref "dots") :opacity 0.3})]))) (range 6)))
(defn time-art [prepared]
  [(a/rough-box "time/chart" 980 170 640 675 a/cream)
   (label prepared "time-label" 1020 225 a/ink)
   (a/ink-line "time/axis" "M 1040 690 L 1560 690 M 1040 690 L 1040 310" {:stroke-width 1 :opacity 0.6})
   (a/ink-line "time/curve" "M 1040 650 C 1150 650 1150 360 1280 360 C 1410 360 1430 580 1560 580"
               {:stroke growth/forest :stroke-width 4})
   (a/group "time/samples" {}
     (mapv (fn [[i x y]]
       (a/group (str "time/sample-" i) {}
         [(a/ink-line (str "time/sample-" i "/guide") (str "M " x " " y " L " x " 690")
                       {:stroke "#a6a894" :stroke-width 1 :stroke-dasharray "4 6"})
          (a/disc (str "time/sample-" i "/dot") x y 9 a/vermilion)]))
       [[0 1040 650] [1 1140 534] [2 1280 360] [3 1400 452] [4 1560 580]]))
   (label prepared "sample-label" 1190 780 growth/forest)])
(defn rect-bounds [id box color]
  (let [[x y w h] box] (a/shape id :rect {:x x :y y :width w :height h :fill "none"
                                         :stroke color :stroke-width 2 :stroke-dasharray "7 5"})))
(defn inspect-art [prepared]
  (let [run (get (:runs prepared) "type-label") x 1060 y (- 480 (:baseline run))
        matrix (g/translate x y) logical (g/bounds matrix (:logical run)) ink (g/bounds matrix (:ink run))
        [lx ly w h] logical]
    [(a/paper "inspect/card-shadow" 1000 315 620 315 "#c8c5a8")
     (a/rough-box "inspect/card" 990 305 620 315 a/cream)
     (label prepared "type-label" x 480 a/ink)
     (rect-bounds "inspect/effect" [(- lx 12) (- ly 12) (+ w 24) (+ h 24)] "#9b76a5")
     (rect-bounds "inspect/logical" logical a/vermilion)
     (rect-bounds "inspect/ink" ink "#268a79")
     (a/ink-line "inspect/baseline" (str "M " x " 480 L " (+ x w) " 480") {:stroke a/blue :stroke-width 1})
     (a/disc "inspect/east" (+ lx w) (+ ly (/ h 2)) 6 a/vermilion)
     (label prepared "logical-label" 1020 710 a/vermilion)
     (label prepared "ink-label" 1240 710 "#268a79")
     (label prepared "effect-label" 1410 710 "#9b76a5")]))
(defn medium-art [prepared]
  (into [(a/shape "medium/orbit" :ellipse {:cx 1290 :cy 500 :rx 315 :ry 250 :fill "none"
                                         :stroke "#828caa" :stroke-width 1 :stroke-dasharray "3 9"})
         (arrow "medium/link-a" 1100 500 100 a/yellow) (arrow "medium/link-b" 1360 500 100 a/yellow)]
    (mapv (fn [[id key x color]]
      (a/group id {}
        [(a/disc (str id "/shadow") (+ x 5) 505 71 "#171b30")
         (a/disc (str id "/disc") x 500 71 color)
         (type-at prepared (str id "/label") key (- x 34) 508 a/ink)]))
      [["medium/lisp" "bl-label" 1035 a/cream] ["medium/scene" "scene-label" 1290 growth/sage]
       ["medium/frame" "frame-label" 1545 a/yellow]])))
(defn plate [prepared item]
  (let [id (:id item) ink (:ink item) accent (:accent item)]
    (a/group id {:transform (g/svg-transform (g/translate (:x item) (:y item)))}
      (into [(a/paper (str id "/shadow") 10 14 1704 1008 "#beb8a3")
             (a/paper (str id "/stock") 0 0 1704 1008 (:bg item))
             (label prepared (str id "/number") 80 74 ink)
             (a/ink-line (str id "/rule") "M 80 100 L 1624 100" {:stroke ink :stroke-width 1 :opacity 0.55})
             (label prepared (str id "/first") 76 224 ink)
             (label prepared (str id "/second") 76 333 accent)
             (label prepared (str id "/body") 82 415 ink)
             (label prepared (str id "/code") 82 675 accent)
             (label prepared (str id "/note") 82 745 ink)
             (a/ink-line (str id "/bottom-rule") "M 80 908 L 1624 908" {:stroke ink :stroke-width 1 :opacity 0.55})
             (label prepared (str id "/source") 82 953 ink)]
        (into (cond (= id "language") (language-art) (= id "meaning") (meaning-art prepared)
                    (= id "family") (family-art) (= id "time") (time-art prepared)
                    (= id "inspect") (inspect-art prepared) :else (medium-art prepared))
          [(a/texture (str id "/grain") 0 0 1704 1008 "grain")])))))
(defn world [prepared]
  {:width width :height height :time 0 :scene "the-program-is-the-sketchbook" :seed 73
   :materials [(m/paper "grain" 73) (m/halftone "dots" 5 0.9 growth/forest)
               (m/hatch "leaf-hatch" 6 growth/forest) (m/grid "grid" 36 "#8e9e94")]
   :objects (into [(a/paper "atlas/stock" 0 0 width height "#e5decb")
                   (a/shape "atlas/grid" :rect {:x 0 :y 0 :width width :height height :fill (m/ref "grid") :opacity 0.12})
                   (a/ink-line "atlas/journey" "M 948 600 L 2800 600 L 4652 600 C 5600 600 5600 1800 4652 1800 L 2800 1800 L 948 1800"
                               {:stroke "#a7a18a" :stroke-width 3 :stroke-dasharray "7 15"})]
                  (mapv (fn [p] (plate prepared p)) plates))})
(defn frame-plan [t]
  (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Atlas time outside its finite film" {:time t}))
  (let [pose (camera/sample camera-track t)] {:time t :camera pose :matrix (camera/matrix pose viewport)}))
