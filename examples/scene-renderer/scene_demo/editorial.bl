(ns scene-demo.editorial
  (:require [scene.core :as s] [scene.atelier :as a] [scene.material :as m]))

(def duration 4)
(def materials [(m/paper "grain" 41) (m/halftone "dots" 5 0.85 "#172449")
                (m/hatch "hatch" 4 "#172449") (m/grid "grid" 28 "#a6b4c7")])

(defn node [id x caption kind p]
  (a/reveal id p
    [(a/disc (str id "-shadow") (+ x 4) 167 34 "#ccc4ab")
     (a/disc (str id "-body") x 162 34 (if (= kind 1) a/yellow "#e1a297"))
     (a/shape (str id "-ring") :circle {:cx x :cy 162 :r 34 :fill "none" :stroke a/ink :stroke-width 2})
     (cond
       (= kind 0) (a/annotation (str id "-glyph") (- x 14) 173 34 "λ" {})
       (= kind 1) (a/group (str id "-glyph") {:transform (str "translate(" (- x 12) " 148)")}
                    [(a/paper (str id "-tile1") 0 0 18 18 a/blue)
                     (a/paper (str id "-tile2") 9 9 18 18 a/ink)])
       :else (a/group (str id "-glyph") {}
               (for [i (range 3) j (range 3)]
                 (a/paper (str id "-pixel-" i "-" j) (+ (- x 12) (* i 9)) (+ 150 (* j 9))
                          6 6 (if (= i j) a/vermilion a/blue)))))
     (a/annotation (str id "-caption") x 228 27 caption {:text-anchor "middle"})]))

(defn scene [t]
  (when (not (and (s/finite? t) (<= 0 t) (< t duration)))
    (s/fail "Editorial film time outside [0,4)" {:time t}))
  (let [intro (a/stagger t 0 0.15 0.8)
        p1 (a/stagger t 1 0.24 0.7) p2 (a/stagger t 2 0.24 0.7)
        p3 (a/stagger t 3 0.24 0.7)]
    {:width 1080 :height 1080 :time t :scene "field-notes" :local-time t :seed 41
     :materials materials
     :clips [(a/paper "hero-mask" 54 347 972 509 "white")]
     :objects
     [(a/paper "stock" 0 0 1080 1080 a/cream)
      (a/texture "stock-grain" 0 0 1080 1080 "grain")
      (a/label "masthead" 56 54 15 "FIELD NOTES     /     001" {:letter-spacing 2.1 :font-weight 600})
      (a/label "edition" 1025 54 14 "BEAM LISP   •   MOTION STUDIES" {:text-anchor "end" :letter-spacing 1.2})
      (a/ink-line "top-rule" "M 55 74 L 1025 74" {:stroke-width 1 :opacity 0.7})
      (a/display "title-first" 52 174 94 "From a thought" {})
      (a/display "title-second" 52 271 100 "to a living frame." {:font-style "italic" :fill a/blue})
      (a/label "deck" 56 315 20 "A small language for things that move." {:fill "#5b5a58"})
      (a/group "hero" {:clip-path "url(#hero-mask-clip)"}
        [(a/paper "blue-field" 54 347 972 509 a/blue)
         (a/shape "field-grid" :rect {:x 54 :y 347 :width 972 :height 509
                                      :fill (m/ref "grid") :opacity 0.13})
         (a/disc "sun" 855 485 147 a/yellow)
         (a/shape "sun-dots" :circle {:cx 855 :cy 485 :r 147 :fill (m/ref "dots") :opacity 0.5})
         (a/disc "sun-center" 855 485 109 a/yellow)
         (a/shape "left-hatch" :rect {:x 54 :y 600 :width 170 :height 256
                                     :fill (m/ref "hatch") :opacity 0.4})
         (a/ink-line "orbit-line" "M 65 738 C 280 928 788 900 1049 551"
                     {:stroke "#9aa9cc" :stroke-width 1.2 :stroke-dasharray "5 9"})
         (a/annotation "margin-note" 92 423 25 "a world, made of values" {:fill "#f1ebd9" :transform "rotate(-6 92 423)"})
         (a/ink-line "note-arrow" "M 131 436 Q 122 472 181 496 L 172 481 M 181 496 L 164 496"
                     {:stroke a/cream :stroke-width 1.6})
         (a/drift "floating-composition" t 4
          [(a/reveal "card-reveal" intro
            [(a/group "back-leaf" {:transform "translate(232 509) rotate(7)"}
               [(a/rough-box "back-leaf-stock" 0 0 608 265 "#d5a295")
                (a/shape "back-leaf-hatch" :rect {:x 0 :y 0 :width 608 :height 265 :fill (m/ref "hatch") :opacity 0.32})])
             (a/group "middle-leaf" {:transform "translate(207 484) rotate(1)"}
               [(a/rough-box "middle-stock" 0 0 608 265 "#b9c6d5")
                (a/shape "middle-lines" :rect {:x 0 :y 0 :width 608 :height 265 :fill (m/ref "grid")})])
             (a/cutout "main-card" "translate(190 458) rotate(-5)" 0 0 640 286 a/cream
               [(a/shape "card-grid" :rect {:x 1 :y 1 :width 638 :height 284 :fill (m/ref "grid") :opacity 0.48})
                (a/texture "card-fibres" 2 2 636 282 "grain")
                (a/label "card-index" 27 36 12 "SCENE / 01" {:letter-spacing 2 :fill "#65615c"})
                (a/annotation "equation" 320 82 39 "an idea → a little universe" {:text-anchor "middle"})
                (a/arrow "flow-a" 188 162 86 a/ink)
                (a/arrow "flow-b" 368 162 86 a/ink)
                (node "source" 140 "compose" 0 p1)
                (node "scene" 320 "evaluate" 1 p2)
                (node "pixels" 500 "make visible" 2 p3)
                (a/ink-line "card-footer-rule" "M 27 252 L 612 252" {:stroke-width 0.7 :opacity 0.45})
                (a/label "card-footer" 28 272 11 "SAME TIME. SAME WORLD. EVERY TIME." {:letter-spacing 1.6})])])])
         (a/annotation "hand-note" 843 725 29 "nothing hidden." {:fill a/cream :transform "rotate(7 843 725)"})
         (a/ink-line "hand-underline" "M 852 739 Q 932 758 1002 749" {:stroke a/yellow :stroke-width 2})
         (a/label "plate-caption" 80 829 12 "FIG. 01   /   A SCENE IS A FUNCTION" {:letter-spacing 1.6 :fill a/cream})
         (a/texture "ink-grain" 54 347 972 509 "grain")])
      (a/label "lower-index" 56 901 14 "THE IDEA" {:letter-spacing 2 :fill a/vermilion :font-weight 600})
      (a/display "closing" 54 952 44 "Compose the rules. Let the picture follow." {})
      (a/label "closing-deck" 57 989 17 "Type, geometry, material, time — all ordinary Lisp values." {:fill "#5b5a58"})
      (a/ink-line "bottom-rule" "M 55 1020 L 1025 1020" {:stroke-width 1 :opacity 0.7})
      (a/label "footer-left" 56 1048 11 "PROCEDURAL ART / COMPOSED FROM LISP VALUES" {:letter-spacing 1.4})
      (a/label "footer-right" 1025 1048 11 "DESIGNED IN BL     /     2026" {:text-anchor "end" :letter-spacing 1.4})]}))
