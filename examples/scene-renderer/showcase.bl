(ns scene-demo.showcase-build
 (:require [scene-demo.showcase :as art] [scene.text :as text] [scene.geometry :as geometry]
           [scene.core :as scene] [interop]))
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(def sources ["examples/scene-renderer/showcase.bl" "examples/scene-renderer/scene_demo/showcase.bl"
 "examples/scene-renderer/showcase_worker.py" "examples/scene-renderer/showcase/surface.vert"
 "examples/scene-renderer/showcase/surface.frag" "examples/scene-renderer/showcase/flat.vert"
 "examples/scene-renderer/showcase/background.frag" "examples/scene-renderer/showcase/type.vert"
 "examples/scene-renderer/showcase/type.frag" "examples/scene-renderer/showcase/post.frag"
 "examples/scene-renderer/showcase/particle.vert" "examples/scene-renderer/showcase/particle.frag"
 "priv/lib/scene/score.bl" "priv/lib/scene/text.bl" "priv/lib/scene/text_worker.py"
 "priv/lib/scene/geometry.bl" "priv/lib/scene/camera.bl" "priv/lib/scene/core.bl" "priv/lib/live/hiccup.bl"])
(let [args (clojure.io/current-command-line-args) out (Path/expand (or (first args) "/tmp/bl-showcase"))
      captured (mapv (fn [p] [p (File/read! p)]) sources)
      font-names ["DMSans.ttf" "InstrumentSerif-Regular.ttf" "InstrumentSerif-Italic.ttf" "PatrickHand-Regular.ttf"
                  "DMSans-OFL.txt" "InstrumentSerif-OFL.txt" "PatrickHand-OFL.txt"]
      fonts (mapv (fn [p] [p (File/read! (str "examples/scene-renderer/assets/fonts/" p))]) font-names)
      identity {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                :fonts (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) fonts)
                :clock [1800 60 1] :seed 7331 :backend "EGL / GLES3 / captured procedural surface and material shaders"}
      revision (digest (interop/->json identity)) dir (str out "/" revision)]
 (File/mkdir_p! (str dir "/sources")) (File/mkdir_p! (str dir "/font")) (File/mkdir_p! (str dir "/shaders"))
 (doseq [[p bytes] captured] (File/write! (str dir "/sources/" (replace-str p "/" "__")) bytes)
   (when (or (String/ends_with? p ".vert") (String/ends_with? p ".frag")) (File/write! (str dir "/shaders/" (Path/basename p)) bytes)))
 (doseq [[p bytes] fonts] (File/write! (str dir "/font/" p) bytes))
 (let [shaped (text/measure! art/typography {:font-dir (str dir "/font") :worker (str dir "/sources/priv__lib__scene__text_worker.py")})
       specs (mapv (fn [spec] (let [run (get (:runs shaped) (:id spec))]
                  (assoc spec :path (geometry/path-data (:commands run)) :ink-bounds (:ink run)))) art/typography)
       plan {:version 1 :viewport [1920 1080] :fps [60 1] :duration 30 :typography specs :audio (art/score)
             :frames (mapv (fn [k] (assoc (art/sample (/ k 60)) :frame k)) (range 1800))}]
  (when (not= (art/sample 12.34) (last (mapv art/sample [29 0 20 4 12.34]))) (scene/fail "Showcase has seek history" {}))
  (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources)) (scene/fail "Sources changed during plan capture" {}))
  (File/write! (str dir "/plan.json.tmp") (interop/->json plan)) (File/rename! (str dir "/plan.json.tmp") (str dir "/plan.json"))
  (File/write! (str dir "/provenance.json") (interop/->json (assoc identity :revision revision :shaping (dissoc shaped :runs)
     :capture "Explicit source/font capture and load-before-capture qualification; native driver remains an external backend dependency")))
  (File/write! (str out "/manifest.json.tmp") (interop/->json {:revision revision :directory dir :frames 1800 :fps [60 1] :duration 30}))
  (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
  (println (str "Captured commercial showcase plan: " dir))))
