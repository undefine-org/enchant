(ns scene-demo.preview (:require [web] [interop]))
(def out (Path/expand (or (first (clojure.io/current-command-line-args)) "/tmp/bl-scene")))
(def sources ["examples/scene-renderer/scene_demo/film.bl" "priv/lib/scene/core.bl"
              "priv/lib/scene/material.bl" "priv/lib/live/hiccup.bl" "examples/scene-renderer/build.bl"
              "examples/scene-renderer/raster.py" "examples/scene-renderer/preview.html"])
(defn signature []
  (mapv (fn [p] (try (File/read! p) (catch _ "missing"))) sources))
(defn router [conn]
  (let [parts (:path_info conn)
        relative (if (empty? parts) "index.html" (join "/" parts))
        path (Path/expand relative out)]
    (if (and (starts-with? path (str out "/")) (File/regular? path))
      (web/bytes conn (cond (ends-with? path ".png") "image/png"
                           (ends-with? path ".svg") "image/svg+xml"
                           (ends-with? path ".json") "application/json"
                           :else "text/html; charset=utf-8") (File/read! path))
      (web/text conn 404 "not found"))))
(defn rebuild []
  (println "Building latest scene revision…")
  (let [result (System/cmd (Path/expand "bin/bl" (BeamLisp/cwd))
                 (list "-p" "examples/scene-renderer" "run" "examples/scene-renderer/build.bl" "--" out)
                 (list (tuple :cd (BeamLisp/cwd)) (tuple :stderr_to_stdout true)))
        diagnostic (let [output (erlang/element 1 result)]
                     (if (empty? output) "Scene build failed; inspect watcher output for details." output))
        ok (= 0 (erlang/element 2 result))]
    (File/write! (str out "/status.json.tmp")
                 (interop/->json {:ok ok :diagnostic diagnostic}))
    (File/rename! (str out "/status.json.tmp") (str out "/status.json"))
    (println (if ok "Published scene revision." (str "Edit rejected; keeping last frame.\n" diagnostic)))))
(File/mkdir_p! out)
(web/serve {:port 4048 :ip (tuple 127 0 0 1) :log :off :plug router})
(println "Scene preview: http://127.0.0.1:4048 — Ctrl-C stops this session")
(loop [previous nil]
  (let [current (signature)]
    (when (not= current previous) (rebuild))
    (Process/sleep 500)
    (recur current)))
