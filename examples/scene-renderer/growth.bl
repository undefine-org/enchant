(ns scene-demo.growth-build
  (:require [scene-demo.growth :as art] [scene.core :as scene] [interop]))
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(def sources ["examples/scene-renderer/growth.bl" "examples/scene-renderer/scene_demo/growth.bl"
              "examples/scene-renderer/raster.py" "priv/lib/scene/text_worker.py" "priv/lib/scene/text.bl"
              "priv/lib/scene/geometry.bl" "priv/lib/scene/motion.bl" "priv/lib/scene/clip.bl"
              "priv/lib/scene/core.bl" "priv/lib/scene/material.bl" "priv/lib/scene/atelier.bl"
              "priv/lib/live/hiccup.bl"])
(defn command! [program args]
  (let [result (System/cmd program (to-list args) (list (tuple :stderr_to_stdout true)))]
    (when (not= 0 (erlang/element 2 result)) (scene/fail "Growth graphics failed" {:output (erlang/element 1 result)}))
    (erlang/element 1 result)))
(let [args (clojure.io/current-command-line-args)
      out (Path/expand (or (first args) "/tmp/bl-growth")) film? (= "film" (second args))
      times (if film? (mapv (fn [k] (scene/frame-time k 24 1)) (range 288)) [0.75 2.8 5 8.2 11])
      captured (mapv (fn [p] [p (File/read! p)]) sources)
      fonts (mapv (fn [p] [p (File/read! (str "examples/scene-renderer/assets/fonts/" p))])
                  ["DMSans.ttf" "InstrumentSerif-Regular.ttf" "InstrumentSerif-Italic.ttf" "PatrickHand-Regular.ttf"
                   "DMSans-OFL.txt" "InstrumentSerif-OFL.txt" "PatrickHand-OFL.txt"])
      rsvg (or (System/get_env "SCENE_RSVG") "rsvg-convert")
      identity {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                :fonts (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) fonts)
                :backend (String/trim (command! rsvg ["--version"])) :times times :fps [24 1]
                :quality "2x Lanczos / canonical Pango outlines / paper tile v1" :seed 73}
      revision (digest (interop/->json identity)) final-dir (str out "/" revision)
      dir (str out "/.pending-" revision "-" (System/pid))]
  (when (not (File/dir? final-dir))
    (File/mkdir_p! (str dir "/font")) (File/mkdir_p! (str dir "/sources"))
    (doseq [[p bytes] fonts] (File/write! (str dir "/font/" p) bytes))
    (doseq [[p bytes] captured] (File/write! (str dir "/sources/" (replace-str p "/" "__")) bytes))
    (let [prepared (art/prepare {:font-dir (str dir "/font") :worker (str dir "/sources/priv__lib__scene__text_worker.py")})]
      (File/write! (str dir "/provenance.json") (interop/->json (assoc identity :shaping (:shaping prepared) :timeline art/schedule)))
      (doseq [pair (map-indexed (fn [k t] [k t]) times)]
        (let [[k t] pair]
          (File/write! (str dir "/" k ".svg") (scene/svg (art/scene prepared t)))))
      (when (not= (art/scene prepared 5) (last (mapv (fn [t] (art/scene prepared t)) [11 0 8 2 5])))
        (scene/fail "Arbitrary seeking changed growth scene" {})))
    (command! "python3" [(str dir "/sources/examples__scene-renderer__raster.py") "raster" dir "--count" (str (count times))
                        "--font-dir" (str dir "/font") "--font" (str dir "/font/InstrumentSerif-Regular.ttf")
                        "--scale" "2" "--rsvg" rsvg])
    (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources))
      (scene/fail "Sources changed during growth export; publication held" {}))
    (File/rename! dir final-dir))
  (File/write! (str out "/manifest.json.tmp")
    (interop/->json {:revision revision :frames (count times) :fps [24 1] :duration (if film? 12 nil)
                    :width 1080 :height 1080 :backend (:backend identity) :seed 73 :sample-times (if film? nil times)
                    :quality (:quality identity)}))
  (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
  (when film? (command! "python3" [(str final-dir "/sources/examples__scene-renderer__raster.py") "export" out
                                 "--out" (str out "/a-seed-of-possibility.mp4")]))
  (println (str "Published " (count times) " growth frames: " final-dir)))
