    "priv",
    "native",
    "tooling/drop",
    "packages/job-runner",
    "env.bl",
    "bl.lock",
    "flake.nix",
    "flake.lock",
    "scripts/prepare-checkout-platform",
    "scripts/prepare-checkout-sdk",
    "scripts/sdk-inputs",
    "scripts/prepare-release.bl",
    "scripts/produce-sdk.bl",
    "scripts/qualify-artifact-generation",
    "scripts/assemble-compiler-generations.py",
    "scripts/compiler-unit-baseline.py",
    "scripts/check-produced-compiler.py",
    "scripts/retain-compiler-preparation.py",
    "scripts/demo-artifact-production",
    "scripts/check-source-floor",
    "scripts/check-execution-history",
    "test/scripts/artifact-generation.bl",
