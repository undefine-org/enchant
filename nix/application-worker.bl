;; Trusted worker entry: request JSON is data; the SDK's existing producer owns
;; compilation, descriptor emission and workspace admission.
(ns artifact.application-worker
  (:require [build :as build] [build-plan :as plan] [build-log :as blog]
            [bl.env :as env] [vm.osenv :as osenv] [app-resource :as app]))

(defn producer-inputs
 "Capture the normal producer's resolved dependency closure. This is a
  conservative input selection, not a second constructor or a replay witness."
 [namespace]
 (let [nodes (mapcat
               (fn [name]
                 (BeamLisp.BuildPlan/nodes_from_resolver name
                   (fn [dependency]
                     (when-let [file (BeamLisp.Loader/source_path dependency)]
                       (plan/memo-node dependency (BeamLisp.Loader/read_source file))))))
               [namespace "core" "sugar"])
       names (sort (distinct (map :ns nodes)))]
   (when-not (and (some #(= namespace %) names) (<= (count names) 256))
     (throw (ex-info "Application producer input selection is invalid" {:namespace namespace})))
   (to-list (Enum/map names
     (fn [name]
       (let [file (BeamLisp.Loader/source_path name)
             source (BeamLisp.Loader/read_source file)]
         {:namespace name :sha256 (crypto/hash :sha256 source)}))))))

(defn emit-produced-unit!
 "Retain the exact runtime modules and source selection from normal production.
  The artifact records membership; replay coverage stays in the actual beams."
 [namespace inputs record ebin directory]
 (let [key (BeamLisp.AOTCache/compiler_key) modules (blog/module-names (:modules record))
       digests (into {} (:digests record))]
  (when-not (and (= key (:key record)) (seq modules) (= modules (distinct modules))
                (= inputs (producer-inputs namespace))
                (= (:hash record) (BeamLisp.AOT/ns_closure_hash namespace)))
   (throw (ex-info "Application unit lacks its original producer module inventory" {})))
  (File/mkdir_p! directory)
  (let [members (Enum/map modules
                 (fn [name]
                  (when-not (= name (Path/basename name))
                   (throw (ex-info "Invalid produced application module" {:module name})))
                  (let [file (Path/join ebin (str name ".beam"))
                        bytes (File/read! file) sha (crypto/hash :sha256 bytes)]
                   (when-not (and (= (get digests name) (String/downcase (Base/encode16 sha)))
                                  (BeamLisp.AOTCache/beam_provenance_matches? file key (:hash record)))
                    (throw (ex-info "Produced application bytes changed" {:module name})))
                   (File/write! (Path/join directory (str name ".beam")) bytes)
                   {:module name :sha256 sha})))]
   (File/write! (Path/join directory "artifact-unit.term")
    (erlang/term_to_binary {:version 1 :namespace namespace :compiler-key key
                           :inputs inputs :modules members
                           :coverage {:scope :artifact-membership :source-staged true
                                      :execution-entry-inventory-complete false}}))
   ;; Membership adds no complete replay claim. The receiver checks the real
   ;; runtime beams; ordinary callers retain their Source-effect contract.
   (BeamLisp.AOT/verify_unit directory))))

(let [request (Jason/decode! (File/read! (System/fetch_env! "BL_APPLICATION_REQUEST")))
      base (System/get_env "BL_APPLICATION_BASE")
      previous (when base (Jason/decode! (File/read! (Path/join base "result.json"))))
      root (System/fetch_env! "BL_APPLICATION_SOURCE")
      out (System/fetch_env! "BL_APPLICATION_OUTPUT")
      project (env/project root)
      _ (when (seq (:errors project))
          (throw (ex-info "Application declaration is invalid" {:errors (:errors project)})))
      _ (Process/put osenv/PDICT-KEY (merge (osenv/overlay) (osenv/validate (or (:env project) {}))))
      _ (doseq [path (:paths project)] (BeamLisp.Env/add_search_path path))
      relative (fn [path] (when path (Path/join root path)))
      ex (get request "ex")
      options {:root root :force? (= true (get request "force")) :scope (if (= "scoped" (get request "scope")) :scoped :full) :out (Path/join out "ebin")
               :sources (Enum/map (get request "sources") relative)
               :world (relative (get request "world"))
               :exclude (vec (distinct (concat (Enum/map (get request "exclude") relative)
                                                (get-in project [:build :exclude]))))
               :jobs (get request "jobs")
               :native (get request "native")
               :ex (when ex {:root (relative (get ex "root")) :exclude (get ex "exclude")})
               :log println}
      unit-counts (atom {:compiled 0 :restored 0})
      result (build/produce! options)
      errors (Enum/map (:errors result) identity)]
  (when (seq errors) (throw (ex-info (str "Application production failed: " (pr-str errors)) {:errors errors})))
  ;; Per-request wall-clock history belongs to the coordinator/Nix log. Keep
  ;; actual source/module facts in the immutable product without timestamps.
  (let [log (Path/join out "ebin/build.log")]
    (when (File/regular? log)
      (blog/write! log (blog/facts-of (dissoc (blog/replay (blog/read-facts log)) :runs :ended)))))
  (File/write! (Path/join out "producer-projection.term")
    (erlang/term_to_binary (select-keys result
      [:manifest :runtime-manifest :profile :out :runtime-out :native-admission])))
  (let [planning (when-not (get request "world")
                   (or (:plan result)
                     (throw (ex-info "Application producer did not return its source plan" {}))))
        units
        (when-not (get request "world")
          (let [sources (Enum/map (:order planning)
                          (fn [node] {:namespace (:ns node) :file (:path node)}))]
              (Enum/map sources
                (fn [source]
                  (let [namespace (:namespace source)
                        name (str namespace)
                        inputs (producer-inputs name)
                        relative (str "units/" name)
                        directory (Path/join out relative)
                        _ (when (some #(contains? #{"" "." ".."} %) (String/split name "/"))
                            (throw (ex-info "Invalid application namespace output path" {:namespace name})))
                        prior (when (and base (not (:force? options)) (File/regular? (Path/join directory "artifact-unit.term")))
                                (BeamLisp.AOT/verify_unit directory))
                        record (get (:manifest result) (:file source))
                        produced-digests (into {} (:digests record))
                        reusable? (and prior (= name (get-in prior [:manifest :namespace]))
                          (= (sort (blog/module-names (:modules record)))
                             (sort (Enum/map (get-in prior [:manifest :modules]) (fn [member] (:module member)))))
                          (every? (fn [member]
                            (= (get produced-digests (:module member))
                               (String/downcase (Base/encode16 (:sha256 member)))))
                            (get-in prior [:manifest :modules]))
                          (= inputs (get-in prior [:manifest :inputs])))
                        _ (swap! unit-counts update (if reusable? :restored :compiled) inc)
                        verified (if reusable? prior
                          (do
                            (when (File/exists? directory) (File/rm_rf! directory))
                            (emit-produced-unit! name inputs record (Path/join out "ebin") directory)))]
                    {:namespace name :source (Path/relative_to (:file source) root) :directory relative :modules (count (get-in verified [:manifest :modules]))})))
              ))
        incoming (when planning
                   (Enum/map (:order planning)
                     (fn [node]
                       {:namespace (:ns node) :path (Path/relative_to (:path node) root)
                        :content (:hash node) :interface (:iface node)
                        :key (get (:key planning) (:path node))
                        :requires (Enum/map (:reqs node) identity)})))
        owned (set (Enum/map (or incoming []) #(:path %)))
        retained (if (= "scoped" (get request "scope"))
                   (filter #(not (contains? owned (get % "path"))) (or (get previous "impact") []))
                   (list))
        impact (concat (Enum/map retained
                         (fn [row] {:namespace (get row "namespace") :path (get row "path")
                                    :content (get row "content") :interface (get row "interface")
                                    :key (get row "key") :requires (get row "requires")})) incoming)
        order (when planning
                (:order (plan/plan (Enum/map impact
                          (fn [row] {:ns (:namespace row) :path (:path row) :hash (:content row)
                                     :iface (:interface row) :reqs (:requires row)})))))
        old-units (into {} (Enum/map (or (get previous "units") []) (fn [row] [(get row "namespace") row])))
        new-units (into {} (Enum/map (or units []) (fn [row] [(:namespace row) row])))
        units (when planning
                (Enum/map order
                  (fn [node]
                    (or (get new-units (:ns node))
                        (let [row (get old-units (:ns node))]
                          (when-not row (throw (ex-info "Scoped application lost a retained unit" {:namespace (:ns node)})))
                          {:namespace (get row "namespace") :directory (get row "directory")
                           :source (:path node) :modules (get row "modules")})))))
        _ (let [kept (set (Enum/map (or units []) #(:directory %)))]
            (doseq [row (or (get previous "units") [])]
              (let [relative (get row "directory")]
                (when-not (and (String/starts_with? relative "units/")
                                (not (some #(contains? #{"" "." ".."} %) (String/split relative "/"))))
                  (throw (ex-info "Invalid retained application unit path" {})))
                (when-not (contains? kept relative) (File/rm_rf! (Path/join out relative))))))
        resource (app/write-project! project (or (:runtime-out result) (Path/join out "ebin")))]
    (File/write! (Path/join out "result.json")
      (Jason/encode! {:built (:built result) :compiled (:compiled result) :cached (:cached result)
                     :ex-built (:ex-built result) :errors errors
                     :unit-compiled (:compiled @unit-counts) :unit-restored (:restored @unit-counts)
                     :units (or units (list))
                     :world-unit (when (get request "world") (Path/relative_to (:out result) out))
                     :impact (when planning (Enum/map order
                                                (fn [node] (some #(when (= (:namespace %) (:ns node)) %) impact))))
                     :runtime-out (when (:runtime-out result) (Path/relative_to (:runtime-out result) out))
                     :app-file (when (:ok? resource) (Path/basename (:path resource)))
                     :app-why (:why resource)
                     :app-resource (:ok? resource)}))))
