(ns verb2
  (:require [bl.util :as u] [bl.ports :as ports]))
(def ^:private Ports (erlang/binary_to_atom "Elixir.BeamLisp.Daemon.Ports"))
(def f "/tmp/bl117/run/beam_lisp/ports/web@3ee6b1d9fe7a49ed")

(println "1. claim file on disk, decoded UNSAFELY (what the bytes really are):")
(def raw (erlang/binary_to_term (File/read! f)))
(println "   keys:" (pr-str (keys raw)))
(println "   :dest ->" (pr-str (erlang/apply (erlang/binary_to_atom "maps") :get (list :dest raw :none))))

(println "2. Ports.list() — the module decodes with [:safe]:")
(println "   " (pr-str (erlang/apply Ports :list (list))))

(println "3. now seed JUST the two new atoms, as any reader that knew the key set would have:")
(def _d (erlang/binary_to_atom "dest"))
(println "   Ports.list() again:" (pr-str (erlang/apply Ports :list (list))))

(println "4. and the REAL bl.ports/run render over that registry:")
(ports/run nil nil)
