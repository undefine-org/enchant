(ns up1
  (:require [bl.util :as u]))

(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private SSL (erlang/binary_to_atom "ssl"))

(Application/ensure_all_started :ssl)
(BeamLisp.Daemon.CA/ensure_started)

(defn opts [name]
  (to-list (concat (to-list (erlang/element 2 (BeamLisp.Daemon.CA/ssl_opts name)))
                   (list (tup (list :active false))))))

(def lr (gen_tcp/listen 7797 (list :binary (tup (list :active false)) (tup (list :reuseaddr true))
                                   (tup (list :ip (tup (list 127 0 0 1)))))))
(println "listen ->" (pr-str (erlang/element 1 lr)))

(def ar (gen_tcp/accept (erlang/element 2 lr) 60000))
(println "accept ->" (pr-str (erlang/element 1 ar)))

(def s (erlang/element 2 ar))
(def hr (erlang/apply SSL :handshake (list s (opts "probe.test") 15000)))
(println "handshake ->" (pr-str hr))

(def ok (and (tuple? hr) (= :ok (erlang/element 1 hr))))
(if ok
  (let [h (erlang/element 2 hr)]
    (println "recv ->" (pr-str (erlang/apply SSL :recv (list h 0 5000))))
    (erlang/apply SSL :send (list h "HTTP/1.1 200 OK\r\ncontent-length: 20\r\nconnection: close\r\n\r\nupgraded-from-tcp!!!")))
  (println "no handshake, nothing to serve"))

(Process/sleep 3000)
