(ns t1
  (:require [bl.util :as u]))

(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private Maps (erlang/binary_to_atom "maps"))

(println "A map literal:" (pr-str {:a 1 :b "x"}))
(println "B term_to_binary of a map literal:" (count (erlang/term_to_binary {:a 1})))
(println "C maps:get on a literal:" (pr-str (erlang/apply Maps :get (list :a {:a 1} :none))))
(println "D maps:get missing:" (pr-str (erlang/apply Maps :get (list :zz {:a 1} :none))))
(def pairs (list (tup (list :a 1)) (tup (list :b 2))))
(println "E map literal with a list value:" (pr-str {:name "web" :port 0 :hosts (list "a.test") :dest (tup (list :unix "/tmp/x.sock"))}))
(println "G String split first/rest:" (pr-str (first (String/split "GET / HTTP/1.1" " "))))
(println "H rest of split:" (pr-str (rest (String/split "a\r\nb\r\n\r\n" "\r\n"))))
(println "I String/contains?:" (pr-str (String/contains? "a\r\n\r\n" "\r\n\r\n")))
(println "J or+get_env:" (pr-str (or (System/get_env "NOPE_GW") "7788")))
(println "K list_to_integer:" (pr-str (String/to_integer (or (System/get_env "NOPE_GW") "7788"))))
(println "L os getpid:" (pr-str (os/getpid)) " -> " (pr-str (erlang/list_to_integer (os/getpid))))
(println "M str+int:" (str "port " 7788 " ok"))
(println "N index-of:" (pr-str (index-of "a/b/c" "/")))
(println "O subs:" (pr-str (subs "abcdef" 2 4)))
(println "P some:" (pr-str (some (fn [x] (if (= x 2) :two nil)) (list 1 2 3))))
(println "Q filter+join:" (pr-str (join "," (filter (fn [x] (> x 1)) (list 1 2 3)))))
(println "R downcase/starts_with?:" (pr-str (String/starts_with? (String/downcase "Host: x") "host:")))
(println "S System/get_env real:" (pr-str (System/get_env "XDG_RUNTIME_DIR")))
(println "T list literal:" (pr-str (list :binary (tup (list :active false)))))
:done
