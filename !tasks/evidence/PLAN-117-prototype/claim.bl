(ns claim
  (:require [bl.util :as u]))

(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private Maps (erlang/binary_to_atom "maps"))
(def ^:private Paths (erlang/binary_to_atom "Elixir.BeamLisp.Daemon.Paths"))

(def NAME (System/get_env "CLAIM_NAME"))
(def HOST (System/get_env "CLAIM_HOST"))
(def ROOT (or (System/get_env "CLAIM_ROOT") "/tmp/bl117/foreign"))
(def PID (String/to_integer (System/get_env "CLAIM_PID")))
(def PORT (String/to_integer (System/get_env "CLAIM_PORT")))

(def ^:private RUN (erlang/element 2 (erlang/apply Paths :runtime_dir (list))))
(def TREE (erlang/apply Paths :tree_id (list ROOT)))
(def PORTSDIR (str RUN "/ports"))

(defn write-claim []
  (let [m {:name NAME :port PORT :pinned false :hosts (list HOST) :tree_id TREE
           :root ROOT :pid PID :claimed_at (erlang/system_time :second)
           :dest (tup (list :tcp PORT))}
        path (str PORTSDIR "/" NAME "@" TREE)
        tmp (str path ".tmp")]
    (File/write! tmp (erlang/term_to_binary m))
    (File/chmod tmp 384)
    (File/rename tmp path)
    path))

(File/mkdir_p PORTSDIR)
(println (str "claim: " HOST " -> tcp 127.0.0.1:" PORT " (owner pid " PID ") -> " (write-claim)))
