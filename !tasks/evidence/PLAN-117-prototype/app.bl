(ns app
  (:require [bl.util :as u] [web :as web]))

(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private Maps (erlang/binary_to_atom "maps"))
(def ^:private Paths (erlang/binary_to_atom "Elixir.BeamLisp.Daemon.Paths"))

(def NAME  (or (System/get_env "APP_NAME") "web"))
(def HOST  (or (System/get_env "APP_HOST") "web.knowledger.test"))
(def ROOT  (or (System/get_env "APP_ROOT") "/tmp/bl117/app"))
(def BODY  (or (System/get_env "APP_BODY") "served by the app bean"))

(def ^:private RUN (erlang/element 2 (erlang/apply Paths :runtime_dir (list))))
(def TREE (erlang/apply Paths :tree_id (list ROOT)))
(def PORTSDIR (str RUN "/ports"))
(def SOCK (str PORTSDIR "/" TREE "." NAME ".sock"))
(def PID (erlang/list_to_integer (os/getpid)))

(defn write-claim []
  (let [m {:name NAME :port 0 :pinned false :hosts (list HOST) :tree_id TREE
           :root ROOT :pid PID :claimed_at (erlang/system_time :second)
           :dest (tup (list :unix SOCK))}
        path (str PORTSDIR "/" NAME "@" TREE)
        tmp (str path ".tmp")]
    (File/write! tmp (erlang/term_to_binary m))
    (File/chmod tmp 384)
    (File/rename tmp path)
    path))

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn
                  (str "<h1>" HOST "</h1>"
                       "<p>" BODY " (pid " PID ")</p>"
                       "<p>destination: unix:" SOCK "</p>"
                       "<p>no TCP port was allocated, here or anywhere.</p>"))
    :else (web/text conn 404 (str "the app bean has no " (web/path conn)))))

(File/mkdir_p PORTSDIR)
(println (str "bl serve: " HOST " -> unix:" SOCK))
(println (str "          claim: " (write-claim) "   (port: 0 — the number is gone, not chosen)"))
(File/rm SOCK)
(let [r (web/serve {:port 0 :ip (tup (list :local SOCK)) :plug router})]
  (println (str "          bandit: " (pr-str (erlang/element 1 r)) "  pid " PID))
  (Process/sleep :infinity))
