(ns t5
  (:require [bl.util :as u] [bl.ports :as ports]))
(def ^:private Ports (erlang/binary_to_atom "Elixir.BeamLisp.Daemon.Ports"))
(def ^:private Paths (erlang/binary_to_atom "Elixir.BeamLisp.Daemon.Paths"))
(println "env XDG_RUNTIME_DIR   :" (pr-str (System/get_env "XDG_RUNTIME_DIR")))
(println "Paths.runtime_dir     :" (pr-str (erlang/apply Paths :runtime_dir (list))))
(println "apply Ports/list      :" (pr-str (erlang/apply Ports :list (list))))
(println "direct Ports/list     :" (pr-str (BeamLisp.Daemon.Ports/list)))
(println "bl.ports/list-ports   :" (pr-str (ports/list-ports)))
(println "count list-ports      :" (count (ports/list-ports)))
(println "Ports module loaded from:" (pr-str (erlang/apply (erlang/binary_to_atom "code") :which (list Ports))))
