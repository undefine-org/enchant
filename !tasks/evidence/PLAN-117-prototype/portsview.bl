(ns portsview
  (:require [bl.util :as u] [bl.ports :as ports]))

(defn mget [k m d] (erlang/apply (erlang/binary_to_atom "maps") :get (list k m d)))
(defn pad [s] (String/pad_trailing (str s) 26))

(println "NAME                       DESTINATION                                              OWNER")
(u/each
  (fn [c]
    (println (str "  " (pad (join ", " (:hosts c)))
                  (pad (pr-str (mget :dest c :none)))
                  "pid " (:pid c))))
  (sort-by (fn [c] (:name c)) (ports/list-ports)))
