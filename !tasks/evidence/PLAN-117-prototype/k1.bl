(ns k1
  "K1 — what a failed TLS handshake should SAY.

  F1 recorded that OTP reports every failed option parse as {dtls_upgrade, notsup}. The question is
  whether the real reason is available to print instead, and from where."
  (:require [bl.util :as u]))

(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private SSL (erlang/binary_to_atom "ssl"))
(def ^:private SSLConfig (erlang/binary_to_atom "ssl_config"))

(Application/ensure_all_started :ssl)
(BeamLisp.Daemon.CA/ensure_started)

(def lr (gen_tcp/listen 7794 (list :binary (tup (list :active false)) (tup (list :ip (tup (list 127 0 0 1)))))))
(def ls (erlang/element 2 lr))

(def base (to-list (concat (to-list (erlang/element 2 (BeamLisp.Daemon.CA/ssl_opts "probe.test")))
                           (list (tup (list :active false))))))
(def bad (to-list (concat base (list (tup (list :frobnicate true))))))

;; a client, then the accept — so there is a CONNECTED socket to hand to :ssl
(def cr (gen_tcp/connect (tup (list 127 0 0 1)) 7794 (list :binary (tup (list :active false)))))
(def ar (gen_tcp/accept ls 5000))
(def s (erlang/element 2 ar))

(println "listen/connect/accept ->" (pr-str (erlang/element 1 lr)) (pr-str (erlang/element 1 cr)) (pr-str (erlang/element 1 ar)))
(println)
(println "1. ssl_config:handle_options with the CA's own list:")
(println "   " (pr-str (erlang/apply SSLConfig :handle_options (list ls base :server :undefined))))
(println)
(println "2. the same list plus one unknown option (:frobnicate):")
(println "   " (pr-str (erlang/apply SSLConfig :handle_options (list ls bad :server :undefined))))
(println)
(println "3. ssl:handshake on a CONNECTED socket, with that same bad list:")
(println "   " (pr-str (erlang/apply SSL :handshake (list s bad 5000))))
(println)
(println "4. and with a good list, for contrast (one line, then stop):")
(println "   " (pr-str (erlang/element 1 (erlang/apply SSL :handshake (list s base 5000)))))
