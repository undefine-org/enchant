(ns t3
  (:require [bl.util :as u]))
(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private Gen (erlang/binary_to_atom "gen_tcp"))

(def p (spawn (fn [] (receive [:go x] (println "receive matched, payload =" (pr-str x))))))
(erlang/send p [:go 42])
(Process/sleep 300)

;; does an ssl upgrade work from a process that does NOT own the socket?
(Application/ensure_all_started :ssl)
(BeamLisp.Daemon.CA/ensure_started)
(def ^:private SSL (erlang/binary_to_atom "ssl"))

(defn opts [n] (to-list (concat (to-list (erlang/element 2 (BeamLisp.Daemon.CA/ssl_opts n)))
                                (list (tup (list :active false))))))

(def lr (gen_tcp/listen 7796 (list :binary (tup (list :active false)) (tup (list :ip (tup (list 127 0 0 1)))))))
(println "listen:" (pr-str (erlang/element 1 lr)))

(defn accept-and-spawn [ls]
  (let [ar (gen_tcp/accept ls 60000)
        s (erlang/element 2 ar)
        h (spawn (fn [] (receive [:go sock]
                          (println "handler handshake ->"
                                   (pr-str (erlang/element 1 (erlang/apply SSL :handshake (list sock (opts "probe.test") 8000))))))))]
    (println "controlling_process ->" (pr-str (erlang/apply Gen :controlling_process (list s h))))
    (erlang/send h [:go s])))

(spawn (fn [] (accept-and-spawn (erlang/element 2 lr))))
(Process/sleep 20000)
