(ns k1b
  "K1, second pass — the surprise from the first run: an UNKNOWN option is accepted
  ({:ok, config}), so {dtls_upgrade, notsup} was never about option contents.

  The first prototype passed `(concat (to-list …) (list …))` — a bl value that is not an Erlang
  list. This asks directly: what does handle_options do with (a) a non-list, and (b) a bad VALUE
  for a known option?"
  (:require [bl.util :as u]))

(defn tup [xs] (erlang/list_to_tuple xs))
(def ^:private SSL (erlang/binary_to_atom "ssl"))
(def ^:private SSLConfig (erlang/binary_to_atom "ssl_config"))

(Application/ensure_all_started :ssl)
(BeamLisp.Daemon.CA/ensure_started)

(def lr (gen_tcp/listen 7792 (list :binary (tup (list :active false)) (tup (list :ip (tup (list 127 0 0 1)))))))
(def ls (erlang/element 2 lr))

(def base (to-list (concat (to-list (erlang/element 2 (BeamLisp.Daemon.CA/ssl_opts "probe.test")))
                           (list (tup (list :active false))))))

(defn ask [label opts]
  (println label)
  (println "   shape: is_list ->" (erlang/is_list opts))
  (println "   handle_options ->"
           (pr-str (try (erlang/apply SSLConfig :handle_options (list ls opts :server :undefined))
                        (catch e (str "RAISED: " e))))))

(ask "1. an unknown option (contents):" (to-list (concat base (list (tup (list :frobnicate true))))))
(ask "2. a bad VALUE for a known option (:versions [:tlsv9]):"
     (to-list (concat (list (tup (list :versions (list :tlsv9)))) base)))
(ask "3. a bl VECTOR where a list is wanted (the first prototype's shape):"
     (list :binary (tup (list :active false))))
(ask "4. the same, built the way the prototype built it (concat of a bl list):"
     (concat base (list (tup (list :active false)))))
