#!/bin/sh
# Checkout commands select immutable Nix prerequisites and SDK before BEAM.
# The native transport reaches a warm realm before doing cold preparation.
set -e

ROOT=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
export BL_CHECKOUT_ROOT="$ROOT"
export BL_CHECKOUT_SDK_INPUTS="$("$ROOT/scripts/prepare-checkout-sdk" --fingerprint)"

# The managed platform supplies the stock client, runtime and mandatory NIF
# before any BEAM starts. Build sandboxes pass their already prepared platform.
PLATFORM=${BL_CHECKOUT_PLATFORM:-}
if [ -z "$PLATFORM" ]; then
  PLATFORM=$("$ROOT/scripts/prepare-checkout-platform")
fi
PLATFORM=$(readlink -f "$PLATFORM")
case "$PLATFORM" in
  /nix/store/*) ;;
  *) echo 'bl: checkout platform must be an immutable Nix product' >&2; exit 69 ;;
esac
if [ ! -f "$PLATFORM/platform.json" ] || [ ! -x "$PLATFORM/bin/drop-launcher" ]; then
  echo 'bl: checkout platform is incomplete' >&2
  exit 69
fi
export BL_CHECKOUT_PLATFORM="$PLATFORM"
export BL_ARTIFACT_PLATFORM="$PLATFORM/artifact-platform"
export BL_PREPARED_NATIVES="$(readlink -f "$PLATFORM/native-products")"
export BL_BIN="$PLATFORM/bin/drop-launcher"
export PATH="$PLATFORM/bin:$PATH"

# Program argv after -- is opaque to the launcher.
for arg in "$@"; do
  [ "$arg" = "--" ] && break
  if [ "$arg" = "--cold" ]; then BL_CHECKOUT_COLD=$ROOT; break; fi
done

# The native client reaches a running VM before any Elixir probe or staging.
# Its cold child comes back through this script exactly once.
if [ "${BL_CHECKOUT_COLD:-}" != "$ROOT" ]; then
  CLIENT="$PLATFORM/bin/drop-launcher"
  exec "$CLIENT" --checkout "$ROOT" -- "$@"
fi
unset BL_CHECKOUT_COLD

SDK=$("$ROOT/scripts/prepare-checkout-sdk")
SDK=$(readlink -f "$SDK")
"$PLATFORM/artifact-platform/bin/python3" - "$SDK" <<'PYSDK'
import json, pathlib, re, sys
sdk = pathlib.Path(sys.argv[1])
if not re.fullmatch(r"/nix/store/[0-9a-z]{32}-[^/]+", str(sdk)):
    raise SystemExit("bl: SDK must be an immutable Nix product")
metadata = json.loads((sdk / "artifact.json").read_text())
if (metadata.get("version"), metadata.get("kind"), metadata.get("target")) != (1, "sdk", "x86_64-linux"):
    raise SystemExit("bl: unsupported SDK product")
if not (sdk / "image/ebin/Elixir.BeamLisp.Launcher.beam").is_file():
    raise SystemExit("bl: incomplete SDK product")
PYSDK
export BL_SDK_PRODUCT="$SDK"
export BL_ROOT="$SDK/image"
export BL_EBIN="$SDK/image/ebin"
export BL_BUILD_ID=src
export BEAM_LISP_DEV=0
# Only immutable SDK dependencies enter the VM. Producer/bootstrap staging is
# confined to bin/bl-producer inside the trusted Nix recipes.
PA=""
for directory in "$SDK"/lib/*/ebin; do
  PA="$PA -pa $directory"
done
exec elixir $PA -e 'BeamLisp.Launcher.start_app!(System.argv(), %{})' -- "$@"
