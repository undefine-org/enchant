(ns browser.evaluation-test
  (:require [browser.page :as page]))

(deftest evaluation-retains-the-browser-diagnostic-and-waits-do-not-hide-errors
  (let [root (str "/tmp/bl-evaluation-test-" (erlang/unique_integer (list :positive)))
        p (page/open! {:width 640 :height 480
                       :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                                "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                                "vnc" (System/get_env "WAYVNC") "width" 640 "height" 580}})]
    (try
      (page/navigate! p "data:text/html,<p>Evaluation contract</p>")
      (page/wait! p "!!document.querySelector('p')")
      (let [error (try (page/evaluate! p "throw Error('native evaluation sentinel')")
                      (catch e {:message (ex-message e) :data (ex-data e)}))]
        (is (String/contains? (:message error) "native evaluation sentinel"))
        (is (String/contains? (get-in error [:data :exception "exception" "description"])
                             "native evaluation sentinel")))
      (page/evaluate! p "window.predicateCalls=0;true")
      (let [message (try (page/wait! p "(()=>{window.predicateCalls++;throw Error('predicate sentinel')})()" 1000)
                         (catch e (ex-message e)))]
        (is (String/contains? message "predicate sentinel"))
        (is (= 1 (page/evaluate! p "window.predicateCalls"))
            "a genuine JavaScript error must propagate rather than become polling or a successful wait"))
      (finally (page/close! p) (File/rm_rf! root)))))
