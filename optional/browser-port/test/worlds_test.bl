(ns browser.worlds-test
  (:require [browser.film :as film] [interop]))

(deftest a-composition-failure-retains-track-clocks-and-releases-every-browser
  (let [root (str "/tmp/bl-world-failure-" (erlang/unique_integer (list :positive)))
        wrapper (str root "/ffmpeg-wrapper")
        _ (File/mkdir_p! root)
        _ (File/write! wrapper (str "#!/bin/sh\nfor item do\n  if [ \"$item\" = \"-filter_complex\" ]; then exit 23; fi\ndone\nexec '"
                                      (String/replace (System/find_executable "ffmpeg") "'" "'\"'\"'") "' \"$@\"\n"))
        _ (File/chmod! wrapper 448)
        options {:width 800 :height 480
                 :launch {"chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                          "vnc" (System/get_env "WAYVNC") "width" 800 "height" 580}}
        world (film/owned-worlds [[:actor options] [:observer options]] (str root "/frames") {:ffmpeg wrapper :fps 30})
        pages ((:open world) {})]
    (try
      (doseq [actor [:actor :observer]]
        ((:step! world) pages [:act actor [:navigate "data:text/html,<body style='background:steelblue'>Native failure evidence</body>"]]))
      (Process/sleep 500)
      (is (= "Native multiscreen composition failed" (try ((:close! world) pages) :unexpected-success (catch e (ex-message e)))))
      (let [records (get (interop/json-> (File/read! (str root "/frames/recordings.json"))) "recordings")]
        (is (= 2 (count records)))
        (doseq [record records]
          (is (number? (get record "trim")))
          (is (> (get record "encodedFrames") 10))
          (is (File/regular? (get record "path")))
          (is (= 0 (elem (System/cmd (System/find_executable "ffmpeg")
                           (list "-v" "error" "-i" (get record "path") "-f" "null" "-")) 1)))))
      (doseq [[_ p] pages] (is (= :undefined (erlang/port_info (:port p)))))
      (finally ((:dispose! world)) (File/rm_rf! root)))))

(deftest aborted-worlds-can-defer-composition-without-losing-raw-tracks
  (let [root (str "/tmp/bl-world-deferred-" (erlang/unique_integer (list :positive)))
        wrapper (str root "/ffmpeg-wrapper")
        marker (str root "/composition-called")
        _ (File/mkdir_p! root)
        _ (File/write! wrapper
            (str "#!/bin/sh\nfor item do\n  if [ \"$item\" = \"-filter_complex\" ]; then : > '" marker "'; exit 23; fi\ndone\nexec '"
                 (String/replace (System/find_executable "ffmpeg") "'" "'\"'\"'") "' \"$@\"\n"))
        _ (File/chmod! wrapper 448)
        options {:width 800 :height 480
                 :launch {"chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                          "vnc" (System/get_env "WAYVNC") "width" 800 "height" 580}}
        world (film/owned-worlds [[:actor options] [:observer options]] (str root "/frames")
                                {:ffmpeg wrapper :fps 30 :compose-on-dispose? false})
        pages ((:open world) {})]
    (try
      (doseq [actor [:actor :observer]]
        ((:step! world) pages [:act actor [:navigate "data:text/html,<p>Raw abort evidence</p>"]]))
      (Process/sleep 500)
      (is (= :disposed (try ((:dispose! world)) :disposed (catch _ :composition-error))))
      (is (not (File/exists? marker)))
      (is (not (File/exists? (str root "/frames/continuous.mp4"))))
      (let [metadata (interop/json-> (File/read! (str root "/frames/recordings.json")))
            records (get metadata "recordings")]
        (is (nil? (get metadata "source")))
        (is (= "deferred" (get metadata "composition")))
        (is (= 2 (count records)))
        (doseq [record records]
          (is (number? (get record "trim")))
          (is (File/regular? (get record "path")))
          (is (> (get record "encodedFrames") 10))
          (is (= 0 (elem (System/cmd "ffmpeg"
                           (list "-v" "error" "-xerror" "-threads" "2" "-i" (get record "path") "-f" "null" "-")) 1)))))
      (doseq [[_ p] pages] (is (= :undefined (erlang/port_info (:port p)))))
      (finally ((:dispose! world)) (File/rm_rf! root)))))
