(ns browser.upload-test (:require [browser.page :as page]))

(deftest native-file-selection-preserves-real-bytes-and-ordinary-form-data
  (let [root (str "/tmp/bl-upload-test-" (erlang/unique_integer (list :positive)))
        file (str root "/proof.txt")
        p (page/open! {:width 800 :height 600
             :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                      "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                      "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})]
    (try
      (File/write! file "independent document bytes")
      (page/navigate! p "data:text/html,<form id='form'><input id='file' name='document' type='file'><input id='disabled' type='file' disabled><button>Send</button></form>")
      (page/wait! p "!!document.querySelector('#file')")
      (page/evaluate! p "window.changes=[];document.querySelector('#file').addEventListener('change',e=>window.changes.push(e.isTrusted))")
      (page/upload! p "#file" [file])
      (is (= "proof.txt" (page/evaluate! p "document.querySelector('#file').files[0].name")))
      (is (= "independent document bytes" (page/evaluate! p "document.querySelector('#file').files[0].text()")))
      (is (= "independent document bytes" (page/evaluate! p "new FormData(document.querySelector('#form')).get('document').text()")))
      (is (= [true] (page/evaluate! p "window.changes")))
      (is (thrown? (page/upload! p "#missing" [file])))
      (is (thrown? (page/upload! p "#disabled" [file])))
      (is (thrown? (page/upload! p "#file" [(str root "/absent.txt")])))
      (is (= 1 (page/evaluate! p "document.querySelector('#file').files.length")))
      (is (thrown? (page/upload! p "#file" [])))
      (is (= 1 (page/evaluate! p "document.querySelector('#file').files.length")))
      (finally (page/close! p) (File/rm_rf! root)))))
