(ns browser.select-test (:require [browser.page :as page] [browser.film :as film]))

(deftest selection-is-real-keyboard-input-with-closed-option-identity
  (let [root (str "/tmp/bl-select-test-" (erlang/unique_integer (list :positive)))
        p (page/open! {:width 800 :height 600
                       :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                                "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                                "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})]
    (try
      (page/navigate! p "data:text/html,<select id='choice'><option disabled value=''>Pick</option><option value='a'>Alpha</option><option disabled value='b'>Beta</option><option value='c'>Gamma</option></select><select id='disabled' disabled><option>a</option></select><select id='multi' multiple><option>a</option></select><select id='ambiguous'><option value='same'>One</option><option value='same'>Two</option></select>")
      (page/wait! p "!!document.querySelector('#choice')")
      (page/evaluate! p "window.changes=[];document.querySelector('#choice').addEventListener('change',e=>window.changes.push(e.isTrusted))")
      (film/action! p [:select "#choice" "c"])
      (is (= "c" (page/evaluate! p "document.querySelector('#choice').value")))
      (is (seq (page/evaluate! p "window.changes")))
      (is (every? #(= true %) (page/evaluate! p "window.changes")))
      (film/action! p [:select "#choice" "a"])
      (is (= "a" (page/evaluate! p "document.querySelector('#choice').value")))
      (doseq [[selector value] [["#missing" "a"] ["#disabled" "a"] ["#multi" "a"] ["#ambiguous" "same"] ["#choice" "b"] ["#choice" "unknown"]]]
        (is (thrown? (page/select! p selector value))))
      (is (= "a" (page/evaluate! p "document.querySelector('#choice').value")))
      (finally (page/close! p) (File/rm_rf! root)))))
