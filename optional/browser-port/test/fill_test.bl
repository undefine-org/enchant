(ns browser.fill-test (:require [browser.page :as page] [browser.film :as film]))

(deftest ordinary-number-and-civil-time-controls-keep-their-typed-form-values
  (let [root (str "/tmp/bl-typed-input-" (erlang/unique_integer (list :positive)))
        p (page/open! {:width 800 :height 600
                       :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                                "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                                "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})]
    (try
      (page/navigate! p "data:text/html,<form id='form'><input id='number' name='number' type='number'><input id='instant' name='instant' type='datetime-local'><input id='date' name='date' type='date'><input id='time' name='time' type='time'><input id='readonly' readonly value='preserved'><input id='disabled' disabled value='preserved'></form>")
      (page/wait! p "!!document.querySelector('#form')")
      (page/evaluate! p "window.changes=[];for(const kind of ['input','change'])document.querySelector('#form').addEventListener(kind,e=>window.changes.push([kind,e.target.id,e.isTrusted]))")
      (doseq [[selector value] [["#number" "3000"] ["#instant" "2026-09-30T17:00"] ["#date" "2026-09-30"] ["#time" "17:00"]]]
        (film/action! p [:fill selector value])
        (is (= value (page/evaluate! p (str "document.querySelector('" selector "').value"))))
        (is (= value (page/evaluate! p (str "new FormData(document.querySelector('#form')).get('" (subs selector 1) "')")))))
      (let [events (page/evaluate! p "window.changes")]
        (is (some #(= ["input" "number" true] %) events))
        (is (some #(= ["input" "instant" false] %) events))
        (is (some #(= ["change" "instant" false] %) events)))
      (is (thrown? (page/fill! p "#instant" "invalid-date")))
      (is (= "2026-09-30T17:00" (page/evaluate! p "document.querySelector('#instant').value")))
      (doseq [selector ["#readonly" "#disabled" "#missing"]]
        (is (thrown? (page/fill! p selector "changed"))))
      (is (= "preserved" (page/evaluate! p "document.querySelector('#readonly').value")))
      (is (= "preserved" (page/evaluate! p "document.querySelector('#disabled').value")))
      (finally (page/close! p) (File/rm_rf! root)))))
