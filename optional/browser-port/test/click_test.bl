(ns browser.click-test (:require [browser.page :as page]))

(deftest clicks-land-on-visible-inline-fragments-and-refuse-covered-targets
  (let [root (str "/tmp/bl-native-click-" (erlang/system_time :millisecond))
        p (page/open! {:width 800 :height 600
                       :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                                "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                                "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})]
    (try
      (page/navigate! p (str "data:text/html;base64," (Base/encode64 "<style>body{margin:30px}a{font:20px/60px sans-serif}#covered{position:absolute;left:300px;top:30px;width:150px;height:50px}#cover{position:absolute;left:295px;top:25px;width:160px;height:60px;background:gray;z-index:5}</style><a id='wrapped' href='#selected'>A fairly long first line<br>x</a><button id='covered'>Covered control</button><div id='cover'></div><div style='height:70px;overflow:auto;margin-top:60px'><div style='height:300px'></div><button id='nested' style='height:45px;width:180px'>Nested control</button></div><script>window.clicked=[];for(const id of ['wrapped','covered','nested'])document.getElementById(id).addEventListener('click',e=>{e.preventDefault();window.clicked.push([id,e.isTrusted])})</script>")))
      (page/wait! p "!!document.querySelector('#nested')")
      (is (= false (page/evaluate! p "(()=>{const e=document.querySelector('#wrapped'),r=e.getBoundingClientRect();return e.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2))})()"))
          "the union bounding-box centre lies between the painted inline fragments")
      (page/click! p "#wrapped")
      (is (= [["wrapped" true]] (page/evaluate! p "window.clicked")))
      (is (thrown? (page/click! p "#covered")))
      (is (= [["wrapped" true]] (page/evaluate! p "window.clicked")) "a covering element cannot receive a misplaced business click")
      (page/click! p "#nested")
      (is (= [["wrapped" true] ["nested" true]] (page/evaluate! p "window.clicked")))
      (finally (page/close! p) (File/rm_rf! root)))))
