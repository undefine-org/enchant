(ns browser.recording-test
  (:require [browser.page :as page] [interop]))

(deftest native-frames-continue-between-scenario-reference-points
  (let [root (str "/tmp/bl-stream-test-" (erlang/unique_integer (list :positive)))
        p (page/open! {:width 800 :height 600
             :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                      "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                      "vnc" (System/get_env "WAYVNC") "width" 800 "height" 700}})
        movie (str root "/continuous.mp4")]
    (try
      (page/show-cursor! p)
      (page/navigate! p (str "data:text/html," (String/replace (URI/encode_www_form "<style>@keyframes spin{to{transform:rotate(360deg)}}#motion{width:90px;height:90px;background:indigo;animation:spin 1s linear infinite}#source,#target{position:absolute;top:200px;padding:30px;background:orange}#target{left:500px}</style><div id='motion'></div><button id='source'>Move</button><div id='target'>Target</div><output id='result'>Waiting</output><script>document.addEventListener('pointerup',e=>{if(e.isTrusted)document.querySelector('#result').textContent='Real input'})</script>") "+" "%20")))
      (page/wait! p "!!document.querySelector('#source')")
      (page/evaluate! p "window.motionPoints=[];document.addEventListener('pointermove',e=>{if(e.isTrusted)window.motionPoints.push([e.clientX,e.clientY])})")
      (is (= true (get (page/record! p movie {:fps 30}) "paintBeforeRecord")))
      (is (thrown? (page/record! p (str root "/duplicate.mp4") {})))
      ;; No screenshot or scenario action occurs during this whole animation.
      (Process/sleep 1500)
      (let [before (page/recording p)]
        (is (= "veryfast" (get before "encoderPreset")))
        (is (> (get before "sourceFrames") 15)))
      (page/drag! p "#source" "#target" 1000)
      (is (= "Real input" (page/evaluate! p "document.querySelector('#result').textContent")))
      (page/evaluate! p "window.motionPoints=[]")
      (page/click! p "#source")
      (is (> (page/evaluate! p "window.motionPoints.length") 10) "click approach is actual motion")
      (is (< (page/evaluate! p "Math.max(...window.motionPoints.slice(1).map((p,i)=>Math.hypot(p[0]-window.motionPoints[i][0],p[1]-window.motionPoints[i][1])))") 50) "no reset or teleport between actions")
      (is (= @(:pointer p) (page/point p "#source")) "native pointer position survives the previous drag")
      ;; Compositor frames can change size during navigation or metrics updates.
      ;; Preserve every native frame inside the declared, constant film canvas.
      (page/cdp! p "Emulation.setDeviceMetricsOverride" {"width" 640 "height" 480 "deviceScaleFactor" 1 "mobile" false})
      (Process/sleep 400)
      (page/screenshot! p (str root "/reference.png"))
      (let [final (page/stop-recording! p)
            probe (System/cmd "ffprobe" (list "-v" "error" "-count_frames" "-show_streams" "-show_format" "-of" "json" movie))
            metadata (interop/json-> (elem probe 0))]
        (is (= 0 (elem probe 1)))
        (is (> (get final "sourceFrames") 30))
        (is (> (get final "encodedFrames") 60))
        (is (= 800 (get-in metadata ["streams" 0 "width"])))
        (is (> (String/to_float (get-in metadata ["format" "duration"])) 2.5))
        (is (File/exists? (str root "/continuous.frames.jsonl")))
        (is (File/exists? (str root "/reference.png"))))
      (finally (page/close! p) (File/rm_rf! root)))))

(deftest the-owned-software-display-produces-native-frames-and-a-decodable-film
  (let [root (str "/tmp/bl-native-frame-" (erlang/unique_integer (list :positive)))
        film (str root "/frames.mp4")
        p (page/open! {:width 800 :height 480
                       :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                                "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                                "vnc" (System/get_env "WAYVNC") "width" 800 "height" 580}})]
    (try
      (is (= true (get (page/record! p film {:fps 30 :record-preset "ultrafast"}) "paintBeforeRecord")))
      (page/navigate! p "data:text/html,<body style='background:steelblue'><button id='action' onclick='this.textContent=event.isTrusted'>Act</button>")
      (page/wait! p "!!document.querySelector('#action')")
      (page/click! p "#action")
      (page/wait! p "document.querySelector('#action').textContent==='true'")
      (Process/sleep 1200)
      (let [recording (page/stop-recording! p)
            result (System/cmd "ffmpeg" (list "-v" "error" "-i" film "-f" "null" "-"))]
        (is (> (get recording "sourceFrames") 1))
        (is (= "ultrafast" (get recording "encoderPreset")))
        (is (> (get recording "encodedFrames") 30))
        (is (= 0 (elem result 1)))
        (is (File/regular? film)))
      (finally (page/close! p) (File/rm_rf! root)))))

(deftest invalid-encoder-preset-refuses-before-creating-media
  (let [root (str "/tmp/bl-preset-test-" (erlang/unique_integer (list :positive)))
        p (page/open! {:width 640 :height 480
                       :launch {"profile" (str root "/profile") "runtime" (str root "/runtime")
                                "chromium" (System/get_env "CHROMIUM") "compositor" (System/get_env "SWAY")
                                "vnc" (System/get_env "WAYVNC") "width" 640 "height" 580}})
        movie (str root "/invalid.mp4")]
    (try
      (doseq [preset ["unknown" false nil 7]]
        (is (thrown? (page/record! p movie {:record-preset preset})))
        (is (not (File/exists? movie)))
        (is (not (File/exists? (str root "/invalid.pending.mp4"))))
        (is (thrown? (page/recording p))))
      (finally (page/close! p) (File/rm_rf! root)))))
