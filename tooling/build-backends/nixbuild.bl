;; Authentication is supplied separately by the CI token or host SSH configuration.
{:version 1
 :kind :nixbuild
 :nix {"settings" {"max-jobs" 0 "builders-use-substitutes" true}
       "distributedBuilds" true
       "buildMachines" [{"hostName" "eu.nixbuild.net"
                          "protocol" "ssh"
                          "systems" ["x86_64-linux"]
                          "maxJobs" 4
                          "supportedFeatures" ["kvm" "nixos-test" "benchmark" "big-parallel"]}]}}
