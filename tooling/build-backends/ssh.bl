;; Copy this description into the operator's configuration and fill in local data.
{:version 1
 :kind :ssh
 :nix {"settings" {"max-jobs" 0 "builders-use-substitutes" true}
       "distributedBuilds" true
       "buildMachines" [{"hostName" "build.example.invalid"
                          "protocol" "ssh-ng"
                          "sshUser" "builder"
                          "sshKey" "/run/keys/local-build"
                          "systems" ["x86_64-linux"]
                          "maxJobs" 2
                          "supportedFeatures" ["kvm"]}]}}
