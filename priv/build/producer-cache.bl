;; Retain only units actually loaded by the producer. This is an optimization
;; input: the next receiver checks constructor inputs and native provenance.
(ns producer-cache)

(defn retain! [units image destination]
  (let [index (Jason/decode! (File/read! (Path/join units "unit-index.json")))
        loaded (set (map (fn [entry] (str (Atom/to_string (elem entry 0)) ".beam")) (code/all_loaded)))
        selected (into {} (filter
                   (fn [[namespace _]]
                     (some #(contains? loaded (Path/basename %))
                       (Path/wildcard (Path/join units (str ".units/" namespace "/*.beam")))))
                   (get index "units")))
        ebin (Path/join destination "ebin")
        names (atom #{})]
    (File/mkdir_p! ebin)
    (File/mkdir_p! (Path/join destination ".units"))
    (doseq [[namespace _] selected]
      (File/cp_r! (Path/join units (str ".units/" namespace))
                  (Path/join destination (str ".units/" namespace)))
      (doseq [path (Path/wildcard (Path/join units (str ".units/" namespace "/*.beam")))]
        (let [name (Path/basename path)]
          (File/cp! (Path/join image (str "ebin/" name)) (Path/join ebin name))
          (swap! names conj (String/replace_suffix name ".beam" "")))))
    (let [compiled (erlang/binary_to_term (File/read! (Path/join image "priv/precompiled.term")))
          entries (into {} (filter (fn [[_ row]] (every? #(contains? @names %) (:modules row))) (:entries compiled)))]
      (File/write! (Path/join destination "precompiled.term")
        (erlang/term_to_binary (assoc compiled :entries entries) (list :deterministic))))
    (File/write! (Path/join destination "unit-index.json") (Jason/encode! (assoc index "units" selected)))
    (println (str "SDK-PRODUCER-CACHE " (Jason/encode! {:units (count selected) :modules (count @names)})))))
