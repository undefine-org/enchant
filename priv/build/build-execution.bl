;; Bootstrap-safe bounded tasks. Uses the same native Task entry as proc.task;
;; it cannot require the library namespaces this producer is compiling.
(ns build-execution)

(defn- execute!
  "Execute at most width private preparations at once. Refill on completion,
   fold completed results in the caller, and stop/await every owned task.
   The caller owns publication; workers only prepare disposable outputs."
  [width action publish initial items ordered?]
  (when-not (and (int? width) (<= 1 width 128))
    (throw (ex-info "Build concurrency requires 1 <= jobs <= 128" {})))
  (let [active (atom {}) owner (erlang/self) ticket (erlang/make_ref)
        start! (fn [[index value]]
                 (let [task (BeamLisp.Refs/task_exec
                              (fn []
                                (let [outcome (try [:ok (action value)]
                                                (catch error [:error __EXCEPTION_KIND__ error __STACKTRACE__]))]
                                  (erlang/send owner [:build-completed ticket index outcome])
                                  :ok)) :link)]
                   (swap! active assoc index task)))
        indexed (map-indexed (fn [index value] [index value]) items)]
    (try
      (loop [remaining indexed result initial ready {} next-index 0]
        (let [pending
              (loop [pending remaining]
                (if (and (seq pending) (< (count @active) width)
                         (< (+ (count @active) (count ready)) (if ordered? (* 2 width) (inc width))))
                  (do (start! (first pending)) (recur (rest pending))) pending))
              available (if ordered? (contains? ready next-index) (seq ready))]
          (cond
            available
            (let [index (if ordered? next-index (first (first ready)))]
              (recur pending (publish result index (get ready index))
                     (dissoc ready index) (if ordered? (inc next-index) next-index)))
            (empty? @active) result
            :else
            (let [[index outcome] (receive [:build-completed seen index outcome]
                                    :when (= seen ticket) [index outcome])
                  task (get @active index)]
              (Task/await task :infinity)
              (swap! active dissoc index)
              (if (= :error (first outcome))
                (erlang/raise (second outcome) (nth outcome 2) (nth outcome 3))
                (recur pending result (assoc ready index (second outcome)) next-index))))))
      (finally
        (doseq [[_ task] @active] (Task/shutdown task :brutal_kill))
        ;; Results sent just before cancellation belong only to this invocation.
        (loop [] (receive [:build-completed seen _ _] :when (= seen ticket) (recur)
                   (after 0 :ok)))))))

(defn reduce!
  "Refill private preparations on completion; fold results on one owner."
  [width action publish initial items]
  (execute! width action publish initial items false))

(defn ordered-reduce!
  "Prepare continuously, publish in input order. At most twice width items
   are admitted across active and completed work; a slow first item applies
   bounded backpressure rather than changing initializer order."
  [width action publish initial items]
  (execute! width action publish initial items true))

(defn map!
  "Bounded completion-driven execution with deterministic input-order results."
  [width action items]
  (let [results (reduce! width action (fn [out index result] (assoc out index result)) {} items)]
    (mapv #(get results %) (range (count results)))))
