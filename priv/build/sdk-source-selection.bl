;; Target selection is declaration data. Reading it never loads a namespace.
(ns sdk-source-selection (:require [reader-node :as rn]))

(defn describe
  ([source] (describe source "SDK source"))
  ([source file]
  (let [form (first (BeamLisp.Reader/read_string source file))
        items (when (and form (= :list (rn/node-tag (rn/node-form form)))) (rn/node-items form))
        head (first items) binding (second items)]
    (when (and head binding (= :symbol (rn/node-tag (rn/node-form head)))
               (= "ns" (rn/node-name (rn/node-form head)))
               (= :symbol (rn/node-tag (rn/node-form binding))))
      (let [namespace (rn/node-name (rn/node-form binding))
            metadata (or (rn/node-pos binding) {})
            interop (:interop metadata)
            javascript? (or (= true (:js metadata)) (= :javascript interop)
                            (and (erlang/is_tuple interop)
                                 (= :keyword (rn/node-tag (rn/node-form interop)))
                                 (= "javascript" (rn/node-name (rn/node-form interop)))))]
        {:namespace namespace :target (if javascript? :javascript :beam)
         :requires (:requires (get (BeamLisp.AOT/namespace_header form) namespace))})))))

(defn beam-source?
  ([source] (= :beam (:target (describe source))))
  ([source file] (= :beam (:target (describe source file)))))
