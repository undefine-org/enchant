;; SDK-side client of the packaged Foundry preparation dispatcher. This module
;; never accepts executable/argv/env fields. Product receipts remain observations;
;; the normal producer verifier and output writer own actual publication.
(ns artifact-jobs (:require [artifact-process :as process]))

(def operation-limit 1048576)
(def result-limit 16777216)

(defn- json-native [value]
  ;; Preserve scalars and malformed collection types for the closed validators.
  ;; Only actual sequential values become JSON arrays; maps recurse at any depth.
  (cond
    (map? value) (reduce (fn [out key]
                          (let [normalized (if (keyword? key) (name key) key)]
                            (when-not (string? normalized)
                              (throw (ex-info "JSON object keys must be strings or keywords" {})))
                            (when (contains? out normalized)
                              (throw (ex-info "JSON object keys collide after normalization" {})))
                            (assoc out normalized (json-native (get value key))))) {} (keys value))
    (sequential? value) (to-list (map json-native value))
    (keyword? value) (name value)
    :else value))
(defn- encode-json! [value] (Jason/encode! (json-native value)))
(defn- refuse! [message data] (throw (ex-info message (assoc data :kind :artifact-job-refused))))
(defn- digest [bytes] (String/downcase (Base/encode16 (crypto/hash :sha256 bytes))))
(defn- bounded! [path limit]
  (let [info (File/lstat! path)]
    (when-not (and (= :regular (:type info)) (<= (:size info) limit))
      (refuse! "Artifact job file is not a bounded regular file" {:path path}))
    (File/read! path)))
(defn- store-runtime! [path]
  (when-not (string? path) (refuse! "Startup preparation coordinator is missing" {}))
  (let [expanded (Path/expand path) link (File/read_link expanded)
        runtime (if (= :ok (elem link 0)) (elem link 1) expanded)]
    (when-not (and (Regex/match? #"^/nix/store/[0-9a-z]{32}-[^/]+$" runtime) (File/dir? runtime))
      (refuse! "An immutable preparation coordinator is required" {})) runtime))
(defn- runtime! [path]
  (let [configured (erlang/apply :Elixir.System :get_env (list "BL_PREPARATION_COORDINATOR"))
        pinned (store-runtime! configured) runtime (store-runtime! path)]
    ;; Compatibility metadata does not authorize a caller-selected executable.
    (when-not (= pinned runtime) (refuse! "Coordinator differs from pinned startup configuration" {}))
    (let [metadata (Jason/decode! (bounded! (Path/join runtime "artifact.json") operation-limit))]
      (when-not (and (= 1 (get metadata "version")) (= "artifact-coordinator-runtime" (get metadata "kind"))
                    (File/regular? (Path/join runtime "bin/bl"))
                    (File/regular? (Path/join runtime "foundry/bin/preparation-operation.bl")))
        (refuse! "Coordinator does not provide the preparation operation interface" {}))) runtime))
(defn- identity [path]
  (let [info (File/lstat! path)]
    {"inode" (:inode info) "device" (:major_device info) "minor-device" (:minor_device info) "uid" (:uid info)}))
(defn- owned-file! [path limit]
  (let [before (File/lstat! path)]
    (when-not (and (= :regular (:type before)) (= (:uid (File/stat! "/proc/self")) (:uid before))
                  (= 0 (erlang/band (:mode before) 63)))
      (refuse! "Preparation file is not private to the current operator" {}))
    (let [stamp (identity path) body (bounded! path limit)]
      (when-not (= stamp (identity path)) (refuse! "Preparation file changed during read" {})) body)))
(defn- directory! [path create?]
  (when-not (and (string? path) (= :absolute (Path/type path)) (< 1 (count path) 4097)
                (not (some #(= ".." %) (String/split path "/"))))
    (refuse! "Artifact jobs require an absolute private request directory" {}))
  (let [directory (Path/expand path)]
    (when (and create? (not (File/exists? directory)))
      ;; The caller owns the parent. Do not chmod an adopted existing directory.
      (let [created (File/mkdir directory)]
        (when (= :ok created) (File/chmod! directory 448))
        (when-not (or (= :ok created) (= (tuple :error :eexist) created))
          (refuse! "Cannot create private artifact request directory" {:directory directory}))))
    (let [info (File/lstat! directory)]
      (when-not (and (= :directory (:type info)) (= (:uid (File/stat! "/proc/self")) (:uid info)) (= 0 (erlang/band (:mode info) 63))
                    (not= 0 (erlang/band (:mode info) 128)))
        (refuse! "Artifact job directory must be private and owner-writable" {:directory directory}))) directory))
(defn- environment []
  ;; A project's logical :env does not select the operator bus or home.
  (into {} (filter #(some? (second %))
             (Enum/map ["HOME" "XDG_RUNTIME_DIR" "DBUS_SESSION_BUS_ADDRESS"]
               (fn [key] [key (erlang/apply :Elixir.System :get_env (list key))])))))
(defn- call! [runtime directory mode arguments timeout]
  (let [runtime (runtime! runtime) directory (directory! directory false)
        output (Path/join directory (str "client-" mode "-" (Base/encode16 (crypto/strong_rand_bytes 16)) ".json"))
        argv (concat ["--cold" "run" (Path/join runtime "foundry/bin/preparation-operation.bl")
                      "--" mode directory] arguments)
        result (process/run (Path/join runtime "bin/bl") argv
                 {:timeout-ms timeout :limit 65536 :stdout-file output :env (environment)})]
    (try
      (let [body (bounded! output result-limit)
            response (try (Jason/decode! body)
                       (catch error (refuse! "Coordinator returned invalid machine output" {:detail (:out result)})))]
        (when-not (and (process/ok? result) (= true (get response "ok")))
          (refuse! "Artifact job operation failed"
            {:status (:status result) :detail (or (get response "error") (:error result) (:out result))}))
        (get response "value"))
      ;; These are only this invocation's machine transport files, never roots.
      (finally (File/rm output)))))
(defn- handle! [handle]
  (when-not (and (map? handle)
                (= #{"version" "kind" "id" "directory" "directory-identity" "operation-sha256" "coordinator"} (set (keys handle)))
                (= 1 (get handle "version")) (= "preparation-handle" (get handle "kind"))
                (string? (get handle "id")) (Regex/match? #"^job_[0-9a-f]{16}$" (get handle "id"))
                (string? (get handle "operation-sha256"))
                (Regex/match? #"^[0-9a-f]{64}$" (get handle "operation-sha256")))
    (refuse! "Invalid artifact preparation handle" {}))
  (runtime! (get handle "coordinator"))
  (directory! (get handle "directory") false)
  (let [body (owned-file! (Path/join (get handle "directory") "operation.json") operation-limit)
        stored (Jason/decode! (owned-file! (Path/join (get handle "directory") "handle.json") operation-limit))]
    (when-not (and (= (identity (get handle "directory")) (get handle "directory-identity")) (= (digest body) (get handle "operation-sha256")) (= stored handle))
      (refuse! "Artifact preparation handle no longer matches its accepted request" {}))) handle)

(defn- record-operation!
  [coordinator directory operation]
  (let [coordinator (runtime! coordinator) directory (directory! directory true)
        _ (when-not (and (map? operation) (= 1 (get operation "version"))
                         (contains? #{"native" "application" "sdk"} (get operation "kind")))
            (refuse! "Unsupported artifact preparation operation" {}))
        body (encode-json! operation)
        _ (when (> (erlang/byte_size body) operation-limit) (refuse! "Artifact preparation operation exceeds capacity" {}))
        path (Path/join directory "operation.json")]
    ;; Publish complete, private bytes with an exclusive hard link. Competing
    ;; identical submissions never observe a partially written operation file.
    (let [temporary (str path ".tmp-" (Base/encode16 (crypto/strong_rand_bytes 16)))]
      (try
        (File/write! temporary body (list :exclusive))
        (File/chmod! temporary 384)
        (let [written (File/ln temporary path)]
          (when-not (or (= :ok written) (= (tuple :error :eexist) written))
            (refuse! "Cannot record private artifact operation" {:directory directory}))
          (when-not (= body (owned-file! path operation-limit))
            (refuse! "An artifact request directory cannot be reused for different input" {:directory directory})))
        (finally (File/rm temporary))))
    {:coordinator coordinator :directory directory :digest (digest body)}))

(defn- accepted! [request handle]
  (when-not (and (= (:coordinator request) (get handle "coordinator"))
                (= (:directory request) (get handle "directory"))
                (= (identity (:directory request)) (get handle "directory-identity"))
                (= (:digest request) (get handle "operation-sha256")))
    (refuse! "Coordinator accepted a different preparation request" {}))
  (handle! handle))

(defn submit!
  "Submit one durable fixed operation. Each requester owns a private directory
   and its roots. Repeating its content rejoins the same Foundry job; Nix shares
   realization across requesters. Inputs are captured before this handoff."
  [coordinator directory operation]
  (let [request (record-operation! coordinator directory operation)]
    (accepted! request (call! (:coordinator request) (:directory request) "submit" [] 60000))))

(defn prepare!
  "Submit and wait through one coordinator VM. Its durable worker survives a
   caller deadline/disconnect. The result still needs product verification and
   destination custody before publication."
  [coordinator directory operation timeout-ms]
  (when-not (and (int? timeout-ms) (<= 1000 timeout-ms 3600000))
    (refuse! "Artifact await deadline must be between one second and one hour" {}))
  (let [request (record-operation! coordinator directory operation)
        result (call! (:coordinator request) (:directory request) "prepare" [(str timeout-ms)] (+ timeout-ms 70000))
        handle (accepted! request (get result "handle"))]
    (when-not (= (:digest request) (get result "operation-sha256"))
      (refuse! "Coordinator completed a different preparation request" {}))
    (assoc result "handle" handle)))

(defn status! [handle]
  (let [handle (handle! handle)]
    (call! (get handle "coordinator") (get handle "directory") "status" [] 60000)))
(defn events!
  "Read bounded Foundry events with a numeric cursor. Events are progress, not
   the machine result or a qualification receipt."
  ([handle] (events! handle 0 200))
  ([handle cursor limit]
   (when-not (and (int? cursor) (<= 0 cursor 9007199254740992)
                 (int? limit) (<= 1 limit 2000))
     (refuse! "Artifact event cursor or limit is invalid" {}))
   (let [handle (handle! handle)]
     (call! (get handle "coordinator") (get handle "directory") "events" [(str cursor) (str limit)] 60000))))
(defn cancel!
  "Request cancellation of this request's verified managed service. An in-flight
   stopped operation is interrupted/outcome-unknown; an unknown live identity is
   needsRecovery and is never signalled. No input/result roots are removed."
  [handle]
  (let [handle (handle! handle)]
    (call! (get handle "coordinator") (get handle "directory") "cancel" [] 60000)))
(defn recover!
  "Reconcile this request's ledger through Foundry's actual worker identity
   checks. Recovery does not authorize publication or release any roots."
  [handle]
  (let [handle (handle! handle)]
    (call! (get handle "coordinator") (get handle "directory") "recover" [] 60000)))
(defn await!
  "Wait in ONE coordinator VM. Deadline expiry or caller disconnect leaves the
   durable operation running. The returned receipt still requires the normal
   product verifier and output-custody checks before publication."
  ([handle] (await! handle 3600000))
  ([handle timeout-ms]
   (when-not (and (int? timeout-ms) (<= 1000 timeout-ms 3600000))
     (refuse! "Artifact await deadline must be between one second and one hour" {}))
   (let [handle (handle! handle)]
     (call! (get handle "coordinator") (get handle "directory") "await" [(str timeout-ms)] (+ timeout-ms 10000)))))
