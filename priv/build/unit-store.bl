;; One artifact producer for SDK library units. Reuse is bound to the inputs
;; the constructor read, not the inventory of the containing SDK/workspace.
(ns unit-store (:require [build-log :as blog] [build-inputs :as inputs]
                        [build-execution :as execution]))

(defn- measure [timings stage run]
  (let [started (erlang/monotonic_time :microsecond)]
    (try (run)
      (finally (swap! timings update stage (fn [elapsed]
        (+ (or elapsed 0) (- (erlang/monotonic_time :microsecond) started))))))))

(defn- hex [bytes] (Base/encode16 bytes (list (tuple :case :lower))))
(defn- digest [text] (hex (crypto/hash :sha256 text)))
(defn- read-index [directory]
  (when (and directory (File/regular? (Path/join directory "unit-index.json")))
    (when (> (:size (File/stat! (Path/join directory "unit-index.json"))) 33554432)
      (throw (ex-info "Unit reuse index exceeds its bound" {})))
    (Jason/decode! (File/read! (Path/join directory "unit-index.json")))))

(defn- relative-input [input root]
  (let [sdk (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        file (BeamLisp.AOT/physical_sdk_path (:file input))
        scope (if (String/starts_with? file (str root "/")) "root" "sdk")
        base (if (= scope "root") root sdk)]
    (when-not (String/starts_with? file (str base "/"))
      (throw (ex-info "Unit read outside its immutable source roots" {:file file})))
    {"namespace" (:namespace input) "scope" scope
     "file" (Path/relative_to file base) "sha256" (digest (:source input))}))

(defn- inputs-current? [inputs root selected]
  (and (seq inputs)
    (every? (fn [input]
      (let [namespace (get input "namespace")
            path (or (get selected namespace) (BeamLisp.Loader/source_path namespace))
            base (if (= "root" (get input "scope")) root
                     (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root)))
            current (when path (BeamLisp.AOT/physical_sdk_path path))]
        (and current (File/regular? current)
             (= (get input "file") (Path/relative_to current base))
             (= (get input "sha256") (digest (BeamLisp.Loader/read_source current)))))) inputs)))

(defn- verify-inputs! [verified inputs namespace]
  (let [actual (into {} (map (fn [row] [(:namespace row) (hex (:sha256 row))])
                            (get-in verified [:manifest :inputs])))
        expected (into {} (map (fn [row] [(get row "namespace") (get row "sha256")]) inputs))]
    (when-not (and (= namespace (get-in verified [:manifest :namespace]))
                   (= actual expected) (contains? actual namespace))
      (throw (ex-info "Unit reuse inputs disagree with verified artifact" {:namespace namespace})))))

(defn artifact-key [prepared]
 (digest (erlang/term_to_binary
           {:namespace (:namespace prepared) :world (:world prepared) :phase-world (:phase-world prepared)
            :producer (System/get_env "BL_COMPILER_EMITTER_CONTEXT")
            :erts (erlang/system_info :version) :native (BeamLisp.LazyMemo/runtime_identity!)
            :host-spec (:host-spec prepared)} (list :deterministic))))

(defn artifact!
  "Retain one complete compiler artifact. The current constructor owns the
   world and exact host target; a cache only supplies verified emitted bytes.
   Runtime/SDK admission remains separate from this compilation cache."
  [prepared directory previous]
  (let [key (artifact-key prepared)
        prior (when previous (Path/join previous key))
        out (Path/join directory key)
        reusable (and prior (File/regular? (Path/join prior "artifact-unit.term")))
        expected (into {} (map (fn [input] [(:namespace input) (hex (:digest input))])
                              (vals (:inputs prepared))))
        verified (if reusable (BeamLisp.AOT/verify_unit prior)
                     (do (File/mkdir_p! directory)
                         (BeamLisp.AOT/emit_unit prepared out)
                         (BeamLisp.AOT/verify_unit out)))
        actual (into {} (map (fn [input] [(:namespace input) (hex (:sha256 input))])
                            (get-in verified [:manifest :inputs])))]
    (when-not (and (= (:namespace prepared) (get-in verified [:manifest :namespace]))
                   (= expected actual))
      (throw (ex-info "Compiler artifact cache inputs disagree" {:namespace (:namespace prepared)})))
    (when reusable
      (File/mkdir_p! directory)
      (File/cp_r! prior out))
    {:verified verified :compiled (not reusable) :key key}))

(defn- compiler-record-path [directory namespace target]
 (Path/join directory (str (digest (erlang/term_to_binary [namespace target] (list :deterministic))) ".json")))

(defn record-compiler-unit! [prepared captured directory phase]
 (let [root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
       row {"version" 1 "key" (:key captured) "namespace" (:namespace prepared)
            "compiler" (:compiler-key prepared) "phase" phase
            "producer" (System/get_env "BL_COMPILER_EMITTER_CONTEXT")
            "erts" (erlang/list_to_binary (erlang/system_info :version))
            "native" (BeamLisp.LazyMemo/runtime_identity!)
            "target" (digest (erlang/term_to_binary (:host-spec prepared) (list :deterministic)))
            "compiled" (:compiled captured)
            "world" (hex (get-in prepared [:world :id]))
            "phase-world" (hex (get-in prepared [:phase-world :id]))
            "inputs" (Enum/map (vals (:inputs prepared)) (fn [input] (relative-input input root)))}]
  (File/write! (compiler-record-path directory (:namespace prepared) (get row "target")) (Jason/encode! row))))

(defn restore-compiler-unit!
 "Reuse a previously captured constructor input set before lowering Source.
  Phase provider bytes and exact target/source resolution remain live checks.
  A planning stage may supply only unchanged units from the qualified floor."
 [selection directory previous phase planning? baseline]
 (when previous
  (let [namespace (elem (:namespace selection) 1)
        target (digest (erlang/term_to_binary (:host-spec selection) (list :deterministic)))
        selected-path (compiler-record-path previous namespace target)
        ;; Initial unit stores addressed input records by namespace. Their
        ;; recorded target still has to match before this migration can reuse.
        path (if (File/regular? selected-path) selected-path
                 (Path/join previous (str (digest namespace) ".json")))
        row (when (and (File/regular? path) (<= (:size (File/stat! path)) 1048576))
              (Jason/decode! (File/read! path)))
        key (get row "key")
        root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        selected {namespace (:file selection)}
        reusable (and (= 1 (get row "version")) (= namespace (get row "namespace"))
                    (= (BeamLisp.AOTCache/current_compiler_key) (get row "compiler"))
                    (= phase (get row "phase"))
                    (= (System/get_env "BL_COMPILER_EMITTER_CONTEXT") (get row "producer"))
                    (= (erlang/list_to_binary (erlang/system_info :version)) (get row "erts"))
                    (= (BeamLisp.LazyMemo/runtime_identity!) (get row "native"))
                    (= target (get row "target"))
                    (or (not planning?) (= false (get row "compiled")))
                    (string? key) (Regex/match? (Regex/compile! "^[0-9a-f]{64}$") key)
                    (inputs-current? (get row "inputs") root selected))]
   (when reusable
    (let [source (Path/join previous key)
          verified (BeamLisp.AOT/verify_unit source)
          _ (verify-inputs! verified (get row "inputs") namespace)
          host (:host-spec selection)
          members (get-in verified [:manifest :modules])
          target? (or (nil? host)
                    (and (= 1 (count members))
                         (= (Atom/to_string (:module host)) (:module (first members)))))
          ;; Planning metadata cannot turn this generation's new code into
          ;; independent reproduction. Match every byte to the OLD floor.
          old? (or (not planning?)
                 (and baseline
                   (= (get baseline "compiler_key") (BeamLisp.AOTCache/current_compiler_key))
                   (= (get baseline "abi_prefix_sha256")
                      (digest (first (String/split (File/read! (Path/join root "build/seed.bl"))
                                      ";; Artifact production owns preparation"))))
                   (every? (fn [[module bytes]]
                     (= (digest bytes) (get-in baseline ["modules" (str (Atom/to_string module) ".beam")])))
                     (:beams verified))))]
     (when (and old? target?)
      (File/mkdir_p! directory)
      (File/cp_r! source (Path/join directory key))
      (let [inputs (into {} (map (fn [input]
                      (let [name (get input "namespace")
                            file (or (get selected name) (BeamLisp.Loader/source_path name))]
                       [name {:namespace name :file (BeamLisp.AOT/physical_sdk_path file)
                              :digest (Base/decode16! (String/upcase (get input "sha256")))}]))
                      (get row "inputs")))
            _ (File/write! (compiler-record-path directory namespace target)
                 (Jason/encode! (assoc row "compiled" false)))]
       {:beams (:beams verified) :inputs inputs :compiled false
        :receipt {:namespace namespace :target (:host-spec selection)
                  :world (Base/decode16! (String/upcase (get row "world")))
                  :phase-world (Base/decode16! (String/upcase (get row "phase-world")))
                  :modules (get-in verified [:manifest :modules])}})))))))

(defn produce!
  "Produce complete units under the caller's output custody. Prior products
   are data: verification and source re-resolution precede every restoration."
  [opts]
  (when-not (contains? #{nil :full} (:scope opts))
    (throw (ex-info "SDK unit production requires its complete source selection" {})))
  (let [started (erlang/monotonic_time :microsecond) timings (atom {})
        out (:out opts) root (BeamLisp.AOT/physical_sdk_path (:root opts))
        sdk (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        _ (when-not (and root (= root sdk))
            (throw (ex-info "SDK unit production requires the actual SDK source root" {})))
        paths (vec (:sources opts))
        selected (into {} (map (fn [path]
                     [(BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source path)) path]) paths))
        _ (when-not (and (= (count selected) (count paths))
                         (every? (fn [namespace] (and (string? namespace)
                                    (Regex/match? (Regex/compile! "^[A-Za-z_][A-Za-z0-9_.-]*$") namespace))) (keys selected)))
            (throw (ex-info "SDK unit selection contains duplicate or invalid namespaces" {})))
        key (BeamLisp.AOTCache/compiler_key)
        runtime (hex (BeamLisp.AOT/runtime_image_key))
        previous (or (:previous opts) (System/get_env "BL_PREVIOUS_UNIT_STORE") out)
        candidate (read-index previous)
        old (when (and (= 1 (get candidate "version")) (= key (get candidate "compiler"))
                       (= runtime (get candidate "runtime"))) (get candidate "units"))
        _ (when-not (every? #(and (string? %) (Regex/match?
                                 (Regex/compile! "^[A-Za-z_][A-Za-z0-9_.-]*$") %)) (keys old))
            (throw (ex-info "Unit reuse index has an invalid namespace" {})))
        _ (File/mkdir_p! (Path/join out ".units"))
        width (min 4 (or (:jobs opts) 1))
        receipts (mapcat #(get % "inputs") (keep #(get old %) (keys selected)))
        snapshot (measure timings :input-snapshot (fn [] (inputs/capture root selected receipts)))
        ;; Compiler workspaces and Env mutation remain on this single owner.
        ;; Only verified immutable restoration crosses the task boundary.
        plans
        (BeamLisp.AOT/with_source_snapshot
          (fn [] (mapv (fn [path]
            (let [namespace (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source path))
                  unit-key (measure timings :unit-keys (fn [] (BeamLisp.AOTCache/key_for_source path)))
                  prior (get old namespace)
                  directory (Path/join (Path/join out ".units") namespace)
                  reusable (and (not (:force? opts)) prior (= unit-key (get prior "key"))
                                (measure timings :reuse-inputs
                                  (fn [] (inputs/current? snapshot (get prior "inputs")))))
                  prepared
                  (when-not reusable
                    (let [workspace (BeamLisp.AOT/open_workspace
                            {:version 2 :phase-imports (list 'core 'sugar) :roots (list root)
                             :sources (list {:namespace (symbol namespace) :file path})} {})]
                      (try
                        (let [prepared (BeamLisp.AOT/prepare_unit workspace (symbol namespace))
                              _ (File/rm_rf! directory)
                              _ (BeamLisp.AOT/emit_unit prepared directory)
                              actual (to-list (sort-by #(get % "namespace")
                                        (map #(relative-input % root) (vals (:inputs prepared)))))
                              verified (BeamLisp.AOT/verify_unit directory)]
                          (verify-inputs! verified actual namespace)
                          {:verified verified :inputs actual})
                        (finally (BeamLisp.AOT/close_workspace! workspace)))))]
              {:path path :namespace namespace :key unit-key :prior prior :directory directory
               :prepared prepared :reusable reusable
               :hash (measure timings :closure-hash (fn [] (BeamLisp.AOT/ns_closure_hash namespace)))})) paths)))
        result
        (execution/reduce! width
          (fn [plan]
            (if (:reusable plan)
              (let [namespace (:namespace plan)
                    source (Path/join (Path/join previous ".units") namespace)
                    verified (measure timings :verify-restored (fn [] (BeamLisp.AOT/verify_unit source)))
                    actual (get (:prior plan) "inputs")]
                (verify-inputs! verified actual namespace)
                (when (not= source (:directory plan))
                  (measure timings :copy-restored
                    (fn [] (File/rm_rf! (:directory plan)) (File/cp_r! source (:directory plan)))))
                (assoc plan :verified verified :inputs actual :compiled? false))
              (merge plan (:prepared plan) {:compiled? true})))
          (fn [acc _ plan]
            (let [verified (:verified plan) actual (:inputs plan) namespace (:namespace plan)
                  same? (and (not (:compiled? plan)) (= previous out)
                         (every? (fn [[module bytes]]
                           (= (tuple :ok bytes) (File/read (Path/join out (str (Atom/to_string module) ".beam")))))
                           (:beams verified)))
                  modules (vec (map first (:beams verified)))
                  _ (doseq [module modules]
                      (when-let [owner (get-in acc [:module-owners module])]
                        (throw (ex-info "Two SDK units own the same output module"
                                        {:module module :owners [owner namespace]}))))
                  _ (measure timings :write-flat (fn [] (doseq [[module bytes] (:beams verified)]
                      (File/write! (Path/join out (str (Atom/to_string module) ".beam")) bytes))))
                  digests (measure timings :output-digests (fn []
                            (vec (sort-by first (map (fn [[module bytes]] [(Atom/to_string module) (digest bytes)])
                                                      (:beams verified))))))
                  entry {:hash (:hash plan) :key (:key plan) :modules modules :digests digests
                         :preparation-key (digest (Jason/encode! actual))}]
              (when-let [log (:log opts)]
                (when-not same? (log (str (if (:compiled? plan) "compile " "restore ") namespace))))
              (-> acc
                (update (if (:compiled? plan) :compiled :cached) + (if same? 0 1))
                (update :built + (if same? 0 1))
                (update :module-owners merge (into {} (map (fn [module] [module namespace]) modules)))
                (assoc-in [:manifest (:path plan)] entry)
                (assoc-in [:units namespace] {"file" (Path/relative_to (:path plan) root)
                                              "key" (:key plan) "inputs" actual}))))
          {:built 0 :compiled 0 :cached 0 :errors [] :manifest {} :units {} :module-owners {} :ex-built 0
           :lock-wait-us 0 :native {:built 0 :cached 0 :artifacts [] :errors []}} plans)
        final-receipts (mapcat #(get % "inputs") (vals (:units result)))
        final-snapshot
        (measure timings :final-inputs (fn []
          (let [fresh (inputs/capture root selected final-receipts)]
            (doseq [[namespace row] (:units result)]
              (when-not (inputs/current? fresh (get row "inputs"))
                (throw (ex-info "Unit inputs changed during production" {:namespace namespace}))))
            fresh)))]
    ;; Full production owns removal. No old beam can survive outside the new
    ;; manifest; partial/scoped production preserves its explicit predecessor.
    (doseq [namespace (keys old)]
      (when-not (contains? (:units result) namespace)
        (let [directory (Path/join (Path/join out ".units") namespace)]
          (when (File/dir? directory)
            (doseq [[module _] (:beams (BeamLisp.AOT/verify_unit directory))]
              (File/rm (Path/join out (str (Atom/to_string module) ".beam")))))
          (File/rm_rf! directory))))
    (File/write! (Path/join out "unit-index.json")
      (Jason/encode! {"version" 1 "compiler" key "runtime" runtime "units" (:units result)}))
    (when-let [manifest (:manifest opts)] (File/write! manifest (erlang/term_to_binary (:manifest result))))
    (when-let [log (:log-path opts)]
      (blog/write! log (blog/facts-of (blog/state-of-manifest (:manifest result)))))
    (println (str "SDK-UNIT-PHASES " (Jason/encode!
      {:elapsed-us (- (erlang/monotonic_time :microsecond) started)
       :phases-us @timings :compiled (:compiled result) :cached (:cached result) :jobs width
       :input-reads {:initial (:reads snapshot) :final (:reads final-snapshot)
                     :references (count final-receipts)}})))
    (dissoc result :units :module-owners)))
