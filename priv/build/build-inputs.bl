;; One explicit source observation for one immutable production pass. No
;; process-global/path-only memo: a final independent pass validates the inputs.
(ns build-inputs)

(defn- digest [bytes]
  (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))

(defn capture
  "Resolve each namespace once and hash each resolved path once. selected
   contains the current constructor selection; receipts contribute macro and
   other actual inputs outside that selection. Missing inputs remain misses."
  [root selected receipts]
  (let [sdk (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        names (sort (distinct (concat (keys selected) (map #(get % "namespace") receipts))))]
    (reduce
      (fn [snapshot namespace]
        (let [path (or (get selected namespace) (BeamLisp.Loader/source_path namespace))
              current (when path (BeamLisp.AOT/physical_sdk_path path))
              cached (get-in snapshot [:paths current])
              row (or cached
                    (when (and current (File/regular? current))
                      {:path current :sha256 (digest (BeamLisp.Loader/read_source current))}))]
          (-> snapshot
            (assoc-in [:sources namespace] row)
            (assoc-in [:paths current] row)
            (update :reads + (if (and row (nil? cached)) 1 0)))))
      {:root root :sdk sdk :sources {} :paths {} :reads 0} names)))

(defn current?
  "Compare exact constructor receipts with this pass, including source
   resolution and scope. Neither mtime nor a dependency's interface is proof."
  [snapshot receipts]
  (and (seq receipts)
    (every? (fn [input]
      (let [row (get-in snapshot [:sources (get input "namespace")])
            base (if (= "root" (get input "scope")) (:root snapshot) (:sdk snapshot))]
        (and row
             (= (get input "file") (Path/relative_to (:path row) base))
             (= (get input "sha256") (:sha256 row))))) receipts)))
