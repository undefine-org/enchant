(ns build-environment)

(defn operator-environment
  "Closed host configuration for managed Nix clients, separate from project :env."
  []
  (into {} (keep (fn [key]
                   (when-let [value (erlang/apply :Elixir.System :get_env (list key))]
                     [key value]))
             ["HOME" "XDG_RUNTIME_DIR" "DBUS_SESSION_BUS_ADDRESS"
              "NIX_CONFIG" "NIX_SSHOPTS" "NIX_USER_CONF_FILES" "NIX_CONF_DIR"
              "SSH_AUTH_SOCK" "XDG_CONFIG_HOME"])))

