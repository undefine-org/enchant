;; SDK input adapter for the existing contextual Source catalog. The generated
;; forwarding Source has application authority; it does not become SDK code.
(ns compile.sdk
 (:require [expand-source :as source] [syntax :as syntax] [compiler :as compiler]))

(defn- refuse! [kind]
 (throw (ex-info "Invalid contextual SDK selection" {:kind kind})))

(defn- macro-template-symbols [value]
 (cond
  (symbol? value) [value]
  (or (erlang/is_list value) (vector? value) (set? value))
   (Enum/flat_map (to-list value) macro-template-symbols)
  (erlang/is_map value)
   (Enum/flat_map (Map/to_list value)
    #(Enum/concat (macro-template-symbols (elem % 0)) (macro-template-symbols (elem % 1))))
  :else []))

(defn- macro-template [value replacements splices]
 (cond
  (erlang/is_list value)
   (cond
    (= 'unquote (first value))
     (if (and (= 2 (count value)) (contains? replacements (second value))
              (not (contains? splices (second value))))
      (get replacements (second value)) (refuse! :world-sdk-macro-recipe))
    (= 'unquote-splicing (first value))
     (if (and (= 2 (count value)) (contains? splices (second value)))
      (get replacements (second value)) (refuse! :world-sdk-macro-recipe))
    (= 'syntax-quote (first value)) (refuse! :world-sdk-macro-recipe)
    :else (Enum/map value #(macro-template % replacements splices)))
  (vector? value) (mapv #(macro-template % replacements splices) value)
  (set? value) (set (Enum/map (to-list value) #(macro-template % replacements splices)))
  (erlang/is_map value)
   (Map/new (Enum/map (Map/to_list value)
    #(tuple (macro-template (elem % 0) replacements splices) (macro-template (elem % 1) replacements splices))))
  :else value))

(defn- macro-definition [binding]
 ;; Convert authenticated declaration DATA, never a live macro function. The
 ;; resulting defsyntax has the same recipe/session/hygiene path as app syntax.
 (let [form (:value binding) tail (when (erlang/is_list form) (drop 2 form))
       tail (if (string? (first tail)) (rest tail) tail)
       params (first tail) body (second tail)]
  (when-not (and (= 'defmacro (first form)) (= (symbol (:name binding)) (second form))
                 (= 2 (count tail)) (vector? params) (<= (count params) 64)
                 (every? symbol? params) (= (count params) (count (distinct params)))
                 (erlang/is_list body) (= 2 (count body)) (= 'syntax-quote (first body)))
   (refuse! :world-sdk-macro-recipe))
  (let [amp (Enum/find_index params #(= '& %))
        _ (when (and amp (not= amp (- (count params) 2))) (refuse! :world-sdk-macro-recipe))
        fixed (if amp (vec (take amp params)) params)
        rest-name (when amp (last params))
        names (if amp (conj fixed rest-name) fixed)
        template (second body) existing (set (macro-template-symbols template))
        holes (mapv #(symbol (str "__sdk_template_hole_" %)) (range (count names)))
        _ (when (some #(contains? existing %) holes) (refuse! :world-sdk-macro-recipe))
        replacements (Map/new (Enum/zip (to-list names) (to-list holes)))
        splices (if amp #{rest-name} #{})
        form-name 'sdk_macro_form context-name 'sdk_macro_context
        rest-expression (Enum/reduce (range (inc (count fixed))) (list :children form-name)
                          (fn [_ value] (list 'erlang/tl value)))
        arguments (Map/new (Enum/map (Enum/with_index holes)
                   (fn [pair]
                    (tuple (elem pair 0)
                     (if (and amp (= (elem pair 1) (count fixed)))
                      {:kind :contextual-splice :children rest-expression}
                      (list 'syntax-arg form-name (inc (elem pair 1))))))))]
   (list 'defsyntax (symbol (:name binding)) [form-name context-name]
    (list 'if (list (if amp 'erlang/>= 'erlang/==)
                    (list 'erlang/length (list :children form-name)) (inc (count fixed)))
     (list 'syntax-template (macro-template template replacements splices)
      (Map/new (Enum/map (Map/to_list arguments) #(tuple (list 'quote (elem % 0)) (elem % 1)))))
     (list 'throw :sdk-macro-arity))))))

(defn capture
 "Select SDK functions, declarative syntax and closed literals in one Source world.
  Revision is a quoted logical label; authenticated provider bytes participate
  in the generated Source digest and therefore the canonical world identity."
 [selection]
 (when-not (and (erlang/is_map selection) (= #{:sdk :revision :only} (set (keys selection)))
                (symbol? (:sdk selection)) (symbol? (:revision selection))
                (vector? (:only selection)) (<= 1 (count (:only selection)) 64)
                (every? symbol? (:only selection))
                (= (count (:only selection)) (count (distinct (:only selection)))))
  (refuse! :world-sdk-selection))
 (let [bindings (mapv #(BeamLisp.AOT/sdk_binding! (str (:sdk selection)) (str %))
                      (sort-by str (:only selection)))
       identity (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary bindings (list :deterministic)))
                              (list (tuple :case :lower)))
       definitions
       (Enum/map bindings
        (fn [binding]
         (cond
          (= :macro (:kind binding)) (macro-definition binding)
          (= :value (:kind binding)) (list 'def (symbol (:name binding)) (list 'quote (:value binding)))
          :else (BeamLisp.CompilerData/sdk_function_declaration binding))))
       source (str "; generated SDK forwarding Source, provider digest " identity "\n"
                   (pr-str (list 'ns (:sdk selection))) "\n" (Enum/join (Enum/map definitions pr-str) "\n"))]
  {:selection selection :bindings bindings
   :source {:namespace (:sdk selection) :revision (:revision selection)
            :file (str "sdk-forwarding:" (:sdk selection) ":" identity)
            :source source}}))

(defn check!
 "Recheck the original SDK evidence without invoking or initializing providers."
 [captured]
 (when-not (= captured (capture (:selection captured))) (refuse! :world-sdk-input-changed))
 captured)


(defn dependencies
 "Project SDK function dependencies from the SAME canonical Source/archive
  catalog. No macro, initializer, ambient Var or provider code executes."
 [sources libraries]
 (let [catalog (source/catalog sources libraries)
       groups (Enum/reduce (Map/values (:recipes catalog)) {}
        (fn [recipe groups]
         (if (not= :function (get-in recipe [:declaration :kind])) groups
          (let [unit (get-in catalog [:worlds (:world recipe)])
                form (syntax/to-reader (:node recipe))
                declaration (compiler/declaration-source form
                              (assoc (BeamLisp.Compiler/new_env (str (:namespace unit))) :file (:file unit)))
                claim (get-in declaration [:metadata :sdk-phase])]
           (if-not claim groups
            (let [binding (BeamLisp.AOT/sdk_function_declaration_binding! claim
                            {:namespace (str (:namespace unit)) :form form})
                  key [(:namespace unit) (:revision unit)]
                  names (conj (get groups key #{}) (symbol (:name binding)))]
             (when (or (> (count names) 64) (and (not (contains? groups key)) (>= (count groups) 128)))
              (refuse! :world-sdk-selection))
             (assoc groups key names)))))))]
  (mapv (fn [entry]
         {:sdk (first (elem entry 0)) :revision (second (elem entry 0))
          :only (vec (sort-by str (elem entry 1)))})
        (sort-by #(pr-str (elem % 0)) (Map/to_list groups)))))

(defn capture-dependencies
 "Join explicit selections and checked archive/Source dependencies once.
  Existing captured SDK inputs remain the only artifact/Loader metadata shape."
 [explicit sources libraries]
 (let [selections (concat (map :selection explicit) (dependencies sources libraries))
       groups (reduce
                (fn [out selection]
                 (let [key [(:sdk selection) (:revision selection)]
                       names (into (get out key #{}) (:only selection))]
                  (when (or (> (count names) 64) (and (not (contains? out key)) (>= (count out) 128)))
                   (refuse! :world-sdk-selection))
                  (assoc out key names))) {} selections)]
  (mapv (fn [entry]
          (capture {:sdk (first (elem entry 0)) :revision (second (elem entry 0))
                    :only (vec (sort-by str (elem entry 1)))}))
        (sort-by #(pr-str (elem % 0)) (Map/to_list groups)))))
