;; SDK input adapter for the existing contextual Source catalog. The generated
;; forwarding Source has application authority; it does not become SDK code.
(ns compile.sdk
 (:require [expand-source :as source] [syntax :as syntax] [compiler :as compiler]))

(defn- refuse! [kind]
 (throw (ex-info "Invalid contextual SDK selection" {:kind kind})))

(defn capture
 "Select SDK functions, declarative syntax and closed literals in one Source world.
  Revision is a quoted logical label; authenticated provider bytes participate
  in the generated Source digest and therefore the canonical world identity."
 [selection]
 (when-not (and (erlang/is_map selection) (= #{:sdk :revision :only} (set (keys selection)))
                (symbol? (:sdk selection)) (symbol? (:revision selection))
                (vector? (:only selection)) (<= 1 (count (:only selection)) 64)
                (every? symbol? (:only selection))
                (= (count (:only selection)) (count (distinct (:only selection)))))
  (refuse! :world-sdk-selection))
 (let [bindings (mapv #(BeamLisp.AOT/sdk_binding! (str (:sdk selection)) (str %))
                      (sort-by str (:only selection)))
       identity (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary bindings (list :deterministic)))
                              (list (tuple :case :lower)))
       definitions
       (Enum/map bindings
        (fn [binding]
         (cond
          (= :macro (:kind binding)) (BeamLisp.CompilerData/sdk_macro_declaration binding)
          (= :value (:kind binding)) (list 'def (symbol (:name binding)) (list 'quote (:value binding)))
          :else (BeamLisp.CompilerData/sdk_function_declaration binding))))
       source (str "; generated SDK forwarding Source, provider digest " identity "\n"
                   (pr-str (list 'ns (:sdk selection))) "\n" (Enum/join (Enum/map definitions pr-str) "\n"))]
  {:selection selection :bindings bindings
   :source {:namespace (:sdk selection) :revision (:revision selection)
            :file (str "sdk-forwarding:" (:sdk selection) ":" identity)
            :source source}}))

(defn check!
 "Recheck the original SDK evidence without invoking or initializing providers."
 [captured]
 (when-not (= captured (capture (:selection captured))) (refuse! :world-sdk-input-changed))
 captured)


(defn dependencies
 "Project SDK function dependencies from the SAME canonical Source/archive
  catalog. No macro, initializer, ambient Var or provider code executes."
 [sources libraries]
 (let [catalog (source/catalog sources libraries)
       groups (Enum/reduce (Map/values (:recipes catalog)) {}
        (fn [recipe groups]
         (if (or (not= :function (get-in recipe [:declaration :kind]))
                 (contains? #{'defrecord 'deftype} (:value (first (:children (:node recipe)))))) groups
          (let [unit (get-in catalog [:worlds (:world recipe)])
                form (syntax/to-reader (:node recipe))
                declaration (compiler/declaration-source form
                              (assoc (BeamLisp.Compiler/new_env (str (:namespace unit))) :file (:file unit)))
                claim (get-in declaration [:metadata :sdk-phase])]
           (if-not claim groups
            (let [binding (BeamLisp.AOT/sdk_function_declaration_binding! claim
                            {:namespace (str (:namespace unit)) :form form})
                  key [(:namespace unit) (:revision unit)]
                  names (conj (get groups key #{}) (symbol (:name binding)))]
             (when (or (> (count names) 64) (and (not (contains? groups key)) (>= (count groups) 128)))
              (refuse! :world-sdk-selection))
             (assoc groups key names)))))))]
  (mapv (fn [entry]
         {:sdk (first (elem entry 0)) :revision (second (elem entry 0))
          :only (vec (sort-by str (elem entry 1)))})
        (sort-by #(pr-str (elem % 0)) (Map/to_list groups)))))

(defn capture-dependencies
 "Join explicit selections and checked archive/Source dependencies once.
  Existing captured SDK inputs remain the only artifact/Loader metadata shape."
 [explicit sources libraries]
 (let [selections (concat (map :selection explicit) (dependencies sources libraries))
       groups (reduce
                (fn [out selection]
                 (let [key [(:sdk selection) (:revision selection)]
                       names (into (get out key #{}) (:only selection))]
                  (when (or (> (count names) 64) (and (not (contains? out key)) (>= (count out) 128)))
                   (refuse! :world-sdk-selection))
                  (assoc out key names))) {} selections)]
  (mapv (fn [entry]
          (capture {:sdk (first (elem entry 0)) :revision (second (elem entry 0))
                    :only (vec (sort-by str (elem entry 1)))}))
        (sort-by #(pr-str (elem % 0)) (Map/to_list groups)))))
