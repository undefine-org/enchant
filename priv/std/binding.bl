;; Immutable binding tables. These are Source data, not artifact admission.
;; The controller must derive the declarations from its actual selected source.
(ns binding (:require [syntax :as syn]))

(defn- refuse! [kind data]
 (throw (ex-info (str "Binding contract: " kind) (assoc data :kind kind))))

(defn- fields! [value allowed required]
 (when-not (and (erlang/is_map value) (not (contains? value :__struct__))
                (every? #(contains? allowed %) (keys value))
                (every? #(contains? value %) required))
  (refuse! :binding-fields {:actual (when (erlang/is_map value) (keys value))
                            :allowed allowed :required required}))
 value)

(defn- name! [value]
 (when-not (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value))
                (= :symbol (elem value 0)) (erlang/is_binary (elem value 1))
                (<= 1 (erlang/byte_size (elem value 1)) 512)
                (not (String/contains? (elem value 1) "/")))
  (refuse! :binding-symbol {:value value}))
 (elem value 1))

(defn- digest! [value]
 (when-not (and (erlang/is_binary value) (= 32 (erlang/byte_size value)))
  (refuse! :binding-digest {}))
 value)

(defn- finite! [value maximum]
 (when-not (or (vector? value) (erlang/is_list value)) (refuse! :binding-collection {}))
 (let [items (BeamLisp.CompilerData/eager_to_list value)]
  (when (> (erlang/length items) maximum) (refuse! :binding-bound {:maximum maximum}))
  items))

(defn- phase! [value]
 (when-not (and (erlang/is_integer value) (<= -4096 value 4096))
  (refuse! :binding-phase {}))
 value)

(defn- path! [value]
 (let [items (finite! value 64)]
  (when-not (every? #(and (erlang/is_integer %) (<= 0 % 1073741823)) items)
   (refuse! :binding-path {}))
  items))

(defn- selection! [selection]
 (fields! selection #{:version :profile :target :sources} [:version :profile :target :sources])
 (when-not (= 1 (:version selection)) (refuse! :binding-version {}))
 (name! (:profile selection)) (name! (:target selection))
 (let [sources (Enum/sort_by
                (Enum/map (finite! (:sources selection) 4096)
                 (fn [source]
                  (fields! source #{:namespace :digest} [:namespace :digest])
                  (name! (:namespace source)) (digest! (:digest source)) source))
                (fn [source] (name! (:namespace source))))
       names (Enum/map sources (fn [source] (:namespace source)))]
  (when (or (empty? sources) (not= names (Enum/uniq names)))
   (refuse! :binding-sources {}))
  (assoc selection :sources sources)))

(defn world-key
 "Canonical logical input key. The descriptor accepts source revisions,
  profile and target names; physical artifacts/receipts are separate inputs."
 [selection]
 (let [s (selection! selection)]
  (crypto/hash :sha256
   (erlang/term_to_binary
    (tuple :binding-world-v1 (name! (:profile s)) (name! (:target s))
     (Enum/map (:sources s) (fn [source] (tuple (name! (:namespace source)) (:digest source)))))))))

(defn- owners [selection]
 (Map/new (Enum/map (:sources selection) #(tuple (:namespace %) (:digest %)))))

(defn- owner! [selected owner]
 (name! owner)
 (when-not (Map/has_key? selected owner)
  (refuse! :binding-owner {:owner owner}))
 owner)

(defn- scope-record [key owner path role]
 (when-not (contains? #{:module :lexical :introduction :use-site :import} role)
  (refuse! :binding-scope-role {}))
 {:version 1 :kind :binding-scope :world key :owner owner :path path :role role
  :id (crypto/hash :sha256 (erlang/term_to_binary (tuple :binding-scope-v1 key owner path role)))})

(defn scope
 "Stable scope coordinates, allocated by the expansion controller. Distinct
  expansion paths/roles remain distinct; no process counter or artifact hash."
 [selection owner path role]
 (let [selection (selection! selection) key (world-key selection)
       owner (owner! (owners selection) owner) path (path! path)]
  (scope-record key owner path role)))

(defn- scopes! [value registry]
 (let [ids (Enum/sort (Enum/uniq (Enum/map (finite! value 128) digest!)))]
  (when-not (every? #(contains? registry %) ids) (refuse! :binding-foreign-scope {}))
  ids))

(defn- declaration! [selected key registry declaration]
 (fields! declaration #{:namespace :name :phase :space :kind :path :scopes :visibility :available-from}
                      [:namespace :name :phase :space :kind :path :scopes :visibility :available-from])
 (owner! selected (:namespace declaration)) (name! (:name declaration))
 (name! (:space declaration)) (phase! (:phase declaration))
 (when-not (contains? #{:value :function :macro :syntax :core} (:kind declaration))
  (refuse! :binding-declaration-kind {}))
 (when-not (contains? #{:public :private :local} (:visibility declaration))
  (refuse! :binding-visibility {}))
 (when-not (and (erlang/is_integer (:available-from declaration))
                (<= 0 (:available-from declaration) 1073741823))
  (refuse! :binding-position {}))
 (let [d (assoc declaration :path (path! (:path declaration))
                            :scopes (scopes! (:scopes declaration) registry))
       ;; This is the complete, finite declaration coordinate, without its ID.
       coordinate (tuple :binding-declaration-v1 key (:namespace d) (:name d) (:phase d)
                         (:space d) (:kind d) (:path d) (:scopes d) (:visibility d) (:available-from d))]
  (assoc d :id (crypto/hash :sha256 (erlang/term_to_binary coordinate)))))

(defn world
 "Build a bounded, immutable indexed table. Scope and declaration rows are
  explicit controller output, not evidence that arbitrary source was checked.
  Validate serialized tables once before repeated lookup. No Env fallback."
 [selection scope-records declarations]
 (let [selection (selection! selection) key (world-key selection) selected (owners selection)
       registry (Enum/reduce (finite! scope-records 16384) {}
                 (fn [record out]
                  (fields! record #{:version :kind :world :owner :path :role :id}
                                  [:version :kind :world :owner :path :role :id])
                  (let [expected (scope-record key (owner! selected (:owner record)) (path! (:path record)) (:role record))]
                   (when (or (not= record expected) (contains? out (:id record)))
                    (refuse! :binding-scope-record {}))
                   (assoc out (:id record) record))))
       rows (Enum/sort_by
              (Enum/map (finite! declarations 16384) #(declaration! selected key registry %))
              (fn [d] (:id d)))
       coordinates (Enum/map rows #(tuple (:namespace %) (:phase %) (:space %) (:name %) (:scopes %)))
       paths (Enum/map rows #(tuple (:namespace %) (:phase %) (:space %) (:path %)))
       _ (when (or (not= coordinates (Enum/uniq coordinates)) (not= paths (Enum/uniq paths)))
           (refuse! :binding-duplicate-declaration {}))
       index (Enum/group_by rows #(tuple (:name %) (:phase %) (:space %)))]
  {:version 1 :kind :binding-world :key key :selection selection :scopes registry
   :declarations rows :index index :owners selected
   :by-id (Map/new (Enum/map rows #(tuple (:id %) %)))}))

(defn validate-world
 "Rebuild and compare all serialized fields, including the index. A valid
  table remains ordinary data; this check never authenticates a compiler."
 [value]
 (fields! value #{:version :kind :key :selection :scopes :declarations :index :by-id :owners}
                [:version :kind :key :selection :scopes :declarations :index :by-id :owners])
 (let [expected (world (:selection value) (Map/values (:scopes value))
                       (Enum/map (:declarations value) #(dissoc % :id)))]
  (when-not (= expected value) (refuse! :binding-invalid-world {}))
  value))

(defn reference-id [world declaration]
 (let [row (Map/get (:by-id world) declaration)]
  (when-not row (refuse! :binding-unknown-declaration {}))
  (crypto/hash :sha256 (erlang/term_to_binary (tuple :binding-reference-v1 (:key world) declaration)))))

(defn- subset? [left right]
 (every? #(Map/has_key? right %) left))

(defn resolve
 "Resolve a contextual identifier in a validated world at one phase and source
  position. Bucketed lookup uses scope containment, never a spelling fallback.
  Unavailable inner declarations do not silently select an outer binding."
 [world identifier phase position]
 (when-not (and (= 1 (:version world)) (= :binding-world (:kind world))
                (syn/identifier? identifier) (= (:key world) (get-in identifier [:context :world])))
  (refuse! :binding-context {}))
 (phase! phase)
 (when-not (and (erlang/is_integer position) (<= 0 position 1073741823))
  (refuse! :binding-position {}))
 (let [context (syn/context (:context identifier)) name (:value identifier) space (:space context)
       _ (name! name) _ (name! space) _ (owner! (:owners world) (:namespace context))
       ids (scopes! (syn/scopes identifier phase) (:scopes world))
       scope-set (Map/new (Enum/map ids #(tuple % true)))
       bucket (Map/get (:index world) (tuple name phase space) (list))
       candidates (Enum/filter bucket
                    #(and (or (not= :private (:visibility %)) (= (:namespace %) (:namespace context)))
                           (subset? (:scopes %) scope-set)))
       ;; A greatest candidate must contain every applicable candidate's scopes.
       ;; Compare the union once instead of comparing all pairs of candidates.
       union (Enum/uniq (Enum/flat_map candidates (fn [d] (:scopes d))))
       greatest (Enum/filter candidates #(= (count (:scopes %)) (count union)))
       selected (when (= 1 (count greatest)) (first greatest))
       status (cond (empty? candidates) :unbound
                    (nil? selected) :ambiguous
                    (> (:available-from selected) position) :not-yet-available
                    :else :resolved)]
  {:version 1 :status status :phase phase :position position
   :candidates (Enum/map candidates (fn [d] (:id d)))
   :declaration (when (= :resolved status) selected)
   :reference (when (= :resolved status)
                {:version 1 :kind :binding-reference :world (:key world) :declaration (:id selected)
                 :id (reference-id world (:id selected)) :phase phase :space space})}))
