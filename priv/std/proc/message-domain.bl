; Actual published predicate/transform ANF only; no execution of user code.
; This proves old-accept => candidate-accept(upcast(input)), not business logic,
; state/reply validity, migration totality outside the old domain or authority.
(ns proc.message-domain
 (:require [system.ir :as ir] [system.publication :as publication]
           [data.first-order :as data] [reload.source-producer :as producer]
           [reload.native-call :as native-call] [datom.query.read-only :as read-only]))
(def MAX-NODES 32768)
(def MAX-HELPERS 32)
(def MAX-BRANCHES 32)
(defn- refuse [reason] (throw (ex-info "Message migration proof unavailable" {:reason reason})))
(defn- decision-step! []
 (when-let [left (Process/get :proc.message-domain/decision-budget)]
  (when (neg? (swap! left dec)) (refuse :message-domain-budget))))
(defn- decision! [action]
 (let [before (Process/get :proc.message-domain/decision-budget)]
  (Process/put :proc.message-domain/decision-budget (atom MAX-NODES))
  (try (action)
   (finally (if before (Process/put :proc.message-domain/decision-budget before)
                       (Process/delete :proc.message-domain/decision-budget))))))
(defn- lit [value] {:tag :literal :value value})
(defn- scalar? [value]
 (or (nil? value) (erlang/is_atom value) (erlang/is_integer value)
     (erlang/is_float value) (erlang/is_binary value)))
(defn- literal? [value] (= :literal (:tag value)))
(defn- message-key? [value] (or (erlang/is_atom value) (erlang/is_binary value)))
(defn- tick [state]
 (when (>= (:nodes state) MAX-NODES) (refuse :message-domain-budget))
 (update state :nodes inc))
(defn- require-domain [state value domain]
 ;; Only the symbolic obligation belongs to this update callback. Capturing
 ;; the accumulated state would also retain every published definition.
 (let [obligation {:value value :domain domain :when (:conditions state [])}]
  (update state :obligations (fn [all] (conj (or all []) obligation)))))
(defn- source-arguments
 ([state arguments] (source-arguments state arguments true))
 ([state arguments assumption?]
 ;; The complete proper argv shares one native budget. Keep duplicates and
 ;; the exact reached branch; a guard in a skipped branch proves nothing.
 (let [guard {:arguments arguments :when (:conditions state []) :assumption? assumption?}]
  (update state :source-guards (fn [all] (conj (or all []) guard))))))
(defn- stamp [state module]
 (if (contains? (:modules state) module) state
  (let [identity (if (= module :erlang)
                   [:otp (erlang/system_info :otp_release) (erlang/system_info :version)]
                   [:beam (erlang/apply module :module_info (list :md5))])]
   (assoc-in state [:modules module] identity))))
(defn- kernel [state module]
 ;; Loaded first; this attests bytes against the actual coherent seed. It never
 ;; admits an uninitialized provider, an arbitrary module prefix or mutable Var.
 (if (contains? (:kernels state #{}) module) state
  (do
   (when-not (and (contains? #{:Elixir.BeamLisp.Ns.Rt :Elixir.BeamLisp.Ns.Core :Elixir.BeamLisp.Num :Elixir.BeamLisp.Set :Elixir.BeamLisp.Vector} module)
                  (erlang/module_loaded module) (BeamLisp.AOT/seed_dependency! module))
    (refuse :unattested-message-kernel))
   (update (stamp state module) :kernels (fn [all] (conj (or all #{}) module))))))
(defn- snapshot! [state namespace name]
 (let [key [namespace name]]
  (if-let [saved (get-in state [:definitions key])] [state saved]
   (do
    (when (>= (count (:definitions state)) MAX-HELPERS) (refuse :message-domain-budget))
    (let [result (publication/snapshot-result namespace name) saved (:snapshot result)]
     (when (= :error (:status result)) (refuse :message-publication-error))
     (when-not saved (refuse :unpublished-message-helper))
     (BeamLisp.CompilerData/constructor_data_cost! (dissoc saved :generation)
                                                 {:callables {} :recipes {} :recipe-frame nil})
     [(assoc-in state [:definitions key] saved) saved])))))
(declare lift choose literal-has-type?)
(defn- lift-case [state environment subject clauses]
 (when (empty? clauses) (refuse :partial-message-case))
 (let [clause (first clauses) pats (:pats clause) pat (first pats)]
  (when-not (and (= 1 (count pats)) (nil? (:guard clause))) (refuse :complex-message-case))
  (case (:pop pat)
   :pvar (lift state (assoc environment (:name pat) subject) (:body clause))
   :plit (do
           (when-not (scalar? (:val pat)) (refuse :complex-message-case))
           (let [test {:tag :strict-eq :left subject :right (lit (:val pat))}
                 conditions (:conditions state [])
                 [state then] (lift (assoc state :conditions (conj conditions test)) environment (:body clause))
                 [state else] (lift-case (assoc state :conditions (conj conditions {:tag :not :value test})) environment subject (rest clauses))]
            [(assoc state :conditions conditions) {:tag :choose :test test
                    :then then :else else}]))
   (refuse :complex-message-case))))
(defn- lift-all [state environment nodes]
 (loop [state state nodes (seq nodes) out []]
  (if-not nodes [state out]
   (let [[after value] (lift state environment (first nodes))]
    (recur after (next nodes) (conj out value))))))
(defn- field [value key default lookup]
 (decision-step!)
 (when-not (and (literal? key) (message-key? (:value key)) (not= :__struct__ (:value key)))
  (refuse :dynamic-or-reserved-message-key))
 (if (and (literal? value) (erlang/is_map (:value value))
          (or (= :native lookup) (not (maps/is_key :__struct__ (:value value)))))
  (let [found (maps/find (:value key) (:value value))]
   (if (= :error found) default (lit (elem found 1))))
 (if (= :choose (:tag value))
  (choose (:test value) (field (:then value) key default lookup) (field (:else value) key default lookup))
 (if (= :map (:tag value))
  (cond (contains? (:fields value) (:value key)) (get (:fields value) (:value key))
        (contains? (:removed value #{}) (:value key)) default
        (:base value) (field (:base value) key default lookup)
        :else default)
  {:tag :field :target value :key (:value key) :default default :lookup lookup}))))
(defn- assoc-term [base key value]
 (when-not (and (literal? key) (message-key? (:value key)) (not= :__struct__ (:value key)))
  (refuse :dynamic-or-reserved-message-key))
 ;; No false plain-map model for arbitrary Record/SortedMap/foreign structs.
 ;; Reconstruction and updates of a known literal map are exact and supported.
 (let [base (if (= :map (:tag base)) base {:tag :map :base base :fields {} :removed #{}})]
  (assoc base :fields (assoc (:fields base) (:value key) value))))
(defn- remove-term [base key]
 (when-not (and (literal? key) (message-key? (:value key))
                (not= :__struct__ (:value key))) (refuse :unknown-message-map-update-domain))
 (let [base (if (= :map (:tag base)) base {:tag :map :base base :fields {} :removed #{}})]
  (assoc base :fields (dissoc (:fields base) (:value key))
              :removed (conj (:removed base #{}) (:value key)))))
(defn- boolean-term? [value]
 (or (and (literal? value) (contains? #{true false} (:value value)))
     (contains? #{:type :eq :bl-eq :num-eq :strict-eq :cmp :and :or :not :key?} (:tag value))))
(defn- choose [test then else]
 (cond
  (literal? test) (if (contains? #{false nil} (:value test)) else then)
  (and (boolean-term? test) (boolean-term? then)
       (or (= (lit false) else) (= test else)))
   {:tag :and :terms [test then]}
  (and (boolean-term? test) (= test then) (boolean-term? else))
   {:tag :or :terms [test else]}
  (and (boolean-term? test) (= (lit true) then) (= (lit false) else)) test
  (and (boolean-term? test) (= (lit false) then) (= (lit true) else)) {:tag :not :value test}
  :else {:tag :choose :test test :then then :else else}))
(defn- scalar-comparison [kind a b]
 (case kind :eq (erlang/== a b) :bl-eq (= a b) :num-eq (erlang/== a b) :strict-eq (erlang/=:= a b)
  :> (erlang/> a b) :>= (erlang/>= a b) :< (erlang/< a b) :<= (erlang/=< a b)
  (refuse :unknown-message-comparison)))
(defn- comparison [kind a b]
 (decision-step!)
 (cond
  (= :choose (:tag a)) (choose (:test a) (comparison kind (:then a) b) (comparison kind (:else a) b))
  (= :choose (:tag b)) (choose (:test b) (comparison kind a (:then b)) (comparison kind a (:else b)))
  (and (contains? #{:eq :bl-eq :num-eq :strict-eq} kind) (literal? a) (not (literal? b))) (comparison kind b a)
  :else (if (and (literal? a) (literal? b) (scalar? (:value a)) (scalar? (:value b)))
  (lit (scalar-comparison kind (:value a) (:value b)))
  (if (contains? #{:eq :bl-eq :num-eq :strict-eq} kind) {:tag kind :left a :right b}
   {:tag :cmp :operator kind :left a :right b}))))
(defn- vector-count [value]
 (decision-step!)
 (cond
  (= :eager-read (:tag value)) {:tag :eager-read :operation :count :input value}
  (= :vector (:tag value)) (lit (count (:items value)))
  (= :choose (:tag value)) (choose (:test value) (vector-count (:then value)) (vector-count (:else value)))
  :else {:tag :vector-count :target value}))
(defn- vector-at [value index default]
 (decision-step!)
 (cond
  (= :eager-read (:tag value)) {:tag :eager-read :operation :nth :input value :index index :default default}
  (= :vector (:tag value)) (get (:items value) index default)
  (= :choose (:tag value)) (choose (:test value) (vector-at (:then value) index default) (vector-at (:else value) index default))
  :else {:tag :vector-at :target value :index index :default default}))
(defn- type-term [type value]
 (if (literal? value) (lit (literal-has-type? (:value value) type))
 (if (= :choose (:tag value))
  (choose (:test value) (type-term type (:then value)) (type-term type (:else value)))
  {:tag :type :type type :value value})))
(defn- key-term [value key]
 (cond
  (= :map (:tag value))
   (cond (contains? (:fields value) key) (lit true)
         (contains? (:removed value #{}) key) (lit false)
         (:base value) (key-term (:base value) key)
         :else (lit false))
  (and (literal? value) (erlang/is_map (:value value))) (lit (maps/is_key key (:value value)))
  :else {:tag :key? :target value :key key}))
(defn- primitive [state module function args]
 (do
 (when-not (and (contains? #{:erlang :maps :Elixir.BeamLisp.Ns.Rt :Elixir.BeamLisp.Num :Elixir.BeamLisp.Set :Elixir.BeamLisp.Vector} module)
                (erlang/module_loaded module)) (refuse :unknown-message-operation))
 (let [arity (count args) pair [module function] a (first args) b (second args)
       rt? (= module :Elixir.BeamLisp.Ns.Rt)
       type (get {[:erlang :is_integer] :integer [:erlang :is_float] :float
                   [:erlang :is_number] :number [:erlang :is_binary] :binary
                   [:erlang :is_map] :raw-map [:erlang :is_atom] :atom
                   [:Elixir.BeamLisp.Ns.Rt :keyword?] :keyword
                   [:Elixir.BeamLisp.Ns.Rt :kind-keyword?] :keyword
                   [:Elixir.BeamLisp.Ns.Rt :vector?] :vector
                   [:Elixir.BeamLisp.Ns.Rt :kind-vector?] :vector
                   [:Elixir.BeamLisp.Ns.Rt :int?] :bl-integer
                   [:Elixir.BeamLisp.Ns.Rt :kind-int?] :bl-integer
                   [:Elixir.BeamLisp.Ns.Rt :string?] :bl-binary
                   [:Elixir.BeamLisp.Ns.Rt :kind-string?] :bl-binary
                   [:Elixir.BeamLisp.Ns.Rt :number?] :bl-number
                   [:Elixir.BeamLisp.Ns.Rt :kind-number?] :bl-number
                   [:Elixir.BeamLisp.Ns.Rt :map?] :maplike
                   [:Elixir.BeamLisp.Ns.Rt :call-map?] :maplike} pair)
       equality (get {[:erlang :==] :eq [:erlang :=:=] :strict-eq
                       [:Elixir.BeamLisp.Num :num_eq] :num-eq
                       [:Elixir.BeamLisp.Ns.Rt :eqv] :bl-eq
                       [:Elixir.BeamLisp.Ns.Rt :k-eqv] :bl-eq} pair)
       ordering (get {[:erlang :>] :> [:erlang :>=] :>= [:erlang :<] :< [:erlang :=<] :<=
                       [:Elixir.BeamLisp.Num :gt] :> [:Elixir.BeamLisp.Num :ge] :>=
                       [:Elixir.BeamLisp.Num :lt] :< [:Elixir.BeamLisp.Num :le] :<=} pair)
       state (if (or rt? (= module :Elixir.BeamLisp.Num)) (kernel state module) (stamp state module))]
  (cond
   (and type (= arity 1)) [state (type-term type a)]
   (and equality (= arity 2))
    (do (when-not (or (and (literal? a) (scalar? (:value a)))
                      (and (literal? b) (scalar? (:value b))))
          (refuse :possibly-forcing-message-equality))
        [(cond (= equality :bl-eq) (require-domain (require-domain state a :raw-scalar) b :raw-scalar)
               (= equality :num-eq) (require-domain (require-domain state a :raw-number) b :raw-number)
               :else state) (comparison equality a b)])
   (and (= module :Elixir.BeamLisp.Num) (contains? #{:add :sub :mul} function) (= arity 2))
    ;; Finite floats can overflow. Mathematical integer arithmetic is the
    ;; closed universal subset; a float range needs separate exact evidence.
    [(require-domain (require-domain state a :raw-integer) b :raw-integer)
     {:tag :number-op :operator function :args args}]
   (and ordering (= arity 2))
    [(if (= module :Elixir.BeamLisp.Num)
       (require-domain (require-domain state a :raw-number) b :raw-number) state)
     (comparison ordering a b)]
   (and rt? (contains? #{:get :coll-get} function) (contains? #{2 3} arity))
    [(if (= :map (:tag a)) state (require-domain state a :plain-map))
     (field a b (if (= arity 3) (nth args 2) (lit nil)) :rt)]
   (and (= module :maps) (= function :get) (contains? #{2 3} arity))
    ;; maps:get/2 may raise for missing keys; don't silently model it as get/3.
    (if (= arity 3) [(require-domain state b :raw-map) (field b a (nth args 2) :native)] (refuse :partial-native-message-lookup))
   (and rt? (= :hash_key function) (= arity 1) (literal? a) (message-key? (:value a)))
    [state a]
   (and rt? (contains? #{:assoc :coll-assoc} function) (= arity 3)) [(if (= :map (:tag a)) state (require-domain state a :plain-map)) (assoc-term a b (nth args 2))]
   (and (= module :maps) (= function :put) (= arity 3)) [(require-domain state (nth args 2) :plain-map) (assoc-term (nth args 2) a b)]
   (and (= module :maps) (= function :remove) (= arity 2)) [(require-domain state b :plain-map) (remove-term b a)]
   (and rt? (contains? #{:dissoc :coll-dissoc} function) (= arity 2)) [(if (= :map (:tag a)) state (require-domain state a :plain-map)) (remove-term a b)]
   (and rt? (contains? #{:not- :call-not-} function) (= arity 1) (boolean-term? a))
    [state {:tag :not :value a}]
   (and rt? (contains? #{:pos? :num-pos?} function) (= arity 1))
    [(require-domain state a :raw-number) (comparison :> a (lit 0))]
   (and (= pair [:erlang :is_map_key]) (= arity 2) (literal? a))
    [(require-domain state b :raw-map) (key-term b (:value a))]
   (and (= pair [:Elixir.BeamLisp.Set :new]) (= arity 1)
        (literal? a) (erlang/is_list (:value a)) (<= (count (:value a)) MAX-BRANCHES)
        (every? scalar? (:value a)))
    [(kernel state module) (lit (BeamLisp.Set/new (:value a)))]
   (and rt? (contains? #{:contains? :coll-contains?} function) (= arity 2)
        (literal? a) (set? (:value a)) (<= (count (:value a)) MAX-BRANCHES)
        (every? scalar? (:value a)))
    [(require-domain state b :raw-scalar)
     {:tag :or :terms (mapv #(comparison :bl-eq b (lit %)) (:value a))}]
   (and rt? (contains? #{:contains? :coll-contains?} function) (= arity 2)
        (literal? b) (message-key? (:value b)))
    [(require-domain state a :plain-map) (key-term a (:value b))]
   (and rt? (contains? #{:count :k-count :coll-count} function) (= arity 1))
    [(require-domain state a :vector) (vector-count a)]
   (and rt? (contains? #{:first :k-first} function) (= arity 1))
    [(require-domain state a :vector) (vector-at a 0 (lit nil))]
   (and rt? (contains? #{:nth :k-nth} function) (contains? #{2 3} arity)
        (literal? b) (erlang/is_integer (:value b)) (<= 0 (:value b) 16383))
    [(require-domain state a :vector) (vector-at a (:value b) (if (= arity 3) (nth args 2) (lit nil)))]
   :else (refuse :unknown-message-operation)))))
(defn- helper [state namespace name values]
 (let [key [namespace name]]
  (when (contains? (:stack state) key) (refuse :recursive-message-helper))
  (let [[state saved] (snapshot! state namespace name)
        matching (filter #(and (= :fixed (elem % 0)) (= (count values) (elem % 1))) (:entries saved))]
   (when-not (= 1 (count matching)) (refuse :ambiguous-message-helper))
   (let [clause (elem (first matching) 3) params (:params clause)]
    (when-not (and (nil? (:guard clause)) (every? #(= :pvar (:pop %)) params))
     (refuse :patterned-message-helper))
    (let [environment (into {} (mapv (fn [p v] [(:name p) v]) params values))
          [after result] (lift (update state :stack conj key) environment (:body clause))]
     [(update after :stack disj key) result])))))
(defn- native-function [value]
 (when (and (erlang/is_function value) (= :external (elem (erlang/fun_info value :type) 1)))
  [(elem (erlang/fun_info value :module) 1) (elem (erlang/fun_info value :name) 1)
   (elem (erlang/fun_info value :arity) 1)]))
(defn- callable-arm [value arity]
 (if (erlang/is_function value) value
  (when (and (erlang/is_tuple value) (= 3 (erlang/tuple_size value))
             (= :"$blfn" (elem value 0)) (erlang/is_map (elem value 1)))
   (maps/get arity (elem value 1) nil))))
(defn- readonly-target [module function arity]
 (when (and (= 2 arity) (= :read! function))
  (let [entry (BeamLisp.Env/sdk_callable! "datom.query.read-only" "read!" 2)
        binding (native-function entry)]
   (when (or (= [module function arity] binding)
             (= module (BeamLisp.Emit/module_for "datom.query.read-only")))
    (BeamLisp.AOT/sdk_callable_evidence! entry)
    (BeamLisp.AOT/sdk_callable_evidence! (erlang/make_fun module function arity))
    {:namespace "datom.query.read-only" :function "read!" :module module :name function :arity arity :binding binding}))))
(defn- readonly-call [state target values]
 (let [query (first values)]
  (when-not (literal? query) (refuse :dynamic-state-observation-query))
  (when (>= (count (:reads state [])) MAX-BRANCHES) (refuse :message-domain-budget))
  (let [plan (read-only/plan! (:value query))
        read {:query (:query plan) :attributes (:attributes plan) :connection (second values) :target target}]
   [(-> (stamp state (:module target))
        (update :reads (fn [all] (conj (or all []) read))))
    {:tag :eager-read :read read}])))
(defn- global [state node values guarded?]
 (let [found (if (= :exact (:lookup node)) (BeamLisp.Env/fetch_exact (:ns node) (:name node))
              (BeamLisp.Env/fetch (:ns node) (:name node)))
       f (when (and (tuple? found) (= :ok (elem found 0))) (elem found 1))
       native (native-function (callable-arm f (count values)))]
  (when-not native (refuse :dynamic-message-helper))
  (when-not (= (count values) (nth native 2)) (refuse :message-helper-arity))
  (let [state (assoc-in state [:bindings [(:ns node) (:name node) (:lookup node)]] native)
        module (first native) function (second native)]
   (if-let [target (readonly-target module function (count values))] (readonly-call state target values)
   (if (= module :Elixir.BeamLisp.Ns.Rt) (primitive (if guarded? (source-arguments state values (:source-ingress state false)) state) module function values)
    (let [home (first (filter #(= module (BeamLisp.Emit/module_for %)) (:namespaces state)))]
     (when-not home (refuse :unknown-message-helper-provider))
     (helper state home (erlang/atom_to_binary function :utf8) values)))))))
(defn- call [state environment node]
 (let [site (ir/call-site node)]
  (when-not (and site (some? (:arity site))) (refuse :dynamic-message-call))
  (let [[state values] (lift-all state environment (:args site)) target (:callee site)
        state (if (:source-argument-guard node) (source-arguments state values) state)]
   (cond
    (and (= :lit (:op target)) (keyword? (:val target)) (contains? #{1 2} (count values)))
     [(let [state (kernel state :Elixir.BeamLisp.Ns.Rt)]
        (if (= :map (:tag (first values))) state (require-domain state (first values) :plain-map)))
      (field (first values) (lit (:val target)) (if (= 2 (count values)) (second values) (lit nil)) :rt)]
    (= :global (:op target)) (global state target values (= :invoke (:mode site)))
    (= :remote (:mode site))
     (if-let [target (readonly-target (:mod site) (:fun site) (count values))] (readonly-call state target values)
     (if-let [home (first (filter #(= (:mod site) (BeamLisp.Emit/module_for %)) (:namespaces state)))]
      (helper state home (erlang/atom_to_binary (:fun site) :utf8) values)
      (primitive state (:mod site) (:fun site) values)))
    :else (refuse :dynamic-message-call)))))
(defn lift [state environment node]
 (let [state (tick state)
       ;; Snapshot/callback provenance is checked before lifting. Analyze the
       ;; actual executable call beneath compiler-owned Source restrictions;
       ;; this proof still grants no execution, callback or native authority.
       original (producer/initialization-body node)
       previous-ingress (:source-ingress state false)
       ingress? (not= original node)
       state (if ingress? (assoc state :source-ingress true) state)
       guarded (native-call/original-source-call original)
       node (if guarded (assoc guarded :source-argument-guard true) (producer/analysis-node node))]
  (when-not (ir/node? node) (refuse :unknown-message-ir))
  (let [[after value] (case (:op node)
   :lit (do (data/check! (:val node) {:max-nodes 16384 :max-bytes 1048576 :max-depth 64})
            [state (lit (:val node))])
   :enil [state (lit ())]
   :cons
    (let [[state head] (lift state environment (:head node))
          [state tail] (lift state environment (:tail node))]
     ;; Reconstruct only bounded proper literal lists, never a lazy sequence,
     ;; protocol value or arbitrary constructor. Set literals use this ABI.
     (when-not (and (literal? head) (literal? tail) (erlang/is_list (:value tail))
                    (< (count (:value tail)) MAX-BRANCHES))
      (refuse :unproved-message-literal-list))
     [state (lit (cons (:value head) (:value tail)))])
   :var (if (contains? environment (:name node)) [state (get environment (:name node))]
          (refuse :free-message-variable))
   :let (let [[after value] (lift state environment (:init node))]
          (lift after (assoc environment (:name node) value) (:body node)))
   :do (loop [state state nodes (seq (:stmts node)) value (lit nil)]
         (if-not nodes [state value]
          (let [[after value] (lift state environment (first nodes))]
           (recur after (next nodes) value))))
   :if (let [[state test] (lift state environment (:test node)) conditions (:conditions state [])
             [state then] (lift (assoc state :conditions (conj conditions test)) environment (:then node))
             [state else] (lift (assoc state :conditions (conj conditions {:tag :not :value test})) environment (:else node))]
         [(assoc state :conditions conditions) (choose test then else)])
   :case (let [[state subject] (lift state environment (:subj node))]
           (lift-case state environment subject (:clauses node)))
   :map (let [[after entries] (lift-all state environment (mapcat identity (:pairs node)))
              fields (reduce (fn [out pair]
                         (let [[key value] pair]
                          (when-not (and (literal? key) (message-key? (:value key))
                                         (not= :__struct__ (:value key))) (refuse :dynamic-or-reserved-message-key))
                          (assoc out (:value key) value))) {} (partition 2 entries))]
          [after {:tag :map :fields fields :removed #{}}])
   :struct
    (let [fields (:fields node) pair (first fields) items (second pair)]
     ;; The compiler's small eager Vector literal is fixed field assembly.
     ;; No caller-nominated constructor, arbitrary field or trie is admitted.
     (when-not (and (= :Elixir.BeamLisp.Vector (:mod node)) (= 1 (count fields))
                    (= :lit (:op (first pair))) (= :items (:val (first pair)))
                    (= :tuple (:op items)) (<= (count (:elems items)) MAX-BRANCHES))
      (refuse :unsupported-message-constructor))
     (let [[after values] (lift-all (kernel state :Elixir.BeamLisp.Vector) environment (:elems items))]
      [after {:tag :vector :items values}]))
   :arith (let [[after values] (lift-all state environment (:args node))]
            (primitive after :Elixir.BeamLisp.Num (:fun node) values))
   :remote (call state environment node)
   :invoke (call state environment node)
   :apply (call state environment node)
   (refuse :unsupported-message-ir))]
   [(if ingress? (assoc after :source-ingress previous-ingress) after) value])))
(defn- with-environment [environment action]
 (let [environment (BeamLisp.Env/resolve_native_context! environment)]
 ;; A captured public context is not executable custody. Even readonly proof
 ;; helpers require a live, attested graph lease before selecting that context.
 (let [enter (fn []
              (let [previous (BeamLisp.Env/capture)]
               (try (BeamLisp.Env/bind environment) (action)
                (finally (BeamLisp.Env/bind previous)))))]
  (if-let [graph (:generation environment)]
   (if (BeamLisp.Env/executing_generation? graph) (enter)
    (do
     (BeamLisp.Loader/ensure_loaded "reload.generation")
     (let [with! (BeamLisp.Env/sdk_callable! "reload.generation" "with!" 2)]
      (with! graph enter))))
   (enter)))))

(defn- capture-current-once
 "Capture a single exact named published arity-one callback, without invoking
  it. Anonymous/captured/higher-order/dynamic/effectful bodies decline. Metadata
  and native identities are private bounded evidence, never adoption authority."
 [callback]
 (BeamLisp.Env/assert_execution_context!)
 (try
   (let [native (native-function callback) graph (Process/get :bl_generation)
         namespaces (vec (distinct (concat (vals (:mapping graph)) [(BeamLisp.Env/current_ns) "core" "sugar"])))
         home (when native (first (filter #(and (string? %) (= (first native) (BeamLisp.Emit/module_for %))) namespaces)))
         state {:nodes 0 :stack #{} :definitions {} :modules {} :bindings {} :obligations [] :namespaces namespaces}]
    (when-not (and native (contains? #{1 2} (nth native 2))) (refuse :unpublished-message-callback))
    (let [epoch (BeamLisp.Env/publication_epoch)
          args (if (= 1 (nth native 2)) [{:tag :input}] [{:tag :input} {:tag :request}])
          direct? (contains? #{:Elixir.BeamLisp.Ns.Rt :Elixir.BeamLisp.Num} (first native))
          _ (when (and (not direct?) (nil? home)) (refuse :unpublished-message-callback))
          _ (when direct? (BeamLisp.AOT/sdk_callable_evidence! callback))
          [after expression] (if direct? (primitive (source-arguments state args false) (first native) (second native) args)
                               (helper state home (erlang/atom_to_binary (second native) :utf8) args))
          saved (get (:definitions after) [home (erlang/atom_to_binary (second native) :utf8)])]
     (when-not (and (or direct? (= (tuple :ok callback) (BeamLisp.Env/fetch_exact home (erlang/atom_to_binary (second native) :utf8))))
                    (= epoch (BeamLisp.Env/publication_epoch)) (or direct? saved))
      (refuse :unstable-message-callback))
     {:status :proved :expression expression :definitions (:definitions after) :modules (:modules after)
      :bindings (:bindings after) :obligations (:obligations after) :source-guards (:source-guards after [])
      :reads (:reads after []) :root native :arity (nth native 2)}))
   (catch error
    (if-let [reason (:reason (ex-data error))]
     {:status :unknown :reason reason} (throw error)))))

(defn capture-current!
 "Fixed native inspection entry. Read only the actual admitted callback's
  published code; never invoke it or select a supplied context."
 [callback]
 (let [result (decision! #(capture-current-once callback))]
  (if (= :unstable-message-callback (:reason result))
   (decision! #(capture-current-once callback)) result)))

(defn- capture-once [callback environment]
 (with-environment environment
  #(assoc (decision! (fn [] (capture-current-once callback))) :environment environment)))

(defn capture-registration!
 "Capture actual retained callback metadata, including after fresh graph
  admission closes. Carries no executable context or callback to the caller."
 [registration]
 (let [result (BeamLisp.Execution/inspect! registration 'proc.message-domain/capture)]
  (case (:status result)
   :completed (assoc (:value result) :registration registration)
   :cancelled {:status :unknown :reason :closed-message-registration}
   :busy {:status :unknown :reason :message-analysis-capacity})))

(declare capture)
(defn- capture-record [record]
 (if (:registration record) (capture-registration! (:registration record))
  (capture (:function record) (:environment record))))

(defn capture
 "Capture actual published metadata under its native lifetime. A first cold
  dependency admission may change the publication epoch; retry that read once.
  No application callback or factory is evaluated by either attempt."
 [callback environment]
 (let [result (capture-once callback environment)]
  (if (= :unstable-message-callback (:reason result))
   (capture-once callback environment) result)))

(declare substitute prove disprove)
(defn- literal-type [value]
 (cond (erlang/is_integer value) :integer (erlang/is_float value) :float
       (erlang/is_binary value) :binary (erlang/is_atom value) :atom
       (vector? value) :vector (erlang/is_map value) :raw-map
       :else :other))
(defn- literal-has-type? [value required]
 ;; These fixed raw/classification predicates invoke no caller/protocol code.
 ;; In particular raw-map is not an assertion about a Record's lookup methods.
 (case required
  :integer (erlang/is_integer value) :bl-integer (erlang/is_integer value)
  :float (erlang/is_float value) :binary (erlang/is_binary value) :bl-binary (erlang/is_binary value)
  :number (erlang/is_number value) :atom (erlang/is_atom value)
  :raw-map (erlang/is_map value)
  :plain-map (and (erlang/is_map value) (not (maps/is_key :__struct__ value)))
  :maplike (BeamLisp.Ns.Rt/map? value) :vector (BeamLisp.Ns.Rt/vector? value)
  :keyword (BeamLisp.Ns.Rt/keyword? value) :bl-number (BeamLisp.Ns.Rt/number? value)
  false))
(defn- type-covers? [actual required]
 (or (= actual required) (and (contains? #{:number :bl-number} required) (contains? #{:integer :bl-integer :float} actual))
     (and (= required :integer) (= actual :bl-integer))
     (and (= required :binary) (= actual :bl-binary))
     (and (= required :bl-integer) (= actual :integer))
     (and (= required :bl-binary) (= actual :binary))
     (and (= required :atom) (= actual :keyword))
     (and (= required :raw-map) (= actual :maplike))
     (and (contains? #{:maplike :raw-map} required) (= actual :plain-map))))
(declare plain-map-known? first-order-known?)
(defn- type-known? [value required facts]
 (cond
  (literal? value) (literal-has-type? (:value value) required)
  (= :map (:tag value)) (or (= :raw-map required)
                           (and (contains? #{:plain-map :maplike} required)
                                (or (nil? (:base value)) (plain-map-known? (:base value) facts))))
  (= :vector (:tag value)) (= :vector required)
  (= :vector-count (:tag value)) (contains? #{:integer :bl-integer :number :bl-number} required)
  (= :number-op (:tag value))
   (and (contains? #{:integer :bl-integer :number :bl-number} required)
        (every? #(type-known? % (if (contains? #{:integer :bl-integer} required) :integer :number) facts) (:args value)))
  :else (some #(and (= :type (:tag %)) (= value (:value %)) (type-covers? (:type %) required)) facts)))
(defn- same-comparison [a b]
 ;; A BL equality may accept metadata wrappers; strict and numeric/BEAM equality
 ;; must never be folded into that wider relation for symbolic inputs.
 (and (= (:tag a) (:tag b)) (= (:left a) (:left b)) (= (:right a) (:right b))))
(defn- proves-bound? [predicate fact facts]
 (when (and (= :cmp (:tag predicate)) (= :cmp (:tag fact))
            (= (:left predicate) (:left fact)) (literal? (:right predicate)) (literal? (:right fact))
            (erlang/is_number (:value (:right predicate))) (erlang/is_number (:value (:right fact)))
            (or (type-known? (:left predicate) :integer facts) (type-known? (:left predicate) :float facts)))
  (let [wanted (:value (:right predicate)) known (:value (:right fact))
        w (:operator predicate) k (:operator fact)]
   (or
    (and (contains? #{:> :>=} w) (contains? #{:> :>=} k)
         (or (> known wanted) (and (= known wanted) (or (= w :>=) (= k :>)))))
    (and (contains? #{:< :<=} w) (contains? #{:< :<=} k)
         (or (< known wanted) (and (= known wanted) (or (= w :<=) (= k :<)))))))))
(defn- disprove [predicate facts]
 (cond
  (= (lit false) predicate) true
  (= (lit true) predicate) false
  (some #(= {:tag :not :value predicate} %) facts) true
  (= :not (:tag predicate)) (prove (:value predicate) facts)
  (= :and (:tag predicate)) (some #(disprove % facts) (:terms predicate))
  (= :or (:tag predicate)) (every? #(disprove % facts) (:terms predicate))
  (contains? #{:eq :bl-eq :num-eq :strict-eq} (:tag predicate))
   (or
    (and (literal? (:left predicate)) (literal? (:right predicate))
         (scalar? (:value (:left predicate))) (scalar? (:value (:right predicate)))
         (not (scalar-comparison (:tag predicate) (:value (:left predicate)) (:value (:right predicate)))))
    (some (fn [fact]
      (and (= (:tag predicate) (:tag fact)) (= (:left predicate) (:left fact))
           (literal? (:right predicate)) (literal? (:right fact))
           (scalar? (:value (:right predicate))) (scalar? (:value (:right fact)))
           (not (scalar-comparison (:tag predicate) (:value (:right predicate)) (:value (:right fact)))))) facts))
  :else (some #(= {:tag :not :value predicate} %) facts)))
(defn- prove [predicate facts]
 (decision-step!)
 (cond
  (= (lit true) predicate) true
  (= (lit false) predicate) false
  (some #(= predicate %) facts) true
  (= :and (:tag predicate)) (every? #(prove % facts) (:terms predicate))
  (= :or (:tag predicate)) (some #(prove % facts) (:terms predicate))
  (= :not (:tag predicate)) (disprove (:value predicate) facts)
  (= :choose (:tag predicate))
   (cond (prove (:test predicate) facts) (prove (:then predicate) facts)
         (disprove (:test predicate) facts) (prove (:else predicate) facts)
         :else (and (prove (:then predicate) (conj facts (:test predicate)))
                    (prove (:else predicate) (conj facts {:tag :not :value (:test predicate)}))))
  (= :type (:tag predicate)) (boolean (type-known? (:value predicate) (:type predicate) facts))
  (contains? #{:eq :bl-eq :num-eq :strict-eq} (:tag predicate))
   (or (some #(same-comparison predicate %) facts)
       (and (literal? (:left predicate)) (literal? (:right predicate))
            (scalar? (:value (:left predicate))) (scalar? (:value (:right predicate)))
            (scalar-comparison (:tag predicate) (:value (:left predicate)) (:value (:right predicate)))))
  (= :cmp (:tag predicate))
   (or (some #(proves-bound? predicate % facts) facts)
       (and (literal? (:left predicate)) (literal? (:right predicate))
            (scalar? (:value (:left predicate))) (scalar? (:value (:right predicate)))
            (scalar-comparison (:operator predicate) (:value (:left predicate)) (:value (:right predicate)))))
  :else false))
(defn- bounded-cases [cases]
 (when (> (count cases) MAX-BRANCHES) (refuse :message-domain-branch-budget)) cases)
(defn- combine [left right]
 (do (when (> (* (count left) (count right)) MAX-BRANCHES)
       (refuse :message-domain-branch-budget))
     (vec (for [a left b right] (into a b)))))
(defn- true-cases [predicate]
 (decision-step!)
 (cond
  (= (lit true) predicate) [[]]
  (= (lit false) predicate) []
  (= :choose (:tag predicate))
   (bounded-cases (into (combine (true-cases (:test predicate)) (true-cases (:then predicate)))
                        (combine [[{:tag :not :value (:test predicate)}]] (true-cases (:else predicate)))))
  (= :and (:tag predicate)) (reduce (fn [out p] (combine out (true-cases p))) [[]] (:terms predicate))
  (= :or (:tag predicate))
   (reduce (fn [out term]
             (let [more (true-cases term)]
              (when (> (+ (count out) (count more)) MAX-BRANCHES)
               (refuse :message-domain-branch-budget))
              (into out more))) [] (:terms predicate))
  (contains? #{:type :eq :bl-eq :num-eq :strict-eq :cmp :key? :not} (:tag predicate)) [[predicate]]
  :else (refuse :unknown-message-predicate)))
(defn- substitute
 ([term input facts] (substitute term input {:tag :request} facts))
 ([term input request facts]
 (decision-step!)
 (case (:tag term)
  :input input
  :request request
  :literal term
  :eager-read term
  :number-op (assoc term :args (mapv #(substitute % input request facts) (:args term)))
  :vector (assoc term :items (mapv #(substitute % input request facts) (:items term)))
  :vector-count (vector-count (substitute (:target term) input request facts))
  :vector-at (vector-at (substitute (:target term) input request facts) (:index term) (substitute (:default term) input request facts))
  :field (field (substitute (:target term) input request facts) (lit (:key term))
                (substitute (:default term) input request facts) (:lookup term))
  :type (type-term (:type term) (substitute (:value term) input request facts))
  :eq (comparison (:tag term) (substitute (:left term) input request facts) (substitute (:right term) input request facts))
  :bl-eq (comparison (:tag term) (substitute (:left term) input request facts) (substitute (:right term) input request facts))
  :num-eq (comparison (:tag term) (substitute (:left term) input request facts) (substitute (:right term) input request facts))
  :strict-eq (comparison (:tag term) (substitute (:left term) input request facts) (substitute (:right term) input request facts))
  :cmp (comparison (:operator term) (substitute (:left term) input request facts) (substitute (:right term) input request facts))
  :and (assoc term :terms (mapv #(substitute % input request facts) (:terms term)))
  :or (assoc term :terms (mapv #(substitute % input request facts) (:terms term)))
  :not (assoc term :value (substitute (:value term) input request facts))
  :key? (key-term (substitute (:target term) input request facts) (:key term))
  :map (cond-> (assoc term :fields (into {} (mapv (fn [[k v]] [k (substitute v input request facts)]) (:fields term))))
         (:base term) (assoc :base (substitute (:base term) input request facts)))
  :choose (let [test (substitute (:test term) input request facts)]
            (cond
             (prove test facts) (substitute (:then term) input request facts)
             (disprove test facts) (substitute (:else term) input request facts)
             :else (choose test (substitute (:then term) input request (conj facts test))
                                (substitute (:else term) input request (conj facts {:tag :not :value test})))))
  (refuse :unknown-message-expression))))
(defn- domain-facts [value domain]
 (if (= :bounded-first-order domain) [{:tag :type :type :first-order :value value}] []))
(defn- compare-expressions-once
 "Pure closed symbolic decision, not a public migration/adoption grant. Callers
  must acquire expressions from capture and retain their actual native evidence."
 [old-accept upcast candidate-accept domain]
 (try
  (let [cases (true-cases old-accept)]
   ;; A false predicate is not an empty caller-authored witness. Its exact code
   ;; could be proved separately, but it does not enter this supported subset.
   (when (empty? cases) (refuse :empty-old-message-domain))
   (let [proved (every? (fn [facts]
                    (let [facts (into facts (domain-facts {:tag :input} domain))
                          converted (substitute upcast {:tag :input} facts)
                          result (substitute candidate-accept converted facts)]
                     (prove result facts))) cases)]
    (if proved {:status :proved :scope :message-predicate-preservation :cases (count cases)}
     {:status :unknown :scope :message-predicate-preservation :reason :message-domain-not-preserved})))
  (catch error {:status :unknown :scope :message-predicate-preservation
                :reason (or (:reason (ex-data error)) :message-proof-unavailable)})))
(defn compare-expressions
 ([old-accept upcast candidate-accept] (compare-expressions old-accept upcast candidate-accept :unrestricted))
 ([old-accept upcast candidate-accept domain]
  (decision! #(compare-expressions-once old-accept upcast candidate-accept domain))))
(defn valid? [proof]
 "Point-in-time native/definition/binding check. Does not compile or execute a
  callback. Physical graph/SDK leases remain independently mandatory."
 (try
  (if-let [registration (:registration proof)]
   (let [current (capture-registration! registration)]
    (and (= :proved (:status current)) (= proof current)))
   (with-environment (:environment proof)
  (fn []
   (and (= :proved (:status proof))
        (every? publication/valid? (vals (:definitions proof)))
        (every? (fn [read]
                  (let [target (:target read)]
                   (and (= target (readonly-target (:module target) (:name target) (:arity target)))
                        (= (select-keys read [:query :attributes])
                           (erlang/apply (BeamLisp.Env/sdk_callable! "datom.query.read-only" "plan!" 1) (list (:query read)))))))
                (:reads proof []))
        (every? (fn [[module identity]]
                  (= identity (if (= module :erlang)
                               [:otp (erlang/system_info :otp_release) (erlang/system_info :version)]
                               [:beam (erlang/apply module :module_info (list :md5))]))) (:modules proof))
        (every? (fn [[[ns name lookup] expected]]
                  (let [found (if (= lookup :exact) (BeamLisp.Env/fetch_exact ns name) (BeamLisp.Env/fetch ns name))]
                   (and (tuple? found) (= :ok (elem found 0)) (= expected (native-function (callable-arm (elem found 1) (nth expected 2)))))))
                (:bindings proof))))))
   (catch _ false)))
(defn- plain-map-known? [value facts]
 (or (and (= :map (:tag value)) (or (nil? (:base value)) (plain-map-known? (:base value) facts)))
     (and (literal? value) (erlang/is_map (:value value)) (not (maps/is_key :__struct__ (:value value))))
     (and (type-known? value :raw-map facts)
          (disprove {:tag :key? :target value :key :__struct__} facts))
     (and (type-known? value :maplike facts) (first-order-known? value facts))))
(defn- first-order-known? [value facts]
 (decision-step!)
 (or (some #(= {:tag :type :type :first-order :value value} %) facts)
     (some #(type-known? value % facts) [:integer :float :binary :atom])
     (case (:tag value)
      :literal (try (data/check! (:value value)) true (catch _ false))
      :map (and (or (nil? (:base value))
                     (and (plain-map-known? (:base value) facts) (first-order-known? (:base value) facts)))
                (every? #(first-order-known? % facts) (vals (:fields value))))
      :vector (every? #(first-order-known? % facts) (:items value))
      :field (and (plain-map-known? (:target value) facts)
                  (first-order-known? (:target value) facts) (first-order-known? (:default value) facts))
      :vector-count (first-order-known? (:target value) facts)
      :vector-at (and (first-order-known? (:target value) facts) (first-order-known? (:default value) facts))
      :choose (and (first-order-known? (:then value) (conj facts (:test value)))
                   (first-order-known? (:else value) (conj facts {:tag :not :value (:test value)})))
      false)))
(defn- total-under?
 ([proof input facts] (total-under? proof input {:tag :request} facts))
 ([proof input request facts]
 (every? (fn [obligation]
           (let [conditions (mapv #(substitute % input request facts) (:when obligation []))
                 value (substitute (:value obligation) input request facts)
                 facts (into facts conditions)]
            (or (some #(disprove % facts) conditions)
            (case (:domain obligation)
             :raw-number (or (type-known? value :integer facts) (type-known? value :float facts))
             :raw-integer (type-known? value :integer facts)
             :raw-scalar (first-order-known? value facts)
             :raw-map (type-known? value :raw-map facts)
             :plain-map (plain-map-known? value facts)
             :vector (and (type-known? value :vector facts) (first-order-known? value facts))
             false)))) (:obligations proof))))

(defn- source-raw-cost [value]
 ;; Exact native traversal cost for already validated literal data. The
 ;; Source walker counts a proper list once, not once per cons cell, and
 ;; traverses every raw field of collection representations.
 (decision-step!)
 (let [children (cond (erlang/is_tuple value) (erlang/tuple_to_list value)
                      (erlang/is_list value) value
                      (erlang/is_map value) (mapcat (fn [pair] [(elem pair 0) (elem pair 1)]) (maps/to_list value))
                      :else [])
       costs (mapv source-raw-cost children)]
  {:nodes (inc (reduce + 0 (map :nodes costs)))
   :depth (if (seq costs) (inc (reduce max 0 (map :depth costs))) 0)}))
(declare source-shape)
(defn- source-shape [value facts]
 (decision-step!)
 (cond
  (or (boolean-term? value)
      (some #(type-known? value % facts) [:integer :float :binary :atom])) [:closed 1 0]
  (literal? value) (let [cost (source-raw-cost (:value value))] [:closed (:nodes cost) (:depth cost)])
  (and (= :map (:tag value)) (nil? (:base value)))
   [:map (into {} (map (fn [[key item]] [key (source-shape item facts)]) (:fields value)))]
  (= :vector (:tag value)) [:vector (mapv #(source-shape % facts) (:items value))]
  (= :vector-count (:tag value)) [:closed 1 0]
  (= :choose (:tag value))
   [:choose (:test value)
    (source-shape (:then value) (conj facts (:test value)))
    (source-shape (:else value) (conj facts {:tag :not :value (:test value)}))]
  ;; No assumed size for an aggregate merely because it is first-order or
  ;; has one typed field. Preserve its full symbolic identity and occurrence.
  :else [:borrow value]))
(defn- source-shape-cost [shape]
 (decision-step!)
 (case (first shape)
  :closed {:nodes (second shape) :depth (nth shape 2)}
  :map (let [costs (mapv source-shape-cost (vals (second shape)))]
         (when (every? some? costs)
          {:nodes (+ 1 (count costs) (reduce + 0 (map :nodes costs)))
           :depth (if (seq costs) (inc (reduce max 0 (map :depth costs))) 0)}))
  ;; The canonical eager constructor has at most the three raw map fields,
  ;; class tag, nil metadata and dense tuple storage. This is an upper bound,
  ;; never the smaller first-order logical cost of the elements alone.
  :vector (let [costs (mapv source-shape-cost (second shape))]
            (when (every? some? costs)
             {:nodes (+ 7 (reduce + 0 (map :nodes costs)))
              :depth (+ 2 (reduce max 0 (map :depth costs)))}))
  :choose (let [a (source-shape-cost (nth shape 2)) b (source-shape-cost (nth shape 3))]
            (when (and a b) {:nodes (max (:nodes a) (:nodes b)) :depth (max (:depth a) (:depth b))}))
  nil))
(defn- source-argv-bounded? [shape]
 (let [costs (mapv source-shape-cost shape)]
  (and (every? some? costs)
       (<= (inc (reduce + 0 (map :nodes costs))) 16384)
       (<= (if (seq costs) (inc (reduce max 0 (map :depth costs))) 0) 64))))
(defn- source-guard-conditions [guard input request facts]
 (mapv #(substitute % input request facts) (:when guard [])))
(defn- source-guard-shape [guard input request facts]
 (mapv #(source-shape (substitute % input request facts) facts) (:arguments guard)))
(defn- source-guards-under? [proof input request facts assumptions]
 (and (contains? proof :source-guards)
  (every? (fn [guard]
   (let [conditions (source-guard-conditions guard input request facts)
         conditional-facts (into facts conditions)]
    (or (some #(disprove % conditional-facts) conditions)
        (let [shape (source-guard-shape guard input request conditional-facts)]
         (or (source-argv-bounded? shape)
             ;; Equal footprint does not preserve callable custody across
             ;; different Source graphs. Borrowed-size dominance is only for
             ;; arguments proved passive; unrestricted capability values keep
             ;; their runtime contract, but receive no invented upgrade proof.
             (and (every? #(first-order-known? (substitute % input request conditional-facts) conditional-facts)
                           (:arguments guard))
              (some (fn [[old old-input old-request]]
               (some (fn [previous]
                 ;; An old predicate's successful true path implies only
                 ;; guards actually reached on that same path.
                 (and (= true (:assumption? previous))
                      (every? #(prove % conditional-facts)
                        (source-guard-conditions previous old-input old-request conditional-facts))
                      (= shape (source-guard-shape previous old-input old-request conditional-facts))))
                (:source-guards old []))) assumptions))))))) (:source-guards proof))))
(defn- total-migration? [old upcast candidate domain]
 (every? (fn [facts]
           (let [input {:tag :input} facts (into facts (domain-facts input domain))
                 converted (substitute (:expression upcast) input facts)]
            (and (or (not= :bounded-first-order domain) (first-order-known? converted facts))
                 (total-under? old input facts) (total-under? upcast input facts)
                 (total-under? candidate converted facts)
                 (contains? old :source-guards)
                 (source-guards-under? upcast input {:tag :request} facts [[old input {:tag :request}]])
                 (source-guards-under? candidate converted {:tag :request} facts [[old input {:tag :request}]]))))
         (true-cases (:expression old))))
(defn- compare-captured-callbacks [a b c domain]
 (if-not (every? #(and (= :proved (:status %)) (= 1 (:arity %)) (empty? (:reads %))) [a b c])
  {:status :unknown :scope :message-predicate-preservation
   :reason (or (:reason (first (filter #(not= :proved (:status %)) [a b c]))) :message-proof-unavailable)}
  (try
   (let [decision (compare-expressions (:expression a) (:expression b) (:expression c) domain)]
    (if (and (= :proved (:status decision)) (total-migration? a b c domain))
     (assoc decision :evidence [a b c])
     (assoc decision :status :unknown :reason (:reason decision :unproved-message-totality-or-identity))))
   (catch error {:status :unknown :scope :message-predicate-preservation
                 :reason (or (:reason (ex-data error)) :message-proof-unavailable)}))))
(defn- stale-relation [decision]
 (if (= :proved (:status decision))
  (dissoc (assoc decision :status :unknown :reason :stale-callback-evidence) :evidence)
  decision))
(defn- fresh-relation [decision evidence]
 (if (and (= :proved (:status decision)) (not (every? valid? (distinct evidence))))
  (stale-relation decision) decision))
(defn- compare-callbacks-once
 "Actual privately retained callback records only. Public comparisons capture
  and freshly validate each proof; no supplied captured evidence is accepted."
 [old upcast candidate domain]
 (let [a (capture-record old) b (capture-record upcast) c (capture-record candidate)]
  (fresh-relation (compare-captured-callbacks a b c domain) [a b c])))
(defn compare-callbacks
 ([old upcast candidate] (compare-callbacks old upcast candidate :unrestricted))
 ([old upcast candidate domain] (decision! #(compare-callbacks-once old upcast candidate domain))))

(defn- compare-captured-replies
 "Exact relational future-input proof. For every old accepted request and
  every reply satisfying the candidate contract at its upcast request, prove
  that downcast(reply, ORIGINAL request) satisfies the old reply contract.
  Handler effects/results are independent runtime obligations. No callback is
  invoked here, and all non-absent inputs use actual retained registrations.
  Shared argument budgets include both reply and original request; only guards
  reached by successful predicates can supply Source budget assumptions."
 [a b c d e domain]
 (let [evidence (vec (filter some? [a b c d e]))]
  (if-not (and a b (every? #(and (= :proved (:status %)) (empty? (:reads %))) evidence)
               (= 1 (:arity a)) (= 1 (:arity b))
               (every? #(contains? #{1 2} (:arity %)) (filter some? [c d e])))
   {:status :unknown :scope :reply-predicate-preservation :reason :unpublished-reply-callback}
   (try
    (let [request {:tag :request} reply {:tag :input}
          old-domain (substitute (:expression a) request request [])
          cases (true-cases old-domain)
          _ (when (empty? cases) (refuse :empty-old-message-domain))
          decisions
          (mapv (fn [request-facts]
                    (let [request-facts (into request-facts (domain-facts request domain))
                          converted (substitute (:expression b) request request request-facts)
                          reply-domain (if c (substitute (:expression c) reply converted request-facts) (lit true))
                          reply-cases (true-cases reply-domain)]
                     (if-not (seq reply-cases) [{:predicate false :totality false}]
                      (mapv (fn [reply-facts]
                                (let [facts (into (into request-facts reply-facts) (domain-facts reply domain))
                                      result (if d (substitute (:expression d) reply request facts) reply)
                                      wanted (if e (substitute (:expression e) result request facts) (lit true))]
                                 {:predicate (boolean (prove wanted facts))
                                  :totality (boolean (and (or (not= :bounded-first-order domain) (first-order-known? result facts))
                                      (total-under? a request request facts)
                                      (total-under? b request request facts)
                                      (or (nil? c) (total-under? c reply converted facts))
                                      (or (nil? d) (total-under? d reply request facts))
                                      (or (nil? e) (total-under? e result request facts))
                                      (contains? a :source-guards)
                                      (or (nil? c) (contains? c :source-guards))
                                      (source-guards-under? b request request facts [[a request request]])
                                      (or (nil? d) (source-guards-under? d reply request facts
                                                     (cond-> [[a request request]] c (conj [c reply converted]))))
                                      (or (nil? e) (source-guards-under? e result request facts
                                                     (cond-> [[a request request]] c (conj [c reply converted]))))))})) reply-cases)))) cases)
          proved (every? #(and (:predicate %) (:totality %)) (mapcat identity decisions))]
     (if proved
      {:status :proved :scope :reply-predicate-preservation :cases (count cases) :evidence evidence}
      {:status :unknown :scope :reply-predicate-preservation :reason :reply-domain-not-preserved
       :decisions decisions}))
    (catch error {:status :unknown :scope :reply-predicate-preservation
                  :reason (or (:reason (ex-data error)) :reply-proof-unavailable)})))))
(defn- compare-replies-once [old-accept upcast candidate-reply downcast old-reply domain]
 (let [[a b c d e] (mapv #(when % (capture-record %)) [old-accept upcast candidate-reply downcast old-reply])]
  (fresh-relation (compare-captured-replies a b c d e domain) (filter some? [a b c d e]))))
(defn compare-replies
 ([old-accept upcast candidate-reply downcast old-reply]
  (compare-replies old-accept upcast candidate-reply downcast old-reply :unrestricted))
 ([old-accept upcast candidate-reply downcast old-reply domain]
  (decision! #(compare-replies-once old-accept upcast candidate-reply downcast old-reply domain))))

(defn- eager-read-value? [value]
 (case (:tag value)
  :eager-read true
  :field (eager-read-value? (:target value))
  :number-op (every? #(or (and (literal? %) (scalar? (:value %))) (eager-read-value? %)) (:args value))
  :choose (every? #(or (eager-read-value? %) (first-order-known? % [])) [(:then value) (:else value)])
  false))
(defn- current-state-operations? [proof input]
 (every? (fn [obligation]
           (let [conditions (mapv #(substitute % input []) (:when obligation []))
                 target (substitute (:value obligation) input [])
                 facts conditions]
            (or (some #(disprove % facts) conditions)
                ;; An eager closed query result contains no foreign protocol,
                ;; callback, lazy continuation or user-selected constructor.
                ;; Fixed scalar/collection operations may still refuse/raise;
                ;; that is a prepublication current-state failure, not totality.
                (eager-read-value? target)
                (total-under? (assoc proof :obligations [obligation]) input facts))))
         (:obligations proof)))
(defn- compare-captured-state [a b value]
 (try
  (if (and (every? #(and (= :proved (:status %)) (= 1 (:arity %))) [a b])
           (current-state-operations? a (lit value))
           ;; Current-state operations can still refuse in bounded rehearsal;
           ;; they cannot execute unknown code or a computed query provider.
           (empty? (:reads b))
           (current-state-operations? b (substitute (:expression a) (lit value) [])))
   {:status :proved :scope :read-only-current-state :evidence [a b]}
   {:status :unknown :scope :read-only-current-state :reason :unproved-current-state-operations})
  (catch error {:status :unknown :scope :read-only-current-state
                :reason (or (:reason (ex-data error)) :state-proof-unavailable)})))
(defn compare-current-state
 "Read-only CURRENT-state evidence with fresh capture/identity validation.
  Conversion and invariant still run once under observing plus deadline;
  runtime value validation and owner revision CAS remain mandatory."
 [migration check value]
 (decision! (fn []
  (let [a (capture-record migration) b (capture-record check)]
   (fresh-relation (compare-captured-state a b value) [a b])))))

(defn- value-path [term]
 (case (:tag term)
  :input [[:input]]
  :request [[:request]]
  :field (when-let [path (value-path (:target term))] (conj path [:key (:key term)]))
  :vector-at (when-let [path (value-path (:target term))] (conj path [:index (:index term)]))
  nil))
(defn- merge-cost [a b]
 {:paths (into (:paths a) (:paths b)) :nodes (+ (:nodes a) (:nodes b))
  :bytes (+ (:bytes a) (:bytes b)) :depth (max (:depth a) (:depth b))})
(defn- cost-product [left right]
 (when (> (* (count left) (count right)) MAX-BRANCHES) (refuse :message-domain-branch-budget))
 (vec (for [a left b right] (merge-cost a b))))
(declare output-costs)
(defn- constructor-costs [values overhead]
 (mapv #(update % :depth + (:height overhead 1))
       (reduce (fn [out value] (cost-product out (output-costs value))) [overhead] values)))
(defn- output-costs [term]
 (decision-step!)
 (let [zero {:paths [] :nodes 0 :bytes 0 :depth 0}]
  (case (:tag term)
   :literal (let [cost (BeamLisp.CompilerData/first_order_cost! (:value term))]
              [(merge-cost zero (assoc cost :paths [] :depth (if (scalar? (:value term)) 0 64)))])
   :choose (bounded-cases (into (output-costs (:then term)) (output-costs (:else term))))
   :map (constructor-costs (concat (when (:base term) [(:base term)]) (vals (:fields term)))
                           (assoc zero :nodes (+ 8 (* 2 (count (:fields term))))
                                       :bytes (+ 64 (reduce + 0 (map #(erlang/byte_size (str %)) (keys (:fields term)))))))
   :vector (constructor-costs (:items term) (assoc zero :nodes 8 :bytes 64 :height 2))
   :number-op (refuse :unbounded-arithmetic-output-size)
   :vector-count [(assoc zero :nodes 1 :bytes 64)]
   (if-let [path (value-path term)]
    ;; A projection returns an existing subtree. Defaults are charged as well,
    ;; so missing-key branches cannot hide a large constant allocation.
    (mapv #(update % :paths conj path) (if (:default term) (output-costs (:default term)) [zero]))
    (refuse :unbounded-message-output-shape)))))
(defn- path-prefix? [left right]
 (and (<= (count left) (count right)) (= left (vec (take (count left) right)))))
(defn conversion-bounds
 "Conservative affine output bound over actual captured code. Each output
  subtree may borrow one disjoint part of its input; duplication/overlap and
  embedding original requests into reply data decline. Tests/sample sizes are
  not evidence. Additive constructor cost is composed across retained edges."
 [proof reply?]
 (decision!
  (fn []
   (try
    (when-not (= :proved (:status proof)) (refuse :unpublished-message-callback))
    (let [costs (output-costs (:expression proof))]
     (doseq [cost costs]
      (let [paths (:paths cost)]
       (when (or (and reply? (some #(= [:request] (first %)) paths))
                 (some true? (for [a (range (count paths)) b (range (inc a) (count paths))]
                               (or (path-prefix? (nth paths a) (nth paths b))
                                   (path-prefix? (nth paths b) (nth paths a))))))
        (refuse :duplicated-or-foreign-message-input))))
     {:status :proved :scope :affine-first-order-output
      :nodes (reduce max 0 (map :nodes costs)) :bytes (reduce max 0 (map :bytes costs))
      :depth (reduce max 0 (map :depth costs))})
    (catch error {:status :unknown :scope :affine-first-order-output
                  :reason (or (:reason (ex-data error)) :message-output-bound-unavailable)})))))


(defn- callback-record-key [record]
 ;; Opaque registrations identify actual native retention, not just an MFA or
 ;; an environment-shaped value. Unregistered comparisons retain exact record
 ;; identity and the existing authentic capture path.
 (if (:registration record) (tuple :registration (:registration record)) (tuple :record record)))
(defn compare-transition
 "Inspect one owner's actual callback records once, evaluate the three closed
  relations privately, and freshly validate every unique proved capture once.
  Inputs are actual callback records, never supplied proofs or a cache flag.
  Commit independently repeats fresh validation of the returned identities."
 [old-accept upcast candidate-accept candidate-reply downcast old-reply migration check value domain]
 (let [records [old-accept upcast candidate-accept candidate-reply downcast old-reply migration check]
       captures (reduce (fn [out record]
                   (if-not record out
                    (let [key (callback-record-key record)]
                     (if (maps/is_key key out) out (maps/put key (capture-record record) out))))) (maps/new) records)
       [a b c r d e m k] (mapv #(when % (maps/get (callback-record-key %) captures nil)) records)
       message (decision! #(compare-captured-callbacks a b c domain))
       reply (decision! #(compare-captured-replies a b r d e domain))
       state (decision! #(compare-captured-state m k value))
       bounds (when (= :bounded-first-order domain)
                {:message-output-bound (conversion-bounds b false)
                 :reply-output-bound (if d (conversion-bounds d true)
                                      {:status :proved :nodes 0 :bytes 0 :depth 0})})
       evidence (vec (distinct (filter #(= :proved (:status %)) (maps/values captures))))
       fresh? (or (not-any? #(= :proved (:status %)) [message reply state])
                  (every? valid? evidence))]
  (if fresh?
   {:message message :reply reply :state state :bounds bounds :downcast-proof d}
   {:message (stale-relation message) :reply (stale-relation reply) :state (stale-relation state)
    :bounds nil :downcast-proof nil})))
