;; Fixed SDK adapters over the one native registration/acceptance protocol.
;; No executable, context, module list or authority token crosses in this handle.
(ns proc.callback)

(defn register!
 "Retain the callback in its actual native context before publication. Extra
  dependencies must be an eager list/vector; unmanaged captured values are not
  traced. Close explicitly or prepare a handoff to its lifetime owner."
 ([f] (BeamLisp.Execution/register! f))
 ([f modules] (BeamLisp.Execution/register! f modules)))

(defn prepare-transfer!
 "Allocate an inactive native target. Index :accepted in the receiver's
  lifetime slot BEFORE commit-transfer!. Preparation grants no invocation."
 [registration owner]
 (BeamLisp.Execution/prepare-handoff! registration owner))

(defn commit-transfer!
 "Accept the exact native offer, returning its registration or cancelled.
  Repeating a successful acceptance returns the same registration. Busy throws
  before transfer; callback execution is never part of this command."
 ([prepared] (commit-transfer! prepared nil))
 ([prepared request]
  (if (= :cancelled prepared) :cancelled
   (let [result (BeamLisp.Execution/accept-handoff! prepared request)]
    (case (:status result)
     :accepted (:registration result)
     :cancelled :cancelled
     :busy (erlang/error :code_lease_capacity))))))

(defn transfer!
 "Compatibility one-step handoff. The native target remains owner-indexed,
  but this cannot establish an application lifetime slot before acceptance.
  Publication protocols must use prepare-transfer! and commit-transfer!."
 [registration owner]
 (if (= :cancelled (:status (BeamLisp.Execution/observe registration))) :cancelled
 (let [prepared (prepare-transfer! registration owner)]
  (try (commit-transfer! prepared)
   (catch error
    (when-not (= :cancelled prepared) (BeamLisp.Execution/close! (:accepted prepared)))
    (throw error))))))

(defn active? [registration]
 (and (not= :cancelled registration)
      (= :active (:status (BeamLisp.Execution/observe registration)))))

(defn unregister! [registration]
 (BeamLisp.Execution/close! registration))

(defn invoke!
 "Accept a callback invocation or return cancelled. Accepted effects drain
  independently of registration close. Arguments must be an eager list/vector."
 [registration args]
 (let [result (BeamLisp.Execution/invoke! registration args)]
  (case (:status result)
   :completed (:value result)
   :cancelled :cancelled
   :busy (erlang/error :code_lease_capacity))))

(defn try-invoke!
 "The native envelope distinguishes pre-entry busy/cancelled from a callback's
  own return or exception. Never replay accepted effects on that exception."
 [registration args]
 (BeamLisp.Execution/invoke! registration args))
