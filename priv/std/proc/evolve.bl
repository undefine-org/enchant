; Stable process identity, versioned messages and atomic handler/state evolution.
; Upgrade callbacks are pure and short. External effects belong to durable jobs.
(ns proc.evolve
 (:require [proc.server :as ps] [proc.callback :as cb] [proc.fence :as fence] [proc.queue :as queue] [proc.owner-registry :as owners] [proc.framework :as framework] [proc.task :as task] [reload.execution :as execution] [data.first-order :as first-order] [datom.conn :as dc] [core]))

(defn- valid-version? [v] (and (erlang/is_integer v) (> v 0)))
(defn- validate! [spec]
 (when-not (and (valid-version? (:version spec)) (string? (:digest spec))
                (not (empty? (:digest spec))) (:handler spec) (:check-state spec) (:accept? spec))
  (throw (ex-info "Evolution requires version, digest, handler and state/message predicates" {:kind :invalid-evolution})))
 (doseq [k [:check-reply :downcast]]
  (when (and (some? (get spec k)) (not (or (erlang/is_function (get spec k) 1) (erlang/is_function (get spec k) 2))))
   (throw (ex-info "Reply contracts and migrations take reply, optionally original request" {:kind :invalid-evolution :callback k})))))

(defn- validate-migrations! [current spec]
 (validate! spec)
 (when-not (and (erlang/is_function (:upcast spec) 1) (erlang/is_function (:migrate-state spec) 1))
  (throw (ex-info "Upgrade requires state and message migrations of arity one" {:kind :missing-migration})))
 (when (and (:check-reply current) (nil? (:downcast spec)))
  (throw (ex-info "Checked old clients require an explicit reply migration" {:kind :missing-reply-migration}))))

(defn prepare-spec
 "Pin callback execution context before crossing into an older owner. Prepared
  specs can be replayed outside the candidate context without alias resolution."
 [spec]
 (if (:environment spec) spec
  ;; The native registration pins the actual frozen graph. This field carries
  ;; only explicit outside dependencies, never a copied generation inventory.
  (assoc spec :environment (BeamLisp.Env/capture_native_context!))))

(defn- registration-meta [registration]
 (when registration
  (BeamLisp.Execution/metadata! registration)))
(defn- proof-record [held key]
 (when-let [registration (get held key)]
  (let [record (get (:callbacks (registration-meta (:handler held))) key)]
   (when-not (and record (erlang/is_function (:function record)))
    (throw (ex-info "Retained evolution callback has no function" {:kind :invalid-evolution :callback key})))
   (assoc record :registration registration))))
(defn- put-registration-meta! [registration value]
 (BeamLisp.Execution/put-metadata! registration value))

(defn- control-spec [grant spec]
 (BeamLisp.Execution/register-bundle! grant 'proc.evolve/spec
   (select-keys spec [:version :digest :handler :accept? :check-state :migrate-state
                     :upcast :downcast :check-reply :environment :modules :message-proof])))

(defn- retain-selected! [spec]
 (let [held (atom [])]
  (try
   (let [registrations
         (reduce (fn [m k]
                   (if-let [f (get spec k)]
                    (let [r (cb/register! f (:modules spec []))]
                     (swap! held conj r)
                     (BeamLisp.Execution/restrict! r)
                     (assoc m k r)) m))
                 (assoc (select-keys spec [:version :digest])
                        :identity-modules (:modules spec [])
                        :reply-arity (if (erlang/is_function (:check-reply spec) 2) 2 1)
                        :downcast-arity (if (erlang/is_function (:downcast spec) 2) 2 1))
                 [:handler :check-state :accept? :migrate-state :upcast :check-reply :downcast])]
    (put-registration-meta! (:handler registrations)
     {:callbacks (into {} (map (fn [key]
                    [key {:function (get spec key) :environment (:environment spec)}])
                    [:handler :check-state :accept? :migrate-state :upcast :check-reply :downcast]))})
    (when (:message-proof spec)
     (put-registration-meta! (:upcast registrations) {:message-proof (:message-proof spec)}))
    registrations)
   (catch e (doseq [r @held] (cb/unregister! r)) (throw e)))))

(defn- spec-environment [spec]
 ;; Metadata has one scope-owned representation. A public map is neither an
 ;; alternate context codec nor execution authority.
 (BeamLisp.Env/resolve_native_context! (:environment spec)))

(defn- retain! [spec]
 (let [environment (spec-environment spec) graph (maps/get :generation environment nil)
       previous (BeamLisp.Env/capture)
       enter (fn []
               (try (BeamLisp.Env/bind environment) (retain-selected! spec)
                    (finally (BeamLisp.Env/bind previous))))]
  ;; Context data is not custody. Native owners borrow the candidate graph
  ;; before registering its callbacks. Existing Source may only reuse its own
  ;; admitted graph; a prepared spec never widens a Source caller's authority.
  (when (and (BeamLisp.Env/source_data_decode_required?)
             (not= (maps/get :env environment nil) (BeamLisp.Env/env_id)))
   (throw (ex-info "Evolution context is outside the current Source graph"
                   {:kind :owner-transition-authority-required})))
  (if (and graph (not (BeamLisp.Env/executing_generation? graph)))
   (erlang/apply (BeamLisp.Env/sdk_callable! "reload.execution" "with!" 2)
                 (list graph enter))
   (erlang/apply enter (list)))))

(defn- release! [held]
 (doseq [k [:handler :check-state :accept? :migrate-state :upcast :check-reply :downcast]]
  (when-let [r (get held k)] (cb/unregister! r))))

(defn- invoke [held k args] (cb/invoke! (get held k) args))
(defn- valid-state! [held state]
 (when-not (= true (dc/observing #(invoke held :check-state [state])))
  (throw (ex-info "Evolution state invariant refused" {:kind :invalid-state})))
 state)
(defn- initial-message-domain [st]
 (let [domain (:message-domain st :unrestricted)]
  (when (= :bounded-first-order domain)
   ;; A composed application's visible slice can be edited by its containing
   ;; Source. Only this fixed SDK actor owns a private immutable initial data
   ;; contract. Declaration spelling alone is never native custody evidence.
   (let [native (BeamLisp.Env/framework_owner_evidence (erlang/self))]
    (when-not (and native (= (tuple "proc.evolve" "owner") (:declaration native)))
     (throw (ex-info "Bounded data evolution requires the fixed standalone SDK owner"
                     {:kind :unsupported-message-domain-owner})))))
  domain))
(defn- external-message-data! [st message]
 (when (= :bounded-first-order (initial-message-domain st))
  (try (first-order/check! message {:max-nodes 16384 :max-bytes 65536 :max-depth 64})
   (catch _ (throw (ex-info "Request is outside the owner's initial data domain" {:kind :message-domain-refused})))))
 message)
(defn- message-data-in-domain! [domain message]
 (when (= :bounded-first-order domain)
  (try (first-order/check! message {:max-nodes 32768 :max-bytes 1048576 :max-depth 128})
   (catch _ (throw (ex-info "Converted request is outside the retained data bound" {:kind :message-domain-refused})))))
 message)
(defn- external-reply-data! [st value]
 (when (= :bounded-first-order (initial-message-domain st))
  (try (first-order/check! value {:max-nodes 16384 :max-bytes 65536 :max-depth 64})
   (catch _ (throw (ex-info "Reply is outside the owner's initial data domain" {:kind :reply-domain-refused})))))
 value)
(defn- reply-data! [value]
 (try (first-order/check! value {:max-nodes 32768 :max-bytes 1048576 :max-depth 128})
  (catch _ (throw (ex-info "Converted reply is outside the retained data bound" {:kind :reply-domain-refused}))))
 value)

(defn- adapt-in-domain [domain st version message]
 (loop [v version msg message replies (list)]
  (message-data-in-domain! domain msg)
  (cond
   (= v (get-in st [:current :version])) {:message msg :replies replies}
   (not (valid-version? v)) (throw (ex-info "Invalid message version" {:kind :unsupported-version}))
   :else (if-let [edge (get (:adapters st) v)]
           (do
            (when-not (= true (dc/observing #(cb/invoke! (:request-check edge) [msg])))
             (throw (ex-info "Message outside its original protocol contract" {:kind :invalid-message})))
            (recur (:to edge) (dc/observing #(cb/invoke! (:callback edge) [msg]))
                   (if (or (:downcast edge) (:reply-check edge)) (cons (assoc edge :request msg) replies) replies)))
           (throw (ex-info "No message upgrade path" {:kind :unsupported-version}))))))

(defn- adapt [st version message]
 (adapt-in-domain (initial-message-domain st) st version message))

(defn- checked-reply [registration arity request value]
 (when (and registration (not= true (try (dc/observing #(cb/invoke! registration (if (= arity 2) [value request] [value]))) (catch _ false))))
  (throw (ex-info "Reply outside client contract" {:kind :invalid-reply})))
 value)

(defn- adapt-reply
 ([edges reply] (adapt-reply edges reply false))
 ([edges reply bounded?]
 (reduce (fn [value edge]
           (let [converted (if-let [f (:downcast edge)]
             (try (dc/observing #(cb/invoke! f (if (= 2 (:downcast-arity edge)) [value (:request edge)] [value])))
              (catch _ (throw (ex-info "Reply migration failed" {:kind :reply-migration-failed})))) value)]
            (checked-reply (:reply-check edge) (:reply-arity edge) (:request edge)
                           (if bounded? (reply-data! converted) converted)))) reply edges)))

(defn- release-edge! [edge]
 (doseq [k [:callback :downcast :reply-check :request-check]]
  (when-let [r (get edge k)] (cb/unregister! r))))

(defn- dispatch-in-context [st version message]
 (try
  (let [_ (external-message-data! st message) held (:current st) adapted (adapt st version message) msg (:message adapted)]
   (when-not (= true (dc/observing #(invoke held :accept? [msg])))
    (throw (ex-info "Message outside current contract" {:kind :invalid-message})))
   (let [result (invoke held :handler [msg (:value st)])]
    (when-not (and (map? result) (contains? result :reply) (contains? result :state))
     (throw (ex-info "Handler must return reply and state" {:kind :invalid-result})))
    (valid-state! held (:state result))
    [(adapt-reply (:replies adapted)
       (checked-reply (:check-reply held) (:reply-arity held) msg
                      (external-reply-data! st (:reply result)))
       (= :bounded-first-order (initial-message-domain st)))
     (assoc st :value (:state result) :revision (inc (:revision st 0)))]))
  (catch e [{:status :refused :kind (or (:kind (ex-data e)) :handler-failed)} st])))

(defn- dispatch [st version message]
 ;; A composed actor still executes its containing graph. After an automatic
 ;; transition, only its exact completed native receipt opens this fixed SDK
 ;; dispatch turn. Each callback then enters its own retained Source context.
 (if-let [grant (get-in st [:publication :automatic-grant])]
  (BeamLisp.Env/with_owner_transition_observation! grant
   (fn [] (dispatch-in-context st version message)))
  (dispatch-in-context st version message)))

(defn- forget-preparation [st]
 (when-let [p (:preparation st)] (release! (:held p)))
 (dissoc st :preparation))

(defn- install-prepared [st held value]
 (let [current (:current st)
       edge {:to (:version held) :callback (:upcast held) :message-proof (when (:message-proof (registration-meta (:upcast held))) (:upcast held))
             :request-check (:accept? current)
             :downcast (:downcast held) :downcast-arity (:downcast-arity held)
             :reply-check (:check-reply current) :reply-arity (:reply-arity current)}
       installed (dissoc held :migrate-state :upcast :downcast :downcast-arity :message-proof)
       after (assoc st :current installed :value value :revision (inc (:revision st 0))
                      :adapters (assoc (:adapters st) (:version current) edge))]
  ;; Transfer registrations only after all fallible validation has finished.
  (cb/unregister! (:migrate-state held))
  (release! (dissoc current :check-reply :accept?))
  after))

(defn- message-proof-api [operation args]
 ;; Ordinary SDK actors do not statically import analysis/prover dependencies.
 (BeamLisp.Loader/ensure_loaded "proc.message-domain")
 (erlang/apply (BeamLisp.Emit/module_for "proc.message-domain") operation (to-list args)))
(defn- automatic-proof! [st spec held]
 (let [environment (spec-environment spec) graph (Process/get :bl_generation)]
  (when-not (and graph (BeamLisp.Env/executing_generation? graph)
                 (= (:digest graph) (:digest spec)) (= graph (:generation environment))
                 (= (:scope graph) (:env environment)))
   (throw (ex-info "Owner candidate has no native execution" {:kind :owner-transition-authority-required})))
  (let [edges (vals (:adapters st))]
   (when-not (and (every? :message-proof edges)
                  (message-proof-api :valid-all?
                    [(distinct (mapcat #(:evidence (:message-proof (registration-meta (:message-proof %)))) edges))]))
    (throw (ex-info "Prior adapters have no exact pure migration proof"
                   {:kind :unproved-prior-message-migration :scope :retained-old-owner}))))
  (doseq [key [:handler :accept? :upcast :migrate-state :check-state :downcast :check-reply]]
   (when-let [function (get spec key)] (BeamLisp.Env/assert_managed_callback! graph function)))
  (let [record (fn [key] (proof-record held key)) domain (initial-message-domain st)
        ;; The reader captures each actual registration once, evaluates all
        ;; relations over those exact identities, then freshly validates each
        ;; unique capture before returning any proved decision for rehearsal.
        transition (message-proof-api :compare-transition
                     [(proof-record (:current st) :accept?) (record :upcast) (record :accept?)
                      (record :check-reply) (record :downcast) (proof-record (:current st) :check-reply)
                      (record :migrate-state) (record :check-state) (:value st) domain])
        proof (:message transition) reply-proof (:reply transition) state-proof (:state transition)]
   (when-not (= :proved (:status proof))
    (throw (ex-info "Future owner inputs have no exact predicate/totality proof"
                   {:kind :unproved-message-migration :scope :retained-old-owner})))
   (when-not (= :proved (:status reply-proof))
    (throw (ex-info "Future replies have no exact original-request conversion proof"
                   {:kind :unproved-reply-migration :scope :retained-old-owner})))
   (when-not (= :proved (:status state-proof))
    (throw (ex-info "Current state conversion is outside the closed read-only fragment"
                   {:kind :unproved-message-migration :scope :retained-old-owner})))
   (let [bounds (when (= :bounded-first-order domain)
                  ;; Bounds come from the same captured upcast/downcast. Keep
                  ;; both keys mandatory below, including on a malformed read.
                  (select-keys (:bounds transition) [:message-output-bound :reply-output-bound]))]
    (when bounds
     (doseq [key [:message-output-bound :reply-output-bound]]
      (let [all (cons (get bounds key)
                     (map #(get (:message-proof (registration-meta (:message-proof %))) key)
                          (vals (:adapters st))))]
       (when-not (and (every? #(= :proved (:status %)) all)
                      (<= (reduce + 0 (map :nodes all)) 16384)
                      (<= (reduce + 0 (map :bytes all)) 983040)
                      (<= (reduce + 0 (map :depth all)) 64))
        (throw (ex-info "Retained adapters cannot preserve the initial bounded data domain"
                        {:kind :unproved-message-migration :scope :message-output-bounds}))))))
    ;; Both relations inspect the same accept/upcast registrations. Keep each
    ;; exact proof once; commit still freshly validates every unique identity.
    {:domain (merge proof bounds {:evidence (vec (distinct (concat (:evidence proof) (:evidence reply-proof))))})
     :state (first (:evidence state-proof)) :check (second (:evidence state-proof))}))))
(defn- queued-samples! [st]
 (let [size (elem (Process/info (erlang/self) :message_queue_len) 1)]
  (when (> size 256) (throw (ex-info "Owner queue exceeds proof budget" {:kind :message-inventory-budget})))
  (let [messages (elem (Process/info (erlang/self) :messages) 1)]
   (when (> (count messages) 256) (throw (ex-info "Owner queue changed beyond budget" {:kind :message-inventory-budget})))
   (vec (keep (fn [envelope]
    (when-not (and (tuple? envelope) (= 3 (erlang/tuple_size envelope)) (= :"$gen_call" (elem envelope 0)))
     (throw (ex-info "Unknown mailbox work must drain" {:kind :unsupported-owner-mailbox})))
    (let [message (elem envelope 2)]
     (first-order/check! message {:max-nodes 16384 :max-bytes 65536 :max-depth 64})
     (when-not (or (erlang/is_list message) (vector? message))
      (throw (ex-info "Mailbox request is not an eager SDK message" {:kind :unsupported-owner-mailbox})))
     (case [(first message) (count message)]
      [:proc.evolve/status 1] nil
      [:proc.evolve/request 3] {:version (nth message 1) :message (nth message 2)}
      [:proc.evolve/call 3] {:version (nth message 1) :message (nth message 2)}
      ;; Private-reference client requests cannot pass first-order admission;
      ;; explicit client work remains retained/drain instead of being skipped.
      (throw (ex-info "Mailbox control requires retained execution" {:kind :unsupported-owner-mailbox}))))) messages)))))

(defn- stage-selected-upgrade [st expected spec samples selected]
 (cond
  (not= expected (get-in st [:current :version])) [{:status :refused :kind :stale-version} st]
  (not (and (valid-version? (:version spec)) (> (:version spec) expected)))
   [{:status :refused :kind :identity-conflict} st]
  (>= (count (:adapters st)) (:history-limit st)) [{:status :refused :kind :history-full} st]
  (not (and (vector? samples) (<= (count samples) 256)
             (every? #(and (map? %) (valid-version? (:version %)) (contains? % :message)) samples)))
   [{:status :refused :kind :invalid-message-samples} st]
  :else
   (let [held (atom selected)]
    (try
     (validate-migrations! (:current st) spec)
     (when-not @held (reset! held (retain! spec)))
     ;; Prove the same registrations that conversion and future adapters own.
     ;; No temporary proof registration or new fresh-graph admission is needed.
     (when (:automatic spec)
      (let [proof (automatic-proof! st spec @held) handler (:handler @held)]
       (put-registration-meta! handler (assoc (registration-meta handler) :preparation-proof proof))
       (put-registration-meta! (:upcast @held) {:message-proof (:domain proof)})))
     (let [;; Authenticate the immutable contract on the actual owner. The
           ;; isolated SDK rehearsal child is not another owner; it receives
           ;; only this private data-validation choice, never owner custody.
           domain (initial-message-domain st)
           result (fence/fence-fn (:upgrade-ms st)
                    #(dc/observing
                      (fn []
                       (doseq [sample samples]
                        (let [message (:message (adapt-in-domain domain st (:version sample) (:message sample)))]
                         (when-not (and (= true (invoke (:current st) :accept? [message]))
                                         (= true (invoke @held :accept? [(invoke @held :upcast [message])])))
                          (throw (ex-info "Observed message migration refused" {:kind :invalid-message})))))
                       (valid-state! @held (invoke @held :migrate-state [(:value st)])))))]
      (if-not (contains? result :ok)
       (do (when-not selected (release! @held))
           [{:status :refused :kind (if (:timeout result) :rehearsal-deadline :candidate-refused)} st])
       (let [ticket (erlang/make_ref)
             _ (when (:automatic spec)
                 (let [observed (execution/runtime-inspection (Process/get :bl_generation) (:ok result))]
                  (when-not (= :valid (:status observed))
                   (throw (ex-info "Owner state belongs to another generation" {:kind (:kind observed :invalid-state)})))))
             preparation {:ticket ticket :held @held :value (:ok result)
                          :expected expected :revision (:revision st 0)}]
        [{:status :prepared :ticket ticket :version (:version spec) :digest (:digest spec)
          :revision (:revision st 0) :messages (count samples) :scope :sampled-owner-state}
         (assoc (forget-preparation st) :preparation preparation)])))
     (catch e
      (when (and @held (nil? selected)) (release! @held))
      [{:status :refused :kind (or (:kind (ex-data e)) :candidate-refused)} st])))))
(defn- stage-upgrade [st expected spec samples]
 (stage-selected-upgrade st expected spec samples nil))

(defn- commit-upgrade [st ticket]
 (let [p (:preparation st) prior (:publication st)]
  (cond
   (and (= ticket (:ticket prior)) (= (:version prior) (get-in st [:current :version])))
    [{:status :already-applied :version (:version prior) :revision (:revision prior)} st]
   (or (nil? p) (not= ticket (:ticket p))) [{:status :refused :kind :unknown-preparation} st]
   (or (not= (:expected p) (get-in st [:current :version])) (not= (:revision p) (:revision st 0)))
    [{:status :refused :kind :stale-preparation} (forget-preparation st)]
   :else
    (let [after (install-prepared (dissoc st :preparation) (:held p) (:value p))
          receipt {:ticket ticket :version (get-in after [:current :version]) :revision (:revision after)}]
     [(assoc (dissoc receipt :ticket) :status :applied) (assoc after :publication receipt)]))))

(defn- complete-automatic-prepare [st grant expected spec samples selected]
 (try
  (BeamLisp.Env/with_owner_transition! grant :prepare
   (fn []
    (let [conversion-entered (atom false)]
     (try
      (when (:preparation st)
       (throw (ex-info "Owner already has accepted preparation" {:kind :owner-preparation-pending})))
      (first-order/check! samples {:max-nodes 32768 :max-bytes 1048576 :max-depth 64})
      (when-not (and (vector? samples) (<= (count samples) 256))
       (throw (ex-info "Invalid explicit owner message samples" {:kind :invalid-message-samples})))
      (let [samples (into samples (queued-samples! st))
            _ (when (> (count samples) 256)
                (throw (ex-info "Combined owner sample inventory exceeds budget" {:kind :message-inventory-budget})))
            _ (reset! conversion-entered true)
            [reply after] (stage-selected-upgrade st expected (assoc spec :automatic true) samples selected)]
       (if (= :prepared (:status reply))
        (do
         (BeamLisp.Env/owner_transition_prepared! grant (:ticket reply))
         [(assoc (dissoc reply :ticket) :scope :proved-future-owner-inputs)
          (update after :preparation #(assoc % :automatic-grant grant))])
        (do
         (when-not (= :rehearsal-deadline (:kind reply))
          (BeamLisp.Env/finish_owner_transition! grant nil :refused))
         [reply after])))
      (catch error
       (if @conversion-entered (throw error)
        (do (BeamLisp.Env/finish_owner_transition! grant nil :refused)
            [{:status :refused :kind (or (:kind (ex-data error)) :unproved-message-migration)} st])))))))
  (catch error [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st])))

(defn- standalone-analysis-owner? []
 ;; A containing application's visible state is not private SDK custody. Nor
 ;; may a Source callback running inside the SDK actor request this private job.
 (and (not (BeamLisp.Env/source_data_decode_required?))
      (= (tuple "proc.evolve" "owner")
         (:declaration (BeamLisp.Env/framework_owner_evidence (erlang/self))))))
(defn- analysis-registrations [st held]
 (vec (distinct
  (remove nil?
   (concat [(get-in st [:current :accept?]) (get-in st [:current :check-reply])]
           (map #(get held %) [:upcast :accept? :check-reply :downcast :migrate-state :check-state])
           (map :registration
            (mapcat (fn [edge]
                      (:evidence (:message-proof (registration-meta (:message-proof edge)))))
                    (vals (:adapters st)))))))))
(defn- warm-analysis! [registrations cell]
 ;; The native owned Task captures only opaque registrations and this private
 ;; GC-owned cell. It never receives a candidate Fn, environment or owner value.
 (try
  (let [unproved (reduce (fn [out registration]
                          (let [captured (message-proof-api :capture-registration! [registration])]
                           (if (= :proved (:status captured)) out (conj out registration))))
                        [] registrations)]
   (reset! cell {:status :ready :unproved unproved}))
  (catch error
   (reset! cell {:status :refused :kind (or (:kind (ex-data error)) :owner-analysis-failed)})))
 :proc.evolve/analyzed)
(defn- guard-analysis! [registrations cell owner]
 ;; The guardian is detached from the owner, but installs its owner monitor
 ;; BEFORE creating the linked metadata child. Child failure is contained here;
 ;; killing this guardian during owner cleanup also kills its linked child.
 (Process/flag :trap_exit true)
 (let [owner-ref (Process/monitor owner)
       child (task/async (fn [] (warm-analysis! registrations cell)))
       child-pid (task/pid child) child-ref (erlang/map_get :ref child)]
  (try
   (loop []
    (receive
     [:DOWN ref :process pid _]
      (cond
       (and (= ref owner-ref) (= pid owner) (not (Process/alive? owner)))
        (do (when (Process/alive? child-pid) (task/shutdown child :brutal_kill)) :proc.evolve/analyzed)
       (and (= ref child-ref) (= pid child-pid) (not (Process/alive? child-pid)))
        (do (when (nil? @cell) (reset! cell {:status :refused :kind :owner-analysis-failed}))
            :proc.evolve/analyzed)
       :else (recur))
     [ref :proc.evolve/analyzed]
      (if (and (= ref child-ref) (some? @cell)) :proc.evolve/analyzed (recur))
     [:EXIT pid _]
      (if (and (= pid child-pid) (not (Process/alive? child-pid)))
       (do (when (nil? @cell) (reset! cell {:status :refused :kind :owner-analysis-failed}))
           :proc.evolve/analyzed)
       (recur))
     _ (recur)))
   (finally
    (Process/demonitor owner-ref (list :flush))
    (when (Process/alive? child-pid) (task/shutdown child :brutal_kill))
    (Process/demonitor child-ref (list :flush))))))
(defn- begin-automatic-analysis [st grant expected spec samples]
 (let [held (atom nil)]
  (try
   (BeamLisp.Env/with_owner_transition! grant :analysis
    (fn []
     (when (or (:preparation st) (:analysis st))
      (throw (ex-info "Owner already has accepted preparation" {:kind :owner-preparation-pending})))
     (when-not (= expected (get-in st [:current :version]))
      (throw (ex-info "Owner version changed" {:kind :stale-version})))
     (validate-migrations! (:current st) spec)
     (when-not (> (:version spec) expected)
      (throw (ex-info "Owner candidate is not a new version" {:kind :identity-conflict})))
     (when (>= (count (:adapters st)) (:history-limit st))
      (throw (ex-info "Owner history is full" {:kind :history-full})))
     (first-order/check! samples {:max-nodes 32768 :max-bytes 1048576 :max-depth 64})
     (when-not (and (vector? samples) (<= (count samples) 256)
                    (every? #(and (map? %) (valid-version? (:version %)) (contains? % :message)) samples))
      (throw (ex-info "Invalid explicit owner message samples" {:kind :invalid-message-samples})))
     ;; This pending-only native entry owns the actual candidate context even
     ;; if fresh admission has closed. It supplies no completion capability.
     (reset! held (retain! spec))
     (let [cell (atom nil) registrations (analysis-registrations st @held) owner (erlang/self)
           worker (task/async-nolink (fn [] (guard-analysis! registrations cell owner)))]
      [{:status :analyzing}
       (assoc st :analysis {:grant grant :expected expected :spec spec :samples samples
                            :held @held :cell cell :task worker})])))
   (catch error
    (when @held (release! @held))
    ;; Refusal is completed only through the existing authentic claim. An
    ;; expired pending grant remains expired; metadata never manufactures one.
    (try
     (BeamLisp.Env/with_owner_transition! grant :prepare
      (fn [] (BeamLisp.Env/finish_owner_transition! grant nil :refused)))
     (catch _ nil))
    [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st]))))
(defn- automatic-prepare-spec [st grant expected spec samples]
 (cond
  (= grant (get-in st [:analysis :grant]))
   [{:status :refused :kind :owner-preparation-pending} st]
  (standalone-analysis-owner?)
  (begin-automatic-analysis st grant expected spec samples)
  :else (complete-automatic-prepare st grant expected spec samples nil)))
(defn- detach-analysis-monitors! [job]
 (when-let [child (:task job)] (Process/demonitor (erlang/map_get :ref child) (list :flush)))
 (when-let [ref (:caller-monitor job)] (Process/demonitor ref (list :flush)))
 :ok)
(defn- discard-analysis! [job]
 (when job
  (try
   (when (Process/alive? (task/pid (:task job)))
    ;; Only fixed, read-only metadata is stopped; no application callback runs
    ;; in this Task and cancellation conveys no effect replay permission.
    (task/shutdown (:task job) :brutal_kill))
   (catch _ nil)
   (finally
    (detach-analysis-monitors! job)
    (release! (:held job)))))
 :ok)
(defn- refuse-analysis [st job kind]
 (discard-analysis! job)
 (try
  (BeamLisp.Env/with_owner_transition! (:grant job) :prepare
   (fn [] (BeamLisp.Env/finish_owner_transition! (:grant job) nil :refused)))
  (catch _ nil))
 (when (:from job) (GenServer/reply (:from job) {:status :refused :kind kind}))
 (dissoc st :analysis))
(defn- unproved-analysis-kind [st job unproved]
 (let [failed (set unproved) held (:held job)
       failed? (fn [registrations] (some #(and % (contains? failed %)) registrations))
       prior (map :registration (mapcat (fn [edge]
                (:evidence (:message-proof (registration-meta (:message-proof edge))))) (vals (:adapters st))))]
  ;; Only an actual SDK worker can write this cell. These observations can
  ;; refuse a role, never prove one or supply a preparation proof to the owner.
  (cond
   (failed? prior) :unproved-prior-message-migration
   (failed? [(get-in st [:current :accept?]) (:upcast held) (:accept? held)]) :unproved-message-migration
   (failed? [(:check-reply held) (:downcast held) (get-in st [:current :check-reply])]) :unproved-reply-migration
   (failed? [(:migrate-state held) (:check-state held)]) :unproved-message-migration
   :else nil)))
(defn- analysis-ready [st ref]
 (let [job (:analysis st)]
  (if-not (and job (= ref (erlang/map_get :ref (:task job)))) st
   (if-let [result @(:cell job)]
    (if-let [refusal (if (= :ready (:status result))
                       (unproved-analysis-kind st job (:unproved result []))
                       (:kind result :owner-analysis-failed))]
     (refuse-analysis st job refusal)
     (do
      ;; Flush Task DOWN/caller observations before the unchanged mailbox
      ;; inventory gate. The Task's result is only a wakeup, never proof data.
      (detach-analysis-monitors! job)
      (let [selected (:held job)
            [reply after] (complete-automatic-prepare (dissoc st :analysis)
                           (:grant job) (:expected job) (:spec job) (:samples job) selected)]
       ;; This slot alone owns selected until the actual prepared state takes
       ;; it. Early refusal, expired grant and rehearsal failure release once.
       (when-not (= (:handler selected) (get-in after [:preparation :held :handler]))
        (release! selected))
       (GenServer/reply (:from job) reply)
       after)))
    ;; Forged/early completion cannot observe or publish a nil private cell.
    st))))
(defn- analysis-down [st ref pid]
 (let [job (:analysis st)]
  (if (and job (not (Process/alive? pid))
           (or (and (= ref (erlang/map_get :ref (:task job))) (= pid (task/pid (:task job))))
               (and (= ref (:caller-monitor job)) (= pid (:caller job)))))
   (refuse-analysis st job :owner-analysis-cancelled) st)))
(defn- automatic-prepare [st grant expected payload samples]
 (try (BeamLisp.Execution/invoke-bundle! payload grant 'proc.evolve/prepare [st expected samples])
  (catch error [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st])))
(defn- automatic-observation [st grant]
 (cond
  (= grant (get-in st [:analysis :grant]))
   {:status :pending :scope :owner-analysis :version (get-in st [:current :version])}
  (= grant (get-in st [:publication :automatic-grant]))
   {:status :applied :version (get-in st [:publication :version]) :revision (get-in st [:publication :revision])}
  (and (= grant (get-in st [:preparation :automatic-grant]))
       (= :prepared (BeamLisp.Env/owner_transition_status grant)))
   {:status (if (= (:revision st 0) (get-in st [:preparation :revision])) :prepared :stale)
    :version (get-in st [:preparation :held :version]) :revision (:revision st 0)}
  :else {:status :refused :kind :unknown-preparation}))
(defn- current-rehearsal [st grant spec]
 ;; This is a receiver-only observation of the exact installed specification.
 ;; A completed native grant authenticates the target/candidate, not any new
 ;; callback set. Never bind the supplied environment or invoke its functions.
 (try
  (when-not (and (erlang/=:= grant (get-in st [:publication :automatic-grant]))
                (= :completed (BeamLisp.Env/owner_transition_status grant)))
   (throw (ex-info "Unknown completed owner preparation" {:kind :unknown-preparation})))
  (let [current (:current st)]
   (when-not
    (and (erlang/is_map spec) (not (maps/is_key :__struct__ spec))
         (erlang/=:= (maps/get :version spec nil) (:version current))
         (erlang/=:= (maps/get :digest spec nil) (:digest current))
         (erlang/=:= (maps/get :modules spec []) (:identity-modules current))
         (every? (fn [key]
                   ;; The full saved spec also contains migrations whose
                   ;; registrations transferred out of the installed head.
                   ;; Compare their saved identities without claiming a live
                   ;; proof registration for an absent optional callback.
                   (let [saved (get (:callbacks (registration-meta (:handler current))) key)]
                    (and saved
                         (erlang/=:= (maps/get key spec nil) (:function saved))
                         (erlang/=:= (maps/get :environment spec nil) (:environment saved)))))
                 [:handler :check-state :accept? :migrate-state :upcast :check-reply :downcast])
         ;; Only callbacks still installed in the current head are invoked by
         ;; requests. Migration/upcast/downcast identities remain in the exact
         ;; saved spec, even after their registration transfers or retirement.
         (every? (fn [key]
                   (if-let [registration (get current key)] (cb/active? registration)
                    (nil? (:function (proof-record current key)))))
                 [:handler :check-state :accept? :check-reply]))
    (throw (ex-info "Current rehearsal specification differs from installed code" {:kind :identity-conflict})))
   [{:status :valid :scope :already-current :version (:version current)
     :revision (:revision st 0)} st])
  (catch error [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st])))

(defn- automatic-current-rehearsal-spec [st grant spec]
 (BeamLisp.Env/with_owner_transition_observation! grant
  (fn [] (current-rehearsal st grant spec))))
(defn- automatic-current-rehearsal [st grant payload]
 (try (BeamLisp.Execution/invoke-bundle! payload grant 'proc.evolve/current-rehearsal [st])
  (catch error [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st])))

(defn- automatic-commit [st grant]
 (if (= grant (get-in st [:publication :automatic-grant]))
  [(assoc (automatic-observation st grant) :status :already-applied) st]
  (let [entered (atom false)]
  (try
   (BeamLisp.Env/with_owner_transition! grant :commit
    (fn []
     (let [p (:preparation st) proof (:preparation-proof (registration-meta (get-in p [:held :handler])))]
      (when-not (= grant (:automatic-grant p))
       (throw (ex-info "Owner preparation is not this native grant" {:kind :unknown-preparation})))
      (when-not (message-proof-api :valid-all?
                   [(distinct (concat (get-in proof [:domain :evidence]) [(:state proof) (:check proof)]))])
       (throw (ex-info "Owner callback identity changed" {:kind :stale-message-proof})))
      (reset! entered true)
      (let [[reply after] (commit-upgrade st (:ticket p))]
       (BeamLisp.Env/finish_owner_transition! grant (:ticket p) (if (= :applied (:status reply)) :applied :refused))
       [reply (if (= :applied (:status reply))
                (assoc-in after [:publication :automatic-grant] grant) after)]))))
   (catch error
    (if @entered (throw error)
     [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st]))))))
(defn- automatic-cancel [st grant]
 (try
  (BeamLisp.Env/with_owner_transition! grant :cancel
   (fn []
    (let [p (:preparation st)]
     (when-not (= grant (:automatic-grant p))
      (throw (ex-info "Owner preparation is not this native grant" {:kind :unknown-preparation})))
     (let [after (forget-preparation st)]
      (BeamLisp.Env/finish_owner_transition! grant (:ticket p) :cancelled)
      [{:status :cancelled} after]))))
  (catch error [{:status :refused :kind (or (:kind (ex-data error)) :owner-transition-authority-required)} st])))

(defn- valid-client-version? [st version]
  (and (valid-version? version)
       (or (= version (get-in st [:current :version])) (contains? (:adapters st) version))))

(defn- acquire [st version]
  (cond
    (not (:managed st)) [{:status :refused :kind :unmanaged-owner} st]
    (not (valid-client-version? st version)) [{:status :refused :kind :unsupported-version} st]
    (or (contains? (:fenced st) version) (<= version (:fenced-through st 0))) [{:status :refused :kind :version-fenced} st]
    :else (let [token (erlang/make_ref)]
            [{:status :acquired :token token :version version}
             (assoc-in st [:clients token] version)])))

(defn- bind-queue [st srv]
  (cond
    (not (:managed st)) [{:status :refused :kind :unmanaged-owner} st]
    (nil? (queue/declaration srv)) [{:status :refused :kind :undeclared-queue} st]
    (contains? (:queues st) srv) [{:status :bound :queue srv} st]
    (> (:retired-through st 0) 0) [{:status :refused :kind :inventory-sealed} st]
    :else [{:status :bound :queue srv} (update st :queues conj srv)]))

(defn- retirement [st expected through]
  (cond
    (not (:managed st)) [{:status :refused :kind :unmanaged-owner} st]
    (not= expected (get-in st [:current :version])) [{:status :stale} st]
    (not (and (valid-version? through) (< through expected)))
      [{:status :refused :kind :invalid-retirement} st]
    :else
      (let [versions (vec (filter (fn [v] (<= v through)) (keys (:adapters st))))
            ;; Close both producer paths BEFORE inspecting dependencies. These
            ;; monotone gates remain closed when retirement waits or crashes.
            after (assoc st :fenced-through (max through (:fenced-through st 0)))
            _ (doseq [srv (:queues st)] (queue/fence-through! srv through))
            live (count (filter (fn [v] (<= v through)) (vals (:clients st))))
            durable (reduce (fn [n srv]
                       (+ n (reduce (fn [sum entry]
                              (if (<= (first entry) through) (+ sum (second entry)) sum))
                            0 (:protocols (queue/protocol-inventory srv))))) 0 (:queues st))]
        (if (or (> live 0) (> durable 0))
          [{:status :waiting :live live :durable durable :through through} after]
          (do
            (doseq [v versions]
              (release-edge! (get (:adapters st) v)))
            [{:status :retired :versions (vec (sort versions)) :through through}
             (assoc after :adapters (apply dissoc (:adapters st) versions)
                          :retired-through (max through (:retired-through st 0)))])))))

(defn owner-evidence
 "Read native versioned-owner registration without sending an unsupported
  message to an arbitrary actor. Dead PID registrations are exact-ticket pruned."
 [pid]
 (let [rows (ets/lookup :beam_lisp_vars (tuple :bl-evolve-owner pid))]
  (when (seq rows)
   (let [row (first rows)]
    (if (Process/alive? pid)
     (let [evidence (elem row 1)]
      (when (or (nil? (:inventory evidence)) (owners/owned-role-live? (:inventory evidence)))
       (dissoc evidence :lease :inventory)))
     (do (ets/delete_object :beam_lisp_vars row) nil))))))
(defn owner? [pid] (some? (owner-evidence pid)))

(defn- initial-state [opts]
  (validate! (:spec opts))
  (when-not (contains? #{nil :unrestricted :bounded-first-order} (:message-domain opts))
   (throw (ex-info "Unknown initial owner message domain" {:kind :invalid-evolution})))
  (let [limit (:history-limit opts 32) budget (:upgrade-ms opts 250)]
   (when-not (and (erlang/is_integer budget) (> budget 0) (<= budget 30000))
    (throw (ex-info "Evolution migration budget must be 1..30000ms" {:kind :invalid-evolution})))
   (when-not (and (erlang/is_integer limit) (> limit 0) (<= limit 1024))
    (throw (ex-info "Evolution history must be bounded" {:kind :invalid-evolution})))
   (let [spec (prepare-spec (:spec opts)) held (retain! spec)
         adopted (atom nil) registered (atom nil)]
    (try
     (valid-state! held (:state opts))
     (when (ets/member :beam_lisp_vars (tuple :bl-evolve-owner (erlang/self)))
      (throw (ex-info "Owner already has an evolution slice" {:kind :duplicate-evolution})))
     ;; Only the standalone SDK engine requests framework adoption. Composed
     ;; app declarations retain their ordinary containing actor's entire graph.
     ;; Without bound initializer resources the safe default remains app-owned.
     (when (and (:standalone-sdk-owner opts) (execution/runtime-owner))
      (reset! adopted (framework/adopt! (execution/runtime-owner))))
     (initial-message-domain {:message-domain (:message-domain opts :unrestricted)})
     (reset! registered (owners/register-owned-role! :evolve {:managed (:managed opts false)}))
     (let [capability (owners/current-owner-capability) inventory @registered
           evidence {:pid (erlang/self) :ticket (or (:proof-id inventory) (erlang/make_ref))
                     :application-id (:application-id inventory) :inventory inventory
                     :lease (:lease capability) :managed (:managed opts false) :kind :proc.evolve}]
      (ets/insert :beam_lisp_vars (tuple (tuple :bl-evolve-owner (erlang/self)) evidence))
      {:current held :value (:state opts) :adapters {} :history-limit limit :upgrade-ms budget
       :owner-evidence evidence :inventory inventory :framework @adopted :revision 0
       :managed (:managed opts false) :message-domain (:message-domain opts :unrestricted)
       :clients {} :queues #{} :fenced #{} :fenced-through 0 :retired-through 0})
     (catch error
      (try (owners/unregister! @registered)
       (finally
        (try (release! held) (finally (framework/close! @adopted)))))
      (throw error))))))

(defn- owner-control-message [value]
 ;; Control arity is at most five. Read canonical small-vector storage directly;
 ;; never dispatch first/count/nth on an unclassified caller-controlled object.
 (cond
  (erlang/is_list value)
   (loop [tail value left 6 out (list)]
    (cond (erlang/== tail (list)) (when (seq out) (erlang/apply :lists :reverse (list out)))
          (zero? left) nil
          :else (recur (erlang/tl tail) (dec left) (cons (erlang/hd tail) out))))
  (and (erlang/is_map value) (= :Elixir.BeamLisp.Vector (maps/get :__struct__ value nil)))
   (let [items (maps/get :items value nil)]
    (when (and (erlang/is_tuple items) (<= 1 (erlang/tuple_size items) 6))
     (erlang/tuple_to_list items)))
  :else nil))
(defn- owner-control-arity? [message]
 (and message
  (= (erlang/length message)
   (case (first message)
    :proc.evolve/status 1
    :proc.evolve/automatic-commit 2
    :proc.evolve/automatic-cancel 2
    :proc.evolve/automatic-status 2
    :proc.evolve/commit 2
    :proc.evolve/cancel 2
    :proc.evolve/acquire 2
    :proc.evolve/release 2
    :proc.evolve/fence 2
    :proc.evolve/bind-queue 2
    :proc.evolve/call 3
    :proc.evolve/upgrade 3
    :proc.evolve/client 3
    :proc.evolve/request 3
    :proc.evolve/retire 3
    :proc.evolve/automatic-current-rehearsal 3
    :proc.evolve/prepare 4
    :proc.evolve/rehearse 4
    :proc.evolve/automatic-prepare 5
    nil))))
(defn message-step
 "Shared versioned-owner engine, used by standalone and composed owners."
 [st message]
 (let [message (owner-control-message message)]
 (if-not (owner-control-arity? message) [{:status :refused :kind :unknown-evolution-message} st]
 (if-not (framework/alive? (:framework st))
  [{:status :refused :kind :framework-initializer-exited} st]
 (case (first message)
  :proc.evolve/call
   (if (:managed st) [{:status :refused :kind :managed-client-required} st]
    (dispatch st (nth message 1) (nth message 2)))
  :proc.evolve/automatic-prepare (automatic-prepare st (nth message 1) (nth message 2) (nth message 3) (nth message 4))
  :proc.evolve/automatic-commit (automatic-commit st (nth message 1))
  :proc.evolve/automatic-cancel (automatic-cancel st (nth message 1))
  :proc.evolve/automatic-status [(automatic-observation st (nth message 1)) st]
  :proc.evolve/automatic-current-rehearsal (automatic-current-rehearsal st (nth message 1) (nth message 2))
  ;; Retired control vocabulary is refusal-only. These tags never select a
  ;; second conversion, context codec or callback-registration protocol.
  :proc.evolve/upgrade [{:status :refused :kind :owner-transition-authority-required} st]
  :proc.evolve/prepare [{:status :refused :kind :owner-transition-authority-required} st]
  :proc.evolve/commit [{:status :refused :kind :owner-transition-authority-required} st]
  :proc.evolve/cancel [{:status :refused :kind :owner-transition-authority-required} st]
  :proc.evolve/rehearse [{:status :refused :kind :owner-transition-authority-required} st]
  :proc.evolve/acquire (acquire st (nth message 1))
  :proc.evolve/client
   (if-let [version (get (:clients st) (nth message 1))]
    (dispatch st version (nth message 2))
    [{:status :refused :kind :unknown-client} st])
  :proc.evolve/request
   (let [version (nth message 1)]
    (cond
     (not (:managed st)) [{:status :refused :kind :unmanaged-owner} st]
     (not (valid-client-version? st version)) [{:status :refused :kind :unsupported-version} st]
     (or (contains? (:fenced st) version) (<= version (:fenced-through st 0)))
      [{:status :refused :kind :version-fenced} st]
     ;; Admission, synchronous domain execution and reply all finish in this
     ;; FIFO turn. Retirement cannot interleave, so no separate client token
     ;; or distributed request mutex is necessary for this lexical lifetime.
     :else (dispatch st version (nth message 2))))
  :proc.evolve/release [{:status :released} (update st :clients dissoc (nth message 1))]
  :proc.evolve/fence
   (let [version (nth message 1)]
    (if (and (:managed st) (valid-version? version))
     [{:status :fenced :version version} (update st :fenced conj version)]
     [{:status :refused :kind :invalid-fence} st]))
  :proc.evolve/bind-queue (bind-queue st (nth message 1))
  :proc.evolve/retire (retirement st (nth message 1) (nth message 2))
  :proc.evolve/status
   [{:version (get-in st [:current :version]) :digest (get-in st [:current :digest])
     :legacy-versions (vec (sort (keys (:adapters st)))) :revision (:revision st 0)
     :reply-contract? (some? (get-in st [:current :check-reply])) :message-domain (:message-domain st :unrestricted)
     :prepared? (some? (:preparation st))
     :managed (:managed st) :clients (count (:clients st))
     :queues (vec (:queues st)) :fenced-versions (vec (sort (:fenced st)))
     :fenced-through (:fenced-through st) :pid (erlang/self)} st]
  [{:status :refused :kind :unknown-evolution-message} st])))))

(defn close-state! [st]
 (try
  (discard-analysis! (:analysis st))
  (forget-preparation st)
  (try (owners/unregister! (:inventory st))
   (finally
    (when (:owner-evidence st)
     (ets/delete_object :beam_lisp_vars
       (tuple (tuple :bl-evolve-owner (get-in st [:owner-evidence :pid])) (:owner-evidence st))))))
  (finally
   (try (release! (:current st))
    (finally
     (try (doseq [edge (vals (:adapters st))] (release-edge! edge))
      (finally (framework/close! (:framework st))))))))
 :ok)
(defn composed-state [opts]
 {:evolve (initial-state opts)})
(defn composed-step [st message]
 (let [[value after] (message-step (:evolve st) message)]
  [value (assoc st :evolve after)]))
(defn composed-close! [_ st] (close-state! (:evolve st)))

(defn evolution-clause
 "Explicit managed domain slice in an existing actor. No PID replacement,
  store ownership inference or interception of arbitrary custom messages."
 [clause _]
 (when-not (= 2 (count clause))
  (throw (ex-info "evolve expects one owner options map" {:kind :invalid-evolution-clause})))
 (let [patterns '[[:proc.evolve/automatic-prepare grant expected spec samples]
                  [:proc.evolve/automatic-commit grant] [:proc.evolve/automatic-cancel grant]
                  [:proc.evolve/automatic-status grant]
                  [:proc.evolve/automatic-current-rehearsal grant spec]
                  [:proc.evolve/call version message] [:proc.evolve/upgrade expected spec]
                  [:proc.evolve/rehearse expected spec budget]
                  [:proc.evolve/prepare expected spec samples]
                  [:proc.evolve/commit ticket] [:proc.evolve/cancel ticket]
                  [:proc.evolve/acquire version] [:proc.evolve/client token message]
                  [:proc.evolve/request version message]
                  [:proc.evolve/release token] [:proc.evolve/fence version]
                  [:proc.evolve/bind-queue srv] [:proc.evolve/retire expected through]
                  [:proc.evolve/status]]]
  {:init (list 'proc.evolve/composed-state (second clause))
   :terminate ['proc.evolve/composed-close!]
   :clauses (mapv (fn [pattern]
                    (list 'handle-call pattern '[_ evolution-state]
                      (list 'let ['[evolution-result evolution-after]
                                   (list 'proc.evolve/composed-step 'evolution-state pattern)]
                        '(reply evolution-result evolution-after)))) patterns)}))
(ps/extend-clause! :evolve evolution-clause)

(ps/defserver owner
 (init [opts] (ok (initial-state (assoc opts :standalone-sdk-owner true))))
 (handle-call message [from st]
  (let [[value after] (message-step st message)]
   (if (and (nil? (:analysis st)) (:analysis after))
    (noreply (update after :analysis #(assoc % :from from :caller (elem from 0)
                                             :caller-monitor (Process/monitor (elem from 0)))))
    (reply value after))))
 (handle-info [ref :proc.evolve/analyzed] [st] (noreply (analysis-ready st ref)))
 (handle-info [:DOWN ref :process pid _] [st]
  (if (framework/initializer-down? (:framework st) ref pid)
   (stop :normal st) (noreply (analysis-down st ref pid))))
 (handle-info _ [st] (noreply st))
 (terminate [_ st] (close-state! st)))

(defn start!
 "Start one stable owner. Spec supplies :version/:digest, :handler (msg,state ->
  {:reply r :state s}), :accept? and :check-state. Optional :check-reply validates
  this version's replies; later upgrades must supply :downcast to checked old
  clients. Both reply callbacks take reply, optionally original request as a
  second argument for request-dependent reply shapes. This runtime defense is
  not a static compatibility proof and cannot
  undo effects already performed by a handler. Native callbacks are retained
  under this owner's lifetime. Declare captured executable dependencies :modules."
 ([spec state] (start! spec state {}))
 ([spec state opts]
  (validate! spec)
  (core/start owner {:spec spec :state state :history-limit (:history-limit opts 32) :upgrade-ms (:upgrade-ms opts 250) :managed (:managed opts false) :message-domain (:message-domain opts :unrestricted)}
                    (dissoc opts :history-limit :upgrade-ms :managed :message-domain))))
(defn call!
 "Version travels with the request, including queued calls from old clients."
 ([pid version message] (call! pid version message 5000))
 ([pid version message timeout] (GenServer/call pid [:proc.evolve/call version message] timeout)))
(defn- assert-candidate! []
 ;; Reject unsupported/unbound callers before even allocating spec metadata.
 ;; Native admission rechecks the same live origin when it issues the grant.
 (when-not (BeamLisp.Env/executing_generation? (Process/get :bl_generation))
  (throw (ex-info "Owner transition requires admitted candidate execution"
                  {:kind :owner-transition-authority-required})))
 :ok)
(defn- public-refusal [error]
 ;; Caller-context/native authority errors never expose a captured graph/token.
 (let [native (:original error)
       role-error? (and (tuple? native) (= 2 (erlang/tuple_size native))
                        (= :invalid_execution_bundle_role (elem native 0)))
       kind (or (:kind (ex-data error))
                (when role-error? :invalid-evolution)
                (when (= :invalid_execution_bundle_dependencies native) :invalid-evolution)
                (when (= :native_context_capacity (:original error)) :owner-context-capacity)
                :owner-transition-authority-required)]
  (cond-> {:status (if (= kind :owner-transition-outcome-unknown) :uncertain :refused)
           :kind kind :scope :retained-old-owner}
   role-error? (assoc :callback (elem native 1)))))
(defn- public-owner-call [pid message timeout]
 (try (GenServer/call pid message timeout)
  (catch _
   ;; This native CAS only succeeds while no receiver has claimed conversion.
   ;; It never cancels accepted/prepared/committing work on a timeout.
   (try (BeamLisp.Env/abandon_owner_transition! (nth message 1)) (catch _ nil))
   ;; A timeout or lost receiver reply cannot establish conversion/commit
   ;; refusal. The native ticket remains the sole reconciliation identity.
   (throw (ex-info "Owner transition outcome is unconfirmed"
                   {:kind :owner-transition-outcome-unknown})))))
(defn- public-spec-call [pid prefix spec suffix timeout]
 (let [grant (nth prefix 1)
       payload (try (control-spec grant spec)
                (catch error
                 ;; A constructor refusal published no carrier. Release only
                 ;; an unclaimed native grant; accepted work remains intact.
                 (try (BeamLisp.Env/abandon_owner_transition! grant) (catch _ nil))
                 (throw error)))]
  (try (public-owner-call pid (into (conj prefix payload) suffix) timeout)
   (finally (BeamLisp.Execution/close! payload)))))
(defn- public-grant! [pid ticket]
 (when-not (erlang/is_reference ticket)
  (throw (ex-info "Unknown owner preparation" {:kind :unknown-preparation})))
 (let [grant (BeamLisp.Env/begin_owner_transition! pid)]
  (when-not (= ticket (elem grant 2))
   (try (BeamLisp.Env/abandon_owner_transition! grant) (catch _ nil))
   (throw (ex-info "Preparation belongs to another exact candidate/owner" {:kind :unknown-preparation})))
  grant))
(defn upgrade!
 "Existing public upgrade API. An application owner automatically uses actual
  candidate execution, native receiver admission and one exact preparation.
  Unsupported future domains/context return a retained-owner typed refusal.
  Every transition uses native candidate admission and an opaque bundle.
  Unbound callers refuse; timeout remains unknown outcome, never safe replay."
 ;; Preparation includes bounded metadata analysis as well as rehearsal. Use
 ;; the same call window as explicit prepare/commit; rehearsal keeps its own
 ;; shorter configured budget and caller-supplied timeouts remain unchanged.
 ([pid expected spec] (upgrade! pid expected spec 31000))
 ([pid expected spec timeout]
  (try
    (assert-candidate!)
    (let [value (prepare-spec spec) grant (BeamLisp.Env/begin_owner_transition! pid)
          status (public-owner-call pid [:proc.evolve/automatic-status grant] timeout)]
     (cond
      (= :applied (:status status))
       (if (and (= (:version status) (:version value))
                (= (:digest value) (:digest (Process/get :bl_generation))))
        (assoc status :status :already-applied)
        {:status :refused :kind :identity-conflict :scope :retained-old-owner})
      (= :prepared (:status status))
       ;; This upgrade call owns no proof that a different earlier prepared
       ;; callback set is its argument. Explicit commit uses its opaque ticket.
       {:status :refused :kind :owner-preparation-pending :scope :retained-old-owner}
      :else
       (let [prepared (public-spec-call pid [:proc.evolve/automatic-prepare grant expected] value [[]] timeout)]
        (if (= :prepared (:status prepared))
         (public-owner-call pid [:proc.evolve/automatic-commit grant] timeout) prepared))))
    (catch error (public-refusal error)))))
(defn rehearse!
 "Existing bounded rehearsal API. Application owners use the same exact native
  preparation/future-domain gate as publication and then cancel that ticket.
  Successful rehearsal runs no business handler and leaves old state installed."
 ;; Metadata preparation has the same finite window as prepare/upgrade. The
 ;; owner's :upgrade-ms still bounds migration, and explicit waits stay exact.
 ([pid expected spec] (rehearse! pid expected spec 30000))
 ([pid expected spec budget]
  (when-not (owner? pid) (throw (ex-info "Owner rehearsal requires native authority" {:kind :owner-transition-authority-required})))
  (try
    (assert-candidate!)
    (let [value (prepare-spec spec) grant (BeamLisp.Env/begin_owner_transition! pid)
          observed (public-owner-call pid [:proc.evolve/automatic-status grant] (+ budget 1000))]
     (if (= :applied (:status observed))
      (public-spec-call pid [:proc.evolve/automatic-current-rehearsal grant] value [] (+ budget 1000))
      (let [prepared (public-spec-call pid [:proc.evolve/automatic-prepare grant expected] value [[]] (+ budget 1000))]
       (if (= :prepared (:status prepared))
        (let [cancelled (public-owner-call pid [:proc.evolve/automatic-cancel grant] (+ budget 1000))]
         (if (= :cancelled (:status cancelled))
          (assoc prepared :status :valid :version expected :candidate-version (:version spec)
                          :candidate-digest (:digest spec)) cancelled)) prepared))))
    (catch error (public-refusal error)))))
(defn status [pid] (GenServer/call pid [:proc.evolve/status]))
(defn prepare-upgrade!
 "Existing public preparation API. Under a managed app's actual candidate
  execution, acquire receiver admission automatically and return an opaque Ref
  ticket for commit/cancel. No application coordinator/annotation is required.
  Explicit samples are checked in addition to queued/future input proof. Native
  grant/owner preparation IDs remain private. Unknown effects are not replayed."
 ([pid expected spec] (prepare-upgrade! pid expected spec []))
 ([pid expected spec samples]
  (when-not (owner? pid) (throw (ex-info "Preparation requires native owner authority" {:kind :owner-transition-authority-required})))
  (try
    (assert-candidate!)
    (let [value (prepare-spec spec) grant (BeamLisp.Env/begin_owner_transition! pid)
          prepared (public-spec-call pid [:proc.evolve/automatic-prepare grant expected] value [samples] 31000)]
     (if (= :prepared (:status prepared)) (assoc prepared :ticket (elem grant 2)) prepared))
    (catch error (public-refusal error)))))
(defn commit-upgrade!
 "Commit the exact opaque preparation Ref. Application callers need actual
  matching candidate execution; possession/copied scope alone is not admission.
  The last completed exact ticket reconciles a lost reply without conversion."
 [pid ticket]
 (try
   (let [grant (public-grant! pid ticket)]
    (public-owner-call pid [:proc.evolve/automatic-commit grant] 31000))
   (catch error (public-refusal error))))
(defn cancel-upgrade! [pid ticket]
 (try
   (let [grant (public-grant! pid ticket)]
    (public-owner-call pid [:proc.evolve/automatic-cancel grant] 5000))
   (catch error (public-refusal error))))

(defn acquire-client!
 "Acquire an old/new protocol dependency from a managed owner. A token stays
  counted until explicitly released; process death does not prove a durable
  sender has stopped. Managed owners refuse raw call! to close bypasses."
 [pid version] (GenServer/call pid [:proc.evolve/acquire version]))
(defn call-client!
 ([pid token message] (call-client! pid token message 5000))
 ([pid token message timeout] (GenServer/call pid [:proc.evolve/client token message] timeout)))
(defn request!
 "Admit and execute one synchronous managed request in a single FIFO turn.
  Enforces version/admission fences before dispatch. Retirement cannot pass an
  executing turn; queued requests after a fence refuse. Async/durable producers
  still require explicit client/queue dependencies. Timeout is outcome unknown."
 ([pid version message] (request! pid version message 5000))
 ([pid version message timeout] (GenServer/call pid [:proc.evolve/request version message] timeout)))
(defn release-client! [pid token] (GenServer/call pid [:proc.evolve/release token]))
(defn with-client!
 "Borrow a managed protocol dependency for one caller action. Admission and
  retirement are serialized by the owner; accepted calls retain their own token
  until finally releases it. No distributed lock surrounds domain execution.
  A refused acquisition returns its refusal without invoking action. This is a
  synchronous lexical lifetime; durable senders must keep explicit tokens."
 [pid version action]
 (let [client (acquire-client! pid version)]
  (if-not (= :acquired (:status client)) client
   (try (action (:token client)) (finally (release-client! pid (:token client)))))))
(defn fence-version!
 "Close new client acquisitions; already accepted clients may drain."
 [pid version] (GenServer/call pid [:proc.evolve/fence version]))
(defn bind-queue!
 "Register a durable protocol dependency before retirement begins. Queue
  protocol numbers must name this owner's message protocol. Registrations are
  monotone, cannot be removed and are sealed after successful retirement. The
  framework must register every managed producer; unmanaged owners cannot
  retire adapters. Queue store must be rebound before its owner starts."
 [pid srv] (GenServer/call pid [:proc.evolve/bind-queue (queue/resolve-server srv)]))
(defn retire!
 "Retire the contiguous legacy prefix through a version only after closing
  admissions and observing zero live client and registered durable dependency.
  This is scoped to this managed owner/inventory, never a whole-program proof.
  Failed and held jobs block retirement. Waiting keeps admissions fenced.
  No caller-supplied boolean or arbitrary callback can authorize collection."
 [pid expected through] (GenServer/call pid [:proc.evolve/retire expected through] 30000))

(defn prepare-transition! [pid grant expected spec]
 (public-spec-call pid [:proc.evolve/automatic-prepare grant expected] spec [[]] 31000))
(defn commit-transition! [pid grant]
 (GenServer/call pid [:proc.evolve/automatic-commit grant] 31000))
(defn cancel-transition! [pid grant]
 (GenServer/call pid [:proc.evolve/automatic-cancel grant] 5000))
(defn transition-status [pid grant]
 (GenServer/call pid [:proc.evolve/automatic-status grant] 5000))
