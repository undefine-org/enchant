;; Per-instance inbox for closed data. General actor calls/callback transfers
;; retain their own execution/custody owners; this API cannot address a PID.
(ns proc.mailbox)

(defn context
 "Return this admitted Source inbox's non-authorizing identity for receive
  guards. It cannot open a context, retain code or name another recipient."
 [] (BeamLisp.Env/source_mailbox_context!))

(defn post-self!
 "Post bounded first-order data to this Source instance. Returns nil. Runtime
  callbacks, references and resources require their managed transfer APIs."
 [value] (BeamLisp.Env/post_source_mailbox_data! value))
