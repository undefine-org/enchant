; One raw-term validator shared with the native compiler kernel. No provider
; initialization is needed to validate compiler data during SDK staging.
(ns data.first-order)

(defn check!
 "Return value unchanged after bounded raw first-order validation. Admit scalar
  data, exact decimals, proper lists/maps, symbols and native vectors/sets
  (including legacy vectors with omitted nil metadata). No lazy
  forcing, Enumerable/protocol dispatch, opaque callbacks or ambient var reads.
  Options: :max-nodes (16384), :max-bytes (1048576), :max-depth (64)."
 ([value] (BeamLisp.CompilerData/check_first_order! value))
 ([value options] (BeamLisp.CompilerData/check_first_order! value options)))
