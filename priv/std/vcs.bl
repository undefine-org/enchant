; vcs.bl — a tree remembers what was done to it, and why.
;
; ── The division of labour ───────────────────────────────────────────────────
;
; jj is the change engine: it snapshots a working copy, gives every change a
; stable id, records every command as an operation, and can put the whole tree
; back to any operation. That is years of work we do not do again.
;
; datom is the fact layer: the operations and commits arrive as facts, joined
; with the one thing jj cannot know — the REQUEST behind them (`:req/by`,
; `:req/why`, `:req/ms`). So "what changed, who asked, why, and how do I take it
; back" is one Datalog program instead of a conversation.
;
; Two invariants keep the pair honest:
;
;   THE MIRROR IS DERIVED.  Every fact is keyed by an id jj already minted
;   (operation id, commit id, change id), so re-ingesting is a no-op and a
;   rebuild yields the same facts. A watermark (`:meta/op-head`) makes the
;   common case — nothing happened since the last look — one `jj op log -n 1`.
;
;   THE MIRROR IS NOT PART OF THE TREE IT MIRRORS.  It lives at
;   `<tree>/.autovcs/`, and the tree must ignore it, or every checkpoint tracks
;   the journal that describes the checkpoint. `vcs/init!` writes that line;
;   `vcs/status` reports whether it is there.
;
; ── One gate, three callers ──────────────────────────────────────────────────
;
; `vcs/gate!` runs the project's own gate (default `bl check --changed`) against
; a checkpoint's paths. The daemon calls `vcs/checkpoint+gated!` after a command;
; `bl vcs checkpoint` calls the same; CI calls `bl vcs gate`. There is one
; definition of "a checkpoint that is allowed", not three.
;
; jj ships as a pinned prebuilt binary (VCS_JJ env, then `priv/jj/<os>-<arch>/jj`,
; then PATH) — see docs/jj-in-front-datom-in-the-back.md for why not a crate.

(ns vcs
  (:require [datom] [datom.conn] [datom.store] [datom.store-fjall]
            [vcs.jj :as jj] [interop :as j] [bl.util :as u] [clojure.string :as cs]))

; The jj boundary lives in `vcs.jj`: where the binary is, how to run it, what a
; change and an operation look like, and the working-copy questions. This file is
; the fact layer on top — the mirror, the queue, the gate, and the questions only
; a join can answer.
;
; `MIRROR` is re-exported because it is this layer's directory too: the queue and
; the store live inside it.


(def MIRROR jj/MIRROR)
(def STORE "mirror.fjall")

; The jj layer's public surface, re-exported. A caller asks `vcs` where jj is and
; what it can do — the split into two files is an implementation choice, not a
; thing every caller has to know.
(def bin jj/bin)
(defn version [] (jj/version))
(defn available? [] (jj/available?))
(defn repo? [dir] (jj/repo? dir))
(defn init! [dir] (jj/init! dir))
(defn run-jj [dir argv] (jj/run-jj dir argv))

; What the mirror holds. Every attribute is jj's own word for the thing, or the
; request's — nothing renamed for our convenience, so a fact and a `jj` field
; can be read side by side.
(def SCHEMA
  [{:db/ident :op/id        :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :op/parent    :db/valueType :db.type/string :db/cardinality :db.cardinality/many}
   {:db/ident :op/desc      :db/valueType :db.type/string}
   {:db/ident :op/args      :db/valueType :db.type/string}
   {:db/ident :op/user      :db/valueType :db.type/string}
   {:db/ident :op/host      :db/valueType :db.type/string}
   {:db/ident :op/start     :db/valueType :db.type/string}
   {:db/ident :op/snapshot  :db/valueType :db.type/boolean}
   {:db/ident :op/workspace :db/valueType :db.type/string}
   {:db/ident :cm/id        :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :cm/change    :db/valueType :db.type/string :db/index true}
   {:db/ident :cm/parent    :db/valueType :db.type/string :db/cardinality :db.cardinality/many}
   {:db/ident :cm/desc      :db/valueType :db.type/string}
   {:db/ident :cm/author    :db/valueType :db.type/string}
   {:db/ident :cm/time      :db/valueType :db.type/string}
   {:db/ident :cm/path      :db/valueType :db.type/string :db/index true :db/cardinality :db.cardinality/many}
   {:db/ident :req/id       :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :req/by       :db/valueType :db.type/string}
   {:db/ident :req/why      :db/valueType :db.type/string}
   {:db/ident :req/path     :db/valueType :db.type/string :db/cardinality :db.cardinality/many}
   {:db/ident :req/op       :db/valueType :db.type/string :db/index true}
   {:db/ident :req/commit   :db/valueType :db.type/string}
   {:db/ident :req/at       :db/valueType :db.type/instant}
   {:db/ident :req/ms       :db/valueType :db.type/long}
   {:db/ident :meta/key     :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :meta/value   :db/valueType :db.type/string}])


; jj is the only writer; these are the calls this namespace makes.
(def REGISTRY (atom {}))

(defn- open-mirror [dir]
  (let [path (str dir "/" MIRROR "/" STORE)]
    (File/mkdir_p! (str dir "/" MIRROR))
    (if (datom.store-fjall/available?)
      (let [store (datom.store-fjall/open path)
            conn (datom.conn/connect-with store SCHEMA)]
        {:conn conn :store store :durable true})
      (let [conn (datom/connect SCHEMA)]
        {:conn conn :store nil :durable false}))))

(defn- mirror-state
  "The open mirror for `dir`, opened once per process."
  [dir]
  (if-let [m (get (deref REGISTRY) dir)]
    m
    (let [m (open-mirror dir)]
      (swap! REGISTRY assoc dir m)
      m)))

(defn close!
  "Release the mirror for `dir` (the daemon calls this when a tree is released)."
  [dir]
  (if-let [m (get (deref REGISTRY) dir)]
    (do (swap! REGISTRY dissoc dir)
        (datom/close! (:conn m))
        (if (:store m) (datom.store/close (:store m)))))
  {:ok true})

(defn- known-set [db query] (into #{} (map first (datom/q query db))))

(defn- watermark
  "The last operation this mirror ingested, as the mirror itself remembers it.
   Durable: a daemon restarts and the mirror must not start over."
  [m]
  (let [rows (datom/q '[:find ?v :where [?e :meta/key "op-head"] [?e :meta/value ?v]]
                      (datom/db (:conn m)))]
    (if (> (count rows) 0) (first (first rows)) "")))

(defn- op-facts [i o]
  (assoc
    {:op/id (jj/fld o "id")
     :op/parent (vec (or (jj/fld o "parents") []))
     :op/desc (or (jj/fld o "description") "")
     :op/args (or (get (jj/fld o "attributes") "args") "")
     :op/user (or (jj/fld o "username") "")
     :op/host (or (jj/fld o "hostname") "")
     :op/start (get (jj/fld o "time") "start")
     :op/snapshot (true? (jj/fld o "is_snapshot"))
     :op/workspace (or (jj/fld o "workspace_name") "")}
    :db/id (- 0 (inc i))))

(defn- commit-facts [i c paths]
  (assoc
    {:cm/id (jj/fld c "commit_id")
     :cm/change (jj/fld c "change_id")
     :cm/parent (vec (or (jj/fld c "parents") []))
     :cm/desc (or (jj/fld c "description") "")
     :cm/author (or (get (jj/fld c "author") "name") "")
     :cm/time (get (jj/fld c "author") "timestamp")
     :cm/path paths}
    :db/id (- 0 (+ 100000 (inc i)))))

(defn mirror!
  "Ingest whatever jj has recorded that datom has not.

   The watermark makes the common case free; content-addressed ids make the
   ingest idempotent, so the counts from an incremental mirror equal the counts
   from a rebuilt one."
  [dir]
  (let [m (mirror-state dir)
        head (jj/head-op dir)]
    ;; The queue is emptied BEFORE the cheap exit: a request that arrived while
    ;; the store was elsewhere has to be taken by the next look at the tree, and
    ;; the next look is usually one with nothing new from jj at all.
    (ingest-spill! dir m)
    (if (= head (watermark m))
      {:ops 0 :commits 0 :skipped true :watermark head}
      (let [db (datom/db (:conn m))
            seen-ops (known-set db '[:find ?id :where [?e :op/id ?id]])
            seen-cms (known-set db '[:find ?id :where [?e :cm/id ?id]])
            new-ops (filterv (fn [o] (not (contains? seen-ops (jj/fld o "id"))))
                             (jj/jj-json dir ["op" "log" "--no-graph" "-T" jj/T]))
            new-cms (filterv (fn [c] (not (contains? seen-cms (jj/fld c "commit_id"))))
                             (jj/jj-json dir ["log" "-r" "all()" "--no-graph" "-T" jj/T]))
            tx (into (into [] (map-indexed op-facts new-ops))
                     (into [] (map-indexed
                                (fn [i c] (commit-facts i c (jj/changed-paths dir (jj/fld c "commit_id"))))
                                new-cms)))]
        (datom/transact! (:conn m)
          (conj tx {:db/id -1 :meta/key "op-head" :meta/value head}))
        (if (:store m) (datom.store-fjall/sync! (:store m)))
        (ingest-spill! dir m)
        {:ops (count new-ops) :commits (count new-cms) :skipped false :watermark head}))))

;; ── the spill ────────────────────────────────────────────────────────────────
;;
;; The request behind a change is the one fact jj cannot re-derive, so it is
;; written to a FILE first and transacted second. The order is the whole point:
;; a checkpoint must not lose its intent because the store was unavailable,
;; slow, or held by another process. `datom.store-fjall/open` takes no lock —
;; two processes may open the same path — so "the store was there" is not a
;; guarantee anyone can give in advance; the spill is the intent's own copy.
;;
;; Two things this is NOT: it is not a claim that a second writer's facts are
;; lost (measured on 2026-09-12: a cold process's request written through the
;; spill was readable by a fresh process and by the daemon — the daemon simply
;; did not see it on its FIRST look, which is a stale-view question, not a lost
;; write), and it is not a substitute for one owner per mirror. It is a queue:
;; whoever holds the mirror ingests it, and it is cleared only once a mirror has
;; actually taken it.

(defn- spill-path [dir] (str dir "/" MIRROR "/requests.jsonl"))

(defn- spill-lines [dir]
  (let [p (spill-path dir)]
    (if (File/exists? p)
      (filterv (fn [l] (> (count (cs/trim l)) 0)) (cs/split-lines (File/read! p)))
      [])))

(defn- spill-rewrite! [dir lines]
  (File/mkdir_p! (str dir "/" MIRROR))
  (File/write! (spill-path dir) (if (seq lines) (str (reduce (fn [acc l] (str acc l "\n")) "" lines)) "")))

(defn- spill! [dir r]
  (spill-rewrite! dir (conj (spill-lines dir) (j/->json r)))
  {:ok true})

(defn- req-facts [r id]
  {:db/id id
   :req/id (jj/fld r "id")
   :req/by (or (jj/fld r "by") "daemon")
   :req/why (or (jj/fld r "why") "")
   :req/op (or (jj/fld r "op") "")
   :req/commit (or (jj/fld r "commit") "")
   :req/at (System/system_time :millisecond)
   :req/ms (or (jj/fld r "ms") 0)
   :req/path (vec (or (jj/fld r "paths") []))})

(defn- ingest-spill!
  "Transact every spilled request the mirror does not already hold, then keep
   only the ones that did not land."
  [dir m]
  (let [lines (spill-lines dir)]
    (if (empty? lines)
      0
      (let [known (known-set (datom/db (:conn m)) '[:find ?id :where [?e :req/id ?id]])
            fresh (filterv (fn [l] (not (contains? known (jj/fld (j/json-> l) "id")))) lines)
            ;; "taken" is decided from what we asked the store to hold — known
            ;; plus what we just transacted — and never from a read AFTER the
            ;; write. A connection only sees up to its own basis, so a
            ;; read-back is a fresh question with a stale answer; the queue must
            ;; not depend on it.
            taken (into known (map (fn [l] (jj/fld (j/json-> l) "id")) fresh))]
        (when (seq fresh)
          (datom/transact! (:conn m)
            (vec (map-indexed (fn [i l] (req-facts (j/json-> l) (- 0 (+ 200000 (inc i))))) fresh)))
          (if (:store m) (datom.store-fjall/sync! (:store m))))
        (spill-rewrite! dir (filterv (fn [l] (not (contains? taken (jj/fld (j/json-> l) "id")))) lines))
        (count fresh)))))

(defn- record-request!
  "The one fact jj cannot know: the request behind the operation."
  [dir r]
  (spill! dir r)
  (let [m (mirror-state dir)]
    (datom/transact! (:conn m) [(req-facts r -1)])
    (if (:store m) (datom.store-fjall/sync! (:store m)))
    (ingest-spill! dir m)
    {:ok true}))

; ── checkpoints ──────────────────────────────────────────────────────────────

(defn checkpoint!
  "Record what just happened as one change.

   `jj describe` snapshots the working copy as a side effect of opening the
   workspace — there is no staging area and no separate commit step — and the
   operation id is read AFTER the describe and before `jj new`, so jj's own op
   log carries the argv that gives the change its intent.

   A tree with nothing to record is left alone: the daemon calls this after
   every command, and most commands change nothing."
  [{:keys [dir by why paths] :or {by "daemon" why ""}}]
  (if (not (jj/dirty? dir))
    {:ok true :skipped true :reason "no changes"}
    (let [t0 (System/system_time :millisecond)
          _ (jj/run-jj dir ["describe" "-m" (str by ": " why)])
          c (jj/at-commit dir)
          op (jj/head-op dir)]
      (jj/run-jj dir ["new"])
      (mirror! dir)
      (record-request! dir {"id" (str op "-req")
                            "by" by "why" why
                            "op" op "commit" (or (jj/fld c "commit_id") "")
                            ;; jj knows which paths the change touched, so a
                            ;; checkpoint taken by hand (the CLI, a test) needs
                            ;; no caller to testify: the diff is the testimony.
                            "paths" (if (seq paths) paths
                                        (jj/changed-paths dir (jj/fld c "commit_id")))
                            "ms" (- (System/system_time :millisecond) t0)})
      {:ok true :skipped false :op op :commit (or (jj/fld c "commit_id") "")
       :change (or (jj/fld c "change_id") "")})))

(defn undo!
  "Put the whole tree back to an operation. Not an inverse patch: jj restores
   the repository state, working copy included."
  [{:keys [dir op]}]
  (let [r (jj/run-jj dir ["op" "restore" op])]
    (mirror! dir)
    {:ok (= 0 (:status r)) :out (cs/trim (:out r))}))

; ── the gate ─────────────────────────────────────────────────────────────────

(defn- bl-bin
  "The `bl` a gate should run.

   NOT necessarily the `bl` on PATH: inside a drop, PATH's first `bl` is the
   release script, whose command surface is start/daemon/eval/rpc — ask it for
   `check` and it answers `Unknown command check`. The launcher hands the real
   one to anything it spawns as `BL_BIN` (tooling/drop/src/launcher.rs), so that
   wins, then VCS_BL for a test or a CI runner, then PATH."
  []
  (or (System/get_env "BL_BIN") (System/get_env "VCS_BL") "bl"))

(defn- default-gate [] [(bl-bin) "check" "--changed"])

(defn- in-process-gate!
  "Run the check in THIS VM and return its exit code.

   Under the daemon this is the whole point: the machinery is already loaded, so
   a gate costs milliseconds instead of a cold VM's boot and library load
   (measured: 16.5 s as a subprocess, inside a request whose client gives up at
   30 s). The report still reaches the user — it prints through the same output
   proxy every other command's output uses."
  [paths]
  (BeamLisp.Loader/ensure_loaded "bl.check")
  ((BeamLisp.Env/fetch! "bl.check" "run")
   (vec (or paths []))
   {:json false :paths [] :code-paths [] :args [] :changed (empty? paths)}))

(defn gate!
  "Run the gate over a checkpoint's paths. One procedure: the daemon calls it
   before recording, `bl vcs checkpoint` calls it, CI calls `bl vcs gate`.

   `:cmd` names a command. Otherwise `:in-process` decides HOW the same
   procedure runs — in this VM when the caller is already warm (the daemon), as
   a subprocess when it is not (CI, a cold CLI).

   The default is `bl check --changed` — the same command this repository's own
   pre-commit hook runs, so a tree that gates locally gates in CI without a
   second definition."
  [{:keys [dir cmd paths in-process]}]
  (cond
    cmd
    (let [r (jj/run-argv dir cmd)]
      {:ok (= 0 (:status r)) :argv cmd :out (cs/trim (:out r))})

    in-process
    (let [code (in-process-gate! paths)]
      {:ok (= 0 code) :argv (default-gate) :in_process true :out ""})

    :else
    (let [argv (default-gate)
          args (if (seq paths) (concat argv (vec paths)) argv)
          r (jj/run-argv dir args)]
      {:ok (= 0 (:status r)) :argv argv :out (cs/trim (:out r))})))

(defn checkpoint+gated!
  "Gate, then record. The gate runs first, so a tree that fails is reported and
   NOT advanced: the failure is the thing worth knowing about."
  [opts]
  (if (not (jj/dirty? (:dir opts)))
    {:ok true :skipped true :reason "no changes"}
    (let [g (gate! opts)]
      (if (:ok g)
        (merge (checkpoint! opts) {:gate g})
        {:ok false :gate g :skipped true}))))

; ── questions ────────────────────────────────────────────────────────────────

(defn status [{:keys [dir]}]
  (let [m (mirror! dir)
        head (jj/at-commit dir)
        db (datom/db (:conn (mirror-state dir)))
        one (fn [q] (let [r (datom/q q db)] (if (> (count r) 0) (first (first r)) 0)))
        ignore (if (File/exists? (str dir "/.gitignore")) (File/read! (str dir "/.gitignore")) "")]
    {:ok true
     :dir dir
     :jj {:version (cs/trim (:out (jj/run-jj dir ["--version"])))
          :head_change (jj/fld head "change_id")
          :head_desc (jj/fld head "description")
          :latest_op (jj/head-op dir)}
     :mirror {:ops (one '[:find (count ?e) :where [?e :op/id _]])
              :commits (one '[:find (count ?e) :where [?e :cm/id _]])
              :requests (one '[:find (count ?e) :where [?e :req/id _]])
              :new m}
     :mirror_ignored (includes? ignore (str MIRROR "/"))}))

(defn history
  "The timeline only this layer can tell: requests joined to the jj operations
   they produced. An operation with no request is somebody else's."
  [{:keys [dir limit] :or {limit 50}}]
  (mirror! dir)
  (let [rows (datom/q
               '[:find ?at ?rid ?by ?why ?path ?ms ?oid ?desc ?args
                 :where [?r :req/id ?rid] [?r :req/by ?by] [?r :req/why ?why]
                        [?r :req/ms ?ms] [?r :req/at ?at] [?r :req/path ?path]
                        [?r :req/op ?oid]
                        [?o :op/id ?oid] [?o :op/desc ?desc] [?o :op/args ?args]]
               (datom/db (:conn (mirror-state dir))))
        sorted (sort-by (fn [row] (get row 0)) rows)
        n (count sorted)
        window (if (> n limit) (subvec sorted (- n limit)) sorted)]
    {:ok true
     :history (mapv (fn [row]
                      {:at (get row 0) :request (get row 1) :by (get row 2)
                       :why (get row 3) :path (get row 4) :ms (get row 5)
                       :op (get row 6) :jj_desc (get row 7) :jj_args (get row 8)})
                    window)}))

(defn touched
  "Which requests touched one path — the codebase question, asked of history."
  [{:keys [dir path]}]
  (mirror! dir)
  (let [rows (datom/q
               '[:find ?at ?rid ?by ?why ?op
                 :in $ ?path
                 :where [?r :req/path ?path] [?r :req/id ?rid] [?r :req/by ?by]
                        [?r :req/why ?why] [?r :req/at ?at] [?r :req/op ?op]]
               (datom/db (:conn (mirror-state dir))) path)]
    {:ok true :path path
     :requests (mapv (fn [row] {:at (get row 0) :request (get row 1) :by (get row 2)
                                :why (get row 3) :op (get row 4)})
                     (sort-by (fn [row] (get row 0)) rows))}))
