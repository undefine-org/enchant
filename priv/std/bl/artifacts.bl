;; Artifact commands use the same fixed JSON data schema as the backend bridge.
(ns bl.artifacts (:require [bl.util :as u]))

(defn- usage []
  (u/usage-error "usage: bl artifacts prepare SOURCE CRATE ABI | list | compare RECEIPT_A RECEIPT_B | explain RECEIPT_A RECEIPT_B | capsule RECEIPT DIRECTORY"))
;; Build drivers are resolved on invocation, as with bl.cli's other build
;; commands. Ordinary library declarations never require the driver tier.
(defn- call [name args]
  (BeamLisp.Loader/ensure_loaded "artifact")
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "artifact" name) (to-list args)))

(defn- emit [value] (println (Jason/encode! value)) 0)

(defn run [args st]
  (let [args (vec args) verb (first args)]
    (case verb
      "prepare"
        (if-not (= 4 (count args)) (usage)
          (emit (call "prepare-native!"
                  [{:platform (:platform (call "framework-context" []))
                   :source (u/resolve (nth args 1)) :crate (nth args 2) :abi (nth args 3)}])))
      "list"
        (if-not (= 1 (count args)) (usage)
          ;; The bridge schema is JSON-native maps/scalars and explicit arrays.
          (emit (to-list (call "retained" []))))
      "compare"
        (if-not (= 3 (count args)) (usage)
          (let [left (Jason/decode! (File/read! (u/resolve (nth args 1))))
                right (Jason/decode! (File/read! (u/resolve (nth args 2))))
                report (call "compare" [left right])]
            (emit (update report :changes to-list))))
      "explain"
        (if-not (= 3 (count args)) (usage)
          (do
            (BeamLisp.Loader/ensure_loaded "artifact.impact")
            (emit (BeamLisp.Ns.Rt/invoke
                    (BeamLisp.Env/fetch_exact! "artifact.impact" "explain-files!")
                    (list (u/resolve (nth args 1)) (u/resolve (nth args 2)))))))
      "capsule"
        (if-not (= 3 (count args)) (usage)
          (emit (call "capsule!" [(Jason/decode! (File/read! (u/resolve (nth args 1))))
                            (u/resolve (nth args 2))])))
      (usage))))
