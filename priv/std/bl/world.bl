;; File/CLI adapter for the existing contextual compiler. No resolver or evaluator
;; lives here: Loader reads, Compiler prepares, AOT bounds, expand links, Lower emits.
(ns bl.world
 (:require [binding :as binding] [expand :as expand] [anf :as anf]
           [lower :as lower] [system.phase :as phase] [system.arity.anf :as arity]
           [bl.util :as u]))

(defn- refuse! [kind detail]
 (throw (ex-info "Invalid compilation world" {:kind kind :detail detail})))

(defn- rows! [value]
 (when-not (or (vector? value) (erlang/is_list value)) (refuse! :world-file-table nil))
 (let [rows (BeamLisp.CompilerData/eager_to_list value)]
  (when (> (count rows) 128) (refuse! :world-file-budget nil)) rows))

(defn- bytes! [path limit]
 (let [stat (File/stat! path)]
  (when-not (and (= :regular (:type stat)) (<= (:size stat) limit))
   (refuse! :world-file-size path))
  (let [file (File/open! path (list :read :binary))
        bytes (try (IO/binread file (+ limit 1)) (finally (File/close file)))
        bytes (if (= :eof bytes) "" bytes)]
   (when-not (and (erlang/is_binary bytes) (<= (erlang/byte_size bytes) limit))
    (refuse! :world-file-size path)) bytes)))

(defn- digest [bytes] (crypto/hash :sha256 bytes))

(defn read-manifest
 "Read one bounded, effect-denying Source expression. Quoted symbols are values;
  ambient vars, reader results and a manifest's own policy grant no capabilities."
 [path]
 (let [path (Path/expand path (BeamLisp/cwd)) source (bytes! path 65536)
       _ (BeamLisp.AtomGuard/check! source)
       selection {:version 1 :profile 'syntax-v1 :target 'beam-v1
                  :sources [{:namespace 'world-manifest :digest (digest source)}]}
       world (binding/world selection [] [])
       node (:node (expand/compile-expression source path
                    {:selection (binding/select [world] []) :world (:key world) :namespace 'world-manifest}))
       value (BeamLisp.AOT/interpret_constructor! node {} {})]
  (when-not (and (erlang/is_map value) (not (contains? value :__struct__))
                 (= #{:version :profile :entry :sources :libraries} (set (keys value)))
                 (= 1 (:version value)) (= 'syntax-v1 (:profile value))
                 (vector? (:entry value)) (= 2 (count (:entry value)))
                 (every? (fn [value] (symbol? value)) (:entry value)))
   (refuse! :world-manifest nil))
  {:manifest value :input {:path path :digest (digest source) :bytes (erlang/byte_size source)}}))

(defn check-inputs!
 "Recheck captured file bytes; analysis and execution always use the prepared
  immutable program, never reload providers through ambient namespace lookup."
 [prepared]
 (doseq [input (:inputs prepared)]
  (when-not (= (:digest input) (digest (bytes! (:path input) 16777216)))
   (refuse! :world-input-changed (:path input))))
 prepared)

(defn prepare
 "Capture a manifest's exact source/archive selection, expand once and project
  phase/codebase reports from that same program. Paths are manifest-relative."
 [path]
 (let [read (read-manifest path) manifest (:manifest read)
       base (Path/dirname (get-in read [:input :path]))
       sources (rows! (:sources manifest)) libraries (rows! (:libraries manifest))
       _ (when (> (+ (count sources) (count libraries)) 128) (refuse! :world-file-budget nil))
       source-capture
       (Enum/map_reduce sources (- 16777216 (get-in read [:input :bytes]))
        (fn [row remaining]
         (when-not (and (erlang/is_map row) (not (contains? row :__struct__))
                        (= #{:namespace :revision :file} (set (keys row)))
                        (symbol? (:namespace row)) (symbol? (:revision row))
                        (erlang/is_binary (:file row)) (not= "" (:file row)))
          (refuse! :world-source-row nil))
         (let [path (Path/expand (:file row) base) bytes (bytes! path remaining)]
          (tuple {:input {:path path :digest (digest bytes) :bytes (erlang/byte_size bytes)}
                  :source (assoc row :source (BeamLisp.Loader/doc_content path bytes))}
                 (- remaining (erlang/byte_size bytes))))))
       source-inputs (elem source-capture 0)
       archive-capture
       (Enum/map_reduce libraries (elem source-capture 1)
        (fn [file remaining]
         (when-not (and (erlang/is_binary file) (not= "" file)) (refuse! :world-library-row nil))
         (let [path (Path/expand file base) bytes (bytes! path remaining)]
          (tuple {:input {:path path :digest (digest bytes) :bytes (erlang/byte_size bytes)}
                  :library (expand/decode-phase-library bytes)}
                 (- remaining (erlang/byte_size bytes))))))
       archive-inputs (elem archive-capture 0)
       inputs (cons (:input read) (Enum/map (Enum/concat source-inputs archive-inputs) #(:input %)))
       _ (check-inputs! {:inputs inputs})
       program (expand/program (Enum/map source-inputs #(:source %)) (:entry manifest)
                 (Enum/map archive-inputs #(:library %)))
       analysis (phase/analyze program) report (:report analysis)
       _ (when-not (= :proved (:status report)) (refuse! :world-phase-check (:status report)))
       facts (:facts analysis)]
  (check-inputs! {:manifest manifest :inputs inputs :program program :phase report :facts facts
                  :arity (assoc (arity/check (:node program)) :snapshot (:snapshot facts))})))

(defn describe [prepared]
 {:profile "syntax-v1" :entry (mapv (fn [value] (str value)) (get-in prepared [:manifest :entry]))
  :worlds (count (get-in prepared [:program :selection :worlds]))
  :references (get-in prepared [:phase :references])
  :expansions (count (get-in prepared [:program :expansions]))
  :phase-check (name (get-in prepared [:phase :status]))
  :arity-check (name (get-in prepared [:arity :status]))
  :arity-scope (name (get-in prepared [:arity :scope]))
  :arity-coverage (get-in prepared [:arity :coverage])
  :arity-diagnostics (get-in prepared [:arity :diagnostics])
  :phase-scope (name (get-in prepared [:phase :scope]))
  :native-effects (name (get-in prepared [:phase :native-effects :status]))
  :native-obligations (count (get-in prepared [:phase :native-effects :obligations]))
  :snapshot (Base/encode16 (get-in prepared [:facts :snapshot]) (list (tuple :case :lower)))
  :constructor-closed (= :closed (get-in prepared [:program :constructor :status]))
  :native-admission false})

(defn artifact
 "Emit run/0 and the existing contextual binding metadata without loading the
  target. These bytes/reports do not grant native execution admission."
 [prepared module]
 (check-inputs! prepared)
 (when-not (erlang/is_atom module) (refuse! :world-target-module nil))
 (let [program (:program prepared)
       bindings {:version 1 :profile 'syntax-v1 :snapshot (get-in prepared [:facts :snapshot])
                 :references (:references program) :expansions (:expansions program)}
       descriptor (anf/module module
                    (list {:op :defn-clause :fname :run :params (list) :guard nil
                           :body (:node program) :ann {}})
                    (list [:run 0])
                    (list [:bl_contextual_bindings (erlang/term_to_binary bindings (list :deterministic))]))]
  (lower/descriptor->beam descriptor {})))

(defn execute
 "Ordinary native evaluation, with the existing framework check and Lower's
  closure-preserving eval-module lifetime. A phase report is not admission."
 [prepared argv]
 (BeamLisp.Env/assert_native_framework_execution!)
 (check-inputs! prepared)
 (BeamLisp/with_argv (BeamLisp.CompilerData/eager_to_list argv)
  (fn []
   (lower/eval-anf
    (erlang/binary_to_atom (str "Elixir.BeamLisp.World.Eval" (erlang/unique_integer (list :positive))))
    (get-in prepared [:program :node])))))

(defn run [args st]
 (let [verb (first args) path (second args)]
  (if (not (and (= 2 (count args)) (contains? #{"check" "emit" "run"} verb)
                (or (not= "emit" verb) (:out st))))
   (u/usage-error "usage: bl world check|run MANIFEST.bl | bl world emit MANIFEST.bl --out FILE.beam")
   (let [prepared (prepare (u/resolve path))]
    (case verb
     "check" (u/emit st (describe prepared) (fn [value] (pr-str value)))
     "run" (let [value (execute prepared (or (:dd st) []))]
             (u/emit st value (fn [v] (BeamLisp.Ns.Rt/print_str v))))
     "emit" (let [pair (artifact prepared :Elixir.BeamLisp.World.Program)
                  output (u/resolve (:out st))]
              (File/write! output (elem pair 1) (list :binary :exclusive))
              (u/emit st (assoc (describe prepared) :output output
                           :module (Atom/to_string (elem pair 0))
                           :beam-sha256 (Base/encode16 (digest (elem pair 1)) (list (tuple :case :lower)))) (fn [value] (pr-str value)))))
    0))))
