;; CLI adapter and compatibility API for the shared compilation-world owner.
(ns bl.world (:require [compile.world :as world] [bl.util :as u]))

(defn read-manifest [path] (world/read-manifest path))
(defn check-inputs! [prepared] (world/check-inputs! prepared))
(defn prepare [path] (world/prepare path))
(defn describe [prepared] (world/describe prepared))
(defn artifact [prepared module] (world/artifact prepared module))
(defn prepare-unit [prepared module] (world/prepare-unit prepared module))
(defn read-unit [directory] (world/read-unit directory))
(defn execute [prepared argv] (world/execute prepared argv))

(defn run [args st]
 (let [verb (first args) path (second args)]
  (if (not (and (= 2 (count args)) (contains? #{"check" "emit" "run"} verb)
                (or (not= "emit" verb) (:out st))))
   (u/usage-error "usage: bl world check|run MANIFEST.bl | bl world emit MANIFEST.bl --out FILE.beam")
   (let [prepared (prepare (u/resolve path))]
    (case verb
     "check" (u/emit st (describe prepared) (fn [value] (pr-str value)))
     "run" (let [value (execute prepared (or (:dd st) []))]
             (u/emit st value (fn [v] (BeamLisp.Ns.Rt/print_str v))))
     "emit" (let [pair (artifact prepared :Elixir.BeamLisp.World.Program)
                  output (u/resolve (:out st))]
              (File/write! output (elem pair 1) (list :binary :exclusive))
              (u/emit st (assoc (describe prepared) :output output
                           :module (Atom/to_string (elem pair 0))
                           :beam-sha256 (Base/encode16 (crypto/hash :sha256 (elem pair 1)) (list (tuple :case :lower)))) (fn [value] (pr-str value)))))
    0))))
