;; Codebase projection of the compiler-owned contextual snapshot.
(ns codebase.phase (:require [binding :as b] [expand-source :as source]))

(defn catalog
 ([sources] (source/catalog sources))
 ([sources libraries] (source/catalog sources libraries)))
(defn unit [catalog namespace revision] (source/unit catalog namespace revision))

(defn- refuse! [kind node]
 (throw (ex-info "Invalid contextual facts" {:kind kind :origin (:origin node)})))

(defn facts
 "Project one expanded snapshot. Consumers use declaration/reference IDs and
  recorded contexts, never reparse Source or resolve through current Env.
  These are analysis data, not native execution admission."
 [program]
 (when-not (= :expanded-program (:kind program)) (refuse! :phase-expanded-program nil))
 (let [selection (b/validate-selection (:selection program))]
  {:version 1 :kind :contextual-facts :selection selection :snapshot (:state-key selection)
   :declarations (Enum/sort_by (Map/values (:by-id selection)) #(:id %))
   :references (:occurrences program) :expansions (:expansions program)
   :imports (:imports selection) :native-obligations (:native-obligations program)
   :coverage (:coverage program) :native-admission false}))
