; vm/native.bl — defnative's policy, in beam-lisp.
;
; ══ WHAT MOVED HERE (FUP-082 T3, PLAN-122) ══════════════════════════════════
;
; A NIF is substrate; the DECLARATION that one exists is not. `defnative`
; (a compiler macro) lowers onto `vm.native/declare`, which:
;   1. synthesizes a host BEAM module named after the ns (the rustler::init!
;      contract), with an @on_load that loads the crate + one nif_error stub
;      per signature — via the pure-bl module synthesis toolkit (anf + lower),
;      no BeamLisp.Emit, no Elixir policy;
;   2. links each name into the ns as an ordinary var (callable AND a value);
;   3. records the declaration so AOT can replay it into emitted modules.
;
; This lives in `vm.*` (not `bl.*`) because `defnative` is used far outside the
; CLI — every native-backed library (datom stores, wry, code/embed) declares
; through it. It is runtime substrate, reusable by any host.
;
; The Rust artifact stays; ONLY this policy is beam-lisp now. The irreducible
; substrate is three BIFs: erlang/load_nif, code/ensure_loaded, and the
; anf→core→beam synthesis (all of which bl already drives).

(ns vm.native
  (:require [anf] [lower] [claim :as c]
            [bl.native-declarations :as native-declarations]))

(defn- rep-bin
  "erlang:string:replace with :all returns IODATA (a list); flatten to a binary."
  [s a b]
  (erlang/apply :erlang :iolist_to_binary
    (list (erlang/apply :string :replace (list s a b :all)))))

;; ── the declarations registry ───────────────────────────────────────────────
;;
;; VM-wide state that must OUTLIVE whichever process first declared a native:
;; a parallel-build worker declaring, then exiting, must not drop the row (that
;; is BUG-021 — a module then AOT-emits WITHOUT its native replay, silently).
;; So the table is created inside the pinned Loader.Server, whose lifetime is
;; the VM's, exactly as native.ex did.

(def TABLE :beam_lisp_native_declarations)

(defn- ensure-table []
  (if (= :undefined (erlang/apply :ets :whereis (list TABLE)))
    (BeamLisp.Loader.Server/run
      (fn []
        (try
          (erlang/apply :ets :new
            (list TABLE (list :named_table :public :set (tuple :read_concurrency true))))
          (catch _ :ok))
        TABLE))
    TABLE))

;; ── the host-module name: THE contract with rustler::init! ──────────────────
;;
;; `datom.store-fjall` → `Elixir.BeamLisp.Native.Datom.StoreFjall`. This MUST
;; match the string each crate passes to rustler::init! at compile time, or
;; load_nif returns {:bad_lib}. Ported character-for-character from native.ex:
;; split on ".", each segment: replace "-"→"_" then CamelCase, join under
;; BeamLisp.Native.

(defn- camelize
  "`store_fjall` → `StoreFjall`. Upcase the first char of each `_`-part, drop
   the separators (the Macro.camelize rule native.ex used)."
  [s]
  (let [parts (erlang/apply :string :split (list s "_" :all))]
    (erlang/apply :erlang :iolist_to_binary
      (list (to-list (map (fn [p]
                   (if (= p "")
                     ""
                     (str (erlang/apply :string :uppercase (list (erlang/apply :string :slice (list p 0 1))))
                          (erlang/apply :string :slice (list p 1)))))
                 parts))))))

(defn host-module
  "The BEAM module atom hosting `ns`'s NIF. THE rustler::init! contract."
  [ns]
  (let [segs (erlang/apply :string :split (list ns "." :all))
        camel (map (fn [seg] (camelize (rep-bin seg "-" "_"))) segs)
        joined (erlang/apply :erlang :iolist_to_binary
                 (list (erlang/apply :lists :join (list "." (to-list camel)))))]
    (erlang/binary_to_atom (str "Elixir.BeamLisp.Native." joined) :utf8)))

(defn- snake
  "kebab var name → snake NIF fname atom: `compare-and-swap` → `:compare_and_swap`."
  [name]
  (erlang/binary_to_atom (rep-bin name "-" "_") :utf8))

;; ── lib-path resolution: consumer apps first, beam_lisp last ────────────────
;;
;; AND THE PROJECT'S OWN priv/native, because that is where `bl build --native`
;; installs one. Before this, a crate a project built landed at
;; <root>/priv/native/<crate>.so — the path `project-installed-path` promises —
;; and NOTHING read it: the search asked the shipped apps, then beam_lisp's
;; priv, so the crate answered ABSENT with its .so sitting in the tree. The
;; roots the LOADER searches are the roots a native can live under, so they are
;; searched in the order the loader searches them (cwd, then BEAM_LISP_PATH,
;; then anything pushed), and BELOW the loaded apps — a project may ship its own
;; crate, and beam_lisp's copy is still the last resort.

(defn- root-native-dir
  "`<root>/priv/native/<crate>`, when the cdylib is there."
  [root crate]
  (let [p (str root "/priv/native/" crate)]
    (if (File/exists? (str p ".so")) p nil)))

(defn- ambient-roots
  "The library roots the loader searches, nearest first: the working directory,
   then each BEAM_LISP_PATH entry, then whatever a caller pushed with
   `Env/add_search_path`. Same order, so a `.bl` file and the native crate
   beside it resolve consistently."
  []
  (let [s (System/get_env "BEAM_LISP_PATH")
        env (if (and (string? s) (not= s ""))
              (to-list (erlang/apply :string :split (list s ":" :all)))
              (list))
        pushed (to-list (BeamLisp.Env/search_paths))]
    (concat (list (BeamLisp/cwd)) env pushed)))

(defn- app-priv-dir [app]
  (if (= app :beam_lisp)
    (BeamLisp.Tiers/priv_root)
    (let [d (erlang/apply :code :priv_dir (list app))]
      (if (and (not (and (erlang/is_tuple d) (= :error (elem d 0))))
               (File/dir? (erlang/apply :erlang :list_to_binary (list d))))
        (erlang/apply :erlang :list_to_binary (list d))
        nil))))

(defn lib-path
  "The extension-less path erlang/load_nif wants for `crate`. Searches every
   loaded app's priv/native (consumers first), then the loader's own roots'
   priv/native (a project's own crate), then beam_lisp's priv; falls back to
   beam_lisp's priv so a load error names a sensible location."
  [crate]
  (let [apps (erlang/apply :lists :map
               (list (fn [a] (elem a 0))
                     (erlang/apply :application :loaded_applications (list))))
        others (erlang/apply :lists :filter (list (fn [a] (not= a :beam_lisp)) apps))
        found (or (some (fn [app]
                          (let [dir (app-priv-dir app)]
                            (if (nil? dir)
                              nil
                              (root-native-dir dir crate))))
                        others)
                  (some (fn [root] (root-native-dir root crate)) (ambient-roots)))]
    (or found (str (BeamLisp.Tiers/priv_root) "/native/" crate))))

(defn artifact-name
  "THE name a crate's cdylib is installed under AND loaded under. Both the
   build (which installs it) and the loader (which asks for it) derive from
   here, so they cannot disagree — BUG-070 was this name existing twice, once
   bare in the build and once `.so` at load."
  [crate]
  (str crate ".so"))

(defn project-installed-path
  "Where the BUILD installs a crate's cdylib: <root>/priv/native/<crate>.so.
   `root` is the project being built, not the running app."
  [root crate]
  (str root "/" INSTALL-DIR "/" (artifact-name crate)))

(defn installed-path
  "Where the built .so lives: priv/native/<crate>.so."
  [crate]
  (str (BeamLisp.Tiers/priv_root) "/native/" (artifact-name crate)))

;; ── warn on a failed load (a capability answer, not a crash) ────────────────

(defn nif-load-failed [ns crate lib reason]
  (BeamLisp.IO/warn
    (str "the NIF for " ns " did not load: " (pr-str reason) "\n"
         "  crate:   " crate "\n"
         "  library: " lib ".so\n"
         "  A \"Function not found\" reason means a declared name or arity\n"
         "  disagrees with the crate; run `bl build` if it is simply missing.\n"))
  :ok)

;; ── host-module synthesis (the substrate seam: anf → core → beam) ───────────
;;
;; Builds a module with:
;;   __load_nif__/0  — the @on_load target: erlang/load_nif(charlist, 0),
;;                     on {:error, r} warn, else return the load result;
;;   __nif_loaded__/0 — a stub the loaded NIF overwrites to return true;
;;   <fname>/<arity>  — one nif_error stub per signature, overwritten at load.
;; The on_load attribute value is a LIST [{fname,arity}] (a bare tuple crashes
;; beam_ssa_opt — locked by spike).

(defn host-descriptor
  "Pure canonical native host descriptor. The caller selects the library path;
   this does not load code, open a library, or publish a declaration receipt."
  [ns crate signatures lib]
  (let [mod (host-module ns)
        charlist (erlang/binary_to_list lib)
        ;; __load_nif__/0: case erlang:load_nif(charlist, 0) of ...
        ;; on_load MUST return :ok even when the .so is absent — the module then
        ;; loads with its nif_error stubs intact and available? answers false
        ;; ("absent = absent"). We call load_nif for its SIDE EFFECT (installing
        ;; the NIF when present) then discard the result and return :ok.
        load-body
        (anf/doo (list
                  (anf/remote :erlang :load_nif (list (anf/lit charlist) (anf/lit 0)))
                  (anf/lit :ok)))
        load-clause {:op :defn-clause :fname :__load_nif__ :params (list)
                     :guard nil :body load-body :ann {}}
        stub-body (anf/remote :erlang :nif_error (list (anf/lit :nif_not_loaded)))
        loaded-clause {:op :defn-clause :fname :__nif_loaded__ :params (list)
                       :guard nil :body stub-body :ann {}}
        stub-clauses (map (fn [sig]
                            (let [fname (snake (first sig))
                                  arity (second sig)
                                  params (map (fn [i] {:pop :pvar :name (str "arg" i)})
                                              (range 1 (inc arity)))]
                              {:op :defn-clause :fname fname :params (apply list params)
                               :guard nil :body stub-body :ann {}}))
                          signatures)
        exports (concat (list [:__nif_loaded__ 0])
                        (map (fn [sig] [(snake (first sig)) (second sig)]) signatures))
        desc (anf/module mod
               (apply list (concat (list load-clause loaded-clause) stub-clauses))
               (apply list exports)
               (list [:on_load (list (tuple :__load_nif__ 0))]))]
    desc))

(defn- create-host
  ([mod ns crate signatures] (create-host mod ns crate signatures (lib-path crate)))
  ([mod ns crate signatures lib]
  (let [descriptor (host-descriptor ns crate signatures lib)
        beam (lower/descriptor->beam descriptor)]
    (when-not (= mod (:name descriptor))
      (throw (ex-info "Native host identity mismatch" {:ns ns :kind :native-host-identity-mismatch})))
    (BeamLisp.AOT/prepare_native_host_emission! ns crate (to-list signatures) lib beam)
    (BeamLisp.Env/publish_binaries! (list beam) (str mod ".beam"))
    (BeamLisp.AOT/register_native_host_emission! ns crate (to-list signatures) lib beam)
    mod)))

(defn bootstrap-sdk-host!
  "SDK kernel bootstrap publishes only a canonical native host, without linking
   provider vars or running the provider namespace initializer. The native AOT
   boundary validates current physical SDK source and library before on_load."
  [ns crate signatures lib]
  (let [mod (host-module ns)]
    (erlang/apply :global :trans
      (list (tuple mod (erlang/self))
        (fn []
          ;; Even an already-loaded host is reconstructed/validated exactly;
          ;; physical publication is an identical-code no-op when appropriate.
          (create-host mod ns crate signatures
            (BeamLisp.AOT/selected_sdk_native_library! ns mod lib)))))))

;; ── link a native name into the ns (callable + value) ───────────────────────

(defn- link-var [ns mod name arity]
  (let [fname (snake name)]
    ;; put_link → the compiler emits a direct remote call (no dispatch cost);
    ;; intern → the name is also a VALUE (passable to map, stored, applied).
    (BeamLisp.Env/put_link ns name (tuple mod (assoc {} arity fname) nil))
    (BeamLisp.Env/intern ns name (erlang/apply :erlang :make_fun (list mod fname arity)))))

;; ── guards ──────────────────────────────────────────────────────────────────

; `signatures` names arrive as a LAZY seq (from `map`), so `:lists.join`
; needs a real list first — passing the seq raised `FunctionClauseError`
; instead of the refusal the guard exists to deliver (measured: the
; ExUnit port got `:lists.join(", ", ("get"))`). `to-list` is the
; normalizer `host-module` already uses.

(defn- names-str
  "The clashing names joined for a message: `\"a, b\"`.

   `:lists.join/2` answers IODATA, not a binary, and `str` embeds that list
   VERBATIM — the first port printed `(\"get\")` where a reader needs `get`.
   Flatten, so the message is text."
  [names]
  (erlang/apply :erlang :iolist_to_binary
    (list (erlang/apply :lists :join (list ", " (to-list names))))))

(defn- tag
  "The prefix the fix suggests: the ns's last segment minus a `store-`.
   `datom.store-fjall` → `fjall`, so the fix reads `fjall-get`."
  [ns]
  (rep-bin (last (erlang/apply :string :split (list ns "." :all))) "store-" ""))

(defn- guard-duplicates! [ns signatures]
  (let [names (map first signatures)
        dupes (->> names frequencies (filter (fn [kv] (> (second kv) 1))) (map first))]
    (when (not (empty? dupes))
      (throw (ex-info (str "defnative in " ns ": "
                           (names-str dupes)
                           " declared more than once") {:ns ns})))))

(defn- guard-shadowing! [ns signatures]
  (let [clashes (filter (fn [name]
                          (let [r (BeamLisp.Env/fetch "core" name)]
                            (and (erlang/is_tuple r) (= :ok (elem r 0)))))
                        (map first signatures))]
    (when (not (empty? clashes))
      (throw (ex-info (str "defnative in " ns ": " (names-str clashes) " would shadow core.\n"
                           "\n"
                           "A native name binds for the whole namespace, so the failure would\n"
                           "surface wherever this file next calls the core function — with an\n"
                           "error about argument types, far from the declaration.\n"
                           "\n"
                           "Prefix them: "
                           (names-str (map (fn [n] (str (tag ns) "-" n)) clashes)))
                      {:ns ns})))))

;; ── the public surface ──────────────────────────────────────────────────────

(defn declare
  "Declare that `ns` is backed by NIF crate `crate`. `signatures` is a list of
   [name arity]. Synthesizes the host module, links each name, records the
   declaration for AOT replay. Returns the host module atom. A VM-wide critical
   section (per host module) guards concurrent same-ns loads."
  [ns crate signatures]
  (let [mod (host-module ns)]
    (erlang/apply :global :trans
      (list (tuple mod (erlang/self))
            (fn []
              (guard-duplicates! ns signatures)
              (guard-shadowing! ns signatures)
              (BeamLisp.AOT/assert_sdk_native_start! ns mod)
              ;; ensure_loaded → {:module,_}|{:error,_}; synth only when absent
              (if (BeamLisp.AOT/sdk_native_source? ns)
                ;; SDK code-path artifacts carry on_load too: synthesize the
                ;; exact proved host instead of executing an unproved cache.
                (when-not (erlang/module_loaded mod) (create-host mod ns crate signatures))
                (when (= :error (elem (erlang/apply :code :ensure_loaded (list mod)) 0))
                  (create-host mod ns crate signatures)))
              (ensure-table)
              (erlang/apply :ets :insert
                (list TABLE (tuple (tuple :native ns) (tuple crate signatures))))
              (doseq [sig signatures] (link-var ns mod (first sig) (second sig)))
              mod)))))

(defn declaration
  "The declaration for `ns` as {:crate c :sigs [[n a]…]}, or nil."
  [ns]
  (ensure-table)
  (let [hits (erlang/apply :ets :lookup (list TABLE (tuple :native ns)))]
    (if (empty? hits)
      nil
      (let [decl (elem (first hits) 1)]
        {:crate (elem decl 0) :sigs (elem decl 1)}))))

(defn declarations
  "Every native declaration so far, as [{:ns … :crate … :sigs …} …]. AOT reads
   this to replay declarations into the modules it emits."
  []
  (ensure-table)
  (map (fn [row]
         (let [ns (elem (elem row 0) 1)
               decl (elem row 1)]
           {:ns ns :crate (elem decl 0) :sigs (elem decl 1)}))
       (erlang/apply :ets :match_object (list TABLE (tuple (tuple :native :_) :_)))))

(defn available?
  "Whether the NIF for `ns` loaded. A capability question — never raises. The
   host stub raises; only the loaded NIF's __nif_loaded__ returns true."
  [ns]
  (let [mod (host-module ns)]
    (try
      (and (erlang/is_tuple (erlang/apply :code :ensure_loaded (list mod)))
           (= :module (elem (erlang/apply :code :ensure_loaded (list mod)) 0))
           (erlang/apply mod :__nif_loaded__ (list)))
      (catch _ false))))

;; ── the build: cargo in, cdylib out (folds native_task + cargo) ─────────────
;;
;; Runtime refresh runs after application startup, with mandatory native
;; custody available. Explicit and startup builds share build's producer.
;; First native boot is the Rust builder's responsibility; this namespace
;; cannot repair an absent mandatory runtime by bootstrapping through itself.

(def NATIVE-DIR "native")          ; crate SOURCES, cwd-relative (project root)
(def INSTALL-DIR "priv/native")    ; where the built .so is installed, cwd-relative

(defn- nif-ext [] ".so")  ; every unix (macOS included) uses .so for erl_ddll

(defn- nix-provider? []
  (when-not (= "nix" (or (System/get_env "BL_NATIVE_PROVIDER") "nix"))
    (throw (ex-info "Native production requires Nix; local providers are unsupported"
                    {:kind :native-provider-unsupported})))
  true)

(defn build!
  "Prepare one declared native alias through the admitted Nix producer."
  [crate]
  (when (or (not (string? crate)) (= "" crate) (contains? #{"." ".."} crate)
            (not= crate (Path/basename crate)) (= :absolute (Path/type crate)))
    (throw (ex-info "Native crate must be one directory name" {:kind :native-crate-scope :crate crate})))
  (nix-provider?)
  (BeamLisp.Loader/ensure_loaded "build")
  (let [result (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "build" "build-native-crate")
                 (list (Path/expand ".") crate nil))]
    (when (seq (:errors result))
      (throw (ex-info (str "Native preparation failed for " crate ":\n" (join "\n" (:errors result)))
                     {:crate crate :errors (:errors result)})))
    {:ok (str INSTALL-DIR "/" crate (nif-ext))}))

(defn- native-root-directory! [path]
  ;; lstat EVERY ancestor before enumeration: expanding a path alone does not
  ;; prevent traversing a symlink hidden in an ancestor directory.
  (let [expanded (Path/expand path)]
    (when (= "/" expanded)
      (throw (ex-info "Native refresh cannot scan the filesystem root" {:kind :native-refresh-scope})))
    (reduce (fn [parent part]
              (let [current (Path/join parent part)]
                (when-not (= :directory (:type (File/lstat! current)))
                  (throw (ex-info "Native refresh requires real source directories"
                                  {:kind :native-refresh-scope :path current})))
                current)) "/" (rest (Path/split expanded)))
    expanded))

(defn- native-refresh-crates [root]
  ;; Consumer and engine projects normalize independently. Never borrow the
  ;; consumer's declarations for the platform root or vice versa.
  (let [root (Path/expand root)
        entries (when (File/regular? (Path/join root "env.bl"))
                  (BeamLisp.Loader/ensure_loaded "bl.env")
                  (let [project (BeamLisp.Ns.Rt/invoke
                                  (BeamLisp.Env/fetch_exact! "bl.env" "project") (list root))]
                    (when (seq (:errors project))
                      (throw (ex-info "Invalid native refresh project" {:kind :native-refresh-declarations
                                                                       :root root :errors (:errors project)})))
                    (get-in project [:build :native])))]
    (let [requests (native-declarations/discover! root entries)]
      ;; SDK image selections can be symlinks with no Rust sources. Validate
      ;; only actual selected source roots before source traversal/production.
      (doseq [source (distinct (map :source requests))] (native-root-directory! source))
      requests)))

(defn- source-native-roots
  ;; A source-backed consumer and engine each retain their own publication root.
  ([] (source-native-roots (BeamLisp/cwd)
        (erlang/apply :Elixir.System :get_env (list "BL_ROOT"))))
  ([project platform]
   (vec (filter (fn [root] (seq (native-refresh-crates root)))
                (distinct (map Path/expand (remove nil? [project platform])))))))

;; A successful producer run leaves a content receipt, not a timestamp shortcut.
;; The receipt covers a conservative superset of native-key's inputs, the live
;; producer key/toolchain, and every installed artifact. It cannot certify a
;; missing artifact, and source edits during a build prevent publication.
(defn- native-refresh-digest [value]
  (String/downcase (Base/encode16 (crypto/hash :sha256
    (erlang/term_to_binary value (list :deterministic))))))

(defn- native-source-inventory! [source]
  ;; Capture the whole declared closure, including support files and sibling
  ;; packages. Generated directories match the immutable snapshot exclusions.
  ;; Bounds make accidental huge source declarations a refusal, not a VM sink.
  (let [source (native-root-directory! source)]
    (loop [pending [[source 0]] rows [] entries 0 bytes 0]
      (if (empty? pending)
        (sort rows)
        (let [[path depth] (first pending)
              remaining (rest pending)
              info (File/lstat! path)
              entries (inc entries)]
          (when (or (> entries 65536) (> depth 64))
            (throw (ex-info "Native source inventory exceeds its entry/depth bound"
                            {:kind :native-refresh-capacity :source source})))
          (cond
            (= :directory (:type info))
              (let [children (remove #(contains? #{".git" ".bl" "target"} %)
                                      (sort (File/ls! path)))]
                (when (> (+ entries (count remaining) (count children)) 65536)
                  (throw (ex-info "Native source directory exceeds inventory capacity"
                                  {:kind :native-refresh-capacity :path path})))
                (recur (concat (map (fn [name] [(Path/join path name) (inc depth)]) children) remaining)
                       (conj rows [(Path/relative_to path source) :directory]) entries bytes))
            (= :regular (:type info))
              (let [size (:size info) total (+ bytes size)]
                (when (or (> size 134217728) (> total 1073741824))
                  (throw (ex-info "Native support files exceed inventory byte capacity"
                                  {:kind :native-refresh-capacity :path path})))
                (recur remaining
                       (conj rows [(Path/relative_to path source) :regular
                                   (erlang/band (:mode info) 511)
                                   (crypto/hash :sha256 (File/read! path))]) entries total))
            :else
              (throw (ex-info "Native source inventory refuses symlinks and special files"
                              {:kind :native-refresh-scope :path path}))))))))

(defn- native-refresh-inputs [root producer cargo]
  (let [requests (native-refresh-crates root)
        sources (sort (distinct (map :source requests)))]
    (native-refresh-digest
      [2 (Path/expand root) producer cargo requests
       (mapv #(tuple % (native-source-inventory! %)) sources)])))

(defn- native-refresh-artifacts [root]
  (mapv #(Path/join (Path/join root "priv/native") (artifact-name (:crate %)))
        (native-refresh-crates root)))

(defn- native-refresh-state [artifacts inputs]
  (when (every? File/regular? artifacts)
    (native-refresh-digest
      [inputs (mapv #(tuple % (crypto/hash :sha256 (File/read! %))) artifacts)])))

(defn- refresh-native-root-owned [root producer cargo build receipt artifacts]
  (when-not (= artifacts (native-refresh-artifacts root))
    (throw (ex-info "Native artifact selection changed before admission" {:kind :native-refresh-scope})))
  (let [inputs (native-refresh-inputs root producer cargo)
        state (native-refresh-state artifacts inputs)]
    (if (and (BeamLisp.AOTCache/enabled?) state (= (tuple :ok state) (File/read receipt)))
      {:built 0 :cached (count (native-refresh-artifacts root))
       :artifacts (native-refresh-artifacts root) :errors []}
      (let [result (build root)]
        (when (and (BeamLisp.AOTCache/enabled?) (empty? (:errors result))
                   (= inputs (native-refresh-inputs root producer cargo)))
          (when-let [after (native-refresh-state artifacts inputs)]
            (File/mkdir_p! (Path/dirname receipt))
            (let [tmp (str receipt ".tmp-" (erlang/apply :os :getpid (list)) "-"
                           (erlang/unique_integer (list :positive)))]
              (try
                (File/write! tmp after)
                (File/rename! tmp receipt)
                (finally (File/rm tmp))))))
        result))))

(defn- refresh-native-root [root producer cargo build]
  (let [receipt (Path/join (Path/join (BeamLisp.AOTCache/dir) "native-refresh")
                           (native-refresh-digest (Path/expand root)))
        artifacts (native-refresh-artifacts root)]
    ;; The receipt and the observed files form one operation. A foreign native
    ;; publisher must exclude even a cache hit before bytes are inspected.
    (c/with-writer! (str receipt ".custody") "native refresh receipt"
      (fn []
        (c/with-artifacts! artifacts "native refresh publication"
          #(refresh-native-root-owned root producer cargo build receipt artifacts))))))

(defn build-all!
  "Refresh source-backed native roots through immutable Nix production."
  []
  (if (nix-provider?)
    (let [roots (source-native-roots)]
      ;; Declaration discovery still validates both roots. The build driver is
      ;; needed only when that validated selection contains actual work.
      (when (seq roots) (BeamLisp.Loader/ensure_loaded "build"))
      (mapcat
        (fn [root]
          (let [result (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "build" "build-native") (list root nil))]
            (doseq [error (:errors result)] (println (str "native refresh: " error)))
            (concat (map #(list (Path/rootname (Path/basename %)) {:ok %}) (:artifacts result))
                    (map #(list root {:error %}) (:errors result)))))
        roots))
    (throw (ex-info "Native production requires Nix" {}))))
