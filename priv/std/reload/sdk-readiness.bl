; Native preparation of the SDK call paths used by a checked Source graph.
; Metadata is read, never executed, to find further bindings. Unused SDK
; functions and quoted provider names do not become initialization requests.
(ns reload.sdk-readiness (:require [reload.native-call :as native-call]))

(def ^:private closures (atom {}))

(defn- field [node key]
 ;; These are compiler descriptor fields, not user collection operations.
 (when (erlang/is_map node) (maps/get key node nil)))

(defn- target-key [target]
 ;; Selectors contain only fixed kind/module/name/arity data. Metadata on the
 ;; sequence carrier has no dependency meaning and must not become a hash walk.
 (erlang/list_to_tuple (to-list target)))

(defn- descriptor-inputs-current? [inputs]
 ;; An initializer may publish unrelated SDK namespaces during the traversal.
 ;; Check the actual descriptors and generations read, rather than rejecting
 ;; every cold pass because the global publication counter moved.
 (Enum/all? inputs
  (fn [pair]
   (let [namespace (elem pair 0) info (elem pair 1)]
    (or (nil? info)
     (and (erlang/=:= (field info :generation)
                     (BeamLisp.Env/sdk_namespace_generations (list namespace)))
          (erlang/=:= (field info :definitions) (Map/new (BeamLisp.Env/ns_defs namespace)))))))))

(defn with-source-snapshot
 "Share exact SDK Source checks within one synchronous metadata validation
  batch. No callback is executed by the checker and no authority is granted.
  Resolver context and expected path/bytes participate in every cache key."
 [action]
 (BeamLisp.Env/assert_native_framework_execution!)
 (if (Process/get :reload.sdk-readiness/source-snapshot)
  (action)
  (try
   (Process/put :reload.sdk-readiness/source-snapshot {})
   (action)
   (finally (Process/delete :reload.sdk-readiness/source-snapshot)))))

(defn- source-input-current? [namespace expected]
 (let [snapshot (Process/get :reload.sdk-readiness/source-snapshot)
       key [(BeamLisp.Loader/declaration_source_context namespace) expected]]
  (if (and snapshot (contains? snapshot key)) (get snapshot key)
   (let [source (BeamLisp.Loader/source_path namespace)
         current (and (= source (:path expected))
                  (if (:image? expected)
                    (nil? source)
                    (and (BeamLisp.AOT/sdk_library_source? namespace source)
                         (= (:sha expected) (crypto/hash :sha256 (BeamLisp.Loader/read_source source))))))]
    (when snapshot
     (Process/put :reload.sdk-readiness/source-snapshot (assoc snapshot key current)))
    current))))

(defn- source-inputs-current? [inputs]
 (try (every? (fn [[namespace expected]] (source-input-current? namespace expected)) inputs)
  (catch _ false)))

(defn reference [node]
 (let [op (field node :op) arguments (field node :args)
       module (field node :mod) function (field node :fun)]
 (cond
  (= :global op) [:binding (field node :ns) (field node :name)]
  (= :remote op)
   (cond
    (and (= :Elixir.BeamLisp.Loader module) (= :ensure_ready function)
         (= 1 (count arguments)) (= :lit (field (first arguments) :op)))
     [:namespace (field (first arguments) :val)]
    (and (or (and (= :Elixir.BeamLisp.Env module) (= :sdk_callable! function))
             (and (= :Elixir.BeamLisp.AOT module) (= :sdk_named_constructor! function)))
         (= 3 (count arguments)) (= :lit (field (first arguments) :op))
         (string? (field (first arguments) :val)))
     (let [namespace (field (first arguments) :val) binding (second arguments)]
      (if (and (= :lit (field binding :op)) (string? (field binding :val)))
       [:binding namespace (field binding :val)] [:namespace namespace]))
    (and (= :Elixir.BeamLisp.Env module) (= :invoke_source_native! function)
         (= 3 (count arguments)) (= :lit (field (first arguments) :op))
         (= :lit (field (second arguments) :op)))
     [:remote (field (first arguments) :val) (field (second arguments) :val)
              (count (native-call/checked-arguments (nth arguments 2)))]
    :else [:remote module function (count arguments)])
  :else nil)))

(defn- closure-current? [cached]
 (and cached
      (every? (fn [namespace] (BeamLisp.Env/ns_ready_in? (list :global) namespace)) (:namespaces cached))
      (= (:generations cached) (BeamLisp.Env/sdk_namespace_generations (to-list (:namespaces cached))))
      (source-inputs-current? (:sources cached))))

(defn- prepare-closure!
 "Initialize only fixed SDK namespaces reached by actual executable binding
  reads/calls, following their actual function descriptors transitively. This
  grants no invocation authority and never evaluates a candidate function."
 [roots]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [frame (tuple :sdk-readiness (erlang/make_ref))
       inventory (BeamLisp.AOT/sdk_inventory_input)
       compiler-key (BeamLisp.AOTCache/compiler_key)
       image-key (when (elem inventory 1) (crypto/hash :sha256 (elem inventory 1)))
       request-key [:request (elem inventory 0) compiler-key (or image-key :source-checkout) roots]]
  ;; Invocation-local compiler data must not live in native memo cells: every
  ;; read/write there copies and scans the growing descriptor graph. This frame
  ;; retains ordinary immutable terms only during this synchronous preparation.
  (Process/put frame {:pending (list) :queued {} :seen {} :namespaces {} :modules {}
                      :initialized {} :fuel 262144})
  (try
  (letfn [(read [key] (maps/get key (Process/get frame)))
          (write! [key value] (Process/put frame (maps/put key value (Process/get frame))) value)
          (step! []
            (when (erlang/< (write! :fuel (erlang/- (read :fuel) 1)) 0)
             (throw (ex-info "SDK readiness graph exceeds its finite bound"
                             {:kind :sdk-readiness-budget}))))
          (enqueue! [target]
            (when target
             (let [key (target-key target)]
              (when-not (or (maps/is_key key (read :seen)) (maps/is_key key (read :queued)))
               (write! :queued (maps/put key true (read :queued)))
               (write! :pending (cons target (read :pending)))))))
          (walk [node]
            ;; Compiler descriptors are finite data. Visit them eagerly and
            ;; keep literal/annotation/pattern payloads opaque.
            (cond
             (and (erlang/is_map node)
                  (erlang/=:= :Elixir.BeamLisp.Vector (maps/get :__struct__ node nil)))
              (do (step!) (Enum/each (BeamLisp.Vector/to_list node) walk))
             (erlang/is_map node)
              (do (step!) (enqueue! (reference node))
               (when-not (= :lit (maps/get :op node nil))
                (Enum/each (maps/to_list node)
                 (fn [pair]
                  (case (elem pair 0)
                   :ann nil :meta nil :params nil :pats nil :pat nil :attrs nil :exports nil
                   (walk (elem pair 1)))))))
             (erlang/is_list node) (do (step!) (Enum/each node walk))
             (erlang/is_tuple node) (do (step!) (Enum/each (erlang/tuple_to_list node) walk))))
          (sdk-namespace [namespace]
            (if (maps/is_key namespace (read :namespaces)) (maps/get namespace (read :namespaces))
             (let [source (when (string? namespace) (BeamLisp.Loader/source_path namespace))
                   fixed? (and (string? namespace) (BeamLisp.AOT/sdk_library_unit? namespace))
                   info (when fixed?
                          ;; Initialize the unit before reading its current
                          ;; descriptor, but never all its function bodies.
                          (when-not (maps/is_key namespace (read :initialized))
                           (BeamLisp.Env/load_sdk_library! namespace)
                           (write! :initialized (maps/put namespace true (read :initialized))))
                          (let [content (when source (BeamLisp.Loader/read_source source))
                                definitions (BeamLisp.Env/ns_defs namespace)
                                shim (BeamLisp.Emit/module_for namespace)
                                row (when-not source (BeamLisp.AOT/sdk_compiler_row shim inventory))
                                requires (if content (second (BeamLisp.SourceGraph/header content)) (:requires row))
                                _ (when-not (erlang/is_list requires)
                                    (throw (ex-info "SDK readiness requires complete unit metadata"
                                             {:kind :sdk-readiness-unit-metadata-required :namespace namespace})))
                                routes (Enum/reduce definitions {}
                                 (fn [pair out]
                                  (Enum/reduce (elem pair 1) out
                                   (fn [entry out]
                                    (let [clause (elem entry 3)
                                          body (when (> (erlang/tuple_size entry) 4) (elem entry 4))]
                                     (Enum/reduce (list shim body) out
                                      (fn [module out]
                                       (if module
                                        (maps/put (tuple module (elem entry 2) (count (field clause :params))) (elem pair 0) out)
                                        out))))))))
                                definition-map (Map/new definitions)
                                generation (BeamLisp.Env/sdk_namespace_generations (list namespace))]
                           {:definitions definition-map :routes routes :generation generation
                            :source-input (if content {:path source :sha (crypto/hash :sha256 content)}
                                             {:path nil :image? true})
                            :requires requires}))]
              (write! :namespaces (maps/put namespace info (read :namespaces))) info)))
          (module-namespace [module]
            (if (maps/is_key module (read :modules)) (maps/get module (read :modules))
             (let [row (when (erlang/is_atom module)
                         (BeamLisp.AOT/sdk_compiler_row module inventory))
                   source (:source row)
                   path (when source (BeamLisp.AOT/sdk_unit_source_path (elem inventory 0) source))
                   namespace (if (and path (File/regular? path))
                               (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source path))
                               ;; Derived from the authenticated artifact bytes,
                               ;; even when the module has not been loaded yet.
                               ;; Never infer a namespace from a filename.
                               (:unit-namespace row))]
              (write! :modules (maps/put module namespace (read :modules))) namespace)))]
   (let [fixed-name? (fn [namespace]
                       (and (string? namespace) (BeamLisp.AOT/sdk_library_unit? namespace)))
         canonical (Enum/reduce (to-list roots) []
          (fn [target output]
           (let [kind (first target)
                 namespace (case kind :binding (second target) :namespace (second target)
                             :remote (module-namespace (second target)) nil)]
            (if-not (fixed-name? namespace) output
             (let [info (sdk-namespace namespace)
                   binding (when (= :remote kind)
                             (maps/get (tuple (second target) (nth target 2) (nth target 3)) (field info :routes) nil))]
              (conj output (if binding [:binding namespace binding] target)))))))
         bound-namespaces (set (map second (filter #(= :binding (first %)) canonical)))
         ;; Cold global reads and warm compiler remotes denote the same SDK
         ;; binding. A loader readiness guard adds no dependency beside it.
         roots (vec (sort (set (remove
                  #(and (= :namespace (first %)) (contains? bound-namespaces (second %))) canonical))))
         key [(elem inventory 0) compiler-key (or image-key :source-checkout) roots]
         cached (get @closures key)]
    (if (closure-current? cached)
     true
     (do
      (Enum/each roots enqueue!)
   (loop []
    (when (seq (read :pending))
     (step!)
     (let [target (erlang/hd (read :pending)) key (target-key target)]
      (write! :pending (erlang/tl (read :pending)))
      (write! :queued (maps/remove key (read :queued)))
      (when-not (maps/is_key key (read :seen))
       (write! :seen (maps/put key true (read :seen)))
       (case (first target)
        :namespace (let [info (sdk-namespace (second target))]
                     (doseq [dependency (:requires info)] (enqueue! [:namespace dependency])))
        :binding
         (let [[_ namespace binding] target info (sdk-namespace namespace)
               entries (when info (maps/get binding (field info :definitions) nil))]
          (if (seq entries)
           (doseq [entry entries]
            (let [clause (elem entry 3)] (walk (field clause :guard)) (walk (field clause :body))))
           ;; Protocol/type values and compiler-created method closures have
           ;; no namespace defn row. Their verified unit header is the bounded
           ;; dependency witness; never treat a missing row as an empty body.
           (doseq [dependency (:requires info)] (enqueue! [:namespace dependency]))))
        :remote
         (let [[_ module function arity] target namespace (module-namespace module)
               info (when namespace (sdk-namespace namespace))
               binding (when info (maps/get (tuple module function arity) (field info :routes) nil))]
          (if binding (enqueue! [:binding namespace binding])
           (doseq [dependency (:requires info)] (enqueue! [:namespace dependency]))))
        nil)))
     (recur)))
      ;; This memo is dependency DATA, never invocation/lifetime authority.
      ;; SDK source/byte validation still runs before every preparation, and
      ;; each miss initializes through the ordinary verified SDK loader.
      (let [namespaces (vec (sort (maps/keys (read :initialized))))
            sources (Map/new (Enum/map namespaces
                        (fn [namespace]
                         (tuple namespace (field (maps/get namespace (read :namespaces)) :source-input)))))
            value {:namespaces namespaces :sources sources
                   :generations (BeamLisp.Env/sdk_namespace_generations (to-list namespaces))}]
       ;; Compare every descriptor snapshot after all own initializations.
       ;; Changes to any traversed input still decline this memo; publication
       ;; elsewhere no longer forces the next callback to repeat the cold walk.
       (when (and (= inventory (BeamLisp.AOT/sdk_inventory_input))
                  (= compiler-key (BeamLisp.AOTCache/compiler_key))
                  (descriptor-inputs-current? (read :namespaces))
                  (closure-current? value)
                  (= inventory (BeamLisp.AOT/sdk_inventory_input))
                  (= compiler-key (BeamLisp.AOTCache/compiler_key)))
        (swap! closures
         (fn [entries]
          (assoc (if (> (+ (count entries) 2) 128) {} entries) key value request-key value)))))
      true))))
   (finally (Process/delete frame)))))

(defn prepare!
 "Prepare genuine SDK dependencies, reusing the existing bounded closure only
  after rechecking actual provider Source, namespace versions and readiness.
  A repeated request need not rebuild the root's entire descriptor table just
  to discover that its authenticated dependency closure remains unchanged."
 [roots]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [inventory (BeamLisp.AOT/sdk_inventory_input)
       compiler-key (BeamLisp.AOTCache/compiler_key)
       image-key (when (elem inventory 1) (crypto/hash :sha256 (elem inventory 1)))
       request-key [:request (elem inventory 0) compiler-key (or image-key :source-checkout) roots]
       cached (get @closures request-key)]
  (if (and (closure-current? cached)
           (= inventory (BeamLisp.AOT/sdk_inventory_input))
           (= compiler-key (BeamLisp.AOTCache/compiler_key)))
   true
   (let [ready (prepare-closure! roots)]
    (when-not (and (= inventory (BeamLisp.AOT/sdk_inventory_input))
                   (= compiler-key (BeamLisp.AOTCache/compiler_key)))
     (throw (ex-info "SDK inputs changed during dependency preparation"
                     {:kind :sdk-readiness-input-changed})))
    ready))))
