; Exact graph execution and leases. A leaf shared by generation planning and
; immutable executable catalogues;never depends on datom/reload/source analysis.
(ns reload.execution)

(defn- refuse! [kind data]
 (throw (ex-info "Immutable generation refused" (assoc data :kind kind))))
(defn- with-lock [key action]
 (BeamLisp.Env/with_generation_lock (tuple :sealed-generation key) action))
(def ^:private prepared (atom {}))

;; One private preparation owner. A row may authenticate prepared code before
;; initialization completes, but only a ready row can be reused or published.
;; Runtime instances belong in this row, never in caller-mutable graph state.
(defn- prepared-generation* [key]
 (let [row (get @prepared key)]
  (when (contains? #{:prepared :instance-prepared :initializing :instance-initialized :instance-failed :ready}
                    (:phase row)) (:generation row))))

(defn cached-preparation [key]
 (BeamLisp.Env/assert_native_framework_execution!)
 (when-let [row (get @prepared key)]
  (if (= :ready (:phase row))
   (let [generation (:generation row)]
    (when (:retired @(:state generation)) (refuse! :retirement-pending {}))
    generation)
   (if (= :instance-failed (:phase row))
    (refuse! :instance-initialization-failed {})
   (if (and (erlang/is_pid (:owner row)) (Process/alive? (:owner row)))
    (refuse! :preparation-in-progress {})
    ;; Caller death is not evidence that initialized resources/code are gone.
    ;; Keep this bounded reservation until an actual lifecycle recovery exists.
    (refuse! :runtime-handover-required {:reason :abandoned-preparation}))))))

(defn preparation-limit [] 256)

(defn begin-preparation! [key]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [owner (erlang/self) limit (preparation-limit)]
  (swap! prepared
   (fn [rows]
    (when (contains? rows key) (refuse! :preparation-in-progress {}))
    (when (>= (count rows) limit) (refuse! :runtime-handover-required {:reason :preparation-capacity}))
    (assoc rows key {:phase :preparing :owner owner}))))
 :ok)

(defn record-prepared! [key generation]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [row (get @prepared key)]
  (when-not (and (= :preparing (:phase row)) (= (erlang/self) (:owner row))
                 (= key (:cache-key generation)))
   (refuse! :preparation-owner-changed {}))
  (swap! prepared assoc key {:phase :prepared :owner (erlang/self) :generation generation}))
 generation)

(defn complete-preparation! [key generation]
 (BeamLisp.Env/assert_native_framework_execution!)
 (with-lock key (fn []
 (let [row (get @prepared key)]
  (when-not (and (contains? #{:prepared :instance-initialized} (:phase row))
                 (= (erlang/self) (:owner row))
                 (erlang/== generation (:generation row)))
   (refuse! :preparation-owner-changed {}))
  (when (:retired @(:state generation)) (refuse! :retired-generation {}))
  ;; Factory initialization's accepted lease may drain after a retirement has
  ;; closed fresh admissions. Recheck native admission under the same generation
  ;; lock as retirement before declaring it ready. Pure Source construction has
  ;; no factory/instance yet; its existing completion adapter remains unchanged.
  (let [ticket (when (:factory row) (BeamLisp.Env/retain_generation_code! generation))]
   (try (swap! prepared assoc key (dissoc (assoc row :phase :ready) :owner))
    (finally (when ticket (BeamLisp.Env/release_code! ticket))))))))
 generation)

(defn abandon-preparation! [key]
 (BeamLisp.Env/assert_native_framework_execution!)
 (swap! prepared
  (fn [rows]
   (let [row (get rows key)]
    ;; Once a factory has entered, caller death or an exception cannot prove
    ;; its effects/callbacks/resources are gone. Only real retirement forgets it.
    (if (and (= (erlang/self) (:owner row))
             (contains? #{:preparing :prepared :instance-prepared} (:phase row)))
     (dissoc rows key) rows))))
 :ok)

(defn ready-prepared! [generation]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [row (get @prepared (:cache-key generation))]
  (when-not (and (= :ready (:phase row)) (erlang/== generation (:generation row)))
   (refuse! :unready-prepared-generation {})))
 generation)

(defn prepare-instance!
 "Freeze canonical factory selection in this original preparation before any
  initializer can run. Metadata grants no native admission. Only the existing
  preparation owner may attach it; no supplied callback becomes executable."
 [generation module exports]
 (BeamLisp.Env/assert_native_framework_execution!)
 (BeamLisp.CompilerData/check_first_order! exports
   {:max-nodes 16384 :max-bytes 1048576 :max-depth 64})
 (when-not (and (erlang/is_atom module) (not (contains? #{nil true false} module))
                (erlang/is_list exports)
                (every? BeamLisp.CompilerData/binding_reference? exports))
  (refuse! :invalid-instance-factory {}))
 (let [expected (into {} (map (fn [reference] [reference true]) exports))
       key (:cache-key generation) row (get @prepared key)]
  (when-not (= (count exports) (count expected)) (refuse! :invalid-instance-factory {}))
  (when-not (and (= :prepared (:phase row)) (= (erlang/self) (:owner row))
                 (erlang/== generation (:generation row)))
   (refuse! :preparation-owner-changed {}))
  (swap! prepared assoc key (assoc row :phase :instance-prepared
                                  :factory {:module module :exports expected})))
 generation)

(defn- checked-instance! [instance expected]
 ;; Inspect the raw map only. No user sequence, callable, Atom, class constructor
 ;; or serialization is executed to validate the factory's result envelope.
 (when-not (and (erlang/is_map instance) (= 4 (erlang/map_size instance))
                (= 1 (:version instance)) (= :contextual-unit-instance (:kind instance))
                (erlang/is_function (:entry instance) 0) (erlang/is_map (:exports instance))
                (= (erlang/map_size expected) (erlang/map_size (:exports instance)))
                (every? (fn [key] (erlang/is_map_key key expected)) (maps/keys (:exports instance))))
  (refuse! :invalid-unit-instance {}))
 instance)

(defn initialize-instance!
 "Run the frozen zero-argument factory once under actual native graph custody.
  Save only a validated instance in the existing private row. Reentry/foreign
  execution refuses before user code; failure retains its original preparation
  for real retirement and cannot be turned into a fresh initializer attempt."
 [generation]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [key (:cache-key generation) row (get @prepared key)]
  (when-not (erlang/== generation (:generation row)) (refuse! :unattested-prepared-generation {}))
  (when (:retired @(:state generation)) (refuse! :retired-generation {}))
  (cond
   (and (:instance row) (contains? #{:instance-initialized :ready} (:phase row))) generation
   (= :instance-failed (:phase row)) (refuse! :instance-initialization-failed {})
   :else
    (do
     (when-not (and (= :instance-prepared (:phase row)) (= (erlang/self) (:owner row)))
      (refuse! :preparation-owner-changed {}))
     ;; No preparation/serving lock is held while Source runs. A competing
     ;; initializer sees this private reservation and cannot execute the body.
     (swap! prepared assoc key (assoc row :phase :initializing))
     (try
      (with! generation
       (fn []
        (let [instance
               ;; The application-owned factory starts its own Source ingress;
               ;; an SDK closure must never impersonate an owned Source body.
               (BeamLisp.Env/invoke_generation_factory! (get-in row [:factory :module]))
              checked (checked-instance! instance (get-in row [:factory :exports]))]
         ;; Keep the actual native lease through validation and private commit;
         ;; retirement cannot forget this row between execution and publication.
         (swap! prepared assoc key (assoc row :phase :instance-initialized :instance checked))
         generation)))
      (catch error
       ;; Admission/unwind can fail outside the retained callback. Never restore
       ;; a row already removed by real retirement, or replace a later instance.
       (swap! prepared
        (fn [rows]
         (let [current (get rows key)]
          (if (and (= :initializing (:phase current)) (= (erlang/self) (:owner current))
                   (erlang/== generation (:generation current)))
           (assoc rows key (assoc row :phase :instance-failed)) rows))))
       (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__)))))))

(defn prepare-captured-unit!
 "Prepare one activation from the native Loader's complete captured unit.
  Passive membership/target validation precedes code publication. The result is
  an original application preparation, never an SDK grant. No initializer runs.
  Code bytes may be shared; each activation has its own scope and private row."
 [verified]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [members (BeamLisp.AOT/contextual_unit_members! verified)
       metadata (:metadata members) beam (get-in members [:runtime :beam]) module (elem beam 0)
       runtime-image (BeamLisp.AOT/runtime_image_key)
       digest (Base/encode16 (crypto/hash :sha256
                (erlang/term_to_binary (tuple (:manifest verified) metadata (crypto/hash :sha256 (elem beam 1)))
                                      (list :deterministic))) (list (tuple :case :lower)))]
  (when-not (= runtime-image (:runtime-image metadata)) (refuse! :compiled-runtime-image-changed {}))
  ;; Fixed SDK inventory/MFAs are frozen before application bytes are loaded.
  ;; No caller metadata, namespace spelling or runtime-floor label substitutes.
  (BeamLisp.Env/ensure_sdk_runtime!)
  (BeamLisp.AOT/passive_binary_functions! module (elem beam 1))
  (let [scope (BeamLisp.Env/fork)
        key [(BeamLisp.Env/env_id) :contextual-unit digest scope]]
   (try
    (begin-preparation! key)
    (let [lease (BeamLisp.Env/retain_exact_binary! beam "captured-contextual-unit.beam")]
     (try
      (let [context (BeamLisp.Env/with_env scope #(assoc (BeamLisp.Env/capture) :generation nil))
            generation {:digest digest :scope scope :context context :modules [module] :mapping {}
                        :resources {} :protocols {} :application-id (str "unit/" digest)
                        :native-modules #{"erlang"} :source-ingress-version 1
                        :classes #{} :server-classes #{} :actor-inputs {} :registries {} :declarations {} :callables {}
                        :state (atom {:retired false :tickets {} :slots #{}}) :cache-key key}]
       (record-prepared! key generation)
       (prepare-instance! generation module (:exports metadata))
       (BeamLisp.Env/register_source_profile! generation)
       generation)
      (finally (BeamLisp.Env/release_code! lease))))
    (catch error
     ;; Preparation has executed no application code. Leave shared immutable
     ;; code loaded; deleting a physical module could invalidate another graph.
     (abandon-preparation! key)
     (BeamLisp.Env/destroy scope)
     (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))))

(defn- instance-ready! [generation]
 (ready-prepared! generation)
 (let [instance (:instance (get @prepared (:cache-key generation)))]
  (when-not instance (refuse! :uninitialized-unit-instance {})) instance))

(defn invoke-instance-entry!
 "Invoke the captured entry result in its original graph; never rerun the
  initialization schedule or resolve a mutable namespace binding."
 [generation]
 (BeamLisp.Env/assert_native_framework_execution!)
 (with! generation #(BeamLisp.Env/invoke_generation_value! (:entry (instance-ready! generation)) (list))))

(defn invoke-instance-binding!
 "Invoke one canonical export from this private ready instance. No string/name
  resolver or alternate environment lookup can substitute a different binding."
 [generation reference args]
 (BeamLisp.Env/assert_native_framework_execution!)
 (with! generation
  (fn []
   (let [exports (:exports (instance-ready! generation))]
    (when-not (erlang/is_map_key reference exports) (refuse! :unsealed-entrypoint {}))
    (BeamLisp.Env/invoke_generation_value! (get exports reference) (BeamLisp.CompilerData/eager_to_list args))))))


(defn prepared-generation
 "Framework-only projection of the original private preparation; never a grant."
 [key]
 (BeamLisp.Env/assert_native_framework_execution!)
 (prepared-generation* key))

(defn forget-preparation!
 "Remove only this exact preparation after fixed owner cleanup. A later instance
  occupying the same reusable plan key survives a lost/repeated cleanup reply."
 [generation]
 (BeamLisp.Env/assert_native_framework_execution!)
 (swap! prepared
  (fn [all]
   (if (erlang/== generation (:generation (get all (:cache-key generation))))
    (dissoc all (:cache-key generation)) all)))
 :ok)

(defn attested-prepared!
 "Read-only exact private preparation-cache identity for trusted framework
  enrollment. A copied/edited map, caller state, digest/resources flag or live
  namespace cannot manufacture this receipt. This does not grant execution,
  root ownership, runtime inheritance or publication authority."
 ([generation] (attested-prepared! generation false))
 ([generation allow-retired?]
 (when-not (and (or (= true allow-retired?) (= false allow-retired?))
                (erlang/is_map generation)
                (erlang/== generation (prepared-generation* (:cache-key generation)))
                (or allow-retired? (not (:retired @(:state generation)))))
  (refuse! :unattested-prepared-generation {}))
 generation))

(defn current
 "Selected graph in this execution;identity alone does not confer a lease."
 [] (Process/get :bl_generation))

(defn frame
 "Read-only native frame/parent IDs. Captured or bound data cannot create one."
 [] (BeamLisp.Env/execution_frame_observation))
(defn selected-graph-id
 "The actual admitted selected graph's opaque identity, or nil when unmanaged."
 [] (BeamLisp.Env/selected_execution_graph_id))
(defn graph-field
 "Bounded scalar observation of the actual selected graph. No map selector."
 [field] (BeamLisp.Env/selected_execution_graph_field field))

(defn acquire! [generation]
 (with-lock (:cache-key generation)
  (fn []
   (let [row (get @prepared (:cache-key generation))]
    (when-not (and (erlang/== generation (:generation row))
                   (or (= :ready (:phase row))
                       (and (= :initializing (:phase row)) (= (erlang/self) (:owner row)))))
     (refuse! :unready-prepared-generation {})))
   (when (:retired @(:state generation)) (refuse! :retired-generation {}))
   (let [ticket (BeamLisp.Env/retain_generation_code! generation)]
    (swap! (:state generation) assoc-in [:tickets ticket] (erlang/self)) ticket))))

(defn release-ticket! [generation ticket]
 (with-lock (:cache-key generation)
  (fn [] (BeamLisp.Env/release_code! ticket)
         (swap! (:state generation) update :tickets dissoc ticket) :ok)))

(defn- executing? [generation]
 ;; The native admitted frame owns this fact. Public graph/context data and
 ;; Source process-dictionary markers cannot establish execution custody.
 (and (map? generation) (BeamLisp.Env/executing_generation? generation)))

(defn owned?
 "Whether this process holds the native execution boundary for
  its selected graph. Conveyed/bound identity alone does not confer ownership."
 [] (executing? (current)))

(defn execute
 ([generation action]
 ;; This admitted native execution frame must restore its complete native
 ;; context. The public env facade intentionally gives Source a restricted token.
 (let [previous (BeamLisp.Env/capture)]
  (try
   (BeamLisp.Env/bind (:context generation))
   (Process/put :bl_generation generation)
   (BeamLisp.Env/with_owned_generation_execution action)
   (finally (BeamLisp.Env/bind previous)))))
 ([generation action ticket]
  (BeamLisp.Env/with_owned_code_execution ticket #(execute generation action))))

(defn invoke-entry [generation entry args]
 ;; These immutable bindings were fetched after compilation/validation in the
 ;; graph's private environment. Retention/context checks remain at admission;
 ;; a cached function is never authority to execute a retired graph.
 (if-let [f (get (:callables generation) entry)]
  (apply f args)
  (let [parts (String/split entry "/") name (get (:mapping generation) (first parts))]
   (when-not (and name (= 2 (count parts))) (refuse! :unsealed-entrypoint {:entrypoint entry}))
   (let [result (BeamLisp.Env/fetch_exact name (second parts))]
    (when-not (and (erlang/is_tuple result) (= :ok (elem result 0)))
     (refuse! :missing-entrypoint {:entrypoint entry}))
    (apply (elem result 1) args)))))

(defn with!
 "Trusted framework execution against a prepared graph, without publication.
  Keeps returned domain callbacks safe only while action runs; delayed users
  must capture! a registration. The caller cannot replace serving policy."
 [generation action]
 (let [ticket (acquire! generation)]
  (try (execute generation action ticket)
       (finally (release-ticket! generation ticket)))))

(defn invoke!
 "Invoke sealed code with its graph/context. A nested named call inside an
  already-owned execution preserves dynamic bindings and reuses that lease.
  An explicit with! remains a new framework context boundary."
 [generation entry args]
 (if (executing? generation) (invoke-entry generation entry args)
  (with! generation #(invoke-entry generation entry args))))


; Registered BL classes have nominal code identity, including inside native raw
; collections and mutable cells. A registry row alone never grants SDK identity.
(defn- class-evidence [generation module proofs]
 (if-let [cached (get proofs module)] [cached proofs 0]
  (let [info (BeamLisp.Record/info module)
        registered? (and (erlang/is_tuple info) (= 4 (erlang/tuple_size info)))
        app? (and registered? generation (contains? (:classes generation #{}) module))
        sdk? (and registered? (not app?) (BeamLisp.AOT/sdk_generated_class? module))
        entry {:info info :registered? registered? :permitted? (or app? sdk?)}]
   [entry (assoc proofs module entry) (if (and registered? (not app?)) 1 0)])))

(defn runtime-inspection
 "Bounded point-in-time raw observation of nonexecutable runtime values. It
  never enumerates domain sequences/queries, invokes user code or returns values.
  Registered classes must be admitted by this exact graph or independently
  attested fixed SDK classes. Mutable aliases can change after this observation;
  native resources/actors remain separate owned-lifetime/migration obligations."
 [generation bindings]
 (try
  (loop [todo (list (tuple :value bindings 0)) left 100000 visited 0 proofs {}
         sdk-checks 0 mutable-cells 0 opaque-handles 0]
   (if (empty? todo)
    {:status :valid :nodes visited :class-checks (count proofs) :sdk-checks sdk-checks
     :mutable-cells mutable-cells :opaque-handles opaque-handles}
    (let [task (first todo) rest-todo (rest todo) mode (elem task 0)]
     (case mode
      :map
       (let [entry (maps/next (elem task 1)) depth (elem task 2)]
        (if (= :none entry)
         (recur rest-todo left visited proofs sdk-checks mutable-cells opaque-handles)
         (recur (cons (tuple :value (elem entry 0) depth)
                 (cons (tuple :value (elem entry 1) depth)
                  (cons (tuple :map (elem entry 2) depth) rest-todo)))
                left visited proofs sdk-checks mutable-cells opaque-handles)))
      :tuple
       (let [v (elem task 1) index (elem task 2) depth (elem task 3)]
        (if (> index (erlang/tuple_size v))
         (recur rest-todo left visited proofs sdk-checks mutable-cells opaque-handles)
         (recur (cons (tuple :value (erlang/element index v) depth)
                 (cons (tuple :tuple v (inc index) depth) rest-todo))
                left visited proofs sdk-checks mutable-cells opaque-handles)))
      :list
       (let [items (elem task 1) depth (elem task 2)]
        (cond
         (= (list) items) (recur rest-todo left visited proofs sdk-checks mutable-cells opaque-handles)
         (not (erlang/is_list items)) {:status :refused :kind :invalid-runtime-value}
         :else (recur (cons (tuple :value (erlang/hd items) depth)
                         (cons (tuple :list (erlang/tl items) depth) rest-todo))
                      left visited proofs sdk-checks mutable-cells opaque-handles)))
      :value
       (let [v (elem task 1) depth (elem task 2) next-left (dec left)]
        (cond
         (or (neg? next-left) (> depth 128)) {:status :refused :kind :runtime-value-budget}
         (erlang/is_function v) {:status :refused :kind :invalid-runtime-value}
         (or (and (erlang/is_map v)
                  (contains? #{:Elixir.BeamLisp.LazySeq :Elixir.BeamLisp.Delay
                               :Elixir.BeamLisp.Derived :Elixir.BeamLisp.Future :Elixir.BeamLisp.Promise}
                             (maps/get :__struct__ v nil)))
             (and (erlang/is_tuple v) (= 3 (erlang/tuple_size v)) (= :$transient (elem v 0))))
          ;; These hide latent code or mutable contents behind an opaque cell.
          ;; Keep them with their owned old callback/task and drain explicitly;
          ;; never force them to make an inheritance snapshot appear safe.
          {:status :refused :kind :opaque-runtime-continuation}
         (and (erlang/is_tuple v) (= 3 (erlang/tuple_size v)) (= :$blfn (elem v 0)))
          {:status :refused :kind :invalid-runtime-value}
         (or (and (erlang/is_map v) (erlang/is_map_key :__struct__ v))
             (and (erlang/is_tuple v) (= 3 (erlang/tuple_size v)) (= :bl_deftype (elem v 0))))
          (let [record? (erlang/is_map v) module (if record? (erlang/map_get :__struct__ v) (elem v 1))
                [evidence next-proofs checks] (class-evidence generation module proofs)
                info (:info evidence) registered? (:registered? evidence)
                valid? (if record?
                         (or (not registered?)
                          (and (= :record (elem info 0)) (:permitted? evidence)
                               (every? #(erlang/is_map_key % v) (elem info 3))))
                         (and registered? (= :deftype (elem info 0)) (:permitted? evidence)
                              (erlang/is_tuple (elem v 2)) (= (count (elem info 3)) (erlang/tuple_size (elem v 2)))))
                cell? (and record? (contains? #{:Elixir.BeamLisp.Atom :Elixir.BeamLisp.Volatile} module))]
           (if-not valid? {:status :refused :kind :foreign-generation-runtime-value}
            (recur (cons (if cell?
                           ;; Only the fixed native Atom read is allowed. No
                           ;; delay/future/derived/Enumerable protocol executes.
                           (tuple :value (BeamLisp.Refs/deref v) (inc depth))
                           (if record? (tuple :map (maps/iterator v) (inc depth))
                                       (tuple :tuple v 1 (inc depth)))) rest-todo)
                   next-left (inc visited) next-proofs (+ sdk-checks checks)
                   (+ mutable-cells (if cell? 1 0)) opaque-handles)))
         (erlang/is_map v)
          (recur (cons (tuple :map (maps/iterator v) (inc depth)) rest-todo)
                 next-left (inc visited) proofs sdk-checks mutable-cells opaque-handles)
         (erlang/is_tuple v)
          (recur (cons (tuple :tuple v 1 (inc depth)) rest-todo)
                 next-left (inc visited) proofs sdk-checks mutable-cells opaque-handles)
         (erlang/is_list v)
          (recur (cons (tuple :list v (inc depth)) rest-todo)
                 next-left (inc visited) proofs sdk-checks mutable-cells opaque-handles)
         :else (recur rest-todo next-left (inc visited) proofs sdk-checks mutable-cells
                      (+ opaque-handles (if (or (erlang/is_pid v) (erlang/is_reference v) (erlang/is_port v)) 1 0)))))
      {:status :refused :kind :invalid-runtime-value}))))
  (catch _ {:status :refused :kind :invalid-runtime-value})))

(defn- require-runtime-values! [generation bindings]
 (let [observed (runtime-inspection generation bindings)]
  (when-not (= :valid (:status observed))
   (refuse! (if (contains? #{:foreign-generation-runtime-value :opaque-runtime-continuation} (:kind observed))
               (:kind observed) :invalid-runtime-bindings)
            {:contract "runtime.classes"})) :ok))

(defn check-runtime!
 "Mandatory point-in-time class check before owner/source publication. It
  changes no bindings, retags no data, traverses no domain query and cannot
  freeze later raw Atom aliases. Owner/resource migration remains separate."
 [generation]
 (when-let [runtime (:runtime @(:state generation))]
  (when-not (Process/alive? (:owner runtime)) (refuse! :missing-runtime-resource {}))
  (require-runtime-values! generation (:values runtime))) :ok)

(defn runtime-value?
 "Bounded nonexecutable data/handles with registered BL class identity checks.
  An opaque native handle is not proof that its backing data was migrated."
 [value] (= :valid (:status (runtime-inspection (current) value))))

(defn bind-runtime!
 "Bind initializer-owned live handles once in this generation. Unlike sealed
  resources these handles do not enter artifact identity. The lifecycle caller
  owns their cleanup and native store/process validation. Call while initializing,
  before publication; no global fallback and no executable callbacks in bindings."
 [bindings]
 (let [generation (current)]
  (when-not (and generation (map? bindings))
   (refuse! :invalid-runtime-bindings {}))
  (with-lock (:cache-key generation)
   (fn []
    (let [state @(:state generation) previous (:runtime state)]
     (when (or (:retired state) (seq (:slots state)))
      (refuse! :runtime-bindings-closed {}))
     (require-runtime-values! generation bindings)
     (if previous
      (if (and (= (erlang/self) (:owner previous)) (= bindings (:values previous))) :already-bound
       (refuse! :runtime-binding-conflict {}))
      (do (swap! (:state generation) assoc :runtime {:owner (erlang/self) :values bindings}) :bound)))))))

(defn runtime-bound?
 "Whether this graph has initializer bindings whose original owner is alive.
  Does not expose handles, authorize inheritance or acquire a serving lease."
 [generation]
 (let [state @(:state generation) runtime (:runtime state)]
  (boolean (and runtime (not (:retired state)) (Process/alive? (:owner runtime))))))

(defn runtime-owner
 "Read the live initializer lifetime for the currently selected graph. This is
  an observation, not inheritance, execution or migration authority."
 []
 (let [generation (current) state (when generation @(:state generation)) runtime (:runtime state)]
  (when (and runtime (not (:retired state)) (Process/alive? (:owner runtime)))
   (:owner runtime))))

(defn inherit-runtime!
 "Explicitly share initializer-owned handles with an unpublished candidate.
  Only their original live owner may authorize this; actors are not restarted,
  resource ownership is not transferred, and no product global is consulted."
 [candidate previous]
 (let [graphs (sort-by #(pr-str (:cache-key %)) [candidate previous])]
  (with-lock (:cache-key (first graphs))
   (fn [] (with-lock (:cache-key (second graphs))
    (fn []
     (let [target @(:state candidate) source @(:state previous) runtime (:runtime source)]
      (when-not (and runtime (= (erlang/self) (:owner runtime)) (Process/alive? (:owner runtime))
                     (not (:retired source)) (not (:retired target)) (empty? (:slots target))
                     (= (:application-id candidate) (:application-id previous)))
       (refuse! :runtime-inheritance-refused {}))
      ;; Validate BEFORE touching candidate bindings. Matching fields never
      ;; silently retag nominal old code identities into a new generation.
      (require-runtime-values! candidate (:values runtime))
      (if (:runtime target)
       (if (= (:runtime target) runtime) :already-bound (refuse! :runtime-binding-conflict {}))
       (do (swap! (:state candidate) assoc :runtime runtime) :inherited)))))))))

(defn runtime-resource
 "Read a live handle owned by this generation's initializer. Owner death,
  retired graph and missing binding fail closed, including conveyed callbacks."
 [key]
 (let [generation (current) state (when generation @(:state generation)) runtime (:runtime state)]
  (when-not (and runtime (not (:retired state)) (Process/alive? (:owner runtime))
                (contains? (:values runtime) key))
   (refuse! :missing-runtime-resource {:resource key}))
  (get (:values runtime) key)))

