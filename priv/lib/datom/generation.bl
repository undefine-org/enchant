;; Generation custody shared by ordinary storage opens. Foundry remains the
;; authority for release selection and admission; this API grants no writes.
(ns datom.generation
 (:require [datom.offline.fs :as fs] [datom.offline.journal :as journal]
           [datom.offline.manifest :as manifest] [datom.offline.layout :as l]))
(defrecord Owner [handle root app])
(defn- result! [value]
 (when (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value)) (= :error (elem value 0)))
  (throw (ex-info "Generation ownership refused" {:kind :generation-ownership-refused}))) value)
(defn claim!
 "Retain independent app/data root claims and every closed declared store.
  Ordinary Fjall opens join this owner as logical readers. No flag or receipt
  permits writes; durable Foundry admission remains a separate prerequisite."
 [app root spec]
 (BeamLisp.Env/assert_native_framework_execution!)
 (manifest/validate! spec)
 (let [raw (journal/read-file root ".bl-generation" 1048576)
       marker (when raw (Jason/decode! raw))
       ready-raw (journal/read-file root "READY.json" journal/LIMIT)
       ready (when ready-raw (Jason/decode! ready-raw))]
  (when-not (and (= #{"version" "protocol" "generation" "ready" "keyFormat" "dataVersion"} (set (keys marker)))
                 (erlang/=:= 1 (get marker "version")) (= "datom-generation-v1" (get marker "protocol"))
                 (erlang/=:= 2 (:key-format spec)) (erlang/=:= 2 (get marker "keyFormat"))
                 (erlang/=:= (:data-version spec) (get marker "dataVersion"))
                 (= (get marker "generation") (get ready "generation"))
                 (journal/digest? (get marker "generation")) (= (get marker "ready") (l/digest ready))
                 (= "datom-offline-root-v1" (get ready "protocol"))
                 (= (:application spec) (get ready "application"))
                 (= (:path root) (get ready "destination"))
                 (= (l/digest (assoc spec :key-format 1)) (get ready "manifest")))
   (throw (ex-info "Generation marker does not bind the declared prepared root" {:kind :generation-identity-mismatch})))
  (->Owner (result! (BeamLisp.Native.Datom.StoreFjall/fjall_generation_claim
                     (:handle app) (:handle root) raw (to-list (mapv :path (:stores spec))))) root app)))
(defn release!
 "Refuse early release while any native store handle retains this owner."
 [owner]
 (BeamLisp.Env/assert_native_framework_execution!)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_generation_release (:handle owner))))
