;; Generation custody shared by ordinary storage opens. Foundry remains the
;; authority for release selection and durable write admission.
(ns datom.generation
 (:require [datom.offline.fs :as fs] [datom.offline.journal :as journal]
           [datom.offline.manifest :as manifest] [datom.offline.layout :as l]
           [datom.offline.tool :as tool] [datom.codec :as codec]))
(defrecord Owner [handle root app])
(defn- result! [value]
 (when (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value)) (= :error (elem value 0)))
  (throw (ex-info "Generation ownership refused" {:kind :generation-ownership-refused}))) value)
(defn claim!
 "Retain independent app/data root claims and every closed declared store.
  Ordinary Fjall opens join this owner as logical readers. No flag or receipt
  permits writes; durable Foundry admission remains a separate prerequisite."
 [app root spec]
 (BeamLisp.Env/assert_native_framework_execution!)
 (manifest/validate! spec)
 (let [raw (journal/read-file root ".bl-generation" 1048576)
       marker (when raw (Jason/decode! raw))
       ready-raw (journal/read-file root "READY.json" journal/LIMIT)
       ready (when ready-raw (Jason/decode! ready-raw))]
  (when-not (and (= #{"version" "protocol" "generation" "ready" "keyFormat" "dataVersion"} (set (keys marker)))
                 (erlang/=:= 1 (get marker "version")) (= "datom-generation-v1" (get marker "protocol"))
                 (erlang/=:= 2 (:key-format spec)) (erlang/=:= 2 (get marker "keyFormat"))
                 (erlang/=:= (:data-version spec) (get marker "dataVersion"))
                 (= (get marker "generation") (get ready "generation"))
                 (journal/digest? (get marker "generation")) (= (get marker "ready") (l/digest ready))
                 (= "datom-offline-root-v1" (get ready "protocol"))
                 (= (:application spec) (get ready "application"))
                 (= (:path root) (get ready "destination"))
                 (= (l/digest (assoc spec :key-format 1)) (get ready "manifest")))
   (throw (ex-info "Generation marker does not bind the declared prepared root" {:kind :generation-identity-mismatch})))
  (->Owner (result! (BeamLisp.Native.Datom.StoreFjall/fjall_generation_claim
                     (:handle app) (:handle root) raw ready-raw (to-list (mapv :path (:stores spec)))
                     (to-list (mapv #(get-in % [:blobs :path]) (:stores spec))))) root app)))
(defn release!
 "Refuse early release while any native store handle retains this owner."
 [owner]
 (BeamLisp.Env/assert_native_framework_execution!)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_generation_release (:handle owner))))

(defn admit!
 "Join Foundry's actual root-owned activation.json beside the fixed writer
  root. The native boundary verifies the selected code/runtime/generation and
  syncs the journal before permitting writes. No option or copied record grants
  admission. Initial activation is restart-only."
 [owner]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [journal (fs/claim! (Path/dirname (:path (:app owner))) {:readonly true})]
  (try
   (result! (BeamLisp.Native.Datom.StoreFjall/fjall_generation_admit
               (:handle owner) (:handle journal) (tool/identity!)))
   (finally (fs/close! journal)))))


(defn status!
 "Observe the actual native owner. Copied record paths/flags are not evidence.
  This is observation only; admit! still requires Foundry's durable decision."
 [owner]
 (Jason/decode! (result! (BeamLisp.Native.Datom.StoreFjall/fjall_generation_status (:handle owner)))))

(defn- observation [observed]
 (let [selected (get observed "dataGeneration") admitted (get observed "writesAdmitted")
       compatible (= codec/INDEX-VERSION (get selected "keyFormat"))]
  {"version" 1 "status" (if admitted "write-admitted" (if compatible "read-only-ready" "read-only"))
   "selection" (l/digest selected) "writesAdmitted" admitted
   "runtimeKeyFormat" codec/INDEX-VERSION "keyFormat" (get selected "keyFormat")
   "dataVersion" (get selected "dataVersion") "generation" (get selected "generation")
   "code" (get selected "code") "runtime" (get selected "runtime")}))
(defn observe!
 "Read-only health projection of the actual native owner; grants no authority."
 [owner] (observation (status! owner)))
(defn readiness!
 "Attest the selected SDK cohort before the controller admits writes. A
  format1 SDK cannot report a format2 candidate ready."
 [owner]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [observed (status! owner)]
  (when-not (= (tool/identity!) (get-in observed ["dataGeneration" "runtime"]))
   (throw (ex-info "Prepared generation requires its compatible runtime cohort" {:kind :generation-runtime-mismatch})))
  (observation observed)))

(defn open-selected!
 "Read the existing activation journal and claim exactly its prepared pair.
  READY carries the closed storage inventory; no application callback runs and
  no missing path is created. A grant is never inferred from this return value."
 [state-dir]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [state (fs/claim! state-dir {:readonly true})
       record (try
               (let [raw (journal/read-file state "activation.json" 1048576)]
                (when-not raw (throw (ex-info "No selected generation" {:kind :generation-selection-required})))
                (let [info (File/lstat! (str state-dir "/activation.json"))]
                 (when-not (and (= :regular (:type info)) (= 0 (:uid info))
                                (zero? (erlang/band (:mode info) 18)))
                  (throw (ex-info "Unprotected activation record" {:kind :generation-selection-required}))))
                (Jason/decode! raw))
               (finally (fs/close! state)))
       selected (get record "dataGeneration")]
  (when-not (and (erlang/=:= 1 (get record "version")) (map? selected)
                 (int? (get record "journalRevision")) (<= 1 (get record "journalRevision") 9223372036854775807)
                 (or (erlang/=:= false (get record "writesAdmitted")) (erlang/=:= true (get record "writesAdmitted")))
                 (contains? #{"starting" "read-only-ready" "write-admitted" "verified"} (get record "phase"))
                 (= (str state-dir "/writer") (get selected "writerRoot")))
   (throw (ex-info "Activation has no runnable generation selection" {:kind :generation-selection-required})))
  (let [app (fs/claim! (get selected "writerRoot"))]
   (try
    (let [root (fs/claim! (get selected "root"))]
     (try
      (let [ready (Jason/decode! (journal/read-file root "READY.json" journal/LIMIT))
            spec (manifest/from-document! (get ready "storage"))
            owner (claim! app root (assoc spec :key-format 2))]
       (try
        (when-not (and (erlang/=:= selected (get (status! owner) "dataGeneration"))
                       (= (get record "candidateReleaseId") (get selected "code"))
                       (erlang/=:= (get record "dataVersion") (get selected "dataVersion")))
         (throw (ex-info "Actual native generation differs from activation" {:kind :generation-selection-mismatch})))
        owner
        (catch error (release! owner) (throw error))))
      (catch error (fs/close! root) (throw error))))
    (catch error (fs/close! app) (throw error))))))
