;; Derive the converter identity from the selected SDK, never a supplied flag.
(ns datom.offline.tool
 (:require [datom.store-fjall :as fj] [datom.offline.layout :as l]))
(defn identity!
 "Complete fixed coordinator SDK closure plus the actual selected Fjall NIF
  bytes. Compiler closure identity alone omits optional native library bodies."
 []
 (BeamLisp.Env/assert_native_framework_execution!)
 (when-not (fj/available?) (l/refuse! :offline-tool-unavailable))
 (let [library (BeamLisp.AOT/selected_sdk_native_library!
                "datom.store-fjall" :Elixir.BeamLisp.Native.Datom.StoreFjall nil)]
  (when-not (string? library) (l/refuse! :offline-tool-unavailable))
  (let [file (str library ".so") size (:size (File/stat! file))]
   (when-not (and (erlang/is_integer size) (<= 1 size 67108864))
    (l/refuse! :offline-tool-native-byte-limit))
   (l/digest {:version 1 :protocol :offline-root-v1
              :sdk (BeamLisp.AOT/sdk_pipeline_identity! "datom.offline.root")
              :native (crypto/hash :sha256 (File/read! file))}))))
