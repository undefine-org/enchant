;; A sealed filesystem target is still not an application activation permit.
;; The root coordinator must verify its content-bound READY before publication.
(ns datom.offline.seal
 (:require [datom.offline.manifest :as manifest] [datom.offline.layout :as l]
           [datom.store-fjall]))
(defn- result! [value]
 (when (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value)) (= :error (elem value 0)))
  (l/refuse! :offline-sealed-publication-refused)) value)
(defn target!
 "Require every declared engine closed, pin its flock, then permanently seal
  this job's target against native file writes and scoped engine opens."
 [scope spec]
 (BeamLisp.Env/assert_native_framework_execution!)
 (manifest/validate! spec)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_seal
            (:handle scope) (to-list (mapv :path (:stores spec))))))
(defn release!
 "Release held claims after publication/reconciliation. Accepted work cannot
  be released early; the job's target remains sealed until the job closes."
 [sealed]
 (BeamLisp.Env/assert_native_framework_execution!)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_release sealed)))
(defn publish!
 "Publish to a distinct sibling of the job, without overwriting. The native
  worker owns the seal through completion even if its BEAM caller dies. A
  timeout is an uncertain outcome: retain custody and reconcile the same path."
 [sealed destination]
 (BeamLisp.Env/assert_native_framework_execution!)
 (let [tag (erlang/make_ref)
       accepted (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_publish
                           sealed destination (erlang/self) tag))]
  (when-not (= :accepted accepted) (l/refuse! :offline-sealed-publication-refused))
  (receive [reply-tag value] :when (= reply-tag tag)
   (result! value)
   (after 300000 (l/refuse! :offline-publication-uncertain)))))
