;; Fixed native coordinator entry. No Conn or application initializer runs;
;; scoped opens can touch only disposable extraction/target/scratch children.
(ns datom.offline.engine
 (:require [datom.store-fjall :as fj] [datom.offline.layout :as l]
           [datom.offline.manifest :as manifest]))

(defrecord Scope [handle path])
(defn- result! [result]
 (when (and (erlang/is_tuple result) (= 2 (erlang/tuple_size result)) (= :error (elem result 0)))
  (l/refuse! :offline-engine-refused))
 result)
(defn scope!
 "Recover the same owned job only after its durable marker matches exactly.
  This is native framework execution, never an application callback permit."
 [directory marker]
 (BeamLisp.Env/assert_native_framework_execution!)
 (->Scope (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_scope (:handle directory) marker))
          (:path directory)))
(defn open!
 "Open an existing supported extraction read-only at the logical level, or a
  private target/scratch store. :create requires an absent store, not a retry."
 ([scope relative] (open! scope relative {}))
 ([scope relative options]
  (BeamLisp.Env/assert_native_framework_execution!)
  (manifest/components relative)
  (let [opened (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_open
                         (:handle scope) relative (= true (:create options))))]
   (fj/->FjallStore (elem opened 0) (elem opened 1)))))

(defn bind-source!
 "Claim every original store without opening any engine. The actual native
  read-only root and store flocks stay owned by this job through publication."
 [scope source spec]
 (BeamLisp.Env/assert_native_framework_execution!)
 (manifest/validate! spec)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_bind_source
            (:handle scope) (:handle source) (to-list (mapv :path (:stores spec))))))
(defn check-source!
 "Confirm the exact original capability and inventory, not copied path flags."
 [scope source spec]
 (BeamLisp.Env/assert_native_framework_execution!)
 (manifest/validate! spec)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_check_source
            (:handle scope) (:handle source) (to-list (mapv :path (:stores spec))))))
(defn release-source!
 "Release original claims only after sealed/accepted publication relinquishes
  custody. A framework caller cannot detach them from an accepted worker."
 [scope]
 (BeamLisp.Env/assert_native_framework_execution!)
 (result! (BeamLisp.Native.Datom.StoreFjall/fjall_offline_release_source (:handle scope))))
