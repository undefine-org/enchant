(ns research.ingest-probe)
(def enabled (atom false))
(def stages (atom {}))
(def features (atom #{}))
(def modes {:baseline #{} :keys #{:native-keys} :binary #{:binary-codec}
            :keys-binary #{:native-keys :binary-codec}
            :fused #{:native-keys :binary-codec :fused-analysis}
            :compact #{:native-keys :binary-codec :fused-analysis :compact-postings}
            :delta #{:native-keys :binary-codec :fused-analysis :delta-postings}})
(defn feature? [key] (contains? (deref features) key))
(defn now [] (erlang/monotonic_time :microsecond))
(defn info [pid key]
  (let [r (erlang/process_info pid key)]
    (if (= :undefined r) 0 (erlang/element 2 r))))
(defn clear! [] (reset! stages {}))
(defn measure [label f]
  (if (not (deref enabled)) (f)
    (let [r (info (erlang/self) :reductions) t (now) value (f)
          micros (- (now) t) reds (- (info (erlang/self) :reductions) r)]
      (swap! stages update label
             (fn [old] {:calls (inc (get old :calls 0))
                        :us (+ (get old :us 0) micros)
                        :reductions (+ (get old :reductions 0) reds)}))
      value)))
(defn encoded-ops! [ops]
  (when (deref enabled)
    (let [counts (reduce (fn [m op]
                           (let [put? (= :put (erlang/element 1 op))]
                             {:ops (inc (:ops m))
                              :key-bytes (+ (:key-bytes m) (erlang/byte_size (erlang/element 2 op)))
                              :value-bytes (+ (:value-bytes m) (if put? (erlang/byte_size (erlang/element 3 op)) 0))}))
                         {:ops 0 :key-bytes 0 :value-bytes 0} ops)]
      (swap! stages update :encoded
             (fn [old] (merge-with + (or old {}) counts))))))
