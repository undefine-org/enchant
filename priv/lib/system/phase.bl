;; Finite checks over the expander's snapshot. No parser or evaluator.
(ns system.phase
 (:require [binding :as b] [syntax :as s] [codebase.phase :as code] [errors :as errors]
           [system.ownership :as ownership] [anf :as anf]))

(defn- valid-reference? [selection occurrence]
 (let [resolved (b/resolve selection (s/identifier (:name occurrence) (:context occurrence))
                           (:lookup-phase occurrence) (:position occurrence))
       expected (:reference resolved) actual (:reference occurrence)
       phase (+ (:lookup-phase occurrence) (:reference-shift occurrence))]
  (and (= :resolved (:status resolved))
       (= (:world actual) (:world expected)) (= (:declaration actual) (:declaration expected))
       (= (:space actual) (:space expected)) (= (:phase actual) phase)
       (if (= :transformer (:occurrence-kind occurrence))
         (let [declaration (:declaration resolved)]
          (and (contains? #{:macro :syntax} (:kind declaration))
               (= (:instance-shift occurrence) (- phase (:phase declaration)))
               (= (:lookup-shift occurrence) (- (:phase expected) (:phase declaration))))) true)
       (= (:id actual) (b/reference-id selection (:declaration actual) phase)))))

(defn- valid-export? [selection entry reference]
 (try
  (anf/binding-value reference)
  (let [row (get-in selection [:by-id (:declaration reference)])]
   (and row (= :public (:visibility row)) (= 0 (:phase row) (:phase reference))
        (= (first entry) (:namespace row)) (contains? #{:function :value} (:kind row))
        (= (:owner-world row) (:world reference)) (= (:space row) (:space reference))
        (= (:id reference) (b/reference-id selection (:declaration reference) 0))))
  (catch error false)))

(defn analyze
 "Project facts once and check their recorded resolutions. Return facts/report
  together so consumers retain one exact snapshot without repeating projection.
  Proved covers binding, phase and availability; native effects remain unknown."
 [program]
 (try
  (let [facts (code/facts program) selection (:selection facts)
        invalid (Enum/concat (Enum/filter (:references facts) #(not (valid-reference? selection %)))
                  (Enum/map (Enum/filter (get-in program [:unit :exports] (list))
                              #(not (valid-export? selection (:entry program) %)))
                    (fn [reference] {:reference reference :occurrence-kind :export :origin nil})))
        diagnostics (Enum/filter
                     (Enum/map invalid
                       #(errors/node->warning :phase {:ann (:origin %)} "Binding does not match the selected phase world"))
                     #(not (nil? %)))]
   {:facts facts
    :ownership (assoc (ownership/check [{:id [:program (:entry program)] :body (:node program)}]
                                       (ownership/execution-protocol))
                      :snapshot (:snapshot facts) :binding-snapshot (:binding-snapshot facts))
    :report
    {:version 2 :status (if (empty? invalid) :proved :refused) :scope :contextual-binding-resolution
    :snapshot (:snapshot facts) :references (count (:references facts)) :invalid invalid
    :diagnostics diagnostics :native-admission false
     :native-effects {:status :unknown :obligations (:native-obligations facts)}}})
  (catch error
   {:facts nil :report
    {:version 2 :status :error :scope :contextual-binding-resolution :native-admission false
     :kind (:kind (ex-data error))}})))

(defn check
 "Compatibility report API. See analyze for the matching prepared facts."
 [program] (:report (analyze program)))
