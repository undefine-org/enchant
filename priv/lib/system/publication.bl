;; Evidence for successful emitted code, never synthetic source compilation.
(ns system.publication
 (:require [system.incr :as incr] [data.bounded-cache :as cache]))

(defn- snapshot-once
 "Read actual published clauses and dispatch, bound to the interned value,
  shim bytes, environment generation and immutable body-module identities.
  Captured/unpublished/rebound functions and in-flight publishers decline."
 [ns name]
 (try
  (let [before (BeamLisp.Env/namespace_generations (list ns))
        raw (BeamLisp.Env/lookup (tuple :emitted_publication ns))
        publication (when (and (tuple? raw) (= :ok (elem raw 0))) (elem raw 1))
        definition-row (BeamLisp.Env/lookup (tuple :emitted_definition ns name))
        definition (when (and (tuple? definition-row) (= :ok (elem definition-row 0)))
                     (elem definition-row 1))
        publication (when publication (assoc publication :bodies (:bodies definition)))
        entries (BeamLisp.Env/ns_definition ns name)
        mod (:module publication)
        defs (when (and (seq entries)
                       (every? (fn [e] (and (tuple? e) (= 5 (erlang/tuple_size e))
                                            (map? (elem e 3)) (= :defn-clause (:op (elem e 3))))) entries))
               (mapv (fn [e] (elem e 3)) entries))
        actual (BeamLisp.Env/fetch_exact ns name)
        identity (when defs
                   (cache/key-data
                     {:dispatch (mapv (fn [e] [(elem e 0) (elem e 1) (elem e 2)]) entries)
                      :bodies (mapv (fn [e] (elem e 4)) entries)
                      :clauses (incr/fn-identity
                                 {:clauses (mapv (fn [d] {:params (mapv :name (:params d))
                                          :body (dissoc d :fname)}) defs)})} 0))
        valid (and before (= 4 (:version publication))
              (contains? #{1 2} (:version definition)) identity
              (= entries (:entries definition))
              (tuple? actual) (= :ok (elem actual 0))
              (BeamLisp.AOT/published_callable_matches? (elem actual 1) entries mod)
              (= (:md5 publication) (erlang/apply mod :module_info (list :md5)))
              (every? (fn [entry]
                        (let [body (elem entry 4) expected (get (:bodies publication) body)]
                         (and expected (= expected (erlang/apply body :module_info (list :md5)))))) entries))
        execution (when (and valid (= 2 (:version definition)))
                  ;; Env rows are mutable. Rebind descriptors to loaded artifact
                  ;; attributes instead of trusting a caller-replaced receipt.
                  (let [receipt (BeamLisp.Emit/execution_entries ns name entries (:bodies definition))]
                   (when (= receipt (:execution definition)) receipt)))
        after (BeamLisp.Env/namespace_generations (list ns))]
   (if (and before after (not= before after)) :retry
    (when (and valid after (= before after))
     {:version 1 :namespace ns :name name :generation before
      :shim publication :identity identity :entries entries :execution execution})))
  (catch _ nil)))

(defn snapshot
 "Read stable publication evidence. First use may load an analysis dependency
  and advance the environment generation. Retry that unstable read once; both
  attempts perform the full identity fence. In-flight or repeatedly changing
  publication still declines."
 [ns name]
 (let [first (snapshot-once ns name)]
  (if (= :retry first)
   (let [second (snapshot-once ns name)] (when-not (= :retry second) second))
   first)))

(defn valid?
 "Compare complete identities, not hash hints. A fresh snapshot performs all
  publication/binding checks again. No solver or recompile runs here."
 [saved]
 (and (some? saved) (= saved (snapshot (:namespace saved) (:name saved)))))
