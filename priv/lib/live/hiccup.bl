; live/hiccup.bl — a hiccup tree → HTML string. The view's output side.
;
; ── What this is ──────────────────────────────────────────────────────
;
; A view in this system is a PURE function `db → hiccup` (see PLAN-052). A
; hiccup tree is ordinary beam-lisp data:
;
;   [:tag attrs? child*]   an element   (attrs is an optional leading map)
;   "text"                 a text node  (HTML-escaped)
;   a number               a text node
;   a SEQ in child slot    spliced      (so `(for …)` yields many children)
;   nil                    dropped
;
; The tag keyword carries Clojure/hiccup shorthand: `:div#id.a.b` is a
; `<div>` with id `id` and classes `a b`. The reader already tokenises that
; as ONE keyword (`#` and `.` are not reader delimiters), so the split is
; done HERE, at render time, and nowhere else.
;
; ── Two reserved attribute kinds ──────────────────────────────────────
;
;   :key      identity for the differ (live/diff). STRIPPED from HTML — it
;             is a diff concern, never a DOM attribute. (It also rides as
;             vector metadata via `^{:key …}`; both are read by the differ.)
;   :on-EVENT a wire binding (an event term). STRIPPED from the HTML body
;             and re-emitted as a `data-ev-EVENT` marker the client hook
;             binds. The VALUE (an [:intent …]/[:assign …] term) never
;             reaches the browser as an attribute; the client learns the
;             binding out of band. Here we only mark WHICH events a node
;             wants, so the shell is inert-but-annotated before JS.
;
; ── Why a string, not a DOM ───────────────────────────────────────────
;
; First paint is server-rendered HTML: a real page before any JS, the
; progressive-enhancement floor. After connect, live/diff computes patches
; against the hiccup VALUE (not the string), so this renderer is only ever
; called for the initial mount and for a subtree `:replace`. That is why it
; is allowed to be the simple, obvious thing.

(ns live.hiccup (:require [interop]))

;; ── void elements: no closing tag, no children ──────────────────────
;;
;; The HTML spec's void elements. A child on one of these is a bug in the
;; view; we render the open tag only (the child is silently unreachable in
;; a browser regardless, so raising here would be stricter than the DOM).

(def ^:private void-tags
  #{"area" "base" "br" "col" "embed" "hr" "img" "input"
    "link" "meta" "param" "source" "track" "wbr"})

;; ── raw-text elements: content is NOT HTML-escaped ──────────────────
;;
;; `<style>` and `<script>` are raw-text elements in the HTML spec: their
;; content is CSS/JS, not markup, and must be emitted verbatim (escaping a
;; CSS `>` combinator or a JS `&&` would corrupt it). A view author is
;; responsible for what goes in them, exactly as in hand-written HTML.
(def ^:private raw-text-tags #{"style" "script"})

;; ── HTML escaping ───────────────────────────────────────────────────
;;
;; Text and attribute values are escaped. The five characters that can
;; break out of text or a double-quoted attribute context. `&` first, or a
;; later replacement's `&` would be double-escaped.

(defn escape
  "HTML-escape a string for text and double-quoted attribute contexts."
  [s]
  (-> (str s)
      (replace-str "&" "&amp;")
      (replace-str "<" "&lt;")
      (replace-str ">" "&gt;")
      (replace-str "\"" "&quot;")
      (replace-str "'" "&#39;")))

;; ── tag-keyword shorthand: :div#id.a.b → {:tag :id :classes} ────────

(defn parse-tag
  "Split a hiccup tag keyword into {:tag :id :classes}.

   `:div#main.card.wide` → {:tag \"div\" :id \"main\" :classes [\"card\" \"wide\"]}
   `:section.panel`       → {:tag \"section\" :id nil :classes [\"panel\"]}
   `:h1`                  → {:tag \"h1\" :id nil :classes []}

   The id is the `#`-segment (at most one); classes are the `.`-segments.
   Order between `#` and `.` does not matter — an id is found wherever the
   `#` is, and every `.`-segment that is not part of the id is a class."
  [kw]
  (let [s (name kw)
        ;; the tag is everything up to the first '#' or '.'
        hash-i (index-of s "#")
        dot-i (index-of s ".")
        cut (cond
              (and (nil? hash-i) (nil? dot-i)) (count s)
              (nil? hash-i) dot-i
              (nil? dot-i) hash-i
              :else (min hash-i dot-i))
        tag (subs s 0 cut)
        rest-str (subs s cut (count s))
        ;; walk the remainder: '#seg' sets id, '.seg' adds a class
        segs (filterv (fn [x] (not= x ""))
                      (split (replace-str rest-str "#" ".#") "."))
        id (reduce (fn [acc seg]
                     (if (starts-with? seg "#") (subs seg 1 (count seg)) acc))
                   nil segs)
        classes (filterv (fn [seg] (not (starts-with? seg "#"))) segs)]
    {:tag tag :id id :classes classes}))

;; ── attribute rendering ─────────────────────────────────────────────

(defn- event-attr?
  "Whether an attribute key is a wire event binding (`:on-click`, …)."
  [k]
  (starts-with? (name k) "on-"))

(defn- render-attr
  "One attribute as a string fragment (with a leading space), or \"\" when
   it contributes nothing. `:key`/`:id`/`:class` are handled by the caller
   (merged with the tag shorthand), so they are skipped here.

     true          → a bare boolean attribute (` disabled`)
     false / nil   → omitted entirely (carries no information)
     :on-EVENT     → `data-ev-EVENT='<json term>'` — the event TERM travels to
                     the browser as a JSON-encoded attribute so the client can
                     send it back verbatim on fire. The term is data (an
                     [:intent …] / [:assign …] vector), so it round-trips safely.
     otherwise     → `k=\"escaped-value\"`"
  [k v]
  (let [kn (name k)]
    (cond
      (contains? #{"id" "class"} kn) ""
      ;; :key becomes data-key: the DOM needs it so the client can address
      ;; keyed children for insert/remove/move, exactly as the differ does.
      (= kn "key") (str " data-key=\"" (escape v) "\"")
      ;; :on-EVENT carries its term as a JSON attribute (single-quoted so the
      ;; JSON's double quotes need no escaping in the HTML attribute value).
      (event-attr? k) (str " data-ev-" (subs kn 3 (count kn))
                           "='" (-> (interop/->json v)
                                    (replace-str "&" "&amp;")
                                    (replace-str "<" "&lt;")
                                    (replace-str ">" "&gt;")
                                    (replace-str "'" "&#39;")) "'")
      (= v true) (str " " kn)
      (or (= v false) (nil? v)) ""
      :else (str " " kn "=\"" (escape v) "\""))))

(defn- render-attrs
  "The full attribute string for an element, merging the tag shorthand's
   id/classes with the attrs map. Explicit `:id` wins over the shorthand's;
   classes CONCATENATE (shorthand first, then `:class`)."
  [shorthand attrs]
  (let [id (or (get attrs :id) (:id shorthand))
        cls-list (concat (:classes shorthand)
                         (let [c (get attrs :class)] (if (nil? c) [] [c])))
        cls (join " " cls-list)]
    (str (if (nil? id) "" (str " id=\"" (escape id) "\""))
         (if (= cls "") "" (str " class=\"" (escape cls) "\""))
         (join "" (map (fn [kv] (render-attr (first kv) (second kv))) (seq attrs))))))

;; ── the renderer ────────────────────────────────────────────────────

(defn- element?
  "A hiccup element: a vector whose head is a keyword."
  [node]
  (and (vector? node) (> (count node) 0) (keyword? (first node))))

;; ── the HTML parser's table fix-ups ─────────────────────────────────
;;
;; The DOM a browser builds from `<table><tr>…</tr></table>` is NOT that markup:
;; the HTML parser inserts the <tbody> a row needs (on the first paint and on
;; every innerHTML mount alike), and a cell outside a row gets an implicit
;; <tr>. A model that kept the rows as the table's children indexed every
;; patch path through the table one level short of the DOM — the client walked
;; into undefined, threw, and the rest of the patch was lost. So the model IS
;; the parser's tree: `parser-children` re-groups a table section's children
;; exactly where the parser would, the renderer emits the inferred elements,
;; and live.diff indexes them (its `children-of` calls this too), so an
;; inserted table also ships the <tbody> a createElement-built subtree would
;; otherwise lack.
;;
;;   in <table>:                 a run of <tr> → one <tbody>
;;                               a run of <td>/<th> → <tbody><tr>
;;   in <thead>/<tbody>/<tfoot>: a run of <td>/<th> → <tr>
;;
;; Any other child (an explicit section, a caption, text) ends the run. Content
;; the parser foster-parents OUT of a table (a <div> in a <table>) is not
;; modelled: it cannot be expressed as this element's children.

(def ^:private table-sections #{"table" "thead" "tbody" "tfoot"})

(defn table-section
  "The bare name when keyword `tag` is table/thead/tbody/tfoot, else nil.
   Cheap for the common case: a tag not starting with `t` is rejected first."
  [tag]
  (when (and (keyword? tag) (starts-with? (name tag) "t"))
    (let [t (:tag (parse-tag tag))]
      (when (contains? table-sections t) t))))

(defn- cell? [t] (or (= t "td") (= t "th")))

(defn- child-tag [c]
  (when (and (vector? c) (> (count c) 0) (keyword? (first c)))
    (:tag (parse-tag (first c)))))

(defn parser-children
  "`children` (already spliced: no seqs, no nils) of a `section` element
   (the result of `table-section`) as the HTML parser places them."
  [section children]
  (let [in-table (= section "table")]
    (if (not (some (fn [c] (let [t (child-tag c)] (or (cell? t) (and in-table (= t "tr")))))
                   children))
      children
      (let [flush-row (fn [st]
                        (if (nil? (:row st)) st
                          (let [tr (into [:tr] (:row st))]
                            (assoc (if in-table
                                     (assoc st :body (conj (or (:body st) []) tr))
                                     (assoc st :out (conj (:out st) tr)))
                                   :row nil))))
            flush-body (fn [st]
                         (if (nil? (:body st)) st
                           (assoc st :out (conj (:out st) (into [:tbody] (:body st))) :body nil)))
            end (reduce
                  (fn [st c]
                    (let [t (child-tag c)]
                      (cond
                        (cell? t) (assoc st :row (conj (or (:row st) []) c))
                        (= t "tr")
                          (let [st (flush-row st)]
                            (if in-table
                              (assoc st :body (conj (or (:body st) []) c))
                              (assoc st :out (conj (:out st) c))))
                        :else (let [st (flush-body (flush-row st))]
                                (assoc st :out (conj (:out st) c))))))
                  {:out [] :body nil :row nil}
                  children)]
        (:out (flush-body (flush-row end)))))))

(defn- spliced
  "A child list flattened as rendering flattens it: groups splice, nils drop."
  [cs]
  (reduce (fn [acc c]
            (cond (nil? c) acc
                  (and (or (seq? c) (list? c)) (not (vector? c))) (into acc (spliced (into [] c)))
                  :else (conj acc c)))
          [] cs))

(defn hiccup->html
  "Render a hiccup tree to an HTML string.

   Elements are `[:tag attrs? child*]`; a leading map is attributes. A seq
   in child position splices (so `(for …)` produces adjacent children). A
   string/number is escaped text. nil is dropped. A vector whose head is
   not a keyword is a GROUP of children and splices like a seq, so eager
   `(mapv …)` works wherever `(for …)` does; a vector headed by an attrs map
   (attributes with no tag) is an error."
  [node]
  (cond
    (nil? node) ""
    (string? node) (escape node)
    (number? node) (str node)
    (element? node)
      (let [has-attrs (and (> (count node) 1) (map? (nth node 1)))
            attrs (if has-attrs (nth node 1) {})
            ;; a ^{:key …} METADATA key is identity exactly like an attr key,
            ;; so it renders as data-key too: the client's keyed ops address
            ;; children through the DOM attribute, and a key the differ sees
            ;; but the DOM lacks makes every keyed :remove a silent no-op —
            ;; the ghost/zombie-DOM bug. Attr key wins if both are present.
            attrs (if (and (not (contains? attrs :key))
                           (some? (get (meta node) :key)))
                    (assoc attrs :key (get (meta node) :key))
                    attrs)
            children (if has-attrs (drop 2 node) (rest node))
            sh (parse-tag (first node))
            tag (:tag sh)
            ;; a table section renders the rows/cells the parser would infer
            children (if (contains? table-sections tag)
                       (parser-children tag (spliced children))
                       children)
            open (str "<" tag (render-attrs sh attrs) ">")]
        (cond
          (contains? void-tags tag) open
          ;; raw-text: emit string children verbatim (CSS/JS, never escaped)
          (contains? raw-text-tags tag)
            (str open (join "" (map (fn [c] (if (string? c) c (str c))) children))
                 "</" tag ">")
          :else
            (str open
                 (join "" (map hiccup->html children))
                 "</" tag ">")))
    ;; a child group in child position: splice its rendered children. A group
    ;; is any seq OR list: in this runtime an EMPTY list (`(apply list [])`, what
    ;; `loom.token/realize` makes of an empty `for`) is `list?` but not `seq?`,
    ;; and fell through to `escape` — the literal text "()" on every live page
    ;; that mapped an empty collection (FUP-123 Finding E).
    (or (seq? node) (list? node)) (join "" (map hiccup->html node))
    ;; a VECTOR group: a vector whose head is not a tag keyword is a group of
    ;; children, the eager twin of a seq — `(mapv (fn [x] [:li x]) xs)` renders
    ;; like `(for …)` without building a lazy seq (whose capture walk is costly).
    ;; An attrs-map head is not a group: attributes with no tag is malformed.
    (vector? node)
      (if (map? (first node))
        (throw (str "hiccup: a vector with attributes needs a tag [:tag {…} …], got "
                    (pr-str node)))
        (join "" (map hiccup->html node)))
    :else (escape node)))
