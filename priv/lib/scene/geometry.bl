(ns scene.geometry (:require [scene.core :as s]))
(def identity [1 0 0 1 0 0])
(defn multiply [a b]
  (let [[aa ab ac ad ax ay] a [ba bb bc bd bx by] b]
    [(+ (* aa ba) (* ac bb)) (+ (* ab ba) (* ad bb))
     (+ (* aa bc) (* ac bd)) (+ (* ab bc) (* ad bd))
     (+ (* aa bx) (* ac by) ax) (+ (* ab bx) (* ad by) ay)]))
(defn point [m p]
  (let [[a b c d x y] m [px py] p] [(+ (* a px) (* c py) x) (+ (* b px) (* d py) y)]))
(defn translate [x y] [1 0 0 1 x y])
(defn rotate [degrees]
  (let [r (* degrees (/ (erlang/apply :math :pi (list)) 180)) c (erlang/apply :math :cos (list r)) v (erlang/apply :math :sin (list r))] [c v (- 0 v) c 0 0]))
(defn transform
  "Operations apply in listed order, independent of backend string conventions."
  [ops]
  (reduce (fn [m op]
    (let [[kind value] op
          n (cond (= kind :translate) (translate (first value) (second value))
                  (= kind :rotate) (rotate value)
                  (= kind :scale) [(first value) 0 0 (second value) 0 0]
                  :else (s/fail "Unknown transform operation" {:operation op}))]
      (when (not (every? s/finite? n)) (s/fail "Invalid transform" {:operation op}))
      (multiply n m))) identity ops))
(defn bounds [m box]
  (let [[x y w h] box
        points (mapv (fn [p] (point m p)) [[x y] [(+ x w) y] [x (+ y h)] [(+ x w) (+ y h)]])
        xs (mapv first points) ys (mapv second points)
        left (apply min xs) top (apply min ys)]
    [left top (- (apply max xs) left) (- (apply max ys) top)]))
(defn union [boxes]
  (if (empty? boxes) [0 0 0 0]
    (let [x (apply min (mapv first boxes)) y (apply min (mapv second boxes))
          right (apply max (mapv (fn [[a b w h]] (+ a w)) boxes))
          bottom (apply max (mapv (fn [[a b w h]] (+ b h)) boxes))]
      [x y (- right x) (- bottom y)])))
(defn svg-transform [m] (str "matrix(" (join " " (mapv str m)) ")"))
(defn path-data [commands]
  (join " " (mapv (fn [command]
    (let [op (first command) coords (rest command)
          required (get {"M" 2 "L" 2 "Q" 4 "C" 6 "Z" 0} op)]
      (when (or (nil? required) (not= required (count coords)) (not (every? s/finite? coords)))
        (s/fail "Invalid structured path command" {:command command}))
      (str op " " (join " " (mapv str coords))))) commands)))
