(ns scene.core (:require [live.hiccup :as h] [scene.material :as material]))

(def capabilities #{:rect :circle :ellipse :line :polyline :path :text :group})
(defn fail [message data] (throw (ex-info message data)))
(defn finite? [x] (and (number? x) (= x x) (< (abs x) 1.0e12)))
(defn progress [t start duration]
  (if (<= duration 0) (if (< t start) 0 1)
    (max 0 (min 1 (/ (- t start) duration)))))
(defn lerp [a b p] (+ a (* (- b a) p)))
(defn ease [p] (* p p (- 3 (* 2 p))))
(defn frame-time [k n d]
  (when (not (and (integer? k) (>= k 0) (integer? n) (> n 0) (integer? d) (> d 0)))
    (fail "Invalid rational frame clock" {:frame k :fps [n d]}))
  (/ (* k d) n))

(defn validate-object [o]
  (when (not (and (string? (:id o)) (not (empty? (:id o)))))
    (fail "Object needs a stable string id" {:object o}))
  (when (not (contains? capabilities (:kind o)))
    (fail "Unsupported scene primitive" {:id (:id o) :kind (:kind o)}))
  (doseq [[k v] (:attrs o)]
    (when (not (contains? #{:x :y :x1 :y1 :x2 :y2 :width :height :rx :ry :cx :cy :r
                           :fill :stroke :stroke-width :opacity :font-size :text-anchor
                           :transform :clip-path :d :points :filter :font-family :font-style :font-weight
                           :letter-spacing :stroke-linecap :stroke-linejoin :stroke-dasharray
                           :stroke-dashoffset :fill-opacity :stroke-opacity} k))
      (fail "Unsupported scene attribute" {:id (:id o) :attribute k}))
    (when (and (number? v) (not (finite? v)))
      (fail "Non-finite geometry" {:id (:id o) :attribute k}))
    (when (and (contains? #{:width :height :r :rx :ry :stroke-width :font-size} k)
               (not (and (finite? v) (>= v 0))))
      (fail "Invalid geometry" {:id (:id o) :attribute k :value v})))
  (when (and (= :text (:kind o)) (not (string? (:text o))))
    (fail "Text must be a string" {:id (:id o)}))
  (when (and (seq (:children o)) (not= :group (:kind o)))
    (fail "Only groups may have children" {:id (:id o)}))
  (doseq [k (get {:rect [:x :y :width :height] :circle [:cx :cy :r]
                  :ellipse [:cx :cy :rx :ry] :line [:x1 :y1 :x2 :y2]
                  :text [:x :y :font-size]} (:kind o) [])]
    (when (not (finite? (get (:attrs o) k)))
      (fail "Missing or invalid geometry" {:id (:id o) :attribute k})))
  (when (contains? (:attrs o) :opacity)
    (let [v (:opacity (:attrs o))]
      (when (not (and (finite? v) (<= 0 v) (<= v 1)))
        (fail "Opacity outside [0,1]" {:id (:id o)}))))
  (doseq [child (:children o)] (validate-object child))
  o)

(defn object-ids [o] (cons (:id o) (mapcat object-ids (:children o))))
(defn validate [scene]
  (when (not (and (finite? (:time scene)) (>= (:time scene) 0)
                  (finite? (:width scene)) (> (:width scene) 0)
                  (finite? (:height scene)) (> (:height scene) 0)))
    (fail "Invalid scene time or dimensions" {:time (:time scene)}))
  (doseq [m (:materials scene)] (material/validate m))
  (doseq [o (concat (:clips scene) (:objects scene))] (validate-object o))
  (let [ids (mapcat object-ids (concat (:clips scene) (:objects scene)))]
    (when (not= (count ids) (count (set ids))) (fail "Duplicate object identity" {:ids ids})))
  scene)

(defn object-tree [o]
  (into [(if (= :group (:kind o)) :g (:kind o))
         (assoc (:attrs o) :id (:id o))]
        (if (= :text (:kind o)) [(:text o)] (mapv object-tree (:children o)))))

(defn svg [scene]
  (validate scene)
  (h/hiccup->html
    [:svg {:xmlns "http://www.w3.org/2000/svg" :width (:width scene) :height (:height scene)
           :viewBox (str "0 0 " (:width scene) " " (:height scene))
           :font-family "DejaVu Sans" :color-interpolation "sRGB"}
     [:title (str "BL scene / " (:scene scene) " / " (:time scene) "s")]
     [:defs (mapv material/svg-definition (:materials scene))
      (mapv (fn [clip] [:clipPath {:id (str (:id clip) "-clip")}
                              (object-tree clip)]) (:clips scene))]
     (mapv object-tree (:objects scene))]))
