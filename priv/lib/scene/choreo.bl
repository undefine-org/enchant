(ns scene.choreo (:require [scene.core :as s] [scene.camera :as camera] [scene.geometry :as geometry]))
(defn point? [p] (and (vector? p) (= 2 (count p)) (every? s/finite? p)))
(defn formation [nodes]
  (when (not (and (vector? nodes) (seq nodes))) (s/fail "Formation needs an ordered node vector" {}))
  (let [ids (mapv :id nodes)]
    (when (not= (count ids) (count (set ids))) (s/fail "Duplicate formation identity" {:ids ids}))
    (doseq [node nodes]
      (when (not (and (string? (:id node)) (not (empty? (:id node))) (point? (:at node))
                      (s/finite? (:angle node)) (s/finite? (:scale node)) (> (:scale node) 0)))
        (s/fail "Formation node needs identity, point, angle, and positive scale" {:node node}))
      (when (and (:parent node) (not (contains? (set ids) (:parent node))))
        (s/fail "Unresolved formation attachment" {:id (:id node) :parent (:parent node)})))
    {:nodes nodes :index (into {} (mapv (fn [node] [(:id node) node]) nodes)) :version 1}))
(defn progress [t at duration]
  (when (not (and (s/finite? t) (s/finite? at) (s/finite? duration) (> duration 0)))
    (s/fail "Choreography needs finite time and positive duration" {}))
  (camera/ease (s/progress t at duration)))
(defn point [a b p] (mapv (fn [i] (s/lerp (nth a i) (nth b i) p)) [0 1]))
(defn turn [a b p]
  (let [delta (- b a) shortest (- delta (* 360 (math/floor (/ (+ delta 180) 360))))]
    (+ a (* shortest p))))
(defn morph
  "Keyed correspondence; paint order follows the source. Attachment endpoints
   travel continuously when their semantic parent changes. No visibility channel."
  [from to p]
  (when (not (and (s/finite? p) (<= 0 p) (<= p 1))) (s/fail "Morph progress outside [0,1]" {:progress p}))
  (when (not= (set (keys (:index from))) (set (keys (:index to))))
    (s/fail "Morph requires the same semantic identities" {}))
  (mapv (fn [a]
    (let [b (get (:index to) (:id a))
          pa (get (:index from) (:parent a) a) pb (get (:index to) (:parent b) b)]
      {:id (:id a) :at (point (:at a) (:at b) p) :angle (turn (:angle a) (:angle b) p)
       :scale (math/exp (s/lerp (math/log (:scale a)) (math/log (:scale b)) p))
       :attachment (point (:at pa) (:at pb) p)
       :relationship {:from (:parent a) :to (:parent b) :progress p}})) (:nodes from)))
(defn follow
  "Blend camera focus between semantic objects/points, preserving its zoom/roll."
  [pose a b p]
  (when (not (and (point? a) (point? b) (s/finite? p) (<= 0 p) (<= p 1)))
    (s/fail "Invalid camera focus blend" {}))
  (assoc pose :center (point a b p)))
(defn path-morph
  "Interpolate corresponding structured commands. Topology must be authored;
   this does not guess contour correspondence or repair self-intersections."
  [a b p]
  (geometry/path-data a) (geometry/path-data b)
  (when (not (and (s/finite? p) (<= 0 p) (<= p 1)
                  (= (mapv first a) (mapv first b)) (= (mapv count a) (mapv count b))))
    (s/fail "Path morph needs matching topology and progress in [0,1]" {}))
  (mapv (fn [i] (let [x (nth a i) y (nth b i)]
    (into [(first x)] (mapv (fn [j] (s/lerp (nth x j) (nth y j) p)) (range 1 (count x)))))) (range (count a))))
