(ns scene.material)

;; Materials are values. Their stable IDs and explicit seeds belong to revision
;; identity; the SVG backend resolves them to reusable graphics resources.
(defn paper [id seed] {:id id :kind :paper :seed seed})
(defn halftone [id spacing radius color]
  {:id id :kind :halftone :spacing spacing :radius radius :color color})
(defn hatch [id spacing color]
  {:id id :kind :hatch :spacing spacing :color color})
(defn grid [id spacing color]
  {:id id :kind :grid :spacing spacing :color color})
(defn ref [id] (str "url(#" id ")"))

(defn validate [m]
  (when (not (and (string? (:id m)) (not (empty? (:id m)))))
    (throw (ex-info "Material needs a stable id" {:material m})))
  (when (not (contains? #{:paper :halftone :hatch :grid} (:kind m)))
    (throw (ex-info "Unsupported scene material" {:material m})))
  (when (and (not= :paper (:kind m))
             (not (and (number? (:spacing m)) (> (:spacing m) 0))))
    (throw (ex-info "Material spacing must be positive" {:material m})))
  (when (and (= :paper (:kind m)) (not (integer? (:seed m))))
    (throw (ex-info "Paper needs an integer seed" {:material m})))
  m)

(defn svg-definition [m]
  (validate m)
  (let [id (:id m) d (:spacing m) color (:color m)]
    (cond
      (= :paper (:kind m))
      [:filter {:id id :data-scene-material "paper" :x "0%" :y "0%" :width "100%" :height "100%"
                :color-interpolation-filters "sRGB"}
       [:feTurbulence {:type "fractalNoise" :baseFrequency "0.72" :numOctaves 3
                       :seed (:seed m) :stitchTiles "stitch"}]
       ;; Dark flecks with transparent troughs. Overlay sparingly; do not blur ink.
       [:feColorMatrix {:type "matrix" :values "0 0 0 0 0.13  0 0 0 0 0.11  0 0 0 0 0.08  0 0 0 0.23 0"}]]
      (= :halftone (:kind m))
      [:pattern {:id id :patternUnits "userSpaceOnUse" :width d :height d}
       [:circle {:cx (/ d 2) :cy (/ d 2) :r (:radius m) :fill color}]]
      (= :hatch (:kind m))
      [:pattern {:id id :patternUnits "userSpaceOnUse" :width d :height d
                 :patternTransform "rotate(35)"}
       [:line {:x1 0 :y1 0 :x2 0 :y2 d :stroke color :stroke-width 1}]]
      (= :grid (:kind m))
      [:pattern {:id id :patternUnits "userSpaceOnUse" :width d :height d}
       [:path {:d (str "M " d " 0 L 0 0 0 " d) :fill "none" :stroke color :stroke-width 0.8}]])))
