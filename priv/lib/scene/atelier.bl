(ns scene.atelier (:require [scene.core :as s] [scene.material :as material]))

;; A small grammar for editorial motion graphics. Combinators return ordinary
;; inspectable scene values; there is no second authoring language in the viewer.
(def ink "#24253b")
(def cream "#f1ebd9")
(def blue "#304484")
(def vermilion "#c74d38")
(def yellow "#ecc451")
(defn shape [id kind attrs] {:id id :kind kind :attrs attrs})
(defn group [id attrs children] {:id id :kind :group :attrs attrs :children (vec children)})
(defn paper [id x y w h color]
  (shape id :rect {:x x :y y :width w :height h :fill color}))
(defn label
  ([id x y size text] (label id x y size text {}))
  ([id x y size text attrs]
   {:id id :kind :text :text text
    :attrs (merge {:x x :y y :font-size size :font-family "DM Sans" :fill ink} attrs)}))
(defn display [id x y size text attrs]
  (label id x y size text (merge {:font-family "Instrument Serif"} attrs)))
(defn annotation [id x y size text attrs]
  (label id x y size text (merge {:font-family "Patrick Hand"} attrs)))
(defn ink-line [id points attrs]
  (shape id :path (merge {:d points :fill "none" :stroke ink :stroke-width 2
                         :stroke-linecap "round" :stroke-linejoin "round"} attrs)))
(defn disc [id x y r color]
  (shape id :circle {:cx x :cy y :r r :fill color}))
(defn texture [id x y w h seed]
  (shape id :rect {:x x :y y :width w :height h :fill "white"
                   :filter (material/ref seed) :opacity 0.42}))

(defn stagger [t index step duration]
  (s/ease (s/progress t (* index step) duration)))
(defn reveal [id p children]
  (group id {:opacity p :transform (str "translate(0 " (* (- 1 p) 22) ")")} children))
(defn drift [id t amount children]
  (group id {:transform (str "translate(0 " (* amount (math/sin (* t 1.3))) ")")} children))

(defn rough-box
  "Two subtly different ink passes, stable for object id. The variation is
   geometry, never a moving per-frame displacement filter."
  [id x y w h color]
  (let [right (+ x w) bottom (+ y h)]
    (group id {}
      [(shape (str id "-stock") :path
         {:d (str "M " x " " (+ y 1) " Q " (+ x (/ w 2)) " " (- y 1)
                  " " right " " y " L " (+ right 1) " " bottom
                  " Q " (+ x (/ w 2)) " " (+ bottom 1) " " x " " bottom " Z")
          :fill color :stroke ink :stroke-width 2 :stroke-linejoin "round"})
       (ink-line (str id "-ink")
         (str "M " (+ x 1.2) " " (+ y 2.6) " L " (- right 1) " " (+ y 1.4)
              " " (- right 0.7) " " (- bottom 1.5) " " (+ x 2) " " (- bottom 0.3) " Z")
         {:stroke-width 0.65 :opacity 0.5})])))

(defn cutout [id transform x y w h color children]
  (group id {:transform transform}
    [(paper (str id "-shadow") (+ x 9) (+ y 12) w h "#172449")
     (rough-box (str id "-paper") x y w h color)
     (group (str id "-content") {} children)]))

(defn arrow [id x y length color]
  (group id {}
    [(ink-line (str id "-shaft") (str "M " x " " y " Q " (+ x (/ length 2)) " " (- y 5)
                                     " " (+ x length) " " y) {:stroke color :stroke-width 2.4})
     (ink-line (str id "-head") (str "M " (- (+ x length) 9) " " (- y 5)
                                    " L " (+ x length) " " y " " (- (+ x length) 9) " " (+ y 5))
               {:stroke color :stroke-width 2.4})]))
