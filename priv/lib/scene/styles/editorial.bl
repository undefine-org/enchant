(ns scene.styles.editorial)
(def warm
  {:id :editorial/warm :paper "#f1ebd9" :card-paper "#f7f1e3" :ink "#24253b" :accent "#c74d38"
   :field "#304484" :muted "#65615c" :shadow "#c9bfa5"
   :type {:display {:family "Instrument Serif" :size 86 :line-height 1.03}
          :heading {:family "Instrument Serif" :size 44 :line-height 1.06}
          :body {:family "DM Sans" :size 20 :line-height 1.3}
          :annotation {:family "Patrick Hand" :size 26 :line-height 1.15}
          :label {:family "DM Sans" :size 12 :line-height 1.2}}})
(def blueprint
  {:id :editorial/blueprint :paper "#263f70" :card-paper "#2f4d80" :ink "#f2efda" :accent "#f3cd65"
   :field "#172c52" :muted "#bbccde" :shadow "#122540"
   :type {:display {:family "Instrument Serif" :size 86 :line-height 1.03}
          :heading {:family "Instrument Serif" :size 44 :line-height 1.06}
          :body {:family "DM Sans" :size 20 :line-height 1.3}
          :annotation {:family "Patrick Hand" :size 26 :line-height 1.15}
          :label {:family "DM Sans" :size 12 :line-height 1.2}}})
(defn cutout [opts content] {:node :card :opts opts :children [content]})
