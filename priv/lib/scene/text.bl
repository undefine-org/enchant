(ns scene.text (:require [scene.core :as s] [interop]))
(defn block [opts text]
  (when (nil? (:id opts)) (s/fail "Text nodes need a local semantic id" {}))
  (when (not (string? text)) (s/fail "Text content must be a string" {:id (:id opts)}))
  {:node :text :opts opts :text text :wrap false})
(defn paragraph [opts text] (assoc (block opts text) :wrap true))
(defn measure!
  "Batch canonical Pango metrics and vector outlines. No graphics work at import.
   opts includes :font-dir and optional :worker, :python, :rsvg. JSON stays at
   the boundary; callers receive keyword metrics keyed by request id."
  [requests opts]
  (when (not= (count requests) (count (set (mapv :id requests))))
    (s/fail "Duplicate semantic text identity" {:kind :duplicate-id}))
  (let [worker (or (:worker opts) (str (BeamLisp.Tiers/priv_root) "/lib/scene/text_worker.py"))
        result (System/cmd (or (:python opts) "python3")
                 (to-list [worker "--font-dir" (Path/expand (:font-dir opts))
                           "--requests-json" (interop/->json requests)
                           "--rsvg" (or (:rsvg opts) (System/get_env "SCENE_RSVG") "rsvg-convert")]))
        value (interop/json-> (erlang/element 1 result))]
    (when (not= 0 (erlang/element 2 result))
      (s/fail "Canonical text shaping failed" {:kind :text-shaping :diagnostic (get value "error")}))
    {:backend (get value "backend") :fonts (get value "fonts")
     :runs (into {} (mapv (fn [run]
        [(get run "id") {:logical (get run "logical") :ink (get run "ink")
                          :baseline (get run "baseline") :lines (get run "lines")
                          :commands (get run "commands") :outline-bounds (get run "outline-bounds")}])
        (get value "runs")))}))
