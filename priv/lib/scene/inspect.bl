(ns scene.inspect (:require [scene.core :as s] [scene.layout :as layout] [scene.atelier :as a]))
(defn object [evaluated id]
  (let [key (if (string? id) id (join "/" (mapv layout/id-part id)))
        value (get evaluated key)]
    (when (nil? value) (s/fail "Unknown scene object" {:kind :unknown-object :id key}))
    value))
(defn bounds [evaluated id] (select-keys (object evaluated id) [:logical :ink :effect :anchors]))
(defn explain [evaluated id property]
  (let [node (object evaluated id) origin (get (:provenance node) property)]
    (when (nil? origin) (s/fail "No recorded origin for property" {:id (:id node) :property property}))
    {:object (:semantic-id node) :property property :value (get (:properties node) property) :because origin}))
(defn overlay [evaluated id]
  (let [node (object evaluated id)]
    (a/group "$inspection" {}
      (into (mapv (fn [[name color]]
                     (let [[x y w h] (get node name)]
                       {:id (str "$inspection/" (str name)) :kind :rect
                        :attrs {:x x :y y :width w :height h :fill "none" :stroke color
                                :stroke-width 1.5 :stroke-dasharray "5 4"}}))
                   [[:logical "#e75145"] [:ink "#25a48e"] [:effect "#b07bdb"]])
            (mapv (fn [[name point]] (a/disc (str "$inspection/anchor/" (str name)) (first point) (second point) 4 "#e75145")) (:anchors node))))))
