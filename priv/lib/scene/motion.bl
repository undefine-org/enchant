(ns scene.motion (:require [scene.core :as s] [scene.geometry :as g]))
(defn tween [opts t]
  (let [start (get opts :at 0) duration (get opts :duration 0.6)]
    (when (not (and (s/finite? t) (s/finite? start) (s/finite? duration) (>= duration 0)))
      (s/fail "Invalid finite tween" {:options opts :time t}))
    (let [p (s/progress t start duration)] (if (= :linear (:ease opts)) p (s/ease p)))))
(defn enter [opts node] (assoc-in node [:opts :enter] opts))
(defn sample [tree t cues]
  (let [enter (:enter tree)
        start (if (:cue enter) (get cues (:cue enter)) (get enter :at 0))
        start (if (nil? start) (s/fail "Unknown animation cue" {:id (:id tree) :cue (:cue enter)}) start)
        p (if enter (tween (assoc enter :at (+ start (get enter :delay 0))) t) 1)
        dy (if (and enter (not= :fade (:effect enter))) (* 22 (- 1 p)) 0)
        matrix (g/multiply (:matrix tree) (g/translate 0 dy))
        children (mapv (fn [child] (sample child t cues)) (:children tree))
        render (assoc (:render tree) :attrs (assoc (:attrs (:render tree)) :transform (g/svg-transform matrix) :opacity p))
        render (if (seq children) (assoc render :children (into (:decorations tree) (mapv :render children))) render)]
    (assoc tree :matrix matrix :children children :render render)))
