(ns scene.camera (:require [scene.core :as s] [scene.geometry :as g]))
(defn point? [value] (and (vector? value) (= 2 (count value)) (every? s/finite? value)))
(defn pose! [pose]
  (when (not (and (point? (:center pose)) (s/finite? (:zoom pose)) (< 0 (:zoom pose))
                  (<= (:zoom pose) 64) (s/finite? (get pose :roll 0))))
    (s/fail "Camera pose needs finite center, positive zoom, and roll degrees" {:pose pose}))
  (assoc pose :roll (get pose :roll 0)))
(defn track [segments]
  (when (not (and (vector? segments) (seq segments))) (s/fail "Camera needs ordered segments" {}))
  (when (not= (count segments) (count (set (mapv :id segments)))) (s/fail "Duplicate camera segment id" {}))
  (let [result
    (reduce (fn [{:keys [duration segments]} segment]
      (let [from (pose! (:from segment)) to (pose! (:to segment))
            d (:duration segment) pullback (get segment :pullback 0)
            controls (get segment :controls [(:center from) (:center to)])]
        (when (not (and (string? (:id segment)) (not (empty? (:id segment)))
                        (s/finite? d) (> d 0) (s/finite? (+ duration d))
                        (s/finite? pullback) (<= 0 pullback) (<= pullback 1)
                        (vector? controls) (= 2 (count controls)) (every? point? controls)))
          (s/fail "Invalid finite camera segment" {:segment segment}))
        (when (and (seq segments) (not= (:to (last segments)) from))
          (s/fail "Camera segments must meet at the same pose" {:id (:id segment)}))
        {:duration (+ duration d)
         :segments (conj segments (assoc segment :at duration :end (+ duration d) :from from :to to
                                        :controls controls :pullback pullback))}))
      {:duration 0 :segments []} segments)]
    (assoc result :version 1)))
(defn ease [p] (* p p p (+ 10 (* p (+ -15 (* 6 p))))))
(defn curve [a b c d p]
  (let [q (- 1 p)] (+ (* q q q a) (* 3 q q p b) (* 3 q p p c) (* p p p d))))
(defn sample
  "Pure camera query. Outside times hold the endpoint. Position is cubic,
   zoom logarithmic, and segment timing has zero endpoint velocity/acceleration."
  [track t]
  (when (not (s/finite? t)) (s/fail "Camera time must be finite" {:time t}))
  (let [segment (or (first (filter (fn [v] (< t (:end v))) (:segments track))) (last (:segments track)))
        p (ease (s/progress t (:at segment) (:duration segment))) q (- 1 p)
        from (:from segment) to (:to segment) [c1 c2] (:controls segment)
        center (mapv (fn [i] (curve (nth (:center from) i) (nth c1 i) (nth c2 i) (nth (:center to) i) p)) [0 1])
        zoom (erlang/apply :math :exp (list (- (s/lerp (erlang/apply :math :log (list (:zoom from))) (erlang/apply :math :log (list (:zoom to))) p)
                         (* (:pullback segment) 16 p p q q))))]
    {:center center :zoom zoom :roll (s/lerp (:roll from) (:roll to) p) :segment (:id segment)}))
(defn matrix [pose viewport]
  (pose! pose)
  (when (not (and (point? viewport) (every? (fn [v] (> v 0)) viewport)))
    (s/fail "Camera viewport needs positive dimensions" {:viewport viewport}))
  (let [[x y] (:center pose) [w h] viewport z (:zoom pose)]
    (g/transform [[:translate [(- 0 x) (- 0 y)]] [:rotate (- 0 (get pose :roll 0))]
                  [:scale [z z]] [:translate [(/ w 2) (/ h 2)]]])))
