(ns scene.score (:require [scene.core :as s]))
(defn track
  "Finite ordered numeric-vector score. Each key is {:at seconds :value vector}.
   Sampled Catmull–Rom tangents keep motion running through interior keys.
   Values are not clamped: bounded channels need an explicit admission policy."
  [keys]
  (when (not (and (vector? keys) (>= (count keys) 2))) (s/fail "Score needs at least two keys" {}))
  (let [size (count (:value (first keys)))]
    (when (not (and (> size 0) (every? (fn [k] (and (s/finite? (:at k))
                       (vector? (:value k)) (= size (count (:value k))) (every? s/finite? (:value k)))) keys)
                   (every? (fn [[a b]] (< (:at a) (:at b))) (partition 2 1 keys))))
      (s/fail "Score keys need increasing finite times and equal finite vectors" {})))
  {:keys keys :version 1})
(defn sample [track t]
  (when (not (s/finite? t)) (s/fail "Score time must be finite" {}))
  (let [keys (:keys track) end (- (count keys) 1)]
    (cond (<= t (:at (first keys))) (:value (first keys))
          (>= t (:at (last keys))) (:value (last keys))
          :else
          (let [i (count (filter (fn [k] (<= (:at k) t)) keys))
                b (nth keys (- i 1)) c (nth keys i)
                a (nth keys (max 0 (- i 2))) d (nth keys (min end (+ i 1)))
                dt (- (:at c) (:at b)) p (/ (- t (:at b)) dt) p2 (* p p) p3 (* p2 p)
                h00 (+ (* 2 p3) (* -3 p2) 1) h10 (+ p3 (* -2 p2) p)
                h01 (+ (* -2 p3) (* 3 p2)) h11 (- p3 p2)]
            (mapv (fn [j]
              (let [av (nth (:value a) j) bv (nth (:value b) j) cv (nth (:value c) j) dv (nth (:value d) j)
                    m0 (if (= a b) 0 (/ (- cv av) (- (:at c) (:at a))))
                    m1 (if (= c d) 0 (/ (- dv bv) (- (:at d) (:at b))))]
                (+ (* h00 bv) (* h10 dt m0) (* h01 cv) (* h11 dt m1))))
              (range (count (:value b))))))))
