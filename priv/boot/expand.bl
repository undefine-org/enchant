;; Ordered contextual elaboration. Reader, binding lookup, macro evaluation and
;; ANF compilation each retain their existing owner. No alternate evaluator.
(ns expand (:require [syntax :as s] [binding :as b] [expand-source :as catalog] [compiler :as compiler]))

(defn- refuse! [kind node]
 (throw (ex-info (str "Contextual expansion: " kind)
          {:kind kind :origin (:origin node)})))

(defn- tick [state]
 (when (<= (:remaining state) 0) (refuse! :expansion-budget nil))
 (update state :remaining dec))

(defn- source-world [state]
 (Map/fetch! (get-in state [:selection :worlds]) (:world state)))

(defn- fresh-scope [state role]
 (let [w (source-world state) n (:next-scope state)
       scope (b/scope (:selection w) (:namespace state)
               (Enum/concat (or (:coordinate-prefix state) (list 1)) (list n)) role)]
  (tuple scope (assoc state :next-scope (+ n 1)
                           :selection (b/register-scope (:selection state) scope)))))

(defn- as-reader [node] (s/to-reader node))

(defn- list-reader [node children]
 (let [form (tuple :list children)]
  (if (:origin node) (tuple :meta form (:origin node)) form)))

(defn- spelling [node]
 (when (s/identifier? node) (elem (:value node) 1)))

(defn- internal-name [reference]
 (str "__bl_binding_" (Base/encode16 (:id reference) (list (tuple :case :lower)))))

(defn- lookup-result [node state]
 (b/resolve (:selection state) node (:phase state)
   (if (= (:world state) (get-in node [:context :world])) (:position state) 1073741823)))

(defn- reference-reader [node result state definition?]
 (let [original (:reference result) shift (Map/get state :reference-shift 0)
       reference (if (= 0 shift) original
                   (assoc original :phase (+ (:phase original) shift)
                     :id (b/reference-id (:selection state) (:declaration original) (+ (:phase original) shift))))
       name (internal-name reference)
       syntax (assoc node :value (symbol name))
       occurrence {:reference reference :name (:value node) :origin (:origin node)
                   :context (:context node) :lookup-phase (:phase state) :position (:position result)
                   :reference-shift shift :definition definition?}
       descriptor {:reference reference :declaration (:declaration result)}
       state (if (= :local (get-in result [:declaration :visibility])) state
                 (assoc-in state [:dependencies name] descriptor))]
  (tuple (as-reader syntax)
         (-> state (assoc-in [:references name] descriptor)
                   (update :occurrences #(cons occurrence %))))))

(defn- resolve-symbol [node state]
 (let [result (lookup-result node state)]
  (when-not (= :resolved (:status result))
   (throw (ex-info "Identifier does not have a unique available binding"
            {:kind (case (:status result) :unbound :unbound-identifier :ambiguous :ambiguous-identifier
                         :not-yet-available :binding-not-yet-available :invalid-binding-result)
             :name (:value node) :origin (:origin node) :resolution result})))
  result))

(defn- bind-symbol [node state]
 (let [name (spelling node)]
  (if (contains? #{"&" "_"} name) (tuple (as-reader node) state)
   (let [n (:next-declaration state)
         declaration {:namespace (:namespace state) :name (:value node) :phase (:phase state)
                      :space (get-in node [:context :space]) :kind :value :visibility :local
                      :available-from 0
                      :path (Enum/concat (or (:coordinate-prefix state) (list 1)) (list n))
                      :scopes (s/scopes node (:phase state))}
         state (assoc state :next-declaration (+ n 1)
                            :selection (b/bind (:selection state) (:world state) declaration))]
    (reference-reader node (resolve-symbol node state) state true)))))

(declare expression-node)
(declare pattern-node)
(declare demand-transformer)

(defn- expression-nodes [nodes state]
 (Enum/map_reduce nodes state (fn [node current] (expression-node node current))))

(defn- pattern-node [node state]
 (cond
  (s/identifier? node) (bind-symbol node state)
  (= :vector (:tag node))
   (let [r (Enum/map_reduce (:children node) state
             (fn [child current]
              (if (= :keyword (:tag child)) (tuple (as-reader child) current)
                  (pattern-node child current))))]
    (tuple (tuple :vector (elem r 0)) (elem r 1)))
  :else (refuse! :unsupported-contextual-pattern node)))

(defn- scoped [nodes scope]
 (Enum/map nodes #(s/add-scope % (:id scope) :all)))

(defn- let-node [node state]
 (let [children (:children node) head (first children) bindings (second children)
       _ (when-not (and (= :vector (:tag bindings)) (even? (count (:children bindings))))
           (refuse! :invalid-contextual-bindings bindings))]
  (loop [items (:children bindings) body (Enum/drop children 2) current state output (list)]
   (if (empty? items)
    (let [r (expression-nodes body current)]
     (tuple (list-reader node
              (cons (as-reader head) (cons (tuple :vector (Enum/reverse output)) (elem r 0)))) (elem r 1)))
    (let [initial (expression-node (second items) current)
          allocated (fresh-scope (elem initial 1) :lexical) scope (elem allocated 0)
          pattern (pattern-node (s/add-scope (first items) (:id scope) :all) (elem allocated 1))]
     ;; Scope the rest of the SOURCE before expanding any macro inside it.
     (recur (scoped (Enum/drop items 2) scope) (scoped body scope) (elem pattern 1)
            (cons (elem initial 0) (cons (elem pattern 0) output))))))))

(defn- fn-clause [parameters body state]
 (when-not (= :vector (:tag parameters)) (refuse! :invalid-contextual-parameters parameters))
 (let [allocated (fresh-scope state :lexical) scope (elem allocated 0)
       params (pattern-node (s/add-scope parameters (:id scope) :all) (elem allocated 1))
       r (expression-nodes (scoped body scope) (elem params 1))]
  (tuple (cons (elem params 0) (elem r 0)) (elem r 1))))

(defn- fn-node [node state]
 (let [children (:children node) head (first children)
       named? (s/identifier? (second children))
       allocated (when named? (fresh-scope state :lexical))
       self (when named? (bind-symbol (s/add-scope (second children) (:id (elem allocated 0)) :all)
                                      (elem allocated 1)))
       forms (if named? (scoped (Enum/drop children 2) (elem allocated 0)) (rest children))
       current (if named? (elem self 1) state)
       prefix (if named? (list (as-reader head) (elem self 0)) (list (as-reader head)))]
  (if (= :vector (:tag (first forms)))
   (let [r (fn-clause (first forms) (rest forms) current)]
    (tuple (list-reader node (Enum/concat prefix (elem r 0))) (elem r 1)))
   (let [r (Enum/map_reduce forms current
             (fn [clause current]
              (when-not (= :list (:tag clause)) (refuse! :invalid-contextual-clause clause))
              (let [r (fn-clause (first (:children clause)) (rest (:children clause)) current)]
               (tuple (list-reader clause (elem r 0)) (elem r 1)))))]
    (tuple (list-reader node (Enum/concat prefix (elem r 0))) (elem r 1))))))

(defn- native-name? [node]
 ;; Native escapes are explicit obligations; they are not inferred bindings.
 ;; The initial expression adapter admits only the existing erlang qualifier.
 (let [name (spelling node)] (and name (String/starts_with? name "erlang/"))))

(defn- macro-node [node result state]
 (when (or (<= (Map/get state :macro-budget 0) 0) (>= (Map/get state :macro-depth 0) 64))
  (refuse! :contextual-macro-budget node))
 (let [depth (Map/get state :macro-depth 0)
       state (-> state (update :macro-budget dec) (assoc :macro-depth (+ 1 depth)))
       allocated (fresh-scope state :introduction) scope (elem allocated 0) state (elem allocated 1)
       reference (:reference result) declaration (:declaration result)
       delta (- (:phase reference) (:phase declaration))
       state (assoc state :selection (b/instantiate (:selection state) (:world reference) delta))
       unit (get-in state [:catalog :worlds (:world reference)])
       context {:version 1 :definition-context
                 (s/shift-context (:context unit) delta)
                :use-context (:context (first (:children node))) :introduction-scope (:id scope)
                :use-phase (:phase state) :phase (+ 1 (:phase state)) :origin (:origin node)}]
  (when-not (:catalog state)
   (refuse! :contextual-macro-controller-unavailable node))
  ;; Fixed compiler interface. No caller-supplied evaluator or runtime macro Fn.
  (let [demand (demand-transformer reference state)
        expanded (BeamLisp.AOT/eval_constructor_session! (:constructor-session state)
                   {:op :apply :fn (elem demand 0)
                    :args [{:op :lit :val node} {:op :lit :val context}]} {})
        materialize (fn [value]
                      (if (= :contextual-literal (:kind value))
                        (s/from-datum (:value value) (:definition-context context)) value))
        syntax (s/validate
                 (if (= :contextual-template (:kind expanded))
                   (s/template (s/shift-phase (:template expanded) delta)
                     (Map/new (Enum/map (Map/to_list (:holes expanded))
                                #(tuple (elem % 0) (materialize (elem % 1))))) (:id scope))
                   (materialize expanded)))
        syntax (s/for-compiler syntax (get-in state [:catalog :worlds (:world state) :file]))
        trace {:transformer reference :origin (:origin node) :protocol 'syntax-v1 :instance-shift delta}]
   (let [r (expression-node syntax (update (elem demand 1) :expansions #(cons trace %)))]
    (tuple (elem r 0) (assoc (elem r 1) :macro-depth depth))))))

(defn- quote-reader [value context]
 (tuple :list (list (tuple :symbol "quote") (s/to-reader (s/from-datum value context)))))

(defn- template-node [node state]
 (when-not (:transformer state) (refuse! :syntax-template-outside-transformer node))
 (let [children (:children node)]
  (when-not (= 3 (count children)) (refuse! :syntax-template-arity node))
  (let [holes (expression-node (nth children 2) state)]
   (tuple (tuple :map
            (list (tuple (tuple :keyword "kind") (tuple :keyword "contextual-template"))
                  (tuple (tuple :keyword "template") (quote-reader (second children) (:context node)))
                  (tuple (tuple :keyword "holes") (elem holes 0)))) (elem holes 1)))))

(defn- argument-node [node state]
 (let [children (:children node) index (nth children 2 nil)]
  (when-not (and (= 3 (count children)) (= :scalar (:tag index))
                 (erlang/is_integer (:value index)) (<= 0 (:value index) 64))
   (refuse! :syntax-argument-index node))
  (let [form (expression-node (second children) state)
        items (tuple :list (list (tuple :symbol "BeamLisp.Ns.Rt/get") (elem form 0) (tuple :keyword "children")))
        tail (Enum/reduce (List/duplicate nil (:value index)) items
               (fn [_ value] (tuple :list (list (tuple :symbol "erlang/tl") value))))]
   (tuple (tuple :list (list (tuple :symbol "erlang/hd") tail)) (elem form 1)))))

(defn- literal-node [node state]
 (when-not (and (:transformer state) (= 2 (count (:children node))))
  (refuse! :syntax-literal-contract node))
 (let [r (expression-node (second (:children node)) state)]
  (tuple (tuple :map (list (tuple (tuple :keyword "kind") (tuple :keyword "contextual-literal"))
                           (tuple (tuple :keyword "value") (elem r 0)))) (elem r 1))))

(defn- expression-node [node state]
 (let [state (tick state) tag (:tag node)]
  (cond
   (s/identifier? node) (reference-reader node (resolve-symbol node state) state false)
   (contains? #{:scalar :keyword} tag) (tuple (as-reader node) state)
   (contains? #{:vector :set} tag)
    (let [r (expression-nodes (:children node) state)]
     (tuple (tuple tag (elem r 0)) (elem r 1)))
   (= :map tag)
    (let [r (Enum/map_reduce (:children node) state
              (fn [pair current]
               (let [left (expression-node (first pair) current)
                     right (expression-node (second pair) (elem left 1))]
                (tuple (tuple (elem left 0) (elem right 0)) (elem right 1)))))]
     (tuple (tuple :map (elem r 0)) (elem r 1)))
   (= :list tag)
    (let [children (:children node) head (first children) name (spelling head)
          binding (when (s/identifier? head)
                    (lookup-result head state))
          kernel? (or (nil? binding) (= :unbound (:status binding)))]
     (cond
      (empty? children) (tuple (list-reader node (list)) state)
      (and kernel? (= "quote" name)) (tuple (as-reader node) state)
      (and kernel? (= "syntax-template" name)) (template-node node state)
      (and kernel? (= "syntax-arg" name)) (argument-node node state)
      (and kernel? (= "syntax-literal" name)) (literal-node node state)
      (and kernel? (contains? #{"let" "let*" "loop" "loop*"} name)) (let-node node state)
      (and kernel? (contains? #{"fn" "fn*"} name)) (fn-node node state)
      (and kernel? (contains? #{"if" "do" "recur" "throw"} name))
       (let [r (expression-nodes (rest children) state)]
        (tuple (list-reader node (cons (as-reader head) (elem r 0))) (elem r 1)))
      (and kernel? (native-name? head))
       (let [r (expression-nodes (rest children) state)]
        (tuple (list-reader node (cons (as-reader head) (elem r 0)))
               (update (elem r 1) :native-obligations
                 #(cons {:name (:value head) :origin (:origin head)
                         :phase (+ (:phase state) (Map/get state :reference-shift 0))} %))))
      :else
       (let [result (when (s/identifier? head) (resolve-symbol head state))]
        (if (contains? #{:macro :syntax} (get-in result [:declaration :kind]))
         (macro-node node result state)
         (let [r (expression-nodes children state)]
          (tuple (list-reader node (elem r 0)) (elem r 1)))))))
   :else (refuse! :unsupported-contextual-expression node))))

(defn expression
 "Elaborate one actual Reader expression against selected logical worlds.
  Actual source bytes must match the selected root revision. Source transformer
  demands are owned by program, which derives its catalog from actual Reader
  units; this expression adapter accepts no evaluator callback."
 [source file options]
 (when-not (and (erlang/is_map options)
                (every? #(contains? #{:selection :world :namespace :phase} %) (keys options)))
  (refuse! :invalid-expansion-options nil))
 (let [graph (b/validate-selection (:selection options))
       w (Map/get (:worlds graph) (:world options)) namespace (:namespace options)
       input (when w (Enum/find (get-in w [:selection :sources]) #(= namespace (:namespace %))))
       _ (when-not (and (erlang/is_binary source) input (= (:digest input) (crypto/hash :sha256 source)))
           (refuse! :expansion-source-mismatch nil))
       phase (Map/get options :phase 0)
       module (b/scope (:selection w) namespace [0] :module)
       graph (b/register-scope graph module)
       context {:world (:key w) :namespace namespace :space 'value :scopes {:all [(:id module)]}}
       forms (s/read source file context)
       _ (when-not (= 1 (count forms)) (refuse! :expansion-expression-count nil))
       state {:selection graph :world (:key w) :namespace namespace :phase phase :position 0
              :next-scope 0 :next-declaration 0 :remaining 1000000
              :references {} :occurrences (list) :expansions (list) :native-obligations (list)}
       result (expression-node (s/for-compiler (first forms) (or file "<expression>")) state) state (elem result 1)]
  {:version 1 :kind :expanded-expression :reader (elem result 0)
   :selection (b/freeze (:selection state)) :references (:references state)
   :occurrences (Enum/reverse (:occurrences state)) :expansions (Enum/reverse (:expansions state))
   :native-obligations (Enum/reverse (:native-obligations state))
   :coverage {:contextual-bindings true :binding-annotations true :native-effects-complete false}}))

(defn compile-expression
 "Compile elaborated local expressions through the existing ANF compiler.
  Global binding lowering is gated until the canonical bound-reference adapter
  can retain selected world identity; it never falls back to ambient Env."
 [source file options]
 (let [expanded (expression source file options)]
  (when (Enum/any? (Map/values (:references expanded))
          #(not= :local (get-in % [:declaration :visibility])))
   (refuse! :contextual-global-lowering-unavailable nil))
  (assoc expanded :node
    (compiler/compile-contextual (:reader expanded)
      (assoc (BeamLisp.Compiler/new_env (str (:namespace options))) :file file) (:references expanded)))))

(defn- contextualize [node unit]
 (Enum/reduce (get-in unit [:context :scopes :all]) (s/for-compiler node (:file unit)) #(s/add-scope %2 %1 :all)))

(defn- definition-node [recipe unit]
 (let [node (contextualize (:node recipe) unit) children (:children node)
       declaration (:declaration recipe)]
  (if (= :value (:kind declaration))
   (do (when-not (= 3 (count children)) (refuse! :contextual-value-arity node))
       (nth children 2))
   (assoc node :children
     (cons (s/identifier 'fn (:context node))
           (if (= :syntax (:kind declaration)) (Enum/drop children 2) (rest children)))))))

(declare link-reference)

(defn- link-dependencies [dependencies state]
 (Enum/reduce (Enum/sort (Map/to_list dependencies)) state
  (fn [entry current] (link-reference (elem entry 0) (elem entry 1) current))))

(defn- wrap-links [reader state]
 (if (empty? (:link-order state)) reader
  (tuple :list
   (list (tuple :symbol "let")
         (tuple :vector (Enum/flat_map (Enum/reverse (:link-order state))
                           (fn [name] (list (symbol name) (get (:linked state) name))))) reader))))

(defn- in-definition [recipe reference state transformer?]
 (let [unit (Map/fetch! (get-in state [:catalog :worlds]) (:world recipe))
       declaration (:declaration recipe)
       phase (+ (:phase declaration) (if transformer? 1 0))
       target-phase (+ (:phase reference) (if transformer? 1 0))
       current (assoc state :world (:world recipe) :namespace (:namespace declaration)
                            :phase phase :position (:position recipe)
                            :reference-shift (- target-phase phase) :transformer transformer? :dependencies {}
                            :coordinate-prefix (Enum/concat (list 3 (+ phase 4096)) (:path declaration))
                            :next-scope 0 :next-declaration 0)
       r (expression-node (definition-node recipe unit) current)
       fields [:world :namespace :phase :position :reference-shift :transformer :dependencies
               :coordinate-prefix :next-scope :next-declaration]
       restored (Enum/reduce fields (elem r 1)
                  (fn [key out] (assoc out key (get state key))))]
  (tuple (elem r 0) (:dependencies (elem r 1)) restored)))

(defn- link-reference [name descriptor state]
 (if (contains? (:linked state) name) state
  (if-let [constant (get-in state [:constant-readers name])]
   (-> state (assoc-in [:linked name] constant) (update :link-order #(cons name %)))
  (do
   (when (contains? (:link-active state) name) (refuse! :contextual-initialization-cycle nil))
   (when (>= (erlang/map_size (:link-active state)) 128) (refuse! :contextual-link-depth nil))
   (let [reference (:reference descriptor)
         recipe (get-in state [:catalog :recipes (:declaration reference)])]
    (when-not recipe (refuse! :contextual-definition-missing nil))
    (when-not (contains? #{:function :value} (get-in recipe [:declaration :kind]))
     (refuse! :contextual-runtime-transformer nil))
    (let [r (in-definition recipe reference (assoc-in state [:link-active name] true) false)
          state (link-dependencies (elem r 1) (elem r 2))
          unit (get-in state [:catalog :worlds (:world recipe)])
          ;; Closed profile values are first-order constants. Evaluate once,
          ;; under the same effect-denying budget as transformers, then embed
          ;; literal data. No duplicated module initialization or hidden effects.
          reader (if (= :value (get-in recipe [:declaration :kind]))
                   (quote-reader
                    (BeamLisp.AOT/eval_constructor_session! (:constructor-session state)
                     (compile-reader (wrap-links (elem r 0) state) (:namespace unit) (:file unit) (:references state)) {})
                    (:context unit)) (elem r 0))]
     (-> (if (= :value (get-in recipe [:declaration :kind]))
           (assoc-in state [:constant-readers name] reader) state)
               (assoc-in [:linked name] reader)
               (update :link-order #(cons name %))
               (update :link-active #(dissoc % name)))))))))

(defn- compile-reader [reader namespace file references]
 (compiler/compile-contextual reader
  (assoc (BeamLisp.Compiler/new_env (str namespace)) :file file) references))

(defn- demand-transformer [reference state]
 (let [key (:id reference)]
  (if-let [cached (get-in state [:transformers key])]
   (tuple cached state)
   (let [recipe (get-in state [:catalog :recipes (:declaration reference)])]
    (when-not (= :syntax (get-in recipe [:declaration :kind]))
     (refuse! :contextual-transformer-missing nil))
    (when (contains? (:transformer-active state) key) (refuse! :contextual-transformer-cycle nil))
    (let [r (in-definition recipe reference
              (assoc state :linked {} :link-order (list) :link-active {}
                           :transformer-active (assoc (:transformer-active state) key true)) true)
          linked (link-dependencies (elem r 1) (elem r 2))
          unit (get-in state [:catalog :worlds (:world recipe)])
          node (compile-reader (wrap-links (elem r 0) linked) (:namespace unit) (:file unit) (:references linked))
          restored (-> linked (assoc :linked (:linked state) :link-order (:link-order state)
                                     :link-active (:link-active state)
                                     :transformer-active (:transformer-active state))
                              (assoc-in [:transformers key] node))]
     (tuple node restored))))))

(defn phase-library
 "Produce portable first-order contextual recipes for source-free imports."
 [sources] (catalog/library sources))

(defn program
 "Compile a closed syntax-v1 source catalog. :entry is [namespace revision],
  both quoted symbols. Source imports select revisions explicitly. Global
  definitions link lexically from those exact Reader-derived recipes; Env is
  never a fallback. Transformers use the existing bounded ANF constructor."
 ([sources entry] (program sources entry []))
 ([sources entry libraries]
 (let [catalog (catalog/catalog sources libraries)
       entry (BeamLisp.CompilerData/eager_to_list entry)
       _ (when-not (= 2 (count entry)) (refuse! :contextual-entry nil))
       unit (catalog/unit catalog (first entry) (second entry))
       _ (Enum/each (Map/values (:units catalog))
           (fn [other]
            (when (and (not= (tuple (:namespace other) (:revision other))
                              (tuple (:namespace unit) (:revision unit)))
                       (not (empty? (:expressions other))))
             (refuse! :contextual-provider-expression (:node (first (:expressions other)))))))
       expressions (:expressions unit)
       _ (when-not (and (= 1 (count expressions)) (= 0 (:phase (first expressions))))
           (refuse! :contextual-entry-expression-count nil))
       expression (first expressions)
       session (BeamLisp.AOT/open_constructor_session!)]
  (try
   (let [state {:catalog catalog :constructor-session session :selection (:selection catalog) :world (get-in unit [:world :key])
              :namespace (:namespace unit) :phase 0 :position (:position expression) :reference-shift 0
              :next-scope 0 :next-declaration 0 :remaining 1000000 :macro-budget 128 :macro-depth 0 :transformer false
              :references {} :dependencies {} :occurrences (list) :expansions (list)
              :native-obligations (list) :linked {} :link-order (list) :link-active {}
              :transformers {} :transformer-active {}}
       r (expression-node (contextualize (:node expression) unit) state)
       state (link-dependencies (:dependencies (elem r 1)) (elem r 1))
       reader (wrap-links (elem r 0) state)
       node (compile-reader reader (:namespace unit) (:file unit) (:references state))]
  {:version 1 :kind :expanded-program :profile 'syntax-v1 :entry entry :reader reader :node node
   :selection (b/freeze (:selection state)) :references (:references state)
   :occurrences (Enum/reverse (:occurrences state)) :expansions (Enum/reverse (:expansions state))
   :native-obligations (Enum/reverse (:native-obligations state))
   :linked (Enum/reverse (:link-order state)) :transformers (:transformers state)
   :constructor (assoc (BeamLisp.AOT/constructor_session_status session) :status :closed)
   :coverage {:contextual-bindings true :closed-global-linking true :binding-annotations true
              :native-effects-complete false :legacy-datum-macros false}})
   (finally (BeamLisp.AOT/close_constructor_session! session))))))
