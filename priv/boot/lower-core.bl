;; Core values and their per-compilation name supply. Keep this leaf before
;; lower in the boot dependency graph: lower is itself used during its build.
(ns lower-core)

(defn reset-fresh! [] (erlang/put :bl_core_fresh_seq 0) nil)

(defn fresh [prefix]
 (let [current (erlang/get :bl_core_fresh_seq)
       next (erlang/+ (if (erlang/=:= current :undefined) 0 current) 1)]
  (erlang/put :bl_core_fresh_seq next)
  (cerl/c_var (erlang/binary_to_atom (str prefix "_ce" next)))))

(defn- operands
 "Bind compound call operands in source order within their current region.
  A Core BIF may be classified as nonthrowing; a throwing call nested in its
  operands can then escape a try unless the operand is bound explicitly.
  Literal/variable operands already satisfy that contract."
 [trees build]
 (let [result (Enum/map_reduce (BeamLisp.CompilerData/eager_to_list trees) (list)
               (fn [tree bindings]
                (if (contains? #{:var :literal} (cerl/type tree))
                 (tuple tree bindings)
                 (let [value (fresh "operand")]
                  (tuple value (cons (tuple value tree) bindings))))))]
  (Enum/reduce (elem result 1) (build (elem result 0))
   (fn [binding body] (cerl/c_let (list (elem binding 0)) (elem binding 1) body)))))

(defn call [module function args]
 (operands args (fn [values] (cerl/c_call (cerl/c_atom module) (cerl/c_atom function) values))))

(defn apply [function args]
 (operands (cons function (BeamLisp.CompilerData/eager_to_list args))
  (fn [values] (cerl/c_apply (first values) (rest values)))))

(defn annotate-call
 "Keep the source location on the call beneath its operand bindings too.
  Let annotations alone do not give the eventual failing BIF a line entry."
 [tree annotations]
 (if (= :let (cerl/type tree))
  (cerl/update_c_let tree (cerl/let_vars tree) (cerl/let_arg tree)
   (annotate-call (cerl/let_body tree) annotations))
  (cerl/set_ann tree annotations)))
