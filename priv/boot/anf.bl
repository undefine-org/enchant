; boot/anf.bl — bl-ANF: the backend-neutral IR.
;
; Graduated from priv/self/anf.bl to the boot tier in PLAN-086 E1: compiler.bl
; emits this vocabulary directly (S-D.emit), so it must live at the tier the
; compiler can require. The reference interpreter (the self-referential
; oracle) stays behind in priv/self/anf.bl.
;
; ── What this is ─────────────────────────────────────────────────────────────
;
; priv/boot/compiler.bl resolves every symbol and expands every macro, then
; emits this small closed vocabulary — self-describing, backend-neutral DATA.
; It is the single IR the toolbench reads and the Core backend consumes:
;
;     compiler.bl → bl-ANF → lower.bl  → Core Erlang → .beam
;
; ── Shape ────────────────────────────────────────────────────────────────────
;
; A node is a map {:op <keyword> …operands… :ann <map>}. `:ann` carries
; types (from typed), effects (from footprint) and source positions; every
; constructor threads it, so nothing downstream has to reshape a node to
; annotate it.
;
; ── The vocabulary ───────────────────────────────────────────────────────────
;
;   :lit    {:val v}                          number/string/atom/nil/true/false
;   :var    {:name "x"}                        a lexical local
;   :global {:ns "user" :name "inc"}           an Env.fetch! var reference
;   :remote {:mod :erlang :fun :+ :args [n…]}  a host call M:f(args)
;           Internal erlang:raise/3 rethrows carry :stack-format :raw.
;   :js     {:kind :global|:new|:call|:method|:get|:index|:set|:array|:object|:to-js|:to-bl|:undefined?|:helper
;            :args [n…] :path string? :property string? :keys [string…]? :helper string?}
;           Native JS operations, allowed only in annotated JS-target namespaces.
;   :arith  {:fun :add :bif :+ :args [n n]}    a 2-arity core numeric op: the
;                                   BeamLisp.Num name and the BIF it is on
;                                   int/float. The int/decimal dispatch is NOT
;                                   a node — it exists only in lower.bl, at
;                                   emission, so analyses at this tier read the
;                                   arithmetic itself (the :arith cutover).
;   :apply  {:fn n :args [n…]}                 call a fn VALUE
;   :invoke {:callee n :arguments list-node}   language callable dispatch
;   :let    {:name "x" :init n :body n}        one binding (ANF core)
;   :if     {:test n :then n :else n}          bl truthiness (nil/false → else)
;   :do     {:stmts [n…]}                      sequence, value = last
;   :case   {:subj n :clauses [clause…]}       pattern match
;   :fn     {:clauses [clause…]}               a closure (params are patterns)
;   :try    {:body n :catch [clause…] :after n|nil}
;   :recv   {:clauses [clause…] :timeout n|nil :after n|nil}
;   :tuple  {:elems [n…]}                      an Erlang tuple
;   :map    {:pairs [[n n]…]}
;   :cons   {:head n :tail n}     :enil {}     list cells
;   :struct {:mod M :fields [[n n]…]}          %Mod{…}
;
; A `clause` is {:pats [pat…] :guard n|nil :body n}. A `pat`:
;   :pvar {:name} :plit {:val} :ptuple {:elems} :pmap {:pairs [[key pat]…]}
;   :pcons {:head :tail} :pnil {} :palias {:a :b} :pstruct {:mod :fields}

(ns anf)


;; Compiler-owned collections are finite and never introduce LazySeq handles.
;; ── finite-* eager wrappers ──────────────────────────────────────────────
;; Local eager wrappers have distinct names (finite-map, finite-concat, etc.) so
;; old seed functions during bootstrap won't shadow them with core helpers when
;; trying to resolve the call site.
(defn- finite-map
  ([f xs] (BeamLisp.CompilerData/eager_map f xs))
  ([f xs ys] (BeamLisp.CompilerData/eager_map f xs ys)))
(defn- finite-map-indexed [f xs] (BeamLisp.CompilerData/eager_map_indexed f xs))
(defn- finite-concat [& xs] (BeamLisp.CompilerData/eager_concat xs))

;; ── constructors (every node threads an :ann, default {}) ────────────────────

(defn- binding-reference? [value]
 ;; Native finite-data shape owner also serves artifact admission before boot.
 ;; This is never semantic selection, Source authentication or native authority.
 (BeamLisp.CompilerData/binding_reference? value))

(defn binding-value
 "An unresolved selected global value. No mutable namespace lookup or physical
  address is implied; a unit linker must bind it before executable emission."
 [reference]
 (when-not (binding-reference? reference)
  (throw (ex-info "Invalid ANF binding reference" {:kind :invalid-anf-binding-reference})))
 {:op :binding :reference reference :ann {}})

(defn reference-of
 "Executable binding identity is a field on :binding. Its annotations cannot
  override it. Lexical references retain the compiler's existing annotations."
 [node]
 (if (= :binding (:op node)) (:reference node) (get-in node [:ann :binding-reference])))

(defn lit [v] {:op :lit :val v :ann {}})
(defn var [name] {:op :var :name name :ann {}})
(defn global [ns name] {:op :global :ns ns :name name :ann {}})
(defn global-exact [ns name] {:op :global :ns ns :name name :lookup :exact :ann {}})
(defn remote [mod fun args] {:op :remote :mod mod :fun fun :args args :ann {}})
(defn invoke [callee arguments] {:op :invoke :callee callee :arguments arguments :ann {}})
(defn arith
  "A 2-arity core numeric op at the CANONICAL tier: `fun` is the BeamLisp.Num
   name (:add :sub :mul :div :lt :gt :le :ge :num_eq), `bif` the Erlang BIF it
   is on int/float, `args` the two operand nodes. The int/decimal DISPATCH is
   not here — it appears only at lowering (lower.bl), so every analysis reads
   the arithmetic itself, never the compiler's is_map scaffold."
  [fun bif args]
  {:op :arith :fun fun :bif bif :args args :ann {}})
(defn app [f args] {:op :apply :fn f :args args :ann {}})
(defn lett [name init body] {:op :let :name name :init init :body body :ann {}})
(defn iff [test then else] {:op :if :test test :then then :else else :ann {}})
(defn doo [stmts] {:op :do :stmts stmts :ann {}})
(defn casee [subj clauses] {:op :case :subj subj :clauses clauses :ann {}})
(defn fnn [clauses] {:op :fn :clauses clauses :ann {}})
(defn tryy [body catch after] {:op :try :body body :catch catch :after after :ann {}})
(defn recv [clauses timeout after] {:op :recv :clauses clauses :timeout timeout :after after :ann {}})
(defn tup [elems] {:op :tuple :elems elems :ann {}})
(defn mapp [pairs] {:op :map :pairs pairs :ann {}})
(defn cons-cell [h t] {:op :cons :head h :tail t :ann {}})
; Compiler implementation must never fetch mutable namespace value bindings to
; build its own IR. Pure functions compile to exact native calls and remain
; correct in isolated declaration scopes that mask ordinary Source values.
(defn empty-list-node [] {:op :enil :ann {}})
(def enil {:op :enil :ann {}})
(defn structt [mod fields] {:op :struct :mod mod :fields fields :ann {}})
(defn clause [pats guard body] {:pats pats :guard guard :body body})

(defn callable-invocation
 "Read a language invocation, distinct from an authored host remote. The
  packed argument list may itself be computed; annotations grant no meaning."
 [node]
 (when (and (map? node) (= :invoke (:op node)))
  {:callee (:callee node) :arguments (:arguments node)}))

;; The grammar owns executable children for both production and analysis.
;; Literal payloads and pattern binders are inert; map-pattern keys are ANF
;; expressions (the same operands Lower emits). Every result is an eager list.
(defn pattern-vars
 "Variable names in a checked pattern; keys and literal data do not bind."
 [pattern]
 (case (:pop pattern)
  :pvar (list (:name pattern))
  :ptuple (BeamLisp.CompilerData/eager_mapcat pattern-vars (:elems pattern))
  :pcons (finite-concat (pattern-vars (:head pattern)) (pattern-vars (:tail pattern)))
  :palias (finite-concat (pattern-vars (:a pattern)) (pattern-vars (:b pattern)))
  :pmap (BeamLisp.CompilerData/eager_mapcat (fn [pair] (pattern-vars (second pair))) (:pairs pattern))
  :pstruct (BeamLisp.CompilerData/eager_mapcat (fn [pair] (pattern-vars (second pair))) (:fields pattern))
  (list)))

(defn pattern-expressions
 "Executable map keys nested inside a pattern; binding/literal data stay inert."
 [pattern]
 (case (:pop pattern)
  :pmap (BeamLisp.CompilerData/eager_mapcat
          (fn [pair] (cons (first pair) (pattern-expressions (second pair)))) (:pairs pattern))
  :pstruct (BeamLisp.CompilerData/eager_mapcat
             (fn [pair] (pattern-expressions (second pair))) (:fields pattern))
  :ptuple (BeamLisp.CompilerData/eager_mapcat pattern-expressions (:elems pattern))
  :pcons (finite-concat (pattern-expressions (:head pattern)) (pattern-expressions (:tail pattern)))
  :palias (finite-concat (pattern-expressions (:a pattern)) (pattern-expressions (:b pattern)))
  :pvar (list) :plit (list) :pnil (list)
  (throw (ex-info "Unknown executable ANF pattern" {:kind :unknown-executable-pattern :pop (:pop pattern)}))))

(defn- executable-clause-children [clauses]
 (BeamLisp.CompilerData/eager_mapcat
  (fn [clause]
   (finite-concat
    (BeamLisp.CompilerData/eager_mapcat pattern-expressions (:pats clause))
    (if (nil? (:guard clause)) (list (:body clause))
     (list (:guard clause) (:body clause))))) clauses))

(defn- executable-pair-children [pairs]
 (BeamLisp.CompilerData/eager_mapcat (fn [pair] (list (first pair) (second pair))) pairs))

(defn executable-children
 "Immediate executable operands in grammar order, including latent function
  bodies and clause guards. This describes syntax, not unconditional execution
  of every branch. Unknown operations refuse; they never look effect-free."
 [node]
 (when-not (map? node)
  (throw (ex-info "Executable child traversal requires an ANF node" {:kind :invalid-executable-node})))
 (let [op (:op node)
       children
       (cond
        (contains? #{:lit :var :global :binding :enil} op) (list)
        (contains? #{:js :arith :remote} op) (:args node)
        (= :invoke op) (list (:callee node) (:arguments node))
        (= :apply op) (cons (:fn node) (:args node))
        (= :let op) (list (:init node) (:body node))
        (= :if op) (list (:test node) (:then node) (:else node))
        (= :do op) (:stmts node)
        (= :case op) (cons (:subj node) (executable-clause-children (:clauses node)))
        (= :fn op) (executable-clause-children (:clauses node))
        (= :try op) (finite-concat (list (:body node))
                      (executable-clause-children (:catch node)) (list (:after node)))
        (= :recv op) (finite-concat (executable-clause-children (:clauses node))
                       (list (:timeout node) (:after node)))
        (= :tuple op) (:elems node)
        (= :map op) (executable-pair-children (:pairs node))
        (= :struct op) (executable-pair-children (:fields node))
        (= :cons op) (list (:head node) (:tail node))
        :else (throw (ex-info "Unknown executable ANF operation"
                       {:kind :unknown-executable-operation :op op})))]
  (BeamLisp.CompilerData/eager_filter (fn [child] (erlang/not (erlang/== nil child))) children)))

;; pattern constructors
(defn pvar [name] {:pop :pvar :name name})
(defn plit [v] {:pop :plit :val v})
(defn ptuple [elems] {:pop :ptuple :elems elems})
(defn pmap [pairs] {:pop :pmap :pairs pairs})
(defn pcons [h t] {:pop :pcons :head h :tail t})
(defn empty-list-pattern [] {:pop :pnil})
(def pnil {:pop :pnil})
(defn palias [a b] {:pop :palias :a a :b b})
(defn pstruct [mod fields] {:pop :pstruct :mod mod :fields fields})

;; ── complete module descriptor boundary ────────────────────────────────────

(defn- boundary-error [m f path message value]
  (throw (ex-info (str "anf module " (:name m)
                       (if (nil? f) "" (str " " (first f) "/" (second f)))
                       " at " path ": " message)
                  {:module (:name m) :function f :path path :value value})))

(defn- exact-keys? [m ks]
  (and (map? m) (= (erlang/map_size m) (erlang/length (to-list ks)))
       (Enum/all? ks (fn [k] (maps/is_key k m)))))

(defn- eager-list [x field]
  (if (or (erlang/is_list x) (BeamLisp.Ns.Rt/vector? x))
    (to-list x)
    (throw (ex-info (str "anf/module: " field " must be a list or vector")
                    {:path field :value x}))))

(defn- literal-data? [v]
  (cond
    (erlang/is_function v) false
    (erlang/is_tuple v) (Enum/all? (erlang/tuple_to_list v) (fn [value] (literal-data? value)))
    (erlang/is_list v) (Enum/all? v (fn [value] (literal-data? value)))
    (BeamLisp.Ns.Rt/vector? v) (Enum/all? (to-list v) (fn [value] (literal-data? value)))
    ; is_map-ok: Core literals include plain data structs, but never resources or thunks.
    (erlang/is_map v) (Enum/all? (maps/keys v) (fn [k] (and (literal-data? k) (literal-data? (maps/get k v)))))
    :else (or (erlang/is_atom v) (erlang/is_number v) (erlang/is_bitstring v))))

(declare validate-node!)
(declare validate-pattern!)

(defn- validate-ann! [m f path ann]
  (when (not (map? ann)) (boundary-error m f path "annotation must be a map" ann)))

(defn- validate-seq! [m f path xs each]
  (when (not (erlang/is_list xs)) (boundary-error m f path "must be a proper list" xs))
  (doseq [[i x] (finite-map-indexed (fn [i x] [i x]) xs)] (each x (str path "[" i "]"))))

(defn- validate-pairs! [m f path pairs key-check val-check]
  (validate-seq! m f path pairs
    (fn [pair p]
      (when (or (not (or (BeamLisp.Ns.Rt/vector? pair) (erlang/is_list pair))) (not= 2 (count pair)))
        (boundary-error m f p "pair must contain exactly two values" pair))
      (key-check (first pair) (str p "[0]"))
      (val-check (second pair) (str p "[1]")))))

(defn- validate-pattern! [m f p path]
  (when (not (map? p)) (boundary-error m f path "pattern must be a map" p))
  (let [op (:pop p)]
    (cond
      (= op :pvar) (when (or (not (exact-keys? p [:pop :name])) (not (erlang/is_binary (:name p))))
                     (boundary-error m f path "pvar requires only binary :name" p))
      (= op :plit) (when (or (not (exact-keys? p [:pop :val])) (not (literal-data? (:val p))))
                     (boundary-error m f path "plit requires safe literal :val" p))
      (= op :pnil) (when (not (exact-keys? p [:pop])) (boundary-error m f path "pnil has no operands" p))
      (= op :ptuple) (do (when (not (exact-keys? p [:pop :elems])) (boundary-error m f path "invalid ptuple fields" p))
                          (validate-seq! m f (str path ".elems") (:elems p) (fn [x q] (validate-pattern! m f x q))))
      (= op :pcons) (do (when (not (exact-keys? p [:pop :head :tail])) (boundary-error m f path "invalid pcons fields" p))
                         (validate-pattern! m f (:head p) (str path ".head")) (validate-pattern! m f (:tail p) (str path ".tail")))
      (= op :palias) (do (when (not (exact-keys? p [:pop :a :b])) (boundary-error m f path "invalid palias fields" p))
                          (validate-pattern! m f (:a p) (str path ".a")) (validate-pattern! m f (:b p) (str path ".b")))
      (= op :pmap) (do (when (not (exact-keys? p [:pop :pairs])) (boundary-error m f path "invalid pmap fields" p))
                        (validate-pairs! m f (str path ".pairs") (:pairs p)
                          (fn [x q] (validate-node! m f x q)) (fn [x q] (validate-pattern! m f x q))))
      (= op :pstruct) (do (when (or (not (exact-keys? p [:pop :mod :fields])) (not (erlang/is_atom (:mod p))))
                            (boundary-error m f path "pstruct requires atom :mod and :fields" p))
                          (validate-pairs! m f (str path ".fields") (:fields p)
                            (fn [x q] (when (not (literal-data? x)) (boundary-error m f q "unsafe literal field key" x)))
                            (fn [x q] (validate-pattern! m f x q))))
      :else (boundary-error m f (str path ".pop") "unknown pattern op" op))))

(defn- validate-inner-clause! [m f cl path]
  (when (not (exact-keys? cl [:pats :guard :body])) (boundary-error m f path "clause fields must be :pats/:guard/:body" cl))
  (validate-seq! m f (str path ".pats") (:pats cl) (fn [x q] (validate-pattern! m f x q)))
  (when (some? (:guard cl)) (validate-node! m f (:guard cl) (str path ".guard")))
  (validate-node! m f (:body cl) (str path ".body")))

(defn- validate-node! [m f n path]
  (when (not (map? n)) (boundary-error m f path "executable node must be an ANF map, not quoted AST" n))
  (validate-ann! m f (str path ".ann") (:ann n))
  (let [op (:op n) node (fn [x p] (validate-node! m f x p))
        nodes (fn [xs p] (validate-seq! m f p xs (fn [x q] (node x q))))]
    (cond
      (= op :lit) (when (or (not (exact-keys? n [:op :val :ann])) (not (literal-data? (:val n)))) (boundary-error m f path "invalid literal or fields" n))
      (= op :var) (when (or (not (exact-keys? n [:op :name :ann])) (not (erlang/is_binary (:name n)))) (boundary-error m f path "var requires binary :name" n))
      (= op :binding) (when-not (and (exact-keys? n [:op :reference :ann]) (binding-reference? (:reference n)))
                        (boundary-error m f path "binding requires a finite selected reference" n))
      (= op :global) (when (or (not (or (exact-keys? n [:op :ns :name :ann]) (and (exact-keys? n [:op :ns :name :lookup :ann]) (= :exact (:lookup n))))) (not (erlang/is_binary (:ns n))) (not (erlang/is_binary (:name n)))) (boundary-error m f path "global requires binary :ns/:name" n))
      (= op :remote)
        (do
          (when (or
                  (not (or (exact-keys? n [:op :mod :fun :args :ann])
                           (and (exact-keys? n [:op :mod :fun :args :stack-format :ann])
                                (= :erlang (:mod n)) (= :raise (:fun n))
                                (= :raw (:stack-format n)) (erlang/is_list (:args n))
                                (= 3 (count (:args n))))))
                  (not (erlang/is_atom (:mod n))) (not (erlang/is_atom (:fun n))))
            (boundary-error m f path "remote requires atom :mod/:fun and :args; raw stacks belong to internal erlang:raise/3" n))
          (nodes (:args n) (str path ".args")))
      (= op :arith) (do (when (or (not (exact-keys? n [:op :fun :bif :args :ann])) (not (erlang/is_atom (:fun n))) (not (erlang/is_atom (:bif n))) (not= 2 (count (:args n)))) (boundary-error m f path "arith requires atom :fun/:bif and exactly 2 :args" n)) (nodes (:args n) (str path ".args")))
      (= op :invoke) (do (when (not (exact-keys? n [:op :callee :arguments :ann])) (boundary-error m f path "invalid invoke fields" n)) (node (:callee n) (str path ".callee")) (node (:arguments n) (str path ".arguments")))
      (= op :apply) (do (when (not (exact-keys? n [:op :fn :args :ann])) (boundary-error m f path "invalid apply fields" n)) (node (:fn n) (str path ".fn")) (nodes (:args n) (str path ".args")))
      (= op :let) (do (when (or (not (exact-keys? n [:op :name :init :body :ann])) (not (erlang/is_binary (:name n)))) (boundary-error m f path "invalid let fields" n)) (node (:init n) (str path ".init")) (node (:body n) (str path ".body")))
      (= op :if) (do (when (not (exact-keys? n [:op :test :then :else :ann])) (boundary-error m f path "invalid if fields" n)) (node (:test n) (str path ".test")) (node (:then n) (str path ".then")) (node (:else n) (str path ".else")))
      (= op :do) (do (when (not (exact-keys? n [:op :stmts :ann])) (boundary-error m f path "invalid do fields" n)) (nodes (:stmts n) (str path ".stmts")) (when (empty? (:stmts n)) (boundary-error m f (str path ".stmts") "do requires at least one statement" (:stmts n))))
      (or (= op :case) (= op :fn)) (do (when (not (exact-keys? n (if (= op :case) [:op :subj :clauses :ann] [:op :clauses :ann]))) (boundary-error m f path "invalid clause-bearing node fields" n)) (when (= op :case) (node (:subj n) (str path ".subj"))) (validate-seq! m f (str path ".clauses") (:clauses n) (fn [x q] (validate-inner-clause! m f x q))))
      (= op :try) (do (when (not (exact-keys? n [:op :body :catch :after :ann])) (boundary-error m f path "invalid try fields" n)) (node (:body n) (str path ".body")) (validate-seq! m f (str path ".catch") (:catch n) (fn [x q] (validate-inner-clause! m f x q))) (when (some? (:after n)) (node (:after n) (str path ".after"))))
      (= op :recv) (do (when (not (exact-keys? n [:op :clauses :timeout :after :ann])) (boundary-error m f path "invalid recv fields" n)) (validate-seq! m f (str path ".clauses") (:clauses n) (fn [x q] (validate-inner-clause! m f x q))) (if (nil? (:timeout n)) (when (some? (:after n)) (boundary-error m f (str path ".after") "receive after requires timeout" (:after n))) (do (node (:timeout n) (str path ".timeout")) (node (:after n) (str path ".after")))))
      (or (= op :tuple) (= op :enil)) (do (when (not (exact-keys? n (if (= op :tuple) [:op :elems :ann] [:op :ann]))) (boundary-error m f path "invalid tuple/list fields" n)) (when (= op :tuple) (nodes (:elems n) (str path ".elems"))))
      (= op :map) (do (when (not (exact-keys? n [:op :pairs :ann])) (boundary-error m f path "invalid map fields" n)) (validate-pairs! m f (str path ".pairs") (:pairs n) node node))
      (= op :cons) (do (when (not (exact-keys? n [:op :head :tail :ann])) (boundary-error m f path "invalid cons fields" n)) (node (:head n) (str path ".head")) (node (:tail n) (str path ".tail")))
      (= op :struct) (do (when (or (not (exact-keys? n [:op :mod :fields :ann])) (not (erlang/is_atom (:mod n)))) (boundary-error m f path "struct requires atom :mod and :fields" n)) (validate-pairs! m f (str path ".fields") (:fields n) node node))
      :else (boundary-error m f (str path ".op") "unknown executable op" op))))

;; ── fast acceptance ─────────────────────────────────────────────────────────
;;
;; The checked boundary above builds a JSON-ish PATH string (`$.clauses[3].body…`)
;; for every node it visits, so the message of a refusal can name the place.
;; Measured: that path construction, not the checks, was a third of compiling
;; the boot tier — every per-definition body module, every shim and every
;; optimized descriptor crosses this boundary, and almost all of them are valid.
;;
;; So acceptance runs first, path-free and allocation-free: the SAME rules in
;; the same order, answering only true/false. Any false falls back to the
;; original path-building walk, which then raises the original error with the
;; original message. A valid descriptor costs one cheap walk; an invalid one
;; costs both, and its refusal is byte-identical to before.

(defn- has-keys? [m ks]
  (if (erlang/== ks (list)) true
    (if (erlang/is_map_key (erlang/hd ks) m) (has-keys? m (erlang/tl ks)) false)))

(defn- keys-exactly? [m n ks]
  (and (erlang/is_map m) (erlang/== n (erlang/map_size m)) (has-keys? m ks)))

(defn- plain-map?
  "A plain (non-struct) map. Stricter than `map?` on purpose: anything else
   falls back to the checked walk, which answers exactly as before."
  [x]
  (and (erlang/is_map x) (erlang/not (erlang/is_map_key :__struct__ x))))

(declare node-ok?)
(declare pattern-ok?)
(declare inner-clause-ok?)

;; Walkers name their element check DIRECTLY. A check passed as a value is
;; resolved through its var, and the boot tier validates descriptors while this
;; namespace's own vars are still being seeded (nil is not a function).
(defn- nodes-ok? [xs]
  (if (erlang/== xs (list)) true
    (and (node-ok? (erlang/hd xs)) (nodes-ok? (erlang/tl xs)))))
(defn- patterns-ok? [xs]
  (if (erlang/== xs (list)) true
    (and (pattern-ok? (erlang/hd xs)) (patterns-ok? (erlang/tl xs)))))
(defn- clauses-ok? [xs]
  (if (erlang/== xs (list)) true
    (and (inner-clause-ok? (erlang/hd xs)) (clauses-ok? (erlang/tl xs)))))
(defn- pair? [pair]
  (and (or (BeamLisp.Ns.Rt/vector? pair) (erlang/is_list pair)) (erlang/== 2 (count pair))))
(defn- nn-pairs-ok? [xs]
  (if (erlang/== xs (list)) true
    (let [p (erlang/hd xs)]
      (and (pair? p) (node-ok? (first p)) (node-ok? (second p)) (nn-pairs-ok? (erlang/tl xs))))))
(defn- np-pairs-ok? [xs]
  (if (erlang/== xs (list)) true
    (let [p (erlang/hd xs)]
      (and (pair? p) (node-ok? (first p)) (pattern-ok? (second p)) (np-pairs-ok? (erlang/tl xs))))))
(defn- lp-pairs-ok? [xs]
  (if (erlang/== xs (list)) true
    (let [p (erlang/hd xs)]
      (and (pair? p) (literal-data? (first p)) (pattern-ok? (second p)) (lp-pairs-ok? (erlang/tl xs))))))

(defn- pattern-ok? [p]
  (and (erlang/is_map p)
    (let [op (maps/get :pop p nil)]
      (cond
        (erlang/== op :pvar) (and (keys-exactly? p 2 '(:pop :name)) (erlang/is_binary (maps/get :name p)))
        (erlang/== op :plit) (and (keys-exactly? p 2 '(:pop :val)) (literal-data? (maps/get :val p)))
        (erlang/== op :pnil) (keys-exactly? p 1 '(:pop))
        (erlang/== op :ptuple) (and (keys-exactly? p 2 '(:pop :elems)) (and (erlang/is_list (maps/get :elems p)) (patterns-ok? (maps/get :elems p))))
        (erlang/== op :pcons) (and (keys-exactly? p 3 '(:pop :head :tail))
                                   (pattern-ok? (maps/get :head p)) (pattern-ok? (maps/get :tail p)))
        (erlang/== op :palias) (and (keys-exactly? p 3 '(:pop :a :b))
                                    (pattern-ok? (maps/get :a p)) (pattern-ok? (maps/get :b p)))
        (erlang/== op :pmap) (and (keys-exactly? p 2 '(:pop :pairs)) (and (erlang/is_list (maps/get :pairs p)) (np-pairs-ok? (maps/get :pairs p))))
        (erlang/== op :pstruct) (and (keys-exactly? p 3 '(:pop :mod :fields)) (erlang/is_atom (maps/get :mod p))
                                     (and (erlang/is_list (maps/get :fields p)) (lp-pairs-ok? (maps/get :fields p))))
        :else false))))

(defn- inner-clause-ok? [cl]
  (and (keys-exactly? cl 3 '(:pats :guard :body))
       (and (erlang/is_list (maps/get :pats cl)) (patterns-ok? (maps/get :pats cl)))
       (or (nil? (maps/get :guard cl)) (node-ok? (maps/get :guard cl)))
       (node-ok? (maps/get :body cl))))

(defn- node-ok? [n]
  (and (erlang/is_map n) (erlang/is_map_key :op n) (erlang/is_map_key :ann n) (plain-map? (maps/get :ann n))
    (let [op (maps/get :op n)]
      (cond
        (erlang/== op :lit) (and (keys-exactly? n 3 '(:op :val :ann)) (literal-data? (maps/get :val n)))
        (erlang/== op :var) (and (keys-exactly? n 3 '(:op :name :ann)) (erlang/is_binary (maps/get :name n)))
        (erlang/== op :binding) (and (keys-exactly? n 3 '(:op :reference :ann)) (binding-reference? (maps/get :reference n)))
        (erlang/== op :global) (and (or (keys-exactly? n 4 '(:op :ns :name :ann))
                                        (and (keys-exactly? n 5 '(:op :ns :name :lookup :ann)) (erlang/== :exact (maps/get :lookup n))))
                                    (erlang/is_binary (maps/get :ns n)) (erlang/is_binary (maps/get :name n)))
        (erlang/== op :remote) (and (or (keys-exactly? n 5 '(:op :mod :fun :args :ann))
                                        (and (keys-exactly? n 6 '(:op :mod :fun :args :stack-format :ann))
                                             (erlang/== :erlang (maps/get :mod n)) (erlang/== :raise (maps/get :fun n))
                                             (erlang/== :raw (maps/get :stack-format n)) (erlang/is_list (maps/get :args n))
                                             (erlang/== 3 (erlang/length (maps/get :args n)))))
                                    (erlang/is_atom (maps/get :mod n)) (erlang/is_atom (maps/get :fun n))
                                    (and (erlang/is_list (maps/get :args n)) (nodes-ok? (maps/get :args n))))
        (erlang/== op :arith) (and (keys-exactly? n 5 '(:op :fun :bif :args :ann)) (erlang/is_atom (maps/get :fun n))
                                   (erlang/is_atom (maps/get :bif n)) (erlang/is_list (maps/get :args n))
                                   (erlang/== 2 (erlang/length (maps/get :args n))) (and (erlang/is_list (maps/get :args n)) (nodes-ok? (maps/get :args n))))
        (erlang/== op :invoke) (and (keys-exactly? n 4 '(:op :callee :arguments :ann))
                                    (node-ok? (maps/get :callee n)) (node-ok? (maps/get :arguments n)))
        (erlang/== op :apply) (and (keys-exactly? n 4 '(:op :fn :args :ann)) (node-ok? (maps/get :fn n))
                                   (and (erlang/is_list (maps/get :args n)) (nodes-ok? (maps/get :args n))))
        (erlang/== op :let) (and (keys-exactly? n 5 '(:op :name :init :body :ann)) (erlang/is_binary (maps/get :name n))
                                 (node-ok? (maps/get :init n)) (node-ok? (maps/get :body n)))
        (erlang/== op :if) (and (keys-exactly? n 5 '(:op :test :then :else :ann)) (node-ok? (maps/get :test n))
                                (node-ok? (maps/get :then n)) (node-ok? (maps/get :else n)))
        (erlang/== op :do) (and (keys-exactly? n 3 '(:op :stmts :ann)) (erlang/is_list (maps/get :stmts n))
                                (erlang/not (erlang/== (list) (maps/get :stmts n))) (and (erlang/is_list (maps/get :stmts n)) (nodes-ok? (maps/get :stmts n))))
        (erlang/== op :case) (and (keys-exactly? n 4 '(:op :subj :clauses :ann)) (node-ok? (maps/get :subj n))
                                  (and (erlang/is_list (maps/get :clauses n)) (clauses-ok? (maps/get :clauses n))))
        (erlang/== op :fn) (and (keys-exactly? n 3 '(:op :clauses :ann)) (and (erlang/is_list (maps/get :clauses n)) (clauses-ok? (maps/get :clauses n))))
        (erlang/== op :try) (and (keys-exactly? n 5 '(:op :body :catch :after :ann)) (node-ok? (maps/get :body n))
                                 (and (erlang/is_list (maps/get :catch n)) (clauses-ok? (maps/get :catch n)))
                                 (or (nil? (maps/get :after n)) (node-ok? (maps/get :after n))))
        (erlang/== op :recv) (and (keys-exactly? n 5 '(:op :clauses :timeout :after :ann))
                                  (and (erlang/is_list (maps/get :clauses n)) (clauses-ok? (maps/get :clauses n)))
                                  (if (nil? (maps/get :timeout n))
                                    (nil? (maps/get :after n))
                                    (and (node-ok? (maps/get :timeout n)) (node-ok? (maps/get :after n)))))
        (erlang/== op :tuple) (and (keys-exactly? n 3 '(:op :elems :ann)) (and (erlang/is_list (maps/get :elems n)) (nodes-ok? (maps/get :elems n))))
        (erlang/== op :enil) (keys-exactly? n 2 '(:op :ann))
        (erlang/== op :map) (and (keys-exactly? n 3 '(:op :pairs :ann)) (and (erlang/is_list (maps/get :pairs n)) (nn-pairs-ok? (maps/get :pairs n))))
        (erlang/== op :cons) (and (keys-exactly? n 4 '(:op :head :tail :ann)) (node-ok? (maps/get :head n))
                                  (node-ok? (maps/get :tail n)))
        (erlang/== op :struct) (and (keys-exactly? n 4 '(:op :mod :fields :ann)) (erlang/is_atom (maps/get :mod n))
                                    (and (erlang/is_list (maps/get :fields n)) (nn-pairs-ok? (maps/get :fields n))))
        :else false))))

(defn- defn-clause-ok? [cl]
  (and (keys-exactly? cl 6 '(:op :fname :params :guard :body :ann))
       (erlang/== :defn-clause (maps/get :op cl))
       (erlang/is_atom (maps/get :fname cl))
       (erlang/not (erlang/== :module_info (maps/get :fname cl)))
       (plain-map? (maps/get :ann cl))
       (erlang/is_list (maps/get :params cl)) (patterns-ok? (maps/get :params cl))
       (or (nil? (maps/get :guard cl)) (node-ok? (maps/get :guard cl)))
       (node-ok? (maps/get :body cl))))

(defn- clause-set
  "The `{fname, arity}` set of valid definition clauses, or nil at the first
   invalid one."
  [cls acc]
  (if (erlang/== cls (list)) acc
    (let [cl (erlang/hd cls)]
      (if (defn-clause-ok? cl)
        (clause-set (erlang/tl cls)
          (maps/put (erlang/list_to_tuple (list (maps/get :fname cl) (erlang/length (maps/get :params cl)))) true acc))
        nil))))

(defn- exports-ok? [es seen acc]
  (if (erlang/== es (list)) true
    (let [e (erlang/hd es)]
      (if (and (BeamLisp.Ns.Rt/vector? e) (erlang/== 2 (count e))
               (erlang/is_atom (first e)) (erlang/is_integer (second e)) (erlang/>= (second e) 0)
               (erlang/not (erlang/== :module_info (first e))))
        (let [k (erlang/list_to_tuple (list (first e) (second e)))]
          (and (erlang/is_map_key k seen) (erlang/not (erlang/is_map_key k acc))
               (exports-ok? (erlang/tl es) seen (maps/put k true acc))))
        false))))

(defn- attrs-ok? [as acc]
  (if (erlang/== as (list)) true
    (let [a (erlang/hd as)]
      (and (BeamLisp.Ns.Rt/vector? a) (erlang/== 2 (count a))
           (erlang/is_atom (first a)) (literal-data? (second a))
           (erlang/not (erlang/is_map_key (first a) {:module true :export true :import true :file true}))
           (erlang/not (erlang/is_map_key (first a) acc))
           (attrs-ok? (erlang/tl as) (maps/put (first a) true acc))))))

(defn- module-ok?
  "Path-free acceptance of a whole descriptor: true only when the checked walk
   would accept it. Direct recursion only — no function values — because the
   boot tier runs this while its own vars are still being seeded."
  [m]
  (and (keys-exactly? m 7 '(:op :version :name :clauses :exports :attrs :ann))
       (erlang/== :module (maps/get :op m)) (erlang/== 1 (maps/get :version m))
       (erlang/is_atom (maps/get :name m)) (plain-map? (maps/get :ann m))
       (erlang/is_list (maps/get :clauses m)) (erlang/is_list (maps/get :exports m))
       (erlang/is_list (maps/get :attrs m))
       (let [seen (clause-set (maps/get :clauses m) {})]
         (and (some? seen)
              (exports-ok? (maps/get :exports m) seen {})
              (attrs-ok? (maps/get :attrs m) {})))))

(declare validate-module-checked!)

(defn validate-module! [m]
  (if (module-ok? m) m (validate-module-checked! m)))

(defn- validate-module-checked! [m]
  (when (not (exact-keys? m [:op :version :name :clauses :exports :attrs :ann]))
    (boundary-error m nil "$" "descriptor has missing or unknown fields" m))
  (when (not= :module (:op m)) (boundary-error m nil "$.op" "must be :module" (:op m)))
  (when (not= 1 (:version m)) (boundary-error m nil "$.version" "unsupported schema version" (:version m)))
  (when (not (erlang/is_atom (:name m))) (boundary-error m nil "$.name" "module name must be an atom" (:name m)))
  (validate-ann! m nil "$.ann" (:ann m))
  (let [seen (atom {})]
    (validate-seq! m nil "$.clauses" (:clauses m)
      (fn [cl path]
        (when (not (exact-keys? cl [:op :fname :params :guard :body :ann])) (boundary-error m nil path "definition fields must be :op/:fname/:params/:guard/:body/:ann" cl))
        (when (not= :defn-clause (:op cl)) (boundary-error m nil (str path ".op") "must be :defn-clause" (:op cl)))
        (when (not (erlang/is_atom (:fname cl))) (boundary-error m nil (str path ".fname") "function name must be an atom" (:fname cl)))
        (validate-ann! m nil (str path ".ann") (:ann cl))
        (let [arity (count (:params cl)) f [(:fname cl) arity]]
          (when (= :module_info (:fname cl)) (boundary-error m f (str path ".fname") "reserved compiler function" (:fname cl)))
          (validate-seq! m f (str path ".params") (:params cl) (fn [x q] (validate-pattern! m f x q)))
          (when (some? (:guard cl)) (validate-node! m f (:guard cl) (str path ".guard")))
          (validate-node! m f (:body cl) (str path ".body"))
          (swap! seen assoc f true))))
    (let [exports-seen (atom {})]
      (validate-seq! m nil "$.exports" (:exports m)
        (fn [e path]
          (when (or (not (BeamLisp.Ns.Rt/vector? e)) (not= 2 (count e)) (not (erlang/is_atom (first e))) (not (erlang/is_integer (second e))) (neg? (second e))) (boundary-error m nil path "export must be [atom nonnegative-integer]" e))
          (let [f [(first e) (second e)]]
            (when (= :module_info (first e)) (boundary-error m f path "reserved compiler export" e))
            (when (get @exports-seen f) (boundary-error m f path "duplicate export" e))
            (when (not (get @seen f)) (boundary-error m f path "export has no matching clause" e))
            (swap! exports-seen assoc f true)))))
    (let [attrs-seen (atom {}) reserved {:module true :export true :import true :file true}]
      (validate-seq! m nil "$.attrs" (:attrs m)
        (fn [a path]
          (when (or (not (BeamLisp.Ns.Rt/vector? a)) (not= 2 (count a)) (not (erlang/is_atom (first a))) (not (literal-data? (second a)))) (boundary-error m nil path "attribute must be [atom Core-literal-compatible-value]" a))
          (when (get reserved (first a)) (boundary-error m nil path "reserved compiler attribute" (first a)))
          (when (get @attrs-seen (first a)) (boundary-error m nil path "duplicate attribute" (first a)))
          (swap! attrs-seen assoc (first a) true))))
    m))

(defn- normalize-grammar [x]
  (cond
    (and (map? x) (or (= :lit (:op x)) (= :plit (:pop x)))) x
    (map? x) (Enum/reduce (maps/keys x) {} (fn [k out] (assoc out k (normalize-grammar (get x k)))))
    (BeamLisp.Ns.Rt/vector? x) (to-list (BeamLisp.CompilerData/eager_map (fn [value] (normalize-grammar value)) (to-list x)))
    (erlang/is_list x) (to-list (BeamLisp.CompilerData/eager_map (fn [value] (normalize-grammar value)) x))
    :else x))

;; Unit linkage rewrites executable operands, including map-pattern keys.
;; Literal payloads, pattern binders and annotations stay inert.
(declare link-node)

(defn map-pattern-expressions
 "Rewrite only executable pattern keys; literal fields and binders stay data."
 [f pattern]
 (case (:pop pattern)
  :pmap (assoc pattern :pairs (finite-map (fn [pair]
                  [(f (first pair)) (map-pattern-expressions f (second pair))]) (:pairs pattern)))
  :pstruct (assoc pattern :fields (finite-map (fn [pair]
                  [(first pair) (map-pattern-expressions f (second pair))]) (:fields pattern)))
  :ptuple (assoc pattern :elems (finite-map (fn [p] (map-pattern-expressions f p)) (:elems pattern)))
  :pcons (assoc pattern :head (map-pattern-expressions f (:head pattern)) :tail (map-pattern-expressions f (:tail pattern)))
  :palias (assoc pattern :a (map-pattern-expressions f (:a pattern)) :b (map-pattern-expressions f (:b pattern)))
  :pvar pattern :plit pattern :pnil pattern
  (throw (ex-info "Unknown executable ANF pattern" {:kind :unknown-executable-pattern :pop (:pop pattern)}))))

(defn- link-clause [clause bindings]
 (assoc clause :pats (finite-map (fn [p] (map-pattern-expressions (fn [key] (link-node key bindings)) p)) (:pats clause))
               :guard (when (some? (:guard clause)) (link-node (:guard clause) bindings))
               :body (link-node (:body clause) bindings)))

(defn- link-node [node bindings]
 (let [op (:op node)]
  (if (= :binding op)
   (let [reference (:reference node) target (get bindings reference)]
    (when-not target
     (throw (ex-info "Selected binding has no unit target"
                    {:kind :unlinked-contextual-binding :reference reference})))
    (assoc target :ann (assoc (merge (:ann target) (:ann node)) :binding-reference reference)))
   (let [scalars (cond (= :invoke op) [:callee :arguments]
                       (= :apply op) [:fn]
                       (= :let op) [:init :body]
                       (= :if op) [:test :then :else]
                       (= :case op) [:subj]
                       (= :try op) [:body :after]
                       (= :recv op) [:timeout :after]
                       (= :cons op) [:head :tail]
                       :else [])
         sequences (cond (contains? #{:js :arith :remote :apply} op) [:args]
                          (= :do op) [:stmts] (= :tuple op) [:elems] :else [])
         clauses (cond (contains? #{:case :fn :recv} op) [:clauses]
                       (= :try op) [:catch] :else [])
         pairs (cond (= :map op) [:pairs] (= :struct op) [:fields] :else [])
         result (reduce (fn [out field]
                          (if (nil? (get out field)) out
                           (assoc out field (link-node (get out field) bindings)))) node scalars)
         result (reduce (fn [out field]
                          (assoc out field (finite-map (fn [child] (link-node child bindings))
                                                       (get out field)))) result sequences)
         result (reduce (fn [out field]
                          (assoc out field (finite-map (fn [clause] (link-clause clause bindings))
                                                       (get out field)))) result clauses)]
    (reduce (fn [out field]
             (assoc out field (finite-map (fn [pair]
                               [(link-node (first pair) bindings) (link-node (second pair) bindings)])
                                          (get out field)))) result pairs)))))

(defn- linked-target? [node]
 (and (not= :binding (:op node))
      (every? (fn [child] (linked-target? child)) (executable-children node))))

(defn- static-link-target? [node]
 (and (not (contains? #{:binding :global} (:op node)))
      (every? (fn [child] (static-link-target? child)) (executable-children node))))

(defn link-bindings
 "Resolve selected references through a finite unit-owned ANF target table.
  Full references are keys, including world/phase/space. Targets must already
  be linked: no recursive resolver, ambient lookup or executable callback.
  This pure transformation grants no Source authenticity or native admission."
 [node bindings]
 (when-not (and (node-ok? node) (plain-map? bindings))
  (throw (ex-info "Invalid ANF unit linkage" {:kind :invalid-anf-binding-link})))
 ;; Check every target before traversal; even unused malformed entries refuse.
 (doseq [entry (maps/to_list bindings)]
  (when-not (and (binding-reference? (elem entry 0)) (node-ok? (elem entry 1))
                 (static-link-target? (elem entry 1)))
   (throw (ex-info "Invalid ANF binding target" {:kind :invalid-anf-binding-link}))))
 (let [linked (link-node node bindings)]
  ;; Future executable grammar additions cannot silently omit substitution.
  (when-not (linked-target? linked)
   (throw (ex-info "Unit linkage left an unresolved executable binding"
                  {:kind :unlinked-contextual-binding})))
  linked))


(defn- contextual-unit-error! [reason]
 (throw (ex-info "Invalid compiled contextual unit" {:kind :invalid-contextual-unit :reason reason})))

(defn- lexical-clauses [clauses bound direct-parameters?]
 (BeamLisp.CompilerData/eager_mapcat
  (fn [clause]
   (let [names (BeamLisp.CompilerData/eager_mapcat pattern-vars (:pats clause))
         ;; General patterns lower '_' as a fresh wildcard. Direct Core fn
         ;; parameters bind it literally, as selected by the shared shape view.
         scope (reduce (fn [scope name]
                         (if (and (= "_" name) (not direct-parameters?)) scope
                          (assoc scope name true))) bound names)
         keys (BeamLisp.CompilerData/eager_mapcat pattern-expressions (:pats clause))]
    (finite-concat (finite-map (fn [key] [key bound]) keys)
                   (when (:guard clause) (list [(:guard clause) scope]))
                   (list [(:body clause) scope])))) clauses))

(defn- check-lexical-node! [expression bound remaining]
 (loop [todo (list [expression bound])]
  (when (seq todo)
   (when (neg? (swap! remaining dec)) (contextual-unit-error! :lexical-budget))
   (let [[node scope] (first todo) op (:op node)
         children
         (case op
          :var (do (when-not (contains? scope (:name node))
                     (throw (ex-info "Unbound variable in contextual unit"
                              {:kind :invalid-contextual-unit :reason :unbound-variable
                               :name (:name node) :origin (:ann node)}))) (list))
          :let (list [(:init node) scope] [(:body node) (assoc scope (:name node) true)])
          :fn (lexical-clauses (:clauses node) scope
                (some? (BeamLisp.CompilerData/simple_function_clause node)))
          :case (cons [(:subj node) scope] (lexical-clauses (:clauses node) scope false))
          :try (let [handler-scope (reduce (fn [bound name] (assoc bound name true)) scope
                                     (vals (BeamLisp.CompilerData/catch_stack_bindings)))]
                 (finite-concat (list [(:body node) scope])
                                (lexical-clauses (:catch node) handler-scope false)
                                (when (:after node) (list [(:after node) scope]))))
          :recv (finite-concat (lexical-clauses (:clauses node) scope false)
                               (when (:timeout node) (list [(:timeout node) scope]))
                               (when (:after node) (list [(:after node) scope])))
          (finite-map (fn [child] [child scope]) (executable-children node)))]
    (recur (finite-concat children (rest todo)))))))

(defn validate-contextual-unit!
 "Validate one finite compiled recipe before projection or phase facts. Native
  CompilerData owns its shape/bijections; this owner checks canonical executable
  grammar, closed selected linkage and ordered lexical scopes. No code or
  initializer is executed; this is not a type/effect or native-admission proof."
 [unit]
 (try (BeamLisp.CompilerData/check_contextual_unit! unit)
      (catch error (contextual-unit-error! :data)))
 (doseq [node (cons (:entry unit) (map :node (:initializers unit)))]
  (when-not (and (node-ok? node) (static-link-target? node))
   (contextual-unit-error! :executable-image)))
 (let [remaining (atom 262144)]
  (loop [links (:initializers unit) bound {}]
   (if (empty? links) (check-lexical-node! (:entry unit) bound remaining)
    (let [link (first links)]
     (check-lexical-node! (:node link) bound remaining)
     (recur (rest links) (assoc bound (:slot link) true))))))
 unit)

(defn- contextual-unit-body [unit tail]
 (reduce (fn [inner link] (lett (:slot link) (:node link) inner))
         tail (reverse (:initializers unit))))

(defn contextual-unit-entry
 "Project the entry from the same validated recipe used by its factory."
 [unit]
 (validate-contextual-unit! unit)
 (contextual-unit-body unit (:entry unit)))

(defn contextual-unit-factory
 "Project a validated recipe to canonical instance ANF. Constructing the
  instance never executes its entry thunk. Data grant no activation/admission."
 [unit]
 (validate-contextual-unit! unit)
 (let [targets (into {} (map (fn [link]
                              [(:reference link)
                               {:op :var :name (:slot link) :ann {:binding-reference (:reference link)}}])
                            (:initializers unit)))
       exports (mapp (finite-map (fn [reference] [(lit reference) (get targets reference)]) (:exports unit)))
       entry (fnn (list (clause (list) nil (:entry unit))))
       value (mapp (list [(lit :version) (lit 1)]
                        [(lit :kind) (lit :contextual-unit-instance)]
                        [(lit :entry) entry] [(lit :exports) exports]))]
  (contextual-unit-body unit value)))

(defn module
  "Construct and validate the canonical version-1 ANF module descriptor.
   Collection inputs are eagerly realized once and normalized to proper lists."
  ([name clauses exports attrs] (module name clauses exports attrs {}))
  ([name clauses exports attrs ann]
   (validate-module! {:op :module :version 1 :name name
                      :clauses (to-list (BeamLisp.CompilerData/eager_map (fn [value] (normalize-grammar value)) (eager-list clauses "$.clauses")))
                      :exports (eager-list exports "$.exports")
                      :attrs (eager-list attrs "$.attrs") :ann ann})))

;; Versioned executable-entry DATA. Authentication of an SDK/control origin
;; belongs to native publication/admission, never this constructor or a tag.
(defn- execution-entry-kinds [] (quote #{:source :sdk :actor :native-adapter :control}))
(defn- execution-edge-kinds []
 (quote #{:direct-call :captured-value :callable-argument :native-adapter
           :fixed-sdk-lookup :start :message :control :handoff :cleanup}))

(defn- entry-error [field]
 (throw (ex-info "Invalid execution entry descriptor"
          {:kind :invalid-execution-entry :field field})))

(defn validate-execution-entry!
 "Validate the closed version-1 entry schema. Entries are finite literal maps;
  edge collections are proper native lists. Passing this shape check supplies
  no runtime origin, context, graph custody or resource capability."
 [entry]
 (when-not (and (map? entry)
                (exact-keys? entry [:version :id :definition :body-identity :kind
                                    :arity :span :edges :dependencies-complete]))
  (entry-error :fields))
 (when-not (= 1 (:version entry)) (entry-error :version))
 (when-not (and (some? (:id entry)) (literal-data? (:id entry))) (entry-error :id))
 (when-not (string? (:definition entry)) (entry-error :definition))
 (when-not (and (some? (:body-identity entry)) (literal-data? (:body-identity entry)))
  (entry-error :body-identity))
 (when-not (contains? (execution-entry-kinds) (:kind entry)) (entry-error :kind))
 (when-not (and (map? (:arity entry)) (exact-keys? (:arity entry) [:kind :count])
                (contains? #{:fixed :variadic} (:kind (:arity entry)))
                (int? (:count (:arity entry)))
                (erlang/>= (:count (:arity entry)) 0)
                (erlang/=< (:count (:arity entry)) 255))
  (entry-error :arity))
 (when-not (and (map? (:span entry)) (literal-data? (:span entry))) (entry-error :span))
 (when-not (or (= true (:dependencies-complete entry)) (= false (:dependencies-complete entry)))
  (entry-error :dependencies-complete))
 (when-not (erlang/is_list (:edges entry)) (entry-error :edges))
 (Enum/each (:edges entry) (fn [edge]
  (when-not (and (map? edge) (exact-keys? edge [:kind :target :evidence :span])
                 (contains? (execution-edge-kinds) (:kind edge))
                 (literal-data? (:target edge))
                 (some? (:evidence edge)) (literal-data? (:evidence edge))
                 (map? (:span edge)) (literal-data? (:span edge)))
   (entry-error :edge))))
 entry)

(defn execution-entry
 "Construct the canonical finite entry schema. Omitted dependency coverage is
  false. Missing identities still refuse; no declaration gets inferred trust."
 [fields]
 (let [entry (maps/merge {:version 1 :span {} :edges (list) :dependencies-complete false} fields)
       edges (eager-list (:edges entry) "$.execution-entry.edges")
       edges (BeamLisp.CompilerData/eager_map
               (fn [edge] (maps/merge {:span {} :target nil} edge)) edges)]
  (validate-execution-entry! (assoc entry :edges edges))))

(defn- execution-span [node]
 (maps/with (list :file :line :col :offset :end-line :end-col :end-offset)
            (or (:ann node) {})))

(defn- dependency-edge [node kind target evidence]
 {:kind kind :target target :evidence evidence :span (execution-span node)})

(defn- node-dependencies [node]
 (let [op (:op node) invocation (callable-invocation node)]
  (cond
   invocation
   (list (dependency-edge node :direct-call
           (tuple :mfa :Elixir.BeamLisp.Ns.Rt :invoke 2) [:anf :invoke])
         (dependency-edge node :callable-argument nil
           [:anf :invoke (:op (:callee invocation))]))
   (= :remote op)
   (if (and (erlang/is_atom (:mod node)) (erlang/is_atom (:fun node)))
    (list (dependency-edge node :direct-call
            (tuple :mfa (:mod node) (:fun node) (count (:args node))) [:anf :remote]))
    (list (dependency-edge node :direct-call nil [:anf :dynamic-remote])))
   (= :binding op)
   (list (dependency-edge node :captured-value nil [:anf :binding (:reference node)]))
   (= :global op)
   ;; A binding is not a physical entry, even for :exact lookups. Resolution
   ;; must authenticate its actual published provider and retained value.
   (list (dependency-edge node :captured-value nil
           [:anf :global (:ns node) (:name node) (:lookup node)]))
   (= :apply op)
   ;; Lowering adds the callable dispatcher. Do not pretend a syntax walk
   ;; inventories backend-generated dependencies or resolves lexical values.
   (list (dependency-edge node :callable-argument nil
           [:anf :apply (:op (:fn node)) (count (:args node))]))
   (contains? #{:arith :struct :js} op)
   (list (dependency-edge node :native-adapter nil [:anf :backend-dependencies op]))
   (and (= :lit op) (not (literal-data? (:val node))))
   (list (dependency-edge node :captured-value nil [:anf :opaque-literal]))
   :else (list))))

(defn execution-dependencies
 "Inventory canonical ANF dependencies, including guards and latent bodies.
  Collection is bounded and eager. Binding/value resolution and backend-added
  calls remain explicit obligations; this is not a dependency-closure proof."
 [roots]
 (loop [pending (eager-list roots "$.execution-roots") edges (list) nodes 0 complete true]
  (if (empty? pending)
   {:edges (lists/reverse edges) :nodes nodes :complete complete}
   (let [node (first pending)
         _ (when (>= nodes 32768)
             (throw (ex-info "Execution dependency inventory exceeded its node budget"
                             {:kind :execution-dependency-limit :limit 32768})))
         children (executable-children node)
         found (node-dependencies node)]
    (recur (finite-concat children (rest pending))
           (Enum/reduce found edges (fn [edge out] (cons edge out)))
           (inc nodes) (and complete (Enum/all? found #(some? (:target %)))))))))

(defn- emitted-entry-key [entry]
 (when-not (and (tuple? entry) (= 5 (erlang/tuple_size entry))
                (contains? #{:fixed :variadic} (elem entry 0))
                (int? (elem entry 1)) (erlang/>= (elem entry 1) 0) (erlang/=< (elem entry 1) 255)
                (erlang/is_atom (elem entry 2)) (erlang/is_atom (elem entry 4))
                (map? (elem entry 3)) (= :defn-clause (:op (elem entry 3)))
                (= (elem entry 2) (:fname (elem entry 3)))
                (= (+ (elem entry 1) (if (= :variadic (elem entry 0)) 1 0))
                   (count (:params (elem entry 3)))))
  (entry-error :emitted-clause))
 (tuple :mfa (elem entry 4) (elem entry 2) (count (:params (elem entry 3)))))

(defn execution-entries
 "Describe the actual five-field emitted clauses with loaded body MD5s.
  Multiple clauses for one physical MFA form one entry. Source/AOT replay use
  this same producer. Origin stays :source until native artifact evidence
  authenticates another domain; annotations cannot nominate SDK/control code."
 [ns name entries body-hashes]
 (when-not (and (string? ns) (string? name) (not (Enum/empty? entries)))
  (entry-error :emitted-inventory))
 (let [groups (Enum/group_by entries (fn [entry] (emitted-entry-key entry)))]
  (finite-map
   (fn [id]
    (let [clauses (get groups id) entry (first clauses)
          body (elem entry 4) md5 (get body-hashes body)
          _ (when-not (and (erlang/is_binary md5) (= 16 (erlang/byte_size md5)))
              (entry-error :body-md5))
          roots (BeamLisp.CompilerData/eager_mapcat
                  (fn [e]
                   (when-not (= (elem entry 0) (elem e 0)) (entry-error :dispatch))
                   (let [clause (elem e 3)]
                    (if (:guard clause) (list (:guard clause) (:body clause))
                     (list (:body clause))))) clauses)
          dependencies (execution-dependencies roots)]
     (execution-entry
      {:id id :definition (erlang/iolist_to_binary (list ns "/" name)) :body-identity (tuple body md5)
       :kind :source :arity {:kind (elem entry 0) :count (elem entry 1)}
       :span (execution-span (elem entry 3)) :edges (:edges dependencies)
       :dependencies-complete (:complete dependencies)})))
   (Enum/sort (maps/keys groups)))))

(defn execution-clause-identities
 "Per-MFA identities embedded by Emit in the same artifact as its code.
  Normalize compiler grammar collections exactly as module construction does.
  Serialize deterministically: literal maps/sets retain their values, but their
  VM-local atom creation order must not change artifact identities. The compiler
  key binds the OTP/toolchain version; retain full SHA256 identities."
 [clauses]
 (let [canonical (finite-map (fn [clause] (normalize-grammar clause)) clauses)
       groups (Enum/group_by canonical (fn [clause] (tuple (:fname clause) (count (:params clause)))))]
  (Enum/reduce (maps/keys groups) {} (fn [key out]
            (assoc out key (crypto/hash :sha256 (erlang/term_to_binary (get groups key) (list :deterministic))))))))
