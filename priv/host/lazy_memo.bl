; host/lazy_memo.bl — the pinned HOST MODULE for `Elixir.BeamLisp.LazyMemo`.
;
; `BeamLisp.LazyMemo` owns the native memo CELL and the policy around it, and
; this file is the `.bl` port of `lib/beam_lisp/lazy_memo.ex` compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam,
; `Elixir.BeamLisp.LazyMemo.beam`. The Rust NIF is unchanged and still names
; that module (`native/lazy_memo/src/lib.rs`, `nif_init`), so the pinned module
; must be the one that LOADS it: `erlang:load_nif/2` binds a library to the
; CALLING module, so `ensure_loaded!` calls it from this module's own code —
; exactly the load the recalled Elixir module did, under the same `:global`
; lock and with the same error text.
;
; WHAT THE CELL HOLDS (PLAN-151 W5). A cell's state is a term the caller
; chooses: `{:pending, thunk}`, `{:running, owner, attempt, waiters}`,
; `{:completed, value}`, `{:failed, thunk, kind, reason, stack}` or
; `{:terminal, reason}`. The THUNK lives on the cell: it is the recipe, and the
; cell that owns the state owns the recipe with it. What must never live in a
; VALUE is a closure — a published value may EMBED a node (`chain/2` builds
; `[e | %LazySeq{…}]`), and a closure in the struct would make every deep copy
; of such a value walk the whole chain behind it. A node's `resource` is one
; word, so copies, CAS comparisons and `flat_size` all stop at it.
;
; VERSIONED TRANSITIONS. Every state transition is a version CAS: the cell
; carries a publication counter, `read_versioned/1` hands it out with the state,
; and `exchange_version/4,5` compares INTEGERS — no term is loaded and no term
; is compared on a path that every realised element pays for. Its `deps_mode`
; argument is the edge policy: `:keep` for a transition that reaches nothing new
; (a claim, a waiter registration, a terminal state — no walk, no graph lock at
; all), or a dependency list for a state that may reach something new, which is
; UNIONED with the cell's existing edges. Only genuinely new ids are
; cycle-checked; edges never shrink while the cell is alive.
;
; DEPENDENCIES are the memo graph's edges, and they exist for ONE question:
; `would_cycle`, asked by the NIF when the new edge set is not a subset of the
; old one. They are NOT an ownership mechanism — a saved state term already
; keeps every resource it embeds alive (FUP-112). So `dependencies/1` is walked
; only when a caller has a term that may hold resources: a published value, a
; fun's captured environment, or a `LazySeq`'s resource and metadata. A bare
; scalar — or a flat proper list of scalars, the shape a produced chunk has —
; cannot hold one and is answered without a walk.
;
; INTERNAL HELPERS ARE TOP LEVEL, AND NAMED `deps_*`. A pinned module is
; functions-only and EVERY top-level `defn` is exported, so the recalled
; module's private helpers would normally be LOCAL closures here. Not for the
; walk: a call through a closure is an INDIRECT call, and on this host an
; indirect call costs about ten times a direct one (one pass over an
; 8000-element list: 12 us as a top-level self-recursion vs 82 us through a
; `loop`'s `recur`). `deps_walk/6` and its two predicates are therefore
; top-level so that the walk — which runs on every create and every publish —
; is a direct self-call. The public surface is otherwise the recalled module's,
; plus the versioned pair.
;
; Run: bin/bl test test/bl/deferred_test.bl test/bl/host_deferred_test.bl

(ns host.lazy-memo)

(defn ensure_loaded!
  "Load the native cell runtime into THIS module, once, under the `:global`
   lock the recalled module used (`{BeamLisp.LazyMemo, :load_nif}` keyed by the
   caller). Idempotent: a loaded library answers `nif_loaded?` true and the
   whole call is a probe."
  []
  (if (nif_loaded?)
    :ok
    (let [; The one failure that is NOT 'build it': `load_nif` answers `:bad_lib`
          ; when the library at this path declares a DIFFERENT module — the file
          ; is there, it belongs to another crate, and the mismatch IS the
          ; diagnosis. Reported, never summarised away.
          advice (fn [reason path]
                   (let [detail (cond
                                  (and (erlang/is_tuple reason)
                                       (erlang/== 2 (erlang/tuple_size reason))
                                       (erlang/== :bad_lib (erlang/element 1 reason)))
                                  (erlang/element 2 reason)
                                  :else nil)
                         text (cond
                                (erlang/is_binary detail) detail
                                (erlang/is_list detail) (erlang/list_to_binary detail)
                                :else "")
                         foreign? (String/contains? text "does not match calling module")]
                     (cond
                       foreign?
                       (str "\nThe artifact is NOT this crate's library — the loader reports:\n"
                            "  " detail "\n"
                            "Fix: rm " path ".so && bl native build\n")
                       :else
                       (str "Fix: bl native build   (builds native/lazy_memo into " path ".so)\n"))))
          load! (fn []
                  (if (nif_loaded?)
                    :ok
                    (let [path (Path/join (BeamLisp.Tiers/priv_root) "native/lazy_memo")
                          r (erlang/load_nif (erlang/binary_to_list path) 0)]
                      (cond
                        (erlang/== :ok r) :ok
                        :else
                        (erlang/error
                          (Elixir.RuntimeError/exception
                            (str "the lazy_memo native runtime is not loadable, and nothing runs without it:\n"
                                 "  " path ".so\n"
                                 "  " (Kernel/inspect (erlang/element 2 r)) "\n\n"
                                 (advice (erlang/element 2 r) path)
                                 "After changing a native runtime module, restart the VM; live NIF\n"
                                 "upgrades are intentionally unsupported.\n")))))))]
      (let [outcome (erlang/apply :global :trans
                      (list (tuple (tuple :"Elixir.BeamLisp.LazyMemo" :load_nif) (erlang/self))
                            load!))]
        (cond
          (erlang/== :ok outcome) :ok
          :else
          (erlang/error
            (Elixir.RuntimeError/exception
              (str "lazy memo NIF load lock failed: " (Kernel/inspect outcome)))))))))

(defn create
  "Create a cell holding `state`. Its dependencies and its byte estimate are
   measured here, before the call, so the lane is chosen directly — a small
   initial value is copied on a regular scheduler, a large one into the dirty
   lane."
  [state]
  (ensure_loaded!)
  (let [deps (dependencies state)
        bytes (estimate_bytes state)]
    (cond
      (erlang/=< bytes (nif_fast_lane_bytes)) (nif_new_fast state deps bytes)
      :else (nif_new state deps bytes))))

(defn create_ref
  "Create an EAGER reference cell: GC-owned like any cell, but its value is not
   scanned for dependency edges and not cycle-checked. This is what an atom
   wants — it holds ordinary data (which may legally point back at another
   atom), and a lazy memo's cycle rejection would wrongly refuse those.
   Ownership is unaffected: the saved term still holds any embedded resource
   handles."
  [value]
  (ensure_loaded!)
  (let [bytes (estimate_bytes value)]
    (cond
      (erlang/=< bytes (nif_fast_lane_bytes)) (nif_new_fast value () bytes)
      :else (nif_new value () bytes))))

(defn exchange_ref
  "Compare-exchange on an eager ref cell: no dependency scan, no cycle check."
  ([resource expected value] (exchange_ref resource expected value ()))
  ([resource expected value notifications]
   (ensure_loaded!)
   (let [bytes (estimate_bytes value)]
     (cond
       (erlang/=< bytes (nif_fast_lane_bytes))
       (let [outcome (nif_compare_exchange_fast resource expected value () bytes notifications)]
         (cond
           (erlang/== :reroute outcome)
           (nif_compare_exchange resource expected value () bytes notifications)
           :else outcome))
       :else (nif_compare_exchange resource expected value () bytes notifications)))))

(defn exchange
  "Compare-exchange a cell's state. Two scheduler lanes, one cell: the fast
   lane is a regular-scheduler NIF and must finish well under 1 ms — it answers
   `:reroute` for a large current value, a large replacement, or any NEW
   dependency edge (an unbounded cycle walk), and we then take the dirty lane.
   The router only skips the fast attempt when the replacement is obviously too
   big, so the common tiny-memo case costs one crossing.

   A control state (`:pending`, `{:running …}`, `{:terminal …}`) is a tiny term
   whose only elements are pids, refs and lists, so its walk is trivially `[]`
   and its estimate constant — the thunk-free cell is what makes that true."
  ([resource expected state] (exchange resource expected state ()))
  ([resource expected state notifications]
   (ensure_loaded!)
   (let [deps (dependencies state)
         bytes (estimate_bytes state)]
     (cond
       (erlang/=< bytes (nif_fast_lane_bytes))
       (let [outcome (nif_compare_exchange_fast resource expected state deps bytes notifications)]
         (cond
           (erlang/== :reroute outcome)
           (nif_compare_exchange resource expected state deps bytes notifications)
           :else outcome))
       :else (nif_compare_exchange resource expected state deps bytes notifications)))))

(defn deps_scalar?
  "INTERNAL (see the namespace header): a term that cannot contain a resource, a
   fun or a handle. Inlined at every spine step."
  [t]
  (or (erlang/is_atom t) (erlang/is_number t) (erlang/is_binary t)
      (erlang/is_pid t) (erlang/is_port t)))

(defn deps_lazy_node?
  "INTERNAL: a `BeamLisp.LazySeq` struct, whose resource is a graph boundary and
   whose metadata is walked."
  [t]
  (and (erlang/is_map t)
       (erlang/is_map_key :__struct__ t)
       (erlang/== :"Elixir.BeamLisp.LazySeq" (erlang/map_get :__struct__ t))))

(defn deps_scalar_list?
  "INTERNAL: a proper list whose every element is a scalar — a produced chunk, a
   captured range, a flat data list. There is nothing behind one, so the walk is
   skipped entirely instead of spending a spine step per element."
  [t]
  (cond
    (erlang/== t ()) true
    (erlang/is_list t)
    (let [h (erlang/hd t)]
      (cond (deps_scalar? h) (deps_scalar_list? (erlang/tl t))
            :else false))
    :else false))

(defn deps_walk
  "INTERNAL: the dependency walk, as a TOP-LEVEL self-recursion.

   Why top level and not a `loop` or a `let`-bound fn: a `recur` inside a loop
   compiles to an indirect call through a closure, and an indirect call costs
   ~10x a direct one here (measured on this host: 12 us vs 82 us for one pass
   over an 8000-element list). The walk is on every publish, so it must be a
   direct self-call.

   ONE LOOP, TWO PHASES. `:inspect` consumes the current term; `:advance` pops
   the next pending term off `stack` — the empty list, which no push can
   produce, terminates it. The common case is a cons list ending in a node, so
   `:inspect` walks the SPINE with `recur`, testing each head's shape and
   pushing only a head that can itself contain something: a flat list of
   numbers — the overwhelming majority of produced values — is one shape test
   per element and NO allocation."
  [phase cur stack ids functions resources]
  (cond
    ; ── pop the next pending term, or answer ──
    (erlang/== phase :advance)
    (cond
      (erlang/== stack ()) resources
      :else (deps_walk :inspect (erlang/hd stack) (erlang/tl stack)
                       ids functions resources))

    ; ── a cons: test its head, continue down the spine ──
    (and (erlang/is_list cur) (erlang/== false (erlang/== cur ())))
    (let [head (erlang/hd cur)
          tail (erlang/tl cur)]
      (cond
        (deps_scalar? head) (deps_walk :inspect tail stack ids functions resources)
        :else (deps_walk :inspect tail (erlang/++ (list head) stack)
                        ids functions resources)))

    ; ── a scalar: nothing inside ──
    (deps_scalar? cur) (deps_walk :advance cur stack ids functions resources)

    ; ── a lazy node: resource + metadata, both walked ──
    (deps_lazy_node? cur)
    (let [resource (erlang/map_get :resource cur)
          identity (nif_id resource)
          seen? (MapSet/member? ids identity)]
      (deps_walk :inspect (erlang/map_get :metadata cur) stack
                 (cond seen? ids :else (MapSet/put ids identity))
                 functions
                 (cond seen? resources
                       :else (erlang/++ (list resource) resources))))

    ; ── a bare memo handle (or a cursor, whose source it answers) ──
    (erlang/is_reference cur)
    (let [found (nif_dependency_resource cur)
          seen? (cond (erlang/== found nil) true
                      :else (MapSet/member? ids (nif_id found)))]
      (cond
        (or (erlang/== found nil) seen?)
        (deps_walk :advance cur stack ids functions resources)
        :else
        (deps_walk :advance cur stack
                   (MapSet/put ids (nif_id found)) functions
                   (erlang/++ (list found) resources))))

    ; ── a closure: walk its captured environment, once per fun ──
    (erlang/is_function cur)
    (cond
      (MapSet/member? functions cur)
      (deps_walk :advance cur stack ids functions resources)
      :else
      (let [env (erlang/element 2 (erlang/fun_info cur :env))]
        (deps_walk :advance cur (erlang/++ env stack)
                   ids (MapSet/put functions cur) resources)))

    ; ── a tuple: walk its elements ──
    (erlang/is_tuple cur)
    (deps_walk :advance cur (erlang/++ (erlang/tuple_to_list cur) stack)
               ids functions resources)

    ; ── a map (a struct included): walk its values and keys ──
    (erlang/is_map cur)
    (deps_walk :advance cur
               (maps/fold (fn [k v acc] (erlang/++ (list v k) acc)) stack cur)
               ids functions resources)

    :else (deps_walk :advance cur stack ids functions resources)))

(defn read_versioned
  "The cell's `{version, state}` — the state together with the publication
   counter that must be handed back to `exchange_version/4,5` to claim it.

   One crossing on the hot path, exactly like `read/1`: the fast NIF
   self-guards and answers the bare atom `:reroute` for an over-ceiling cell
   instead of a routing round-trip. Here that atom cannot be confused with a
   real answer — the answer is a 2-tuple, never an atom."
  [resource]
  (ensure_loaded!)
  (let [value (nif_read_versioned_fast resource)]
    (cond
      (erlang/== :reroute value) (nif_read_versioned resource)
      :else value)))

(defn put
  "Unconditional replace of a ref cell's value — the last writer wins (a
   volatile's contract). No dependency scan: like `create_ref`, a ref cell's
   value may legally point anywhere, and a cycle it closes is the cycle
   collector's to reclaim."
  [resource value]
  (let [bytes (estimate_bytes value)]
    (cond
      (erlang/=< bytes (nif_fast_lane_bytes))
      (let [outcome (nif_put_fast resource value bytes)]
        (cond
          (erlang/== :reroute outcome) (nif_put resource value bytes)
          :else outcome))
      :else (nif_put resource value bytes))))

(defn collect_cycles
  "Run one cycle-collection round now and answer how many cells it freed.
   Rounds also run by themselves, on a native thread, as cells are allocated;
   this is for tests and for a caller that just dropped a large cyclic
   structure. Answers 0 when the collector is off (see `collector_status`)."
  []
  (ensure_loaded!)
  (nif_collect_cycles))

(defn collector_status
  "`\"\"` when the cycle collector calibrated against this emulator (it is on);
   otherwise the reason it stays off."
  []
  (ensure_loaded!)
  (nif_collector_status))

(defn exchange_version
  "Versioned compare-exchange: the `expected_version` is the counter that came
   with the state the caller read, and the comparison is an integer compare —
   NO term is loaded and no term is compared.

   `deps_mode` is the whole point of the lane split:

     - `:keep` — this transition reaches no resource the cell did not already
       hold (a claim, a waiter registration, a terminal state). The edge set is
       left exactly as it is: no walk, no graph lock, no cycle check.

     - a dependency list — a state that may reach something new (`{:pending
       thunk}` at creation, `{:completed value}`, `{:failed …}`). It is UNIONED
       with the cell's existing edges; only genuinely new ids are cycle-checked,
       and a new edge is not fast-lane work (the cycle walk is unbounded in the
       reachable set), so such a call answers `:reroute` and we retry dirty."
  ([resource expected_version replacement deps_mode]
   (exchange_version resource expected_version replacement deps_mode ()))
  ([resource expected_version replacement deps_mode notifications]
   (ensure_loaded!)
   (let [bytes (estimate_bytes replacement)]
     (cond
       (erlang/=< bytes (nif_fast_lane_bytes))
       (let [outcome (nif_exchange_version_fast
                       resource expected_version replacement deps_mode bytes notifications)]
         (cond
           (erlang/== :reroute outcome)
           (nif_exchange_version
             resource expected_version replacement deps_mode bytes notifications)
           :else outcome))
       :else (nif_exchange_version
               resource expected_version replacement deps_mode bytes notifications)))))

(defn dependencies
  "The memo resources `term` can reach, in a list, deduplicated by the NIF's
   cell identity. A memo handle is a graph boundary (its transitive
   dependencies live in the native graph); immutable metadata belongs to the
   wrapper and must be walked, which is why a `LazySeq` node contributes both
   its resource AND its metadata.

   TWO CHEAP PRE-CHECKS before the walk — the shapes that dominate real traffic
   and can hold nothing: a scalar, and a flat proper list of scalars (a produced
   chunk, a `range`'s vector backing, a captured data list). Both answer `[]`
   without minting a worklist. Everything else goes to `deps_walk/6`."
  [term]
  (ensure_loaded!)
  (cond
    (deps_scalar? term) ()
    (deps_scalar_list? term) ()
    :else (deps_walk :inspect term () (MapSet/new) (MapSet/new) ())))

(defn cursor
  "A native chunked cursor over the finite eager `list`. Its source is saved
   once, and each pulled chunk shares that storage."
  [list]
  (ensure_loaded!)
  (nif_cursor list (dependencies list) (estimate_bytes list)))

(defn cursor_dirty_chunks?
  "Whether this cursor's chunks must take the dirty lane, decided at creation
   from the source's average element size."
  [resource]
  (nif_cursor_dirty_chunks resource))

(defn cursor_chunk
  "Pull the next chunk. `dirty?` (from `cursor_dirty_chunks?/1`) picks the lane."
  ([resource] (cursor_chunk resource false))
  ([resource dirty?]
   (cond
     (erlang/== false dirty?) (nif_cursor_chunk_fast resource)
     :else (nif_cursor_chunk resource))))

(defn estimate_bytes
  "The term's size in bytes — the estimate the lanes are chosen by and the
   number the cache budget is charged.

   A CONTROL STATE — `{:running owner attempt waiters}` or `{:terminal reason}`
   — answers a constant: it is a pid, a ref and a waiter list, so its copy is
   fixed work and the only element that can grow is the waiter list, which is
   exactly what a per-element walk would charge for on a transition meant to be
   O(1). Everything else (a `{:pending thunk}`, a `{:completed value}`, a
   `{:failed …}`) measures exactly.

   `:erts_debug.flat_size/1` is exact, O(size) at the BIF, and safe on every
   term a cell here can hold: a lazy node's `resource` is a HANDLE into the
   native graph, so `flat_size` stops at it the way it stops at any resource and
   never walks the capture chain behind it."
  [term]
  (cond
    ; the control-state tag test, inline: this function is on every create,
    ; every exchange and every atom swap!, and a single-use predicate does not
    ; earn a call there.
    (and (erlang/is_tuple term)
         (let [tag (erlang/element 1 term)]
           (or (erlang/== tag :running) (erlang/== tag :terminal))))
    64

    :else (erlang/* (erlang/apply :erts_debug :flat_size (list term))
                    (erlang/system_info :wordsize))))

(defn admit!
  "The cache budget gate. `:lazy_cache_budget_bytes` (default 512 MiB) bounds
   the bytes retained off-heap; a budget of 0 refuses every new attempt. At or
   over budget, collect and give the deferred off-heap reclaim a bounded grace
   period before refusing — live answers are untouched."
  []
  (let [default 536870912
        budget (Application/get_env :beam_lisp :lazy_cache_budget_bytes default)]
    (cond
      (and (erlang/is_integer budget) (erlang/>= budget 0)) :ok
      :else (erlang/error
              (Elixir.ArgumentError/exception
                "lazy_cache_budget_bytes must be a non-negative integer")))
    (cond
      (erlang/== budget 0)
      (erlang/error (Elixir.BeamLisp.LazySeq.ForceError/exception
                      (tuple :lazy_cache_budget_exceeded budget)))

      (erlang/>= (:retained_bytes (stats)) budget)
      (let [await (fn await [deadline]
                    (cond
                      (erlang/< (:retained_bytes (stats)) budget) :ok
                      (erlang/>= (System/monotonic_time :millisecond) deadline)
                      (erlang/error (Elixir.BeamLisp.LazySeq.ForceError/exception
                                      (tuple :lazy_cache_budget_exceeded budget)))
                      :else (do (Process/sleep 1) (await deadline))))]
        (erlang/garbage_collect)
        (await (erlang/+ (System/monotonic_time :millisecond) 25)))

      :else :ok)))

(defn new
  "Create a cell from an already-measured state, dependency list and byte
   estimate — the door for a caller that has done its own measuring. The lazy
   force path does NOT use it: `create/1` measures and picks the lane, which is
   what keeps a small initial state off the dirty scheduler."
  [state dependencies bytes]
  (ensure_loaded!)
  (nif_new state dependencies bytes))

(defn read
  "The cell's current state. One crossing on the hot path: the fast NIF
   self-guards, answering `:reroute` for an over-ceiling cell instead of a
   routing round-trip. A small cell whose state IS the literal `:reroute` atom
   falls through to the dirty read and returns the same value — one extra
   crossing for that lone pathological case only."
  [resource]
  (ensure_loaded!)
  (let [value (nif_read_fast resource)]
    (cond
      (erlang/== :reroute value) (nif_read resource)
      :else value)))

(defn fast_lane_bytes
  "Byte ceiling below which cell reads/writes take the regular-scheduler lane."
  []
  (ensure_loaded!)
  (nif_fast_lane_bytes))

(defn set_fast_lane_bytes
  "Tune the fast-lane ceiling. Raising it trades scheduler fairness for
   throughput."
  [bytes]
  (ensure_loaded!)
  (nif_set_fast_lane_bytes bytes))

(defn compare_exchange
  "Dirty-lane-only compare-exchange, for a caller that has measured its own
   dependencies."
  [resource expected replacement dependencies bytes]
  (ensure_loaded!)
  (nif_compare_exchange resource expected replacement dependencies bytes ()))

(defn id
  "The cell's stable identity, as the dependency graph keys it."
  [resource]
  (ensure_loaded!)
  (nif_id resource))

(defn stats []
  (ensure_loaded!)
  (nif_stats))

; Runtime loading happens after the compiler's own load, so the probe lives in
; the NIF, not in a persistent term: a host-module reload then cannot lie. Each
; stub exists so `load_nif` can bind the real entry point over it — a library
; whose function list this module does not declare is refused `{:bad_lib, …}`.

(defn nif_loaded? [] false)
(defn nif_new [_state _dependencies _bytes] (erlang/nif_error :nif_not_loaded))
(defn nif_new_fast [_state _dependencies _bytes] (erlang/nif_error :nif_not_loaded))
(defn nif_read [_resource] (erlang/nif_error :nif_not_loaded))
(defn nif_read_fast [_resource] (erlang/nif_error :nif_not_loaded))
(defn nif_put_fast [_resource _value _bytes] (erlang/nif_error :nif_not_loaded))
(defn nif_put [_resource _value _bytes] (erlang/nif_error :nif_not_loaded))
(defn nif_collect_cycles [] (erlang/nif_error :nif_not_loaded))
(defn nif_collector_status [] (erlang/nif_error :nif_not_loaded))
(defn nif_read_versioned [_resource] (erlang/nif_error :nif_not_loaded))
(defn nif_read_versioned_fast [_resource] (erlang/nif_error :nif_not_loaded))
(defn nif_exchange_version_fast
  [_resource _expected_version _replacement _deps_mode _bytes _notifications]
  (erlang/nif_error :nif_not_loaded))
(defn nif_exchange_version
  [_resource _expected_version _replacement _deps_mode _bytes _notifications]
  (erlang/nif_error :nif_not_loaded))
(defn nif_fast_lane_bytes [] (erlang/nif_error :nif_not_loaded))
(defn nif_set_fast_lane_bytes [_bytes] (erlang/nif_error :nif_not_loaded))
(defn nif_compare_exchange_fast
  [_resource _expected _replacement _dependencies _bytes _notifications]
  (erlang/nif_error :nif_not_loaded))
(defn nif_compare_exchange
  [_resource _expected _replacement _dependencies _bytes _notifications]
  (erlang/nif_error :nif_not_loaded))
(defn nif_id [_resource] (erlang/nif_error :nif_not_loaded))
(defn nif_resource_id [_term] (erlang/nif_error :nif_not_loaded))
(defn nif_stats [] (erlang/nif_error :nif_not_loaded))
(defn nif_cursor [_list _dependencies _bytes] (erlang/nif_error :nif_not_loaded))
(defn nif_cursor_chunk [_cursor] (erlang/nif_error :nif_not_loaded))
