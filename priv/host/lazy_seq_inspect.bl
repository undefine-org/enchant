; host/lazy_seq_inspect.bl — the pinned PROTOCOL IMPL for `Elixir.Inspect` on
; `BeamLisp.LazySeq`.
;
; `defimpl Inspect, for: BeamLisp.LazySeq` is its own module,
; `Inspect.BeamLisp.LazySeq`. This file is the `.bl` port of that impl,
; compiled by `BeamLisp.AOT/compile_host_file` into
; `Elixir.Inspect.BeamLisp.LazySeq.beam`.
;
; ABI PARITY IS THE CONTRACT. `inspect/2` samples up to `opts.limit` elements
; (default 20), renders each through `Inspect.Algebra.to_doc/2` with the same
; options, intersperses single spaces, appends `…` when more remain, and wraps
; the whole in `( )`. The body is a FLAT list of docs: `concat/1` does not
; accept a nested list as a doc, and the recalled module crashed the algebra
; formatter that way — which made a lazy seq impossible to inspect, including
; inside a test failure's message. Sampling goes through `BeamLisp.LazySeq`, so
; a seq renders as its realized prefix, exactly as before.
;
; `__impl__/1` answers `:for` (the type) and `:protocol` (the protocol); an
; unknown key raises `FunctionClauseError`, as the generated function did.
; FUNCTIONS-ONLY: no `:struct_fields`, so no `__struct__`/`__info__` export.
;
; Run: bin/bl test test/bl/host_lazy_test.bl

(ns host.lazy-seq-inspect)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.LazySeq"
    (= :protocol k) :"Elixir.Inspect"
    :else (erlang/error
            (Elixir.FunctionClauseError/exception
              (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                    (tuple :function :__impl__)
                    (tuple :arity 1))))))

(defn inspect
  "`Inspect.inspect/2`: `(1 2 3 …)` — up to `opts.limit` elements (default 20),
   with `…` when the seq continues past the sample."
  [lazy opts]
  (let [given (erlang/map_get :limit opts)
        limit (cond (and (erlang/is_integer given) (erlang/> given 0)) given :else 20)
        sampled (BeamLisp.LazySeq/sample lazy limit)
        elems (erlang/element 1 sampled)
        truncated (erlang/element 2 sampled)
        body (Enum/map elems (fn [e] (Inspect.Algebra/to_doc e opts)))
        body (Enum/intersperse body " ")
        body (cond (erlang/== true truncated) (erlang/++ body (list "…")) :else body)]
    (Inspect.Algebra/concat
      (erlang/++ (list "(") (erlang/++ body (list ")"))))))
