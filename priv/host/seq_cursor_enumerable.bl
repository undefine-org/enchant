; host/seq_cursor_enumerable.bl — the pinned PROTOCOL IMPL for
; `BeamLisp.SeqCursor`.
;
; `defimpl Enumerable, for: BeamLisp.SeqCursor` is its own module,
; `Enumerable.BeamLisp.SeqCursor`, compiled beside the type it serves. This
; file is the `.bl` port of that impl, compiled by
; `BeamLisp.AOT/compile_host_file` into
; `Elixir.Enumerable.BeamLisp.SeqCursor.beam`.
;
; ABI PARITY IS THE CONTRACT. A cursor is a forward-only walk, so `count`,
; `member?` and `slice` all report `{:error, <impl module>}` and the caller
; falls back to `reduce`; `reduce` pulls one cell at a time through
; `BeamLisp.SeqCursor.cell/1` and forwards `:cont` / `:halt` / `:suspend`
; exactly, the suspension's resumption closure continuing at the tail it
; stopped on; `__impl__/1` answers `:for` and `:protocol`. An unknown
; `__impl__` key raises `FunctionClauseError`.
;
; FUNCTIONS-ONLY: no `:struct_fields`, so no `__struct__`/`__info__` export.
; The `{:error, module}` answers name their own module from a fun literal
; compiled into THIS file, so at a probe atom they answer that atom.
;
; Run: bin/bl test test/bl/host_lazy_test.bl

(ns host.seq-cursor-enumerable)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.SeqCursor"
    (= :protocol k) :"Elixir.Enumerable"
    :else (erlang/error
            (Elixir.FunctionClauseError/exception
              (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                    (tuple :function :__impl__)
                    (tuple :arity 1))))))

(defn count
  "A forward-only walk has no constant-time count; the caller falls back to
   `reduce`."
  [_cursor]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn member?
  "A forward-only walk has no membership test; the caller falls back to
   `reduce`."
  [_cursor _value]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn slice
  "A forward-only walk has no constant-time slice; the caller falls back to
   `reduce`."
  [_cursor]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn reduce
  "`Enumerable.reduce/3`: pull one cell at a time, forwarding `:cont`/`:halt`/
   `:suspend`. A suspension hands back a resumption closure that continues at
   the tail of the cell it stopped on."
  [cursor acc fun]
  (cond
    (and (erlang/is_tuple acc) (erlang/== :halt (erlang/element 1 acc)))
    (tuple :halted (erlang/element 2 acc))

    (and (erlang/is_tuple acc) (erlang/== :suspend (erlang/element 1 acc)))
    (tuple :suspended (erlang/element 2 acc) (fn [a] (reduce cursor a fun)))

    :else
    (let [c (BeamLisp.SeqCursor/cell cursor)]
      (cond
        (erlang/== c nil) (tuple :done (erlang/element 2 acc))
        :else (reduce (erlang/tl c)
                      (fun (erlang/hd c) (erlang/element 2 acc))
                      fun)))))
