; host/future.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Future`.
;
; A reference to a computation already running on the BEAM (`(future body…)`);
; `deref` blocks until the task returns, `future-cancel` shuts it down. The
; struct holds the `Task` running it. It carries its own struct so a future is
; never mistaken for a plain map. This file is the `.bl` port of
; `lib/beam_lisp/refs.ex`'s `BeamLisp.Future` half, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose
; `__struct__/0,1` pair and `__info__/1` are SYNTHESIZED by `:struct_fields` —
; no `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/1` is that public constructor. It builds the same map as
; `defstruct [:task]`, tagged with whatever module this file compiled into.
;
; Run: bin/bl test test/bl/host_refs_test.bl

(ns host.future)

(defn new
  "The `%Future{task: task}` constructor: `__struct__/1` fed the field in
   declaration order."
  [task]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :task task (maps/new)))))
