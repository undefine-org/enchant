; host/lazy_seq_force_error.bl — the pinned HOST MODULE for
; `Elixir.BeamLisp.LazySeq.ForceError`.
;
; The exception a lazy node raises for everything that is NOT its evaluator's
; own failure: recursive force, a cyclic retained value, a lost evaluator, an
; exhausted cache budget. This is the `.bl` port of the nested `ForceError`
; module in `lib/beam_lisp/lazy_seq.ex`, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose
; `__struct__/0,1` pair and `__info__/1` are SYNTHESIZED by `:struct_fields`
; — `defexception [:reason, :message]` becomes three fields, with
; `__exception__` FIRST and defaulting `true`, exactly as Elixir's
; `defexception` orders them.
;
; `:behaviour Exception` is the behaviour `defexception` declares; it is the
; reason `BeamLisp.AOT/compile_host_file`'s `:behaviour` option exists and the
; reason `priv/build/seed.bl`'s `host-opts` forwards it.
;
; `exception/1` and `message/1` are the two functions `defexception` generates
; beside the struct: `raise ForceError, reason` funnels through `exception/1`,
; and `Exception.message/1` through `message/1`. Both are module-exact — the
; struct `exception/1` builds is tagged with whatever module this file was
; compiled into, so a probe compile answers its own struct.
;
; Run: bin/bl test test/bl/host_lazy_test.bl

(ns host.lazy-seq-force-error)

(defn exception
  "The `%ForceError{}` for `reason`: the reason itself, and the message the
   recalled module built from it."
  [reason]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :__exception__ true
        (maps/put :reason reason
          (maps/put :message (str "LazySeq force failed: " (Kernel/inspect reason))
                    (maps/new)))))))

(defn message
  "`Exception.message/1`'s entry point: the message `exception/1` computed."
  [e]
  (erlang/map_get :message e))
