; host/z3_port.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Z3Port`.
;
; The z3 port driver: beam-lisp code builds SMT-LIB text, and this module owns
; the subprocess protocol — open/close, the read deadlines, the framing that
; finds an answer among z3's chatter, the `(echo …)` sync marker, and the
; check-sat sanitizer. This is the `.bl` port of `lib/beam_lisp/z3_port.ex`,
; compiled FUNCTIONS-ONLY by `BeamLisp.AOT/compile_host_file` into
; `Elixir.BeamLisp.Z3Port.beam`; its callers are `priv/lib/z3.bl` and
; `priv/std/z3pool.bl`.
;
; ABI parity is the contract: the same answers, the same value shapes, the same
; exceptions, and the same wire bytes to the child process. The one deliberate
; deviation is recorded at `read_answer/2`: a beam-lisp pattern cannot PIN a
; bound port, so every receive names the port with a `:when` guard (a port is a
; clause-local parameter, and the guard can see it) — the same selective
; receive the Elixir `^port` gave, without pin syntax.
;
; The driver is FUNCTIONS, not a process, and that is deliberate: ports deliver
; their replies to the mailbox of the process that OWNS them, so whoever owns
; the port must be whoever calls these functions. Called from a beam-lisp
; `defserver` (see priv/std/z3pool.bl), that is structural serialization — a
; gen_server answers one call at a time — with no lock anywhere.
;
; Run: bin/bl test test/bl/host_z3_port_test.bl

(ns host.z3_port)

; TWO CONSTANTS the Elixir source held as module attributes are INLINED here,
; because a pinned host module is FUNCTIONS-ONLY: `compile_host_file` refuses
; value definitions, and a helper defn would widen the export surface beyond
; the source's own defns.
;
;   @default_read_timeout 20000 — the port's read deadline, the BACKSTOP, not the
;     policy. The pool arms z3's OWN ceiling (priv/std/z3pool.bl,
;     `z3-timeout-ms`) at every lease, so a hard query is answered `unknown` by
;     the solver and never reaches this. This one fires when z3 ignores its own
;     ceiling, when the port is driven directly (the tests do), or when a caller
;     arms a ceiling ABOVE it — so a caller who wants to wait longer than this
;     for one answer must move this too, with BL_Z3_READ_TIMEOUT. A raise here is
;     a real bug, and the honest report.
;   @marker "~~bl-ok~~" — z3 answers `(echo "…")` with the string alone
;     (verified against the pinned binary), which makes it a reliable sync
;     marker: a command is acknowledged on its own terms, instead of hoping the
;     next check-sat surfaces its error.

(defn env_ms
  "A positive integer from the environment, or `default`.

   ONE rule for every bound in this path: a missing, non-numeric or non-positive
   value falls back rather than disarming the deadline it exists to enforce."
  [name default]
  (let [raw (System/get_env name)]
    (if (nil? raw)
      default
      (let [parsed (Integer/parse raw)]
        (if (and (erlang/is_tuple parsed)
                 (erlang/== 2 (erlang/tuple_size parsed))
                 (erlang/is_integer (erlang/element 1 parsed))
                 (erlang/== "" (erlang/element 2 parsed))
                 (erlang/> (erlang/element 1 parsed) 0))
          (erlang/element 1 parsed)
          default)))))

(defn read_timeout
  "How long one complete solver conversation may take, in ms.

   `BL_Z3_READ_TIMEOUT` moves it; a missing, non-numeric or non-positive value
   falls back to the default rather than disarming the read."
  []
  (env_ms "BL_Z3_READ_TIMEOUT" 20000))

(defn open
  "Start z3 and return its port."
  []
  (let [r (open_port)]
    (if (erlang/== :ok (erlang/element 1 r))
      (erlang/element 2 r)
      (erlang/error (Elixir.RuntimeError/exception (erlang/element 2 r))))))

(defn close
  [port]
  (when (alive? port) (assert_port_owner! port) (Port/close port))
  :ok)

(defn- assert_port_owner! [port]
 (let [owner (erlang/port_info port :connected)]
  (when (= :undefined owner) (erlang/error :badarg))
  (when-not (= (erlang/self) (elem owner 1)) (erlang/error :z3_port_owner_required)))
 :ok)

(defn- retire_port! [port]
 ;; A failed exchange cannot be reused. Never close a foreign owner's port.
 (when (erlang/is_port port)
  (try
   (when (= (tuple :connected (erlang/self)) (erlang/port_info port :connected))
    (Port/close port))
   (catch _ nil))
  (loop []
   (receive
    [seen [:data _]] :when (= seen port) (recur)
    [:EXIT seen _] :when (= seen port) (recur)
    (after 0 :ok))))
 :ok)

(defn- with_conversation! [port action]
 ;; This scope changes no Env, origin or execution grant. The real connected
 ;; PID is checked before any effect. Nested phases share one absolute budget.
 (assert_port_owner! port)
 (let [previous (Process/get :bl_z3_conversation)
       shared (and (erlang/is_map previous) (= port (Map/get previous :port)))
       frame (if shared previous
               {:port port :deadline (+ (erlang/monotonic_time :millisecond) (read_timeout))
                :monitor (erlang/monitor :port port)})]
  (Process/put :bl_z3_conversation frame)
  (try (action)
   (catch error
    (retire_port! port)
    (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))
   (finally
    (if (nil? previous) (Process/delete :bl_z3_conversation)
     (Process/put :bl_z3_conversation previous))
    (when-not shared (Process/demonitor (:monitor frame) (list :flush)))))))

(defn- conversation_deadline [port]
 (let [frame (Process/get :bl_z3_conversation)]
  (if (and (erlang/is_map frame) (= port (Map/get frame :port))) (:deadline frame)
   (+ (erlang/monotonic_time :millisecond) (read_timeout)))))

(defn- conversation_monitor [port]
 (let [frame (Process/get :bl_z3_conversation)]
  (when (and (erlang/is_map frame) (= port (Map/get frame :port))) (:monitor frame))))

(defn- read_remaining [deadline]
 (max 0 (- deadline (erlang/monotonic_time :millisecond))))

(defn- reply_capacity! [port bytes]
 ;; Keep malformed/unterminated replies finite even before the time budget.
 (when (> (erlang/byte_size bytes) 16777216)
  (retire_port! port) (erlang/error :z3_reply_capacity))
 :ok)

(defn- port_write! [port bytes]
 (assert_port_owner! port)
 (when (zero? (read_remaining (conversation_deadline port)))
  (erlang/error (RuntimeError/exception "z3 timeout before command")))
 ;; A busy driver must not suspend this process beyond its conversation budget.
 (when-not (Port/command port bytes (list :nosuspend)) (erlang/error :z3_port_busy))
 :ok)

(defn open_port
  "Start a z3 process. Called ONLY by the owner (`BeamLisp.Z3.Solver`), which
   keeps the port for its whole life and serializes every conversation on it.

   The solver is resolved at EXACTLY one place — `priv/z3/bin/z3`, the pinned
   binary fetched by `bl install z3` — never the PATH: what proves your rules is
   the artifact the repo pinned, not whatever a shell happens to resolve. The
   error names the remedy when it is absent."
  []
  (let [exe (resolve_exe)]
    (if (nil? exe)
      (tuple :error (missing_solver_message))
      (tuple :ok (erlang/open_port
                   (erlang/list_to_tuple (list :spawn_executable exe))
                   (list :binary :stream :use_stdio
                         (erlang/list_to_tuple (list :args (list "-in")))))))))

(defn- missing_solver_message
  []
  (str "bundled z3 not found. Looked (in order) at:\n"
       (Enum/join (Enum/map (candidate_paths) (fn [p] (str "  - " p))) "\n")
       "\nrun: bl install z3   (or set BEAM_LISP_Z3=/path/to/z3)"))

(defn alive?
  "True while the solver process behind `port` is reachable.

   A port dies with the process that OPENED it, so a memoized port can outlive
   its owner — the server that answered the first query. A caller that caches a
   port must ask this before reusing it: `Port.command/2` on a closed port
   raises badarg, which reaches the client as a bare `ArgumentError: argument
   error`."
  [port]
  (and (erlang/is_port port) (not (nil? (Port/info port)))))

(defn- resolve_exe
  "The pinned z3 artifact across packaging tiers — never the system PATH."
  []
  (Enum/find (candidate_paths) (fn [p] (File/exists? p))))

(defn- candidate_paths
  "Three candidates, first that exists wins:
     1. BEAM_LISP_Z3 env — an explicit pin (release/CI points it at its artifact)
     2. :code.priv_dir/z3/bin/z3 — the mix / OTP-release layout, where priv_dir
        is a real directory the fetch task populated
     3. <cwd>/priv/z3/bin/z3 — the ESCRIPT tier: `bl` is a single archive file,
        so priv_dir resolves to a pseudo-path INSIDE it that can hold no 34MB
        NIF; the pinned binary still lives in the checkout's priv/, and `bl` is
        run from the repo root. This is a repo artifact, not a PATH lookup.
   All three name the SAME pinned binary the repo controls.

   priv uses Tiers.priv_root/0, NOT :code.priv_dir: inside an escript the code
   path answers with a path INSIDE the archive, which is not a directory on
   disk — Tiers.priv_root falls back to the checkout's priv/, the truth there as
   everywhere else."
  []
  (let [exe (if (erlang/== :win32 (erlang/element 1 (os/type))) "z3.exe" "z3")
        env (System/get_env "BEAM_LISP_Z3")
        priv (Path/join (list (BeamLisp.Tiers/priv_root) "z3" "bin" exe))
        cwd (Path/join (list (File/cwd!) "priv" "z3" "bin" exe))]
    (Enum/uniq (concat (if env (list env) (list)) (list priv cwd)))))

(defn check
  "Reset, assert `smt`, check-sat. Returns `%{status:, model:}` where status is
   \"sat\" | \"unsat\" | \"unknown\" | \"error\"; model is the `(get-model)` text
   when `model?: true` and status is \"sat\".

   RUNS IN THE PORT'S OWNER: the reads below arrive in the caller's mailbox, so
   the owner is the only process that may call this."
  ([port smt] (raw_check port smt false))
  ([port smt model?] (raw_check port smt model?)))

(defn raw_reason
  "`unknown` means the question was not decided, and the two ways that happens
   want OPPOSITE responses: a CEILING (`timeout` / `canceled`) says raise it or
   simplify the query; an INCOMPLETE THEORY says no ceiling will help, and the
   obligation has to stay undecided rather than be retried harder.

   One extra round trip, on the undecided path only. The reply is the RAW z3
   string here; naming it is the language's job (`oracle/verdict`)."
  [port status rest]
   (with_conversation! port (fn []
  (if (erlang/== status "unknown")
    (do (port_write! port "(get-info :reason-unknown)\n")
        (extract_reason (read_sexp port rest)))
    nil))))

(defn- extract_reason
  "`(:reason-unknown \"timeout\")` → \"timeout\"; `(:reason-unknown \"\")` → nil;
   any other shape → nil, because a caller that cannot read the reason must not
   be handed a guess."
  [text]
  (let [m (Regex/run (Regex/compile! "^\\(:reason-unknown\\s+(.*)\\)$" "s")
                     (String/trim (or text "")))]
    (if (and (erlang/is_list m) (erlang/== 2 (erlang/length m)))
      (let [inner (String/trim_trailing
                    (String/trim_leading (String/trim (Enum/at m 1)) "\"")
                    "\"")]
        (if (erlang/== inner "") nil inner))
      nil)))

(defn raw_check
  "The protocol itself. Runs in the OWNER process only."
  ([port smt] (raw_check port smt false))
  ([port smt model?]
   (with_conversation! port (fn []
   ;; A caller-supplied (check-sat) would make z3 answer TWICE and desync the
   ;; reader by one answer for every later query on this port — a silent,
   ;; alternating sat/unsat that looks like a solver bug. Strip it: this
   ;; function owns the check.
   (let [smt (Regex/replace (Regex/compile! "^\\s*\\(check-sat\\)\\s*$" "m") smt "")
         _ (port_write! port (str "(reset)\n" smt "(check-sat)\n"))
         ans (read_answer port "")]
     (if (erlang/== "sat" (erlang/element 1 ans))
       (if model?
         (do (port_write! port "(get-model)\n")
             {:status "sat" :model (read_sexp port (erlang/element 2 ans))})
         {:status "sat" :model nil})
       {:status (erlang/element 1 ans)
        :model nil
        :why (raw_reason port (erlang/element 1 ans) (erlang/element 2 ans))}))))))

(defn raw_command
  "Send SMT-LIB and wait for z3 to ACKNOWLEDGE it. Anything z3 prints before the
   marker is returned as `:output`; an `(error …)` line comes back as
   `%{ok: false}` rather than desynchronizing the reader."
  [port smt]
   (with_conversation! port (fn []
  ;; The command owns its delimiter. A literal echo in supplied SMT cannot
  ;; acknowledge this later frame. Consume the full frame before reporting any
  ;; error, whether the transport coalesces or splits the error/marker lines.
  (let [marker (str "~~bl-ok-" (Base/encode16 (crypto/strong_rand_bytes 16) (list (tuple :case :lower))) "~~")
        _ (port_write! port (str smt "\n(echo \"" marker "\")\n"))
        r (read_command_frame port marker "")]
    (if (erlang/== :marker (erlang/element 1 r))
      {:ok true :output (erlang/element 2 r)}
      {:ok false :error (erlang/element 2 r) :output (erlang/element 3 r)})))))

(defn raw_check_here3
  "The same check, positional — beam-lisp callers pass `(assume core? model?)`
   and never have to marshal a map across the boundary."
  [port assume core? model?]
  (raw_check_here port {:assume assume :core? core? :model? model?}))

(defn raw_check_here
  "check-sat in the CURRENT solver state — no reset, so assertions accumulate and
   `push`/`pop` scope them. Options: `:assume` (SMT-LIB literals checked with
   `check-sat-assuming`), `:core?` (return the unsat core — assertions must be
   named and the script must set `:produce-unsat-cores`), `:model?` (return the
   model on sat)."
  [port opts]
   (with_conversation! port (fn []
  (let [assume (or (:assume opts) (list))
        check (if (erlang/== assume (list))
                "(check-sat)\n"
                (str "(check-sat-assuming (" (Enum/join assume " ") "))\n"))
        _ (port_write! port check)
        ans (read_answer port "")]
    (cond
      (erlang/== "unsat" (erlang/element 1 ans))
      (if (:core? opts)
        (do (port_write! port "(get-unsat-core)\n")
            {:status "unsat" :core (read_sexp port (erlang/element 2 ans))})
        {:status "unsat" :core nil})

      (erlang/== "sat" (erlang/element 1 ans))
      (if (:model? opts)
        (do (port_write! port "(get-model)\n")
            {:status "sat" :core nil :model (read_sexp port (erlang/element 2 ans))})
        {:status "sat" :core nil})

      :else
      {:status (erlang/element 1 ans)
       :core nil
       :why (raw_reason port (erlang/element 1 ans) (erlang/element 2 ans))})))))

(defn raw_scoped
  "One SCOPED question: push, assert the script, check-sat, [get-model], pop —
   all inside one call, against the solver state the caller's conversation
   already built. The prelude is therefore sent once per conversation instead of
   once per question.

   `(get-model)` runs BEFORE the pop — the model of a popped scope is gone — and
   `pop` prints nothing, so the reply stream stays exactly one status (+ model)."
  ([port smt] (raw_scoped port smt false))
  ([port smt model?]
   (with_conversation! port (fn []
   (port_write! port (str "(push 1)\n" smt "\n(check-sat)\n"))
   (let [ans (read_answer port "")]
     (cond
       (erlang/== "unsat" (erlang/element 1 ans))
       (do (port_write! port "(pop 1)\n")
           {:status "unsat" :core nil :model nil})

       (erlang/== "sat" (erlang/element 1 ans))
       (let [model (if model?
                     (do (port_write! port "(get-model)\n")
                         (read_sexp port (erlang/element 2 ans)))
                     nil)]
         (port_write! port "(pop 1)\n")
         {:status "sat" :core nil :model model})

       :else
       (let [why (raw_reason port (erlang/element 1 ans) (erlang/element 2 ans))]
         (port_write! port "(pop 1)\n")
         {:status (erlang/element 1 ans) :core nil :model nil :why why})))))))

(defn- read_until_marker
  [port acc out]
  ;; Retain the pinned helper ABI; all command parsing has one implementation.
  (read_command_frame port "~~bl-ok~~" acc))

(defn- read_command_frame [port marker acc]
 (read_command_frame_until port marker acc (conversation_deadline port)))

(defn- command_frame_failure [port message output]
 (retire_port! port)
 (tuple :error message output))

(defn- read_command_frame_until [port marker acc deadline]
 (reply_capacity! port acc)
 (let [pieces (String/split acc "\n") lines (Enum/drop pieces -1)
       end (Enum/find_index lines (fn [line] (= marker line)))
       complete (if (nil? end) lines (Enum/take lines end))
       output (Enum/join (Enum/reject complete (fn [line] (= "" line))) "\n")
       error (Enum/find complete (fn [line] (String/starts_with? (String/trim_leading line) "(error")))
       remaining (read_remaining deadline) monitor (conversation_monitor port)]
  (cond
   (zero? remaining) (command_frame_failure port "timeout waiting for z3 to acknowledge" output)
   (some? end) (if error (tuple :error error output) (tuple :marker output))
   :else
   (receive
    [p [:data data]] :when (and (== p port) (string? data))
     (read_command_frame_until port marker (str acc data) deadline)
    [:DOWN seen :port p _] :when (and (= seen monitor) (= p port))
     (command_frame_failure port "z3 exited before acknowledgement" output)
    (after remaining
     (command_frame_failure port "timeout waiting for z3 to acknowledge" output))))))

(defn- read_answer
 "One complete status line. Nested status/model/reason phases share the
  conversation's original deadline; chunks cannot renew it."
 [port acc]
 (read_answer_until port acc (conversation_deadline port)))

(defn- answer_timeout! [port acc]
 (retire_port! port)
 (erlang/error (RuntimeError/exception (str "z3 timeout (acc: " (Kernel/inspect acc) ")"))))

(defn- read_answer_until [port acc deadline]
 (reply_capacity! port acc)
 (let [remaining (read_remaining deadline) monitor (conversation_monitor port)]
  (when (zero? remaining) (answer_timeout! port acc))
  (receive
    [p [:data data]] :when (and (== p port) (string? data))
    (let [acc2 (str acc data)
          _ (reply_capacity! port acc2)
          pieces (String/split acc2 "\n") lines (Enum/drop pieces -1)
          idx (Enum/find_index lines
                (fn [l] (Enum/member? (list "sat" "unsat" "unknown" "error") l)))]
      (if (nil? idx)
        (read_answer_until port acc2 deadline)
        (do
         (when (zero? (read_remaining deadline)) (answer_timeout! port acc2))
         ;; Consume the actual status even after an error. Preserve any model
         ;; prefix already delivered in this chunk for the next read phase.
         (tuple (if (Enum/any? (Enum/take lines idx)
                     (fn [line] (String/starts_with? (String/trim_leading line) "(error")))
                 "error" (Enum/at lines idx))
               (Enum/join (Enum/drop pieces (erlang/+ idx 1)) "\n")))))
    [:DOWN seen :port p _] :when (and (= seen monitor) (= p port))
     (do (retire_port! port) (erlang/error (RuntimeError/exception "z3 exited before reply")))
    (after remaining (answer_timeout! port acc)))))

(defn- read_sexp [port acc]
 (read_sexp_until port acc (conversation_deadline port)))

(defn- read_sexp_until [port acc deadline]
 (reply_capacity! port acc)
 (let [remaining (read_remaining deadline) monitor (conversation_monitor port)]
  (when (zero? remaining) (answer_timeout! port acc))
  (if (and (erlang/> (String/length acc) 3) (balanced? acc))
    acc
    (receive
      [p [:data data]] :when (and (== p port) (string? data))
       (read_sexp_until port (str acc data) deadline)
      [:DOWN seen :port p _] :when (and (= seen monitor) (= p port))
       (do (retire_port! port) (erlang/error (RuntimeError/exception "z3 exited before complete value")))
      (after remaining (answer_timeout! port acc))))))

(defn- balanced?
  [s]
  (erlang/== 0
    (Enum/reduce (String/graphemes s) 0
      (fn [ch n]
        (cond
          (erlang/== ch "(") (erlang/+ n 1)
          (erlang/== ch ")") (erlang/- n 1)
          :else n)))))
