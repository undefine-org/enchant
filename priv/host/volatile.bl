; host/volatile.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Volatile`.
;
; beam-lisp's `(volatile! v)` — Clojure's unsynchronized mutable box. The value
; lives in the **process dictionary** of the process that created it, keyed by
; a unique reference; the struct holds ONLY that key, never the value, so it is
; safe to send anywhere (the value simply is not visible outside its home
; process). It carries its own struct so a volatile is never mistaken for a
; plain map. This file is the `.bl` port of `lib/beam_lisp/refs.ex`'s
; `BeamLisp.Volatile` half, compiled by `BeamLisp.AOT/compile_host_file` into
; ONE exact-named beam whose `__struct__/0,1` pair and `__info__/1` are
; SYNTHESIZED by `:struct_fields` — no `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/1` is that public constructor. It builds the same map as
; `defstruct [:key]`, tagged with whatever module this file compiled into.
;
; Run: bin/bl test test/bl/host_refs_test.bl

(ns host.volatile)

(defn new
  "The `%Volatile{key: key}` constructor: `__struct__/1` fed the field in
   declaration order."
  [key]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :key key (maps/new)))))
