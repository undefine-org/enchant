; host/promise.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Promise`.
;
; A single-assignment reference: `deref` blocks until `deliver` sets a value,
; then returns it forever. Backed by a small process, so `deref` is an
; asynchronous wait, never a poll; the struct holds that process's pid. It
; carries its own struct so a promise is never mistaken for a plain map. This
; file is the `.bl` port of `lib/beam_lisp/refs.ex`'s `BeamLisp.Promise` half,
; compiled by `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose
; `__struct__/0,1` pair and `__info__/1` are SYNTHESIZED by `:struct_fields` —
; no `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/1` is that public constructor. It builds the same map as
; `defstruct [:pid]`, tagged with whatever module this file compiled into.
;
; Run: bin/bl test test/bl/host_refs_test.bl

(ns host.promise)

(defn new
  "The `%Promise{pid: pid}` constructor: `__struct__/1` fed the field in
   declaration order."
  [pid]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :pid pid (maps/new)))))
