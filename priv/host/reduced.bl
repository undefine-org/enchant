; host/reduced.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Reduced`.
;
; Clojure's `Reduced` sentinel: wraps a value so a `reduce` terminates early
; with it. `reduce` returns the *unwrapped* value at the halting point;
; `reduced?` tests for the wrapper, and `deref`/`unreduced` peel it by hand.
; Structurally a plain one-field struct, so `=` distinguishes it from the value
; it carries. This file is the `.bl` port of `lib/beam_lisp/refs.ex`'s
; `BeamLisp.Reduced` half, compiled by `BeamLisp.AOT/compile_host_file` into
; ONE exact-named beam whose `__struct__/0,1` pair and `__info__/1` are
; SYNTHESIZED by `:struct_fields` — no `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/1` is that public constructor. It builds the same map as
; `defstruct [:value]`, tagged with whatever module this file compiled into.
;
; Run: bin/bl test test/bl/host_refs_test.bl

(ns host.reduced)

(defn new
  "The `%Reduced{value: value}` constructor: `__struct__/1` fed the field in
   declaration order."
  [value]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :value value (maps/new)))))
