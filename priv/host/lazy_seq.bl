; host/lazy_seq.bl — the pinned HOST MODULE for `Elixir.BeamLisp.LazySeq`.
;
; The lazy sequence: a recipe, run at most once per node, whose successful
; answer is shared, whose known failures may be retried, and whose recursive
; force, cyclic retained value and lost evaluator are terminal. This file is
; the `.bl` port of `lib/beam_lisp/lazy_seq.ex`, compiled by
; `BeamLisp.AOT/compile_host_file` into ONE exact-named beam whose
; `__struct__/0,1` pair and `__info__/1` are SYNTHESIZED by `:struct_fields`
; — no `defstruct`, no Elixir source.
;
; THE CELL HOLDS THE RECIPE (PLAN-151 W5). A node's cell state is one of
; `{:pending thunk}` (or `{:pending thunk recipe}`, see THE FOLD RECIPE),
; `{:running owner attempt waiters}`, `{:completed value}`,
; `{:failed thunk kind reason stack}` or `{:terminal reason}`. The struct is
; `resource metadata`: a handle into that cell plus the value-owned metadata.
; The THUNK (and the fold recipe) is on the cell — it is the recipe, and the state that owns
; it keeps it alive. The running state does not carry it: its owner is executing
; it, and every other process reaches the outcome through the attempt's reply.
;
; WHY THE THUNK IS NOT A STRUCT FIELD. A produced value can EMBED a node:
; `chain/2` builds `[e | %LazySeq{…}]`, and `(lazy-seq (cons x prev))` is
; idiomatic. A closure in the struct would make every deep copy of such a value
; walk the closure's free variables — and for a realised chain those hold the
; previous node, whose own thunk holds the one before it. One `exchange` then
; copied the whole chain behind it (measured 58 us at 1e3 nodes, 258 us at 4e3,
; linear — and the 20k-node reclamation case overran its 30 s bound). The
; struct's `resource` is ONE word, so the cell copy, the CAS comparison and
; `estimate_bytes/1`'s `flat_size` all stop at it and the chain never re-enters
; any of them.
;
; ONE WALK AND ONE COPY IN, ONE COPY OUT. Realising one element costs exactly:
; one walk of the thunk's captured environment (at create — those are the cell's
; cycle edges), one copy of it into the cell (create), one copy out (the claimer
; reads `{:pending thunk}`), plus the value's own walk and copy when it is
; published. Everything else is O(1): a claim, a waiter registration and a
; terminal transition are VERSION compare-and-swaps carrying `:keep` — no term
; load, no term compare, no dependency walk, no graph lock (see
; `BeamLisp.LazyMemo`).
;
; THE FAILURE PATH IS BIT-FOR-BIT. A thunk's failure is captured with
; `(catch-raw [kind reason stack] …)` — the class atom, the UNNORMALIZED reason
; and the raw stack — stored on the cell, handed to every waiter and replayed
; with `erlang:raise/3`. A waiter that catches a normalized exception would
; lose the evaluator's own error; this is why `catch-raw` exists.
;
; ## THE FOLD RECIPE
;
; Realising one element through the memo cell is expensive: the state term is
; copied into and out of the cell and the CAS compares the whole old state. A
; consumer that walks the WHOLE seq once (a `reduce`, a `count`, a `vec`) pays
; that cost per element for no benefit: it never reads the memo again.
;
; So a producer that can also compute its elements from its SOURCE may attach a
; fold `recipe` to its node. It is called by a reducing consumer INSTEAD of the
; cell walk, and creates no cells at all:
;
;     recipe :: (fn [rf init] -> acc | BeamLisp.Reduced)
;
; `rf` is a raw 2-arity Erlang fun `(rf acc x)` — already call-shaped by the
; caller, so a recipe never has to dispatch a callable itself. The recipe folds
; the seq's elements in order and returns the accumulator, or a `Reduced` when
; `rf` asks the fold to stop; the caller peels the sentinel, exactly as the
; memo walk does (`rt.k-fold`/`rt.k-reduce`).
;
; ### When the recipe may be used
;
; Only while the node's head cell is still `{:pending thunk recipe}`
; (`pending_recipe` answers it with the version it read). Once anything is
; realised the memo walk is used instead, so elements already published keep
; their shared values and a side-effecting `f` is not re-run for them.
;
; ### A fold REALISES the node
;
; A fold that runs to the end publishes the complete element list it produced
; as the node's `{:completed …}` state (`publish_folded`, a version CAS against
; the `:pending` it read). The next consumer reads that answer: a producer runs
; once per element however many consumers fold the seq, which is Clojure's
; realise-once contract. Two consumers racing on one pending node may both fold
; from source; the CAS lets one publish, and both return correct answers. A
; fold the consumer HALTS (a `Reduced`) produced only a prefix and publishes
; nothing: the node stays pending.
;
; The recipe is ON THE CELL, never a struct field: a value that embeds the node
; (`(concat prev [x])` built in a loop) would otherwise carry every recipe
; closure behind it, and each cell holding such a value copies the whole chain
; (measured: 400 chained concats retained 15 MB instead of 0.2 MB).
;
; A PINNED MODULE IS FUNCTIONS-ONLY and EVERY top-level `defn` is exported. The
; recalled module's private helpers are TOP LEVEL here under their recalled
; names, plus the fold-recipe helpers — a call through a local closure is an
; INDIRECT call, and on this host an indirect call costs up to ten times a
; direct one (measured on the dependency walk: 12 us vs 82 us for one pass over
; an 8000-element list). `force/1` runs on every realised element, so its whole
; protocol is compiled as direct calls. The PUBLIC ABI is unchanged; the extra
; names are internal and their docstrings say so.
;
; Run: bin/bl test test/bl/lazy_producers_test.bl test/bl/host_module_test.bl

(ns host.lazy-seq)

(defn lazy?
  "True for a lazy node — a map tagged with the `BeamLisp.LazySeq` struct."
  [x]
  (and (erlang/is_map x)
       (erlang/is_map_key :__struct__ x)
       (erlang/== :"Elixir.BeamLisp.LazySeq" (erlang/map_get :__struct__ x))))

(defn chunk_size
  "Elements per shared memo cell for the chunked producers."
  [] 32)

(defn new
  "Wrap a recipe in a shared lazy node. A successful result is memoized.

   The cell is BORN holding `{:pending thunk}`, so its edges are the recipe's
   captured resources from the start and every LATER transition's edge set is a
   subset of them. That is what keeps the NIF's cycle walk off the hot path:
   the walk is unbounded in the reachable set, and a cell that carried no edges
   until its value arrived would re-walk every node behind each new one.

   The two-arity form also gives the node a fold `recipe` a reducing consumer
   may use while it is still `:pending` (see the namespace header). The recipe
   lives ON THE CELL, `{:pending thunk recipe}`, for the reason the thunk does:
   a struct field would be copied with every value that embeds the node."
  ([thunk]
   (if (and (erlang/is_function thunk)
            (erlang/== 0 (erlang/element 2 (erlang/fun_info thunk :arity))))
     (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
       {:__struct__ mod
        :resource (BeamLisp.LazyMemo/create (tuple :pending thunk))
        :metadata nil})
     (erlang/error
       (Elixir.FunctionClauseError/exception
         (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
               (tuple :function :new)
               (tuple :arity 1))))))
  ([thunk recipe]
   (if (and (erlang/is_function thunk)
            (erlang/== 0 (erlang/element 2 (erlang/fun_info thunk :arity)))
            (erlang/is_function recipe)
            (erlang/== 2 (erlang/element 2 (erlang/fun_info recipe :arity))))
     (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
       {:__struct__ mod
        :resource (BeamLisp.LazyMemo/create (tuple :pending thunk recipe))
        :metadata nil})
     (erlang/error
       (Elixir.FunctionClauseError/exception
         (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
               (tuple :function :new)
               (tuple :arity 2)))))))

(defn from_fun
  "`new/1` under the spelling the `lazy-seq` macro uses."
  [thunk]
  (if (and (erlang/is_function thunk)
           (erlang/== 0 (erlang/element 2 (erlang/fun_info thunk :arity))))
    (new thunk)
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :from_fun)
              (tuple :arity 1))))))

(defn pending_recipe
  "`{recipe version}` when the node's head cell is `{:pending thunk recipe}` at
   `version`, else `nil`: no recipe, or already claimed, realised, failed or
   terminal. One read answers both questions a fold asks, and the version is
   what `publish_folded` CASes against."
  [l]
  (let [current (BeamLisp.LazyMemo/read_versioned (erlang/map_get :resource l))
        state (erlang/element 2 current)]
    (cond
      (and (erlang/is_tuple state)
           (erlang/== 3 (erlang/tuple_size state))
           (erlang/== :pending (erlang/element 1 state)))
      (tuple (erlang/element 3 state) (erlang/element 1 current))
      :else nil)))

(defn pending?
  "Whether the node's head cell is still `:pending` — the one state in which a
   fold recipe may be used (see the namespace header). Any other state —
   already realised, in flight elsewhere, failed-then-retried, or terminal —
   reads through the memo walk instead."
  [l]
  (cond
    (lazy? l)
    (let [state (BeamLisp.LazyMemo/read (erlang/map_get :resource l))]
      (and (erlang/is_tuple state)
           (erlang/== :pending (erlang/element 1 state))))
    :else
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :pending?)
              (tuple :arity 1))))))

(defn input
  "The normalised input a lazy producer walks: a vector becomes its list, a
   list longer than `chunk_size` becomes a `SeqCursor` (O(1) to copy, at most
   one small chunk on the BEAM heap), anything else passes through. A list of
   `chunk_size` or fewer — including an improper one, whose `length` has no
   answer — stays itself."
  [x]
  (cond
    (and (erlang/is_map x) (erlang/is_map_key :__struct__ x)
         (erlang/== :"Elixir.BeamLisp.Vector" (erlang/map_get :__struct__ x)))
    (input (BeamLisp.Vector/to_list x))

    (erlang/is_list x)
    (let [size (try (erlang/length x) (catch-raw [kind reason stack] 0))]
      (cond
        (erlang/> size (chunk_size)) (BeamLisp.SeqCursor/new x)
        :else x))

    :else x))

(defn chain
  "Prepend `elems` (in order) onto a node built from `tail-fun` — the shape a
   chunked producer's cell uses for everything past its first chunk. An empty
   `elems` answers `nil`: there is nothing to chain."
  [elems tail-fun]
  (cond
    (erlang/== elems ()) nil
    (and (erlang/is_function tail-fun)
         (erlang/== 0 (erlang/element 2 (erlang/fun_info tail-fun :arity))))
    (erlang/apply :lists :foldr
      (list (fn [e acc] (erlang/apply :lists :append (list (list (list e) acc))))
            (new tail-fun)
            elems))
    :else
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :chain)
              (tuple :arity 2))))))

; ── the force protocol ───────────────────────────────────────────────────────
;
; INTERNAL, AND TOP LEVEL FOR A MEASURED REASON. A call through a local closure
; is an INDIRECT call, and on this host an indirect call costs up to ten times a
; direct one (see `BeamLisp.LazyMemo`'s `deps_walk/6` for the measurement).
; `force/1` runs on every realised element, so its whole protocol lives at top
; level — the recalled module's own private names, one level up — and the
; dispatch between them is a direct call.
;
; `again` is the caller's FRESH REFERENCE: a term minted inside this call, so no
; user value can equal it. That is how a helper says "the cell moved under me,
; re-dispatch" without a sentinel a user term could be mistaken for.

(defn publish_folded
  "Publish the COMPLETE element list a fold recipe produced over the node's
   pending head cell at `version` — the recipe's answer becomes the shared
   answer, so a later consumer reads it instead of re-running the producer
   (Clojure's realise-once contract). A version that moved (someone else
   realised or claimed the node meanwhile) or a would-be cycle leaves the cell
   as it is: publishing is an optimisation of the NEXT read, never needed for
   this fold's own answer. Returns `:ok`, `:retry` or `:cycle`."
  [l version elems]
  (let [state (tuple :completed (cond (erlang/== elems ()) nil :else elems))]
    (BeamLisp.LazyMemo/exchange_version
      (erlang/map_get :resource l) version state (attempt_deps state))))

(defn force_error
  "INTERNAL: the refusal every force failure is reported as."
  [reason]
  (erlang/error (Elixir.BeamLisp.LazySeq.ForceError/exception reason)))

(defn return_outcome
  "INTERNAL: peel an attempt outcome — the value, the evaluator's own failure
   replayed with `erlang:raise/3`, or the terminal reason."
  [outcome]
  (cond
    (erlang/== :completed (erlang/element 1 outcome)) (erlang/element 2 outcome)
    (erlang/== :failed (erlang/element 1 outcome))
    (erlang/raise (erlang/element 2 outcome)
                  (erlang/element 3 outcome)
                  (erlang/element 4 outcome))
    :else (force_error (erlang/element 2 outcome))))

(defn attempt_outcome
  "INTERNAL: a CELL state as the OUTCOME a waiter replays. The two differ for a
   failure: the cell keeps the recipe so a retry can run it, the outcome is the
   class, the unnormalized reason and the raw stack."
  [state]
  (cond
    (erlang/== :failed (erlang/element 1 state))
    (tuple :failed (erlang/element 3 state)
           (erlang/element 4 state) (erlang/element 5 state))
    :else state))

(defn attempt_deps
  "INTERNAL: the edge policy for publishing `state` — `:keep` for a terminal
   state (it reaches nothing new), the state's own walk otherwise, which the NIF
   UNIONS with the cell's existing edges."
  [state]
  (cond
    (erlang/== :terminal (erlang/element 1 state)) :keep
    :else (BeamLisp.LazyMemo/dependencies state)))

(defn attempt_owner?
  "INTERNAL: is `state` the running attempt `attempt` owned by `owner`?"
  [state attempt owner]
  (and (erlang/is_tuple state)
       (erlang/== :running (erlang/element 1 state))
       (erlang/== owner (erlang/element 2 state))
       (erlang/== attempt (erlang/element 3 state))))

(defn attempt_notifications
  "INTERNAL: one `{:lazy_attempt, identity, attempt, outcome}` per waiter. No
   waiters is the common case and answers without minting an identity."
  [resource attempt waiters outcome]
  (cond
    (erlang/== waiters ()) ()
    :else
    (let [identity (BeamLisp.LazyMemo/id resource)]
      (Enum/map waiters
        (fn [w] (tuple w (tuple :lazy_attempt identity attempt outcome)))))))

(defn publish_attempt
  "INTERNAL: publish `state` over the attempt this process owns, waking every
   registered waiter with the outcome. Returns the OUTCOME; the caller peels it
   with `return_outcome`.

   An evaluator cannot be interrupted between publication and notification:
   both are one native operation, so a waiter that arrives after a successful
   publish still reads its exact answer."
  [l attempt state]
  (let [resource (erlang/map_get :resource l)
        current (BeamLisp.LazyMemo/read_versioned resource)
        version (erlang/element 1 current)
        cell (erlang/element 2 current)]
    (cond
      (attempt_owner? cell attempt (erlang/self))
      (let [waiters (erlang/element 4 cell)
            outcome (attempt_outcome state)
            outgoing (BeamLisp.LazyMemo/exchange_version
                       resource version state (attempt_deps state)
                       (attempt_notifications resource attempt waiters outcome))]
        (cond
          (erlang/== :ok outgoing) outcome
          (erlang/== :retry outgoing) (publish_attempt l attempt state)
          :else (publish_attempt l attempt (tuple :terminal :cyclic_memo))))

      (and (erlang/is_tuple cell) (erlang/== :terminal (erlang/element 1 cell)))
      cell

      :else (force_error (tuple :stale_force_owner attempt)))))

(defn evaluate_attempt
  "INTERNAL: run the recipe and publish what it produced — its value, or the
   failure `catch-raw` captured bit for bit."
  [l attempt thunk]
  (return_outcome
    (publish_attempt l attempt
      (try (tuple :completed (erlang/apply thunk ()))
           (catch-raw [kind reason stack] (tuple :failed thunk kind reason stack))))))

(defn claim_attempt
  "INTERNAL: claim the pending (or failed) state at `version` and run it.

   The claim swaps the VERSION and keeps the edges: the cell was created with
   the recipe's own captured resources as its edges, so `:keep` is exact — no
   dependency walk, no graph lock, no term comparison. The running state does
   not carry the recipe: its owner is executing it."
  [l version thunk again]
  (BeamLisp.LazyMemo/admit!)
  (let [resource (erlang/map_get :resource l)
        attempt (erlang/make_ref)
        running (tuple :running (erlang/self) attempt ())
        outcome (BeamLisp.LazyMemo/exchange_version resource version running :keep)]
    (cond
      (erlang/== :ok outcome) (evaluate_attempt l attempt thunk)
      (erlang/== :retry outcome) again
      :else (force_error :cyclic_memo))))

(defn owner_lost
  "INTERNAL: the evaluator is gone. Publish a TERMINAL reply to every
   registered waiter so no waiter hangs on a dead owner; the reply rides the
   same native operation as the commit."
  [l owner attempt]
  (let [resource (erlang/map_get :resource l)
        current (BeamLisp.LazyMemo/read_versioned resource)
        version (erlang/element 1 current)
        cell (erlang/element 2 current)]
    (cond
      (attempt_owner? cell attempt owner)
      (let [terminal (tuple :terminal (tuple :force_owner_lost owner attempt))
            outgoing (BeamLisp.LazyMemo/exchange_version
                       resource version terminal :keep
                       (attempt_notifications resource attempt
                                              (erlang/element 4 cell) terminal))]
        (cond
          (erlang/== :ok outgoing) :ok
          (erlang/== :retry outgoing) (owner_lost l owner attempt)
          :else (force_error :cyclic_memo)))
      :else :ok)))

(defn receive_attempt
  "INTERNAL: wait for our attempt's reply, or for the owner's death.

   A receive clause's guard is a BARE `:when` (not a `(:when …)` list), and its
   guard vocabulary is the language's own (`==`, `and`, `pid?`, …), never a
   `erlang/`-prefixed call. Both clauses are guarded, which is what keeps
   receive SELECTIVE: a message that is neither our attempt's reply nor our
   monitor's DOWN is left in the mailbox, exactly as the recalled module's
   pinned patterns did."
  [l identity owner attempt monitor]
  (receive
    [:lazy_attempt i a outcome]
    :when (and (== i identity) (== a attempt))
    (do (Process/demonitor monitor (list :flush))
        (return_outcome outcome))

    [:DOWN ref :process _ _]
    :when (== ref monitor)
    (do (owner_lost l owner attempt)
        ; A commit and its notifications are one native operation, so if the
        ; commit won before owner death its exact reply is still in flight —
        ; read it. Otherwise `owner-lost` just published ours.
        (receive
          [:lazy_attempt i2 a2 outcome2]
          :when (and (== i2 identity) (== a2 attempt))
          (return_outcome outcome2)))))

(defn wait_for_attempt
  "INTERNAL: join a running attempt — register as a waiter with a version CAS
   (edges kept: a waiter is not a dependency), monitor the owner, and wait."
  [l owner attempt again]
  (let [resource (erlang/map_get :resource l)
        identity (BeamLisp.LazyMemo/id resource)
        monitor (Process/monitor owner)
        current (BeamLisp.LazyMemo/read_versioned resource)
        version (erlang/element 1 current)
        cell (erlang/element 2 current)]
    (cond
      (attempt_owner? cell attempt owner)
      (let [outcome (BeamLisp.LazyMemo/exchange_version
                      resource version
                      (tuple :running owner attempt
                             (erlang/++ (list (erlang/self))
                                        (erlang/element 4 cell)))
                      :keep)]
        (cond
          (erlang/== :ok outcome)
          (receive_attempt l identity owner attempt monitor)
          (erlang/== :retry outcome)
          (do (Process/demonitor monitor (list :flush)) again)
          :else
          (do (Process/demonitor monitor (list :flush))
              (force_error :cyclic_memo))))
      :else (do (Process/demonitor monitor (list :flush)) again))))

(defn force_state
  "INTERNAL: the force state machine — a TOP-LEVEL self-recursion, so every
   re-dispatch after a lost race is a direct call. `again` is the caller's
   fresh reference (see the section header)."
  [l again]
  (let [resource (erlang/map_get :resource l)
        current (BeamLisp.LazyMemo/read_versioned resource)
        version (erlang/element 1 current)
        state (erlang/element 2 current)
        tag (cond (erlang/is_tuple state) (erlang/element 1 state) :else state)]
    (cond
      (erlang/== tag :completed) (erlang/element 2 state)
      (erlang/== tag :terminal) (return_outcome state)

      (erlang/== tag :running)
      (cond
        (erlang/== (erlang/element 2 state) (erlang/self))
        (return_outcome (publish_attempt l (erlang/element 3 state)
                                         (tuple :terminal :recursive_force)))
        :else
        (let [r (wait_for_attempt l (erlang/element 2 state) (erlang/element 3 state) again)]
          (cond (erlang/== r again) (force_state l again) :else r)))

      (erlang/== tag :pending)
      (let [r (claim_attempt l version (erlang/element 2 state) again)]
        (cond (erlang/== r again) (force_state l again) :else r))

      (erlang/== tag :failed)
      (let [r (claim_attempt l version (erlang/element 2 state) again)]
        (cond (erlang/== r again) (force_state l again) :else r))

      :else (force_error (tuple :stale_force_owner state)))))

(defn force
  "Force a node to its value: the shared answer if one is published, the
   evaluator's own failure replayed if the attempt failed, `ForceError`
   otherwise. Concurrent forces of one node share one attempt; the waiter is
   told the exact outcome, and the owner's death is terminal.

   Every transition is a VERSION compare-and-swap, and the `deps_mode` it
   passes is the point: `:keep` for a claim, a waiter registration and a
   terminal state (they reach nothing the cell did not already hold, so no
   dependency is walked and no cycle is checked), and the state's own walk for
   a `{:completed v}` or `{:failed …}`, which the NIF UNIONS with the cell's
   existing edges."
  [l]
  (cond
    (erlang/== false (lazy? l))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :force)
              (tuple :arity 1))))

    :else (force_state l (erlang/make_ref))))

(defn memo_state
  "The cell's state in the LOGICAL shape callers use. `{:pending thunk}`,
   `{:completed value}`, `{:failed thunk kind reason stack}` and
   `{:terminal reason}` are the cell's own states, returned as they are. A
   running cell answers `{:running nil owner attempt waiters}`: the shape is the
   recalled one — a waiter list, an owner, an attempt — but the thunk slot is
   `nil` because the recipe is on the owner's stack by then, not on the cell.
   `Deferred`'s `realized?` reads only the `:completed` tag."
  [l]
  (cond
    (erlang/== false (lazy? l))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :memo_state)
              (tuple :arity 1))))

    :else
    (let [state (BeamLisp.LazyMemo/read (erlang/map_get :resource l))]
      (cond
        (and (erlang/is_tuple state)
             (erlang/== :running (erlang/element 1 state)))
        (tuple :running nil (erlang/element 2 state)
               (erlang/element 3 state) (erlang/element 4 state))
        :else state))))

(defn normalize_cell
  "INTERNAL: `nil` for the empty list, else the list itself — the realized value
   an empty or non-empty collection normalizes to."
  [xs]
  (cond (erlang/== xs ()) nil :else xs))

(defn tagged?
  "INTERNAL: a map tagged with the struct `name` (`:__struct__` is the tag)."
  [v name]
  (and (erlang/is_map v)
       (erlang/is_map_key :__struct__ v)
       (erlang/== name (erlang/map_get :__struct__ v))))

(defn realize_step
  "INTERNAL: one realize step — force, then normalize the head. TOP LEVEL so a
   nested lazy chain (`(lazy-seq (concat …))` hands back another node) is peeled
   by a direct self-call instead of an indirect one."
  [node depth]
  (cond
    (erlang/> depth 100000)
    (erlang/error
      (Elixir.RuntimeError/exception
        (str "LazySeq.realize: thunk chain " depth " deep without a head — "
             "a self-referential lazy seq never produces a cell; it would hang forever")))

    :else
    (let [v (force node)]
      (cond
        (erlang/== v ()) nil
        (tagged? v :"Elixir.BeamLisp.Vector") (normalize_cell (BeamLisp.Vector/to_list v))
        (tagged? v :"Elixir.BeamLisp.Set") (normalize_cell (BeamLisp.Set/to_list v))
        (lazy? v) (realize_step v (erlang/+ depth 1))
        (tagged? v :"Elixir.BeamLisp.SeqCursor") (BeamLisp.SeqCursor/cell v)
        :else v))))

(defn realize
  "Force a node and normalize to a realized cell: `nil` or `[head | tail]`.

   A lazy-seq body may hand back any seqable rather than a cons cell — jank
   writes `(lazy-seq c1)` around a bare collection — so normalize it here, at
   the one place a thunk's value enters the walk. Without this a realized
   vector reached the walk loops as an opaque value and crashed with no
   matching clause. The invariant every walk relies on is: forcing a node
   yields `nil` or a `[h | t]` cell, never a bare LazySeq — and Clojure
   `lazy-seq` bodies routinely *return another seq*, so a thunk that hands back
   a bare LazySeq is idiomatic, not an error. Only the HEAD is normalized; the
   tail stays lazy, so an infinite seq still realizes one cell at a time."
  [l]
  (cond
    (erlang/== false (lazy? l))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :realize)
              (tuple :arity 1))))

    :else (realize_step l 0)))

(defn cell
  "Normalize any seqable to a realized cell: `nil`, a `[head | tail]` list
   (whose tail may be a `LazySeq`), or, for non-seqables, the value itself.
   This is the one chokepoint every seq walk (forcing, `first`, `rest`,
   `take`, `count`, `Enum`) goes through.

   A lazy-seq body may return any seqable — jank wraps a bare collection in
   `(lazy-seq c1)` — so anything Enumerable becomes a cell rather than falling
   through as an opaque value that the walk loops then cannot match.
   Non-seqable values still pass through."
  [x]
  (cond
    (erlang/== x nil) nil
    (erlang/== x ()) nil
    (lazy? x) (realize x)
    (tagged? x :"Elixir.BeamLisp.SeqCursor") (BeamLisp.SeqCursor/cell x)
    (erlang/is_list x) x
    (tagged? x :"Elixir.BeamLisp.Vector") (normalize_cell (BeamLisp.Vector/to_list x))
    (tagged? x :"Elixir.BeamLisp.Set") (normalize_cell (BeamLisp.Set/to_list x))
    (erlang/is_binary x) (normalize_cell (String/graphemes x))
    :else
    (cond
      (erlang/== nil (erlang/apply :"Elixir.Enumerable" :impl_for (list x))) x
      :else (normalize_cell (Enum/to_list x)))))

(defn to_list
  "Fully realize into a proper list (iterative — a 100k `doall` cannot blow the
   stack)."
  [lazy]
  (let [go (fn go [c acc]
               (cond
                 (erlang/== c nil) (Enum/reverse acc)
                 :else (go (cell (erlang/tl c))
                             (erlang/++ (list (erlang/hd c)) acc))))]
    (go (cell lazy) ())))

(defn prefix
  "Realize up to `n` elements (iterative)."
  [lazy n]
  (cond
    (erlang/== false (erlang/is_integer n))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :prefix)
              (tuple :arity 2))))
    :else
    (let [go (fn go [c k acc]
                 (cond
                   (erlang/=< k 0) (Enum/reverse acc)
                   (erlang/== c nil) (Enum/reverse acc)
                   :else (go (cell (erlang/tl c))
                               (erlang/- k 1)
                               (erlang/++ (list (erlang/hd c)) acc))))]
      (go (cell lazy) n ()))))

(defn sample
  "`{taken, truncated?}`: sample up to `n` elements, flag if more remain."
  [lazy n]
  (let [taken (prefix lazy (erlang/+ n 1))]
    (cond
      (erlang/> (erlang/length taken) n) (tuple (Enum/take taken n) true)
      :else (tuple taken false))))

(defn count
  "Element count, forcing the whole seq (iterative)."
  [lazy]
  (let [go (fn go [c acc]
               (cond
                 (erlang/== c nil) acc
                 :else (go (cell (erlang/tl c)) (erlang/+ acc 1))))]
    (go (cell lazy) 0)))

(defn nth
  "Element at `i`, or `nil` (iterative)."
  [lazy i]
  (cond
    (erlang/== false (and (erlang/is_integer i) (erlang/>= i 0)))
    (erlang/error
      (Elixir.FunctionClauseError/exception
        (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
              (tuple :function :nth)
              (tuple :arity 2))))
    :else
    (let [go (fn go [c k]
                 (cond
                   (erlang/== c nil) nil
                   (erlang/== k 0) (erlang/hd c)
                   :else (go (cell (erlang/tl c)) (erlang/- k 1))))]
      (go (cell lazy) i))))

(defn run
  "Force the whole seq for side effects, discarding elements."
  [lazy]
  (let [go (fn go [c]
               (cond
                 (erlang/== c nil) :ok
                 :else (go (cell (erlang/tl c)))))]
    (go (cell lazy))))
