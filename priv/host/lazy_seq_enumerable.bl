; host/lazy_seq_enumerable.bl — the pinned PROTOCOL IMPL for `BeamLisp.LazySeq`.
;
; `defimpl Enumerable, for: BeamLisp.LazySeq` is its own module,
; `Enumerable.BeamLisp.LazySeq`, compiled beside the type it serves. This file
; is the `.bl` port of that impl, compiled by `BeamLisp.AOT/compile_host_file`
; into `Elixir.Enumerable.BeamLisp.LazySeq.beam`.
;
; ABI PARITY IS THE CONTRACT. `count` delegates to `BeamLisp.LazySeq.count/1`,
; the same call the Elixir impl made, so `Enum.count/1` forces the seq the same
; way; `member?` and `slice` report `{:error, <impl module>}` so the caller
; falls back to `reduce` (there is no constant-time membership or slice here);
; `reduce` walks one realized cell at a time and forwards `:cont` / `:halt` /
; `:suspend` exactly — including the suspension's resumption closure, which
; continues from the cell AFTER the one it suspended on; and `__impl__/1`
; answers `:for` (the type) and `:protocol` (the protocol). An unknown
; `__impl__` key raises `FunctionClauseError`, as the generated two-clause
; function did.
;
; FUNCTIONS-ONLY: no `:struct_fields`, so this beam gains no `__struct__` or
; `__info__` export. The `{:error, module}` answers name their own module from a
; fun literal compiled into THIS file, so at a probe atom they answer that atom
; — module-exact, never a hard-coded `Enumerable.BeamLisp.LazySeq`.
;
; Run: bin/bl test test/bl/host_lazy_test.bl

(ns host.lazy-seq-enumerable)

(defn __impl__
  "The `defimpl`-generated introspection: `:for` is the type, `:protocol` the
   protocol. An unknown key is the `FunctionClauseError` the generated
   two-clause function raised."
  [k]
  (cond
    (= :for k) :"Elixir.BeamLisp.LazySeq"
    (= :protocol k) :"Elixir.Enumerable"
    :else (erlang/error
            (Elixir.FunctionClauseError/exception
              (list (tuple :module (erlang/element 2 (erlang/fun_info (fn [] nil) :module)))
                    (tuple :function :__impl__)
                    (tuple :arity 1))))))

(defn count
  "`Enumerable.count/1`: the element count, tagged `{:ok, n}`."
  [lazy]
  (tuple :ok (BeamLisp.LazySeq/count lazy)))

(defn member?
  "No membership walk of its own; the caller falls back to `reduce`."
  [_lazy _x]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))

(defn reduce
  "`Enumerable.reduce/3`: force one cell at a time, forwarding `:cont`/`:halt`/
   `:suspend`. A suspension hands back a resumption closure that continues at
   the tail of the cell it stopped on."
  [lazy acc fun]
  (let [do-reduce
        (fn do-reduce [acc lazy fun]
          (cond
            (and (erlang/is_tuple acc) (erlang/== :halt (erlang/element 1 acc)))
            (tuple :halted (erlang/element 2 acc))

            (and (erlang/is_tuple acc) (erlang/== :suspend (erlang/element 1 acc)))
            (tuple :suspended (erlang/element 2 acc)
                   (fn [a] (do-reduce a lazy fun)))

            (and (erlang/is_tuple acc) (erlang/== :cont (erlang/element 1 acc)))
            (let [c (BeamLisp.LazySeq/cell lazy)]
              (cond
                (erlang/== c nil) (tuple :done (erlang/element 2 acc))
                :else
                (let [outcome (fun (erlang/hd c) (erlang/element 2 acc))]
                  (cond
                    (erlang/== :cont (erlang/element 1 outcome))
                    (do-reduce (tuple :cont (erlang/element 2 outcome)) (erlang/tl c) fun)
                    (erlang/== :halt (erlang/element 1 outcome))
                    (tuple :halted (erlang/element 2 outcome))
                    :else
                    (tuple :suspended (erlang/element 2 outcome)
                           (fn [a] (do-reduce a (erlang/tl c) fun)))))))))
        ]
    (do-reduce acc lazy fun)))

(defn slice
  "No constant-time slice for a lazy seq; the caller falls back to `reduce`."
  [_lazy]
  (tuple :error (erlang/element 2 (erlang/fun_info (fn [] nil) :module))))
