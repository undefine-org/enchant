; host/atom.bl — the pinned HOST MODULE for `Elixir.BeamLisp.Atom`.
;
; `BeamLisp.Atom` is the reference type behind beam-lisp's `(atom v)`: a value
; behind a GC-owned memo cell, plus a SECOND cell holding the watch table
; `%{key => fn}`. It carries its own struct so an atom is never mistaken for a
; plain map. This file is the `.bl` port of `lib/beam_lisp/refs.ex`'s
; `BeamLisp.Atom` half, compiled by `BeamLisp.AOT/compile_host_file` into ONE
; exact-named beam (`Elixir.BeamLisp.Atom.beam`) whose `__struct__/0,1` pair
; and `__info__/1` are SYNTHESIZED by the `:struct_fields` option — no
; `defstruct`, no Elixir source.
;
; A pinned module is FUNCTIONS-only, so the source must spell at least one
; `defn`; `new/2` is that public constructor. It builds the same map as
; `defstruct [:cell, :watches]` — tagged with whatever module this file was
; compiled into — so a probe compile answers its own `__struct__/1`.
;
; Run: bin/bl test test/bl/host_refs_test.bl

(ns host.atom)

; WHY NOT `(__struct__ …)`. `__struct__/1` is synthesized by the pinned
; emitter from `:struct_fields`, and a pinned file cannot call it by name: an
; unqualified `__struct__` is not a unit defn, so the compiler lowers it to a
; var lookup rather than the direct call the pinned retarget step could fix.
; The tag the emitter bakes into `__struct__/0` is the module this file's own
; code occupies; the module a fun literal compiled into this file occupies is
; the same atom, and `erlang:fun_info(F, module)` answers exactly it. So `new`
; is module-exact: at `BeamLisp.Atom` it builds `%BeamLisp.Atom{}`, and a probe
; compile under any other atom builds that atom's struct — matching that
; beam's `__struct__/1`.
(defn new
  "The `%Atom{cell: cell, watches: watches}` constructor: `__struct__/1` fed
   the two fields in declaration order."
  [cell watches]
  (let [mod (erlang/element 2 (erlang/fun_info (fn [] nil) :module))]
    (maps/put :__struct__ mod
      (maps/put :cell cell
        (maps/put :watches watches (maps/new))))))
