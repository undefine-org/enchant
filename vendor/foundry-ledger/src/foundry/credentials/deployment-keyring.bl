; src/foundry/credentials/deployment-keyring.bl — Foundry's secrets live in the system keyring, never on disk.
;
; The freedesktop Secret Service reached through the `secret-tool` CLI:
; $FOUNDRY_SECRET_TOOL when set (tests use a fake), else `secret-tool` on the
; system tool dirs. Item attributes: service=foundry env=<sandbox|production>
; scope=<scope> name=<VAR>; label "Foundry <env> <scope> <name>".
; Named launch instances use service=foundry-instance-<FOUNDRY_INSTANCE>.
; Unnamed launches keep service=foundry; neither can match the other's items.
;
; Laws:
;   * A value travels only on a child's stdin (store) or stdout (lookup) —
;     never argv, never a child's environment, never an error text.
;   * No fallback: a locked/missing keyring is a refusal, never a file.
;   * Every call is bounded (30 s) so an unanswerable prompt cannot hang a job.
;
; Contract:
;   (store! env scope name value) → {:ok true} | {:error :keyring-unavailable :message msg}
;   (lookup env scope name)       → {:ok value} | {:error :keyring-missing :message msg}
;                                   | {:error :keyring-unavailable :message msg}
;   (clear! env scope name)       → nil (best effort)
;   (ref env scope) / (parse-ref s) → "@keyring:<env>/<scope>" / [env scope] | nil
;   (read-env-file path {:resolve-keyring true}) → {:ok {name value}} | {:error msg}
;     owner-only regular non-symlink file; the message never contains a value.

(ns deployment-keyring
  (:require [deployment-exec :as x]))

(def timeout-ms 30000)
(def ref-prefix "@keyring:")
(def unavailable-message
  "the system keyring is locked or unavailable — unlock it (log into the desktop session) and try again")

(defn ref [env scope] (str ref-prefix env "/" scope))

(defn parse-ref [s]
  (when (string? s)
    (let [m (Regex/run (Regex/compile! "^@keyring:(sandbox|production)/([a-z0-9]+)$") s)]
      (when m [(nth m 1) (nth m 2)]))))

(defn- binary []
  (let [e (System/get_env "FOUNDRY_SECRET_TOOL")]
    (if (and e (not= e "")) e (x/tool "secret-tool"))))

(defn- attrs [env scope name]
  (let [instance (System/get_env "FOUNDRY_INSTANCE")
        base ["service" "foundry" "env" env "scope" scope "name" name]]
    (if (or (nil? instance) (= "" instance))
      base
      (do
        (when-not (Regex/match? (Regex/compile! "^[a-z0-9][a-z0-9-]{0,63}\\z") instance)
          (throw (ex-info "FOUNDRY_INSTANCE must be a lowercase instance name (1-64 characters)"
                          {"kind" "deployment-keyring"})))
        ;; A distinct service also keeps legacy lookups from matching named items:
        ;; Secret Service lookup matches a subset of attributes, not exact equality.
        (assoc base 1 (str "foundry-instance-" instance))))))

;; x/run gives a child exactly the env it is handed (nothing inherited). The
;; Secret Service is reached over the user's D-Bus SESSION, so its address must
;; pass through (without it: "Cannot autolaunch D-Bus without X11 $DISPLAY",
;; which read as `keyring-unavailable` on an unlocked keyring). E2E_KEYRING is
;; the e2e stand-in's store. Named allowlist, never a prefix match.
(def session-env
  ["DBUS_SESSION_BUS_ADDRESS" "XDG_RUNTIME_DIR" "HOME" "DISPLAY" "WAYLAND_DISPLAY" "E2E_KEYRING"])

(defn- child-env []
  (reduce (fn [m k] (let [v (System/get_env k)] (if (and (string? v) (not= v "")) (assoc m k v) m)))
          {} session-env))

(defn- call [args stdin]
  (let [b (binary)]
    (if b
      (x/run b args {:stdin stdin :timeout-ms timeout-ms :limit 65536 :env (child-env)})
      {:status :spawn-failed :error "secret-tool is not installed"})))

(defn store! [env scope name value]
  (let [r (call (vec (concat ["store" (str "--label=Foundry " env " " scope " " name)]
                             (attrs env scope name)))
                (str value))]
    (if (x/ok? r)
      {:ok true}
      {:error :keyring-unavailable :message unavailable-message})))

(defn lookup [env scope name]
  (let [r (call (vec (cons "lookup" (attrs env scope name))) nil)
        out (or (:out r) "")]
    (cond
      (not= :exited (:status r)) {:error :keyring-unavailable :message unavailable-message}
      (and (= 0 (:exit r)) (> (erlang/byte_size out) 0))
      {:ok (if (String/ends_with? out "\n") (subs out 0 (- (count out) 1)) out)}
      ;; secret-tool is silent when an item is absent; any text means the
      ;; collection could not be opened.
      (and (not= 0 (:exit r)) (not= "" (String/trim out)))
      {:error :keyring-unavailable :message unavailable-message}
      :else {:error :keyring-missing
             :message (str "no " scope " credential " name " in the keyring for " env
                           "; Connect it again in Accounts")})))

(defn clear! [env scope name]
  (call (vec (cons "clear" (attrs env scope name))) nil)
  nil)

;; ── env files ───────────────────────────────────────────────────────────────

(def uid-cache (atom nil))

(defn- current-uid []
  (or @uid-cache
      (let [r (x/run (x/tool "id") ["-u"] {:timeout-ms 5000})
            n (when (x/ok? r) (erlang/binary_to_integer (String/trim (:out r))))]
        (reset! uid-cache n)
        n)))

;; #file_info{size,type,access,atime,mtime,ctime,mode,links,major_device,
;;            minor_device,inode,uid,gid}: element 1 is the record tag.
(defn- check-file [path]
  (let [info (erlang/apply :file :read_link_info (list path))]
    (if (not= :ok (erlang/element 1 info))
      (str "envFile cannot be read: " path)
      (let [fi (erlang/element 2 info)
            ftype (erlang/element 3 fi)
            mode (erlang/element 8 fi)
            uid (erlang/element 13 fi)]
        (cond
          (not= :regular ftype) (str "envFile must be a regular file, not a symlink or device: " path)
          (not= uid (current-uid)) (str "envFile must be owned by the job owner: " path)
          (not= 0 (erlang/band mode 63)) (str "envFile must be owner-only (chmod 600): " path)
          :else nil)))))

(defn- resolve-value [name value]
  (if-not (String/starts_with? value ref-prefix)
    {:ok value}
    (let [p (parse-ref value)]
      (if-not p
        {:error (str "envFile " name " has a malformed keyring reference")}
        (let [[env scope] p
              r (lookup env scope name)]
          (cond
            (contains? r :ok) r
            (= :keyring-missing (:error r))
            {:error (str "the " scope " account has no " name " in the keyring (" env
                         "). Connect it again in Accounts")}
            :else {:error (str "the " scope " account cannot be read: keyring locked or unavailable. "
                               "Unlock it (log into the desktop session) and try again")}))))))

(defn read-env-file
  ([path] (read-env-file path {:resolve-keyring true}))
  ([path opts]
   (let [bad (check-file path)]
     (if bad
       {:error bad}
       (loop [ls (String/split (File/read! path) "\n") n 1 acc {}]
         (if (empty? ls)
           {:ok acc}
           (let [line (first ls)]
             (if (or (= "" line) (String/starts_with? (String/trim line) "#"))
               (recur (rest ls) (+ n 1) acc)
               (let [i (index-of line "=")]
                 (if (or (nil? i) (< i 0))
                   {:error (str "envFile line " n " is not NAME=VALUE")}
                   (let [name (String/trim (subs line 0 i))
                         value (subs line (+ i 1))]
                     (if-not (Regex/match? (Regex/compile! "^[A-Za-z_][A-Za-z0-9_]*$") name)
                       {:error (str "envFile line " n " has an invalid variable name")}
                       (let [r (if (get opts :resolve-keyring true)
                                 (resolve-value name value)
                                 {:ok value})]
                         (if (contains? r :ok)
                           (recur (rest ls) (+ n 1) (assoc acc name (:ok r)))
                           r)))))))))))))
)
