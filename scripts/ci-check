#!/usr/bin/env python3
"""Run bounded current checks through the host's configured Nix worker policy."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--sdk', help='Existing immutable SDK selection; default uses normal production')
parser.add_argument('--previous', help='Retained SDK whose completed units may be reused by production')
parser.add_argument('--local', action='store_true',
                    help='Explicitly use this host\'s bounded KVM worker; default requires the build station')
parser.add_argument('--models', type=Path, help='Explicit immutable pinned model root for inventory prerequisites')
parser.add_argument('--out', type=Path, required=True)
parser.add_argument('--source', type=Path, default=root, help='Checkout to snapshot; defaults to this tree')
parser.add_argument('--shard', type=int)
parser.add_argument('--shards', type=int, default=4)
parser.add_argument('files', nargs='*')
args = parser.parse_args()
project = args.source.resolve(strict=True)
models = None
if args.models:
    models = args.models.resolve(strict=True)
    if not re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', str(models)):
        parser.error('Models must name an immutable Nix store input')
    spec = importlib.util.spec_from_file_location('ci_model_input', root / 'scripts/ci-model-input.py')
    model_input = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(model_input)
    subprocess.run(['nix-store', '--check-validity', str(models)], check=True)
    model_input.verify(models, project)
if args.out.exists() or args.out.is_symlink():
    parser.error('Output must be absent; preserve prior receipts')
if args.shard is None:
    if not args.files:
        parser.error('Select files or an explicit shard')
    if len(args.files) != len(set(args.files)):
        parser.error('Select each test file once')
    for name in args.files:
        path = Path(name)
        if path.is_absolute() or not name.endswith(('_test.bl', '_test.exs')):
            parser.error('Select relative test files ending in _test.bl or _test.exs')
        try:
            selected = (project / path).resolve(strict=True)
        except OSError:
            parser.error('Test file does not exist: ' + name)
        if not selected.is_relative_to(project / 'test') or not selected.is_file():
            parser.error('Test file must be inside the source test directory: ' + name)
    request = {'kind': 'files', 'files': args.files}
else:
    if args.files or not 0 <= args.shard < args.shards:
        parser.error('Select a valid shard without file arguments')
    request = {'kind': 'shard', 'index': args.shard, 'count': args.shards}
spec = importlib.util.spec_from_file_location('ci_inventory', root / 'scripts/ci-test-shard.py')
inventory = importlib.util.module_from_spec(spec)
spec.loader.exec_module(inventory)
if args.shard is None and set(args.files) & inventory.host_nix_files(project):
    parser.error('Real Nix consumers require scripts/ci-host-nix-check --local --sdk; the bounded VM has no build daemon')
args.out.parent.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix='bl-ci-request-') as temporary:
    path = Path(temporary) / 'request.json'
    path.write_text(json.dumps(request))
    spec = importlib.util.spec_from_file_location('ci_source', root / 'scripts/ci-source.py')
    source_input = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(source_input)
    snapshot = Path(temporary) / 'source'
    source_input.capture(project, snapshot)
    command = ['nix-build', str(root / 'nix/ci-check.nix'), '--argstr', 'source', str(snapshot),
               '--argstr', 'request', str(path), '--out-link', str(args.out.absolute()),
               '--max-jobs', '1' if args.local else '0', '--option', 'timeout', '5700',
               '--option', 'experimental-features', 'nix-command flakes']
    for key in ('sdk', 'previous'):
        if getattr(args, key):
            command += ['--argstr', key, str(Path(getattr(args, key)).resolve(strict=True))]
    if models:
        command += ['--argstr', 'models', str(models)]
    subprocess.run(command, cwd=root, check=True)
receipt = json.loads((args.out / 'result.json').read_text())
print(json.dumps(receipt, indent=2))
passed = (receipt.get('status') == 'passed' and receipt.get('request') == request
          and receipt.get('frozen_inputs_unchanged') is True
          and type(receipt.get('assertions')) is int and receipt['assertions'] > 0
          and all(re.fullmatch('[0-9a-f]{64}', receipt.get(name, ''))
                  for name in ('sdk_descriptor_sha256', 'candidate_sha256', 'compiler_manifest_sha256', 'source_sha256')))
if args.sdk:
    passed = passed and receipt.get('sdk_descriptor_sha256') == hashlib.sha256(
        (Path(args.sdk).resolve() / 'artifact.json').read_bytes()).hexdigest()
raise SystemExit(0 if passed else 1)
