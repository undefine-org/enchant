(ns tooling.compile-build-backends (:require [build.backend :as backend]))
(let [args (vec (BeamLisp/argv)) check (= "--check" (first args))
      paths (if check (rest args) args)]
  (when (empty? paths) (throw (ex-info "Supply one or more .bl backend descriptions" {})))
  (doseq [path paths]
    (println (backend/compile-file! path {:check check}))))
