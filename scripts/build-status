#!/usr/bin/env python3
"""Inspect checkout build selections and accepted jobs without starting a BEAM."""
import argparse
import json
from pathlib import Path
import re

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--root', type=Path, default=Path.cwd())
args = parser.parse_args()
base = args.root.resolve() / '.bl/sdks'
current = base / 'current-sdk'
result = {'sdk': str(current.resolve()) if current.exists() else None, 'jobs': []}
for pointer in sorted(base.glob('*/active-job')):
    name = pointer.read_text().strip()
    if not re.fullmatch(r'job-[A-Za-z0-9]+', name):
        result['jobs'].append({'directory': str(pointer.parent), 'status': 'invalid job pointer'})
        continue
    directory = pointer.parent / name
    row = {'directory': str(directory), 'status': 'preparing coordinator'}
    handle = directory / 'handle.json'
    if handle.exists():
        value = json.loads(handle.read_text())
        identity = value.get('id', '')
        if re.fullmatch(r'job_[0-9a-f]{16}', identity):
            ledger = directory / 'foundry-state/ledger/jobs' / (identity + '.json')
            if ledger.exists():
                job = json.loads(ledger.read_text())
                row.update({key: job.get(key) for key in ('id', 'status', 'started_at', 'finished_at', 'exit_code', 'cancel_requested')})
    result['jobs'].append(row)
print(json.dumps(result, indent=2))
