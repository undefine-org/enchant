#!/usr/bin/env python3
"""Qualify the pre-BEAM Nix consumer against an actual Source product receipt.
Run under a whole-client-tree resource cap. Nix daemon workers are separate.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--receipt', type=Path, required=True)
    parser.add_argument('--platform', type=Path, required=True)
    parser.add_argument('--out', type=Path, required=True)
    parser.add_argument('--cargo', default=shutil.which('cargo'))
    args = parser.parse_args()
    if not args.cargo or args.out.exists():
        parser.error('Cargo and an absent output directory are required')
    crate = ROOT / 'tooling/drop'
    source = (crate / 'src/builder.rs').read_text().split('pub(crate) fn custody_source_identity()', 1)[1].split('let actual =', 1)[0]
    rows = re.findall(r'\("([^"]+)", include_str!\("[^"]+"\)\)', source)
    expected = {'Cargo.toml', 'Cargo.lock'} | {str(path.relative_to(crate)) for path in (crate / 'src').glob('*.rs')}
    if set(rows) != expected or len(rows) != len(expected):
        parser.error('compiled Source attestation must cover every Rust/Cargo input')
    digest = hashlib.sha256()
    frozen = {}
    for relative in rows:
        data = (crate / relative).read_bytes()
        digest.update(relative.encode() + b'\0' + data + b'\0')
        frozen[relative] = hashlib.sha256(data).hexdigest()
    identity = digest.hexdigest()
    args.out.mkdir(parents=True)
    (args.out / 'inputs.json').write_text(json.dumps(frozen, indent=2) + '\n')
    env = {**os.environ, 'CARGO_TARGET_DIR': str((args.out / 'cargo').absolute()),
           'BL_CUSTODY_TEST_SOURCE_SHA256': identity,
           'BL_NIX_ARTIFACT_TEST_RECEIPT': str(args.receipt.absolute()),
           'BL_ARTIFACT_PLATFORM': str(args.platform.absolute()), 'BL_NATIVE_PROVIDER': 'nix'}
    command = [args.cargo, 'test', '--offline', '--locked', '--manifest-path', str(crate / 'Cargo.toml'),
               '--bin', 'drop-launcher', 'nix_artifact::tests', '--', '--include-ignored', '--test-threads=1', '--nocapture']
    started = time.monotonic()
    with (args.out / 'execution.log').open('w') as log:
        result = subprocess.run(command, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=180)
    text = (args.out / 'execution.log').read_text()
    for relative, want in frozen.items():
        if hashlib.sha256((crate / relative).read_bytes()).hexdigest() != want:
            raise RuntimeError('Rust input changed during qualification: ' + relative)
    accepted = result.returncode == 0 and '4 passed; 0 failed' in text and text.count('BUILD-CUSTODY-SOURCE ' + identity) == 4
    receipt = {'status': 'passed' if accepted else 'failed', 'scope': 'rust-bootstrap-component',
               'seconds': round(time.monotonic() - started, 3), 'tests': 4, 'exit': result.returncode,
               'compiled_source_sha256': identity,
               'source_receipt_sha256': hashlib.sha256(args.receipt.read_bytes()).hexdigest(),
               'platform': str(args.platform.absolute()),
               'log_sha256': hashlib.sha256(text.encode()).hexdigest(), 'sdk_or_floor_qualified': False}
    (args.out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps(receipt))
    return 0 if accepted else 1


if __name__ == '__main__':
    raise SystemExit(main())
