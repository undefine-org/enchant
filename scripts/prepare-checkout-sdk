#!/usr/bin/env bash
# Internal managed entry prerequisite. Prints one retained immutable SDK path.
set -euo pipefail
umask 077
root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
inventory() {
  local directory=$1
  shift
  local prune=(-false)
  for omitted in "$@"; do prune+=(-o -path "$directory/$omitted"); done
  find "$directory" \( "${prune[@]}" \) -prune -o -printf '%y %m %p %l\n'
  find "$directory" \( "${prune[@]}" \) -prune -o -type f -exec sha256sum {} +
}
fingerprint=$(
  {
    inventory "$root/bin"
    inventory "$root/nix"
    inventory "$root/priv" native z3 .bl codegen.sources precompiled.term sdk-code.term
    inventory "$root/tooling/drop" target .git .bl
    for crate in "$root"/native/*; do inventory "$crate" target .git .bl; done
    sha256sum "$root/env.bl" "$root/bl.lock" "$root/flake.lock" "$root/flake.nix" \
      "$root/scripts/prepare-checkout-sdk" \
      "$root/scripts/prepare-release.bl" "$root/scripts/qualify-artifact-generation" \
      "$root/scripts/demo-artifact-production" "$root/scripts/check-source-floor" \
      "$root/scripts/check-execution-history" "$root/test/scripts/artifact-generation.bl"
  } | LC_ALL=C sort | sha256sum | cut -d' ' -f1
)
if [ "${1:-}" = --fingerprint ] && [ "$#" = 1 ]; then
  printf '%s\n' "$fingerprint"
  exit 0
fi
if [ "$#" != 0 ]; then
  echo 'usage: prepare-checkout-sdk [--fingerprint]' >&2
  exit 64
fi
directory="$root/.bl/sdks/$fingerprint"
mkdir -p "$directory"
exec 9>"$directory/preparation.lock"
flock -x 9
retained="$directory/result-sdk"
if [ ! -f "$retained/artifact.json" ]; then
  echo 'bl: preparing the immutable SDK on the configured Nix build station' >&2
  systemd-run --user --quiet --collect --wait --pipe --expand-environment=no \
    --working-directory="$root" --property=MemoryMax=4G --property=MemorySwapMax=0 \
    --property=RuntimeMaxSec=3600 --property=KillMode=control-group \
    nix-build "$root/nix/prepare-sdk.nix" --argstr root "$root" --argstr product sdk \
      --out-link "$directory/result" --max-jobs 0 --option timeout 3300 \
      --option experimental-features 'nix-command flakes' >"$directory/preparation.log" 2>&1 || {
        tail -60 "$directory/preparation.log" >&2
        exit 69
      }
fi
readlink -f "$retained"
