#!/usr/bin/env bash
# Internal managed entry prerequisite. Prints one retained immutable SDK path.
set -euo pipefail
umask 077
root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
fingerprint_of_tree() {
  python3 "$root/scripts/sdk-inputs" --root "$root"
}
selection=false
case "${1:-}" in
  --fingerprint)
    [ "$#" = 1 ] || exit 64
    fingerprint_of_tree
    exit 0 ;;
  --selection)
    [ "$#" = 1 ] || exit 64
    selection=true ;;
  '') [ "$#" = 0 ] || exit 64 ;;
  *) echo 'usage: prepare-checkout-sdk [--fingerprint|--selection]' >&2; exit 64 ;;
esac
emit_selection() {
  if "$selection"; then printf '%s %s\n' "$1" "$fingerprint"
  else printf '%s\n' "$1"; fi
}
for prerequisite in nix-build systemd-run python3 flock; do
  command -v "$prerequisite" >/dev/null || { echo "bl: required preparation tool missing: $prerequisite" >&2; exit 69; }
done
mkdir -p "$root/.bl/sdks"
# Fingerprint and capture occur after the preparation lock. In particular a
# waiting caller never adopts a fingerprint computed before its predecessor.
exec 9>"$root/.bl/sdks/preparation.lock"
flock -x 9
fingerprint=$(fingerprint_of_tree)
directory="$root/.bl/sdks/$fingerprint"
mkdir -p "$directory"
retained="$directory/result-sdk"

bounded() {
  systemd-run --user --quiet --collect --wait --pipe --expand-environment=no \
    --working-directory="$root" --property=MemoryMax=4G --property=MemorySwapMax=0 \
    --property=RuntimeMaxSec=3700 --property=KillMode=control-group "$@" 9>&-
}
# The dispatcher prints JSON only to stdout. Unit and runtime diagnostics go to
# a different file and never enter JSON parsers.
dispatch() {
  local mode=$1
  shift
  bounded "$coordinator/bin/bl" --cold run \
    "$coordinator/foundry/bin/preparation-operation.bl" -- "$mode" "$job" "$@" \
    >"$transport/client-$mode.json" 2>"$transport/client-$mode.log"
}
verify_selection() {
  python3 - "$1" "$2" <<'PYVERIFY'
import json, pathlib, re, sys
output, coordinator = map(pathlib.Path, sys.argv[1:])
assert re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', str(output))
metadata = json.loads((output / 'artifact.json').read_text())
assert metadata['version'] == 1 and metadata['kind'] == 'sdk'
assert metadata['target'] == 'x86_64-linux'
assert metadata['coordinator'] == str(coordinator)
assert (output / 'preparation-coordinator').is_symlink()
assert (output / 'preparation-coordinator').resolve(strict=True) == coordinator
assert (output / 'image/ebin/Elixir.BeamLisp.Launcher.beam').is_file()
assert (output / 'bin/bl').is_file()
cm = json.loads((coordinator / 'artifact.json').read_text())
assert cm['version'] == 1 and cm['kind'] == 'artifact-coordinator-runtime'
assert (coordinator / 'foundry/bin/preparation-operation.bl').is_file()
PYVERIFY
}

# A restored selection owns its original coordinator. A freshly evaluated
# coordinator can differ solely because the predecessor hint changed.
# Verify the retained product against the current exact engine bytes before
# any source capture, coordinator evaluation or durable job is needed.
if [ -f "$retained/artifact.json" ]; then
  output=$(readlink -f "$retained")
  coordinator=$(readlink -f "$output/preparation-coordinator")
  verify_selection "$output" "$coordinator"
  source=$(python3 - "$output/artifact.json" <<'PYSOURCE'
import json, re, sys
source = json.load(open(sys.argv[1]))['source']
if not isinstance(source, str) or not re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', source):
    raise SystemExit('bl: retained SDK lacks an immutable engine source')
print(source)
PYSOURCE
)
  frozen=$(python3 "$root/scripts/sdk-inputs" --root "$source" --policy "$root/nix/engine-inputs.json")
  if [ "$frozen" != "$fingerprint" ]; then
    echo 'bl: retained SDK engine bytes differ from current inputs' >&2
    exit 69
  fi
  ln -sfn "$output" "$root/.bl/sdks/current-sdk.tmp"
  mv -T "$root/.bl/sdks/current-sdk.tmp" "$root/.bl/sdks/current-sdk"
  emit_selection "$output"
  exit 0
fi

if [ -f "$directory/active-job" ]; then
  job_name=$(cat "$directory/active-job")
  [[ "$job_name" =~ ^job-[A-Za-z0-9]+$ ]] || { echo 'bl: invalid active SDK job pointer' >&2; exit 69; }
  job="$directory/$job_name"
  [ -d "$job" ] && [ ! -L "$job" ] || { echo 'bl: active SDK job directory is missing' >&2; exit 69; }
else
  job=$(mktemp -d "$directory/job-XXXXXXXXXXXX")
  printf '%s\n' "${job##*/}" >"$directory/active-job.tmp"
  mv -T "$directory/active-job.tmp" "$directory/active-job"
fi
# Retain completed preparation records even when a later generation fails.
# These records never select a compiler or grant runtime admission.
remember_preparation() {
  if [ -f "$root/scripts/retain-compiler-preparation.py" ]; then
    python3 "$root/scripts/retain-compiler-preparation.py" --root "$root/.bl/sdks" --job "$job" || true
  fi
}
trap remember_preparation EXIT
# Each wrapper invocation owns separate machine transports. A previous wrapper
# can die while its managed await service continues writing; never truncate or
# parse that surviving observer's files when another caller rejoins the job.
transport=$(mktemp -d "$job/client-XXXXXXXXXXXX")
# Unique job directories never move: durable handles bind their path/inode.
if [ ! -L "$job/source-retained" ]; then
  echo 'bl: capturing the immutable engine source on the configured Nix build station' >&2
  bounded nix-build "$root/nix/sdk-source.nix" --argstr source "$root" \
    --out-link "$job/source-retained" --option timeout 3300 \
    --option experimental-features 'nix-command flakes' \
    >"$job/source-build.log" 2>&1 || { tail -60 "$job/source-build.log" >&2; exit 69; }
fi
engine=$(readlink -f "$job/source-retained")
# Hash frozen bytes with the same semantic policy. Never relabel a job after
# mutable edits: its immutable source and original fingerprint are evidence.
frozen=$(python3 "$root/scripts/sdk-inputs" --root "$engine" --policy "$root/nix/engine-inputs.json")
if [ "$frozen" != "$fingerprint" ]; then
  printf '%s\n' "$fingerprint" >"$job/expected-fingerprint"
  printf '%s\n' "$frozen" >"$job/captured-fingerprint"
  rm -f "$directory/active-job"
  echo "bl: engine inputs changed during capture; retained evidence at $job; retry" >&2
  exit 69
fi
# Freeze one verified predecessor per job. It is retained by both this wrapper
# and the coordinator and never changes when a later caller rejoins the job.
if [ ! -f "$job/operation.json" ]; then
  previous=
  if [ -L "$job/previous-sdk" ]; then
    previous=$(readlink -f "$job/previous-sdk")
  elif [ -f "$root/.bl/sdks/current-sdk/unit-store/unit-index.json" ]; then
    previous=$(readlink -f "$root/.bl/sdks/current-sdk")
    ln -s "$previous" "$job/previous-sdk"
  fi
  preparation=
  if [ -n "$previous" ]; then
    if [ -L "$job/previous-preparation" ]; then
      preparation=$(readlink -f "$job/previous-preparation")
    elif [ -d "$root/.bl/sdks/previous-preparation/unit-store" ]; then
      preparation=$(readlink -f "$root/.bl/sdks/previous-preparation")
      ln -s "$preparation" "$job/previous-preparation"
    fi
  fi
  python3 - "$engine" "$previous" "$preparation" >"$job/operation.tmp" <<'PYOP'
import json, sys
request = dict(version=2, kind='sdk', source=sys.argv[1], product='sdk', previous=sys.argv[2] or None)
if sys.argv[3]:
    request.update(version=3, preparation=sys.argv[3])
print(json.dumps(request, sort_keys=True))
PYOP
  chmod 600 "$job/operation.tmp"
  mv -T "$job/operation.tmp" "$job/operation.json"
fi

if [ ! -L "$job/coordinator-retained" ]; then
  echo 'bl: preparing the independent immutable preparation coordinator' >&2
  coordinator_previous=()
  if [ -L "$job/previous-sdk" ]; then
    coordinator_previous=(--argstr previous "$(readlink -f "$job/previous-sdk")")
  fi
  bounded nix-build "$engine/nix/sdk-artifact.nix" --argstr source "$engine" --argstr product coordinator "${coordinator_previous[@]}" \
    --out-link "$job/coordinator-retained" --option timeout 3300 \
    --option experimental-features 'nix-command flakes' \
    >"$job/coordinator-build.log" 2>&1 || { tail -60 "$job/coordinator-build.log" >&2; exit 69; }
fi
coordinator=$(readlink -f "$job/coordinator-retained")
python3 - "$engine" "$coordinator" "$job" <<'PYBOOTSTRAP'
import json, os, pathlib, re, stat, sys
engine, coordinator, job = map(pathlib.Path, sys.argv[1:])
for value in (engine, coordinator):
    assert re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', str(value)) and value.is_dir()
info = job.lstat()
assert stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and info.st_mode & 0o077 == 0
metadata = json.loads((coordinator / 'artifact.json').read_text())
assert metadata['version'] == 1 and metadata['kind'] == 'artifact-coordinator-runtime'
assert (coordinator / 'bin/bl').is_file()
assert (coordinator / 'foundry/bin/preparation-operation.bl').is_file()
PYBOOTSTRAP
python3 - "$job/operation.json" "$engine" <<'PYREQUEST'
import json, os, pathlib, re, stat, sys
path = pathlib.Path(sys.argv[1])
info = path.lstat()
assert stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and info.st_mode & 0o077 == 0
assert info.st_size <= 1048576
request = json.loads(path.read_text())
version = request['version']
assert version in (2, 3)
assert set(request) == {'version', 'kind', 'source', 'product', 'previous'} | ({'preparation'} if version == 3 else set())
assert (request['kind'], request['source'], request['product']) == ('sdk', sys.argv[2], 'sdk')
if version == 3:
    assert re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', request['preparation'])
    assert (path.parent / 'previous-preparation').resolve(strict=True) == pathlib.Path(request['preparation'])
previous = request['previous']
assert previous is None or re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', previous)
if previous is not None:
    assert (path.parent / 'previous-sdk').resolve(strict=True) == pathlib.Path(previous)
PYREQUEST
# One coordinator VM submits, reconciles a safely queued worker and waits.
# Deadlines/disconnects preserve the same durable job for the next caller.
if ! dispatch prepare 3600000; then
  # Failed terminal jobs permit a fresh attempt on the NEXT normal invocation.
  # Deadlines and unknown ownership retain the active pointer for reconnection.
  if dispatch status; then
    state=$(python3 - "$transport/client-status.json" <<'PYSTATE'
import json, sys
reply = json.load(open(sys.argv[1]))
assert reply['ok'] is True
print(reply['value']['status'])
PYSTATE
)
    case "$state" in failed|cancelled|interrupted) rm "$directory/active-job" ;; esac
  fi
  cat "$transport/client-prepare.log" >&2
  cat "$transport/client-prepare.json" >&2
  exit 69
fi
output=$(python3 - "$transport/client-prepare.json" "$job/operation.json" "$job/retained" <<'PYRESULT'
import hashlib, json, pathlib, re, sys
reply = json.loads(pathlib.Path(sys.argv[1]).read_text())
assert reply['ok'] is True
receipt = reply['value']
operation = pathlib.Path(sys.argv[2]).read_bytes()
request = json.loads(operation)
assert receipt['version'] == 1 and receipt['kind'] == 'preparation-result'
assert receipt['operation'] == 'sdk' and receipt['product'] == 'sdk'
assert receipt['source'] == request['source']
assert receipt['operation-sha256'] == hashlib.sha256(operation).hexdigest()
output = receipt['output']
assert re.fullmatch(r'/nix/store/[0-9a-z]{32}-[^/]+', output)
retention = pathlib.Path(sys.argv[3])
assert receipt['retention-root'] == str(retention)
assert retention.is_symlink() and str(retention.resolve(strict=True)) == output
print(output)
PYRESULT
)
verify_selection "$output" "$coordinator"
ln -sfn "$output" "$directory/result-sdk.tmp"
mv -T "$directory/result-sdk.tmp" "$retained"
ln -sfn "$output" "$root/.bl/sdks/current-sdk.tmp"
mv -T "$root/.bl/sdks/current-sdk.tmp" "$root/.bl/sdks/current-sdk"
emit_selection "$output"
