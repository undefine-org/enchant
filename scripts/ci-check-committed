#!/usr/bin/env python3
"""Run normal remote CI from a verified immutable Git export.

Use --staging-dir /dev/shm to keep the small source snapshot off a busy disk.
All remaining arguments go to scripts/ci-check; its bounded Build worker and
frozen-input verification are unchanged. Working-tree edits are not included.
"""
import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
LIMIT = 512 * 1024 * 1024


def capture(root, revision, source):
    helper = importlib.util.spec_from_file_location('ci_source', ROOT / 'scripts/ci-source.py')
    module = importlib.util.module_from_spec(helper)
    helper.loader.exec_module(module)
    revision = subprocess.check_output(['git', 'rev-parse', '--verify', '--end-of-options',
        revision + '^{commit}'], cwd=root, text=True).strip()
    roots = sorted(module.ROOTS & set(subprocess.check_output(
        ['git', 'ls-tree', '--name-only', revision], cwd=root, text=True).splitlines()))
    expected = {}
    for row in subprocess.check_output(['git', 'ls-tree', '-rz', revision, '--', *roots], cwd=root).split(b'\0'):
        if not row:
            continue
        header, name = row.split(b'\t', 1)
        mode, kind, oid = header.split()
        if kind != b'blob':
            raise ValueError('Committed checks require self-contained source files')
        expected[os.fsdecode(name)] = (int(mode, 8), oid.decode())
    archive = source.with_suffix('.tar')
    subprocess.run(['git', 'archive', '--format=tar', '--output', str(archive), revision,
                    '--', *roots], cwd=root, check=True)
    size = archive.stat().st_size
    if size > LIMIT:
        raise ValueError('Committed source exceeds the private capture bound')
    with archive.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    source.mkdir()
    seen = set()
    with tarfile.open(archive) as packed:
        for member in packed:
            if member.isdir():
                continue
            if member.name in seen or member.name not in expected:
                raise ValueError('Git export changed the source inventory')
            mode, oid = expected[member.name]
            blob = hashlib.sha1(usedforsecurity=False)
            if mode == 0o120000 and member.issym():
                body = os.fsencode(member.linkname)
                blob.update(b'blob ' + str(len(body)).encode() + b'\0' + body)
            elif mode in (0o100644, 0o100755) and member.isfile():
                if member.mode & 0o111 != mode & 0o111:
                    raise ValueError('Git export changed an executable mode')
                blob.update(b'blob ' + str(member.size).encode() + b'\0')
                with packed.extractfile(member) as stream:
                    while chunk := stream.read(1024 * 1024):
                        blob.update(chunk)
            else:
                raise ValueError('Git export changed a source file kind')
            if blob.hexdigest() != oid:
                raise ValueError('Git export changed committed source bytes')
            seen.add(member.name)
        if seen != set(expected):
            raise ValueError('Git export omitted committed source files')
        packed.extractall(source, filter='data')
    archive.unlink()
    subprocess.run(['git', 'init', '-q'], cwd=source, check=True)
    subprocess.run(['git', 'add', '--force', '--all'], cwd=source, check=True)
    return {'version': 1, 'revision': revision, 'roots': roots, 'archive_sha256': digest,
            'archive_bytes': size, 'files': len(seen), 'capture': 'verified-immutable-git-export',
            'working_tree_edits_included': False, 'placement': 'remote-only'}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--revision', default='HEAD')
    parser.add_argument('--out', required=True, type=Path)
    parser.add_argument('--staging-dir', type=Path)
    args, checks = parser.parse_known_args()
    if any(len(arg.split('=', 1)[0]) > 2 and '--source'.startswith(arg.split('=', 1)[0]) for arg in checks):
        parser.error('--source cannot override the verified committed snapshot; select --revision')
    output = args.out.absolute()
    inputs = Path(str(output) + '.inputs.json')
    if output.exists() or output.is_symlink() or inputs.exists() or inputs.is_symlink():
        parser.error('Output must be absent; retain existing receipts')
    output.parent.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    with tempfile.TemporaryDirectory(prefix='bl-committed-check-', dir=args.staging_dir) as work:
        work = Path(work)
        source = work / 'source'
        receipt = capture(ROOT, args.revision, source)
        receipt['capture_seconds'] = round(time.monotonic() - started, 3)
        inputs.write_text(json.dumps(receipt, indent=2) + '\n')
        print(json.dumps(receipt), flush=True)
        subprocess.run([sys.executable, str(ROOT / 'scripts/ci-check'), '--remote',
            '--source', str(source), '--out', str(output), *checks], cwd=ROOT,
            env=dict(os.environ, TMPDIR=str(work)), check=True)


if __name__ == '__main__':
    main()
