#!/usr/bin/env bash
# Prints one retained immutable platform path; preparation diagnostics use stderr.
set -euo pipefail
root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
fingerprint=$(
  {
    sha256sum "$root/flake.lock" "$root/flake.nix"
    find "$root/nix" "$root/tooling/drop" "$root/native" \
      \( -name target -o -name .git -o -name .bl -o -name __pycache__ \) -prune -o \
      -printf '%y %m %p %l\n'
    find "$root/nix" "$root/tooling/drop" "$root/native" \
      \( -name target -o -name .git -o -name .bl -o -name __pycache__ \) -prune -o \
      -type f -exec sha256sum {} +
  } | LC_ALL=C sort | sha256sum | cut -d' ' -f1
)
retained="$root/.bl/platforms/$fingerprint"
if [ ! -f "$retained/platform.json" ]; then
  command -v nix-build >/dev/null || { echo 'bl: Nix is required to prepare the checkout platform' >&2; exit 69; }
  command -v systemd-run >/dev/null || { echo 'bl: a systemd user manager is required for preparation' >&2; exit 69; }
  mkdir -p "$root/.bl/platforms"
  nix_environment=()
  for name in NIX_CONFIG NIX_SSHOPTS NIX_USER_CONF_FILES NIX_CONF_DIR SSH_AUTH_SOCK XDG_CONFIG_HOME; do
    if [[ -v $name ]]; then nix_environment+=("--setenv=$name"); fi
  done
  systemd-run --user --quiet --collect --wait --pipe --expand-environment=no \
    --working-directory="$root" --property=MemoryMax=2G --property=MemorySwapMax=0 \
    --property=RuntimeMaxSec=3600 --property=KillMode=control-group \
    "${nix_environment[@]}" \
    nix-build "$root/nix/prepare-checkout.nix" --argstr root "$root" \
      --out-link "$retained" --option timeout 3300 >/dev/null
fi
readlink -f "$retained"
