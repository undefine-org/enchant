#!/usr/bin/env python3
"""Exercise the real global CLI/NIF showcase in an existing Source-free SDK.
Run under systemd MemoryMax=2G, MemorySwapMax=0, RuntimeMaxSec=240.
The image must come from scripts/demo-sdk-artifacts, with its accepted receipt.
"""
import argparse,hashlib,json,os,runpy,subprocess,time
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--image',type=Path,required=True)
p.add_argument('--source-root',type=Path,required=True)
p.add_argument('--out',type=Path,required=True)
p.add_argument('--platform',required=True)
p.add_argument('--elixir',required=True)
a=p.parse_args(); image=a.image.resolve();root=a.source_root.resolve();out=a.out.absolute()
if os.path.lexists(out):p.error('output must be absent')
producer=json.loads((image.parent/'result.json').read_text())
try:
 runpy.run_path(str(root/'scripts/sdk_sealed_profiles.py'))['validate_universal'](producer)
 runpy.run_path(str(root/'scripts/test_prerequisites.py'))['require'](root,['test/scripts/artifact-provider-driver.bl'])
except (ValueError,RuntimeError) as error:p.error(str(error))
if any(f.is_file() and f.name.endswith(('.bl','.bl.md','.bl.org','.clj','.cljc')) for f in (image/'priv').rglob('*')):p.error('SDK language Source must be absent')
paths=[*(image/'ebin').glob('*.beam'),image/'ebin/beam_lisp.app',image/'priv/bootstrap/seed/manifest.term',image/'priv/precompiled.term',image/'priv/sdk-code.term',*(image/'priv/native').glob('*.so')]
def frozen():return {str(f.relative_to(image)):hashlib.sha256(f.read_bytes()).hexdigest() for f in paths}
inputs=frozen();out.mkdir(parents=True)
(out/'inputs.json').write_text(json.dumps(inputs,indent=2)+'\n')
command=[a.elixir,'--erl','+S 2:2 +SDcpu 1:1 +SDio 1']
for dep in dict.fromkeys(f.resolve() for f in [*sorted((root/'deps').glob('*/ebin')),*sorted((root/'_build').glob('*/lib/*/ebin'))]):command+=['-pa',str(dep)]
command+=['-pa',str(image/'ebin'),str(image/'boot.exs')]
env=dict(os.environ,BL_ROOT=str(image),BL_DAEMON='off',XDG_CACHE_HOME=str(out/'empty-cache'),BL_ARTIFACT_SOURCE_ROOT=str(root),BL_ARTIFACT_OUTPUT_DIR=str(out),BL_ARTIFACT_PLATFORM=a.platform,BL_ARTIFACT_DRIVER=str(root/'test/scripts/artifact-showcase-driver.bl'))
started=time.monotonic()
with (out/'execution.log').open('w') as log:r=subprocess.run(command,cwd=image,env=env,stdout=log,stderr=subprocess.STDOUT,timeout=180)
showcase=json.loads((out/'showcase.json').read_text()) if (out/'showcase.json').exists() else {}
passed=r.returncode==0 and inputs==frozen() and showcase.get('answer')==42 and all(showcase.get(k)==0 for k in ['prepare','list','compare','capsule']) and showcase.get('usage')==2
receipt={'kind':'source-free-sdk-artifact-showcase','status':'passed' if passed else 'failed','exit':r.returncode,'seconds':round(time.monotonic()-started,3),'sdk_source_absent':True,'sdk_bytes_unchanged':inputs==frozen(),'showcase':showcase,'producer_receipt_sha256':hashlib.sha256((image.parent/'result.json').read_bytes()).hexdigest(),'inputs_sha256':hashlib.sha256((out/'inputs.json').read_bytes()).hexdigest()}
(out/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps(receipt));raise SystemExit(0 if passed else 1)
