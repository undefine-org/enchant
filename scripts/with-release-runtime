#!/usr/bin/env python3
"""Execute release checks with the pinned FHS loader, preserving artifact bytes.

Prepare the adapter once with:
  nix-build nix/ci-release-runtime.nix -o .bl/ci-release-runtime
Use --sdk when an SDK is available to verify that its executor uses this libc.
This adapter is for checks. It does not make older release hosts supported.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess


def runtime_identity(runtime, sdk=None):
    runtime = Path(runtime).resolve(strict=True)
    identity = json.loads((runtime / 'runtime.json').read_text())
    if (identity.get('version'), identity.get('kind'), identity.get('target')) != (
            1, 'ci-release-runtime', 'x86_64-linux'):
        raise ValueError('Unsupported release test runtime')
    if sdk is not None:
        sdk = Path(sdk).resolve(strict=True)
        metadata = json.loads((sdk / 'artifact.json').read_text())
        if (metadata.get('version'), metadata.get('kind'), metadata.get('target')) != (1, 'sdk', 'x86_64-linux'):
            raise ValueError('Unsupported SDK selection')
        platform = Path(metadata['platform'])
        descriptor = json.loads((platform / 'platform.json').read_text())
        headers = subprocess.check_output(
            [str(runtime / 'bin/readelf'), '--program-headers',
             str(Path(descriptor['executor']) / 'bin/drop-launcher')], text=True)
        if f"Requesting program interpreter: {identity['glibc']}/lib/ld-linux-x86-64.so.2]" not in headers:
            raise ValueError('Release test loader differs from the SDK executor libc')
        return runtime, platform
    return runtime, None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--runtime', type=Path,
                        default=Path(os.environ.get('BL_CI_RELEASE_RUNTIME', '.bl/ci-release-runtime')))
    parser.add_argument('--sdk', type=Path)
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        parser.error('A command is required after --')
    try:
        runtime, platform = runtime_identity(args.runtime, args.sdk)
    except (KeyError, OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.error(str(error))
    env = dict(os.environ)
    if platform is not None:
        env['PATH'] = str(platform / 'bin') + os.pathsep + env.get('PATH', '')
    os.execve(runtime / 'bin/with-release-runtime', ['with-release-runtime', *command], env)


if __name__ == '__main__':
    main()
