;; Closed Nix worker entry. Public self-build selects the finished Nix release.
(ns tooling.produce-sdk (:require [selfbuild :as selfbuild] [seed :as seed] [drop :as drop]))
(let [_ (selfbuild/timed "prepare-release" (fn [] (BeamLisp/run_file "scripts/prepare-release.bl")))
      floor (selfbuild/timed "check-floor" (fn [] (seed/check {})))
      _ (when-not (:ok? floor)
          (throw (ex-info "SDK production requires the current qualified compiler floor" floor)))
      _ (println (str "SDK-FLOOR-CHECK " (Jason/encode! {:current true :namespaces (:namespaces floor)})))
      result (selfbuild/assemble!
               {:out (System/fetch_env! "BL_PRODUCTION_PAYLOAD")
                :bin (System/fetch_env! "BL_PRODUCTION_LAUNCHER")
                :jobs (String/to_integer (System/fetch_env! "NIX_BUILD_CORES"))})]
  (when-not (:ok? result)
    (throw (ex-info (str "Immutable SDK production failed: " (pr-str (:errors result)))
                   {:errors (:errors result)})))
  ;; Use the pinned native packer, then the same independent trailer/digest
  ;; verifier. The producer retains its complete assembly until that succeeds.
  (let [output (System/fetch_env! "BL_PRODUCTION_DROP_OUTPUT")
        packed (selfbuild/timed "pack-sdk" (fn [] (System/cmd (System/fetch_env! "BL_PRODUCTION_PACKER")
                 (list "pack" "--release" (:tree result)
                       "--launcher" (System/fetch_env! "BL_PRODUCTION_LAUNCHER") "--out" output)
                 (list (tuple :stderr_to_stdout true)))))]
    (println (elem packed 0))
    (when-not (and (= 0 (elem packed 1))
                  (:ok? (selfbuild/timed "verify-sdk-package" (fn [] (drop/verify output)))))
      (throw (ex-info "Native SDK package failed verification" {}))))
  ;; Hand off the completed tree directly; no archive needs to be unpacked.
  (File/rename! (:tree result) (System/fetch_env! "BL_PRODUCTION_PAYLOAD"))
  (when-let [destination (System/get_env "BL_PRODUCTION_UNIT_STORE")]
    (selfbuild/timed "retain-unit-store" (fn []
      (let [units (selfbuild/unit-store-root)
            source-priv (Path/join (Path/dirname units) "priv")
            facts (Path/join units "source-parts")]
        (File/mkdir_p! facts)
        (File/rename! (Path/join source-priv "parts") (Path/join facts "parts"))
        (BeamLisp/eval (File/read! "scripts/retain-producer.bl"))
        (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "tooling.retain-producer" "retain!")
          (list units (Path/join (System/fetch_env! "BL_PRODUCTION_PAYLOAD") "lib/beam_lisp-0.1.0")
                (Path/join units "producer")))
        (File/rename! units destination)))))
  (println (str "SDK-UNIT-RESULT " (Jason/encode! (select-keys result [:compiled :cached :built]))))
  (println (str "SDK-PRODUCER " (:out result))))
