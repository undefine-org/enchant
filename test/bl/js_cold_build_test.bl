; A cold CLI build must initialize its emitter dependencies before staging
; the same namespaces as target source. Warm compiler tests cannot expose this.
(ns bl.js.cold-build-test
  (:require [bl.util :as u] [bl.js :as cli] [js.build :as build]))

(deftest compiler-host-leaves-keep-exact-identities-and-unresolved-diagnostics
 (let [leaves (cli/leaf-names) missing (atom [])
       ctx (build/link-ctx {:ns "cold.diagnostics" :requires []}
              {"cold.diagnostics" #{}} #{} missing leaves #{} (atom #{}))]
  (is (= [:leaf "Elixir.Enum/all?/2"] (build/remote-link :Elixir.Enum :all? 2 leaves)))
  (is (= "L.LEAVES[\"Elixir.BeamLisp.CompilerData/binding_reference?/1\"]"
         ((:remote ctx) :Elixir.BeamLisp.CompilerData :binding_reference? 1)))
  (is (= "MISSING(\"Elixir.Enum/all?/3\")" ((:remote ctx) :Elixir.Enum :all? 3)))
  (is (= "MISSING(\"Elixir.BeamLisp.CompilerData/not_a_function/1\")"
         ((:remote ctx) :Elixir.BeamLisp.CompilerData :not_a_function 1)))
  (is (= [["cold.diagnostics" "leaf" "Elixir.Enum/all?/3"]
          ["cold.diagnostics" "leaf" "Elixir.BeamLisp.CompilerData/not_a_function/1"]] @missing))))

(deftest cold-cli-build-can-compile-the-emitter-own-dependencies
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: skipped")
    (let [checkout (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
          cli (or (System/get_env "BL_TEST_JS_CLI")
                  (System/get_env "BL_QUALIFY_CANDIDATE")
                  (when-let [sdk (System/get_env "BL_SDK_PRODUCT")] (Path/join sdk "bin/bl"))
                  (Path/join checkout "bin/bl"))
          root (Path/join (System/tmp_dir!)
                 (str "bl-jscold-" (System/unique_integer (u/to-list [:positive]))))
          source (str root "/src")
          out (str root "/out")]
      (try
        (File/mkdir_p! (str source "/cold"))
        (File/write! (str source "/cold/main.bl")
          "(ns ^:js cold.main)\n(def allowed #{\"a\"})\n(defn answer [] 42)\n(println (answer))\n(println (contains? allowed \"a\"))\n(println (binary/at \"é\" 1))\n(println (binary/match \"é_a\" \"_\"))\n(println (binary/matches \"aaaa\" \"aa\"))\n(println (binary/part \"abcd\" 3 -2))\n")
        (let [[report code] (u/to-list (erlang/tuple_to_list
                             (System/cmd cli
                               (u/to-list ["--cold" "js" "build" "cold.main" "-p" source
                                           "--with" "system.ir,system.js,js.pattern" "--out" out])
                               (u/kw [:cd root] [:stderr_to_stdout true]))))]
          (is (= 0 code) report)
          (when (= 0 code)
            (let [[printed result] (u/to-list (erlang/tuple_to_list
                                      (System/cmd "node" (u/to-list [(str out "/ns/cold.main.mjs")])
                                                  (u/kw [:stderr_to_stdout true]))))]
              (is (= 0 result) printed)
              (is (= "42\ntrue\n169\n{2, 1}\n({0, 2} {2, 2})\nbc\n" printed) "the cold build runs against its compiled core"))
            (let [result (System/cmd "node"
                           (u/to-list [(Path/join checkout "test/js/compiler/ir-bundle.mjs") out])
                           (u/kw [:stderr_to_stdout true]))]
              (is (= 0 (elem result 1)) (elem result 0))
              (is (= "JS_IR_BUNDLE_OK\n" (elem result 0))))))
        (finally (File/rm_rf! root))))))
