(ns contextual-namespace-exports-test
 (:require [expand :as x] [anf :as a] [lower :as lower] [compiler :as compiler]
           [system.phase :as phase] [codebase.phase :as facts] [compile.world :as world]))

(defn- prepared [text]
 (x/prepare-program [{:namespace 'exports :revision 'current :file "exports.bl" :source text}]
                    ['exports 'current]))
(defn- named-reference [program name]
 (:reference (first (filter  #(and (= name (get-in % [:declaration :name]))
                                            (not= :local (get-in % [:declaration :visibility]))) (vals (:references program))))))
(defn- emit [bundle module]
 (elem (lower/descriptor->beam
  (a/module module (compiler/contextual-unit-clauses (get-in bundle [:program :unit]) module)
    (list [:run 0] [:__bl_unit__ 0]) (list)) {}) 1))
(defn- unload [module] (code/delete module) (code/purge module))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))

(deftest unused-public-runtime-declarations-export-with-private-captures-and-no-env-publication
 (let [bundle (prepared "(ns exports) (def base 40) (defn- helper [x] (erlang/+ base x)) (defn answer [] (helper 2))")
       program (:program bundle) unit (:unit program)
       instance (lower/eval-anf :Elixir.ContextualExportFactory (compiler/contextual-unit-factory unit))
       exported (:exports instance) answer (get exported (named-reference program 'answer))]
  (is (= 2 (count exported)))
  (is (= 40 (get exported (named-reference program 'base))))
  (is (= 42 (answer)))
  (is (= 42 (answer)))
  (is (not (contains? exported (named-reference program 'helper))))
  (is (= nil ((:entry instance))))
  (is (= :proved (:status (phase/check program))))
  (is (= :error (BeamLisp.Env/lookup (tuple "exports" "answer"))))
  (is (= :error (BeamLisp.Env/lookup (tuple "exports" "base"))))))

(deftest physical-factory-initializes-once-and-entry-reads-the-captured-result
 (erlang/erase :contextual-export-effect)
 (let [bundle (prepared (str "(ns exports) (defn touch [] (erlang/put :contextual-export-effect :body)) "
                             "(erlang/put :contextual-export-effect :entry) 42"))
       module :Elixir.ContextualPhysicalExports beam (emit bundle module)]
  (try
   (is (= :undefined (erlang/get :contextual-export-effect)))
   (is (= (tuple :module module) (code/load_binary module '() beam)))
   (let [instance (erlang/apply module :__bl_unit__ (list))
         touch (get (:exports instance) (named-reference (:program bundle) 'touch))]
    (is (= :entry (erlang/get :contextual-export-effect)))
    (touch)
    (is (= :body (erlang/get :contextual-export-effect)))
    (is (= 42 ((:entry instance))))
    (is (= :body (erlang/get :contextual-export-effect)))
    (erlang/erase :contextual-export-effect)
    (is (= 42 (erlang/apply module :run (list))))
    (is (= :entry (erlang/get :contextual-export-effect))))
   (finally (erlang/erase :contextual-export-effect) (unload module)))))

(deftest same-namespace-physical-revisions-keep-their-own-export-identities-and-code
 (let [old (prepared "(ns exports) (def base 40) (defn answer [x] (erlang/+ base x))")
       new (prepared "(ns exports) (def base 100) (defn answer [x] (erlang/+ base x))")
       old-module :Elixir.ContextualExportsOld new-module :Elixir.ContextualExportsNew
       old-beam (emit old old-module) new-beam (emit new new-module)
       old-reference (named-reference (:program old) 'answer)
       new-reference (named-reference (:program new) 'answer)]
  (try
   (code/load_binary old-module '() old-beam)
   (let [old-instance (erlang/apply old-module :__bl_unit__ (list))
         old-answer (get (:exports old-instance) old-reference)]
    (code/load_binary new-module '() new-beam)
    (let [new-instance (erlang/apply new-module :__bl_unit__ (list))
          new-answer (get (:exports new-instance) new-reference)]
     (is (not= old-reference new-reference))
     (is (= 42 (old-answer 2)))
     (is (= 102 (new-answer 2)))
     (is (= 42 (old-answer 2)))
     (is (not (contains? (:exports new-instance) old-reference)))
     (is (not (contains? (:exports old-instance) new-reference)))))
   (finally (unload old-module) (unload new-module)))))

(deftest runtime-export-roots-exclude-transformers-phase-values-and-private-bindings
 (let [bundle (prepared (str "(ns exports) (begin-for-syntax (def amount 42)) "
                             "(defsyntax answer [form context] (syntax-literal amount)) "
                             "(defn- hidden [] 0) (defn public [] (answer))"))
       program (:program bundle) exports (get-in program [:unit :exports])
       declarations (get-in program [:selection :by-id])
       instance (lower/eval-anf :Elixir.ContextualExportPhases
                  (compiler/contextual-unit-factory (:unit program)))]
  (is (= 1 (count exports)))
  (is (= 'public (get-in declarations [(:declaration (first exports)) :name])))
  (is (= 0 (:phase (first exports))))
  (is (= 42 ((get (:exports instance) (first exports)))))
  (is (= :proved (:status (phase/check program))))))

(deftest export-recipe-participates-in-snapshot-and-private-exports-refuse-phase-proof
 (let [program (:program (prepared "(ns exports) (defn- hidden [] 0) (defn public [] 42)"))
       private-reference (named-reference program 'hidden)
       changed (assoc-in program [:unit :exports] (list private-reference))]
  (is (not= (:snapshot (facts/facts program)) (:snapshot (facts/facts changed))))
  (is (= :refused (:status (phase/check changed))))
  (is (= :refused (:status (phase/check
                    (assoc-in program [:unit :exports]
                      (list (assoc (first (get-in program [:unit :exports])) :extra true)))))))
  (is (= :invalid-contextual-unit
         (kind #(compiler/contextual-unit-factory (assoc (:unit program) :version 1.0)))))
  (is (= :invalid-contextual-unit
         (kind #(compiler/contextual-unit-factory
                  (assoc (:unit program) :exports (list private-reference private-reference))))))))


(deftest physical-export-callables-preserve-multiple-arities-variadics-and-self-recursion
 (let [bundle (prepared (str "(ns exports) (defn- bias [x] (erlang/+ x 40)) "
                             "(defn answer ([x] (bias x)) ([x & more] (erlang/+ (bias x) (erlang/length more)))) "
                             "(defn count-to [n] (if (erlang/< n 42) (recur (erlang/+ n 1)) n))"))
       module :Elixir.ContextualExportArities beam (emit bundle module)]
  (try
   (code/load_binary module '() beam)
   (let [instance (erlang/apply module :__bl_unit__ (list))
         answer (get (:exports instance) (named-reference (:program bundle) 'answer))
         count-to (get (:exports instance) (named-reference (:program bundle) 'count-to))]
    (is (= 42 (answer 2)))
    (is (= 42 (answer 1 9)))
    (is (= 42 (answer 0 9 8)))
    (is (= 42 (count-to 0))))
   (finally (unload module)))))

(deftest ordinary-artifact-emission-rejects-a-stale-export-analysis-before-code-loading
 (let [dir (Path/join (System/tmp_dir!) (str "contextual-exports-" (erlang/unique_integer (list :positive))))
       module :Elixir.ContextualWorldExports]
  (File/mkdir_p! dir)
  (try
   (File/write! (Path/join dir "main.bl") "(ns exports) (defn- hidden [] 0) (defn answer [] 42)")
   (File/write! (Path/join dir "world.bl")
      "{:version 1 :profile 'syntax-v1 :entry ['exports 'current] :sources [{:namespace 'exports :revision 'current :file \"main.bl\"}] :libraries []}")
   (let [prepared (world/prepare (Path/join dir "world.bl"))
         private-reference (named-reference (:program prepared) 'hidden)
         changed (assoc-in prepared [:program :unit :exports] (list private-reference))]
    (is (= :world-analysis-changed (kind #(world/artifact changed module))))
    (is (not (erlang/module_loaded module)))
    (let [pair (world/artifact prepared module)]
     (code/load_binary module '() (elem pair 1))
     (let [instance (erlang/apply module :__bl_unit__ (list))
           answer (get (:exports instance) (named-reference (:program prepared) 'answer))]
      (is (= 42 (answer)))
      (is (= nil ((:entry instance)))))))
   (finally (unload module) (File/rm_rf! dir)))))
