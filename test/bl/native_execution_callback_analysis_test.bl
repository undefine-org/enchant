(ns native-execution-callback-analysis-test
 (:require [reload.generation :as g] [proc.callback :as cb] [proc.message-domain :as domain]
           [test.support.source-fixtures :as fixtures]))
(fixtures/effects!)

(deftest metadata-analysis-borrows-the-actual-retained-callback-after-graph-retirement
 (let [graph (g/prepare!
              {:application-id "callback-analysis-after-retirement"
               :native-modules #{"SourceEffectObserverFixture"}
               :sources {"callback.analysis"
                 "(ns callback.analysis)
                  (defn identity-value [value] value)
                  (defn effect [value] (SourceEffectObserverFixture/put :callback-analysis-effect value))"}})
       register (fn [name] (g/with! graph
                            #(let [registration (cb/register!
                                     (BeamLisp.Env/fetch_exact! (get (:mapping graph) "callback.analysis") name))]
                               ;; The first inspection must prepare deferred
                               ;; SDK readers before this real Source boundary.
                               (BeamLisp.Execution/restrict! registration)
                               registration)))
       pure (register "identity-value") effect (register "effect")
       caller (BeamLisp.Env/capture)]
  (try
   (SourceEffectObserverFixture/delete :callback-analysis-effect)
   (is (= :waiting (:status (g/retire! graph))))
   (is (thrown? (g/with! graph (fn [] :fresh-admission))))
   (let [proof (domain/capture-registration! pure)]
    (is (= :proved (:status proof)))
    (is (= pure (:registration proof)))
    (is (not (contains? proof :environment)))
    (is (domain/valid? proof))
    (is (not (domain/valid? (assoc proof :root [:copied :function 1]))))
    (is (= 42 (cb/invoke! pure [42])))
    (is (= :unknown (:status (domain/capture-registration! effect))))
    (is (= nil (SourceEffectObserverFixture/get :callback-analysis-effect)))
    (is (thrown? (BeamLisp.Execution/inspect! pure "proc.message-domain/capture")))
    (is (thrown? (BeamLisp.Execution/inspect! pure 'arbitrary/evaluator)))
    (is (= caller (BeamLisp.Env/capture)))
    (cb/unregister! pure)
    (is (= {:status :cancelled} (BeamLisp.Execution/inspect! pure 'proc.message-domain/capture)))
    (is (not (domain/valid? proof)))
    (is (= {:status :unknown :reason :closed-message-registration}
           (domain/capture-registration! pure))))
   (finally (cb/unregister! pure) (cb/unregister! effect) (g/retire! graph)
            (SourceEffectObserverFixture/delete :callback-analysis-effect)))))
