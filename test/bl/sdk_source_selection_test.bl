(ns sdk.source-selection-test (:require [sdk-source-selection :as selection]))

(deftest target-is-a-declaration-not-a-namespace-prefix
  (doseq [[text target] [["(ns ordinary)" :beam]
                         ["(ns js.helper) (defn answer [] 42)" :beam]
                         ["(ns ^:js browser.native)" :javascript]
                         ["(ns ^{:interop :javascript} browser.native)" :javascript]
                         ["(defn fragment [] 42)" nil]
                         ["'(ns ^:js quoted.namespace)" nil]]]
    (is (= target (:target (selection/describe text))))
    (is (= target (:target (selection/describe text "fixture.bl"))))))

(deftest selection-never-runs-the-source-body
  (let [marker (str (System/tmp_dir!) "/selection-must-not-run-" (System/unique_integer (list :positive)))
        text (str "(ns ^:js browser.native) (File/write! " (pr-str marker) " \"bad\")")]
    (is (= false (selection/beam-source? text)))
    (is (not (File/exists? marker)))))
