(ns typed-invocation-contract-test (:require [typed :as typed] [compiler :as compiler]))
(defn- warnings []
 (mapv :kind (:warnings (typed/check-source
                        "(defn run [] (let [f :answer] (f {} 1 2)))" "typed.invocation.contract"))))
(deftest compiler-compatibility-data-cannot-change-typed-arity-findings
 (let [expected (warnings) previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork :global)]
  (is (= [:arity] expected))
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (doseq [poison [nil {"kw" [3]} {"kw" [1 2 3]}]]
      (BeamLisp.Env/intern "compiler" "ifn-arities" poison)
      (is (= expected (warnings))))))
   (finally (BeamLisp.Env/destroy scope) (BeamLisp.Env/bind previous)))))

(deftest public-contract-ignores-both-compatibility-and-function-value-rebinding
 (let [expected {"kw" [1 2] "map" [1 2] "set" [1 2] "vector" [1]}
       previous (BeamLisp.Env/capture) scope (BeamLisp.Env/fork :global)]
  (is (= expected (compiler/invocation-arities)))
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (BeamLisp.Env/intern "compiler" "ifn-arities" nil)
     (BeamLisp.Env/intern "compiler" "invocation-arities" nil)
     (is (= expected (compiler/invocation-arities)))
     (is (= [:arity] (warnings)))))
   (finally (BeamLisp.Env/destroy scope) (BeamLisp.Env/bind previous)))))

(deftest published-callable-data-counts-agree-with-actual-native-dispatch
 (doseq [[kind value first-argument] [["kw" :answer {:answer 42}]
                                      ["map" {:answer 42} :answer]
                                      ["set" #{:answer} :answer]
                                      ["vector" [42] 0]]]
  (doseq [n (range 4)]
   (let [args (cond (= n 0) (list) (= n 1) (list first-argument)
                   (= n 2) (list first-argument :fallback)
                   :else (list first-argument :fallback :extra))
         outcome (try (BeamLisp.Ns.Rt/invoke value args) :accepted (catch _ :refused))
         expected (if (contains? (set (get (compiler/invocation-arities) kind)) n)
                    :accepted :refused)]
    (is (= expected outcome))))))
