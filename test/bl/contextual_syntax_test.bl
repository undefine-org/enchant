(ns contextual-syntax-test (:require [syntax :as s]))

(defn- ctx []
 {:world (crypto/hash :sha256 "world") :namespace 'example :space 'value
  :scopes {0 [(crypto/hash :sha256 "module")]}})

(defn- kind-of [action]
 (try (action) nil (catch error (:kind (ex-data error)))))

(deftest contextual-reader-roundtrips-actual-reader-shapes-and-authored-metadata
 (let [source "(let [x 42] ^{:doc \"note\"} [x {:k #{1 2}} 'name #Entry{:value x}])"
       original (BeamLisp.Reader/read_string source "roundtrip.bl")
       syntax (s/read source "roundtrip.bl" (ctx))]
  (is (= original (map s/to-reader syntax)))
  (is (= "roundtrip.bl" (get-in (first syntax) [:origin :file])))
  (is (= 1 (get-in (first syntax) [:origin :line])))
  (is (= :syntax-record-datum (kind-of #(s/to-datum (first syntax)))))))

(deftest datum-conversion-preserves-data-and-does-not-interpret-anf-lookalikes
 (let [data (list 'f [1 :two] {:op :invoke :callee 'x :arguments (list 3)} #{4 5} nil true false "hello")
       syntax (s/from-datum data (ctx))]
  (is (= data (s/to-datum syntax)))
  (is (= :map (:tag (nth (:children syntax) 2))))
  (is (= :syntax-symbol (kind-of #(s/identifier "x" (ctx)))))
  (is (= :syntax-datum (kind-of #(s/from-datum (fn [] :opaque) (ctx)))))
  (is (= :syntax-datum (kind-of #(s/from-datum (erlang/make_ref) (ctx)))))))

(deftest phase-specific-module-scopes-and-general-introduction-scopes-compose
 (let [a (crypto/hash :sha256 "a") b (crypto/hash :sha256 "b")
       identifier (s/identifier 'x (assoc (ctx) :scopes {0 [a a] 1 [b]}))
       introduced (s/add-scope identifier a :all)]
  (is (= [a] (vec (s/scopes identifier 0))))
  (is (= [b] (vec (s/scopes identifier 1))))
  (is (= (sort [a b]) (s/scopes introduced 1)))
  (is (= [] (vec (s/scopes identifier -1))))
  (is (= :syntax-phase (kind-of #(s/scopes identifier :all))))))

(deftest shape-origin-and-budget-validation-refuse-before-data-escapes
 (let [node (s/identifier 'x (ctx))
       deep (reduce (fn [value _] (list value)) 'x (range 130))]
  (is (= :syntax-node (kind-of #(s/validate (assoc node :op :invoke)))))
  (is (= :syntax-datum (kind-of #(s/validate (assoc node :tag :scalar :value (fn [] :opaque))))))
  (is (= :syntax-origin (kind-of #(s/validate (assoc node :origin {:opaque (erlang/make_ref)})))))
  (is (= :syntax-bound (kind-of #(s/from-datum deep (ctx)))))
  (is (= :syntax-bound (kind-of #(s/from-datum (vec (range 100001)) (ctx)))))))

(deftest template-validates-contexts-and-total-output-work
 (let [template (s/identifier 'body (ctx))
       scope (crypto/hash :sha256 "introduction")
       foreign (s/identifier 'x (assoc (ctx) :world (crypto/hash :sha256 "other")))]
  (is (= :syntax-template-world (kind-of #(s/template template {'body foreign} scope))))
  (is (= :syntax-template (kind-of #(s/template template (list) scope))))
  (is (= :syntax-node (kind-of #(s/template template {'body {:op :lit :val 42}} scope))))))
