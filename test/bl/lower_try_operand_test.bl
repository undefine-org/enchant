(ns lower-try-operand-test (:require [compiler :as compiler] [lower :as lower]))

(defn- evaluate [source]
 (lower/eval-anf (erlang/binary_to_atom (str "Elixir.TryOperand." (erlang/unique_integer (list :positive))))
  (compiler/compile (BeamLisp.Reader/read_one source) (compiler/new-env "user"))))

(deftest calls-nested-in-protected-operands-stay-inside-the-try
 (doseq [expression ["(erlang/throw :payload)"
                     "(erlang/=:= true (erlang/throw :payload))"
                     "(erlang/length (erlang/throw :payload))"
                     "(lists/reverse (erlang/throw :payload))"
                     "[(erlang/throw :payload)]"
                     "{:value (erlang/throw :payload)}"]]
  (is (= [:throw :payload]
         (evaluate (str "(try " expression " (catch-raw [kind reason stack] [kind reason]))"))))))

(deftest argument-effects-and-failure-run-left-to-right-in-the-protected-region
 (is (= [[:error :badarg] 1]
        (evaluate (str "(do (erlang/put :try-operand-order 0) "
                    "[(try (erlang/+ (do (erlang/put :try-operand-order 1) (erlang/error :badarg)) "
                    "(do (erlang/put :try-operand-order 2) 0)) "
                    "(catch-raw [kind reason stack] [kind reason])) "
                    "(erlang/get :try-operand-order)])")))))

(deftest an-outer-bif-error-retains-its-source-location-after-operand-binding
 (let [file "try-operands-position.bl"
       source (str "(ns try.operand.position)\n(defn fail [xs]\n  (erlang/tuple_size\n"
                   "    (erlang/hd xs)))\n(try (fail '(42)) (catch-raw [kind reason stack] stack))")
       env (compiler/new-env "user")
       frames (reduce (fn [_ form] (BeamLisp.Compiler/eval_form form env)) nil
                (BeamLisp.Reader/read_string source file))
       frame (Enum/find frames
               (fn [frame]
                (= file (erlang/iolist_to_binary (Keyword/get (erlang/element 4 frame) :file "")))))]
  (is (some? frame) (pr-str frames))
  (when frame (is (= 3 (Keyword/get (erlang/element 4 frame) :line))))))
