; test/bl/lazy_scaling_test.bl — the gate that keeps O(n²) lazy producers out.
; Run: bl test test/bl/lazy_scaling_test.bl
;
; PLAN-151. A lazy producer whose per-element memo cell captures the rest of its
; input costs O(n²): each cell's price is proportional to what its thunk
; captured. The symptom is not a wrong answer but a slow one, which no
; equivalence test notices — so this file times every producer at n and 2n and
; fails when doubling the input more than triples the time. A linear producer
; shows ~2; the defect this guards against showed 3.5–6.
;
; Timing tests are noisy on a loaded host, so each side takes the best of three
; runs and the bound (3.0) sits well above linear and well below quadratic. A
; case too fast to time (< 3 ms at 2n) is linear by construction and passes.
; bench/lazy_scaling.bl prints the same cases as a table.

(ns lazy-scaling.test)

(def ^:private n 3000)

(defn- us [f]
  (let [t0 (erlang/monotonic_time :microsecond)]
    (f)
    (- (erlang/monotonic_time :microsecond) t0)))

(defn- best [f] (min (us f) (us f) (us f)))

(defn- linear?
  "Whether `f` (given a vector of size k) scales linearly from n to 2n. Answers
   the measurement too, so a failure names its numbers."
  [f]
  (let [a (best (fn [] (f (vec (range n)))))
        b (best (fn [] (f (vec (range (* 2 n))))))]
    {:ok? (or (< b 3000) (<= b (* 3 (max a 1))))
     :n-us a :2n-us b}))

(def ^:private env (into {} (map (fn [i] [i i]) (range 20000))))

(def cases
  [["map-indexed"   (fn [c] (count (map-indexed (fn [i x] [i x]) c)))]
   ["keep-indexed"  (fn [c] (count (keep-indexed (fn [i x] (when (even? i) x)) c)))]
   ["dedupe"        (fn [c] (count (dedupe c)))]
   ["keep"          (fn [c] (count (keep (fn [x] (when (odd? x) x)) c)))]
   ["partition-by"  (fn [c] (count (partition-by (fn [x] (quot x 7)) c)))]
   ["partition"     (fn [c] (count (partition 4 c)))]
   ["interpose"     (fn [c] (count (interpose 0 c)))]
   ["interleave"    (fn [c] (count (interleave c c)))]
   ["for"           (fn [c] (count (for [x c] x)))]
   ["for :when"     (fn [c] (count (for [x c :when (even? x)] x)))]
   ["map"           (fn [c] (count (map inc c)))]
   ["filter"        (fn [c] (count (filter odd? c)))]
   ["walk first/rest"
    (fn [c] (loop [s (map-indexed (fn [i x] [i x]) c) k 0] (if (seq s) (recur (rest s) (inc k)) k)))]
   ["reduce over map-indexed" (fn [c] (reduce (fn [a _] (inc a)) 0 (map-indexed (fn [i x] [i x]) c)))]
   ["mapv, f closes over a large map" (fn [c] (count (mapv (fn [x] (get env x)) c)))]
   ["for, body closes over a large map" (fn [c] (count (for [x c] (get env x))))]])

; A producer whose carried STATE grows with the input is a different class: the
; state is part of the value a shared memo hands to a waiter, so every chunk
; copies it. `distinct` (its seen set) is the one such producer. It is 34x
; cheaper than before PLAN-151 yet still O(n^2/32), and only FUP-129 (local
; until shared / store-once terms) can make it linear. It is timed here so the
; residual stays visible and cannot regress past its measured shape (ratio ~4
; at n=3000, ~70 ms): bounded at 2n by an absolute budget instead of the ratio.
(def residuals
  [["distinct (FUP-129)" (fn [c] (count (distinct c))) 1000000]])

(deftest state-carrying-producers-stay-within-their-budget
  (doseq [[nm f budget-us] residuals]
    (let [r (linear? f)]
      (is (<= (:2n-us r) budget-us)
          (str nm ": " (:n-us r) " us at n=" n ", " (:2n-us r) " us at 2n, budget " budget-us)))))

(deftest every-lazy-producer-is-linear
  (doseq [[nm f] cases]
    (let [r (linear? f)]
      (is (:ok? r) (str nm ": " (:n-us r) " us at n=" n ", " (:2n-us r) " us at 2n")))))
