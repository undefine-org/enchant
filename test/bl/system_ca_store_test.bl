; HTTP clients initialize OTP's normal trust store before selecting transport.
; A minimal worker must provide real system roots rather than disabling TLS.
(ns system.ca-store-test)

(deftest otp-can-load-the-system-certificate-authorities
 (let [certificates (erlang/apply :public_key :cacerts_get (list))]
  (is (erlang/is_list certificates))
  (is (pos? (erlang/length certificates)))))
