(ns execution.ir-children-test (:require [anf :as anf] [system.ir :as ir]))

(def a {:op :lit :val :a :ann {}})
(def b {:op :lit :val :b :ann {}})
(def c {:op :lit :val :c :ann {}})
(def d {:op :lit :val :d :ann {}})

(deftest grammar-children-are-eager-and-literal-data-remains-inert
 (let [payload {:op :remote :mod :erlang :fun :error :args (list a)}
       literal {:op :lit :val payload :ann {}}
       children (anf/executable-children {:op :map :pairs [[a b] [c d]]})]
  (is (= (list) (anf/executable-children literal)))
  (is (erlang/is_list children))
  (is (= (list a b c d) children))
  (is (= children (ir/child-nodes {:op :map :pairs [[a b] [c d]]})))))

(deftest clause-guards-latent-bodies-and-cleanup-are-visible
 (let [clause {:pats [{:pop :plit :val {:op :remote}}] :guard b :body c}]
  (is (= (list a b c d)
         (anf/executable-children {:op :try :body a :catch [clause] :after d})))
  (is (= (list b c) (anf/executable-children {:op :fn :clauses [clause]})))
  (is (= (list b c a d)
         (anf/executable-children {:op :recv :clauses [clause] :timeout a :after d})))))

(deftest every-operand-family-has-one-shared-traversal
 (doseq [[node expected]
         [[{:op :js :args [a b]} [a b]]
          [{:op :arith :args [a b]} [a b]]
          [{:op :remote :args [a b]} [a b]]
          [{:op :apply :fn a :args [b c]} [a b c]]
          [{:op :let :init a :body b} [a b]]
          [{:op :if :test a :then b :else c} [a b c]]
          [{:op :do :stmts [a b c]} [a b c]]
          [{:op :tuple :elems [a b]} [a b]]
          [{:op :struct :fields [[a b]]} [a b]]
          [{:op :cons :head a :tail b} [a b]]]]
  (is (= expected (vec (anf/executable-children node))))
  (is (= expected (vec (ir/child-nodes node))))))

(deftest unsupported-operations-refuse-in-both-production-and-analysis
 (is (thrown? (anf/executable-children {:op :unrecognized :hidden a})))
 (is (thrown? (ir/child-nodes {:op :unrecognized :hidden a}))))

(deftest callable-abi-reading-is-shared-with-production
 (let [callee (anf/var "f") tail (anf/var "arguments")
       fixed (anf/invoke callee (anf/cons-cell a (anf/empty-list-node)))
       dynamic (anf/invoke callee (anf/cons-cell a tail))
       site (ir/call-site dynamic)]
  (is (= callee (:callee (anf/callable-invocation fixed))))
  (is (= :invoke (:mode (ir/call-site fixed))))
  (is (= 1 (:arity (ir/call-site fixed))))
  (is (= :invoke (:mode site)))
  (is (= [a tail] (:args site)))
  (is (= tail (:rest site)))
  (is (nil? (:arity site)))
  (is (nil? (anf/callable-invocation nil)))
  (let [remote (anf/remote :Elixir.BeamLisp.Ns.Rt :invoke (list callee tail))]
   (is (nil? (anf/callable-invocation remote)))
   (is (= :remote (:mode (ir/call-site remote)))))))
