(ns native-execution-epoch-cleanup-test)

(deftest closing-and-consuming-native-epochs-reclaims-only-their-unaccepted-offers
 ;; Keep the owner alive throughout and run this file alone for exact custody
 ;; counts. Owner-death reclamation cannot satisfy this gate accidentally.
 (let [warm (BeamLisp.Execution/register! (fn [] nil))
       _ (BeamLisp.Execution/close! warm)
       baseline (ets/info :beam_lisp_source_lease_domains :size)]
  (let [source (BeamLisp.Execution/register! (fn [] 42))
        offers (mapv (fn [_] (BeamLisp.Execution/prepare-handoff! source (erlang/self))) [1 2 3])]
   (try
    (is (= (+ baseline 4) (ets/info :beam_lisp_source_lease_domains :size)))
    (BeamLisp.Execution/close! source)
    (doseq [offer offers]
     (is (= nil (BeamLisp.Env/execution_registration_state (:accepted offer)))))
    (is (= baseline (ets/info :beam_lisp_source_lease_domains :size)))
    (finally (BeamLisp.Execution/close! source)
     (doseq [offer offers] (BeamLisp.Execution/close! (:accepted offer))))))
  (let [source (BeamLisp.Execution/register! (fn [] 42))
        first (BeamLisp.Execution/prepare-handoff! source (erlang/self))
        other (BeamLisp.Execution/prepare-handoff! source (erlang/self))]
   (try
    (is (= :accepted (:status (BeamLisp.Execution/accept-handoff! first))))
    (is (= nil (BeamLisp.Env/execution_registration_state (:accepted other))))
    (is (= (inc baseline) (ets/info :beam_lisp_source_lease_domains :size)))
    (BeamLisp.Execution/close! source)
    (is (= {:status :completed :value 42} (BeamLisp.Execution/invoke! (:accepted first) [])))
    (finally (BeamLisp.Execution/close! source) (BeamLisp.Execution/close! (:accepted first))
             (BeamLisp.Execution/close! (:accepted other)))))
  (let [source (BeamLisp.Execution/register! (fn [] 41))
        offer (BeamLisp.Execution/prepare-handoff! source (erlang/self))]
   (try
    (is (= {:status :completed :value 41} (BeamLisp.Execution/invoke! source [])))
    (is (= :active (:status (BeamLisp.Execution/observe source))))
    (is (= {:status :pending} (BeamLisp.Execution/handoff-status offer)))
    (is (= :accepted (:status (BeamLisp.Execution/accept-handoff! offer))))
    (finally (BeamLisp.Execution/close! source) (BeamLisp.Execution/close! (:accepted offer)))))
  (is (= baseline (ets/info :beam_lisp_source_lease_domains :size)))))
