;; Actual produced-SDK consumer. Component fixture transport is not a substitute
;; for this test; it requires real proc.mailbox image/dependency/public evidence.
(ns contextual-mailbox-sdk-test (:require [compile.world :as world]))
(deftest selected-sdk-mailbox-runs-the-existing-bracket-example
 (let [prepared (world/prepare "test/fixtures/contextual-mailbox/world.bl")]
  (is (= :proved (get-in prepared [:phase :status])))
  (is (= [42 107 99] (world/execute prepared [])))
  (is (= 3 (count (get-in prepared [:program :expansions]))))))
