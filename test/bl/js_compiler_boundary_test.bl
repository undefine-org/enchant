(ns bl.js.compiler-boundary-test (:require [bl.json :as json]))

(deftest javascript-compiler-guards-match-installed-native-validation
 (let [fixtures [["scalar" 1 {}] ["small-int-bytes" 1 {:max-bytes 3}]
                 ["integer-bytes" 256 {:max-bytes 5}] ["negative-bytes" -1 {:max-bytes 5}]
                 ["bignum-bytes" 18446744073709551616 {:max-bytes 12}]
                 ["float-bytes" 1.5 {:max-bytes 9}] ["unicode-bytes" "é" {:max-bytes 1}]
                 ["nil-bytes" nil {:max-bytes 2}] ["list-nodes" (list 1 2) {:max-nodes 2}]
                 ["vector-nodes" [1 2] {:max-nodes 3}] ["map-nodes" {:x 1} {:max-nodes 2}]
                 ["set-nodes" #{1} {:max-nodes 3}] ["nested-depth" (list (list (list 1))) {:max-depth 2}]
                 ["invalid-limits" 1 {:max-nodes 0}] ["native-tuple" (tuple :x 1) {}]
                 ["improper-list" (erlang/++ (list 1) :tail) {}] ["opaque-function" (fn [] 1) {}]
                 ["foreign-struct" (maps/put :__struct__ :foreign {}) {}]
                 ["symbol-metadata" (with-meta 'x {:owner "test"}) {}]
                 ["metadata-nodes" (with-meta 'x {:owner "test"}) {:max-nodes 2}]]
       expected (mapv (fn [[label value options]]
                   [label (try (BeamLisp.CompilerData/check_first_order! value options) "accepted"
                            (catch error (let [data (ex-data error)]
                              (str (name (:kind data)) ":" (name (:reason data))))))]) fixtures)
       root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       result (System/cmd "node" (list (Path/join root "test/js/compiler-data.test.mjs") (json/encode expected))
                            (list (tuple :stderr_to_stdout true)))]
  (is (= 0 (elem result 1)) (elem result 0))))

(deftest retained-native-sdk-builds-the-selected-checkout-javascript-compiler
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       library (Path/join root "priv/lib")
       out (str (System/tmp_dir!) "/bl-js-boundary-" (System/unique_integer (list :positive)))]
  ;; Source selection uses the existing public loader search path. The retained
  ;; native compiler remains unchanged; only ordinary JS assets come from the
  ;; explicitly selected source tree, outside its immutable SDK image.
  (BeamLisp.Env/add_search_path library)
  (is (= (Path/join library "js/build.bl") (BeamLisp.Loader/source_path "js.build")))
  (BeamLisp.Loader/ensure_loaded "bl.js")
  (try
   ((BeamLisp.Env/fetch! "bl.js" "build!") "js.eval"
    {:paths (list library (Path/join root "priv/boot")) :out out
     :stub "lower" :with "reader" :host "run"})
   (let [result (System/cmd "node" (list (Path/join root "test/js/native-live.mjs") out root)
                                  (list (tuple :stderr_to_stdout true)))]
    (is (= 0 (elem result 1)) (elem result 0)))
   (finally (File/rm_rf! out)))))
