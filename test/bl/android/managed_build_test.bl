(ns android.managed-build-test)

(def source-root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))
(def prototype "qualification.android-managed-build")
(BeamLisp.Env/with_ns prototype
 (fn [] (BeamLisp/eval
          (String/replace (BeamLisp.Loader/read_source
                            (Path/join source-root "priv/std/bl/android.bl.md"))
            "(ns bl.android" "(ns qualification.android-pipeline"))))
(defn invoke [name args]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! prototype name) (to-list args)))
(defn scratch []
 (let [root (Path/join (System/tmp_dir!) (str "android-pipeline-" (erlang/unique_integer (list :positive))))]
  (File/mkdir_p! root) root))
(defn old-time! [file]
 (File/touch! file (tuple (tuple 2000 1 1) (tuple 0 0 0)))
 (:mtime (File/stat! file)))

(deftest managed-application-units-reuse-the-identical-product-and-rebuild-only-edits
 (let [root (scratch) source (Path/join root "src") output (Path/join root "ebin")
       file (Path/join source "android_incremental_fixture.bl")]
  (try
   (File/mkdir_p! source)
   (File/write! (Path/join root "env.bl") "{:name \"android-fixture\" :paths [\"src\"]}")
   (File/write! file "(ns android-incremental-fixture) (defn answer [] 41)")
   (let [first-build (invoke "compile!" ["initial app" root [source] output])
         product (:product first-build)
         units (:artifact-units first-build)
         bytes (into {} (map (fn [unit] [unit (File/read! (Path/join unit "artifact-unit.term"))]) units))
         unchanged (invoke "compile!" ["unchanged app" root [source] output])]
    (is (String/starts_with? product "/nix/store/"))
    (is (= product (:product unchanged)))
    (is (= 0 (:compiled unchanged)))
    (is (seq units))
    (doseq [[unit manifest] bytes]
     (is (= manifest (File/read! (Path/join unit "artifact-unit.term"))))
     (is (= "android-incremental-fixture" (get-in (BeamLisp.AOT/verify_unit unit) [:manifest :namespace]))))
    (File/write! file "(ns android-incremental-fixture) (defn answer [] 42)")
    (let [edited (invoke "compile!" ["edited app" root [source] output])]
     (is (not= product (:product edited)))
     (is (= 1 (:compiled edited)))
     (is (seq (:artifact-units edited)))))
   (finally (File/rm_rf! root)))))
