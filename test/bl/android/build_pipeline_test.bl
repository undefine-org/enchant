(ns android.build-pipeline-test)

(def source-root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))
(def prototype "qualification.android-pipeline")
(BeamLisp.Env/with_ns prototype
 (fn [] (BeamLisp/eval
          (String/replace (BeamLisp.Loader/read_source
                            (Path/join source-root "priv/std/bl/android.bl.md"))
            "(ns bl.android" "(ns qualification.android-pipeline"))))
(defn invoke [name args]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! prototype name) (to-list args)))
(defn scratch []
 (let [root (Path/join (System/tmp_dir!) (str "android-pipeline-" (erlang/unique_integer (list :positive))))]
  (File/mkdir_p! root) root))
(defn old-time! [file]
 (File/touch! file (tuple (tuple 2000 1 1) (tuple 0 0 0)))
 (:mtime (File/stat! file)))

(deftest erlang-compilation-uses-the-selected-vm-and-reuses-valid-output
 (let [root (scratch) source (Path/join root "android_pipeline_probe.erl")
       output (Path/join root "ebin") trap (Path/join root "erlc")
       marker (Path/join root "external-erlc-called") previous (System/get_env "PATH")]
  (try
   (File/write! trap (str "#!/bin/sh\ntouch '" marker "'\nexit 99\n"))
   (File/chmod! trap 493)
   (System/put_env "PATH" (str root ":" previous))
   (File/write! source "-module(android_pipeline_probe).\n-export([answer/0]).\nanswer() -> 41.\n")
   (let [beam (invoke "erl-compile!" ["test stub" source output]) before (old-time! beam)]
    (is (File/regular? beam))
    (is (not (File/exists? marker)))
    (invoke "erl-compile!" ["unchanged stub" source output])
    (is (= before (:mtime (File/stat! beam))))
    (File/write! beam "damaged compiled output")
    (invoke "erl-compile!" ["restore damaged stub" source output])
    (is (not= "damaged compiled output" (File/read! beam)))
    (File/write! source "-module(android_pipeline_probe).\n-export([answer/0]).\nanswer() -> 42.\n")
    (invoke "erl-compile!" ["changed stub" source output])
    (code/load_binary :android_pipeline_probe (String/to_charlist beam) (File/read! beam))
    (is (= 42 (erlang/apply :android_pipeline_probe :answer (list))))
    (is (not (File/exists? marker))))
   (finally
    (System/put_env "PATH" previous)
    (code/purge :android_pipeline_probe) (code/delete :android_pipeline_probe)
    (File/rm_rf! root)))))

(deftest staging-reuses-unchanged-files-and-prunes-only-its-owned-projection
 (let [root (scratch) source (Path/join root "source") target (Path/join root "stage")
       manifest (Path/join root "owned.term")]
  (try
   (File/write! source "one")
   (File/mkdir_p! target)
   (File/write! (Path/join target "foreign") "keep")
   (invoke "sync-files!" [target {"app/first.beam" source} manifest])
   (let [before (old-time! (Path/join target "app/first.beam"))]
    (invoke "sync-files!" [target {"app/first.beam" source} manifest])
    (is (= before (:mtime (File/stat! (Path/join target "app/first.beam"))))))
   (File/write! source "two")
   (invoke "sync-files!" [target {"app/second.beam" source} manifest])
   (is (not (File/exists? (Path/join target "app/first.beam"))))
   (is (= "two" (File/read! (Path/join target "app/second.beam"))))
   (is (= "keep" (File/read! (Path/join target "foreign"))))
   (finally (File/rm_rf! root)))))

(deftest abi-selection-is-command-local-and-keeps-other-build-flags
 (is (= {:abi "arm64-v8a" :args ["--standalone" "--release"]}
        (invoke "abi-options" [["--standalone" "--abi" "arm64-v8a" "--release"]])))
 (is (= {:abi "x86_64" :args []} (invoke "abi-options" [["--abi" "x86_64"]])))
 (doseq [args [["--abi"] ["--abi" "unknown"] ["--abi" "x86_64" "--abi" "arm64-v8a"]]]
  (is (= :invalid-android-abi
       (try (invoke "abi-options" [args]) nil (catch error (:kind (ex-data error))))))))

(deftest empty-environment-abi-keeps-the-project-default-and-explicit-selection-wins
 (let [root (scratch) old (System/get_env "BL_ANDROID_ABI")]
  (try
   (File/write! (Path/join root "env.bl")
    "{:name \"android-env-fixture\" :paths [\"src\"] :android {:app \"fixture\" :id \"org.beamlisp.fixture\" :ns \"fixture.app\" :abi \"x86_64\"}}")
   (doseq [value ["" " \t"]]
    (System/put_env "BL_ANDROID_ABI" value)
    (is (= "x86_64" (:abi (invoke "target" [root]))))
    (is (= "arm64-v8a" (:abi (invoke "target" [root "arm64-v8a"])))))
   (finally
    (if old (System/put_env "BL_ANDROID_ABI" old) (System/delete_env "BL_ANDROID_ABI"))
    (File/rm_rf! root)))))

(deftest generated-phone-entry-compiles-with-the-selected-erlang-compiler
 (let [root (scratch)
       native (Path/join (BeamLisp.Tiers/priv_root) "native/lazy_memo.so")
       sha (String/downcase (Base/encode16 (crypto/hash :sha256 (File/read! native))))]
  (try
   ;; This control only compiles the generated entry. The complete real target
   ;; and admission are exercised by ordinary_receiver_test and device startup.
   (invoke "boot-module!" [{:app "android_boot_fixture" :ns "android.boot.fixture"}
                            root {:native {"lazy_memo.so" sha}}])
   (let [file (Path/join root "android_boot_fixture.beam")
         chunks (beam_lib/chunks (String/to_charlist file) (list :exports))]
    (is (= :ok (elem chunks 0)))
    (is (Enum/member? (Keyword/get (elem (elem chunks 1) 1) :exports) (tuple :start 0))))
   (finally (File/rm_rf! root)))))

(deftest device-resource-projection-replaces-readonly-cache-and-preserves-unchanged-mtime
 (let [root (scratch) destination (Path/join root "beam_lisp.app")
       source (Path/join (erlang/list_to_binary (code/lib_dir :beam_lisp)) "ebin/beam_lisp.app")
       libraries ["kernel-11.0" "stdlib-7.0" "elixir" "logger" "crypto-5.9"]]
  (try
   (File/write! destination "old resource") (File/chmod! destination 292)
   (invoke "device-app-file!" [source destination libraries])
   (let [read (erlang/apply :file :consult (list (String/to_charlist destination)))
         app (first (elem read 1)) props (elem app 2) before (old-time! destination)]
    (is (= :ok (elem read 0)))
    (is (= :beam_lisp (elem app 1)))
    (is (every? #{:kernel :stdlib :elixir :logger :crypto} (proplists/get_value :applications props)))
    (invoke "device-app-file!" [source destination libraries])
    (is (= before (:mtime (File/stat! destination)))))
   (finally (File/rm_rf! root)))))

(deftest android-stages-the-selected-sdk-elixir-version-and-complete-pure-apps
 (let [files (invoke "sdk-elixir-files" [])]
  (doseq [app [:elixir :eex :iex :logger :mix]]
   (let [relative (str "otp/lib/" (name app) "/ebin/" (name app) ".app")
         actual (get files relative)
         resource (erlang/apply :file :consult (list (String/to_charlist actual)))
         version (proplists/get_value :vsn (elem (first (elem resource 1)) 2))]
    (is (File/regular? actual))
    (is (= (System/version) (erlang/list_to_binary version)))))
  (is (= (elem (code/get_object_code :Elixir.System) 1)
         (File/read! (get files "otp/lib/elixir/ebin/Elixir.System.beam"))))
  (is (not (some #(String/ends_with? % ".so") (keys files))))))

(deftest runtime-inventory-leaves-apk-launcher-links-to-the-real-launcher
 (doseq [path ["otp/erts-17.0/bin/beam.smp" "otp/erts-17.0/bin/erl_child_setup"
               "otp/erts-17.0/bin/inet_gethost" "otp/erts-17.0/bin/epmd"
               "otp/lib/exqlite-0.37.0/priv/sqlite3_nif.so"]]
  (is (= false (invoke "runtime-owned-file?" [path]))))
 (doseq [path ["otp/erts-17.0/bin/escript" "otp/erts-17.0/bin/erl"
               "otp/lib/mob-0.9.3/ebin/Elixir.Mob.beam"
               "otp/lib/beam_lisp-0.1.0/priv/native/lazy_memo.so"
               "otp/lib/exqlite-0.37.0/ebin/Elixir.Exqlite.beam"]]
  (is (= true (invoke "runtime-owned-file?" [path])))))
