(ns typed.coverage-test (:require [typed :as types] [diag] [errors]))

(deftest type-evidence-reports-constraints-and-visited-clauses
 (let [result (types/check-source-result "(defn f ([] (+ 1 2)) ([x] (str x)))" "typed.coverage-fixture")]
  (is (= 1 (get-in result [:coverage :definitions])))
  (is (= 2 (get-in result [:coverage :clauses])))
  (is (some #(= :proved (:status %)) (:obligations result)))
  (is (= :proved (:status result)) (pr-str result))
  (is (= true (get-in result [:coverage :complete])))))

(deftest partial-argument-overlap-is-an-obligation
 (let [result (types/check-source-result "(defn f [x] (+ x 1))" "typed.coverage-fixture")]
  (is (= :unknown (:status result)) (pr-str result))
  (is (some #(= :argument-type (:reason %)) (:obligations result)))
  (is (= false (get-in result [:coverage :complete])))))

(deftest unknown-return-types-remain-obligations-without-call-sites
 (let [result (types/check-source-result "(defn identity [x] x)" "typed.coverage-fixture")]
  (is (= :unknown (:status result)) (pr-str result))
  (is (some #(= :return-type (:reason %)) (:obligations result)))
  (is (= false (get-in result [:coverage :complete])))))

(deftest silent-editor-checks-do-not-prove-unknown-types
 (let [source "(defn f [value] (unknown-operation value))"
       editor (types/check-source source "typed.coverage-fixture")
       result (types/check-source-result source "typed.coverage-fixture")]
  (is (empty? (:warnings editor)))
  (is (= :unknown (:status result)) (pr-str result))
  (is (some #(= :signature-unavailable (:reason %)) (:obligations result)))
  (is (= false (get-in result [:coverage :complete])))))

(deftest definite-type-errors-retain-the-shared-diagnostic-vocabulary
 (let [result (types/check-source-result "(defn f [] (+ :bad 1))" "typed.coverage-fixture")]
  (is (= :refused (:status result)) (pr-str result))
  (is (some #(= :disjoint-argument-type (:reason %)) (:obligations result)))
  (is (every? diag/diag? (:diagnostics result)))
  (is (some #(= :type-mismatch (:kind %)) (:diagnostics result)))
  (is (every? #(string? (errors/render "fixture.bl" "(defn f [] (+ :bad 1))" %))
              (:diagnostics result)))))

(deftest malformed-type-input-has-an-explicit-error-verdict
 (let [result (types/check-source-result "(defn broken [" "typed.coverage-fixture")]
  (is (= :error (:status result)))
  (is (= false (get-in result [:coverage :complete])))
  (is (every? diag/diag? (:diagnostics result)))
  (is (= :type-analysis-error (:kind (first (:diagnostics result)))))))

(deftest opting-into-coverage-preserves-editor-output-and-nested-state
 (let [source "(defn f [] (+ :bad 1))"
       first (types/check-source source "typed.coverage-fixture")
       _ (types/check-source-result "(defn g [x] (unknown x))" "typed.coverage-fixture")
       again (types/check-source source "typed.coverage-fixture")]
  (is (= first again))
  (is (= #{:warnings :evidence} (set (keys again))))))
