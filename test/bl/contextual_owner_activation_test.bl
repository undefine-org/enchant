(ns contextual-owner-activation-test
 (:require [compile.world :as world] [reload.execution :as execution] [reload.generation :as generation]
           [reload.state :as state] [proc.evolve :as evolve] [reload]))

(defn- fixture [action]
 (let [dir (Path/join (System/tmp_dir!) (str "canonical-owner-" (erlang/unique_integer (list :positive))))]
  (File/mkdir_p! dir)
  (try
   (File/write! (Path/join dir "main.bl")
    "(ns owner.unit)
      (defn handle [message value] (let [n (erlang/+ value message)] {:reply n :state n}))
      (defn accepts [message] (erlang/is_integer message))
      (defn valid [value] (erlang/is_integer value))
      (defn unchanged [value] value)
      (defn spec [version digest]
        {:version version :digest digest :handler handle :accept? accepts :check-state valid
         :migrate-state unchanged :upcast unchanged}) 42")
   (File/write! (Path/join dir "world.bl")
    "{:version 1 :profile 'syntax-v1 :entry ['owner.unit 'current] :sources [{:namespace 'owner.unit :revision 'current :file \"main.bl\"}] :libraries []}")
   (let [prepared (world/prepare (Path/join dir "world.bl"))
         reference (:reference (first (filter #(and (= 'spec (get-in % [:declaration :name])) (not= :local (get-in % [:declaration :visibility])))
                                     (vals (get-in prepared [:program :references])))))
         captured (BeamLisp.AOT/compile_unit (world/prepare-unit prepared :Elixir.CanonicalOwnerActivation))]
    (action captured reference))
   (finally (File/rm_rf! dir)))))
(defn- initialize [captured]
 (let [g (execution/prepare-captured-unit! captured)]
  (execution/initialize-instance! g)
  (execution/complete-preparation! (:cache-key g) g) g))
(defn- spec [g reference version]
 (generation/with! g #(evolve/prepare-spec (generation/invoke! g reference [version (:digest g)]))))

(deftest canonical-actor-refuses-unproved-evolution-and-keeps-original-custody
 (fixture
  (fn [captured reference]
   (let [old (initialize captured) fresh (initialize captured) pid (atom nil)]
    (try
     (reload/set-enabled! true)
     (generation/with! old #(state/bind! {}))
     (generation/inherit-runtime! fresh old)
     (reset! pid (generation/with! old #(evolve/start! (spec old reference 1) 0 {:managed true})))
     (is (= 2 (evolve/request! @pid 1 2)))
     (let [result (generation/with! fresh #(reload/activate! @pid 1 (spec fresh reference 2)))]
      (is (= {:status :refused :kind :unproved-message-migration}
             (select-keys result [:status :kind])) (pr-str result)))
     (is (= 5 (evolve/request! @pid 1 3)))
     (is (= {:status :refused :kind :unsupported-version} (evolve/request! @pid 2 4)))
     (is (= :waiting (:status (generation/retire! old))))
     (is (= 1 (:version (evolve/status @pid))))
     (is (= 9 (evolve/request! @pid 1 4)))
     (finally
      (when (and @pid (Process/alive? @pid)) (GenServer/stop @pid))
      (reload/set-enabled! nil)
      (generation/retire! old) (generation/retire! fresh)))))))
