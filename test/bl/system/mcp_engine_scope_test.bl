(ns system.mcp-engine-scope-test
  (:require [mcp.tools :as tools] [code.index :as index] [datom]))

(deftest the-engine-mount-does-not-pay-for-the-project-before-a-code-question
  (let [root (str (System/tmp_dir!) "/bl-engine-scope-" (erlang/unique_integer (list :positive)))
        owned (atom [])]
    (File/mkdir_p! (str root "/src"))
    (File/write! (str root "/env.bl") "{:name \"scope-fixture\" :paths [\"src\"]}\n")
    (File/write! (str root "/src/project.bl") "(ns engine-scope-fixture) (defn project-value [] 7)\n")
    (try
      (BeamLisp/with_cwd root
        (fn []
          (let [engine (tools/engine-conn) engine-index (index/held-index)]
            (swap! owned conj engine)
            (is (= #{"codebase" "typed"} (set (map first (:sources engine-index)))))
            (is (= 2 (get-in engine-index [:stats :files])))
            (is (not (tools/mounted?)))
            (let [project (tools/conn) project-index (index/held-index)]
              (swap! owned conj project)
              (is (= #{"codebase" "typed" "engine-scope-fixture"} (set (map first (:sources project-index)))))
              (is (= [["project-value"]]
                     (vec (datom/q '[:find ?name :where [?e :fn/ns "engine-scope-fixture"] [?e :fn/name ?name]]
                                    (datom/db project)))))
              (is (= engine (tools/engine-conn)))
              (is (datom/alive? engine))))))
      (finally (doseq [c (distinct @owned)] (datom/close! c)) (File/rm_rf! root)))))
