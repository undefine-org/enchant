(ns system.data-global-mutation-test (:require [system.analyze :as an]))

(deftest a-nested-redefinition-prevents-a-literal-data-proof
  (let [source "(def palette {})
                (defn replace-palette []
                  (def palette (lazy-seq (println :effect) (list 1))))
                (defn inspect [] (count palette))"
        summary (an/analyze source)]
    (is (contains? (:footprint (get summary "inspect")) :opaque-world))
    (is (contains? (:latent (get summary "inspect")) :opaque-world))))

(deftest quoted-definitions-remain-data
  (let [source "(def palette {:example '(def palette (fn [] (println :effect)))})
                (defn inspect [key] (get palette key {:label (name key)}))"
        summary (an/analyze source)]
    (is (= {} (:footprint (get summary "inspect"))))
    (is (= {} (:latent (get summary "inspect"))))))
