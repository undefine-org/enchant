(ns system.af-worklist-test (:require [system.gfp :as gfp]))

;; Independent finite-path characterization: avoiding the goal fails at a
;; dead end or a repeated vertex. No fixpoint iteration appears in this oracle.
(defn- all-paths-hit-goal? [graph goals start]
 (letfn [(walk [state seen]
           (cond
            (contains? goals state) true
            (contains? seen state) false
            (empty? (get graph state)) false
            :else (every? #(walk % (conj seen state)) (get graph state))))]
  (walk start #{})))

(deftest all-two-state-graphs-and-goal-subsets-match-the-path-oracle
 (doseq [edges (range 16) goal-mask (range 4)]
  (let [graph (into {} (map (fn [from]
                             [from (vec (filter #(not (zero? (erlang/band edges (erlang/bsl 1 (+ (* 2 from) %))))) [0 1]))])
                           [0 1]))
        goals (set (filter #(not (zero? (erlang/band goal-mask (erlang/bsl 1 %)))) [0 1]))
        expected (set (filter #(all-paths-hit-goal? graph goals %) [0 1]))]
   (is (= expected (gfp/af [0 1] #(get graph %) #(contains? goals %))) (pr-str [edges goal-mask])))))

(deftest long-chain-reads-each-state-once
 (let [n 256 calls (atom {}) goals (atom {})
       reached (gfp/af (range n)
                  (fn [state] (swap! calls update state #(inc (or % 0)))
                              (if (= state (dec n)) [] [(inc state) (inc state)]))
                  (fn [state] (swap! goals update state #(inc (or % 0))) (= state (dec n))))]
  (is (= (set (range n)) reached))
  (is (= n (count @calls)))
  (is (every? #(= 1 %) (vals @calls)))
  (is (= n (count @goals)))
  (is (every? #(= 1 %) (vals @goals)))))

(deftest cycles-deadlocks-and-outside-successors-do-not-prove-progress
 (is (= #{} (gfp/af [0 1] #(get {0 [0 1] 1 [0]} %) (fn [_] false))))
 (is (= #{2} (gfp/af [0 1 2] #(get {0 [1 2] 1 [0] 2 []} %) #(= % 2))))
 (is (= #{} (gfp/af [0] (fn [_] [:outside]) #(= % :outside))))
 (is (= #{} (gfp/af [] (fn [_] []) (fn [_] true))))
 (is (= #{nil false :done}
        (gfp/af [nil false :done] #(get {nil [false] false [:done] :done []} %) #(= :done %)))))

(deftest finite-worklist-does-not-borrow-the-lazy-cache-budget
 (let [previous (Application/get_env :beam_lisp :lazy_cache_budget_bytes)
       result (try
                (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
                (gfp/af [0 1 2] #(get {0 [1] 1 [2] 2 []} %) #(= 2 %))
                (catch error :unexpected-lazy-admission)
                (finally
                 (if (nil? previous)
                  (Application/delete_env :beam_lisp :lazy_cache_budget_bytes)
                  (Application/put_env :beam_lisp :lazy_cache_budget_bytes previous))))]
  (is (= #{0 1 2} result))))
