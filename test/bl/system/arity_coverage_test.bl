(ns system.arity-coverage-test (:require [system.arity :as ar]))

(deftest malformed-input-is-an-error-even-when-editor-findings-are-empty
 (let [source "(ns broken) (defn unfinished ["
       result (ar/check-source source)]
  (is (= :error (:status result)))
  (is (= false (get-in result [:coverage :complete])))
  (is (= :arity-analysis-error (:kind (first (:diagnostics result)))))
  (is (empty? (ar/diagnostics source)))))

(deftest unresolved-and-local-callables-are-explicit-obligations
 (let [unknown (ar/check-source "(ns sample) (defn call-it [] (missing/operation 1))")
       local (ar/check-source "(ns sample) (defn keep [x] x) (defn call-it [] (keep 1))")]
  (is (= :unknown (:status unknown)) (pr-str unknown))
  (is (= false (get-in unknown [:coverage :complete])))
  (is (= :unresolved-callee (:reason (first (:obligations unknown)))))
  (is (= :unknown (:status local)))
  (is (= :local-signature (:reason (first (:obligations local)))))))

(deftest valid-and-invalid-resolved-signatures-have-distinct-verdicts
 (let [valid (ar/check-source "(ns sample) (defn f [x] (str x))")
       invalid (ar/check-source "(ns sample) (defn f [x] (keep x))")]
  (is (= :proved (:status valid)) (pr-str valid))
  (is (= true (get-in valid [:coverage :complete])))
  (is (= :refused (:status invalid)))
  (is (= 1 (get-in invalid [:coverage :refused])))
  (is (= :call-arity (:kind (first (:findings invalid)))))))

(deftest repeated-sites-share-resolution-without-losing-coverage
 (let [result (ar/check-source
               (str "(ns sample) (defn f [x] " (apply str (repeat 12 "(keep x) ")) ")"))]
  (is (= :refused (:status result)))
  (is (= 12 (get-in result [:coverage :refused])))
  (is (= (count (:obligations result)) (get-in result [:coverage :sites])))
  (is (= 12 (count (:findings result))))))

(deftest lexical-callables-cannot-borrow-a-core-signature
 (let [result (ar/check-source "(ns sample) (defn f [keep] (keep 1))")]
  (is (= :unknown (:status result)) (pr-str result))
  (is (= :lexical-callable (:reason (first (:obligations result)))))))
