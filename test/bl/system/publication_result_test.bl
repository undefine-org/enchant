(ns system.publication-result-test
 (:require [system.publication :as publication] [proc.message-domain :as domain] [env]))
(defn- fixture []
 (let [namespace (str "publication.result.p" (erlang/unique_integer (list :positive)))]
  (env/eval (str "(ns " namespace ") (defn identity-value [x] x)")) namespace))

(deftest actual-declarations-produce-a-qualified-read-with-no-admission
 (let [namespace (fixture) result (publication/snapshot-result namespace "identity-value")]
  (is (= :proved (:status result)))
  (is (= :published-definition-identity (:scope result)))
  (is (= false (:native-admission result)))
  (is (= (:snapshot result) (publication/snapshot namespace "identity-value")))
  (is (publication/valid? (:snapshot result)))))

(deftest unavailable-binding-and-invalid-request-are-distinct
 (let [result (publication/snapshot-result "publication.absent" "missing")]
  (is (= :unknown (:status result)))
  (is (= :unpublished-or-unbound-definition (:reason result)))
  (is (nil? (publication/snapshot "publication.absent" "missing"))))
 (let [result (publication/snapshot-result nil 42)]
  (is (= :error (:status result)))
  (is (= :invalid-publication-reference (:cause result)))
  (is (nil? (publication/snapshot nil 42)))))

(deftest an-identity-reader-failure-cannot-masquerade-as-an-unpublished-helper
 (let [namespace (fixture) name "identity-value"
       entries (BeamLisp.Env/ns_definition namespace name)
       first-entry (first entries)
       callback (BeamLisp.Env/fetch_exact! namespace name)
       environment (BeamLisp.Env/with_ns namespace #(BeamLisp.Env/capture_native_context!))
       altered (erlang/setelement 4 first-entry
                 (assoc (elem first-entry 3) :body {:op :unsupported-publication-expression}))]
  (try
   (BeamLisp.Env/put_ns_definition namespace name (list altered))
   (let [result (publication/snapshot-result namespace name)]
    (is (= :error (:status result)))
    (is (= :publication-analysis-error (:kind result)))
    (is (= :unknown-executable-operation (:cause result)))
    (is (nil? (publication/snapshot namespace name)))
    (is (= :message-publication-error (:reason (domain/capture callback environment)))))
   (finally (BeamLisp.Env/put_ns_definition namespace name entries)))
  (is (= :proved (:status (publication/snapshot-result namespace name))))))
