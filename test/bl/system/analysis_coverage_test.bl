(ns system.analysis-coverage-test
 (:require [system.analyze :as analyze] [system.incr :as incr] [system.footprint :as fp]))

(def flow-source "(defn identity [x] x) (defn entry [] (identity identity))")

(deftest reaching-the-flow-cap-is-not-a-complete-analysis
 (let [program (analyze/prepare-program flow-source {:flow-limit 0})
       result (analyze/analyze-prepared program {} (set (keys (:bodies program))))]
  (is (= false (:flow-complete? program)))
  (is (= 1 (:flow-rounds program)))
  (is (= false (get-in result [:coverage :complete])))
  (is (some? (:summaries result)))))

(deftest converged-analysis-reports-definition-and-top-level-coverage
 (let [program (analyze/prepare-program flow-source)
       result (analyze/analyze-prepared program {} (set (keys (:bodies program))))]
  (is (= true (:flow-complete? program)))
  (is (= 2 (get-in result [:coverage :definitions])))
  (is (= [] (get-in result [:coverage :missing])))
  (is (= true (get-in result [:coverage :complete])))
  (is (= true (:converged? result)))))

(deftest invalid-top-level-source-cannot-vacuously-earn-coverage
 (let [program (analyze/prepare-program "(defn good [] 1) (recur 1)")]
  (is (= false (get-in program [:coverage :top-level-complete])))
  (is (= false (get-in program [:coverage :complete])))))

(deftest incremental-results-preserve-completeness-evidence
 (let [source "(defn leaf [] 1) (defn entry [] (leaf))"
       first (incr/analyze-program {} source)
       again (incr/analyze-program (:cache first) source)]
  (is (= true (get-in first [:coverage :complete])))
  (is (= (:coverage first) (:coverage again)))
  (is (= (:summaries first) (:summaries again)))
  (is (not (empty? (:hits again))))))
