(ns system.alpha-patterns-test
 (:require [system.tier :as tier] [compiler :as compiler] [anf :as a] [lower :as lower]))

(defn- expression [text]
 (compiler/compile-contextual (BeamLisp.Reader/read_one text) (compiler/new-env "user") {}))

(deftest real-compiler-functions-compare-through-renamed-parameter-patterns
 (let [a (expression "(fn [x] (erlang/+ x 2))") b (expression "(fn [renamed] (erlang/+ renamed 2))")
       fa (lower/eval-anf :Elixir.AlphaPatternA a) fb (lower/eval-anf :Elixir.AlphaPatternB b)]
  (is (= 42 (fa 40)))
  (is (= 42 (fb 40)))
  (is (tier/alpha= a b))
  (is (not (tier/alpha= a (expression "(fn [renamed] (erlang/+ renamed 3))"))))))

(deftest repeated-pattern-variables-and-clause-scopes-remain-distinct
 (let [function (fn [first second body]
                  (a/fnn (list (a/clause (list (a/pvar first) (a/pvar second)) nil (a/var body))))) ]
  (is (tier/alpha= (function "x" "x" "x") (function "a" "a" "a")))
  (is (not (tier/alpha= (function "x" "x" "x") (function "a" "b" "a"))))
  (is (not (tier/alpha= (function "x" "y" "x") (function "a" "b" "b"))))))
