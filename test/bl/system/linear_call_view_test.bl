(ns system.linear-call-view-test (:require [system.linear :as lin] [anf :as a]))

(deftest constructor-identity-uses-canonical-calls-and-real-native-targets
 (let [params ["self" "inner-fn"]
       args (a/cons-cell (a/var "self")
              (a/cons-cell (a/var "inner-fn")
                (a/cons-cell (a/var "inner-fn") a/enil)))
       expected [{:local "inner-fn" :placements 2}]]
  (doseq [namespace ["a" "anf"]]
   (is (= expected (lin/affine-violations params (a/invoke (a/global namespace "lett") args)))))
  (is (= expected (lin/affine-violations params
                    (a/remote :a :lett (list (a/var "self") (a/var "inner-fn") (a/var "inner-fn"))))))
  (is (empty? (lin/affine-violations params
                (a/remote :Elixir.BeamLisp.Ns.Rt :invoke (list (a/global "a" "lett") args)))))))

(deftest a-foreign-constructor-name-cannot-produce-a-vacuous-clean-report
 (let [source "(defn- f [x] (core/lett x))"]
  (is (thrown-with-msg? "system.linear" (lin/param-violations source)))
  (is (thrown-with-msg? "system.linear" (lin/check-compiler source)))))

(defn- duplicated-compiled-local [init]
 (a/lett "compiled" init
  (a/invoke (a/global "anf" "tup")
    (a/cons-cell (a/cons-cell (a/var "compiled")
                   (a/cons-cell (a/var "compiled") a/enil)) a/enil))))

(deftest canonical-producer-calls-classify-compiled-locals-before-placement-counting
 (let [expected [{:local "compiled" :placements 2}]]
  (doseq [name ["compile-node" "self-apply" "nest-lets"]]
   (is (= expected
          (lin/affine-violations []
           (duplicated-compiled-local (a/invoke (a/global "compiler" name) a/enil))))))
  (is (= expected
         (lin/affine-violations []
          (duplicated-compiled-local (a/remote :Elixir.BeamLisp.Ns.Compiler :compile-node (list))))))))

(deftest a-leaf-reference-is-not-a-recursively-compiled-child
 (is (empty? (lin/affine-violations []
               (duplicated-compiled-local (a/invoke (a/global "anf" "var") a/enil)))))
 (is (empty? (lin/affine-violations []
               (duplicated-compiled-local
                 (a/remote :Elixir.BeamLisp.Ns.Rt :invoke
                   (list (a/global "compiler" "compile-node") a/enil)))))))


(defn- place-child []
 (a/invoke (a/global "anf" "tup")
  (a/cons-cell (a/cons-cell (a/var "inner-fn") a/enil) a/enil)))

(deftest compiler-control-flow-and-emitted-control-flow-have-different-placement-rules
 (let [one (place-child)
       choice (a/iff (a/lit true) one one)]
  (is (= {"inner-fn" 1} (lin/placements ["inner-fn"] choice)))
  (is (= {"inner-fn" 2} (lin/placements ["inner-fn"] (a/doo (list choice choice)))))
  (is (= {"inner-fn" 2} (lin/placements ["inner-fn"] (a/iff one one one))))
  ;; Both arguments of an emitted conditional are built by the compiler.
  ;; This is a constructor invocation, not compiler-source :if control flow.
  (is (= [{:local "inner-fn" :placements 2}]
       (lin/affine-violations ["inner-fn"]
        (a/invoke (a/global "anf" "iff")
         (a/cons-cell (a/lit true)
          (a/cons-cell (a/var "inner-fn")
           (a/cons-cell (a/var "inner-fn") a/enil)))))))))
