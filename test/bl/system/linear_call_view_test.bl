(ns system.linear-call-view-test (:require [system.linear :as lin] [anf :as a]))

(deftest constructor-identity-uses-canonical-calls-and-real-native-targets
 (let [params ["self" "inner-fn"]
       args (a/cons-cell (a/var "self")
              (a/cons-cell (a/var "inner-fn")
                (a/cons-cell (a/var "inner-fn") a/enil)))
       expected [{:local "inner-fn" :placements 2}]]
  (doseq [namespace ["a" "anf"]]
   (is (= expected (lin/affine-violations params (a/invoke (a/global namespace "lett") args)))))
  (is (= expected (lin/affine-violations params
                    (a/remote :a :lett (list (a/var "self") (a/var "inner-fn") (a/var "inner-fn"))))))
  (is (empty? (lin/affine-violations params
                (a/remote :Elixir.BeamLisp.Ns.Rt :invoke (list (a/global "a" "lett") args)))))))

(deftest a-foreign-constructor-name-cannot-produce-a-vacuous-clean-report
 (let [source "(defn- f [x] (core/lett x))"]
  (is (thrown-with-msg? "system.linear" (lin/param-violations source)))
  (is (thrown-with-msg? "system.linear" (lin/check-compiler source)))))
