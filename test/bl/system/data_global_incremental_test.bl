(ns system.data-global-incremental-test
  (:require [system.analyze :as an] [system.incr :as incr]))

(deftest global-value-changes-cannot-reuse-a-literal-purity-claim
  (let [literal "(def palette {:ready :green}) (defn label [key] (palette key))"
        callback "(def palette (fn [key] (println key))) (defn label [key] (palette key))"
        _ (incr/analyze-program {} literal)
        first (incr/analyze-program {} literal)
        second (incr/analyze-program (:cache first) callback)
        third (incr/analyze-program (:cache second) literal)]
    (is (:stable? first))
    (is (contains? (:footprint (get (:summaries first) "label")) :opaque-world))
    (is (contains? (:footprint (get (:summaries second) "label")) :opaque-world))
    (is (= (an/analyze callback) (:summaries second)))
    (is (= (an/analyze literal) (:summaries third)))
    (is (contains? (:footprint (get (:summaries third) "label")) :opaque-world))))
