(ns system.analysis-alias-context-test (:require [system.analyze :as an] [compiler :as c] [env]))

(deftest captured-source-aliases-do-not-depend-on-ambient-short-namespaces
 (let [scope (env/fork)
       source "(ns analysis.alias-input (:require [anf :as a] [compiler :as c]))
               (defn make-node [x] (a/lit x))
               (defn compiler-env [] (c/new-env \"analysis.probe\"))"]
  (try
   (env/with-env scope
    (fn []
     (let [before (BeamLisp.Env/capture)
           aliases [(BeamLisp.Env/alias_target "system.analyze.program" "a")
                    (BeamLisp.Env/alias_target "system.analyze.program" "c")]
           clean (c/with-fresh-names #(an/fn-bodies source))]
      (doseq [namespace ["a" "c"]]
       (BeamLisp.Env/declare_ns namespace)
       (BeamLisp.Env/intern namespace "sentinel" :ambient))
      (is (= clean (c/with-fresh-names #(an/fn-bodies source))))
      (is (= before (BeamLisp.Env/capture)))
      (is (= aliases [(BeamLisp.Env/alias_target "system.analyze.program" "a")
                     (BeamLisp.Env/alias_target "system.analyze.program" "c")]))
      (is (= :ambient (BeamLisp.Env/fetch_exact! "a" "sentinel"))))))
   (finally (env/destroy scope)))))
