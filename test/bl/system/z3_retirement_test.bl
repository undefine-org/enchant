(ns z3.retirement.test
 (:require [z3pool]))

(defn- replaced? [victim]
 (loop [n 0]
  (let [now (z3pool/solvers)]
   (cond
    (and (= 4 (count now)) (not (some #(= victim %) now))) true
    (>= n 200) false
    :else (do (Process/sleep 5) (recur (inc n)))))))

(deftest an-incomplete-real-solver-command-retires-the-pooled-owner
 ;; The real bundled solver accepts exit but cannot acknowledge the following
 ;; host marker. Exercise public leasing and the actual SDK actor/supervisor;
 ;; the Source-derived mutation control separately counts external effects.
 (let [victim (atom nil)]
  (try
   (is (= 4 (z3pool/pool!)))
   (let [failure (z3pool/with-solver
                  (fn []
                   (reset! victim (z3pool/current))
                   (try (z3pool/command "(exit)") :unexpected-reply
                    (catch-raw [kind reason stack] {:kind kind :reason reason}))))]
    (is (erlang/is_pid @victim))
    (is (= :exit (:kind failure)))
    (is (String/contains? (Kernel/inspect (:reason failure)) "Solver conversation retired")))
   (is (replaced? @victim))
   (is (= false (Process/alive? @victim)))
   (is (= 4 (count (z3pool/solvers))))
   (is (= "sat" (:status (z3pool/check "(assert true)\n" false))))
   (is (= 0 (z3pool/busy)) "the failed conversation released its lease")
   (finally (z3pool/pool-stop!)))))
