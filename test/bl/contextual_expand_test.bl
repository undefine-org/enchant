(ns contextual-expand-test
 (:require [expand :as x] [binding :as b] [lower :as lower]))

(defn- options [source]
 (let [selection {:version 1 :profile 'syntax-v1 :target 'beam-v1
                  :sources [{:namespace 'example :digest (crypto/hash :sha256 source)}]}
       world (b/world selection [] [])]
  {:selection (b/select [world] []) :world (:key world) :namespace 'example}))

(defn- result [source]
 (let [compiled (x/compile-expression source "contextual-expression.bl" (options source))
       module (erlang/binary_to_atom
                (str "Elixir.ContextualExpression." (erlang/unique_integer (list :positive))))]
  (tuple (lower/eval-anf module (:node compiled)) compiled)))

(defn- kind-of [action]
 (try (action) nil (catch error (:kind (ex-data error)))))

(deftest actual-reader-scopes-feed-the-existing-native-compiler
 (let [source "(let [x 40 f (fn [x] (erlang/+ x 2))] (erlang/+ (f 0) x))"
       r (result source) expanded (elem r 1)]
  (is (= 42 (elem r 0)))
  (is (= 3 (count (get-in expanded [:selection :introduced-declarations]))))
  (is (= (:selection expanded) (b/validate-selection (:selection expanded))))
  (is (= 2 (count (:native-obligations expanded))))
  (is (= 6 (count (:occurrences expanded))))))

(deftest sequential-bindings-loops-patterns-and-quoted-data
 (is (= 42 (elem (result "(let [x 20 x (erlang/+ x 1)] (erlang/* x 2))") 0)))
 (is (= 42 (elem (result "(loop [x 0] (if (erlang/< x 42) (recur (erlang/+ x 1)) x))") 0)))
 (is (= 42 (elem (result "(let [[x y] [40 2]] (erlang/+ x y))") 0)))
 (is (= 'untouched (elem (result "'untouched") 0))))

(deftest no-ambient-fallback-or-unchecked-source
 (is (= :unbound-identifier (kind-of #(result "(let [x missing] x)"))))
 (is (= :expansion-source-mismatch
        (kind-of #(x/expression "42" "example.bl" (options "43"))))))

(deftest expansion-fingerprints-do-not-feed-back-into-binding-identity
 (let [source "(let [x 42] x)" a (x/expression source "a.bl" (options source))
       z (x/expression source "z.bl" (options source))]
  (is (= (:selection a) (:selection z)))
  (is (= (keys (:references a)) (keys (:references z))))
  ;; Reader positions are relative to the source; display paths are not identity.
  (is (= (:occurrences a) (:occurrences z)))))
