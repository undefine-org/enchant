(ns execution.history.qualification-causal-test)

(defn- control [name]
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       driver (Path/join root "test/scripts/execution-qualification-driver.py")
       file "test/scripts/test_history_qualification_causal.py"
       selected [(str "QualificationCausal." name)]
       [output status] (System/cmd "python3" (to-list (concat [driver file] selected))
                         (list (tuple :cd root) (tuple :stderr_to_stdout true)))
       rows (filterv #(String/starts_with? % "BL-HISTORY-UNITTEST ") (String/split output "\n"))]
  (when-not (and (= 0 status) (= 1 (count rows)))
   (throw (ex-info (str "Qualification causal control failed: " name "\n" (String/slice output 0 16000))
                   {:status status :name name})))
  (let [report (Jason/decode! (String/replace_prefix (first rows) "BL-HISTORY-UNITTEST " "")
                             (list (tuple :keys :atoms)))]
   (is (= selected (:selected report) (:passed report)))
   (is (= 1 (:tests_run report)))
   (is (:complete report)))))

(deftest E11-current-cache-restore-cannot-overwrite-fresh-native-product
 (control "test_E11_actual_restore_policy_cannot_overwrite_new_native"))

(deftest E52-current-quick-full-slots-and-archive-directory-boundaries
 (control "test_E52_actual_concurrency_and_archive_directory_mutations"))

(deftest E82-current-resume-identity-rejects-four-drift-variants
 (control "test_E82_actual_identity_filter_rejects_changed_candidate_and_inputs"))

(deftest E83-dispatch-uses-merge-base-and-keeps-new-private-blob-refusal
 (control "test_E83_dispatch_shell_uses_real_merge_base_and_keeps_new_blob_guard"))

(deftest E83-normal-launchers-delegate-nix-worker-policy-to-host
 (control "test_E83_actual_preparation_forwards_host_nix_policy"))

(deftest E84-other-platforms-wait-for-complete-reused-linux-inventory
 (control "test_E84_actual_release_waits_for_complete_reused_linux_inventory"))
