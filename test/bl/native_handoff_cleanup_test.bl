(ns native-handoff-cleanup-test)

(deftest sender-death-before-target-publication-reclaims-native-pending-custody
 ;; Run in its own focused file so prior asynchronous owner cleanups cannot
 ;; hide an extra row. The receiver remains alive and never learns the target.
 (let [warmup (BeamLisp.Execution/register! (fn [] nil))
       _ (BeamLisp.Execution/close! warmup)
       baseline (ets/info :beam_lisp_source_lease_domains :size)
       parent (erlang/self)
       sender (spawn (fn []
                (let [source (BeamLisp.Execution/register! (fn [] 42))]
                 (BeamLisp.Execution/prepare-handoff! source parent)
                 (erlang/send parent :native-preparation-complete)
                 (receive :stop nil (after 10000 nil)))))
       monitor (Process/monitor sender)]
  (try
   (receive :native-preparation-complete true (after 10000 (throw :missing-preparation)))
   (is (>= (ets/info :beam_lisp_source_lease_domains :size) (+ baseline 2)))
   (erlang/send sender :stop)
   (is (receive [:DOWN ref :process pid _] :when (and (= ref monitor) (= pid sender)) true (after 10000 false)))
   (let [deadline (+ (erlang/monotonic_time :millisecond) 5000)]
    (is (loop []
         (cond
          (= (ets/info :beam_lisp_source_lease_domains :size) baseline) true
          (> (erlang/monotonic_time :millisecond) deadline) false
          :else (do (Process/sleep 5) (recur))))))
   (finally (erlang/send sender :stop) (Process/demonitor monitor (list :flush))))))
