(ns bl.test-discovery-test (:require [bl.test :as suite]))

(deftest default-discovery-keeps-both-namespace-spellings-and-literate-tests
  (let [root (str "/tmp/bl-test-discovery-" (erlang/unique_integer (list :positive)))
        conventional ["alpha-test.bl" "beta_test.bl" "gamma-test.bl.md" "delta_test.bl.org"]
        fixtures ["fixture.bl" "helper.bl.md" "story.bl.org" "contest.bl"]]
    (try
      (File/mkdir_p! (str root "/test/nested"))
      (doseq [file (concat conventional fixtures)] (File/write! (str root "/test/" file) ""))
      (File/write! (str root "/test/nested/epsilon-test.bl") "")
      (BeamLisp/with_cwd root
        (fn []
          (let [found (set (map #(Path/relative_to % root) (suite/files [])))]
            (is (= (set (conj (mapv #(str "test/" %) conventional) "test/nested/epsilon-test.bl")) found))
            (is (= 5 (count found)))
            (is (not (contains? found "test/fixture.bl")))
            (is (= [(str root "/test/fixture.bl")] (vec (suite/files ["test/fixture.bl"])))))))
      (finally (File/rm_rf! root)))))
