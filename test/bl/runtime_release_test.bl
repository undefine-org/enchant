(ns runtime-release-test (:require [release :as release]))

(deftest runtime-release-rejects-invalid-selection-before-filesystem-effects
 (let [out (Path/join (System/tmp_dir!) (str "runtime-release-invalid-" (erlang/unique_integer (list :positive))))]
  (doseq [[programs entry] [[{} 'main] [{'main "unused"} 'missing]
                            [{"main" "unused"} "main"] [{'bad/name "unused"} 'bad/name]]]
   (is (contains? #{:runtime-release-name :runtime-release-programs}
         (try (release/assemble-runtime! programs entry out) :unexpected
          (catch error (:kind (ex-data error))))))
   (is (not (File/exists? out))))))

(deftest runtime-release-preserves-existing-and-dangling-outputs
 (let [root (Path/join (System/tmp_dir!) (str "runtime-release-existing-" (erlang/unique_integer (list :positive))))
       out (Path/join root "image") link (Path/join root "link")]
  (File/mkdir_p! out)
  (File/write! (Path/join out "keep") "existing product")
  (File/ln_s! (Path/join root "absent") link)
  (try
   (doseq [path [out link]]
    (is (= :runtime-release-output-exists
          (try (release/assemble-runtime! "unused" path) :unexpected
           (catch error (:kind (ex-data error)))))))
   (is (= "existing product" (File/read! (Path/join out "keep"))))
   (is (= :symlink (:type (File/lstat! link))))
   (finally (File/rm_rf! root)))))
