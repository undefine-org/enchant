(ns compiler-data-literal-test (:require [anf :as a] [lower :as lower]))
(defn- refused? [action] (try (action) false (catch _ true)))
(defn- unit [value]
 {:version 2 :kind :compiled-contextual-unit :initializers (list) :steps (list)
  :entry (a/lit value) :exports (list)})

(deftest compiler-tuples-are-passive-data-and-do-not-broaden-public-first-order-values
 (doseq [value [(tuple) (tuple 1 "schema" :record (list "payload"))
                {:descriptor [(tuple :exports (tuple :new 1))] :schema (tuple 1 'Packet)}]]
  (is (= value (BeamLisp.CompilerData/check_compiler_data! value)))
  (is (refused? #(BeamLisp.CompilerData/check_first_order! value))))
 (is (refused? #(BeamLisp.CompilerData/check_first_order! (tuple 1 2) {:native-tuples true})))
 (is (= 'Packet (BeamLisp.CompilerData/check_first_order! 'Packet))))

(deftest compiler-tuples-cannot-hide-resources-thunks-or-foreign-structs
 (let [effects (atom 0)
       bad [(fn [] (swap! effects inc)) (erlang/self) (erlang/make_ref)
            (lazy-seq (do (swap! effects inc) (list 42)))
            (maps/put :__struct__ :Elixir.ForgedCompilerValue {:value 42})]]
  (doseq [value bad]
   (let [hidden (tuple :class (tuple value))]
    (is (refused? #(BeamLisp.CompilerData/check_compiler_data! hidden)))
    (is (refused? #(BeamLisp.CompilerData/check_contextual_unit! (unit hidden))))
    (is (refused? #(a/contextual-unit-factory (unit hidden))))))
  (is (= 0 @effects))))

(deftest compiler-tuples-charge-the-same-node-byte-and-depth-budgets
 (doseq [[value options] [[(tuple 1 2 3) {:max-nodes 2}]
                          [(tuple "too-long") {:max-bytes 1}]
                          [(tuple (tuple (tuple 1))) {:max-depth 1}]]]
  (is (refused? #(BeamLisp.CompilerData/check_compiler_data! value options))))
 (is (= (tuple 1 2) (BeamLisp.CompilerData/check_compiler_data! (tuple 1 2)
                                    {:max-nodes 3 :max-bytes 64 :max-depth 1}))))

(deftest existing-unit-grammar-admits-closed-tuple-literals-without-running-them
 (let [value (tuple 1 "logical" "Packet" :record (list "payload")) recipe (unit value)]
  (is (= recipe (BeamLisp.CompilerData/check_contextual_unit! recipe)))
  (is (= recipe (a/validate-contextual-unit! recipe)))
  (let [instance (lower/eval-anf :Elixir.CompilerTupleLiteral (a/contextual-unit-factory recipe))]
   (is (= value ((:entry instance))))
   (is (= {} (:exports instance))))))

(deftest reader-decimal-literals-cross-the-same-passive-data-boundaries
 (let [value (BeamLisp.Decimal/parse! "1.50")
       reader (BeamLisp.Reader/read_one "1.50M")]
  (is (= value (BeamLisp.CompilerData/check_first_order! value)))
  (is (= value (BeamLisp.CompilerData/check_compiler_data! value)))
  (is (= reader (BeamLisp.CompilerData/check_reader_data! reader)))
  (is (= value (BeamLisp.Compiler/eval_string "1.50M")))
  (is (= value (BeamLisp.Compiler/eval_string "(let [x 1.50M] x)")))
  (is (= [value] (BeamLisp.Compiler/eval_string "'[1.50M]")))
  (let [instance (lower/eval-anf :Elixir.CompilerDecimalLiteral
                    (a/contextual-unit-factory (unit value)))]
   (is (= value ((:entry instance)))))))

(deftest decimal-shaped-runtime-values-cannot-smuggle-fields-or-resources
 (let [value (BeamLisp.Decimal/parse! "1.50") effects (atom 0)]
  (doseq [bad [(maps/remove :scale value) (maps/put :extra :hidden value)
              (maps/put :scale -1 value) (maps/put :scale 1.5 value)
              (maps/put :unscaled (fn [] (swap! effects inc)) value)
              (maps/put :unscaled (lazy-seq (swap! effects inc) (list 1)) value)
              (maps/put :unscaled 1.5 value) (maps/put :scale (erlang/make_ref) value)
              (maps/put :__struct__ :Elixir.Fake.Decimal {:unscaled 150 :scale 2})]]
   (is (refused? #(BeamLisp.CompilerData/check_first_order! bad)))
   (is (refused? #(BeamLisp.CompilerData/check_compiler_data! bad))))
  (is (= 0 @effects))
  (doseq [[data limits] [[value {:max-nodes 2}] [value {:max-bytes 1}]
                        [{:nested value} {:max-depth 1}]
                        [(maps/put :unscaled (erlang/bsl 1 4096) value) {:max-bytes 32}]]]
   (is (refused? #(BeamLisp.CompilerData/check_first_order! data limits))))))

(deftest legacy-vector-layout-has-no-extra-field-or-storage-bypass
 (let [value (maps/remove :meta [42]) effects (atom 0)]
  (is (= value (BeamLisp.CompilerData/check_first_order! value)))
  (is (= value (BeamLisp.CompilerData/check_compiler_data! value)))
  (doseq [bad [(maps/put :items (fn [] (swap! effects inc)) value)
              (maps/put :extra :hidden value) (maps/put :items (list 42) value)]]
   (is (refused? #(BeamLisp.CompilerData/check_first_order! bad))))
  (is (= 0 @effects))))
