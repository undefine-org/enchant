(ns native-execution-frame-attestation-test (:require [reload.generation :as generation]))

(deftest frozen-native-frames-do-not-revalidate-sdk-preparation-on-every-invocation
 ;; Run alone: the VM's actual call counter observes the protected SDK MFA,
 ;; without replacing an implementation or fabricating an admission receipt.
 (let [g (generation/prepare!
           {:application-id "frame-attestation-cost"
            :sources {"frame.attestation" "(ns frame.attestation) (defn callback [] (fn [] 42))"}})
       registration (generation/with! g #(BeamLisp.Execution/register!
                       (generation/invoke! g "frame.attestation/callback" [])))
       mfa (BeamLisp.Env/source_policy_row :source_prepared_identity)]
  (try
   (is (= 1 (erlang/trace_pattern mfa true (list :call_count))))
   (is (= {:status :completed :value 42} (BeamLisp.Execution/invoke! registration [])))
   (is (= 0 (elem (erlang/trace_info mfa :call_count) 1)))
   (erlang/trace_pattern mfa :restart (list :call_count))
   (is (= 42 (generation/with! g (fn [] 42))))
   ;; Fresh root admission still authenticates the original SDK preparation.
   (is (> (elem (erlang/trace_info mfa :call_count) 1) 0))
   (finally
    (erlang/trace_pattern mfa false (list :call_count))
    (BeamLisp.Execution/close! registration) (generation/retire! g)))))
