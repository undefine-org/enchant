(ns contextual-boot-isolation-test (:require [anf :as anf]))

(defn- nodes [node]
 (cons node (Enum/flat_map (anf/executable-children node) (fn [child] (nodes child)))))

(deftest contextual-boot-callbacks-do-not-read-mutable-source-function-values
 (let [names #{"syntax" "binding" "expand-source" "expand"}
       selected (Map/new (Enum/map (Enum/sort names)
                  (fn [namespace]
                   (let [module (BeamLisp.Emit/module_for namespace)]
                    (Code/ensure_loaded? module)
                    (tuple namespace (erlang/apply module :__bl_ns_defs__ (list)))))))
       violations
       (Enum/flat_map (Enum/sort names)
        (fn [namespace]
         (let [module (BeamLisp.Emit/module_for namespace)
               _ (Code/ensure_loaded? module)
               definitions (Map/fetch! selected namespace)]
          (Enum/flat_map (Map/to_list definitions)
           (fn [definition]
            (Enum/flat_map (elem definition 1)
             (fn [entry]
              (Enum/map
               (Enum/filter (Enum/concat (nodes (:body (elem entry 3)))
                              (if (some? (:guard (elem entry 3))) (nodes (:guard (elem entry 3))) (list)))
                #(and (= :global (:op %)) (contains? names (:ns %))
                       (Map/has_key? (Map/get selected (:ns %)) (:name %))))
               (fn [node] [namespace (elem definition 0) (:ns node) (:name node)])))))))))]
  (is (= (list) violations))))
