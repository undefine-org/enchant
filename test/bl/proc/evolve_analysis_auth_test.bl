(ns proc.evolve-analysis-auth-test
 (:require [proc.evolve :as ev] [reload.generation :as g]
           [test.support.evolve-reply-fixtures :as f]))
(defn- queued? [owner]
 (let [deadline (+ (System/monotonic_time :millisecond) 5000)]
  (loop []
   (if (Enum/any? (elem (Process/info owner :messages) 1)
         (fn [m] (and (tuple? m) (= 3 (erlang/tuple_size m)) (= :"$gen_call" (elem m 0))
                       (= :proc.evolve/automatic-prepare (first (elem m 2)))))) true
    (if (< (System/monotonic_time :millisecond) deadline)
     (do (Process/sleep 10) (recur)) false)))))
(defn- job-info [owner]
 ;; Native fixture observation only. The function returns the original state
 ;; unchanged and sends no Fn, context, owner value or private cell to the test.
 (let [parent (erlang/self) token (erlang/make_ref)]
  (erlang/apply :sys :replace_state
   (list owner (fn [st]
    (let [job (:analysis st) guardian (when job (erlang/map_get :pid (:task job)))]
     (erlang/send parent
      (tuple token (when job
       {:guardian guardian
        :ref (erlang/map_get :ref (:task job)) :grant (:grant job)
        :ready? (some? @(:cell job))
        :held (vec (remove nil? (map #(get (:held job) %)
                            [:handler :accept? :upcast :check-reply :downcast :migrate-state :check-state])))}))))
    st)))
  (receive [seen value] :when (= token seen) value (after 5000 (throw :owner-observation-missing)))))
(defn- analysis-entry []
 ;; Attest the actual SDK entry once. Call events contain its arity only; no
 ;; captured registrations, private cell or Source metadata enter the trace.
 (let [entry (BeamLisp.Env/sdk_callable! "proc.evolve" "warm-analysis!" 2)]
  (tuple (elem (erlang/fun_info entry :module) 1)
         (elem (erlang/fun_info entry :name) 1) 2)))
(defn- stop-entry-trace! [mfa pids]
 (erlang/trace_pattern mfa false (list :local))
 (doseq [pid pids]
  (when (and pid (Process/alive? pid))
   (erlang/trace pid false (list :call :arity :set_on_spawn)))))
(defn- eventually [predicate]
 (let [deadline (+ (System/monotonic_time :millisecond) 5000)]
  (loop []
   (if (predicate) true
    (if (< (System/monotonic_time :millisecond) deadline)
     (do (Process/sleep 10) (recur)) false)))))
(defn- grant-released? [grant]
 (try (not (:native-custody (BeamLisp.Env/owner_transition_observation grant))) (catch _ true)))
(defn- registrations-closed? [job]
 (every? #(not= :active (:status (BeamLisp.Execution/observe %))) (:held job)))
(defn- with-paused-analysis
 ([name action] (with-paused-analysis name nil action))
 ([name before-resume action]
 (f/with-owner name [:old-request :new-request]
  (fn [[_ fresh] owner]
   (let [parent (erlang/self) token (erlang/make_ref) worker (atom nil)
         spec (f/spec fresh 2) publisher (atom nil)
         entry (analysis-entry) module (elem entry 0) function (elem entry 1)
         traced (atom [owner])]
    ;; Cold SDK dependency preparation belongs before the controlled owner
    ;; pause. This reads verified metadata and grants no candidate custody.
    (erlang/apply (BeamLisp.Env/sdk_callable! "reload.sdk-readiness" "prepare!" 1)
      (list [[:binding "proc.message-domain" "capture-current!"]
             [:binding "proc.message-domain" "cached-capture-current?"]]))
    (erlang/apply :sys :suspend (list owner))
    (try
     (when-not (= 1 (erlang/trace_pattern entry true (list :local)))
      (throw :actual-analysis-entry-unavailable))
     (erlang/trace owner true (list :call :arity :set_on_spawn (tuple :tracer parent)))
     (reset! publisher
      (spawn-monitor
       (fn []
        (g/with! fresh
         (fn []
          (let [prepared (ev/prepare-upgrade! owner 1 spec)]
           (erlang/send parent [:auth-prepared token prepared])
           (when (= :prepared (:status prepared))
            (receive [:auth-commit seen] :when (= token seen)
             (erlang/send parent [:auth-committed token (ev/commit-upgrade! owner (:ticket prepared))])
             (after 30000 :parent-stopped-waiting)))))))))
     (when-not (queued? owner)
      (let [reply (receive [:auth-prepared seen result] :when (= token seen)
                    (select-keys result [:status :kind]) (after 0 :pending))]
       (throw (ex-info "Public preparation was not queued"
                {:kind :public-preparation-not-queued :reply reply
                 :publisher-stack (Process/info (first @publisher) :current_stacktrace)}))))
     ;; The actual public bundle/grant already retains candidate code. The owner
     ;; has not consumed it, and no metadata child can hold a lock yet.
     (when before-resume (before-resume fresh))
     (erlang/apply :sys :resume (list owner))
     ;; The arity-only trace identifies the actual metadata child; delivery is
     ;; asynchronous, so a call event alone does not prove its current location.
     (let [child (receive [:trace pid :call [m f a]]
                  :when (and (= module m) (= function f) (= 2 a)) pid
                  (after 10000
                   (let [job (job-info owner) guardian (:guardian job)
                         links (when (and guardian (Process/alive? guardian)) (Process/info guardian :links))]
                    (throw (ex-info "Actual metadata entry was not observed"
                      {:kind :actual-metadata-entry-missing :pending? (some? job)
                       :guardian-live? (boolean links) :ready? (boolean (:ready? job))
                       :link-count (if (tuple? links) (erlang/length (elem links 1)) 0)})))))]
      (reset! worker child)
      (when-not (erlang/suspend_process child) (throw :actual-worker-not-suspended))
      (let [paused-at (System/monotonic_time :millisecond)
            observed (job-info owner) guardian (:guardian observed)
            links (when guardian (Process/info guardian :links))
            linked? (and (tuple? links) (lists/member child (elem links 1)))
            job (assoc observed :worker child :paused-at paused-at)]
       (reset! traced [owner guardian child])
       (stop-entry-trace! entry @traced)
       (when-not (and observed linked? (not (:ready? observed)))
        (throw (ex-info "Actual pending metadata boundary was missed"
                 {:kind :actual-pending-metadata-boundary-missing
                  :pending? (some? observed) :linked? (boolean linked?)
                  :link-count (if (tuple? links) (erlang/length (elem links 1)) 0)
                  :ready? (boolean (:ready? observed))})))
      (action owner fresh (first @publisher) (second @publisher) token job)))
     (finally
      (stop-entry-trace! entry @traced)
      (try (erlang/apply :sys :resume (list owner)) (catch _ nil))
      (when (and @worker (Process/alive? @worker))
       (try (erlang/resume_process @worker) (catch _ nil))
       (Process/exit @worker :kill))
      (when @publisher
       (when (Process/alive? (first @publisher)) (Process/exit (first @publisher) :kill))
       (let [monitor (second @publisher)]
        (receive [:DOWN seen :process _ _] :when (= seen monitor) nil (after 0 nil)))))))))))

(deftest forged-task-wakeups-cannot-publish-and-real-pending-custody-survives-retirement
 ;; Authenticate the Source refusal before starting the real public preparation
 ;; deadline. A source compiler check must not consume a paused worker's window.
 (let [prepared (atom nil)
       refused (try
         (reset! prepared (g/prepare! {:application-id "analysis-forbidden-sys" :fixed-runtime true
                           :native-modules #{"sys"}
                           :sources {"analysis.forbidden" "(ns analysis.forbidden) (defn state [pid] (sys/get_state pid))"}}))
         nil (catch error (select-keys (ex-data error) [:kind :symbol]))
         (finally (when @prepared (g/retire! @prepared))))]
  ;; check-expanded-source! rejects this exact reflective Source spelling;
  ;; the Native target declaration below independently denies the same MFA.
  (is (= {:kind :unmanaged-compiled-producer :symbol "sys/get_state"} refused)))
 (with-paused-analysis "analysis-authentic-pending"
  (fn [fresh]
   ;; This genuine Native boundary closes the queued call's exact candidate
   ;; admissions while its original public bundle prevents physical purge.
   (is (= false (BeamLisp.Env/retire_generation_modules! fresh)))
   (let [parent (erlang/self) nonce (erlang/make_ref)
         probe (erlang/spawn_monitor (fn []
           (erlang/send parent
            (tuple nonce
             {:already-admitted? (BeamLisp.Env/executing_generation? fresh)
              :refused? (try (g/with! fresh (fn [] :fresh-admission)) false (catch _ true))}))))
         monitor (elem probe 1)]
    (try
     (let [result (receive [seen result] :when (= seen nonce) result (after 5000 nil))]
      (is (= false (:already-admitted? result)))
      (is (= true (:refused? result))))
     (finally
      (when (Process/alive? (elem probe 0)) (Process/exit (elem probe 0) :kill))
      (Process/demonitor monitor (list :flush))))))
  (fn [owner _ publisher monitor token job]
   (println "AUTH_PAUSED_MFA"
    (pr-str (Enum/map (elem (Process/info (:worker job) :current_stacktrace) 1)
      (fn [frame] (tuple (elem frame 0) (elem frame 1)
                         (if (erlang/is_integer (elem frame 2)) (elem frame 2) :arity-redacted))))))
   (println "AUTH_PAUSED_PHASE" :observed (- (System/monotonic_time :millisecond) (:paused-at job)))
   (is (= :pending (:phase (BeamLisp.Env/owner_transition_observation (:grant job)))))
   (is (:native-custody (BeamLisp.Env/owner_transition_observation (:grant job))))
   (erlang/send owner (tuple (:ref job) :proc.evolve/analyzed))
   (erlang/send owner (tuple (:ref job) {:status :ready :proof :forged}))
   (erlang/send owner (tuple :DOWN (:ref job) :process (:guardian job) :forged))
   (let [status (ev/status owner) pending (job-info owner)]
    (is (= 1 (:version status)))
    (is (= false (:prepared? status)))
    (is (= false (:ready? pending)))
    (is (Process/alive? (:worker job))))
   ;; Source cannot inspect this private slot through the framework's native
   ;; system interface. Explicitly declaring sys does not grant that target.
   (is (= :refuse (BeamLisp.Env/source_target_declaration! :sys :get_state 1)))
   (is (= true (ev/request! owner 1 :write)))
   (println "AUTH_PAUSED_PHASE" :after-old-write (- (System/monotonic_time :millisecond) (:paused-at job)))
   (is (= :pending (:phase (BeamLisp.Env/owner_transition_observation (:grant job)))))
   (println "AUTH_PAUSED_PHASE" :resuming (- (System/monotonic_time :millisecond) (:paused-at job)))
   (erlang/resume_process (:worker job))
   (let [prepared (receive [:auth-prepared seen result] :when (= token seen) result (after 35000 nil))]
    (println "AUTH_PAUSED_PHASE" :prepared (:status prepared) (- (System/monotonic_time :millisecond) (:paused-at job)))
    (is (= :prepared (:status prepared))))
   (erlang/send publisher [:auth-commit token])
   (is (= :applied (:status (receive [:auth-committed seen result] :when (= token seen) result (after 35000 nil)))))
   (is (= :normal (receive [:DOWN seen :process _ reason] :when (= monitor seen) reason (after 5000 :missing))))
   (is (= owner (:pid (ev/status owner))))
   (is (= {:value 1} (ev/request! owner 2 {:operation :read})))
   (is (= 1 (ev/request! owner 1 :read)))
   ;; A duplicate result for the genuinely completed task has no preparation.
   (erlang/send owner (tuple (:ref job) :proc.evolve/analyzed))
   (is (= false (:prepared? (ev/status owner)))))))

(deftest caller-and-worker-death-refuse-only-the-pending-analysis-and-preserve-the-old-owner
 (doseq [mode [:caller :worker :guardian]]
  (with-paused-analysis (str "analysis-death-" (name mode))
   (fn [owner _ publisher monitor token job]
    (Process/exit (case mode :caller publisher :worker (:worker job) :guardian (:guardian job)) :kill)
    (is (eventually #(and (nil? (job-info owner)) (not (Process/alive? (:worker job))) (not (Process/alive? (:guardian job)))
                          (registrations-closed? job) (grant-released? (:grant job)))))
    (is (= 1 (:version (ev/status owner))))
    (is (= false (:prepared? (ev/status owner))))
    (is (= 0 (ev/request! owner 1 :read)))
    (when (not= :caller mode)
     (let [reply (receive [:auth-prepared seen result] :when (= token seen) result (after 5000 nil))]
      (is (= :refused (:status reply)))
      (is (= (if (= :worker mode) :owner-analysis-failed :owner-analysis-cancelled) (:kind reply))))
     (is (= :normal (receive [:DOWN seen :process _ reason] :when (= monitor seen) reason (after 5000 :missing)))))))))

(deftest owner-death-releases-pending-registration-custody-and-the-read-only-worker
 (with-paused-analysis "analysis-owner-death"
  (fn [owner fresh _ _ _ job]
   (Process/exit owner :kill)
   (is (eventually #(and (not (Process/alive? (:worker job))) (not (Process/alive? (:guardian job)))
                        (registrations-closed? job) (grant-released? (:grant job)))))
   (is (eventually #(= :retired (:status (g/retire! fresh))))))))
