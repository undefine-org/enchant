(ns proc.evolve-analysis-auth-test
 (:require [proc.evolve :as ev] [proc.task :as task] [reload.generation :as g]
           [test.support.evolve-reply-fixtures :as f]))
(defn- queued? [owner]
 (loop [left 1000]
  (if (some (fn [m] (and (tuple? m) (= 3 (erlang/tuple_size m)) (= :"$gen_call" (elem m 0))
                         (= :proc.evolve/automatic-prepare (first (elem m 2)))))
            (elem (Process/info owner :messages) 1)) true
   (if (pos? left) (do (Process/sleep 1) (recur (dec left))) false))))
(defn- job-info [owner]
 ;; Native fixture observation only. The function returns the original state
 ;; unchanged and sends no Fn, context, owner value or private cell to the test.
 (let [parent (erlang/self) token (erlang/make_ref)]
  (erlang/apply :sys :replace_state
   (list owner (fn [st]
    (let [job (:analysis st) guardian (when job (task/pid (:task job)))
          links (when (and guardian (Process/alive? guardian)) (Process/info guardian :links))
          children (if (tuple? links) (remove #{owner} (elem links 1)) [])]
     (erlang/send parent
      (tuple token (when job
       {:guardian guardian :worker (when (= 1 (count children)) (first children))
        :ref (erlang/map_get :ref (:task job)) :grant (:grant job)
        :ready? (some? @(:cell job))
        :held (vec (remove nil? (map #(get (:held job) %)
                            [:handler :accept? :upcast :check-reply :downcast :migrate-state :check-state])))}))))
    st)))
  (receive [seen value] :when (= token seen) value (after 5000 (throw :owner-observation-missing)))))
(defn- await-metadata-child [owner]
 (loop [left 1000]
  (let [job (job-info owner)]
   (when-not job (throw :actual-pending-analysis-missing))
   (when (:ready? job) (throw :worker-finished-before-suspension))
   (if (:worker job) job
    (if (pos? left) (do (Process/sleep 1) (recur (dec left)))
     (throw :actual-linked-metadata-child-missing))))))
(defn- eventually [predicate]
 (loop [left 5000]
  (if (predicate) true
   (if (pos? left) (do (Process/sleep 1) (recur (dec left))) false))))
(defn- grant-released? [grant]
 (try (not (:native-custody (BeamLisp.Env/owner_transition_observation grant))) (catch _ true)))
(defn- registrations-closed? [job]
 (every? #(not= :active (:status (BeamLisp.Execution/observe %))) (:held job)))
(defn- with-paused-analysis [name action]
 (f/with-owner name [:old-request :new-request]
  (fn [[_ fresh] owner]
   (let [parent (erlang/self) token (erlang/make_ref) worker (atom nil)
         spec (f/spec fresh 2) publisher (atom nil)]
    (erlang/apply :sys :suspend (list owner))
    (try
     (reset! publisher
      (spawn-monitor
       (fn []
        (g/with! fresh
         (fn []
          (let [prepared (ev/prepare-upgrade! owner 1 spec)]
           (erlang/send parent [:auth-prepared token prepared])
           (when (= :prepared (:status prepared))
            (receive [:auth-commit seen] :when (= token seen)
             (erlang/send parent [:auth-committed token (ev/commit-upgrade! owner (:ticket prepared))])
             (after 30000 :parent-stopped-waiting)))))))))
     (when-not (queued? owner) (throw :public-preparation-not-queued))
     (erlang/apply :sys :resume (list owner))
     (let [job (await-metadata-child owner)]
      (reset! worker (:worker job))
      (when-not (erlang/suspend_process @worker) (throw :actual-worker-not-suspended))
      ;; A fixture that missed this boundary must fail, never count a completed
      ;; worker as evidence that an early/forged result was safely rejected.
      (when (:ready? (job-info owner)) (throw :worker-finished-before-suspension))
      (action owner fresh (first @publisher) (second @publisher) token job))
     (finally
      (try (erlang/apply :sys :resume (list owner)) (catch _ nil))
      (when (and @worker (Process/alive? @worker))
       (try (erlang/resume_process @worker) (catch _ nil))
       (Process/exit @worker :kill))
      (when @publisher
       (when (Process/alive? (first @publisher)) (Process/exit (first @publisher) :kill))
       (receive [:DOWN seen :process _ _] :when (= seen (second @publisher)) nil (after 0 nil)))))))))

(deftest forged-task-wakeups-cannot-publish-and-real-pending-custody-survives-retirement
 (with-paused-analysis "analysis-authentic-pending"
  (fn [owner fresh publisher monitor token job]
   (is (= :pending (:phase (BeamLisp.Env/owner_transition_observation (:grant job)))))
   (is (:native-custody (BeamLisp.Env/owner_transition_observation (:grant job))))
   (erlang/send owner (tuple (:ref job) :proc.evolve/analyzed))
   (erlang/send owner (tuple (:ref job) {:status :ready :proof :forged}))
   (erlang/send owner (tuple :DOWN (:ref job) :process (:guardian job) :forged))
   (let [status (ev/status owner) pending (job-info owner)]
    (is (= 1 (:version status)))
    (is (= false (:prepared? status)))
    (is (= false (:ready? pending)))
    (is (Process/alive? (:worker job))))
   ;; Source cannot inspect this private slot through the framework's native
   ;; system interface. Explicitly declaring sys does not grant that target.
   (is (= :refuse (BeamLisp.Env/source_target_declaration! :sys :get_state 1)))
   (is (= :dynamic-code-dependency
          (try (g/prepare! {:application-id "analysis-forbidden-sys" :native-modules #{"sys"}
                             :sources {"analysis.forbidden" "(ns analysis.forbidden) (defn state [pid] (sys/get_state pid))"}})
               nil (catch error (:kind (ex-data error))))))
   (is (= true (ev/request! owner 1 :write)))
   (is (= :waiting (:status (g/retire! fresh))))
   (is (thrown? (g/with! fresh (fn [] :fresh-admission))))
   (is (= :pending (:phase (BeamLisp.Env/owner_transition_observation (:grant job)))))
   (erlang/resume_process (:worker job))
   (let [prepared (receive [:auth-prepared seen result] :when (= token seen) result (after 35000 nil))]
    (is (= :prepared (:status prepared))))
   (erlang/send publisher [:auth-commit token])
   (is (= :applied (:status (receive [:auth-committed seen result] :when (= token seen) result (after 35000 nil)))))
   (is (= :normal (receive [:DOWN seen :process _ reason] :when (= monitor seen) reason (after 5000 :missing))))
   (is (= owner (:pid (ev/status owner))))
   (is (= {:value 1} (ev/request! owner 2 {:operation :read})))
   (is (= 1 (ev/request! owner 1 :read)))
   ;; A duplicate result for the genuinely completed task has no preparation.
   (erlang/send owner (tuple (:ref job) :proc.evolve/analyzed))
   (is (= false (:prepared? (ev/status owner)))))))

(deftest caller-and-worker-death-refuse-only-the-pending-analysis-and-preserve-the-old-owner
 (doseq [mode [:caller :worker :guardian]]
  (with-paused-analysis (str "analysis-death-" (name mode))
   (fn [owner _ publisher monitor token job]
    (Process/exit (case mode :caller publisher :worker (:worker job) :guardian (:guardian job)) :kill)
    (is (eventually #(and (nil? (job-info owner)) (not (Process/alive? (:worker job))) (not (Process/alive? (:guardian job)))
                          (registrations-closed? job) (grant-released? (:grant job)))))
    (is (= 1 (:version (ev/status owner))))
    (is (= false (:prepared? (ev/status owner))))
    (is (= 0 (ev/request! owner 1 :read)))
    (when (not= :caller mode)
     (let [reply (receive [:auth-prepared seen result] :when (= token seen) result (after 5000 nil))]
      (is (= :refused (:status reply)))
      (is (= (if (= :worker mode) :owner-analysis-failed :owner-analysis-cancelled) (:kind reply))))
     (is (= :normal (receive [:DOWN seen :process _ reason] :when (= monitor seen) reason (after 5000 :missing)))))))))

(deftest owner-death-releases-pending-registration-custody-and-the-read-only-worker
 (with-paused-analysis "analysis-owner-death"
  (fn [owner fresh _ _ _ job]
   (Process/exit owner :kill)
   (is (eventually #(and (not (Process/alive? (:worker job))) (not (Process/alive? (:guardian job)))
                        (registrations-closed? job) (grant-released? (:grant job)))))
   (is (eventually #(= :retired (:status (g/retire! fresh))))))))
