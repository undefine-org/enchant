(ns proc.evolve-request-contract-test
 (:require [proc.evolve :as ev] [test.support.evolve-fixtures :as f]
           [test.support.workflow :as workflow]))

(defn- source [mode]
 (let [vector? (= :vector mode)
       map? (contains? #{:map-from-vector :map-from-integer :map-identity} mode)
       reply? (= :unproved-reply mode)
       accepts (cond vector? "(and (vector? message) (= 2 (count message)) (= :add (first message)) (int? (second message)))"
                     map? "(and (erlang/is_map message) (erlang/is_integer (maps/get :amount message nil)))"
                     (= :nonnegative mode) "(and (erlang/is_integer message) (erlang/>= message 0))"
                     :else "(erlang/is_integer message)")
       upcast (case mode :map-from-vector "{:amount (second message)}"
                          :map-from-integer "{:amount message}" "message")]
  (str "(ns evolution.fixture)
        (defn accepts [message] " accepts ")
        (defn valid [value] (erlang/is_integer value))
        (defn unchanged [value] value)
        (defn migrate [value] value)
        (defn upcast [message] " upcast ")
        (defn reply-conversion [value] " (if reply? "(do (Process/put :unproved-reply-effect true) value)" "value") ")
        (defn handler [message state]
         (let [next (+ state " (cond vector? "(second message)" map? "(:amount message)" :else "message") ")]
          {:state next :reply next}))
        (defn spec [version digest]
         {:version version :digest digest :accept? accepts :check-state valid
          :handler handler :migrate-state migrate :upcast upcast"
          (if reply? " :check-reply valid :downcast reply-conversion" "") "})")))
(defn- upgrade! [graph pid expected version]
 (f/in! graph #(ev/upgrade! pid expected (f/spec graph version))))

(deftest admitted-candidate-still-cannot-upgrade-an-unmanaged-owner
 (f/with-owner "request-unmanaged-refusal" [(source :integer) (source :integer)] 0 {}
  (fn [[_ fresh] p]
   (let [candidate (f/spec fresh 2) before (ev/status p)]
    (f/with-counter (:handler candidate)
     (fn [calls]
      (is (= :owner-transition-authority-required (:kind (upgrade! fresh p 1 2))))
      (is (= before (ev/status p)))
      (is (= 0 (calls)))))
    (is (= 1 (ev/call! p 1 1)))))))

(deftest malformed-old-requests-refuse-without-unproved-vector-adoption-or-effects
 (f/with-owner "request-vector-refusal" [(source :vector) (source :map-from-vector)] 0 {:managed true}
  (fn [[old fresh] p]
   (let [client (:token (ev/acquire-client! p 1)) candidate (f/spec fresh 2)]
    (try
     (f/with-counter (:handler (f/spec old 1))
      (fn [calls]
       (f/with-counter (:upcast candidate)
        (fn [conversions]
         (let [before (ev/status p)]
          ;; This owner began with the unrestricted message contract.
          ;; Vector traversal has no canonical-data premise in that contract. A genuine candidate still cannot publish an unproved edge.
          (is (= :unproved-message-migration (:kind (upgrade! fresh p 1 2))))
          (doseq [message [[:add 4 :extra] [:other 4] [:add "4"]]]
           (is (= :invalid-message (:kind (ev/request! p 1 message))))
           (is (= :invalid-message (:kind (ev/call-client! p client message)))))
          (is (= before (ev/status p)))
          (is (= 0 (calls)))
          (is (= 0 (conversions))))
         (is (= 4 (ev/request! p 1 [:add 4])))
         (is (= 1 (calls)))
         (is (= 0 (conversions)))
         (is (= 1 (:version (ev/status p))))))))
     (finally (ev/release-client! p client)))))))

(deftest reply-contracts-require-their-own-future-input-proof-before-conversion
 (f/with-owner "request-reply-refusal" [(source :unproved-reply) (source :unproved-reply)] 0 {:managed true}
  (fn [[_ fresh] p]
   (let [candidate (f/spec fresh 2) before (ev/status p)]
    (f/with-counter (:downcast candidate)
     (fn [conversions]
      (f/with-counter (:handler candidate)
       (fn [calls]
        (is (= :unproved-reply-migration (:kind (upgrade! fresh p 1 2))))
        (is (= before (ev/status p)))
        (is (= 0 (calls)))
        (is (= 0 (conversions)))))))
    (is (= 2 (ev/request! p 1 2)))))))

(deftest tightening-an-intermediate-protocol-refuses-before-installing-any-adapter
 (f/with-owner "request-tightening-refusal" [(source :integer) (source :nonnegative) (source :integer)] 0 {:managed true}
  (fn [[_ fresh third] p]
   (let [candidate (f/spec fresh 2) before (ev/status p)]
    (f/with-counter (:upcast candidate)
     (fn [conversions]
      (f/with-counter (:handler candidate)
       (fn [calls]
        ;; Every integer was accepted by v1. Identity cannot establish that all
        ;; old inputs satisfy v2's nonnegative predicate, even if v3 is looser.
        (is (= :unproved-message-migration (:kind (upgrade! fresh p 1 2))))
        (is (= before (ev/status p)))
        (is (= :stale-version (:kind (upgrade! third p 2 3))))
        (is (= [] (:legacy-versions (ev/status p))))
        (is (= 0 (conversions)))
        (is (= 0 (calls)))))))
    (is (= -1 (ev/request! p 1 -1)))))))

(deftest compatible-multi-hop-conversion-checks-original-and-intermediate-protocols
 (f/with-owner "request-compatible-chain"
   [(source :integer) (source :map-from-integer) (source :map-identity) (source :map-identity)] 0 {:managed true}
  (fn [[_ middle latest next] p]
   (let [first-spec (f/spec middle 2) last-spec (f/spec latest 3)]
    (f/with-counter (:upcast first-spec)
     (fn [first-edge]
      (f/with-counter (:upcast last-spec)
       (fn [last-edge]
        (f/with-counter (:handler last-spec)
         (fn [calls]
          (workflow/status! :applied (upgrade! middle p 1 2))
          (workflow/status! :applied (upgrade! latest p 2 3))
          (is (= 0 (first-edge))) (is (= 0 (last-edge))) (is (= 0 (calls)))
          (let [before (ev/status p)]
           (is (= :invalid-message (:kind (ev/request! p 1 "2"))))
           (is (= :invalid-message (:kind (ev/request! p 2 {:amount "2"}))))
           (is (= :candidate-refused
                  (:kind (f/in! next #(ev/prepare-upgrade! p 3 (f/spec next 4) [{:version 1 :message "invalid"}])))))
           (is (= before (ev/status p))))
          (is (= 0 (first-edge))) (is (= 0 (last-edge))) (is (= 0 (calls)))
          (is (= 2 (ev/request! p 1 2)))
          (is (= 1 (first-edge))) (is (= 1 (last-edge))) (is (= 1 (calls)))
          (is (= 3 (ev/request! p 2 {:amount 1})))
          (is (= 1 (first-edge))) (is (= 2 (last-edge))) (is (= 2 (calls)))
          (is (= 5 (ev/request! p 3 {:amount 2})))
          (is (= 3 (calls)))
          (is (= [1 2] (:legacy-versions (ev/status p))))))))))))))
