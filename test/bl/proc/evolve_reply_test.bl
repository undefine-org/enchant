(ns proc.evolve-reply-test
 (:require [proc.evolve :as ev] [proc.callback :as cb] [reload.generation :as g]
           [test.support.evolve-reply-fixtures :as f] [test.support.evolve-fixtures :as trace] [env]))
(defn first-spec []
 {:version 1 :digest "reply-runtime-unit" :accept? int? :check-state int? :check-reply int?
  :handler (fn [m s] {:reply m :state (+ m s)})})
(defn- adapt-reply [edges value]
 ((BeamLisp.Env/fetch_exact! "proc.evolve" "adapt-reply") edges value))

(deftest old-and-new-callers-keep-their-reply-contracts-through-multiple-upgrades
 (f/with-owner "reply-chain" [:integer :map :vector]
  (fn [[_ second third] p]
   (is (= 3 (ev/request! p 1 3)))
   (is (= :applied (:status (f/upgrade! second p 1 2))))
   (is (= 4 (ev/request! p 1 4)))
   (is (= {:value 5} (ev/request! p 2 5)))
   (is (= :applied (:status (f/upgrade! third p 2 3))))
   (is (= 6 (ev/request! p 1 6)))
   (is (= {:value 7} (ev/request! p 2 7)))
   (is (= [8] (ev/request! p 3 8)))
   (is (= [1 2] (:legacy-versions (ev/status p))))
   (is (:reply-contract? (ev/status p))))))

(deftest queued-old-requests-get-old-replies-after-fifo-publication
 (f/with-owner "reply-fifo" [:integer :map]
  (fn [[_ fresh] p]
   (let [parent (erlang/self) request (erlang/alias)
         prepared (g/with! fresh #(ev/prepare-upgrade! p 1 (f/spec fresh 2)))
         publisher (atom nil)]
    (try
     (is (= :prepared (:status prepared)))
     (erlang/apply :sys :suspend (list p))
     (reset! publisher (spawn-monitor #(erlang/send parent [:published
                        (g/with! fresh (fn [] (ev/commit-upgrade! p (:ticket prepared))))])))
     ;; Observe the genuine public wrapper's opaque control in the paused
     ;; mailbox, then queue old work behind it. No test creates native grants.
     (let [queued (loop [left 1000]
                    (let [messages (elem (Process/info p :messages) 1)]
                     (if (some #(and (tuple? %) (= 3 (erlang/tuple_size %))
                                     (= :"$gen_call" (elem % 0))
                                     (= :proc.evolve/automatic-commit (first (elem % 2)))) messages) true
                      (if (pos? left) (do (Process/sleep 1) (recur (dec left))) false))))]
      (is queued))
     (erlang/send p (tuple :"$gen_call" (tuple parent request) [:proc.evolve/request 1 6]))
     (erlang/apply :sys :resume (list p))
     (is (= :applied (:status (receive [:published r] r (after 5000 nil)))))
     (is (= 6 (receive [tag r] :when (= tag request) r (after 5000 nil))))
     (is (= p (:pid (ev/status p))))
     (finally
      (try (erlang/apply :sys :resume (list p)) (catch _ nil))
      (erlang/unalias request)
      (when @publisher
       (let [[pid monitor] @publisher]
        (receive [:DOWN ref :process seen _] :when (and (= monitor ref) (= pid seen)) true (after 5000 false))))))))))

(deftest retained-reply-checks-and-conversions-use-their-original-code-context
 ;; Unit-check the genuine registration/invocation adapter in real unbound
 ;; forked envs. Publication is independently proved with named Source above.
 (let [old (env/fork) fresh (env/fork) held (atom []) previous (env/current)]
  (try
   (let [old-check (env/with-env old #(cb/register! (fn [r] (and (= old (env/current)) (int? r)))))
         new-check (env/with-env fresh #(cb/register! (fn [r] (and (= fresh (env/current)) (map? r)))))
         downcast (env/with-env fresh #(cb/register! (fn [r] (if (= fresh (env/current)) (:value r) "wrong-context"))))]
    (reset! held [old-check new-check downcast])
    (is (= 4 (adapt-reply [{:downcast downcast :downcast-arity 1 :reply-check old-check :reply-arity 1 :request 4}] {:value 4})))
    (is (= true (cb/invoke! new-check [{:value 5}])))
    (is (= {:value 5} {:value (adapt-reply [{:downcast downcast :downcast-arity 1 :reply-check old-check :reply-arity 1 :request 5}] {:value 5})}))
    (is (= previous (env/current))))
   (finally (doseq [r @held] (cb/unregister! r)) (env/destroy fresh) (env/destroy old)))))

(deftest missing-reply-migration-is-refused-before-rehearsal-and-publication
 (f/with-owner "reply-missing" [:integer :missing-downcast]
  (fn [[_ fresh] p]
   (let [before (ev/status p) candidate (f/spec fresh 2)]
    (is (= :missing-reply-migration (:kind (g/with! fresh #(ev/rehearse! p 1 candidate)))))
    (is (= :missing-reply-migration (:kind (f/upgrade! fresh p 1 2))))
    (is (= before (ev/status p))))
   (is (= 2 (ev/request! p 1 2))))))

(deftest wrong-current-and-adapted-replies-never-escape-as-success
 (f/with-owner "reply-wrong" [:integer :wrong-downcast :map :bad-handler]
  (fn [[_ wrong fresh bad-handler] p]
   (let [before (ev/status p)]
    (is (= :unproved-reply-migration (:kind (f/upgrade! wrong p 1 2))))
    (is (= before (ev/status p))))
   (is (= 4 (ev/request! p 1 4)))
   (is (= :applied (:status (f/upgrade! fresh p 1 2))))
   (is (= {:value 2} (ev/request! p 2 2)))
   ;; Declared future reply shape is compatible. An actual bad handler result
   ;; is independently rejected at runtime without changing the owner state.
   (is (= :applied (:status (f/upgrade! bad-handler p 2 3))))
   (let [before (ev/status p)]
    (is (= :invalid-reply (:kind (ev/request! p 3 5))))
    (is (= :invalid-reply (:kind (ev/request! p 1 5))))
    (is (= before (ev/status p)))))))

(deftest reply-conversion-failure-is-distinct-and-keeps-the-owner-current
 (f/with-owner "reply-throw" [:integer :throw-downcast :map]
  (fn [[_ bad fresh] p]
   (let [before (ev/status p)
         check (cb/register! int?) downcast (cb/register! (fn [_] (throw (ex-info "private detail" {}))))]
    (try
     (is (= :unproved-reply-migration (:kind (f/upgrade! bad p 1 2))))
     (is (= :reply-migration-failed
            (try (adapt-reply [{:downcast downcast :downcast-arity 1 :reply-check check :reply-arity 1 :request 4}] {:value 4})
                 nil (catch error (:kind (ex-data error))))))
     (is (= before (ev/status p)))
     (finally (cb/unregister! downcast) (cb/unregister! check))))
   (is (= :applied (:status (f/upgrade! fresh p 1 2))))
   (is (= {:value 2} (ev/request! p 2 2))))))

(deftest reply-checks-and-conversions-remain-until-managed-clients-drain
 (f/with-owner "reply-drain" [:integer :map :vector]
  (fn [[_ second third] p]
   (let [token (:token (ev/acquire-client! p 1))]
    (is (= :applied (:status (f/upgrade! second p 1 2))))
    (is (= :applied (:status (f/upgrade! third p 2 3))))
    (is (= 6 (ev/call-client! p token 6)))
    (is (= :waiting (:status (ev/retire! p 3 2))))
    (is (= 7 (ev/call-client! p token 7)))
    (ev/release-client! p token)
    (is (= :retired (:status (ev/retire! p 3 2))))
    (is (= [] (:legacy-versions (ev/status p))))
    (is (= :unknown-client (:kind (ev/call-client! p token 1))))
    (let [current (:token (ev/acquire-client! p 3))]
     (is (= [8] (ev/call-client! p current 8)))
     (ev/release-client! p current))))))

(deftest invalid-reply-callbacks-refuse-during-spec-validation
 (doseq [[key f] [[:check-reply true] [:downcast (fn [_ _ _] nil)]]]
  (is (try (ev/start! (assoc (first-spec) key f) 0) false
        (catch e (= :invalid-evolution (:kind (ex-data e))))))))

(deftest absent-reply-options-can-be-explicit-nil
 (let [p (ev/start! (assoc (first-spec) :check-reply nil :downcast nil) 0)]
  (try
   (is (not (:reply-contract? (ev/status p))))
   (is (= 3 (ev/call! p 1 3)))
   (finally (GenServer/stop p)))))

(deftest reply-contracts-and-conversions-can-depend-on-the-original-request
 (f/with-owner "reply-request" [:old-request :new-request]
  (fn [[_ fresh] p]
   (is (= :applied (:status (f/upgrade! fresh p 1 2))))
   (is (= 0 (ev/request! p 1 :read)))
   (is (= true (ev/request! p 1 :save)))
   (is (= 1 (ev/request! p 1 :read)))
   (is (= {:value 1} (ev/request! p 2 {:operation :read}))))))

(deftest runtime-reply-validation-does-not-claim-to-undo-handler-effects
 (let [effects (atom 0)
       p (ev/start! (assoc (first-spec) :handler
                    (fn [_ s] (swap! effects inc) {:reply "wrong" :state (inc s)})) 0)]
  (try
   (let [before (ev/status p)]
    (is (= :invalid-reply (:kind (ev/call! p 1 4))))
    (is (= before (ev/status p)))
    (is (= 1 @effects)))
   (finally (GenServer/stop p)))))

(deftest initial-data-domain-does-not-change-legacy-capabilities-or-follow-candidate-markers
 (f/with-owner "reply-legacy-capability" [:capability :map] {:message-domain :unrestricted}
  (fn [[_ fresh] p]
   (let [capability (erlang/make_ref) before (ev/status p)
         candidate (assoc (f/spec fresh 2) :message-domain :bounded-first-order)]
    (is (= :unrestricted (:message-domain before)))
    (is (= capability (ev/request! p 1 capability)))
    (is (= :unproved-message-migration (:kind (g/with! fresh #(ev/upgrade! p 1 candidate)))))
    (is (= :unrestricted (:message-domain (ev/status p))))
    (is (= capability (ev/request! p 1 capability)))))))

(deftest initial-bounded-data-guard-refuses-forged-vector-and-callback-before-source
 (f/with-owner "reply-data-boundary" [:integer]
  (fn [[old] p]
   (trace/with-counter (:handler (f/spec old 1))
    (fn [calls]
     (let [forged (maps/put :__struct__ :Elixir.BeamLisp.Vector {:items :not-native-vector-storage})
           before (ev/status p)]
      (doseq [value [forged (fn [] :unproved) (erlang/make_ref)]]
       (is (= :message-domain-refused (:kind (ev/request! p 1 value)))))
      (is (= before (ev/status p)))
      (is (= 0 (calls)))))))))
