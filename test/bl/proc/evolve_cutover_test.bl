; The cutover has one native grant/bundle transition path. Unbound ownership
; does not select a raw-spec compatibility engine.
(ns proc.evolve-cutover-test (:require [proc.evolve :as ev]))
(defn- native-spec []
 {:version 1 :digest "cutover-native-owner" :accept? (fn [_] true)
  :check-state (fn [_] true) :handler (fn [message state] {:reply message :state state})})

(deftest unsupported-ownership-and-retired-control-messages-refuse-without-effects
 (let [owner (ev/start! (native-spec) 7) calls (atom 0)
       candidate (assoc (native-spec) :version 2 :digest "unsupported-candidate"
                    :migrate-state (fn [value] (swap! calls inc) value)
                    :upcast (fn [value] value))
       ticket (erlang/make_ref) before (ev/status owner)]
  (try
   (doseq [operation [#(ev/upgrade! owner 1 candidate) #(ev/rehearse! owner 1 candidate)
                      #(ev/prepare-upgrade! owner 1 candidate) #(ev/commit-upgrade! owner ticket)
                      #(ev/cancel-upgrade! owner ticket)]]
    (is (= {:status :refused :kind :owner-transition-authority-required :scope :retained-old-owner}
           (operation))))
   (doseq [message [[:proc.evolve/upgrade 1 candidate] [:proc.evolve/rehearse 1 candidate 250]
                   [:proc.evolve/prepare 1 candidate []] [:proc.evolve/commit ticket]
                   [:proc.evolve/cancel ticket]]]
    (is (= {:status :refused :kind :owner-transition-authority-required} (GenServer/call owner message))))
   (is (= before (ev/status owner)))
   (is (= 0 @calls))
   (is (= "unchanged owner" (ev/call! owner 1 "unchanged owner")))
   (finally (GenServer/stop owner)))))

(deftest prepared-spec-metadata-has-one-opaque-context-codec
 (let [resolve (BeamLisp.Env/fetch_exact! "proc.evolve" "spec-environment")]
  (is (= :invalid_native_context
       (try (resolve {:environment (BeamLisp.Env/capture)}) :unexpected-acceptance
        (catch error (BeamLisp.ExInfo/ex_original error)))))))
