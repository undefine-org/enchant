(ns proc.source-guard-budget-test
 (:require [proc.message-domain :as domain] [reload.generation :as g]))
(def SOURCE
 "(ns guard.budget)
  (defn plain [m] (erlang/is_map m))
  (defn old-map [m] (and (erlang/is_map m) (erlang/=:= 1 (maps/get :tag m 1))))
  (defn identity-value [m] m)
  (defn wrap [m] {:payload m})
  (defn duplicate-guard [m] (do (maps/get :tag m m) (old-map m)))
  (defn dormant [m] (or (erlang/is_map m) (erlang/=:= 1 (maps/get :tag m 1))))
  (defn force-guard [m] (do (maps/get :tag m 1) (dormant m)))
  (defn integer [m] (erlang/is_integer m))
  (defn typed-map [m] (and (erlang/is_map m) (erlang/is_integer (maps/get :tag m 1))))
  (defn project [m] {:tag (maps/get :tag m 1)})
  (defn box [m] {:tag m})
  (defn vector-box [m] [m])
  (defn vector-integer [m] (and (vector? m) (= 1 (count m)) (erlang/is_integer (first m))))")
(defn- with-proof [action]
 (let [graph (g/prepare! {:application-id (str "source-budget-proof-" (erlang/unique_integer (list :positive)))
                         :native-modules #{"erlang" "maps"} :sources {"guard.budget" SOURCE}})
       callback (fn [name] (g/with! graph
                   #(let [namespace (get (:mapping graph) "guard.budget")]
                     {:function (BeamLisp.Env/fetch_exact! namespace name)
                      :environment (BeamLisp.Env/capture_native_context!)})))]
  (try (action callback) (finally (g/retire! graph)))))
(deftest guarded-whole-map-wrapping-has-no-universal-source-budget-proof
 (with-proof
  (fn [f]
   (let [a (f "old-map") b (f "wrap") c (f "old-map")
         captured (domain/capture (:function a) (:environment a))]
    (is (= :proved (:status captured)))
    (is (pos? (count (:source-guards captured))))
    (is (= :unknown (:status (domain/compare-callbacks a b c :bounded-first-order))))))))
(deftest identity-guard-and-scalar-projective-conversions-remain-proved
 (with-proof
  (fn [f]
   (doseq [[old conversion fresh] [["old-map" "identity-value" "old-map"]
                                  ["integer" "box" "typed-map"]
                                  ["typed-map" "project" "typed-map"]
                                  ["integer" "vector-box" "vector-integer"]
                                  ["plain" "wrap" "plain"]]]
    (let [result (domain/compare-callbacks (f old) (f conversion) (f fresh) :bounded-first-order)]
     (when-not (= :proved (:status result)) (println "SOURCE_GUARD_POSITIVE" old conversion fresh (pr-str (dissoc result :evidence))))
     (is (= :proved (:status result))))))))
(deftest whole-argv-keeps-duplicate-input-occurrences
 (with-proof
  (fn [f]
   (let [r (f "duplicate-guard") capture (domain/capture (:function r) (:environment r))
         arguments (:arguments (first (:source-guards capture)))]
    (is (= :proved (:status capture)))
    (is (= 3 (count arguments)))
    (is (= (nth arguments 1) (nth arguments 2)))
    (is (= :unknown (:status (domain/compare-callbacks (f "old-map") (f "identity-value") r :bounded-first-order))))))))
(deftest skipped-old-guards-do-not-authorize-new-native-invocation
 (with-proof
  (fn [f]
   (let [r (f "dormant") captured (domain/capture (:function r) (:environment r))]
    (is (= :proved (:status captured)))
    (is (seq (:when (first (:source-guards captured)))))
    (is (= :unknown (:status (domain/compare-callbacks r (f "identity-value") (f "force-guard") :bounded-first-order))))))))

(deftest transition-batch-matches-authentic-comparisons-with-shared-records
 (with-proof
  (fn [f]
   (let [integer (f "integer") identity (f "identity-value")
         batch (domain/compare-transition integer identity integer integer identity integer identity integer 0 :bounded-first-order)]
    (doseq [key [:message :reply :state]] (is (= :proved (:status (get batch key)))))
    (is (= :proved (get-in batch [:bounds :message-output-bound :status])))
    (is (= :proved (get-in batch [:bounds :reply-output-bound :status])))
    (is (= (:downcast-proof batch) (second (get-in batch [:message :evidence]))))
    (is (= 2 (count (distinct (concat (get-in batch [:message :evidence])
                                     (get-in batch [:reply :evidence])
                                     (get-in batch [:state :evidence]))))))
    (is (= (select-keys (domain/compare-callbacks integer identity integer :bounded-first-order) [:status :scope :cases])
           (select-keys (:message batch) [:status :scope :cases])))
    (is (= (select-keys (domain/compare-replies integer identity integer identity integer :bounded-first-order) [:status :scope :cases])
           (select-keys (:reply batch) [:status :scope :cases])))
    (is (= (select-keys (domain/compare-current-state identity integer 0) [:status :scope])
           (select-keys (:state batch) [:status :scope])))))))
(deftest transition-batch-does-not-accept-returned-proof-as-callback-record
 (with-proof
  (fn [f]
   (let [integer (f "integer") identity (f "identity-value")
         proof (domain/capture (:function integer) (:environment integer))
         batch (domain/compare-transition proof identity integer integer identity integer identity integer 0 :bounded-first-order)]
    (is (= :proved (:status proof)))
    (is (= :unknown (get-in batch [:message :status])))
    (is (= :unknown (get-in batch [:reply :status])))))))
