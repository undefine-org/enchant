(ns proc.evolve-retirement-stress-test
 (:require [proc.evolve :as ev] [test.support.evolve-counter-fixtures :as f]))

(deftest retirement-keeps-evolution-bounded-across-many-releases
 ; Every release has its own frozen Source graph/digest, real native grant,
 ; and retained callback set; all forty retire/reuse cycles remain covered.
 (f/with-owner "evolve-basic-many-releases"
             (into [[1 :integer] [2 :map]] (mapv (fn [version] [version :identity]) (range 3 42)))
             0 {:managed true :history-limit 1}
  (fn [graphs p]
   ;; Iterate the finite version range directly. A lazy zip would repeatedly
   ;; scan its captured forty-one complete graphs for resource dependencies.
   (doseq [version (range 2 42)]
    (let [candidate (nth graphs (dec version))]
    (is (= :applied (:status (f/upgrade candidate p (dec version) version))))
    (is (= :retired (:status (ev/retire! p version (dec version)))))
    (is (= [] (:legacy-versions (ev/status p))))))
   (is (= 41 (:version (ev/status p))))
   (is (= 1 (ev/request! p 41 "inc"))))))
