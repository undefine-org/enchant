(ns proc.evolve-sample-domain-test
 (:require [proc.evolve :as evolve] [test.support.evolve-fixtures :as fixture]))

(deftest bounded-owner-rehearses-supplied-samples-without-giving-the-child-owner-custody
 (fixture/with-owner "bounded-owner-sample-rehearsal"
  [(fixture/source :old) (fixture/source :map)] 0
  {:managed true :message-domain :bounded-first-order}
  (fn [[_ fresh] owner]
   (let [candidate (fixture/spec fresh 2)]
    (fixture/with-counter (:handler candidate)
     (fn [calls]
      (let [before (evolve/status owner)
            prepared (fixture/in! fresh
                       #(evolve/prepare-upgrade! owner 1 candidate
                         [{:version 1 :message :inc} {:version 1 :message :read}]))]
       (is (= :prepared (:status prepared)))
       (is (= 2 (:messages prepared)))
       (is (= 0 (calls)))
       (is (= (:revision before) (:revision (evolve/status owner))))
       (is (= :bounded-first-order (:message-domain (evolve/status owner))))
       (is (= :applied (:status (fixture/in! fresh
                                  #(evolve/commit-upgrade! owner (:ticket prepared))))))
       (is (= owner (:pid (evolve/status owner))))
       (is (= 1 (evolve/request! owner 1 :inc)))
       (is (= 1 (calls))))))))))

(deftest invalid-samples-and-external-capabilities-still-refuse-without-running-handlers
 (fixture/with-owner "bounded-owner-sample-refusal"
  [(fixture/source :old) (fixture/source :map)] 0
  {:managed true :message-domain :bounded-first-order}
  (fn [[old fresh] owner]
   (let [candidate (fixture/spec fresh 2)]
    (fixture/with-counter (:handler (fixture/spec old 1))
     (fn [old-calls]
      (fixture/with-counter (:handler candidate)
       (fn [new-calls]
        (let [before (evolve/status owner)
              refused (fixture/in! fresh
                        #(evolve/prepare-upgrade! owner 1 candidate
                          [{:version 1 :message :outside-original-contract}]))]
         (is (= :refused (:status refused)))
         (is (= before (evolve/status owner)))
         (is (= 0 (old-calls)))
         (is (= 0 (new-calls))))
        (let [before (evolve/status owner)]
         (doseq [value [(erlang/make_ref) (fn [] :not-data)]]
          (is (= :message-domain-refused (:kind (evolve/request! owner 1 value)))))
         (is (= before (evolve/status owner)))
         (is (= 0 (old-calls)))
         (is (= 0 (new-calls))))
        (is (= 1 (evolve/request! owner 1 :inc)))
        (is (= 1 (old-calls)))
        (is (= 0 (new-calls)))))))))))
