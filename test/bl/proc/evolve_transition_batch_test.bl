(ns proc.evolve-transition-batch-test
 (:require [proc.evolve :as evolve]
           [test.support.evolve-reply-fixtures :as fixture]))

(deftest first-public-reply-upgrade-captures-and-validates-each-actual-registration-once
 (fixture/with-owner "reply-transition-batch" [:integer :map :vector]
  (fn [[_ fresh _] owner]
   (is (= 3 (evolve/request! owner 1 3)))
   (let [mfa (tuple :Elixir.BeamLisp.Env :inspect_execution_callback! 2)]
    (when-not (= 1 (erlang/trace_pattern mfa true (list :call_count)))
     (throw (ex-info "Native callback inspection counter unavailable" {})))
    (try
     ;; Use the ordinary public timeout. The first edge has eight distinct
     ;; actual registrations: capture+fresh validation, then commit's retained
     ;; fresh validation. No descriptor or callback inspection is mocked.
     (let [result (fixture/upgrade! fresh owner 1 2)
           inspections (elem (erlang/trace_info mfa :call_count) 1)]
      (is (= :applied (:status result)))
      (is (= 24 inspections)))
     (is (= 4 (evolve/request! owner 1 4)))
     (is (= {:value 5} (evolve/request! owner 2 5)))
     (is (= [1] (:legacy-versions (evolve/status owner))))
     (finally (erlang/trace_pattern mfa false (list :call_count))))))))
