(ns proc.evolve-preparation-test
 (:require [proc.evolve :as ev] [reload.generation :as g]
           [test.support.evolve-fixtures :as f] [test.support.workflow :as workflow]))

(def OLD (f/source :old))
(def NEW (f/source :map))
(defn- prepared! [graph pid samples]
 (workflow/status! :prepared (f/in! graph #(ev/prepare-upgrade! pid 1 (f/spec graph 2) samples))))
(defn- commit! [graph pid prepared]
 (f/in! graph #(ev/commit-upgrade! pid (:ticket prepared))))

(deftest lexical-client-dependencies-drain-without-distributed-request-locks
 (f/with-owner "preparation-lexical-client" [OLD] 0 {:managed true}
  (fn [_ p]
   (let [ran (atom false)]
    (is (= 1 (ev/with-client! p 1 #(ev/call-client! p % :inc))))
    (is (= 0 (:clients (ev/status p))))
    (is (try (ev/with-client! p 1 (fn [_] (throw (ex-info "caller failed" {})))) false (catch _ true)))
    (is (= 0 (:clients (ev/status p))))
    (ev/fence-version! p 1)
    (is (= :version-fenced (:kind (ev/with-client! p 1 (fn [_] (reset! ran true))))))
    (is (not @ran))))))

(deftest synchronous-managed-request-admission-is-one-fifo-turn-with-native-fences
 (f/with-owner "preparation-fifo" [OLD NEW] 0 {:managed true}
  (fn [[_ fresh] p]
   (let [parent (erlang/self) request (erlang/alias) fence (erlang/alias)]
    (try
     (is (= 1 (ev/request! p 1 :inc)))
     (is (= 0 (:clients (ev/status p))))
     ;; This test orders requests against a completed native publication. Use
     ;; the public preparation/commit protocol; a one-call client timeout is
     ;; an unknown outcome and cannot establish the ordering prerequisite.
     (workflow/status! :applied (commit! fresh p (prepared! fresh p [])))
     (is (= 2 (ev/request! p 1 :inc)))
     (erlang/send p (tuple :"$gen_call" (tuple parent request) [:proc.evolve/request 1 :inc]))
     (erlang/send p (tuple :"$gen_call" (tuple parent fence) [:proc.evolve/fence 1]))
     (is (= 3 (receive [tag result] :when (= tag request) result (after 5000 :timeout))))
     (is (= :fenced (:status (receive [tag result] :when (= tag fence) result (after 5000 :timeout)))))
     (is (= :version-fenced (:kind (ev/request! p 1 :inc))))
     (is (= 3 (ev/request! p 2 {:amount 0})))
     (is (= :retired (:status (ev/retire! p 2 1))))
     (is (= :unsupported-version (:kind (ev/request! p 1 :inc))))
     (finally (erlang/unalias request) (erlang/unalias fence)))))))

(deftest exact-candidate-publication-is-idempotent-and-never-runs-a-handler-in-rehearsal
 (f/with-owner "preparation-exact" [OLD NEW] 4 {:managed true}
  (fn [[_ fresh] p]
   (let [candidate (f/spec fresh 2)]
    (f/with-counter (:handler candidate)
     (fn [calls]
      (is (= :unknown-preparation (:kind (ev/cancel-upgrade! p nil))))
      (let [before (ev/status p) prepared (prepared! fresh p [{:version 1 :message :inc} {:version 1 :message :read}])]
       (is (= 2 (:messages prepared)))
       (is (= 0 (calls)))
       (is (= (:revision before) (:revision (ev/status p))))
       (is (:prepared? (ev/status p)))
       (is (= :applied (:status (commit! fresh p prepared))))
       (is (not (:prepared? (ev/status p))))
       (is (= 5 (ev/request! p 1 :inc)))
       (is (= :already-applied (:status (commit! fresh p prepared))))
       (is (= 1 (calls)))
       (is (= p (:pid (ev/status p)))))))))))

(deftest intervening-work-refuses-stale-preparation-and-preserves-the-accepted-write
 (f/with-owner "preparation-stale" [OLD NEW] 0 {:managed true}
  (fn [[_ fresh] p]
   (let [prepared (prepared! fresh p [])]
    (is (= 1 (ev/request! p 1 :inc)))
    (is (= :stale-preparation (:kind (commit! fresh p prepared))))
    (is (not (:prepared? (ev/status p))))
    (is (= 1 (:version (ev/status p))))
    (is (= 1 (ev/request! p 1 :read)))
    (is (= :unknown-preparation (:kind (commit! fresh p prepared))))))))

(deftest wrong-message-or-state-conversion-refuses-before-publication
 (f/with-owner "preparation-invalid" [OLD NEW (f/source :wrong-upcast) (f/source :invalid)] 3 {:managed true}
  (fn [[_ fresh wrong-message wrong-state] p]
   (doseq [candidate [wrong-message wrong-state]]
    (is (= :refused (:status (f/in! candidate #(ev/prepare-upgrade! p 1 (f/spec candidate 2) [{:version 1 :message :inc}])))))
    (is (= 1 (:version (ev/status p))))
    (is (not (:prepared? (ev/status p)))))
   (is (= 3 (ev/request! p 1 :read)))
   (is (= :invalid-message-samples (:kind (f/in! fresh #(ev/prepare-upgrade! p 1 (f/spec fresh 2) [{}])))))
   (is (= :invalid-message-samples
          (:kind (f/in! fresh #(ev/prepare-upgrade! p 1 (f/spec fresh 2) (vec (repeat 257 {:version 1 :message :inc}))))))))))

(deftest preparations-are-owner-local-bounded-and-cancellable
 (f/with-generations "preparation-owner-local" [OLD NEW (f/source :ninety-nine)]
  (fn [[old fresh alternative]]
   (let [a (f/in! old #(ev/start! (f/spec old 1) 1 {:managed true})) b (f/in! old #(ev/start! (f/spec old 1) 2 {:managed true}))]
    (try
     (let [prepared (prepared! fresh a [])
           refused (f/in! alternative #(ev/prepare-upgrade! a 1 (f/spec alternative 2)))]
      (is (= :owner-preparation-pending (:kind refused)))
      (is (= :unknown-preparation (:kind (commit! fresh b prepared))))
      (is (= :applied (:status (commit! fresh a prepared))))
      (is (= 1 (ev/request! a 1 :read))))
     (let [prepared (prepared! alternative b [])]
      (is (= :cancelled (:status (f/in! alternative #(ev/cancel-upgrade! b (:ticket prepared))))))
      (is (= :unknown-preparation (:kind (commit! alternative b prepared))))
      (is (not (:prepared? (ev/status b)))))
     (finally (GenServer/stop a) (GenServer/stop b)))))))

(def COMPOSED
 (str OLD "
  (ps/defserver owner
   (evolve {:spec (:spec start-opts) :state 0 :managed true})
   (handle-call :ordinary [_ state] (reply :ordinary state)))"))
(deftest composed-owner-supports-the-same-native-preparation-protocol
 (let [source (String/replace COMPOSED "(ns evolution.fixture)"
                 "(ns evolution.fixture (:require [proc.server :as ps] [proc.evolve :as ev]))")]
  (f/with-generations "preparation-composed" [source NEW]
   (fn [[old fresh]]
    (let [p (f/in! old #(start (BeamLisp.Env/fetch_exact! (get (:mapping old) "evolution.fixture") "owner")
                              {:spec (f/spec old 1)}))
          client (:token (ev/acquire-client! p 1))]
     (try
      (let [prepared (prepared! fresh p [{:version 1 :message :inc}])]
       (is (= :applied (:status (commit! fresh p prepared))))
       (is (= 1 (ev/call-client! p client :inc)))
       (is (= 2 (ev/request! p 1 :inc)))
       (is (= :ordinary (GenServer/call p :ordinary))))
      (finally (ev/release-client! p client) (GenServer/stop p))))))))

(deftest rejected-candidates-never-overwrite-a-valid-preparation-or-run-effectful-migration
 (f/with-owner "preparation-keeps-exact-ticket" [OLD NEW (f/source :effectful)] 2 {:managed true}
  (fn [[_ fresh effectful] p]
   (let [candidate (f/spec effectful 2)]
    (f/with-counter (:migrate-state candidate)
     (fn [calls]
      ;; Effectful conversion is outside the closed future-input proof. It is
      ;; refused before invocation; this makes no scheduling/deadline claim.
      (is (= :unproved-message-migration
             (:kind (f/in! effectful #(ev/prepare-upgrade! p 1 candidate)))))
      (is (= 0 (calls)))
      (let [valid (prepared! fresh p [])]
       (is (= :owner-preparation-pending
              (:kind (f/in! effectful #(ev/prepare-upgrade! p 1 candidate)))))
       (is (= 0 (calls)))
       (is (= :applied (:status (commit! fresh p valid))))
       (is (= 2 (ev/request! p 1 :read))))))))))
