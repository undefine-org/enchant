; All transitions use actual managed Source candidates and the single native
; grant/bundle protocol. A prepared spec or a raw actor message is not authority.
(ns proc.evolve-test
 (:require [proc.evolve :as ev] [reload.generation :as g] [test.support.evolve-counter-fixtures :as f]))

(deftest stable-pid-state-and-late-old-messages
 (f/with-owner "evolve-basic-stable" [[1 :integer] [2 :map] [3 :identity]] 0 {:managed true}
  (fn [[_ fresh third] p]
   (is (= 1 (ev/request! p 1 "inc")))
   (is (= :applied (:status (f/upgrade fresh p 1 2))))
   (is (= p (:pid (ev/status p))))
   (is (= 2 (:version (ev/status p))))
   (is (= 2 (ev/request! p 1 "inc")))
   (is (= 7 (ev/request! p 2 "five")))
   (is (= [1] (:legacy-versions (ev/status p))))
   (is (= :already-applied (:status (f/upgrade fresh p 1 2))))
   (is (= :stale-version (:kind (f/upgrade third p 1 3))))
   (is (= :identity-conflict
          (:kind (g/with! fresh #(ev/upgrade! p 2 (assoc (f/spec fresh 2) :digest "changed"))))))
   (is (= 7 (ev/request! p 1 "read"))))))

(deftest refused-upgrade-and-invalid-message-preserve-owner
 (f/with-owner "evolve-basic-refusals" [[1 :integer] [2 :map] [2 :invalid]] 4 {:managed true}
  (fn [[_ fresh invalid] p]
   (is (= :refused
          (:status (g/with! fresh #(ev/upgrade! p 1 (dissoc (f/spec fresh 2) :upcast))))))
   (is (= :refused (:status (f/upgrade invalid p 1 2))))
   (is (= false (:prepared? (ev/status p))))
   (is (= 1 (:version (ev/status p))))
   (is (= 4 (ev/request! p 1 "read")))
   (is (= :unsupported-version (:kind (ev/request! p 9 "inc"))))
   (is (= :invalid-message (:kind (ev/request! p 1 :unhandled))))
   (is (= 5 (ev/request! p 1 "inc"))))))

(deftest queued-old-calls-upcast-after-upgrade-without-rewriting-mailbox
 (f/with-owner "evolve-basic-queued" [[1 :integer] [2 :map]] 0 {:managed true}
  (fn [[_ fresh] p]
   (let [parent (erlang/self) upgrade-alias (erlang/alias) call-alias (erlang/alias)]
    (try
     (g/with! fresh
      (fn []
       (let [prepared (ev/prepare-upgrade! p 1 (f/spec fresh 2))
             grant (BeamLisp.Env/begin_owner_transition! p)]
        (is (= :prepared (:status prepared)))
        (is (= (:ticket prepared) (elem grant 2)))
        ;; Preparation already conveyed the spec through an opaque native
        ;; bundle. Only this real grant travels in the queued commit command.
        ;; Same sender's signals order commit before the old-version request.
        (erlang/send p (tuple :"$gen_call" (tuple parent upgrade-alias)
                              [:proc.evolve/automatic-commit grant]))
        (erlang/send p (tuple :"$gen_call" (tuple parent call-alias)
                              [:proc.evolve/request 1 "inc"]))
        ;; Commit freshly validates the retained proof before publication,
        ;; within the public transition API's 31-second reply window.
        (is (= :applied (:status (receive [tag r] :when (= tag upgrade-alias) r (after 31000 nil)))))
        (is (= 1 (receive [tag r] :when (= tag call-alias) r (after 31000 nil)))))))
     (is (= p (:pid (ev/status p))))
     (is (= 2 (:version (ev/status p))))
     (finally (erlang/unalias upgrade-alias) (erlang/unalias call-alias)))))))

(deftest slow-migration-is-bounded-and-history-is-bounded
 (f/with-owner "evolve-basic-bounds" [[1 :integer] [2 :effectful] [2 :map] [3 :identity]]
             1 {:managed true :upgrade-ms 1000 :history-limit 1}
  (fn [[_ effectful fresh third] p]
   ;; Sleeping conversion is outside the supported pure future-input proof.
   ;; Its refusal is before conversion, not a claimed execution timeout proof.
   (let [migration (:migrate-state (f/spec effectful 2))
         mfa (tuple (elem (erlang/fun_info migration :module) 1)
                    (elem (erlang/fun_info migration :name) 1) 1)]
    (try
     (is (= 1 (erlang/trace_pattern mfa true (list :call_count))))
     (is (= :unproved-message-migration (:kind (f/upgrade effectful p 1 2))))
     (is (= 0 (elem (erlang/trace_info mfa :call_count) 1)))
     (finally (erlang/trace_pattern mfa false (list :call_count)))))
   (is (= false (:prepared? (ev/status p))))
   (is (= 1 (ev/request! p 1 "read")))
   (is (= :applied (:status (f/upgrade fresh p 1 2))))
   (is (= :history-full (:kind (f/upgrade third p 2 3))))
   (is (= 2 (ev/request! p 1 "inc"))))))

(deftest managed-retirement-fences-admissions-and-waits-for-real-clients
 (f/with-owner "evolve-basic-managed-retirement" [[1 :integer] [2 :map] [3 :identity]]
             0 {:managed true :history-limit 1}
  (fn [[_ fresh third] p]
   (let [acquired (ev/acquire-client! p 1) token (:token acquired)]
    (try
     (is (= :acquired (:status acquired)))
     (is (= :managed-client-required (:kind (ev/call! p 1 "inc"))))
     (is (= 1 (ev/call-client! p token "inc")))
     (is (= :applied (:status (f/upgrade fresh p 1 2))))
     (is (= :waiting (:status (ev/retire! p 2 1))))
     (is (= :version-fenced (:kind (ev/acquire-client! p 1))))
     (is (= 2 (ev/call-client! p token "inc")))
     (ev/release-client! p token)
     (is (= :unknown-client (:kind (ev/call-client! p token "inc"))))
     (is (= :retired (:status (ev/retire! p 2 1))))
     (is (= [] (:legacy-versions (ev/status p))))
     (is (= :applied (:status (f/upgrade third p 2 3))))
     (finally (ev/release-client! p token)))))))

(deftest unmanaged-owners-cannot-authorize-adapter-collection
 (f/with-owner "evolve-basic-unmanaged-retirement" [[1 :integer] [2 :map]] 0 {:managed false}
  (fn [[_ fresh] p]
   (is (= :owner-transition-authority-required (:kind (f/upgrade fresh p 1 2))))
   (is (= :unmanaged-owner (:kind (ev/retire! p 1 1))))
   (is (= [] (:legacy-versions (ev/status p))))
   (is (= 1 (:version (ev/status p))))
   (is (= 1 (ev/call! p 1 "inc"))))))
