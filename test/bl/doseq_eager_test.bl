(ns core.doseq-eager-test)

(defn under-zero-budget [f]
  (let [previous (Application/get_env :beam_lisp :lazy_cache_budget_bytes)]
    (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
    (try (f)
      (catch error {:error (ex-message error)})
      (finally
        (if (nil? previous) (Application/delete_env :beam_lisp :lazy_cache_budget_bytes)
          (Application/put_env :beam_lisp :lazy_cache_budget_bytes previous))))))

(deftest finite-effects-never-need-optional-memo-admission
  (let [out (atom [])
        result (under-zero-budget
                 (fn [] (doseq [x [1 2] y [x (+ x 1)]] (swap! out conj [x y]))))]
    (is (nil? result))
    (is (= [[1 1] [1 2] [2 2] [2 3]] @out))))

(defn modified-loop [out]
  (doseq [x [1 2 3] :let [base (* x 10)] :when (odd? x)
          y [0 1 2 3] :while (< y 2) :let [total (+ base y)] :when (odd? total)]
    (swap! out conj [x y total])))

(deftest modifiers-keep-their-binding-scope-and-order
  (let [out (atom [])]
    (is (nil? (modified-loop out)))
    (is (= [[1 1 11] [3 1 31]] @out))
    (reset! out [])
    (is (nil? (under-zero-budget (fn [] (modified-loop out)))))
    (is (= [[1 1 11] [3 1 31]] @out))))

(deftest while-stops-only-its-own-binding-group
  (let [out (atom [])
        result (under-zero-budget
                 (fn [] (doseq [x [1 2] y [0 1 2] :while (< y x) z [7 8]]
                          (swap! out conj [x y z]))))]
    (is (nil? result))
    (is (= [[1 0 7] [1 0 8] [2 0 7] [2 0 8] [2 1 7] [2 1 8]] @out))))

(deftest when-skips-the-following-while-predicate
  (let [out (atom []) checked (atom [])
        result (under-zero-budget
                 (fn [] (doseq [x [0 1 2 3 4 5] :when (odd? x)
                                :while (do (swap! checked conj x) (< x 3)) y [9]]
                          (swap! out conj [x y]))))]
    (is (nil? result))
    (is (= [1 3] @checked))
    (is (= [[1 9]] @out))))

(deftest destructuring-and-empty-inputs-stay-eager
  (let [out (atom [])
        result (under-zero-budget
                 (fn [] (doseq [[k v] [[:a 1] [:b 2]] {w :value} [{:value 3} {:value 4}]]
                          (swap! out conj [k v w]))))]
    (is (nil? result))
    (is (= [[:a 1 3] [:a 1 4] [:b 2 3] [:b 2 4]] @out))
    (is (nil? (under-zero-budget (fn [] (doseq [x [] y [1 2]] (swap! out conj :unreachable))))))
    (is (= 4 (count @out)))))

(deftest body-reduced-values-do-not-stop-the-effect-loop
  (let [out (atom [])
        result (under-zero-budget
                 (fn [] (doseq [x [1 2] y [3 4]] (swap! out conj [x y]) (reduced :body-value))))]
    (is (nil? result))
    (is (= [[1 3] [1 4] [2 3] [2 4]] @out))))

(deftest collection-expressions-run-once-in-their-own-scope
  (let [outer (atom 0) inner (atom []) out (atom [])
        result (under-zero-budget
                 (fn [] (doseq [x (do (swap! outer inc) [1 2])
                                y (do (swap! inner conj x) [3 4])]
                          (swap! out conj [x y]))))]
    (is (nil? result))
    (is (= 1 @outer))
    (is (= [1 2] @inner))
    (is (= [[1 3] [1 4] [2 3] [2 4]] @out))))

(deftest a-body-exception-preserves-its-exact-effects-and-propagates
  (let [out (atom [])
        result (try (doseq [x [1 2] y [3 4]]
                      (swap! out conj [x y])
                      (when (= y 4) (throw (ex-info "body failure" {:marker :body}))))
                 (catch error (:marker (ex-data error))))]
    (is (= :body result))
    (is (= [[1 3] [1 4]] @out))))

(deftest while-still-terminates-an-infinite-input
  (let [out (atom [])]
    (is (nil? (doseq [x (range) :while (< x 4) y [0 1]] (swap! out conj [x y]))))
    (is (= [[0 0] [0 1] [1 0] [1 1] [2 0] [2 1] [3 0] [3 1]] @out))))
