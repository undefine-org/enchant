(ns native-execution-metadata-test)

(deftest opaque-registration-metadata-follows-the-native-ownership-epoch
 (let [source (BeamLisp.Execution/register! (fn [] 42))
       prepared (atom nil)]
  (try
   (is (= nil (BeamLisp.Execution/metadata! source)))
   (is (= :ok (BeamLisp.Execution/put-metadata! source {:version 1 :label 'candidate})))
   (is (= (erlang/self) (BeamLisp.Execution/observe source 'owner)))
   (is (= nil (BeamLisp.Execution/observe source 'source-scope)))
   (reset! prepared (BeamLisp.Execution/prepare-handoff! source (erlang/self)))
   (let [target (:accepted @prepared)]
    (is (thrown? (BeamLisp.Execution/metadata! target)))
    (is (= :accepted (:status (BeamLisp.Execution/accept-handoff! @prepared))))
    (is (= {:version 1 :label 'candidate} (BeamLisp.Execution/metadata! target)))
    (is (thrown? (BeamLisp.Execution/put-metadata! source {:version 99})))
    (is (= :ok (BeamLisp.Execution/put-metadata! target {:version 2})))
    (is (= {:version 2} (BeamLisp.Execution/metadata! target)))
    (is (= {:status :completed :value 42} (BeamLisp.Execution/invoke! target [])))
    (BeamLisp.Execution/close! target)
    (is (thrown? (BeamLisp.Execution/metadata! target))))
   (finally (BeamLisp.Execution/close! source)
            (when @prepared (BeamLisp.Execution/close! (:accepted @prepared)))))))

(deftest metadata-commands-do-not-admit-a-nonowner-or-a-fabricated-registration
 (let [parent (erlang/self) source (BeamLisp.Execution/register! (fn [] 42))
       fake (tuple :bl-execution parent (erlang/make_ref))]
  (try
   (BeamLisp.Execution/put-metadata! source {:secret 'owner})
   (spawn (fn []
            (erlang/send parent [:metadata-outsider
              [(try (BeamLisp.Execution/metadata! source) :unexpected (catch _ :refused))
               (try (BeamLisp.Execution/put-metadata! source {:secret 'replaced}) :unexpected
                (catch _ :refused))]])))
   (is (= [:refused :refused]
          (receive [:metadata-outsider result] result (after 10000 (throw :missing-outsider)))))
   (is (= {:secret 'owner} (BeamLisp.Execution/metadata! source)))
   (is (thrown? (BeamLisp.Execution/metadata! fake)))
   (is (thrown? (BeamLisp.Execution/put-metadata! fake {})))
   (is (thrown? (BeamLisp.Execution/restrict! fake)))
   (is (thrown? (BeamLisp.Execution/observe source 'function)))
   (is (= :ok (BeamLisp.Execution/restrict! source)))
   (finally (BeamLisp.Execution/close! source)))))
