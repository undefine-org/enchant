(ns execution.history-preboot-test
 (:require [test.support.source-fixtures :as fixtures]))

(deftest E10-actual-cold-cli-reaches-first-assertion-without-heavy-graph
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       fixture (Path/join root "test/fixtures/execution_cold_cli.bl")
       scratch (Path/join (System/tmp_dir!) (str "history-cold-cli-" (erlang/unique_integer (list :positive))))
       manifest (Path/join (BeamLisp.Bootstrap/seed_dir) "manifest.term")
       expected (Base/encode16 (crypto/hash :sha256 (File/read! manifest)) (list (tuple :case :lower)))
       paths (Enum/flat_map (code/get_path) (fn [p] (list "-pa" (erlang/list_to_binary p))))
       script (str "Application.load(:beam_lisp)\n"
                   "path = Path.join(BeamLisp.Bootstrap.seed_dir(), \"manifest.term\")\n"
                   "unless Base.encode16(:crypto.hash(:sha256, File.read!(path)), case: :lower) == System.fetch_env!(\"BL_HISTORY_EXPECTED_MANIFEST\"), do: raise \"wrong child compiler floor\"\n"
                   "BeamLisp.Launcher.main([\"--cold\", \"test\" | System.argv()])\n")]
  (File/mkdir_p! scratch)
  (try
   (let [[output status] (System/cmd "elixir" (erlang/++ paths (list "-e" script "--" fixture))
                         (list (tuple :cd scratch) (tuple :stderr_to_stdout true)
                          (tuple :env (list (tuple "BL_DAEMON" "off")
                                            (tuple "XDG_RUNTIME_DIR" scratch)
                                            (tuple "BL_ROOT" (Path/dirname (BeamLisp.Tiers/priv_root)))
                                            (tuple "BL_HISTORY_EXPECTED_MANIFEST" expected)))))]
    (is (= 0 status) output)
    (is (String/contains? output "HISTORY_COLD_CLI_READY") output))
   (finally (File/rm_rf! scratch)))))

(deftest E21-authenticated-publication-protects-sdk-before-first-runtime-lease
 (let [[output status] (fixtures/cold! "test/fixtures/execution_publication_before_lease.bl")]
  (is (= 0 status) output)
  (is (String/contains? output "HISTORY_PUBLICATION_BEFORE_LEASE_READY") output)))
