(ns retained-sdk-pin-test (:require [artifact :as artifact]))

(deftest qualified-sdk-pins-keep-pure-observation-and-the-real-product-dependency
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       sdk (or (System/get_env "BL_SDK_PRODUCT") (:sdk (artifact/framework-context)))
       out (Path/join (System/tmp_dir!)
             (str "retained-sdk-pin-" (erlang/unique_integer (list :positive)) ".json"))
       hash (fn [file] (Base/encode16 (crypto/hash :sha256 (File/read! file))
                          (list (tuple :case :lower))))]
  (try
   (let [[output status] (System/cmd "python3"
                          (list "-B" (Path/join root "test/scripts/retained_sdk_pin.py")
                                "--sdk" sdk "--out" out)
                          (list (tuple :stderr_to_stdout true)))
         report (erlang/apply :json :decode (list (File/read! out)))]
    (is (= 0 status) output)
    (is (= "passed" (get report "status")))
    (is (= 4 (get report "tests")))
    (is (= sdk (get report "sdk")))
    (is (= (hash (Path/join sdk "artifact.json")) (get report "descriptor_sha256")))
    (is (= (hash (Path/join root "nix/retained-sdk.nix")) (get report "producer_sha256")))
    (is (= false (get report "SDK_production_requested")))
    (is (= false (get report "native_production_requested"))))
   (finally (File/rm out)))))
