(ns contextual-class-emission-test
 (:require [compiler :as compiler] [anf :as a] [lower :as lower] [compile.world :as world]))
(defn- key [] (String/duplicate "a" 64))
(defn- input [] (String/duplicate "b" 64))
(defn- form [text] (first (BeamLisp.Reader/read_string text "class-emission.bl")))
(defn- fixture []
 (let [suffix (str "R" (erlang/unique_integer (list :positive)))
       classes (list (compiler/prepare-class-declaration (form "(defrecord Packet [payload])")
                       (compiler/new-env "emit.record") (Module/concat :Elixir.ContextEmitRecord suffix))
                     (compiler/prepare-class-declaration (form "(deftype Opaque [payload])")
                       (compiler/new-env "emit.type") (Module/concat :Elixir.ContextEmitType suffix)))]
  {:descriptors (Enum/map classes (fn [class] (:descriptor class)))
   :unit {:version 2 :kind :compiled-contextual-unit :initializers (list) :exports (list)
          :steps (Enum/map (Enum/with_index classes)
                   (fn [pair] {:op :capture :slot (str "frame" (elem pair 1)) :node (:lexical-node (elem pair 0))}))
          :entry (a/var "frame0")}}))
(defn- emit [f] (BeamLisp.AOT/prepare_contextual_classes! (:unit f) (:descriptors f) (key) (input)))
(defn- reason [action] (try (action) nil (catch-raw [kind reason stack] reason)))
(defn- attribute [bytes key]
 (let [attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
       value (Keyword/get attrs key)]
  (if (and (erlang/is_list value) (= 1 (erlang/length value))) (first value) value)))
(defn- retire [beams] (doseq [beam beams] (BeamLisp.Env/retire_module! (first beam))))
(defn- factory [unit]
 (lower/descriptor->beam (a/module :Elixir.ContextEmitFactory
  (list {:op :defn-clause :fname :run :params (list) :guard nil :body (a/contextual-unit-factory unit) :ann {}})
  (list [:run 0]) (list)) {}))

(deftest original-generated-module-owner-emits-and-stamps-every-logical-class-once
 (let [f (fixture) emitted (emit f)]
  (is (= 2 (count (:beams emitted)) (count (:members emitted))))
  (is (= [:replay_declaration! :replay_declaration!]
         (vec (map #(get-in % [:node :init :fun]) (get-in emitted [:unit :steps])))))
  (doseq [beam (:beams emitted)]
   (let [bytes (second beam) module (first beam)
         row (first (filter #(= (Atom/to_string module) (:module %)) (:members emitted)))]
    (is (= (crypto/hash :sha256 bytes) (:sha256 row)))
    (is (= (:class-metadata row) (attribute bytes :bl_generated_class)))
    (is (= :generated-class (attribute bytes :bl_aot_artifact_role)))
    (is (= 1 (attribute bytes :bl_contextual_class_version) (attribute bytes :bl_generated_class_version)))
    (is (= (key) (attribute bytes :bl_compiler_key)))
    (is (= (input) (attribute bytes :bl_source_hash)))
    (is (nil? (BeamLisp.Record/info module)))
    (is (not (erlang/module_loaded module)))))))

(deftest preloaded-class-replay-builds-constructors-with-zero-runtime-compilation
 (let [f (fixture) emitted (emit f) bytes (factory (:unit emitted)) record (first (first (:beams emitted)))
       target (tuple :Elixir.BeamLisp.Emit :compile_descriptor 1)]
  (try
   (BeamLisp.Env/publish_binaries! (cons bytes (:beams emitted)) "context-class-emission")
   (erlang/trace_pattern target true (list :call_count))
   (let [instance (erlang/apply (first bytes) :run (list)) frame ((:entry instance))
         value (BeamLisp.Ns.Rt/invoke (elem frame 1) (list 42))]
    (is (= (Map/put {:payload 42} :__struct__ record) value))
    (is (= (tuple :call_count 0) (erlang/trace_info target :call_count)))
    (is (= (list :payload) (BeamLisp.Record/fields_of record)))
    (BeamLisp.Emit/compile_descriptor (first (:descriptors f)))
    (is (= (tuple :call_count 1) (erlang/trace_info target :call_count))))
   (finally (erlang/trace_pattern target false (list :call_count))
            (retire (cons bytes (:beams emitted)))))))

(deftest inventory-and-actual-producer-sites-must-match-before-runtime
 (let [f (fixture) one (first (:descriptors f)) empty (assoc (:unit f) :steps (list) :entry (a/lit 42))
       repeated (update (:unit f) :steps #(cons (assoc (first %) :slot "duplicate") %))]
  (is (= :contextual_class_publication_mismatch (reason #(emit (assoc f :descriptors (list))))))
  (is (= :contextual_class_inventory_incomplete (reason #(emit (assoc f :unit empty)))))
  (is (= :contextual_class_publication_mismatch (reason #(emit (assoc f :unit repeated)))))
  (is (= :invalid_contextual_class_inventory (reason #(emit (assoc f :descriptors (list one one))))))
  (is (not (erlang/module_loaded (:name (first (:descriptors f))))))
  (is (not (erlang/module_loaded (:name (second (:descriptors f))))))))

(deftest descriptor-shaped-literal-data-does-not-become-a-class-publication
 (let [f (fixture) unit (assoc (:unit f) :steps (list) :entry (a/lit (first (:descriptors f))))
       emitted (emit {:unit unit :descriptors (list)})]
  (is (= unit (:unit emitted)))
  (is (= (list) (:members emitted) (:beams emitted)))))

(deftest world-unit-emission-keeps-class-members-and-refuses-single-binary-drop
 (let [dir (Path/join (System/tmp_dir!) (str "class-emission-" (erlang/unique_integer (list :positive))))]
  (try
   (File/mkdir_p! dir)
   (File/write! (Path/join dir "main.bl") "(ns emitted) (defrecord Packet [payload]) (deftype Opaque [payload]) 42")
   (File/write! (Path/join dir "world.bl")
    "{:version 1 :profile 'syntax-v1 :entry ['emitted 'current] :sources [{:namespace 'emitted :revision 'current :file \"main.bl\"}] :libraries []}")
   (let [prepared (world/prepare (Path/join dir "world.bl"))
         unit (world/prepare-unit prepared :Elixir.ContextEmitWorld)
         destination (Path/join dir "unit")]
    (is (= 2 (count (:generated-beams (first (:plans unit))))))
    (is (= :contextual-class-unit-required
           (try (world/artifact prepared :Elixir.ContextEmitSingle) nil (catch error (:kind (ex-data error))))))
    (BeamLisp.AOT/emit_unit unit destination)
    (let [verified (BeamLisp.AOT/verify_unit destination) members (BeamLisp.AOT/contextual_unit_members! verified)]
     (is (= 2 (count (:classes members))))
     (is (= 3 (count (:runtime-beams members))))
     (is (= false (:native-admission members)))))
   (finally (File/rm_rf! dir)))))
