(ns vm.native-refresh-test (:require [vm.native] [claim :as c]))

(defn- refresh [root producer cargo build]
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "vm.native" "refresh-native-root")
                       (list root producer cargo build)))

(defn- fixture [f]
  (let [root (str (System/tmp_dir!) "/native-refresh-" (erlang/unique_integer (list :positive)))
        prior (Process/get :bl-osenv-overlay)
        calls (atom 0)
        artifact (str root "/priv/native/tiny.so")
        build (fn [_]
                (swap! calls inc)
                (File/mkdir_p! (Path/dirname artifact))
                (File/write! artifact "compiled artifact")
                {:built 1 :cached 0 :artifacts [artifact] :errors []})]
    (try
      (Process/put :bl-osenv-overlay {"BEAM_LISP_AOT_CACHE_DIR" (str root "/cache")})
      (File/mkdir_p! (str root "/native/tiny/src"))
      (File/write! (str root "/native/tiny/Cargo.toml") "[package]\nname = \"tiny\"\n")
      (File/write! (str root "/native/tiny/src/lib.rs") "original source")
      (f root calls build artifact)
      (finally
        (if (nil? prior) (Process/delete :bl-osenv-overlay) (Process/put :bl-osenv-overlay prior))
        (File/rm_rf! root)))))

(deftest unchanged-refresh-reuses-content-receipt-and-changes-invalidate
  (fixture
    (fn [root calls build artifact]
      (is (= 1 (:built (refresh root "producer-a" "cargo-a" build))))
      (is (= 1 (:cached (refresh root "producer-a" "cargo-a" build))))
      (is (= 1 @calls) "unchanged startup does not load or call the native producer")
      (let [source (str root "/native/tiny/src/lib.rs")
            before (File/stat! source)]
        (File/write! source "modified source")
        (File/touch! source (:mtime before))
        (refresh root "producer-a" "cargo-a" build)
        (is (= 2 @calls) "content edits invalidate even with the same mtime"))
      (File/write! (str root "/native/tiny/src/new.rs") "new source")
      (refresh root "producer-a" "cargo-a" build)
      (is (= 3 @calls) "new input files invalidate")
      (File/rm! (str root "/native/tiny/src/new.rs"))
      (refresh root "producer-a" "cargo-a" build)
      (is (= 4 @calls) "deleted input files invalidate")
      (File/write! (str root "/native/tiny/Cargo.lock") "dependency lock")
      (refresh root "producer-a" "cargo-a" build)
      (is (= 5 @calls) "lockfile changes invalidate")
      (File/write! artifact "artifact drift")
      (refresh root "producer-a" "cargo-a" build)
      (is (= 6 @calls) "installed bytes are checked")
      (File/rm! artifact)
      (refresh root "producer-a" "cargo-a" build)
      (is (= 7 @calls) "missing artifacts must be restored")
      (refresh root "producer-b" "cargo-a" build)
      (is (= 8 @calls) "producer changes invalidate")
      (refresh root "producer-b" "cargo-b" build)
      (is (= 9 @calls) "cargo changes invalidate")
      (refresh root "producer-b" "cargo-b" build)
      (is (= 9 @calls) "a new successful receipt becomes reusable"))))

(deftest failed-refresh-is-never-certified
  (fixture
    (fn [root calls build artifact]
      (let [fail (fn [_] (swap! calls inc) {:errors ["failed"] :artifacts []})]
        (refresh root "producer-a" "cargo-a" fail)
        (refresh root "producer-a" "cargo-a" fail)
        (is (= 2 @calls) "a failed build is retried")
        (refresh root "producer-a" "cargo-a" build)
        (refresh root "producer-a" "cargo-a" build)
        (is (= 3 @calls) "a successful retry becomes reusable")))))

(deftest inputs-edited-during-refresh-are-not-certified
  (fixture
    (fn [root calls build artifact]
      (let [mutating (fn [selected]
                       (let [r (build selected)]
                         (File/write! (str root "/native/tiny/src/lib.rs") "mid-build edit")
                         r))]
        (refresh root "producer-a" "cargo-a" mutating)
        (refresh root "producer-a" "cargo-a" build)
        (is (= 2 @calls) "input races require a fresh producer run")
        (refresh root "producer-a" "cargo-a" build)
        (is (= 2 @calls))))))


(defn- with-foreign-custody [scope action]
 (let [parent (erlang/self)
       [worker watch] (spawn-monitor
                      (fn []
                       (let [acquired (c/acquire! scope "other native writer")]
                        (erlang/send parent [:native-custody (:ok? acquired)])
                        (receive :finish :ok))))]
  (try
   (receive [:native-custody acquired] (assert acquired) (after 5000 (throw :native-custody-not-ready)))
   (action)
   (finally
    (erlang/exit worker :kill)
    (receive [:DOWN ref :process pid _] :when (and (= ref watch) (= pid worker)) :ok
     (after 5000 (throw :native-custody-not-down)))))))

(defn- receipt-scope [root]
 (str (Path/join (Path/join (BeamLisp.AOTCache/dir) "native-refresh")
        ((BeamLisp.Env/fetch_exact! "vm.native" "native-refresh-digest") (Path/expand root))) ".custody"))
(defn- held-kind [action] (try (action) :accepted (catch error (:kind (ex-data error)))))

(deftest even-a-refresh-cache-hit-refuses-foreign-publication-before-observing-it
 (fixture
  (fn [root calls build artifact]
   (refresh root "producer-a" "cargo-a" build)
   (BeamLisp.Compiler/eval_string
    (File/read! (Path/join (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
                  "test/fixtures/execution_history/unprotected_native_refresh.bl")))
   (let [old (BeamLisp.Env/fetch_exact! "execution.history.unprotected-native-refresh" "refresh-native-root")
         old-cache (assoc (Process/get :bl-osenv-overlay)
                    "BEAM_LISP_AOT_CACHE_DIR" (str root "/original-cache"))
         original (fn []
                    (let [saved (Process/get :bl-osenv-overlay)]
                     (try
                      (Process/put :bl-osenv-overlay old-cache)
                      (old root "producer-a" "cargo-a" build)
                      (finally (Process/put :bl-osenv-overlay saved)))))]
    ;; Each consumer must receive a receipt made by its own input algorithm.
    ;; They observe the same artifact, but never overwrite each other's receipt.
    (is (= 1 (:built (original))))
    (with-foreign-custody (c/artifact-scope artifact)
     (fn []
      (is (= :build-workspace-held (held-kind #(refresh root "producer-a" "cargo-a" build))))
      (is (= 2 @calls))
      (is (nil? (c/held-by (receipt-scope root))) "partial acquisition released the receipt claim")
      (is (= 1 (:cached (original)))
          "the original consumer accepts its receipt while another publisher owns the artifact")
      (is (= 2 @calls)))))
   (is (= 1 (:cached (refresh root "producer-a" "cargo-a" build))))
   (is (= 2 @calls)))))

(deftest a-foreign-receipt-owner-refuses-before-the-producer-is-called
 (fixture
  (fn [root calls build artifact]
   (with-foreign-custody (receipt-scope root)
    (fn []
     (is (= :build-workspace-held (held-kind #(refresh root "p" "c" build))))
     (is (= 0 @calls))
     (is (not (File/exists? artifact)))))
   (is (= 1 (:built (refresh root "p" "c" build))))
   (is (= 1 @calls)))))

(deftest multi-artifact-refusal-preserves-existing-ownership-and-unwinds-new-claims
 (fixture
  (fn [root _ _ _]
   (let [a (str root "/priv/native/a.so") z (str root "/priv/native/z.so") ran (atom false)]
    (with-foreign-custody (c/artifact-scope z)
     (fn []
      (is (= :build-workspace-held (held-kind (fn [] (c/with-artifacts! [z a] "refresh" (fn [] (reset! ran true)))))))
      (is (not @ran))
      (is (nil? (c/held-by (c/artifact-scope a))))
      (c/acquire! (c/artifact-scope a) "outer publisher")
      (try
       (is (= :build-workspace-held (held-kind #(c/with-artifacts! [a z] "refresh" (fn [] (reset! ran true))))))
       (is (c/owned? (c/artifact-scope a)))
       (is (not @ran))
       (finally (c/release! (c/artifact-scope a))))))
    (is (= :done (c/with-artifacts! [a z a] "refresh" (fn [] :done))))
    (is (nil? (c/held-by (c/artifact-scope a))))
    (is (nil? (c/held-by (c/artifact-scope z))))))))

(deftest exceptional-producers-release-publication-and-receipt-custody
 (fixture
  (fn [root calls build artifact]
   (is (thrown-with-msg? "producer exploded"
         (refresh root "p" "c" (fn [_] (throw (ex-info "producer exploded" {}))))))
   (is (nil? (c/held-by (receipt-scope root))))
   (is (nil? (c/held-by (c/artifact-scope artifact))))
   (is (= 1 (:built (refresh root "p" "c" build))))
   (is (= 1 (:cached (refresh root "p" "c" build))))
   (is (= 1 @calls)))))
