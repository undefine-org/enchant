(ns vm.native-startup-test)

;; Exercise the actual policy with an absent/then-present producer namespace.
;; The producer records invocation; it never runs Cargo or publishes a NIF.
(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/std/vm/native.bl"))]
  (BeamLisp/eval (-> source
    (String/replace "(ns vm.native\n" "(ns native-startup-policy\n")
    (String/replace "\"build\"" "\"native-startup-producer\""))))

(ns vm.native-startup-test)

(deftest empty-startup-keeps-producer-cold-and-new-roots-are-still-discovered
  (let [root (str (System/tmp_dir!) "/native-startup-" (erlang/unique_integer (list :positive)))
        src (Path/join root "src") marker (Path/join root "calls")
        run (fn [] (BeamLisp/with_cwd root
                    (fn [] (BeamLisp.Loader/with_ambient_dirs (list src)
                      (fn [] (vec (BeamLisp.Ns.Rt/invoke
                        (BeamLisp.Env/fetch_exact! "native-startup-policy" "build-all!") (list))))))))]
    (File/mkdir_p! src)
    (try
      (is (= [] (run)))
      (is (not (BeamLisp.Env/loaded_ns? "native-startup-producer"))
          "no-work startup must not need a producer namespace")
      (File/write! (Path/join src "native-startup-producer.bl")
        (str "(ns native-startup-producer)\n"
             "(defn build-native [root _] (File/write! " (pr-str marker)
             " (str root \"\\n\") (list :append)) {:artifacts [] :errors []})\n"))
      (File/mkdir_p! (Path/join root "native/tiny/src"))
      (File/write! (Path/join root "native/tiny/Cargo.toml") "[package]\nname = \"tiny\"\nversion = \"0.1.0\"\n")
      (File/write! (Path/join root "native/tiny/src/lib.rs") "// declaration-discovery fixture\n")
      (is (= [] (run)))
      (is (= (str root "\n") (File/read! marker))
          "a new root must be produced after a prior empty selection")
      (File/rename! (Path/join root "native/tiny") (Path/join root "outside"))
      (File/ln_s! (Path/join root "outside") (Path/join root "native/tiny"))
      (is (thrown? (run)) "symlinked source roots still refuse before production")
      (is (= (str root "\n") (File/read! marker)))
      (finally (File/rm_rf! root)))))
