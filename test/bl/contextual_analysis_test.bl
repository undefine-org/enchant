(ns contextual-analysis-test
 (:require [expand :as x] [codebase.phase :as code] [system.phase :as phase]
           [typed :as typed] [errors :as errors]))

(defn- program []
 (x/program [{:namespace 'example :revision 'current :file "example.bl"
              :source "(ns example) (let [x 42] x)"}] ['example 'current]))

(deftest facts-and-phase-analysis-consume-one-expanded-snapshot
 (let [p (program) facts (code/facts p) result (phase/check p)]
  (is (= (:snapshot facts) (:snapshot result)))
  (is (= :proved (:status result)))
  (is (= 2 (:references result)))
  (is (= false (:native-admission result)))
  (is (= :unknown (get-in result [:native-effects :status])))
  (is (= :refused (:status (phase/check
          (assoc p :occurrences (cons (assoc-in (first (:occurrences p)) [:reference :phase] 1)
                                      (rest (:occurrences p))))))))))

(deftest type-facts-do-not-cross-binding-identities-through-the-same-spelling
 (let [p (program) reference (:reference (first (:occurrences p)))
       node {:op :var :name "x" :ann {:binding-reference reference}}
       changed (assoc-in node [:ann :binding-reference :id] (crypto/hash :sha256 "other"))]
  (is (= #{:int} (typed/sym-type {(:id reference) #{:int} "x" #{:string}} node)))
  (is (= typed/any (typed/sym-type {(:id reference) #{:int} "x" #{:string}} changed)))
  (is (= {:arity 1} (typed/call-sig {(:id reference) {:arity 1} "x" {:arity 2}} node)))
  (is (nil? (typed/call-sig {(:id reference) {:arity 1} "x" {:arity 2}} changed)))))

(deftest original-contextual-spans-reach-the-existing-diagnostic-vocabulary
 (let [p (program) occurrence (first (:occurrences p))
       warning (errors/node->warning :phase {:kind :syntax :origin (:origin occurrence)} "Example")]
  (is (= "example.bl" (:file warning)))
  (is (= 1 (:line warning)))))
