(ns build-pipeline-image-test)

(doseq [file ["build-plan" "build-execution" "build-inputs" "unit-store" "build-image" "selfbuild"]]
  (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
        source (File/read! (Path/join root (str "priv/build/" file ".bl")))
        renamed (reduce (fn [text name]
                          (String/replace text name (str "pipeline-image-" name)))
                        source ["build-plan" "build-execution" "build-inputs" "unit-store" "build-image" "selfbuild"])]
    (BeamLisp/eval renamed)))
(ns build-pipeline-image-test (:require [build :as build]))

(defn- invoke [namespace function args]
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! (str "pipeline-image-" namespace) function) args))
(defn- contents [directory]
  (into {} (map (fn [path] [(Path/basename path) (File/read! path)])
                (filter (fn [path] (File/regular? path)) (Path/wildcard (Path/join directory "*"))))))

(deftest restored-units-feed-byte-identical-serial-and-parallel-images
  (let [scratch (Path/join (System/tmp_dir!) (str "build-image-" (System/unique_integer (list :positive))))
        root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        sdk (System/fetch_env! "BL_SDK_PRODUCT")
        sources (mapv #(Path/join root %) ["std/errors.bl" "std/proc/task.bl" "std/vm/owner.bl"])
        opts {:root root :sources sources :previous (Path/join sdk "unit-store")}
        serial-out (Path/join scratch "serial-units") parallel-out (Path/join scratch "parallel-units")
        serial (Path/join scratch "serial") parallel (Path/join scratch "parallel")
        inventory (Path/join parallel "sdk-code.term") index (Path/join parallel "precompiled.term")]
    (File/mkdir_p! scratch)
    (try
      (let [a (invoke "unit-store" "produce!" (list (assoc opts :out serial-out :jobs 1)))
            b (invoke "unit-store" "produce!" (list (assoc opts :out parallel-out :jobs 4)))
            manifest (:manifest b)]
        (is (= 0 (:compiled a)))
        (is (= 3 (:cached a)))
        (is (= (:manifest a) manifest))
        ;; Independent existing assembly remains the equivalence control.
        (build/assemble-outputs! (:manifest a) serial-out serial)
        (build/relocate-unit-sources! (:manifest a) root serial)
        (BeamLisp.AOT/write_sdk_inventory! root (:manifest a) serial (Path/join serial "sdk-code.term"))
        (build/write-precompiled-index! (:manifest a) serial (Path/join serial "precompiled.term"))
        (is (pos? (invoke "build-image" "assemble!"
                    (list manifest manifest root parallel-out parallel inventory index 4))))
        (is (= (contents serial) (contents parallel)))
        ;; A changed producer object must fail before metadata publication.
        (let [before (File/read! inventory)
              module (first (:modules (second (first manifest))))
              path (Path/join parallel-out (str (Atom/to_string module) ".beam"))]
          (File/write! path "corrupt")
          (is (= :refused (try (invoke "build-image" "assemble!"
                               (list manifest manifest root parallel-out parallel inventory index 4))
                             :accepted (catch _ :refused))))
          (is (= before (File/read! inventory))))
        (is (= [] (vec (Path/wildcard (str inventory ".units-*"))))))
      (finally (File/rm_rf! scratch)))))

(deftest parsed-facts-cross-stages-only-for-exact-content-and-generation
  (let [scratch (Path/join (System/tmp_dir!) (str "build-parts-" (System/unique_integer (list :positive))))
        a (Path/join scratch "a.bl") b (Path/join scratch "b.bl")
        first (Path/join scratch "first") second (Path/join scratch "second")
        pattern (tuple :Elixir.BeamLisp.BuildPlan :build-content-parts 1)
        calls (fn [] (elem (erlang/trace_info pattern :call_count) 1))
        reset! (fn [] (erlang/trace_pattern pattern false (list :local :call_count))
                     (erlang/trace_pattern pattern true (list :local :call_count)))]
    (File/mkdir_p! scratch)
    (try
      (File/write! a "(ns parts.a) (def value 1)")
      (File/write! b "(ns parts.b) (def value 2)")
      (reset!)
      (is (= 2 (invoke "build-image" "prime!" (list first [a b] nil 2))))
      (is (= 2 (calls)))
      (reset!)
      (is (= 2 (invoke "build-image" "prime!" (list second [a b] first 2))))
      (is (= 0 (calls)) "assembly reuses actual frames without parsing again")
      (File/write! a "(ns parts.a) (def value 3)")
      (reset!)
      (invoke "build-image" "prime!" (list second [a b] first 2))
      (is (= 1 (calls)) "edited content must parse")
      (doseq [path (Path/wildcard (Path/join first "parts/*/*"))] (File/write! path "corrupt"))
      (reset!)
      (invoke "build-image" "prime!" (list second [a b] first 2))
      (is (= 2 (calls)) "corrupt shortcuts must parse")
      (finally
        (erlang/trace_pattern pattern false (list :local :call_count))
        (File/rm_rf! scratch)))))

;; The ordinary application producer uses the same task executor. Preserve its
;; own Source namespace and initializer context rather than mutating the SDK.
(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/build/build.bl"))]
  (BeamLisp/eval (-> source
    (String/replace "(ns build\n" "(ns pipeline-image-ordinary-build\n")
    (String/replace "[build-execution :as execution]" "[pipeline-image-build-execution :as execution]"))))
(ns build-pipeline-image-test)
(deftest ordinary-build-preserves-serialized-initializers-and-warm-reuse
  (let [root (Path/join (System/tmp_dir!) (str "pipeline-ordinary-" (System/unique_integer (list :positive))))
        trace (Path/join root "trace")
        paths (mapv #(Path/join root (str % ".bl")) ["a" "b" "c"])]
    (File/mkdir_p! root)
    (try
      (doseq [[name path] (map (fn [a b] [a b]) ["a" "b" "c"] paths)]
        (File/write! path (str "(ns pipeline.ordinary." name ")\n"
          "(File/write! " (pr-str trace) " " (pr-str (str name ":start\n")) " (list :append))\n"
          "(Process/sleep 5)\n"
          "(File/write! " (pr-str trace) " " (pr-str (str name ":end\n")) " (list :append))\n")))
      (let [opts {:root root :sources paths :out (Path/join root "out") :scope :scoped :jobs 2}
            a (invoke "ordinary-build" "produce!" (list opts))
            lines (vec (String/split (String/trim (File/read! trace)) "\n"))
            b (invoke "ordinary-build" "produce!" (list opts))]
        (is (= [] (:errors a)))
        (is (= 3 (:compiled a)))
        (is (= 6 (count lines)))
        (doseq [[start end] (partition 2 lines)]
          (is (= (first (String/split start ":")) (first (String/split end ":")))))
        (is (= [] (:errors b)))
        (is (= 0 (:built b))))
      (finally (File/rm_rf! root)))))
