(ns contextual-phase-capture-test
 (:require [compiler :as compiler] [anf :as a] [expand :as x] [lower :as lower]))
(defn- reader [text] (first (BeamLisp.Reader/read_string text "phase-capture.bl")))
(defn- source [text] {:namespace 'client :revision 'v1 :source text :file "phase-capture.bl"})
(defn- refused? [action] (try (action) false (catch _ true)))

(deftest phase-captures-are-explicit-closed-callable-parameters
 (let [env (compiler/new-env "phase.capture")
       callable (compiler/compile-contextual-callable (reader "(erlang/+ input 2)") env {} (list) (list "input"))
       unit {:version 2 :kind :compiled-contextual-unit :initializers (list) :steps (list) :exports (list) :entry callable}]
  (is (= :fn (:op callable)))
  (is (= unit (a/validate-contextual-unit! unit)))
  (is (= 42 (lower/eval-anf :Elixir.ExplicitPhaseCapture (a/invoke callable (a/cons-cell (a/lit 40) (a/empty-list-node))))))
  (is (refused? #(compiler/compile-contextual-unit (reader "input") (assoc env :locals {"input" "input"}) {} (list))))
  (doseq [parameters [(list "input" "input") (list 42) ["input"]]]
   (is (refused? #(compiler/compile-contextual-callable (reader "input") env {} (list) parameters))))))

(deftest captured-phase-values-scope-over-linked-helper-initializers
 (let [text (str "(ns client) (begin-for-syntax (def offset 40) "
                 "(defn helper [x] (erlang/+ offset x))) "
                 "(defsyntax literal [form ctx] (syntax-literal (helper 2))) (literal)")
       program (x/program [(source text)] ['client 'v1])]
  (is (= 42 (lower/eval-anf :Elixir.LinkedPhaseCapture (:node program))))
  (is (= :closed (get-in program [:constructor :status])))))
