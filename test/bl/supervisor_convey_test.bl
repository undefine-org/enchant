(ns supervisor-convey-test)

(defserver context-child
  (init [arg] (ok arg))
  (handle-call :env [_from st] (reply (BeamLisp.Env/env_id) st)))

(defn- supervisor []
  (let [mod :Elixir.BeamLisp.SupervisorConveyProbe
        path (or (System/get_env "SUPERVISOR_SOURCE") (Path/join (BeamLisp/cwd) "priv/host/supervisor.bl"))
        output (str "/tmp/bl-supervisor-convey-" (erlang/unique_integer (list :positive)))
        result (BeamLisp.AOT/compile_host_file path
                 (list (tuple :module mod) (tuple :output_dir output)
                       (tuple :file path) (tuple :source_hash (crypto/hash :sha256 (File/read! path)))
                       (tuple :load? false)))]
    (try
      (code/load_binary mod (erlang/binary_to_list (elem result 1)) (File/read! (elem result 1)))
      mod
      (finally (File/rm_rf! output)))))

(deftest dynamic-child-keeps-the-spec-makers-environment
  (let [module (supervisor)
        sup (elem (DynamicSupervisor/start_link (list (tuple :strategy :one_for_one))) 1)
        fork (BeamLisp.Env/fork)
        before (BeamLisp.Env/capture)
        supervisor-env (proplists/get_value :bl_env (elem (Process/info sup :dictionary) 1))]
    (try
      (let [spec (BeamLisp.Env/with_env fork
                   (fn [] (erlang/apply module :server (list :context context-child nil {:restart :temporary}))))
            result (DynamicSupervisor/start_child sup spec)
            pid (elem result 1)]
        (is (= :ok (elem result 0)))
        (is (= fork (call pid :env)))
        (is (= supervisor-env (proplists/get_value :bl_env (elem (Process/info sup :dictionary) 1))))
        (is (= before (BeamLisp.Env/capture))))
      (finally
        (erlang/unlink sup)
        (Supervisor/stop sup)
        (BeamLisp.Env/destroy fork)))))
