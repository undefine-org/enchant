; test/bl/catch_raw_test.bl — `(try … (catch-raw [kind reason stack] …))`.
; Run: bl test test/bl/catch_raw_test.bl
;
; `catch` NORMALIZES what it catches (an :error becomes an exception struct, a
; throw of a non-exception becomes ExInfo, an :exit becomes {:exit v}) — right
; for user code, and lossy for a runtime that must RECORD a failure and REPLAY
; it unchanged: a memo cell whose thunk raised hands every waiter the same
; kind, reason and stack the evaluator saw (PLAN-151). `catch-raw` is that
; clause: the class atom, the raw reason, the raw stack `erlang/raise` accepts.

(ns catch-raw.test)

(defn- raw [f]
  (try (f) (catch-raw [kind reason stack] [kind reason stack])))

(deftest binds-the-class-and-the-unnormalized-reason
  (is (= [:throw :boom] (take 2 (raw (fn [] (erlang/throw :boom))))))
  (is (= [:exit :bye] (take 2 (raw (fn [] (erlang/exit :bye))))))
  (is (= [:error :badthing] (take 2 (raw (fn [] (erlang/error :badthing))))))
  (is (= :error (first (raw (fn [] (erlang/error (Elixir.ArgumentError/exception "x")))))))
  (is (= "x" (:message (second (raw (fn [] (erlang/error (Elixir.ArgumentError/exception "x")))))))
      "an exception reason arrives as the struct itself, untouched"))

(deftest the-stack-reraises-bit-for-bit
  (let [[k r s] (raw (fn [] (erlang/error :inner)))
        [k2 r2 _] (raw (fn [] (erlang/raise k r s)))]
    (is (= [:error :inner] [k2 r2]))))

(deftest the-body-value-passes-through
  (is (= 42 (try 42 (catch-raw [k r s] :never)))))

(deftest finally-still-runs
  (let [a (atom 0)]
    (is (= 1 (try (erlang/throw 1) (catch-raw [k r s] r) (finally (swap! a inc)))))
    (is (= 1 @a))))

(deftest ordinary-catch-is-unchanged
  (is (= "x" (ex-message (try (erlang/error (Elixir.ArgumentError/exception "x"))
                              (catch e e))))))
