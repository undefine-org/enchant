; test/bl/model_test.bl — which copy of the embedding weights answers.
; Run: bl test test/bl/model_test.bl
;
; Ported from the ExUnit `test/beam_lisp/model_test.exs`. `model` decides WHICH
; copy of the embedding weights answers, and every way that decision can go
; wrong is invisible: semantic search degrades to "the model weights are not on
; disk", which reads as a missing feature rather than a resolution bug. So the
; rules are pinned here, against real directories, with the marker the fetch
; actually writes.
;
; Isolation. A private ordinary copy of the selected SDK's model Source changes
; only its bundled-root provider. The bundle uses a private temporary directory;
; the ambient cache uses a unique fixture name after the pin is cleared.
; The environment pin is saved, cleared for the run, and restored, so a run
; cannot read or leave the machine's real model selection. (`bl test` already
; isolates each file; the save/restore makes this one self-contained too.)

(ns model.test
  (:require [model]))

; Keep every tier/absence rule from the actual selected implementation, while
; providing a writable bundle root. This creates ordinary test code at a fresh
; namespace; it neither replaces model's SDK code nor grants SDK authority.
(let [namespace (str "fixture.model-test-" (erlang/unique_integer (list :positive)))
      current (BeamLisp.Env/current_ns)
      source (BeamLisp.Loader/read_source (Path/join (BeamLisp.Tiers/priv_root) "lib/model.bl"))
      provider "(Path/join (BeamLisp.Tiers/priv_root) \"embed\")"]
  (assert (= 2 (count (String/split source provider))))
  (try
    (BeamLisp.Compiler/eval_string
      (-> source
          (String/replace "(ns model)" (str "(ns " namespace ")"))
          (String/replace provider "(System/fetch_env! \"BL_MODEL_TEST_BUNDLE_ROOT\")")))
    (finally (BeamLisp.Env/in_ns current)))
  (BeamLisp.Env/add_alias current "model" namespace))

; A fetch's completion record: DIGEST is written LAST, after every weight has
; verified against its pinned sha256 — and the files it stands for are what make
; the directory readable. A complete copy is both (`model/fetched?`).
(defn- fetch!
  [dir]
  (File/mkdir_p! dir)
  (doseq [f (model/files)]
    (File/write! (Path/join dir f) "x"))
  (File/write! (Path/join dir "DIGEST")
               "75cf7a6c2171b230ad19b1e7d8e0b1aee86da5a02af8e7cacedd9921d227623c")
  dir)

(defn- restore-env
  "Put an environment variable back the way it was found: unset stays unset."
  [k v]
  (if (nil? v) (System/delete_env k) (System/put_env k v)))

(defn- with-model
  "Run `f` with a fresh per-test model name, the env pin CLEARED, and the
   bundled/ambient roots this test may fill. Resolve them only after clearing
   the pin; the caller may have retained models in a read-only Nix store input."
  [f]
  (let [name (str "model-test-" (erlang/unique_integer (list :positive)))
        directory (Path/join (System/tmp_dir!) name)
        env (model/dir-env)
        saved (System/get_env env)
        saved-bundle (System/get_env "BL_MODEL_TEST_BUNDLE_ROOT")]
    (System/delete_env env)
    (System/put_env "BL_MODEL_TEST_BUNDLE_ROOT" (Path/join directory "bundle"))
    (try
      (let [bundled (model/bundled-dir name) ambient (model/ambient-dir name)]
        (is (String/starts_with? bundled (str directory "/")))
        (assert (not (String/starts_with? ambient "/nix/store/")))
        (try
          (f {:name name :bundled bundled :ambient ambient})
          (finally (File/rm_rf! ambient))))
      (finally
        (File/rm_rf! directory)
        (restore-env "BL_MODEL_TEST_BUNDLE_ROOT" saved-bundle)
        (restore-env env saved)))))

(deftest an-explicit-pin-is-an-answer-present-means-it-and-empty-means-absent
  (with-model
    (fn [{:keys [name bundled ambient]}]
      ; With a pin, the VALUE is the ROOT and the model is its `<name>`
      ; subdirectory — `dir` is `root/name` either way, so the pin has to be
      ; written where a fetch would have written it.
      (let [root (Path/join ambient "pinned-root")
            pinned (fetch! (Path/join root name))]
        (System/put_env (model/dir-env) root)

        (is (= :env (model/tier name)))
        (is (= pinned (model/dir name)))

        ; The same pin with nothing in it is ABSENT — it does not fall through
        ; to a bundled copy that is very likely sitting in this checkout, or a
        ; test that forces absence on a machine that has the weights would be
        ; asserting nothing. (Also: the bundle is not what answered above.)
        (let [empty (Path/join ambient "empty")]
          (System/put_env (model/dir-env) empty)

          (is (= :absent (model/tier name)))
          (is (= (Path/join empty name) (model/dir name)))
          (is (not (= (model/dir name) bundled))))))))

(deftest a-bundled-copy-answers-when-nothing-pins-it
  (with-model
    (fn [{:keys [name bundled]}]
      (fetch! bundled)
      (is (= :bundled (model/tier name)))
      (is (= bundled (model/dir name))))))

(deftest the-ambient-cache-answers-when-the-bundle-has-no-copy
  (with-model
    (fn [{:keys [name bundled ambient]}]
      (File/rm_rf! bundled)
      (fetch! ambient)
      (is (= :ambient (model/tier name)))
      (is (= ambient (model/dir name))))))

(deftest weights-with-no-digest-are-not-a-copy
  (with-model
    (fn [{:keys [name ambient]}]
      (let [partial (Path/join ambient "half-downloaded")]
        (File/mkdir_p! partial)
        (File/write! (Path/join partial "model.safetensors") "weights")

        (is (not (model/fetched? partial)))

        ; …and nothing resolves to it: a partial download must not look like a
        ; model, because the digest is what identifies the vector space every
        ; stored embedding was made in.
        (is (= :absent (model/tier name)))))))

(deftest a-digest-with-no-weights-is-not-a-copy-either
  (with-model
    (fn [{:keys [name ambient]}]
      ; The converse, and the reason `fetched?` asks for both halves: a DIGEST
      ; alone is a CLAIM about weights that are not there. Reading it as
      ; complete points every later caller at a directory that cannot be
      ; opened, and the failure surfaces as a parse error instead of as
      ; "not on disk".
      (let [claim (Path/join ambient "digest-only")]
        (File/mkdir_p! claim)
        (File/write! (Path/join claim "DIGEST")
                     "75cf7a6c2171b230ad19b1e7d8e0b1aee86da5a02af8e7cacedd9921d227623c")

        (is (not (model/fetched? claim)))
        (is (= :absent (model/tier name)))

        ; And a copy missing ONE file is not a copy: the reader opens all three.
        (let [almost (fetch! (Path/join ambient "almost"))]
          (File/rm! (Path/join almost "tokenizer.json"))
          (is (not (model/fetched? almost))))))))

(deftest the-shape-of-a-model-is-declared-once
  (with-model
    (fn [{:keys [ambient]}]
      ; `code.embed/present?` and the build's payload check ask the `model`
      ; namespace what files make a model, so the three lists that once existed
      ; cannot drift apart again.
      (is (= ["config.json" "tokenizer.json" "model.safetensors"] (model/files)))

      (let [complete (fetch! (Path/join ambient "complete"))]
        (is (model/fetched? complete))))))

(deftest with-nothing-fetched-dir-names-where-a-fetch-was-expected
  (with-model
    (fn [{:keys [name bundled ambient]}]
      (is (= :absent (model/tier name)))

      ; The absent case must point at a path a fetch would fill, so the message
      ; that prints `dir` is a remedy and not a mystery.
      (is (= ambient (model/dir name)))
      (is (= [bundled ambient] (model/searched-dirs name))))))

(deftest an-inherited-readonly-model-pin-is-cleared-before-choosing-fixture-roots
  (let [env (model/dir-env) saved (System/get_env env)
        pin (or (System/get_env "BL_SDK_PRODUCT") "/nix/store/readonly-model-fixture")]
    (System/put_env env pin)
    (try
      (with-model
        (fn [{:keys [name bundled ambient]}]
          (is (nil? (System/get_env env)))
          (is (not (String/starts_with? ambient (str pin "/"))))
          (is (not (String/starts_with? bundled (str pin "/"))))
          (fetch! ambient)
          (is (= :ambient (model/tier name)))
          (fetch! bundled)
          (is (= :bundled (model/tier name)))))
      (is (= pin (System/get_env env)) "the caller's exact pin is restored")
      (finally (restore-env env saved)))))
