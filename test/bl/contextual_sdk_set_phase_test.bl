(ns contextual-sdk-set-phase-test
 (:require [compile.sdk :as sdk] [expand :as expand] [lower :as lower]))

(defn- execute [program]
 (lower/eval-anf
  (erlang/binary_to_atom (str "Elixir.SDKSetPhase" (erlang/unique_integer (list :positive))))
  (:node program)))

(deftest produced-sdk-set-imports-use-the-same-core-conj-owner-at-both-phases
 ;; Requires the newly produced SDK. The prior immutable SDK records unresolved
 ;; clojure.set/conj and remains the retained negative baseline for this case.
 (let [provider (:source (sdk/capture {:sdk 'clojure.set :revision 'selected :only ['union]}))
       source {:namespace 'set.client :revision 'current :file "set-client.bl"
               :source (str "(ns set.client) (import-world 'clojure.set 'selected :only [union]) "
                            "(begin-for-syntax (import-world 'clojure.set 'selected :only [union])) "
                            "(defsyntax answer [form ctx] (syntax-literal (union #{1 2} #{2 3}))) "
                            "[(union #{1 2} #{2 3}) (answer)]")}
       library (expand/decode-phase-library
                 (expand/encode-phase-library (expand/phase-library [provider])))]
  (is (= [#{1 2 3} #{1 2 3}]
         (execute (expand/program [provider source] ['set.client 'current]))))
  (is (= [#{1 2 3} #{1 2 3}]
         (execute (expand/program [source] ['set.client 'current] [library]))))))
