;; Compiler control: exercise the internal producer; normal build/run uses Nix.
; wave9_aot_test.bl — AOT: `.bl` sources become real BEAM modules on the code
; path, so a fresh VM loads and runs them with NO runtime compilation.
;
; Ported from the ExUnit `test/beam_lisp/wave9_aot_test.exs`. That suite reached
; the build through the Elixir shell `BeamLisp.BuildTask`; here the build goes
; straight to `priv/build/build.bl` (`build/produce!`, `build/clean`) — the driver the
; product boot path uses — with no Elixir seam in the path.
;
; The key assertion is the subprocess in "fresh VM loads the beams": that
; `elixir` child only does `Code.ensure_loaded` + `__bl_init__/0`, never the
; compiler. The last test locks in the shim/body/companion split — an AOT-loaded
; namespace must survive a runtime `(def)` churn of its own module.
;
; Fixtures build into an ISOLATED dir, never the shared production code path.
; Compiling them into the real output dir (with the `clean` that precedes it)
; deleted the AOT beams the rest of the suite depends on and left a fixture-only
; manifest, so a later module purge hit a missing body beam (nondeterministic
; `UndefinedFunctionError`). A throwaway dir added to the code path stays
; hermetic.
;
; Run: bin/bl test test/bl/wave9_aot_test.bl

(ns wave9-aot.test
  (:require [build :as b]))

; ── fixtures, built once into an isolated dir ───────────────────────────────

(def fixture-dir (Path/join (BeamLisp/cwd) "test/fixtures/aot"))

(def compile-path
  "A THROWAWAY output dir. The value is load-bearing: the child VM's
   `loaded_from=` assertion pins `Ns.Math` to exactly this path."
  (Path/join (System/tmp_dir!) "beam_lisp_aot_fixtures"))

(def math-mod :Elixir.BeamLisp.Ns.Math)
(def hello-mod :Elixir.BeamLisp.Ns.Hello)
(def greeter-mod :Elixir.BeamLisp.Ns.Greeter)

(defn- discover
  "Every source `BuildTask.discover` would have found: plain `.bl` and the
   literate `.bl.md`/`.bl.org` documents, sorted."
  [dir]
  (sort (distinct
          (mapcat (fn [ext] (Path/wildcard (Path/join dir (str "**/*" ext))))
                  (to-list (BeamLisp.Loader/doc_extensions))))))

(defn- beam-path [mod] (Path/join compile-path (str mod ".beam")))

(defn- beam-mtime [mod] (:mtime (File/stat! (beam-path mod))))

(defn- clean! [] (b/clean compile-path (b/manifest-path compile-path)))

(defn- build-fixtures!
  "Compile the fixture set through the production driver; return `build/produce!`'s
   map (`:built`, `:errors`)."
  []
  (b/produce! {:sources (discover fixture-dir)
          :out compile-path
          :manifest (b/manifest-path compile-path)
          :jobs 2}))

(defn- setup!
  "The ExUnit `setup_all`: a clean slate, then ONE build of the fixture set, then
   the isolated dir on the code path. A failed build is fatal, exactly as the
   ExUnit `assert {:ok, []}` was — a fixture that did not compile must not read
   as a passing suite (and ward cannot report an `is` recorded outside a deftest:
   `run_ns` resets the counters when it starts)."
  []
  (clean!)
  (let [r (build-fixtures!)]
    (when (pos? (count (:errors r)))
      (erlang/error (str "AOT fixture build failed: " (pr-str (:errors r)))))
    (when-not (pos? (:built r))
      (erlang/error "AOT fixture build compiled nothing"))
    (Code/append_path compile-path)
    ; Intern the fixture namespaces exactly as a fresh VM's boot would. The
    ; ExUnit suite relied on a sibling module having already interned them in
    ; its long-lived VM; ward runs this file in its own fork off a warm base,
    ; so the prerequisite is STATED here instead of inherited. Successful load
    ; and the exact emitted path are required: the point is the AOT BEAM, and a
    ; source fallback would let every assertion below pass without testing it.
    (BeamLisp.Loader/with_search_dir fixture-dir
     (fn []
      (doseq [ns (list "math" "hello" "greeter")]
       (let [loaded (BeamLisp.Loader/ensure_loaded ns)
             mod (BeamLisp.Emit/module_for ns)]
        (when (or (not= :ok loaded)
                  (not= (Path/expand (beam-path mod))
                        (Path/expand (erlang/list_to_binary (code/which mod)))))
          (erlang/error (str "fixture ns " ns " did not load from its AOT beam: "
                             (pr-str loaded))))))))
    r))

; Build once at load: the deftests below observe the built state, mirroring the
; ExUnit module-level `setup_all` (which both compiled and code-pathed them).
(def fixtures (setup!))

; ── emitted modules ─────────────────────────────────────────────────────────

(deftest emits-one-beam-module-per-namespace
  (doseq [mod (list math-mod hello-mod greeter-mod)]
    (is (File/exists? (beam-path mod)) (str "missing " (beam-path mod)))))

(deftest compiled-modules-answer-correctly-in-process
  (is (= 36 (BeamLisp.Ns.Math/square 6)))
  (is (= 15 (BeamLisp.Ns.Math/add 7 8)))
  ; value def read from a defn body, re-interned by __bl_init__/0
  (is (= 126 (BeamLisp.Ns.Math/answer-mul 3)))
  (is (= "answer=42" (BeamLisp.Ns.Math/describe)))
  ; macro defined and used in the same file
  (is (= 42 (BeamLisp.Ns.Math/double 21)))

  ; Three clauses of ONE arity, chosen by their `:when` guards. This is the
  ; AOT-specific risk: the generated namespace module holds shims, and a shim
  ; that dropped its guard would forward every call to the first clause —
  ; `sign(-1)` would answer `:positive`.
  (is (= :positive (BeamLisp.Ns.Math/sign 5)))
  (is (= :negative (BeamLisp.Ns.Math/sign -5)))
  (is (= :zero (BeamLisp.Ns.Math/sign 0)))
  (is (= "hi, world!" (BeamLisp.Ns.Hello/greet "world")))
  (is (= "LOUD" (BeamLisp.Ns.Hello/shout "loud")))
  ; cross-ns :require + :refer + :as all resolve
  (is (= "hi, aot! | 16 | LOUD" (BeamLisp.Ns.Greeter/report 4)))

  ; fn *values* are interned as captures, so `map f` / RT.invoke work
  (let [sumv (elem (BeamLisp.Env/fetch "math" "sum") 1)
        addv (elem (BeamLisp.Env/fetch "math" "add") 1)]
    (is (= 10 (BeamLisp.Ns.Rt/invoke sumv (list 1 2 3 4))))
    (is (= 19 (BeamLisp.Ns.Rt/invoke addv (list 9 10))))))

; ── a fresh VM, no runtime compilation ──────────────────────────────────────

(defn- fresh-vm-script []
  (str
    "(ns fixture.wave9-cold)\n"
    "(Code/prepend_path " (pr-str compile-path) ")\n"
    "(BeamLisp.Loader/with_search_dir " (pr-str fixture-dir) " (fn [] "
    "(doseq [n [\"math\" \"hello\" \"greeter\"]] "
    "(assert (= :ok (BeamLisp.Loader/ensure_loaded n))) "
    "(assert (= (str " (pr-str compile-path) " \"/\" (BeamLisp.Emit/module_for n) \".beam\") "
    "(erlang/list_to_binary (code/which (BeamLisp.Emit/module_for n))))))))\n"
    "(println (str \"loaded_from=\" (erlang/list_to_binary (code/which :Elixir.BeamLisp.Ns.Math))))\n"
    "(println (str \"has_bl_init=\" (erlang/function_exported :Elixir.BeamLisp.Ns.Math :__bl_init__ 0)))\n"
    "(println (str \"square=\" (BeamLisp.Ns.Math/square 9)))\n"
    "(println (str \"answer_mul=\" (BeamLisp.Ns.Math/answer-mul 3)))\n"
    "(println (str \"double=\" (BeamLisp.Ns.Math/double 21)))\n"
    "(println (str \"greet=\" (BeamLisp.Ns.Hello/greet \"world\")))\n"
    "(println (str \"report=\" (BeamLisp.Ns.Greeter/report 3)))\n"))

(deftest fresh-vm-loads-the-beams-with-no-runtime-compilation
  ; Boot the exact selected SDK normally; add only the ordinary fixture beams.
  (let [file (str compile-path ".cold.bl")
        cli (or (System/get_env "BL_QUALIFY_CANDIDATE")
                (when-let [sdk (System/get_env "BL_SDK_PRODUCT")] (Path/join sdk "bin/bl"))
                (Path/join (BeamLisp/cwd) "bin/bl"))
        _ (File/write! file (fresh-vm-script))]
   (try
    (let [r (System/cmd cli (list "--cold" "run" file)
                           (list (tuple :stderr_to_stdout true)))
          text (elem r 0)]
    (is (= 0 (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))
    (is (includes? text (str "loaded_from=" compile-path)))
    (is (includes? text "has_bl_init=true"))
    (is (includes? text "square=81"))
    (is (includes? text "answer_mul=126"))
    (is (includes? text "double=42"))
    (is (includes? text "greet=hi, world!"))
    (is (includes? text "report=hi, aot! | 9 | LOUD")))
    (finally (File/rm! file)))))

; ── incremental: nothing to rebuild ─────────────────────────────────────────

(deftest second-run-recompiles-nothing
  (let [before (map (fn [mod] (list mod (beam-mtime mod))) (list math-mod hello-mod))
        r (build-fixtures!)]
    (is (= [] (vec (:errors r))))
    ; BuildTask answered `{:noop, []}` here: nothing rebuilt, nothing failed.
    (is (= 0 (:built r)) "a second build of unchanged sources must build nothing")
    (doseq [pair before]
      (is (= (second pair) (beam-mtime (first pair)))
          "an unchanged source must not rewrite its beam"))))

; ── clean removes the beams and the manifest ────────────────────────────────

(deftest clean-removes-generated-modules-and-the-manifest
  (is (File/exists? (beam-path math-mod)))

  (clean!)

  (is (not (File/exists? (beam-path math-mod))))
  (is (not (File/exists? (Path/join compile-path "compile.beam_lisp"))))

  ; Recompile so the rest of the suite still sees them.
  (let [r (build-fixtures!)]
    (is (= [] (vec (:errors r))))
    (is (pos? (:built r)) "the post-clean rebuild must compile")))

; ── regression: an AOT-loaded namespace survives module version churn ───────
;
; This is the failure that motivated the shim/body/companion split. AOT used to
; splice real fn code and macro-expander closures directly into the
; `BeamLisp.Ns.<Ns>` module. A later runtime `(def)` into that namespace reloads
; it; the BEAM keeps two versions and purges the oldest on the third load,
; stranding every fn capture and macro closure that lived in the reloaded module
; — `(math/square 3)` and the `twice` macro would raise BadFunctionError /
; "undefined function …Ns.Fn.M<n>". The fix houses real code in a never-reloaded
; `BeamLisp.Ns.Body.<Ns>` and macro closures in `BeamLisp.Ns.Init.<Ns>`; only the
; thin shim module churns. This test locks that in by churning `math` and then
; using both a fn and a macro from it.

(deftest an-aot-loaded-namespace-survives-runtime-def-churn-of-its-module
  (BeamLisp.Loader/with_search_dir fixture-dir #(BeamLisp.Loader/ensure_loaded "math"))

  ; Sanity: the fn and the macro work before any churn.
  (is (= 25 (BeamLisp/eval "(math/square 5)")))
  (is (= 14 (BeamLisp/eval "(math/twice 7)")))

  ; Churn the `math` namespace hard: each `(def)` rebuilds the shim module, and
  ; the BEAM purges an old version every third load. Four is comfortably past
  ; the purge threshold.
  (doseq [i (list 1 2 3 4)]
    (BeamLisp.Compiler/eval_string (str "(defn churn" i " [] " i ")")
                                   (BeamLisp.Compiler/new_env "math")))

  ; The AOT-loaded fn still runs: its code lives in Ns.Body.Math, never
  ; reloaded, so the capture the shim forwards to was never purged.
  (is (= 36 (BeamLisp/eval "(math/square 6)")))
  (is (= 19 (BeamLisp/eval "(math/add 9 10)")))

  ; The AOT-loaded MACRO still expands: its expander closure lives in
  ; Ns.Init.Math, also never reloaded.
  (is (= 16 (BeamLisp/eval "(math/twice 8)"))))
