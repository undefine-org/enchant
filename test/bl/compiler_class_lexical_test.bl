(ns compiler-class-lexical-test
 (:require [compiler :as compiler] [lower :as lower] [anf :as a] [reload.generated-class :as boundary]))
(defn- form [text] (first (BeamLisp.Reader/read_string text "class-lexical.bl")))
(defn- namespace! [] (str "class.lexical.n" (erlang/unique_integer (list :positive))))
(defn- refused? [f] (try (f) false (catch _ true)))
(defn- execute [prepared] (lower/eval-anf :Elixir.ClassLexicalInitializer (:lexical-node prepared)))
(defn- reference [name]
 {:version 1 :kind :binding-reference :world (crypto/hash :sha256 "class-world")
  :declaration (crypto/hash :sha256 name) :id (crypto/hash :sha256 (str "ref:" name)) :space 'value :phase 0})

(deftest lexical-class-frame-uses-original-constructors-without-namespace-publication
 (let [scope (BeamLisp.Env/fork)]
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (doseq [[head kind module] [["defrecord" :record :Elixir.ClassLexicalRecord]
                                ["deftype" :deftype :Elixir.ClassLexicalType]]]
      (let [namespace (namespace!) prepared (compiler/prepare-class-declaration
                          (form (str "(" head " Packet [payload])")) (compiler/new-env namespace) module)]
       (try
        (is (= module (:module (boundary/lexical! (:lexical-node prepared) namespace "Packet" kind #{} (fn [_] nil)))))
        (is (= (if (= :record kind) [1 2 3] [1 2]) (vec (map :index (:binding-slots prepared)))))
        (is (= prepared (BeamLisp.CompilerData/check_compiler_data! prepared)))
        (let [frame (execute prepared) value (BeamLisp.Ns.Rt/invoke (elem frame 1) (list 42))]
         (is (= module (elem frame 0)))
         (is (= (if (= :record kind) (Map/put {:payload 42} :__struct__ module)
                    (tuple :bl_deftype module (tuple 42))) value))
         (if (= :record kind)
          (is (= value (BeamLisp.Ns.Rt/invoke (elem frame 2) (list {:payload 42}))))
          (is (= 2 (erlang/tuple_size frame)))))
        (doseq [binding (:bindings prepared)]
         (is (= :error (BeamLisp.Env/lookup (tuple namespace (str (:name binding)))))))
        (finally (BeamLisp.Env/retire_module! module)))))))
   (finally (BeamLisp.Env/destroy scope)))))

(deftest lexical-projection-retains-inline-protocol-order-and-delayed-methods
 (let [scope (BeamLisp.Env/fork) module :Elixir.ClassLexicalProtocol namespace (namespace!)]
  (try
   (BeamLisp.Env/with_env scope
    (fn []
     (BeamLisp.Multi/define_protocol namespace "Proto" (list "read"))
     (let [prepared (compiler/prepare-class-declaration
                      (form "(defrecord Packet [payload] Proto (read [this] (erlang/put :class-lexical-method :called)))")
                      (compiler/new-env namespace) module)
           checked (atom [])
           class (boundary/lexical! (:lexical-node prepared) namespace "Packet" :record #{namespace} #(swap! checked conj %))]
      (is (= 1 (count @checked)))
      (is (= ["read"] (get-in class [:extensions 0 :methods])))
      (is (= :undefined (erlang/erase :class-lexical-method)))
      (let [frame (execute prepared) value (BeamLisp.Ns.Rt/invoke (elem frame 1) (list 42))]
       (is (= :undefined (erlang/get :class-lexical-method)))
       (is (= :undefined (BeamLisp.Multi/dispatch_protocol namespace "Proto" "read" (list value))))
       (is (= :called (erlang/erase :class-lexical-method)))
       (is (= :error (BeamLisp.Env/lookup (tuple namespace "Packet"))))))))
   (finally (erlang/erase :class-lexical-method) (BeamLisp.Env/destroy scope) (BeamLisp.Env/retire_module! module)))))

(deftest lexical-boundary-refuses-extra-calls-swapped-values-and-corrupted-descriptors
 (let [namespace (namespace!) prepared (compiler/prepare-class-declaration
                   (form "(defrecord Packet [payload])") (compiler/new-env namespace) :Elixir.ClassLexicalCorrupt)
       node (:lexical-node prepared) check #(boundary/lexical! % namespace "Packet" :record #{} (fn [_] nil))
       values (get-in node [:body :init :elems])]
  (is (refused? #(check (assoc-in node [:body :init :elems] (reverse values)))))
  (is (refused? #(check (assoc-in node [:body :body :stmts]
                          (list (a/remote :erlang :put (list (a/lit :lexical-bypass) (a/lit true))) (a/var "__class_bindings__"))))))
  (is (refused? #(check (assoc-in node [:init :args]
                         (list (a/lit (assoc (:descriptor prepared) :clauses (list))))))))
  (is (refused? #(check (:node prepared))))
  (is (= :undefined (erlang/get :lexical-bypass)))
  (is (not (erlang/module_loaded :Elixir.ClassLexicalCorrupt)))))

(deftest one-lexical-initializer-feeds-multiple-selected-exports-in-the-existing-unit
 (let [namespace (namespace!) module :Elixir.ClassLexicalUnit
       prepared (compiler/prepare-class-declaration (form "(defrecord Packet [payload])") (compiler/new-env namespace) module)
       init {:name "class" :reference (reference "class") :slot "frame" :node (:lexical-node prepared)}
       rows (cons init (to-list (map (fn [slot]
                             {:name (str (:name slot)) :reference (reference (str (:name slot)))
                              :slot (str "class_slot_" (:index slot))
                              :node (a/remote :erlang :element (list (a/lit (:index slot)) (a/var "frame")))})
                           (:binding-slots prepared))))
       unit {:version 2 :kind :compiled-contextual-unit :initializers (to-list rows)
             :steps (to-list (map (fn [row] {:op :initialize :reference (:reference row)}) rows))
             :entry (a/var "class_slot_1") :exports (to-list (map :reference (rest rows)))}]
  (try
   (let [instance (lower/eval-anf :Elixir.ClassLexicalUnitFactory (a/contextual-unit-factory unit))
         exports (:exports instance)
         ctor (get exports (reference "->Packet")) map-ctor (get exports (reference "map->Packet"))]
    (is (= module ((:entry instance))))
    (is (= module (get exports (reference "Packet"))))
    (is (= (Map/put {:payload 42} :__struct__ module) (BeamLisp.Ns.Rt/invoke ctor (list 42))))
    (is (= (BeamLisp.Ns.Rt/invoke ctor (list 42)) (BeamLisp.Ns.Rt/invoke map-ctor (list {:payload 42}))))
    (is (= :error (BeamLisp.Env/lookup (tuple namespace "Packet")))))
   (finally (BeamLisp.Env/retire_module! module)))))
