(ns contextual-library-compat-test (:require [expand :as x] [lower :as lower]))
(defn- fixture [name]
 (File/read! (Path/join (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
                      (str "test/fixtures/phase-library-schemas/" name ".etf"))))
(deftest older-data-converts-once-to-revision-qualified-library-identities
 (doseq [version ["v1" "v2"]]
  (let [restored (x/decode-phase-library (fixture version))
        program (x/program [{:namespace 'client :revision 'v1 :file "client.bl"
                             :source "(ns client) (import-world 'library 'v1 :only [result]) (result)"}]
                    ['client 'v1] [restored])]
   (is (= 3 (:version restored)))
   (is (= restored (x/decode-phase-library (x/encode-phase-library restored))))
   (is (every? #(every? (fn [row] (contains? row :only-origins)) (:imports %)) (:units restored)))
   (is (every? #(= (:revision %) (:revision (first (get-in % [:world :selection :sources])))) (:units restored)))
   (is (= 42 (lower/eval-anf (erlang/binary_to_atom (str "Elixir.ConvertedVersion." version)) (:node program)))))))
