(ns contextual-library-compat-test (:require [expand :as x] [lower :as lower]))

(defn- unit [namespace source]
 {:namespace namespace :revision 'current :file (str namespace ".bl") :source source})

(deftest version-one-data-converts-once-to-the-current-library-schema
 (let [current (x/phase-library
                 [(unit 'base "(ns base) (defn amount [] 40)")
                  (unit 'library
                    (str "(ns library) (import-world 'base 'current :only [amount]) "
                         "(defn answer [] (erlang/+ (amount) 2))"))])
       ;; Reconstruct the previous data schema. This is a format test, not
       ;; producer authentication or an SDK admission fixture.
       previous (-> current (assoc :version 1)
                   (update :units
                    #(Enum/map % (fn [unit]
                       (update unit :imports (fn [rows] (Enum/map rows (fn [row] (dissoc row :only-origins))))))))
                   (dissoc :digest))
       previous (assoc previous :digest
                  (crypto/hash :sha256 (erlang/term_to_binary previous (list :deterministic))))
       restored (x/decode-phase-library (erlang/term_to_binary previous (list :deterministic)))
       program (x/program [(unit 'client
                             "(ns client) (import-world 'library 'current :only [answer]) (answer)")]
                          ['client 'current] [restored])]
  (is (= 2 (:version current)))
  (is (= 2 (:version restored)))
  (is (= restored (x/decode-phase-library (x/encode-phase-library restored))))
  (is (every? #(every? (fn [row] (contains? row :only-origins)) (:imports %)) (:units restored)))
  (is (= 42 (lower/eval-anf :Elixir.ContextualPreviousLibrary (:node program))))))
