(ns aot-reader-cache-test)

(deftest reader-evidence-retains-guard-accounting-identity-and-pass-bounds
 ;; Fixed native component harness: real kernel proofs and an owned private
 ;; Env; no application identity is cleared or supplied callback admitted.
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       before (BeamLisp.Env/capture)]
  (Code/eval_file (Path/join root "research/fresh-preparation/reader-guards.exs"))
  (is (= before (BeamLisp.Env/capture)))
  (is (nil? (Process/get :bl_constructor_reader_cache)))
  (is (nil? (Process/get :bl_constructor_reader_guard_capture)))))
