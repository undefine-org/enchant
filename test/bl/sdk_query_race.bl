;; Fault injection changes the private query edge, never a protected SDK route.
;; The cache actor itself must retain its actual attested SDK declaration.
(ns test.bl.sdk-query-race (:require [data.bounded-cache :as cache]))
(def LOOKUP-HOOKS (atom {}))
(defn lookup [name key revision]
 (let [answer (cache/lookup name key revision)]
  (when-let [hook (get @LOOKUP-HOOKS name)] (hook answer))
  answer))
(defn with-lookup-hook [private hook action]
 (let [name (:name private) old (get @LOOKUP-HOOKS name)]
  (swap! LOOKUP-HOOKS assoc name hook)
  (try (action)
   (finally (if old (swap! LOOKUP-HOOKS assoc name old) (swap! LOOKUP-HOOKS dissoc name))))))
(defn with-engine [action]
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       id (str "query-race-" (erlang/unique_integer (list :positive)))
       dir (Path/join (System/tmp_dir!) id)
       agg-ns (str id ".agg") engine-ns (str id ".engine")
       cache-name (keyword id "results") modules (atom []) previous (BeamLisp.Env/capture)
       rename (fn [source]
        (-> source (String/replace "datom.query.agg" agg-ns)
                   (String/replace "datom.query.engine" engine-ns)
                   (String/replace ":datom.query.results" (str ":" id "/results"))))]
  (File/mkdir_p! dir)
  (try
   (doseq [[file suffix] [["priv/lib/datom/query/agg.bl" "agg"]
                          ["priv/lib/datom/query/engine.bl" "engine"]]]
    (let [path (Path/join dir (str suffix ".bl")) raw (rename (File/read! (Path/join root file)))
          source (if (= "engine" suffix)
                   (do
                    (when-not (= 2 (count (String/split raw "(cache-data/lookup ")))
                     (throw (ex-info "The private query fixture needs its actual lookup edge" {})))
                    (String/replace raw "(cache-data/lookup " "(test.bl.sdk-query-race/lookup ")) raw)]
     (File/write! path source)
     (let [beams (BeamLisp.AOT/compile_file path (list (tuple :output_dir dir) (tuple :mark_loaded? true)))]
      (swap! modules into (mapv #(elem % 0) beams)))))
   (when-not (cache/ready! cache-name)
    (throw (ex-info "The real SDK cache owner must initialize before a query race" {})))
   (action {:agg agg-ns :engine engine-ns :name cache-name
            :query (fn [& args]
                    (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! engine-ns "q") (to-list args)))})
   (finally
    (swap! LOOKUP-HOOKS dissoc cache-name)
    (when-let [owner (Process/whereis cache-name)] (core/stop owner))
    (BeamLisp.Env/bind previous)
    (doseq [module @modules] (code/purge module) (code/delete module))
    (File/rm_rf! dir)))))
