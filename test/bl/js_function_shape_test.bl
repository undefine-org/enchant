(ns js-function-shape-test
 (:require [anf :as a] [compiler :as compiler] [js.emit :as emit] [bl.util :as u]))

(defn- js-effect [message]
 (compiler/compile (BeamLisp.Reader/read_one (str "(js/console.log " (pr-str message) ")"))
  (assoc (compiler/new-env "shape.js") :target :js :js-interop true)))
(defn- execute [node suffix]
 (emit/reset-state!)
 (let [result (emit/emit node {:ns "shape.js" :dest nil :invoke "null"})
       runtime (Path/dirname (BeamLisp.Loader/source_path "js.emit"))
       script (str "import * as R from " (emit/js-str (str "file://" runtime "/rt.mjs")) ";\n"
                "import * as C from " (emit/js-str (str "file://" runtime "/actor/module.mjs")) ";\n"
                "import * as J from " (emit/js-str (str "file://" runtime "/interop.mjs")) ";\n"
                (join "\n" (emit/kw-decls)) "\n" (join "\n" (:lines result))
                "\nconst value=" (:val result) ";" suffix)]
  (System/cmd "node" (list "--input-type=module" "-e" script) (list (tuple :stderr_to_stdout true)))))
(defn- plain [] (a/fnn (list (a/clause (list) nil (a/lit 42)))))

(deftest a-lookalike-self-scaffold-keeps-its-executable-argument
 (let [outer (a/fnn (list (a/clause (list (a/pvar "self")) nil (plain))))
       node (a/lett "self" outer (a/app (a/var "self") (list (js-effect "argument"))))
       result (execute node "console.log(value());")]
  (is (= 0 (elem result 1)) (elem result 0))
  (is (= "argument\n42\n" (elem result 0)))))

(deftest a-string-tag-is-data-rather-than-a-native-dispatcher
 (let [node (a/tup (list (a/lit "$blfn") (a/mapp (list [(a/lit 0) (plain)])) (a/lit nil)))
       result (execute node "console.log(typeof value);")]
  (is (= 0 (elem result 1)) (elem result 0))
  (is (= "object\n" (elem result 0)))))

(deftest a-noncanonical-dispatch-field-is-evaluated-as-data
 (let [node (a/tup (list (a/lit :"$blfn") (a/mapp (list)) (js-effect "field")))
       result (execute node "console.log(typeof value);")]
  (is (= 0 (elem result 1)) (elem result 0))
  (is (= "field\nobject\n" (elem result 0)))))
