(ns native-execution-managed-test
 (:require [reload.generation :as generation] [reload.execution :as execution]))

(deftest native-registrations-capture-the-admitted-managed-graph-and-keep-its-code
 (let [graph (generation/prepare!
              {:application-id "native-registration-managed"
               :stable-namespaces #{"reload.execution"}
               :sources {"native.registration"
                 (str "(ns native.registration (:require [reload.execution :as execution])) "
                      "(defn callback [] (fn [] (execution/owned?)))")}})
       receiver (spawn (fn [] (receive :stop nil (after 30000 nil))))
       registration (generation/with! graph
                      #(BeamLisp.Execution/register!
                         (generation/invoke! graph "native.registration/callback" [])))
       prepared (BeamLisp.Execution/prepare-handoff! registration receiver)]
  (try
   (is (not (execution/owned?)))
   (is (= {:status :completed :value true} (BeamLisp.Execution/invoke! registration [])))
   (is (= :accepted (:status (BeamLisp.Execution/accept-handoff! prepared))))
   (is (= {:status :cancelled} (BeamLisp.Execution/invoke! registration [])))
   (is (= :waiting (:status (generation/retire! graph))))
   (is (= {:status :completed :value true} (BeamLisp.Execution/invoke! (:accepted prepared) [])))
   (BeamLisp.Execution/close! (:accepted prepared))
   (is (= {:status :cancelled} (BeamLisp.Execution/invoke! (:accepted prepared) [])))
   (is (= :retired (:status (generation/retire! graph))))
   (is (not (execution/owned?)))
   (finally (BeamLisp.Execution/close! registration) (BeamLisp.Execution/close! (:accepted prepared))
    (erlang/send receiver :stop) (generation/retire! graph)))))
