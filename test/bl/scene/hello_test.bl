(ns scene.hello-test (:require [scene-demo.hello :as art] [scene.core :as s]))
(def prepared (art/prepare {:font-dir "examples/scene-renderer/assets/fonts"}))
(defn world-items [t] (filter (fn [v] (String/starts_with? (:id v) "world/")) (:items (art/frame prepared t))))
(deftest truthful-measurement-and-continuity
 (let [short (art/artwork prepared 8) long (art/artwork prepared 12)
       frames (mapv (fn [t] (art/frame prepared t)) [0 8 12 17 23 27 30 33 36 42 48 54 59])]
  (is (> (nth (:box (first (:worlds long))) 2) (nth (:box (first (:worlds short))) 2)))
  (is (contains? (:fonts (:shaping prepared)) "Nunito.ttf"))
  (is (every? (fn [f] (= 24 (count (:semantic-ids f)))) frames))
  (is (every? (fn [f] (every? (fn [v] (every? s/finite? (:matrix v))) (:items f))) frames))
  (is (= (vec (world-items 30)) (vec (world-items 33))))
  (is (= (art/frame prepared 12.3) (last (mapv (fn [t] (art/frame prepared t)) [59 0 43 8 12.3]))))
  (is (try (art/frame prepared 60) false (catch _ true)))
  (is (= [8 3 12 8] (mapv art/project-time [30 31.7 32.1 33])))
  (is (= 12 (:shot (art/frame prepared 59))))))
