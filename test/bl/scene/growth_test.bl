(ns scene.growth-test
  (:require [scene-demo.growth :as art] [scene.core :as s] [scene.clip :as clip]))
(def prepared (art/prepare {:font-dir "examples/scene-renderer/assets/fonts"}))
(deftest authored-study-is-sampleable-and-valid
  (let [reference (art/scene prepared 8.2)]
    (is (= reference (last (mapv (fn [t] (art/scene prepared t)) [11 0 3 5 8.2]))))
    (is (every? (fn [t] (map? (s/validate (art/scene prepared t)))) [0 0.5 2 5 6 9.5 (/ 287 24)]))
    (is (= 12 (:duration art/schedule)))
    (is (= 7.625 (get (:cues art/schedule) "growth/germination/unfold/plant/flower")))
    (is (= 3.2 (:local-time (first (filter (fn [v] (= :plant (:content v))) (clip/sample art/schedule 6))))))
    (is (try (art/scene prepared 12) false (catch _ true)))))
(deftest type-uses-canonical-outlines-and-fits-its-authored-width
  (is (every? (fn [[id run]] (and (seq (:commands run)) (string? (:path run)))) (:runs prepared)))
  (is (< (nth (:logical (get (:runs prepared) "title-italic")) 2) 968))
  (is (< (nth (:logical (get (:runs prepared) "note-branch")) 2) 232)))
