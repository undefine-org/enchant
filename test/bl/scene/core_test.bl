(ns scene.core-test (:require [scene.core :as s] [scene-demo.film :as film]))
(deftest seeking-is-independent-of-history
  (let [times [0 3.99 4 7.99 8 11.99]
        expected (mapv film/scene times)]
    (doseq [t [11 2 8 1]] (s/svg (film/scene t)))
    (is (= expected (mapv film/scene times)))
    (is (= [0 0 1 1 2 2] (mapv :scene expected)))))
(deftest clock-and-easing-boundaries
  (is (= 0 (s/progress -1 0 1)))
  (is (= 1 (s/progress 1 0 0)))
  (is (= 0 (s/ease 0))) (is (= 1 (s/ease 1)))
  (is (= 1 (s/frame-time 30 30 1))))
(deftest svg-contains-required-graphics
  (let [svg (s/svg (film/scene 1))]
    (is (includes? svg "clip-path="))
    (is (includes? svg "rotate("))
    (is (includes? svg "<text"))
    (is (includes? svg "<circle"))))
(defn rejects? [f] (try (f) false (catch _ true)))
(deftest invalid-scenes-have-diagnostics
  (is (rejects? (fn [] (film/scene -1))))
  (is (rejects? (fn [] (film/scene 12))))
  (is (rejects? (fn [] (s/frame-time -1 30 1))))
  (is (rejects? (fn [] (s/svg (assoc (film/scene 0) :width -1)))))
  (is (rejects? (fn [] (s/validate-object {:id "bad" :kind :unknown}))))
  (is (rejects? (fn [] (s/validate-object {:id "bad" :kind :rect :attrs {:width -1}})))))
(deftest duplicate-ids-are-rejected
  (let [scene (film/scene 1)]
    (is (rejects? (fn [] (s/svg (assoc scene :objects (conj (:objects scene) (first (:objects scene))))))))))
