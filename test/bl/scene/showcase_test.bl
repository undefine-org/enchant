(ns scene.showcase-test
 (:require [scene-demo.showcase :as art] [scene.core :as scene]))

(deftest material-study-seeks-preserve-finite-geometry-and-identities
 (let [times [0 0.6 3.75 7.5 11.25 15 18.75 22.5 26.25 29.99]
       frames (mapv art/sample times)
       ids (mapv :id art/typography)]
  (doseq [frame frames]
   (is (= ids (mapv :id (:types frame))))
   (is (= 16 (count (:view-projection frame))))
   (is (every? scene/finite? (:view-projection frame)))
   (is (every? scene/finite? (:eye frame)))
   (is (< (abs (- 1 (reduce + 0 (:shape frame)))) 0.000001))
   (is (every? #(<= 0 % 1) (:shape frame))))
  (is (= (art/sample 12.34) (last (mapv art/sample [29 0 20 4 12.34]))))
  (doseq [time [-1 30]]
   (is (try (art/sample time) false (catch _ true))))))
