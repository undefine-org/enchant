(ns scene.frame-plan-test (:require [scene-demo.frame-plan :as plan]))
(deftest review-is-bounded-and-film-keeps-the-complete-clock
 (is (= {:mode "review" :indices [0 3599]}
        (plan/selection ["out" "review" "3599,0"] 3600 [0])))
 (is (= [0 990] (:indices (plan/selection ["out"] 3600 [0 990]))))
 (is (= (vec (range 1800)) (:indices (plan/selection ["out" "film"] 1800 [0]))))
 (doseq [args [["out" "review" "0,0"] ["out" "review" "3600"]
              ["out" "review" "1.5"] ["out" "film" "0"] ["out" "unknown"]]]
  (is (try (plan/selection args 3600 [0]) false (catch _ true))))
 (is (try (plan/selection ["out"] 3600 (vec (range 65))) false (catch _ true))))
