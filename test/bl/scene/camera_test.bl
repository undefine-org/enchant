(ns scene.camera-test (:require [scene.camera :as c] [scene.geometry :as g]))
(def a {:center [0 0] :zoom 1 :roll 0})
(def b {:center [100 60] :zoom 4 :roll 2})
(def path (c/track [{:id "go" :duration 4 :from a :to b :controls [[20 -20] [80 80]]}
                    {:id "read" :duration 3 :from b :to (assoc b :center [110 65])}]))
(defn close? [a b] (< (abs (- a b)) 0.000001))
(defn rejects? [f] (try (f) false (catch _ true)))
(deftest camera-clock-geometry-and-continuity
  (is (= 7 (:duration path)))
  (is (= [0 0] (:center (c/sample path -1))))
  (is (= [110 65] (:center (c/sample path 10))))
  (is (close? 2 (:zoom (c/sample path 2))))
  (is (= [50 30] (:center (c/sample path 2))))
  (is (= "read" (:segment (c/sample path 4))))
  (is (every? true? (mapv close? [960 540] (g/point (c/matrix (c/sample path 2) [1920 1080]) [50 30]))))
  (is (< (abs (- (first (:center (c/sample path 4.001))) (first (:center (c/sample path 3.999))))) 0.00001))
  (is (= (c/sample path 2.25) (last (mapv (fn [t] (c/sample path t)) [6 0 4 1 2.25])))))
(deftest camera-invalid-paths-fail-before-render
  (is (rejects? (fn [] (c/track []))))
  (is (rejects? (fn [] (c/track [{:id "x" :duration 0 :from a :to b}]))))
  (is (rejects? (fn [] (c/track [{:id "x" :duration 1 :from a :to (assoc b :zoom 0)}]))))
  (is (rejects? (fn [] (c/track [{:id "x" :duration 1 :from a :to b} {:id "y" :duration 1 :from a :to b}]))))
  (is (rejects? (fn [] (c/track [{:id "x" :duration 1 :from a :to b :pullback -1}])))))
