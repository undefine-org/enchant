(ns scene.postcard-test
  (:require [scene.core :as s] [scene.motion :as motion] [scene.layout :as layout]
            [scene.inspect :as inspect] [scene-demo.postcard :as postcard]))
(defn rejects? [f] (try (f) false (catch _ true)))
(deftest sampled-timing-has-clamped-boundaries
  (is (= 0 (motion/tween {:at 1 :duration 0.5} 0)))
  (is (= 1 (motion/tween {:at 1 :duration 0.5} 2)))
  (is (= 0 (motion/tween {:at 1 :duration 0} 0.99)))
  (is (= 1 (motion/tween {:at 1 :duration 0} 1)))
  (is (rejects? (fn [] (motion/tween {:duration -1} 1)))))
(deftest postcard-seeks-preserve-layout-and-explanation
  (let [prepared (postcard/prepare {})
        before (postcard/frame prepared 2.5)
        _ (doseq [t [5.99 0 1.2 3.4]] (postcard/frame prepared t))
        after (postcard/frame prepared 2.5)
        retimed (postcard/prepare {:cue 1.2 :step 0.25} {:previous prepared :worker "/missing-worker-must-not-run.py"})]
    (is (= (:shaping prepared) (:shaping retimed)))
    (is (not= (:scene (postcard/frame prepared 0.8)) (:scene (postcard/frame retimed 0.8))))
    (is (= (:scene before) (:scene after)))
    (is (= (inspect/bounds (:objects before) "postcard/cards/compose")
           (inspect/bounds (:objects after) "postcard/cards/compose")))
    (is (= "Instrument Serif" (:value (inspect/explain (:objects before) "postcard/cards/compose/title" :font))))
    (is (rejects? (fn [] (postcard/frame prepared 6))))
    (is (rejects? (fn [] (inspect/object (:objects before) "missing"))))))
