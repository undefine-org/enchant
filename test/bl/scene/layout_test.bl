(ns scene.layout-test
  (:require [scene.core :as s] [scene.layout :as l] [scene.text :as text]
            [scene.geometry :as g] [scene.styles.editorial :as art]))
(defn card [body]
  (art/cutout {:id :card :width 420 :padding 28}
    (l/column {:gap 12}
      [(text/block {:id :title :role :heading} "A little world")
       (text/paragraph {:id :body :role :body} body)])))
(defn rejects? [f] (try (f) false (catch _ true)))
(deftest canonical-wrapping-and-measurable-card
  (let [short (card "Choose a time.")
        long (card "Choose a time. A much longer explanation that should wrap naturally within the measured card without any manual coordinate repair.")
        measured (text/measure! (into (l/requests short 420 art/warm)
                                  (mapv (fn [r] (update r :id (fn [id] (str "long/" id)))) (l/requests long 420 art/warm)))
                    {:font-dir "examples/scene-renderer/assets/fonts"})
        short-tree (l/evaluate short 420 art/warm (:runs measured))
        long-runs (into {} (mapv (fn [[id v]] [(replace-str id "long/" "") v])
                                 (filter (fn [[id v]] (starts-with? id "long/")) (seq (:runs measured)))))
        long-tree (l/evaluate long 420 art/warm long-runs)
        a (l/index short-tree) b (l/index long-tree)]
    (is (> (nth (:logical long-tree) 3) (nth (:logical short-tree) 3)))
    (is (= (set (keys a)) (set (keys b))))
    (is (contains? a "card/title"))
    (is (> (second (:east (:anchors (get b "card")))) (second (:east (:anchors (get a "card"))))))
    (is (> (nth (:effect short-tree) 2) (nth (:logical short-tree) 2)))
    (is (= :style-role (:from (:font (:provenance (get a "card/title"))))))
    (is (string? (s/svg {:width 520 :height 700 :time 0 :objects [(:render short-tree)]})))))
(deftest listed-transform-order
  (let [m (g/transform [[:translate [10 0]] [:rotate 90]]) p (g/point m [0 0])]
    (is (< (abs (first p)) 0.00001))
    (is (< (abs (- (second p) 10)) 0.00001))))
(deftest bad-layout-and-identities-are-diagnosed
  (is (rejects? (fn [] (l/requests (card "x") -1 art/warm))))
  (is (rejects? (fn [] (l/requests (l/column {:id :root :padding 300} []) 420 art/warm))))
  (is (rejects? (fn [] (text/measure! [{:id "same"} {:id "same"}] {})))))
(deftest keyed-insertion-does-not-rename-existing-objects
  (let [original (l/column {:id :root} [(text/block {:id :a} "A") (text/block {:id :b} "B")])
        inserted (l/column {:id :root} [(text/block {:id :new} "New") (text/block {:id :b} "B") (text/block {:id :a} "A")])]
    (is (= ["root/a" "root/b"] (mapv :id (l/requests original 400 art/warm))))
    (is (= ["root/new" "root/b" "root/a"] (mapv :id (l/requests inserted 400 art/warm))))))
