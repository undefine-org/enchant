(ns scene.atlas-test
  (:require [scene-demo.atlas :as atlas] [scene.core :as s] [scene.camera :as camera]))
(def prepared (atlas/prepare {:font-dir "examples/scene-renderer/assets/fonts" :worker "priv/lib/scene/text_worker.py"}))
(deftest continuous-world-and-camera-only-time
  (let [world (atlas/world prepared) before (s/svg world)
        plans (mapv atlas/frame-plan [55 0 20 7.4 38 3])]
    (is (= 5600 (:width (s/validate world))))
    (is (= before (s/svg (atlas/world prepared))))
    (is (= (atlas/frame-plan 3) (last plans)))
    (is (< (abs (- atlas/duration 56)) 0.000001))
    (is (= 11 (count (:segments atlas/camera-track))))
    (is (every? (fn [k] (let [[a b c d x y] (:matrix (atlas/frame-plan (/ k 24)))]
                          (and (every? s/finite? [a b c d x y]) (> (- (* a d) (* b c)) 0)))) (range 1344)))
    (is (try (atlas/frame-plan 56) false (catch _ true)))))
(deftest presentation-text-fits-the-reading-plates
  (is (every? (fn [plate]
      (let [id (:id plate) body (get (:runs prepared) (str id "/body"))]
        (and (<= (:lines body) 4)
             (< (nth (:logical (get (:runs prepared) (str id "/first"))) 2) 880)
             (< (nth (:logical (get (:runs prepared) (str id "/second"))) 2) 880)))) atlas/plates))
  (is (= 6 (count atlas/plates))))
