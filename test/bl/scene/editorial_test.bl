(ns scene.editorial-test
  (:require [scene.core :as s] [scene.material :as m] [scene-demo.editorial :as art]))
(defn rejects? [f] (try (f) false (catch _ true)))
(deftest seeded-materials-and-seek-order
  (let [before (s/svg (art/scene 2.5))]
    (doseq [t [3.99 0 1.4 0.2]] (s/svg (art/scene t)))
    (is (= before (s/svg (art/scene 2.5))))
    (is (includes? before "feTurbulence"))
    (is (includes? before "patternUnits"))
    (is (includes? before "Instrument Serif"))
    (is (includes? before "Patrick Hand"))
    (is (includes? before "clip-path"))))
(deftest malformed-materials-are-not-silently-omitted
  (is (rejects? (fn [] (m/svg-definition {:id "bad" :kind :unavailable}))))
  (is (rejects? (fn [] (m/svg-definition (m/halftone "bad" 0 1 "black"))))))
(deftest temporal-boundaries
  (is (rejects? (fn [] (art/scene 4))))
  (is (rejects? (fn [] (art/scene -1))))
  (is (= 1080 (:width (s/validate (art/scene 0))))))
