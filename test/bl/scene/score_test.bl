(ns scene.score-test (:require [scene.score :as score] [scene.core :as s]))
(deftest continuous-score
 (let [track (score/track [{:at 0 :value [0 10]} {:at 1 :value [2 12]} {:at 3 :value [4 6]}])
       d 0.00001 left (/ (- (first (score/sample track 1)) (first (score/sample track (- 1 d)))) d)
       right (/ (- (first (score/sample track (+ 1 d))) (first (score/sample track 1))) d)]
  (is (= [0 10] (score/sample track -1)))
  (is (= [4 6] (score/sample track 4)))
  (is (= [2 12] (score/sample track 1)))
  (is (< (abs (- left right)) 0.001))
  (is (try (score/track [{:at 1 :value [0]} {:at 1 :value [1]}]) false (catch _ true)))
  (is (try (score/track [{:at 0 :value [0]} {:at 1 :value [1 2]}]) false (catch _ true)))))
(deftest scored-geometry-is-seekable-and-renders-through-the-native-backend
 (let [track (score/track [{:at 0 :value [20 30]} {:at 1 :value [60 10]} {:at 2 :value [100 30]}])
       frame (fn [t]
               (let [[x y] (score/sample track t)]
                {:width 160 :height 80 :time t
                 :objects [{:id "card" :kind :rect
                            :attrs {:x x :y y :width 20 :height 10 :fill "#204060"}}]}))
       frames (mapv frame [1.5 0 0.4 1 2])
       folder (str ".local/scene-score-" (erlang/unique_integer (list :positive)))
       svg (str folder "/frame.svg") png (str folder "/frame.png")]
  (is (every? (fn [value] (map? (s/validate value))) frames))
  (is (every? (fn [value] (= ["card"] (mapv :id (:objects value)))) frames))
  (is (= (frame 1) (nth frames 3)))
  (is (= [60 10] (score/sample track 1)))
  (is (not= (s/svg (frame 0)) (s/svg (frame 2))))
  (is (every? (fn [t] (every? s/finite? (score/sample track t))) [0 0.4 1 1.5 2]))
  (try
   (File/mkdir_p! folder)
   (File/write! svg (s/svg (frame 1)))
   (let [result (System/cmd "rsvg-convert" (list "--output" png svg))
         bytes (File/read! png)]
    (is (= 0 (erlang/element 2 result)))
    (is (= "89504E470D0A1A0A" (binary/encode_hex (binary/part bytes 0 8))))
    (is (= 160 (binary/decode_unsigned (binary/part bytes 16 4))))
    (is (= 80 (binary/decode_unsigned (binary/part bytes 20 4)))))
   (finally (File/rm_rf! folder)))))
