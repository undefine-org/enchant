(ns scene.score-test (:require [scene.score :as score] [scene-demo.showcase :as art] [scene.core :as s]))
(deftest continuous-score
 (let [track (score/track [{:at 0 :value [0 10]} {:at 1 :value [2 12]} {:at 3 :value [4 6]}])
       d 0.00001 left (/ (- (first (score/sample track 1)) (first (score/sample track (- 1 d)))) d)
       right (/ (- (first (score/sample track (+ 1 d))) (first (score/sample track 1))) d)]
  (is (= [0 10] (score/sample track -1)))
  (is (= [4 6] (score/sample track 4)))
  (is (= [2 12] (score/sample track 1)))
  (is (< (abs (- left right)) 0.001))
  (is (try (score/track [{:at 1 :value [0]} {:at 1 :value [1]}]) false (catch _ true)))
  (is (try (score/track [{:at 0 :value [0]} {:at 1 :value [1 2]}]) false (catch _ true)))))
(deftest complete-showcase-clock
 (let [frames (mapv (fn [k] (art/sample (/ k 60))) (range 1800)) ids (mapv :id (:types (first frames)))]
  (is (= 8 (count ids)))
  (is (every? (fn [f] (= ids (mapv :id (:types f)))) frames))
  (is (every? (fn [f] (and (every? s/finite? (:view-projection f)) (= 16 (count (:view-projection f)))
                           (< (abs (- 1 (reduce + 0 (:shape f)))) 0.00001)
                           (every? (fn [v] (<= 0 v)) (:shape f)) (> (nth (:gesture f) 3) 0.03))) frames))
  (is (= (art/sample 12.34) (last (mapv art/sample [29.9 0 14 2 12.34]))))
  (is (try (art/sample 30) false (catch _ true)))
  (is (= 64 (count (filter (fn [e] (= (:voice e) "kick")) (art/score)))))))
