; Packaged qualification: the SDK carries its own canonical shaping worker.
(ns scene.text-test (:require [scene.text :as text]))
(deftest installed-worker-shapes-the-same-metrics-and-outlines
 (let [requests [{:id "heading" :text "A little world" :family "DM Sans" :size 24}]
       opts {:font-dir "examples/scene-renderer/assets/fonts"}
       default (text/measure! requests opts)
       explicit (text/measure! requests
                  (assoc opts :worker (str (BeamLisp.Tiers/priv_root) "/lib/scene/text_worker.py")))
       run (get-in default [:runs "heading"])]
  (is (= (:runs default) (:runs explicit)))
  (is (= (:fonts default) (:fonts explicit)))
  (is (= 1 (:lines run)))
  (is (> (nth (:logical run) 2) 0))
  (is (seq (:commands run)))))
