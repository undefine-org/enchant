(ns scene.choreo-test (:require [scene.choreo :as c]))
(def a (c/formation [{:id "seed" :at [0 0] :angle 350 :scale 1}
                      {:id "leaf" :at [10 0] :angle 0 :scale 1 :parent "seed"}]))
(def b (c/formation [{:id "leaf" :at [50 40] :angle 90 :scale 4}
                      {:id "seed" :at [20 10] :angle 10 :scale 1 :parent "leaf"}]))
(defn rejects? [f] (try (f) false (catch _ true)))
(deftest correspondence-follows-keys-and-relationships
  (let [nodes (c/morph a b 0.5)]
    (is (= ["seed" "leaf"] (mapv :id nodes)))
    (is (= [10 5] (:at (first nodes))))
    (is (= 360 (:angle (first nodes))))
    (is (< (abs (- 2 (:scale (second nodes)))) 0.000001))
    (is (= [25 20] (:attachment (second nodes))))
    (is (= [25 20] (:attachment (first nodes))))
    (is (= [5 10] (:center (c/follow {:zoom 2} [0 0] [10 20] 0.5))))))
(deftest bad-correspondence-and-invalid-geometry-fail
  (is (rejects? (fn [] (c/formation [{:id "x" :at [0 0] :angle 0 :scale 1 :parent "missing"}]))))
  (is (rejects? (fn [] (c/morph a (c/formation [{:id "other" :at [0 0] :angle 0 :scale 1}]) 0.5))))
  (is (rejects? (fn [] (c/morph a b 1.1)))))
(deftest structured-path-correspondence
  (is (= [["M" 5 10] ["L" 15 20]] (c/path-morph [["M" 0 0] ["L" 10 10]] [["M" 10 20] ["L" 20 30]] 0.5)))
  (is (rejects? (fn [] (c/path-morph [["M" 0 0]] [["L" 0 0]] 0.5)))))
