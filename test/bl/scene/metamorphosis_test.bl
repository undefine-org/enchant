(ns scene.metamorphosis-test
  (:require [scene-demo.metamorphosis :as art] [scene.core :as s]))
(def prepared (art/prepare {:font-dir "examples/scene-renderer/assets/fonts"}))
(deftest one-system-persists-through-every-transformation
  (let [frames (mapv (fn [t] (art/frame prepared t)) [0 8 15 23 30 37 47])
        ids (mapv :id (:objects (first frames))) edges (mapv :id (:edges (first frames)))]
    (is (every? (fn [f] (= ids (mapv :id (:objects f)))) frames))
    (is (every? (fn [f] (= edges (mapv :id (:edges f)))) frames))
    (is (= 48 (count (:semantic-ids (first frames)))))
    (is (every? (fn [f] (every? (fn [o] (and (not (contains? o :opacity)) (every? s/finite? (:matrix o)))) (:objects f))) frames))
    (is (> (/ (:zoom (:camera (first frames))) (:zoom (:camera (last frames)))) 7))
    (is (not= (:edges (nth frames 1)) (:edges (nth frames 2))))
    (is (= (art/frame prepared 23) (last (mapv (fn [t] (art/frame prepared t)) [47 0 36 8 23]))))
    (is (try (art/frame prepared 48) false (catch _ true)))))
