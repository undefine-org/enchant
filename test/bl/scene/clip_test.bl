(ns scene.clip-test (:require [scene.clip :as c]))
(defn rejects? [f] (try (f) false (catch _ true)))
(def story
  (c/schedule
    (c/sequence {:id "film" :cues {"detail" 2}}
      [(c/clip {:id "opening" :duration 2} {:shot :opening})
       (c/retime {:id "slow" :duration 4}
         (c/parallel {:id "layers"}
           [(c/clip {:id "base" :duration 2 :cues {"bloom" 1}} :base)
            (c/delay {:id "later" :by 1}
              (c/clip {:id "accent" :duration 1} :accent))]))])))
(deftest nested-local-clocks-and-half-open-boundaries
  (is (= 6 (:duration story)))
  (is (= ["film/opening"] (mapv :id (c/sample story 0))))
  (is (= ["film/slow/layers/base"] (mapv :id (c/sample story 2))))
  (is (= [1 0] (mapv :local-time (c/sample story 4))))
  (is (= [] (c/sample story 6)))
  (is (= [] (c/sample story -1)))
  (is (= 4 (get (:cues story) "film/slow/layers/base/bloom")))
  (is (= 2 (get (:cues story) "film/detail")))
  (is (= (c/sample story 4.5) (last (mapv (fn [t] (c/sample story t)) [5 0 4 2 4.5])))))
(deftest gaps-holds-and-zero-duration
  (let [s (c/schedule (c/parallel {:id "root" :duration 3}
                      [(c/delay {:id "wait" :by 1} (c/clip {:id "flash" :duration 1} :x))
                       (c/clip {:id "marker" :duration 0} :never)]))]
    (is (= [] (c/sample s 0)))
    (is (= [:x] (mapv :content (c/sample s 1))))
    (is (= [] (c/sample s 2)))))
(deftest composition-errors-are-explicit
  (is (rejects? (fn [] (c/clip {:id "x" :duration -1} nil))))
  (is (rejects? (fn [] (c/clip {:id "x/y" :duration 1} nil))))
  (is (rejects? (fn [] (c/clip {:id "x" :duration 1 :cues {"bad" 2}} nil))))
  (is (rejects? (fn [] (c/parallel {:id "x" :duration 1} [(c/clip {:id "a" :duration 2} nil)]))))
  (is (rejects? (fn [] (c/sequence {:id "x"} [(c/clip {:id "a" :duration 1} nil) (c/clip {:id "a" :duration 1} nil)]))))
  (is (rejects? (fn [] (c/retime {:id "x" :duration 0} (c/clip {:id "a" :duration 1} nil))))))
