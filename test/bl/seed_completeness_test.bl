(ns test.seed-completeness (:require [seed]))

(defn- root [] (or (System/get_env "BL_TEST_SOURCE_ROOT") (File/cwd!)))
(defn- selected-floor [] (Path/join (BeamLisp.Tiers/priv_root) "bootstrap/seed"))

(defn- scratch [tag]
  (let [d (Path/join (System/tmp_dir!) (str "seed-completeness-" tag "-" (System/unique_integer (list :positive))))]
    (File/mkdir_p! d) d))

(deftest partial-boot-closure-never-replaces-the-previous-floor
  (let [ebin (scratch "partial") out (scratch "previous") keep (Path/join out "keep")]
    (try
      (File/write! keep "previous-floor")
      (doseq [variant ["Ns.Multi" "Ns.Body.Multi"]]
        (File/cp! (Path/join (Path/join (root) "build") (seed/beam-of variant)) (Path/join ebin (seed/beam-of variant))))
      (let [r (seed/run {:root (root) :ebin ebin :out out})]
        (is (not (:ok? r)))
        (is (includes? (join " " (:errors r)) "incomplete boot closure"))
        (is (= "previous-floor" (File/read! keep))))
      (finally (File/rm_rf! ebin) (File/rm_rf! out)))))

(defn- check-floor [opts]
  (seed/check (merge {:boot (Path/join (BeamLisp.Tiers/priv_root) "boot")
                      :host (Path/join (BeamLisp.Tiers/priv_root) "host")
                      :out (selected-floor)} opts)))

(deftest checking-a-floor-requires-both-the-shim-and-body
  (is (:ok? (check-floor {:root (root)})))
  (doseq [variant ["Ns.Compiler" "Ns.Body.Compiler"]]
    (let [out (scratch "missing")]
      (try
        (File/cp_r! (selected-floor) out)
        (File/rm! (Path/join out (seed/beam-of variant)))
        (let [r (check-floor {:root (root) :out out})]
          (is (not (:ok? r)))
          (is (some #(= "compiler" %) (:unjudged r))))
        (finally (File/rm_rf! out))))))

(deftest stale-initializer-companions-do-not-reenter-the-floor
 (let [ebin (scratch "stale-init")
       output (Path/join ebin "emitted")
       source (Path/join ebin "fixture.bl")
       _ (File/write! source "(ns seed-stale-fixture) (defn answer [] 42)")
       workspace (BeamLisp.AOT/open_workspace
                   {:version 2 :phase-imports (list 'core 'sugar)
                    :sources (list {:namespace 'seed-stale-fixture :file source})} {})]
  (try
   ;; Current Data-readers has a legitimate initializer. Emit a real functions-
   ;; only private unit, then add an unreferenced stale companion beside it.
   (BeamLisp.AOT/emit_unit (BeamLisp.AOT/prepare_unit workspace 'seed-stale-fixture) output)
   (File/write! (str output "/" (seed/beam-of "Ns.Init.Seed-stale-fixture")) "obsolete initializer")
   (is (= ["Ns.Seed-stale-fixture" "Ns.Init.Seed-stale-fixture.Namespace" "Ns.Body.Seed-stale-fixture"]
          (seed/emitted-variants "Seed-stale-fixture" output)))
   (finally (BeamLisp.AOT/close_workspace! workspace) (File/rm_rf! ebin)))))

(deftest referenced-initializer-remains-required-even-when-file-is-missing
 (let [ebin (scratch "required-init")]
  (try
   (File/cp! (str (root) "/build/" (seed/beam-of "Ns.Compiler"))
             (str ebin "/" (seed/beam-of "Ns.Compiler")))
   (is (= ["Ns.Compiler" "Ns.Init.Compiler.Namespace" "Ns.Body.Compiler" "Ns.Init.Compiler"]
          (seed/emitted-variants "Compiler" ebin)))
   (finally (File/rm_rf! ebin)))))

(deftest disk-provenance-inspection-never-replaces-executable-code
 (let [out (scratch "inspection") module :bl_seed_inspection_fixture
       descriptor (fn [value hash key]
         (BeamLisp.Emit/descriptor_for module
          (list (BeamLisp.Emit/function_clause :value (BeamLisp.Emit/lit value)))
          (list (tuple :bl_source_hash hash) (tuple :bl_compiler_key key))))
       before (BeamLisp.Emit/compile_descriptor (descriptor 1 "old" "old"))
       after (BeamLisp.Emit/compile_descriptor (descriptor 2 "disk-hash" "disk-key"))
       path (str out "/bl_seed_inspection_fixture.beam")]
  (try
   (BeamLisp.Env/publish_binaries! (list before) "running-fixture")
   (File/write! path (elem after 1))
   (is (= {:ok {:hash "disk-hash" :key "disk-key"}} (seed/stamp path)))
   (is (= 1 (erlang/apply module :value (list))))
   (is (= "running-fixture" (erlang/list_to_binary (code/which module))))
   (is (= false (erlang/check_old_code module)))
   (finally (BeamLisp.Env/retire_module! module) (File/rm_rf! out)))))
