(ns server.return-model-test)
(defn- fixture! []
 (BeamLisp.Compiler/eval_string
  "(ns server.returnfixture)
   (def order (atom []))
   (defn mark [n] (swap! order conj n) n)
   (defn reset-order [] (reset! order []))
   (defn observation [] @order)
   (defn baseline [] ((fn [a b] (tuple :ok a b)) (mark 1) (mark 2)))
   (defn fail-first [] (mark 1) (throw (ex-info \"first argument\" {:kind :return-first})))
   (defn baseline-throws [] ((fn [a b] (tuple :ok a b)) (fail-first) (mark 2)))
   (defserver direct (init [_] (ok (mark 1) (mark 2))))
   (defserver throws (init [_] (ok (fail-first) (mark 2))))
   (defserver captured (init [_] (let [respond reply] (respond :answer :state))))
   (defserver shadowed (init [_] (let [ok (fn [value] value)] (ok :shadowed))))")
 (fn [name args]
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "server.returnfixture" name) (to-list args))))
(deftest direct-returns-preserve-ordinary-argument-order-and-single-evaluation
 (let [call (fixture!)]
  (call "reset-order" [])
  (let [expected (call "baseline" []) order (call "observation" [])]
   (call "reset-order" [])
   (is (= expected (erlang/apply (BeamLisp.Env/fetch_exact! "server.returnfixture" "direct") :init (list nil))))
   (is (= order (call "observation" [])))
   (is (= #{1 2} (set order)))
   (is (= 2 (count order))))))
(deftest first-class-constructors-and-lexical-shadowing-keep-their-callable-behavior
 (let [call (fixture!)]
  (is (= (tuple :reply :answer :state)
         (erlang/apply (BeamLisp.Env/fetch_exact! "server.returnfixture" "captured") :init (list nil))))
  (is (= :shadowed (erlang/apply (BeamLisp.Env/fetch_exact! "server.returnfixture" "shadowed") :init (list nil))))))

(deftest a-throwing-return-operand-preserves-ordinary-call-effects
 (let [call (fixture!)
       capture (fn [action] (try (action) :unexpected (catch error (:kind (ex-data error)))))]
  (call "reset-order" [])
  (let [expected (capture #(call "baseline-throws" [])) order (call "observation" [])]
   (call "reset-order" [])
   (is (= :return-first expected))
   (is (= [1] order))
   (is (= expected (capture #(erlang/apply (BeamLisp.Env/fetch_exact! "server.returnfixture" "throws") :init (list nil)))))
   (is (= order (call "observation" []))))))
