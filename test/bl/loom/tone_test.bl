; tone_test.bl — loom.tone: OKLCH round trips, generated dark themes, and the
; oomph checks that catch a flat night.
;
; Run: bl test test/bl/loom/tone_test.bl

(ns loom.tone.test
  (:require [loom.tone :as tone]
            [loom.token :as t]))

(defn- near? [a b eps] (< (abs (- a b)) eps))

(def roles
  {:steps [:base :inset :surface :raised :overlay] :card [:surface :base] :frame [:frame :base]
   :text [:text :text-2 :text-3] :accents [[:action :text-3]] :solids [:action-solid]
   :fields [[:field :surface]]})

(deftest oklch-round-trips-through-hex
  (doseq [hex ["#131624" "#f3ac75" "#ffffff" "#000000" "#3f6b4e" "#5b8def"]]
    (let [{:keys [l c h]} (tone/oklch hex)]
      (is (= hex (tone/oklch->hex l c h)) hex))))

(deftest known-references
  (is (near? 1.0 (:l (tone/oklch "#ffffff")) 0.001))
  (is (near? 0.0 (:l (tone/oklch "#000000")) 0.001))
  (is (near? 21.0 (tone/contrast "#ffffff" "#000000") 0.01)))

(deftest out-of-gamut-keeps-lightness-and-hue
  (let [hex (tone/oklch->hex 0.7 0.4 52)
        {:keys [l h c]} (tone/oklch hex)]
    (is (near? 0.7 l 0.01))
    (is (near? 52 h 3))
    (is (< c 0.4) "chroma came down to fit sRGB")))

(deftest a-generated-night-has-oomph
  (let [th (tone/dark {:hue 272 :chroma 0.028 :accents {:action {:hue 58} :danger {:hue 25}}})
        r (tone/oomph th roles)]
    (is (:ok? r) (pr-str (:failures r)))
    (is (empty? (tone/wcag th [[:text :raised 7.0 "body on the top surface"]
                               [:text-3 :surface 4.5 "meta on cards"]
                               [:action :surface 4.5 "action text"]
                               [:danger :surface 4.5 "danger text"]
                               [:on-action :action-solid 4.5 "a filled action"]
                               [:line-strong :surface 3.0 "control edges"]])))
    (is (every? (fn [k] (contains? th k)) [:danger :danger-solid :on-danger :danger-soft]))))

(deftest the-frame-can-carry-the-brand
  (let [th (tone/dark {:hue 272 :frame {:hue 275 :chroma 0.09}})]
    (is (> (:c (tone/oklch (:frame th))) 0.05))
    (is (< (:l (tone/oklch (:frame th))) (:l (tone/oklch (:base th)))))))

(deftest a-flat-night-is-caught
  ;; Backdesk's dark palette before the oomph checks: slate surfaces bunched
  ;; together, a beige "filled" button, pastel accents as light as meta text,
  ;; a rail no darker than the page, fields lighter than cards.
  (let [flat {:frame "#1d2153" :base "#252935" :inset "#2c3240" :surface "#343b4a" :raised "#404959" :overlay "#444d5d"
              :field "#404959" :text "#f7f8fb" :text-2 "#e0e5ef" :text-3 "#c1cada"
              :action "#ffc28e" :action-solid "#f3dfcf"}
        checks (set (map :check (:failures (tone/oomph flat roles))))]
    (is (contains? checks :tier) "text tiers collapse")
    (is (contains? checks :stand) "the action is as light as meta text")
    (is (contains? checks :solid) "the filled button lost its colour")
    (is (contains? checks :frame) "the rail does not sit below the page")
    (is (contains? checks :recess) "fields read as raised, not recessed")))

(deftest a-card-that-barely-rises-is-caught
  ;; Forest's first night: the card 0.032 above the page passes a per-step
  ;; floor, but reads as one slab
  (let [r (tone/oomph {:base "#111a15" :surface "#17221c"} {:card [:surface :base]})]
    (is (= [:card] (map :check (:failures r))))))

(deftest lift-raises-the-whole-ladder
  (let [a (tone/dark {:hue 160}) b (tone/dark {:hue 160 :lift 0.03})]
    (is (> (:l (tone/oklch (:base b))) (:l (tone/oklch (:base a)))))
    (is (:ok? (tone/oomph b (dissoc roles :accents :solids))))))

(deftest loom-defaults-have-oomph
  ;; loom's own dark defaults are held to the same floors as a generated night
  (let [c (:color t/tokens)
        r (tone/oomph c {:steps [:bg :surface :surface-2 :surface-3] :card [:surface :bg] :text [:text :muted :faint]
                         :accents [[:accent :muted] [:success :muted] [:danger :muted]]})]
    (is (:ok? r) (pr-str (:failures r)))
    (is (empty? (tone/wcag c [[:text :surface-3 7.0 "body on the top surface"]
                              [:muted :surface-3 4.5 "muted on the top surface"]
                              [:accent :bg 4.5 "links on the page"]
                              [:faint :bg 3.0 "faint, large text only"]
                              [:border-2 :surface 1.4 "interactive borders show"]])))))
