; env_vars_test.bl — the environment variables `bl` reads are the ones the CLI reference lists.
;
; docs/bl/00-the-cli.md holds ONE table of every BL_* / BEAM_LISP_* variable. Documentation
; written by reading drifts: an idle-timer variable was documented for months and nothing
; read it (FUP-148). This diffs the table against the source, both ways:
;
;   listed but never read   a promise nothing keeps: delete the row or write the reader
;   read but never listed   an undeclared knob: add the row (and say why it is not a key)
;
; "Read" means the name appears in a line that reads the environment (System/get_env,
; env::var, a shell expansion, or the launcher's own table), in a bl, Rust or shell source.

(ns env-vars-test)

(def DOC "docs/bl/00-the-cli.md")
(def SOURCE-GLOBS ["priv/**/*.bl" "priv/**/*.bl.md" "tooling/**/*.rs" "tooling/**/*.bl" "tooling/**/*.sh"])
(def COMMENT-STARTS [";" "//" "///" "#" "*"])

;; Variables read by the code that are NOT a user-facing knob and so are not in the table:
;; the examples in a doc that are not variables, and names built by concatenation.
(def NOT-VARIABLES #{"BL_VERSION" ; named in the doc to say nothing reads it
                     "BL_HOST"    ; a JavaScript global (globalThis.BL_HOST in js.bl), not an environment variable
                     "BL_TOKEN__" "BL_APP" "BL_KIND" "BL_NOTE" "BL_RECORDED_AT" "BL_REDACTED"
                     "BL_SCENARIO" "BL_SOURCE" "BL_STATUS" "BL_STEPS" "BL_USER" "BL_BUILD_ID_"})

(defn- names-in
  "Every BL_*/BEAM_LISP_* name in `text`."
  [text]
  (set (map first (Regex/scan
    (Regex/compile! "(?<![A-Z0-9_])(?:BL_|BEAM_LISP_)[A-Z0-9_]+") text))))

(defn- code-line?
  "Not a comment: a line whose first non-blank character starts no comment."
  [line]
  (let [t (String/trim line)]
    (not (some (fn [c] (String/starts_with? t c)) COMMENT-STARTS))))

(defn- quoted-names
  "The BL_*/BEAM_LISP_* names that appear inside double quotes on `line`."
  [line]
  (let [parts (String/split line "\"")]
    ; odd-numbered pieces are inside quotes
    (mapcat (fn [i] (names-in (nth parts i)))
            (filter odd? (range (count parts))))))

(defn- documented []
  (let [text (File/read! DOC)
        start (String/split text "## Environment variables")
        section (first (String/split (second start) "\n## "))]
    (set (filter (fn [v] (not (contains? NOT-VARIABLES v))) (names-in section)))))

(defn- read-by-code []
  (set (filter (fn [v] (not (contains? NOT-VARIABLES v)))
               (mapcat (fn [glob]
                         (mapcat (fn [file]
                                   (let [text (File/read! file)]
                                    (if (String/contains? text (list "BL_" "BEAM_LISP_"))
                                     (mapcat (fn [line] (if (code-line? line) (quoted-names line) []))
                                             (String/split text "\n")) [])))
                                 (Path/wildcard glob)))
                       SOURCE-GLOBS))))

(deftest variable-token-boundaries-preserve-prefix-and-comment-scanning-rules
  (is (= #{"BL_VALID" "BEAM_LISP_OK" "BL_AFTER"}
         (names-in "BL_VALID BEAM_LISP_OK BL_ BEAM_LISP_ XBL_HIDDEN _BL_HIDDEN xBL_AFTER BL_VALID"))))

(deftest every-documented-variable-is-read
  (let [listed (documented) read (read-by-code)
        unread (sort (filter (fn [v] (not (contains? read v))) listed))]
    (is (= [] (vec unread)) (str "documented but nothing reads them: " (pr-str unread)))))

(deftest every-variable-read-is-documented
  (let [listed (documented) read (read-by-code)
        undocumented (sort (filter (fn [v] (not (contains? listed v))) read))]
    (is (= [] (vec undocumented)) (str "read but not in docs/bl/00-the-cli.md: " (pr-str undocumented)))))

(deftest the-table-is-not-empty
  (is (>= (count (documented)) 30) "the section exists and lists the variables"))

(run-tests)
