;; Compiler control: exercise the internal producer; normal build/run uses Nix.
(ns sdk-artifact-shapes-test (:require [build :as build]))

(deftest real-literate-actions-and-generated-actor-references-prepare-without-initialization
 (let [root (BeamLisp.Tiers/priv_root)
       out (Path/join (System/tmp_dir!) (str "sdk-artifact-shapes-" (erlang/unique_integer (list :positive))))
       before (BeamLisp.Env/capture)]
  (try
   (let [result (build/produce!
                 {:sources (mapv #(Path/join root %) ["std/bl/vm.bl.md" "std/bl/realm.bl.md"
                                                      "std/proc/reconcile-runtime.bl"])
                  :root root :out out :sdk-artifacts? true :jobs 1})]
    (is (= [] (:errors result)))
    (is (= 3 (:compiled result)))
    (is (= 3 (count (:manifest result))))
    (doseq [[file _] (:manifest result)]
     (let [namespace (BeamLisp.Loader/declared_ns (BeamLisp.Loader/read_source file))
           shim (BeamLisp.Emit/module_for namespace)
           bytes (File/read! (Path/join out (str (Atom/to_string shim) ".beam")))
           attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)]
      (is (erlang/is_list (BeamLisp.AOT/sdk_unit_requires attrs)))))
    (is (every? :preparation-key (vals (:manifest result))))
    (is (= before (BeamLisp.Env/capture))))
   (finally (File/rm_rf! out)))))
