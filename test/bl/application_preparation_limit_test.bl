(ns application-preparation-limit-test)

;; Evaluate the coordinator's actual inert contract helpers. No request is
;; submitted and no producer is started by these admission boundary controls.
(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "nix/preparation-operation.bl"))
      helpers (first (String/split
                      (str "(def terminal" (second (String/split source "(def terminal")))
                      "(defn- operation!"))]
 (BeamLisp/eval (str "(ns application-preparation-limit-test)\n"
  (String/replace helpers "(defn- application!" "(defn admit"))))
(ns application-preparation-limit-test)
(defn request [n]
 {"version" 4 "source" (System/fetch_env! "BL_SDK_PRODUCT")
  "sources" (mapv #(str "src/dependency-" % ".bl") (range n))
  "world" nil "exclude" ["main.bl"] "ex" nil "native" false "jobs" 2
  "scope" "full" "base" nil "force" false "attempt" nil "nativeProducts" []})
(defn refused? [r]
 (try (admit r) false (catch error (= :artifact-job-refused (:kind (ex-data error))))))
(deftest actual-hera-size-and-the-finite-bound-are-admitted
 (doseq [n [0 256 265 512]]
  (let [r (request n)] (is (= r (admit r)))
   (is (< (erlang/byte_size (encode-json! r)) operation-limit))))
 (is (refused? (request 513))))
(deftest increased-count-retains-path-shape-and-execution-admission
 (let [r (request 265)]
  (doseq [bad [(assoc r "sources" ["../outside.bl"])
               (assoc r "sources" ["/outside.bl"])
               (assoc r "sources" {:hidden "source.bl"})
               (assoc r "sources" [(str "src/" (String/duplicate "x" 4096))])
               (assoc r "execute" "arbitrary command")
               (assoc r "jobs" 5) (assoc r "force" true)
               (assoc r "version" 99)]]
   (is (refused? bad)))))
