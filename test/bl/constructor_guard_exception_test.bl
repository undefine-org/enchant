(ns constructor-guard-exception-test
 (:require [anf :as a] [lower :as lower]))

(deftest vm-map-guard-failures-remain-failed-clauses-in-both-engines
 (doseq [subject [42 {}]]
  (let [expression (a/casee (a/lit subject)
                     (list (a/clause (list (a/pvar "value"))
                             (a/remote :erlang :map_get (list (a/lit :absent) (a/var "value"))) (a/lit 0))
                           (a/clause (list (a/pvar "fallback")) nil (a/lit 42))))]
   (is (= 42 (lower/eval-anf
               (erlang/binary_to_atom (str "Elixir.ConstructorMapGuard." (erlang/unique_integer (list :positive))))
               expression)))
   (is (= 42 (BeamLisp.AOT/interpret_constructor! expression {} {}))))))
