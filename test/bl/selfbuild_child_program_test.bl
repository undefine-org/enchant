(ns selfbuild-child-program.test (:require [selfbuild]))

(deftest sdk-producer-program-parses-before-starting-an-external-vm
  (let [program ((BeamLisp.Env/fetch_exact! "selfbuild" "library-program"))
        parsed (Code/string_to_quoted program)]
    (is (= :ok (elem parsed 0))
        (str "The actual SDK child program must be valid Elixir: " (pr-str parsed)))))
