(ns contextual-world-arity-test
 (:require [bl.world :as world] [bl.cli :as cli] [system.arity :as arity]))

(deftest ordinary-world-check-reports-lexical-arity-without-executing
 (let [dir (Path/join (System/tmp_dir!) (str "bl-world-arity-" (erlang/unique_integer (list :positive))))
       path (Path/join dir "world.bl") previous (Process/group_leader)
       device (elem (StringIO/open "") 1)]
  (File/mkdir! dir)
  (try
   (File/write! (Path/join dir "main.bl")
    "(ns showcase)\n(let [f (fn [x] x)]\n (do (erlang/put :world-arity-executed true) (f)))")
   (File/write! path
    "{:version 1 :profile 'syntax-v1 :entry ['showcase 'current] :sources [{:namespace 'showcase :revision 'current :file \"main.bl\"}] :libraries []}")
   (let [prepared (world/prepare path) report (:arity prepared)]
    (is (= :refused (:status report)))
    (is (= (get-in prepared [:facts :snapshot]) (:snapshot report)))
    (is (= 1 (get-in report [:coverage :refused])))
    (is (= 1 (get-in report [:coverage :unknown])))
    (is (= :call-arity (:kind (first (:diagnostics report)))))
    (is (= 3 (:line (first (:diagnostics report)))))
    (is (= :refused (:status (arity/check-anf (get-in prepared [:program :node]))))))
   (Process/group_leader (erlang/self) device)
   (is (= 0 (cli/run-argv (list "world" "check" path "--json"))))
   (let [json (Jason/decode! (elem (StringIO/contents device) 1))]
    (is (= "refused" (get json "arity-check")))
    (is (= "lexical-anf-call-arity" (get json "arity-scope")))
    (is (= 1 (get-in json ["arity-coverage" "refused"])))
    (is (= 3 (get (first (get json "arity-diagnostics")) "line"))))
   (is (= :undefined (erlang/get :world-arity-executed)))
   (finally (Process/group_leader (erlang/self) previous) (StringIO/close device) (File/rm_rf! dir)))))
