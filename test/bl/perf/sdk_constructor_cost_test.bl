(ns sdk-constructor-cost-test)

(deftest constructor-selection-consumes-one-complete-unit-proof-per-lookup
  (BeamLisp.Loader/ensure_loaded "proc.server")
  (let [evidence (BeamLisp.PackageAuthority/sdk_unit_evidence
                   "proc.server" (BeamLisp.AOT/sdk_inventory_input))
        members (count (:members evidence))
        patterns [(tuple :Elixir.BeamLisp.AOT :sdk_inventory_input 0)
                  (tuple :Elixir.BeamLisp.AOT :sdk_compiler_row 2)
                  (tuple :Elixir.BeamLisp.AOT :sdk_source_current? 3)]]
    (is (pos? members))
    (doseq [pattern patterns] (erlang/trace_pattern pattern true (list :local :call_count)))
    (try
      (doseq [lookups [1 2]]
        (let [callback (BeamLisp.Env/sdk_callable! "proc.server" "clause-extension-form" 2)]
          (is (erlang/is_function callback 2))
          (doseq [[pattern expected] (map (fn [pattern expected] [pattern expected])
                                        patterns [lookups (* members lookups) lookups])]
            (is (= (tuple :call_count expected) (erlang/trace_info pattern :call_count))))))
      ;; A previous successful lookup never turns an absent or wrong-arity
      ;; constructor into an executable target.
      (is (thrown? (BeamLisp.Env/sdk_callable! "proc.server" "clause-extension-form" 0)))
      (is (thrown? (BeamLisp.Env/sdk_callable! "proc.server" "not-a-constructor" 2)))
      (finally
        (doseq [pattern patterns] (erlang/trace_pattern pattern false (list :local :call_count)))))))
