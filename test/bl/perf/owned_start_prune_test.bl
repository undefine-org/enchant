(ns owned-start-prune-test)

(defn- waiting-child []
  (spawn (fn [] (receive :stop :stopped))))

(defn- stop-children! [children]
  (let [monitors (mapv (fn [pid] [pid (Process/monitor pid)]) children)
        ;; These test-only waiters own no external resources. Terminate them
        ;; directly, then await the whole group before releasing its scope.
        deadline (+ (System/monotonic_time :millisecond) 10000)]
    (try
      (doseq [pid children] (Process/exit pid :kill))
      (doseq [[pid monitor] monitors]
        (receive
          [:DOWN seen :process child _] :when (and (= seen monitor) (= child pid)) :stopped
          (after (max 0 (- deadline (System/monotonic_time :millisecond)))
            (throw (ex-info "Owned-start stress children did not stop" {:kind :stress-cleanup-timeout :pid pid
                         :diagnostic (Process/info pid [:status :current_function :messages])})))))
      (finally
        (doseq [[pid monitor] monitors]
          (when (Process/alive? pid) (Process/exit pid :kill))
          (Process/demonitor monitor (list :flush)))))))

(deftest a-large-live-working-set-does-not-scan-the-start-table-per-spawn
  ;; Reproduce the case that a half-capacity full-table prune does not fix:
  ;; thousands of genuinely live children, so pruning cannot shrink the table.
  (let [children (mapv (fn [_] (waiting-child)) (range 2100))
        traces [(tuple :ets :select 2) (tuple :ets :tab2list 1)]
        more (atom [])]
    (try
      (is (>= (ets/info :beam_lisp_native_owned_starts :size) 2048))
      (doseq [mfa traces] (erlang/trace_pattern mfa true (list :local :call_count)))
      (try
        (reset! more (mapv (fn [_] (waiting-child)) (range 64)))
        (doseq [mfa traces]
          (is (= (tuple :call_count 0) (erlang/trace_info mfa :call_count))))
        (finally
          (doseq [mfa traces] (erlang/trace_pattern mfa false (list :local :call_count)))))
      (finally
        (stop-children! (into children @more))))))
