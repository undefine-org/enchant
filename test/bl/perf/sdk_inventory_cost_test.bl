(ns sdk-inventory-cost-test)

(deftest inventory-shares-source-and-disassembly-within-complete-units
  (let [root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
        ebin (Path/join (Path/dirname root) "ebin")
        manifest (into {} (map (fn [namespace]
                     (let [shim (BeamLisp.Emit/module_for namespace)
                           path (Path/join ebin (str (Atom/to_string shim) ".beam"))
                           attrs (Keyword/get (elem (elem (beam_lib/chunks (File/read! path) (list :attributes)) 1) 1) :attributes)
                           members (BeamLisp.AOT/normalized_attribute attrs :bl_aot_unit_members)]
                       [(BeamLisp.Loader/source_path namespace) {:modules (cons shim (elem members 1))}]))
                    ["errors" "proc.task"]))
        output (Path/join (System/tmp_dir!) (str "inventory-cost-" (erlang/unique_integer (list :positive))))
        patterns [(tuple :Elixir.BeamLisp.Loader :read_source 1)
                  (tuple :beam_disasm :file 1)]]
    (doseq [pattern patterns] (erlang/trace_pattern pattern true (list :local :call_count)))
    (try
      (let [module-count (BeamLisp.AOT/write_sdk_inventory! root manifest ebin output)]
        (is (pos? module-count))
        ;; Read initial and final Source independently for each unit. Route and
        ;; literal-definition checks consume one actual disassembly per shim.
        (is (= (tuple :call_count 4) (erlang/trace_info (first patterns) :call_count)))
        (is (= (tuple :call_count 2) (erlang/trace_info (second patterns) :call_count)))
        (doseq [pattern patterns] (erlang/trace_pattern pattern false (list :local :call_count)))
        (let [rows (BeamLisp.AOT/decode_sdk_inventory! (File/read! output))]
          (is (= module-count (count rows)))
          (doseq [[source record] manifest module (:modules record)]
            (let [path (Path/join ebin (str (Atom/to_string module) ".beam"))
                  independent (BeamLisp.AOT/portable_sdk_row
                                (BeamLisp.AOT/sdk_artifact_entry! root source module path))]
              (is (= independent (get rows (Atom/to_string module))))))))
      (finally
        (doseq [pattern patterns] (erlang/trace_pattern pattern false (list :local :call_count)))
        (File/rm output)))))
