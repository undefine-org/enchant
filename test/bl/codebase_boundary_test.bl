(ns codebase.boundary-test
 (:require [codebase :as cb] [codebase.boundary :as boundary] [datom]))

(defn descriptor [name]
 {:version 1 :id [name :fixed 0] :definition name :body-identity [:fixture name]
  :kind :source :arity {:kind :fixed :count 0} :edges [] :dependencies-complete true})

(deftest source-edges-remain-visible-across-static-and-dynamic-boundaries
 (let [source "(ns boundary.fixture) (defn leaf [] 1) (defn entry [leaf] (leaf))"
       index (cb/index-source {} "boundary.fixture" source {:mode :calls})
       result (boundary/project index [(descriptor "boundary.fixture/leaf")
                                        (descriptor "boundary.fixture/entry")])]
  (is (= 2 (get-in result [:coverage :entries])))
  (is (= false (get-in result [:coverage :complete])))
  (is (some #(and (= :unresolved (:edge/status %)) (= "leaf" (:edge/written %))) (:edges result)))))

(deftest a-missing-emitted-definition-cannot-disappear-from-coverage
 (let [index (cb/index-source {} "boundary.fixture" "(defn leaf [] 1) (defn missing [] 2)" {:mode :calls})
       result (boundary/project index [(descriptor "boundary.fixture/leaf")])]
  (is (= ["boundary.fixture/missing"] (get-in result [:coverage :missing])))
  (is (= false (get-in result [:coverage :complete])))))

(deftest empty-and-incomplete-emission-do-not-certify-an-inventory
 (let [empty (boundary/project {:fn [] :calls []} [])
       index (cb/index-source {} "boundary.fixture" "(defn leaf [] 1)" {:mode :calls})
       partial (boundary/project index [(dissoc (descriptor "boundary.fixture/leaf") :dependencies-complete)])]
  (is (= false (get-in empty [:coverage :complete])))
  (is (= false (get-in partial [:coverage :complete])))))

(deftest duplicate-physical-entry-identities-refuse-projection
 (let [index (cb/index-source {} "boundary.fixture" "(defn leaf [] 1)" {:mode :calls})
       entry (descriptor "boundary.fixture/leaf")]
  (is (thrown? (boundary/project index [entry entry])))))

(deftest top-level-callers-also-require-an-emitted-entry
 (let [index (cb/index-source {} "boundary.fixture" "(defn leaf [] 1) (leaf)" {:mode :calls})
       result (boundary/project index [(descriptor "boundary.fixture/leaf")])]
  (is (= ["boundary.fixture/<top>"] (get-in result [:coverage :missing-callers])))
  (is (= false (get-in result [:coverage :complete])))))

(deftest reverse-impact-uses-the-emitted-entry-relation
 (let [index (cb/index-source {} "boundary.fixture" "(defn leaf [] 1) (defn entry [] (leaf))" {:mode :calls})
       leaf (descriptor "boundary.fixture/leaf")
       entry (assoc (descriptor "boundary.fixture/entry") :edges
               [{:kind :direct-call :target (:id leaf) :evidence [:fixture :direct-call]}])
       result (boundary/project index [leaf entry])
       connection (cb/connect-codebase boundary/SCHEMA)]
  (try
   (datom/transact! connection (:facts result))
   (is (= true (get-in result [:coverage :complete])))
   (is (= #{(:id leaf) (:id entry)} (boundary/impact (datom/db connection) #{(:id leaf)})))
   (finally (datom/close! connection)))))
