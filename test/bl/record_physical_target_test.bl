(ns record-physical-target-test)
(defn- refused? [f] (try (f) false (catch _ true)))
(defn- retire [modules] (doseq [module modules] (BeamLisp.Env/retire_module! module)))

(deftest distinct-physical-targets-preserve-one-logical-schema-without-effects
 (doseq [[kind targets] [[:record [:Elixir.PhysicalRecordA :Elixir.PhysicalRecordB]]
                         [:deftype [:Elixir.PhysicalTypeA :Elixir.PhysicalTypeB]]]]
  (let [descriptors (mapv #(BeamLisp.Record/declaration_descriptor "world.logical" "Packet" kind (list "payload") %) targets)]
   (doseq [[module descriptor] (map (fn [module descriptor] [module descriptor]) targets descriptors)]
    (is (= module (:name descriptor)))
    (is (= (tuple 1 "world.logical" "Packet" kind (list "payload")) (BeamLisp.Record/declaration_metadata descriptor)))
    (is (= kind (BeamLisp.Record/declaration_kind descriptor "world.logical" "Packet")))
    (is (nil? (BeamLisp.Record/info module)))
    (is (not (erlang/module_loaded module)))))))

(deftest same-logical-name-can-publish-two-physical-schemas-through-original-owner
 (let [a :Elixir.PhysicalSchemaA b :Elixir.PhysicalSchemaB
       before (BeamLisp.Record/declaration_descriptor "world.revisions" "Packet" :record (list "old") a)
       after (BeamLisp.Record/declaration_descriptor "world.revisions" "Packet" :record (list "new") b)]
  (try
   (is (= a (BeamLisp.Record/publish_declaration! before)))
   (is (= b (BeamLisp.Record/publish_declaration! after)))
   (is (= (Map/put {:old 42} :__struct__ a) (BeamLisp.Ns.Rt/invoke (BeamLisp.Record/positional_ctor a) (list 42))))
   (is (= (Map/put {:new 43} :__struct__ b) (BeamLisp.Ns.Rt/invoke (BeamLisp.Record/positional_ctor b) (list 43))))
   (is (= (list :old) (BeamLisp.Record/fields_of a)))
   (is (= (list :new) (BeamLisp.Record/fields_of b)))
   (is (refused? #(BeamLisp.Record/declaration_descriptor "foreign.origin" "Packet" :record (list "old") a)))
   (finally (retire [a b])))))

(deftest explicit-target-replay-keeps-native-lease-and-schema-fences
 (let [module :Elixir.PhysicalReplay descriptor
        (BeamLisp.Record/declaration_descriptor "world.replay" "Packet" :deftype (list "payload") module)
       pair (BeamLisp.Emit/compile_descriptor descriptor)]
  (try
   (BeamLisp.Env/publish_binaries! (list pair) "preloaded-physical-class")
   (let [lease (BeamLisp.Env/retain_code! (list module))]
    (try
     (is (nil? (BeamLisp.Record/info module)))
     (is (= module (BeamLisp.Record/replay_declaration! descriptor (erlang/apply module :module_info (list :md5)))))
     (is (= (tuple :bl_deftype module (tuple 42)) (BeamLisp.Ns.Rt/invoke (BeamLisp.Record/positional_ctor module) (list 42))))
     (is (refused? #(BeamLisp.Record/publish_declaration!
                     (BeamLisp.Record/declaration_descriptor "world.replay" "Packet" :deftype (list "changed") module))))
     (is (= (list :payload) (BeamLisp.Record/fields_of module)))
     (is (not (BeamLisp.Env/retire_module! module)))
     (finally (BeamLisp.Env/release_code! lease))))
   (is (BeamLisp.Env/retire_module! module))
   (finally (retire [module])))))

(deftest physical-target-is-not-a-descriptor-rename-or-admission-shortcut
 (let [a :Elixir.PhysicalCanonicalA b :Elixir.PhysicalCanonicalB
       descriptor (BeamLisp.Record/declaration_descriptor "world.canonical" "Packet" :record (list "payload") a)]
  (is (nil? (BeamLisp.Record/declaration_kind (assoc descriptor :name b) "world.canonical" "Packet")))
  (is (nil? (BeamLisp.Record/declaration_kind descriptor "foreign" "Packet")))
  (doseq [target [nil true false "Module" 42]]
   (is (refused? #(BeamLisp.Record/declaration_descriptor "world.canonical" "Packet" :record (list "payload") target))))
  (is (not (erlang/module_loaded a)))
  (is (not (erlang/module_loaded b)))))
