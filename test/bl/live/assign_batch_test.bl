(ns live.assign-batch-test
  (:require [live.socket :as socket] [datom]))

(deftest one-local-gesture-projects-its-final-consistent-state
  (let [conn (datom/connect []) rendered (atom [])
        view (fn [_ _ locals]
               (swap! rendered conj (select-keys locals [:minimum :maximum]))
               [:div (str (:minimum locals) ".." (:maximum locals))])
        state (socket/mount {:view view :shared conn :sink (erlang/self)
                             :locals {:minimum 10 :maximum 20}})
        basis (datom/basis-t (datom/db conn))]
    (try
      (reset! rendered [])
      (let [next (socket/handle-event state [[:assign :minimum 30] [:assign :maximum 40]])]
        (is (= 30 (get-in next [:locals :minimum])))
        (is (= 40 (get-in next [:locals :maximum])))
        (is (= 1 (count @rendered)) "one gesture must not render every field reset")
        (is (every? #(<= (:minimum %) (:maximum %)) @rendered)
            "the intermediate half-edited bounds are not an observable view")
        (is (= basis (datom/basis-t (datom/db conn)))))
      (finally (datom/close! conn)))))
