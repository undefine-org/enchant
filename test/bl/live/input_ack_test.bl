(ns live.input-ack.test
  (:require [datom] [live.socket :as socket]))

(defn- frames []
  (receive frame
    (if (and (vector? frame) (contains? #{:mount :patch :input-ack :style :denied} (first frame)))
      (into [frame] (frames)) (frames))
    (after 0 [])))
(defn- fixture [conn & [overrides]]
  (socket/mount
    (merge {:shared conn :sink (erlang/self) :locals {:draft "A"}
            :view (fn [_ _ locals] [:input {:value (:draft locals)}])} overrides)))

(deftest mount-negotiates-input-ack-and-patch-precedes-ack
  (let [c (datom/connect []) state (fixture c)
        initial (frames)
        mount (first (filter #(= :mount (first %)) initial))]
    (try
      (is (= {:input-ack true :text-layout []} (nth mount 2)))
      (let [after (socket/handle-event state [:assign :draft [:from :value]]
                                      {:value "B" :live/input-id "field-one"})
            pushed (frames)]
        (is (= "B" (get-in after [:locals :draft])))
        (is (= [:patch :input-ack] (mapv first pushed)))
        (is (= [:input-ack "field-one"] (last pushed)))
        (is (= "B" (nth (first (second (first pushed))) 3))))
      (let [before (datom/db c)]
        (socket/handle-event state [:assign :draft "C"] {})
        (is (not (some #(= :input-ack (first %)) (frames))))
        (is (= before (datom/db c))))
      (finally (datom/close! c)))))

(deftest input-metadata-is-not-a-business-payload-and-commits-project-before-ack
  (let [c (datom/connect [{:db/ident :entry/value :db/valueType :db.type/string}])
        payload (atom nil)
        state (fixture c {:view (fn [db _ _]
                                  [:input {:value (or (first (first (datom/q '[:find ?v :where [_ :entry/value ?v]] db))) "")}])
                          :intents {:save (fn [_ p _] (reset! payload p)
                                            [{:db/id -1 :entry/value (:value p)}])}})]
    (try
      (frames)
      (socket/handle-event state [:intent :save {}] {:value "written" :live/input-id "field-two"})
      (let [pushed (frames) tags (mapv first pushed)]
        (is (= "written" (:value @payload)))
        (is (not (contains? @payload :live/input-id)))
        (is (= :input-ack (last tags)))
        (is (some #(= :patch %) tags))
        (is (= [:input-ack "field-two"] (last pushed))))
      (finally (datom/close! c)))))

(deftest a-coalesced-older-input-is-acknowledged-without-its-obsolete-render
  (let [c (datom/connect []) state (fixture c)
        queued (tuple :"$gen_cast" (tuple :event [:assign :draft [:from :value]] {:value "newest"}))]
    (try
      (frames)
      (erlang/send (erlang/self) queued)
      (let [after (socket/handle-event state [:assign :draft [:from :value]]
                                      {:value "older" :live/input-id "older-id"} true)]
        (is (= "older" (get-in after [:locals :draft])))
        (receive queued-again (is (= queued queued-again)) (after 100 (is false)))
        (is (= [[:input-ack "older-id"]] (frames))))
      (finally (datom/close! c)))))

(deftest a-compound-local-input-projects-once-before-acknowledgement
  (let [c (datom/connect []) rendered (atom [])
        state (fixture c {:locals {:draft "A" :fold :earlier}
                          :view (fn [_ _ locals]
                                  (swap! rendered conj (select-keys locals [:draft :fold]))
                                  [:input {:value (:draft locals)}])})
        before (datom/basis-t (datom/db c))]
    (try
      (frames) (reset! rendered [])
      (let [after (socket/handle-event state
                    [[:assign :draft [:from :value]] [:assign :fold nil]]
                    {:value "2026-09-07T16:00" :live/input-id "civil-input"})
            pushed (frames)]
        (is (= "2026-09-07T16:00" (get-in after [:locals :draft])))
        (is (nil? (get-in after [:locals :fold])))
        (is (= [{:draft "2026-09-07T16:00" :fold nil}] @rendered)
            "a tracked compound input must not repeat its final projection")
        (is (= [:patch :input-ack] (mapv first pushed)))
        (is (= [:input-ack "civil-input"] (last pushed)))
        (is (= before (datom/basis-t (datom/db c)))))
      (finally (datom/close! c)))))

(deftest a-mixed-input-batch-still-projects-its-shared-write-before-ack
  (let [c (datom/connect [{:db/ident :entry/value :db/valueType :db.type/string}])
        state (fixture c {:view (fn [db _ locals]
                                  [:div [:span (:draft locals)]
                                   [:input {:value (or (first (first (datom/q '[:find ?v :where [_ :entry/value ?v]] db))) "")}]])
                          :intents {:save (fn [_ p _] [{:db/id -1 :entry/value (:value p)}])}})]
    (try
      (frames)
      (let [after (socket/handle-event state
                    [[:assign :draft "Edited"] [:intent :save {}]]
                    {:value "written" :live/input-id "mixed-input"})
            pushed (frames)]
        (is (= "Edited" (get-in after [:locals :draft])))
        (is (= "written" (first (first (datom/q '[:find ?v :where [_ :entry/value ?v]] (datom/db c))))))
        (is (= [:input-ack "mixed-input"] (last pushed)))
        (is (String/contains? (pr-str (butlast pushed)) "written")))
      (finally (datom/close! c)))))
