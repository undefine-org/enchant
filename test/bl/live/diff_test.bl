; diff_test.bl — W2: the keyed structural differ.
;
; Two kinds of assertion:
;   1. GOLDEN — a specific (old,new) pair yields a specific, MINIMAL op set.
;      This pins that a reorder is :move (not :replace), an append is one
;      :insert, etc. — the properties that make this better than string diff.
;   2. PROPERTY — for every pair, (apply-ops (diff a b) a) == b. The ops are
;      not just plausible; applying them reconstructs the target exactly.

(ns live.diff.test
  (:require [live.diff :as d] [interop]))

;; these tests deliberately diff unkeyed lists; silence the advisory warning
;; so the suite output stays clean (one test re-enables it to check the toggle).
(d/set-keyless-warning! false)

;; ── golden: minimal ops ─────────────────────────────────────────────

(deftest text-change-one-op
  (is (= [[:text [0 0] "new"]]
         (d/diff [:div [:h3 "old"]] [:div [:h3 "new"]]))))

(deftest attr-change-one-op
  (is (= [[:set-attr [] "data-state" "open"]]
         (d/diff [:div {:data-state "closed"}] [:div {:data-state "open"}]))))

(deftest attr-removed
  (is (= [[:remove-attr [] "title"]]
         (d/diff [:div {:title "x"}] [:div {}]))))

(deftest tag-change-is-replace
  (is (= [[:replace [] [:span "x"]]]
         (d/diff [:div "x"] [:span "x"]))))

(deftest keyed-append-one-insert
  ; op shape: [:insert path key index subtree]
  (is (= [[:insert [] "b" 1 [:li {:key "b"} "B"]]]
         (d/diff [:ul [:li {:key "a"} "A"]]
                 [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]))))

(deftest keyed-remove-one-op
  (is (= [[:remove [] "a"]]
         (d/diff [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
                 [:ul [:li {:key "b"} "B"]]))))

(deftest keyed-reorder-is-moves-not-replace
  ; the signature property: reordering N keyed rows emits :move ops, so the
  ; DOM nodes are preserved (a string diff would rewrite them all)
  (let [ops (d/diff [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"] [:li {:key "c"} "C"]]
                    [:ul [:li {:key "c"} "C"] [:li {:key "a"} "A"] [:li {:key "b"} "B"]])]
    (is (every? (fn [op] (contains? #{:move} (first op))) ops))
    (is (not (some (fn [op] (= :replace (first op))) ops)))))

(deftest unchanged-is-empty
  (is (= [] (d/diff [:div "same"] [:div "same"]))))

(deftest keyed-content-change-recurses
  ; same key, changed inner text → descends to a :text op at the child path,
  ; no :move (index unchanged), no :replace
  (is (= [[:text [0 0] "B2"]]
         (d/diff [:ul [:li {:key "a"} "B"]]
                 [:ul [:li {:key "a"} "B2"]]))))

;; ── a :class change keeps the tag shorthand's classes ───────────────
;; `[:span.x {:class "y"}]` renders class="x y": the renderer concatenates the
;; shorthand's classes ahead of :class (live.hiccup/render-attrs). An attr op
;; sets the DOM attribute wholesale, so it must carry the same merged value — a
;; bare "z" wiped the tag's `x` on the first toggle, and dropping :class removed
;; the attribute and `x` with it. The id is the same contract: an explicit :id
;; wins over the shorthand's, and dropping it falls back to the shorthand's.

(deftest class-attr-ops-carry-the-shorthand-classes
  (is (= [[:set-attr [] "class" "x z"]]
         (d/diff [:span.x {:class "y"}] [:span.x {:class "z"}])))
  (is (= [[:set-attr [] "class" "x"]]
         (d/diff [:span.x {:class "y"}] [:span.x {}])))
  (is (= [[:set-attr [] "class" "x y"]]
         (d/diff [:span.x] [:span.x {:class "y"}])))
  (is (= [[:set-attr [] "class" "a b on"]]
         (d/diff [:li#r.a.b {:class nil}] [:li#r.a.b {:class "on"}])))
  ;; no shorthand: the attribute itself goes, as before
  (is (= [[:remove-attr [] "class"]]
         (d/diff [:span {:class "y"}] [:span {}])))
  (is (= [[:set-attr [] "id" "a"]]
         (d/diff [:span#a {:id "b"}] [:span#a {}])))
  ;; an unrelated attr on a shorthand-classed node does not touch class
  (is (= [[:set-attr [] "title" "t"]]
         (d/diff [:span.x {:class "y"}] [:span.x {:class "y" :title "t"}]))))

(deftest property-shorthand-class-change
  (is (= (d/normalize [:span.x {:class "z"} "t"])
         (d/apply-ops (d/diff [:span.x {:class "y"} "t"] [:span.x {:class "z"} "t"])
                      [:span.x {:class "y"} "t"])))
  (is (= (d/normalize [:div [:span.x "t"]])
         (d/apply-ops (d/diff [:div [:span.x {:class "y"} "t"]] [:div [:span.x "t"]])
                      [:div [:span.x {:class "y"} "t"]])))
  (is (= (d/normalize [:span#a "t"])
         (d/apply-ops (d/diff [:span#a {:id "b"} "t"] [:span#a "t"]) [:span#a {:id "b"} "t"]))))

;; ── an inserted / replaced subtree crosses the wire already spliced ──
;; The client renders an [:insert]/[:replace] subtree from JSON, where a seq
;; and an element are both arrays and a keyword tag and a text are both
;; strings: `[:p (list "a" [:b "c"])]` arrived as ["p",["a",["b","c"]]], whose
;; child reads as an ELEMENT named "a" (InvalidCharacterError for any text with
;; a space; a blank page). The first paint was right because hiccup->html
;; splices. So the differ ships the subtree the way the renderer sees it: child
;; groups spliced at every depth, nils dropped, and metadata keys (which JSON
;; cannot carry) moved into the attrs so the inserted nodes keep their identity.

(deftest inserted-subtree-splices-child-groups
  (is (= [[:insert [] nil 0 [:p "two words" [:b "c"]]]]
         (d/diff [:div] [:div [:p (list "two words" [:b "c"])]])))
  (is (= [[:replace [0] [:p "a" [:i "x"] "b" [:b "c"]]]]
         (d/diff [:div [:span]] [:div [:p (list "a" (list [:i "x"] "b")) nil [:b "c"]]])))
  (is (= [[:insert [] "k" 0 [:li {:key "k"} "two words" [:b "c"]]]]
         (d/diff [:ul] [:ul [:li {:key "k"} (list "two words" [:b "c"])]])))
  (is (= "[[\"insert\",[],null,0,[\"p\",\"two words\",[\"b\",\"c\"]]]]"
         (interop/->json (d/diff [:div] [:div [:p (list "two words" [:b "c"])]])))))

(deftest inserted-subtree-carries-metadata-keys-as-attrs
  (let [row (fn [k] (with-meta [:li k] {:key k}))]
    ;; the inserted node itself, with no attrs map to put the key in
    (is (= [[:insert [] "a" 0 [:li {:key "a"} "a"]]]
           (d/diff [:ul] [:ul (row "a")])))
    ;; and the keyed rows INSIDE an inserted subtree, so a later keyed op on
    ;; them finds its data-key in the DOM
    (is (= [[:insert [] nil 0 [:ul [:li {:key "a"} "a"] [:li {:key "b"} "b"]]]]
           (d/diff [:div] [:div [:ul (map row ["a" "b"])]])))))

(deftest property-inserted-text-led-seq
  (let [a [:div [:p "head"]]
        b [:div [:p "head"] [:p (list "two words" [:b "c"])]]
        c [:div [:p "head"] [:p (list "other words" [:b "c"])]]]
    (is (= (d/normalize b) (d/apply-ops (d/diff a b) a)))
    (is (= (d/normalize c) (d/apply-ops (d/diff b c) b)))))

;; ── a table's rows sit in the <tbody> the HTML parser inserts ───────
;; `[:table [:tr …] [:tr …]]` is table > tbody > tr in every browser (the
;; parser infers the tbody on the first paint and on each innerHTML mount). The
;; differ indexed the rows as the table's children, so every path through a
;; table was one level short: the client's `at` walked into undefined, threw,
;; and the rest of the patch was lost. Paths now go through the tbody.

(deftest table-paths-go-through-the-implicit-tbody
  ;; div > table(0) > tbody(0) > tr(1) > td(0) > text(0)
  (is (= [[:text [0 0 1 0 0] "B"]]
         (d/diff [:div [:table [:tr [:td "a"]] [:tr [:td "b"]]]]
                 [:div [:table [:tr [:td "a"]] [:tr [:td "B"]]]])))
  ;; a keyed row insert lands in the tbody, not the table
  (is (= [[:insert [0] "2" 1 [:tr {:key "2"} [:td "b"]]]]
         (d/diff [:table [:tr {:key "1"} [:td "a"]]]
                 [:table [:tr {:key "1"} [:td "a"]] [:tr {:key "2"} [:td "b"]]])))
  ;; a table inserted whole ships the tbody the client must create itself
  (is (= [[:insert [] nil 0 [:table [:tbody [:tr [:td "a"]]]]]]
         (d/diff [:div] [:div [:table [:tr [:td "a"]]]])))
  ;; spelling the tbody out is the same tree, so switching spellings is a no-op
  (is (= [] (d/diff [:table [:tr [:td "a"]]] [:table [:tbody [:tr [:td "a"]]]]))))

(deftest property-table-without-tbody
  (let [a [:main [:table [:tr [:td "a"]] [:tr [:td "b"]]] [:span.pill "À relire"]]
        b [:main [:table [:tr [:td "a"]] [:tr [:td "b2"]] [:tr [:td "c"]]] [:span.pill "Signé"]]]
    (is (= (d/normalize b) (d/apply-ops (d/diff a b) a)))
    (is (= (d/normalize a) (d/apply-ops (d/diff b a) b)))))

;; ── the round-trip property: apply-ops ∘ diff = identity to new ─────

(defn- round-trips? [a b]
  ; apply-ops reconstructs in normalized form (explicit attrs slot), so we
  ; compare normalized-to-normalized: structural equality, not whether an
  ; empty `{}` happens to be written. The DIFF is computed on the authored
  ; trees; only the equality check is normalized.
  (= (d/normalize b) (d/apply-ops (d/diff a b) a)))

(deftest property-text-change
  (is (round-trips? [:div [:h3 "old"]] [:div [:h3 "new"]])))

(deftest property-attr-change
  (is (round-trips? [:div {:data-state "closed"} "x"]
                    [:div {:data-state "open"} "x"])))

(deftest property-keyed-insert
  (is (round-trips? [:ul [:li {:key "a"} "A"]]
                    [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]])))

(deftest property-keyed-remove
  (is (round-trips? [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
                    [:ul [:li {:key "b"} "B"]])))

(deftest property-keyed-reorder
  (is (round-trips? [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"] [:li {:key "c"} "C"]]
                    [:ul [:li {:key "c"} "C"] [:li {:key "a"} "A"] [:li {:key "b"} "B"]])))

(deftest property-tag-change
  (is (round-trips? [:div "x"] [:span "x"])))

(deftest property-nested-mixed
  (is (round-trips?
        [:main [:header [:h1 "Old"]] [:section [:p "a"] [:p "b"]]]
        [:main [:header [:h1 "New"]] [:section [:p "a"] [:p "c"]]])))

(deftest property-insert-and-reorder
  ; a combined change: one new row AND a reorder of the existing ones
  (is (round-trips?
        [:ul [:li {:key "a"} "A"] [:li {:key "b"} "B"]]
        [:ul [:li {:key "b"} "B"] [:li {:key "c"} "C"] [:li {:key "a"} "A"]])))

(deftest property-positional-children
  ; unkeyed children fall back to positional diff — still must round-trip
  (is (round-trips? [:div [:span "a"] [:span "b"]]
                    [:div [:span "a"] [:span "c"]])))

;; ── unkeyed LENGTH changes: the case that silently dropped/blanked nodes ──
;; A positional diff of lists of DIFFERENT length must still round-trip. These
;; pin the bug where a longer NEW list emitted `:replace` at a nonexistent
;; index (dropping the surplus) and a longer OLD list emitted a blanking
;; `:text` (keeping ghosts). Correctness is independent of keys; keys only
;; change whether nodes MOVE vs re-diff in place.

(deftest property-positional-grow
  (is (round-trips? [:div [:p "a"]]
                    [:div [:p "a"] [:p "b"] [:p "c"]])))

(deftest property-positional-shrink
  (is (round-trips? [:div [:p "a"] [:p "b"] [:p "c"]]
                    [:div [:p "a"]])))

(deftest property-positional-empty-to-many
  (is (round-trips? [:div] [:div [:p "a"] [:p "b"]])))

(deftest property-positional-many-to-empty
  (is (round-trips? [:div [:p "a"] [:p "b"]] [:div])))

(deftest property-positional-grow-and-change
  ; the real catalog case: a list changes length AND its content differs
  (is (round-trips?
        [:div [:section [:h3 "Button"]] [:section [:h3 "Field"]] [:section [:h3 "Checkbox"]]]
        [:div [:section [:h3 "Card"]] [:section [:h3 "Badge"]]
              [:section [:h3 "Alert"]] [:section [:h3 "Divider"]]])))

(deftest keyless-warning-can-be-silenced
  ; the warning is advisory, never affects correctness, and is suppressible
  (d/set-keyless-warning! false)
  (is (round-trips? [:div [:p "a"]] [:div [:p "a"] [:p "b"]]))
  (d/set-keyless-warning! true))

(deftest unkeyed-to-keyed-list-reconciles-positionally
  ;; an unkeyed empty-state (several children) replaced by ONE keyed row: the
  ;; old children must actually be removed. A keyed reconcile with no keys on
  ;; the old side emits [:remove path nil], which names nothing — zombies.
  (let [a [:div [:span "icon"] [:b "Nothing yet"] [:p "hint"] [:a {:href "/x"} "go"]]
        b [:div [:article {:key "c1"} "row"]]
        ops (d/diff a b)]
    (is (= (d/normalize b) (d/apply-ops ops a)))
    (is (not (some (fn [op] (and (= :remove (first op)) (nil? (nth op 2)))) ops)))
    ;; and back again
    (is (= (d/normalize a) (d/apply-ops (d/diff b a) b)))
    ;; an empty keyed list growing stays keyed (insert by key)
    (let [ops2 (d/diff [:ul] [:ul [:li {:key "k"} "x"]])]
      (is (= (d/normalize [:ul [:li {:key "k"} "x"]]) (d/apply-ops ops2 [:ul])))
      (is (= :insert (first (first ops2))))
      (is (= "k" (nth (first ops2) 2))))))

;; ── an EMPTY list child splices to nothing, like the renderer ────────
;; FUP-123 Finding E: an empty list is `list?` but not `seq?`; the differ must
;; flatten it exactly as `hiccup->html` does, or it diffs a phantom "()" node.

(deftest empty-list-child-group-is-no-node
  (is (= [] (d/diff [:div [:p "x"]] [:div (apply list []) [:p "x"]])))
  (is (= [] (d/diff [:div (list) [:p "x"]] [:div [:p "x"]]))))

;; ── structural ops apply SHALLOWEST parent first ─────────────────────
;; An inner list's path indexes its outer list's NEW children, so the outer
;; reconcile must land first. Removing row "a" while every surviving row's own
;; keyed list also loses an option used to patch the OLD row at each index.
(deftest nested-keyed-removals-patch-the-surviving-rows
  (d/set-keyless-warning! false)
  (let [row (fn [k opts] [:li {:key k} [:select (apply list (map (fn [o] [:option {:key o} o]) opts))]])
        a [:ul (row "a" ["x" "y"]) (row "b" ["x" "y"]) (row "c" ["x" "y"])]
        b [:ul (row "b" ["y"]) (row "c" ["y"])]]
    (is (= (d/normalize b) (d/apply-ops (d/diff a b) a)))))

;; Exhaustive small permutations certify correctness AND minimal move count.
;; The oracle is exponential subsequence enumeration, independent of the
;; production patience algorithm; five rows keep this oracle deliberately tiny.
(defn- permutations [xs]
  (if (empty? xs) [[]]
    (mapcat (fn [x]
              (mapv (fn [tail] (into [x] tail))
                    (permutations (filterv (fn [y] (not= x y)) xs)))) xs)))

(defn- longest-increasing [xs previous]
  (if (empty? xs) 0
    (let [x (first xs) tail (rest xs)
          skip (longest-increasing tail previous)]
      (if (or (nil? previous) (> x previous))
        (max skip (+ 1 (longest-increasing tail x))) skip))))

(defn- numbered-list [xs]
  (into [:ul] (mapv (fn [n] [:li {:key (str n)} (str n)]) xs)))

(deftest every-five-row-permutation-round-trips-with-the-minimum-moves
  (let [old (numbered-list [0 1 2 3 4])]
    (doseq [order (permutations [0 1 2 3 4])]
      (let [new (numbered-list order) ops (d/diff old new)]
        (is (= (d/normalize new) (d/apply-ops ops old)) (pr-str order))
        (is (= (- 5 (longest-increasing order nil)) (count ops)) (pr-str order))
        (is (every? (fn [op] (= :move (first op))) ops))))))

(defn- list-change-cost [n]
  (let [old (numbered-list (range n))
        new (assoc old n [:li {:key (str (- n 1))} "changed"])
        _ (d/diff old new)
        before (erlang/element 2 (erlang/process_info (erlang/self) :reductions))
        ops (d/diff old new)
        reds (- (erlang/element 2 (erlang/process_info (erlang/self) :reductions)) before)]
    (is (= [[:text [(- n 1) 0] "changed"]] ops))
    reds))

(deftest changing-one-row-has-subquadratic-diff-cost
  (let [small (list-change-cost 512) big (list-change-cost 1024)]
    (println (str "keyed diff budget: 512=" small " reductions; 1024=" big))
    (is (< big (* small 3.2)) "doubling a keyed list must not quadruple the work")))
