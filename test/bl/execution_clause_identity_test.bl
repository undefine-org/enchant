(ns execution.clause-identity-test)

(deftest actual-clause-identities-do-not-depend-on-vm-atom-creation-order
 (let [paths (Enum/flat_map (code/get_path) (fn [p] (list "-pa" (erlang/list_to_binary p))))
       script (str
        "names = Enum.map(1..15, &(\"history_execution_literal_atom_\" <> Integer.to_string(&1)))\n"
        "order = if System.argv() == [\"reverse\"], do: Enum.reverse(names), else: names\n"
        "Enum.each(order, &String.to_atom/1)\n"
        "Application.load(:beam_lisp)\n"
        "for app <- Application.spec(:beam_lisp, :applications) || [], do: {:ok, _} = Application.ensure_all_started(app)\n"
        "BeamLisp.AOT.boot()\n"
        "atoms = Enum.map(names, &String.to_existing_atom/1)\n"
        "values = [{:literal_map, Map.new(atoms, &{&1, true})}, {:literal_set, MapSet.new(atoms)}]\n"
        "clauses = for {name, value} <- values, do: %{op: :\"defn-clause\", fname: name, params: [], guard: nil, ann: %{}, body: %{op: :lit, val: value, ann: %{}}}\n"
        "hashes = apply(BeamLisp.Ns.Anf, :\"execution-clause-identities\", [clauses])\n"
        "encoded = hashes |> Enum.sort() |> Enum.map(fn {_, digest} -> Base.encode16(digest) end) |> Enum.join(\":\")\n"
        "IO.puts(\"HISTORY-CLAUSE-IDENTITIES \" <> encoded)\n")
       results (mapv
                 (fn [order]
                  (let [[output status] (System/cmd "elixir" (erlang/++ paths (list "-e" script "--" order))
                                          (list (tuple :stderr_to_stdout true)
                                           (tuple :env (list (tuple "BL_DAEMON" "off")
                                                             (tuple "BL_ROOT" (Path/dirname (BeamLisp.Tiers/priv_root)))))))
                        rows (filterv #(String/starts_with? % "HISTORY-CLAUSE-IDENTITIES ")
                                (String/split output "\n"))]
                   (is (= 0 status) output)
                   (is (= 1 (count rows)) output)
                   (first rows))) ["forward" "reverse"])]
  (is (= (first results) (second results)))))
