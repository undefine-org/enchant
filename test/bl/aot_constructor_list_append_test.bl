(ns aot-constructor-list-append-test)

(defn- append-node [left right]
 {:op :remote :mod :erlang :fun :++
  :args (list {:op :lit :val left} {:op :lit :val right})})
(defn- refusal [action]
 (try (action) nil (catch error (:detail (ex-data error)))))

(deftest exact-proper-list-append-retains-syntax-and-empty-list-semantics
 (doseq [[left right] [[() ()] [() '(x)] ['(a b) ()] ['(a [1 2]) '(c {:x 3})]]]
  (is (= (erlang/++ left right)
       (BeamLisp.AOT/interpret_constructor! (append-node left right) {} {})))))

(deftest append-refuses-nonlists-and-excessive-combined-output
 (doseq [[left right] [[nil ()] [[] ()] [() nil] [() {}]]]
  (is (= :list-append-domain
       (refusal #(BeamLisp.AOT/interpret_constructor! (append-node left right) {} {})))))
 (is (= :collection-budget
      (refusal #(BeamLisp.AOT/interpret_constructor!
                 (append-node (to-list (range 9000)) (to-list (range 9000))) {} {})))))

(deftest copied-list-cells-reserve-the-cumulative-allocation-budget-first
 (let [key (tuple :append-allocation-test (erlang/make_ref))
       state {:counter-frame key :max-collection 16384 :data-limits {}}]
  (try
   (Process/put key (assoc (BeamLisp.AOT/constructor_counters) :allocation-nodes 1))
   (is (= :allocation-node-budget
        (refusal #(BeamLisp.AOT/constructor_primitive :erlang :++ (list '(x) ()) state))))
   (finally (Process/delete key)))))
