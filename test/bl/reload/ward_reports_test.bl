;; The baseline control extracts the current collector's exact expression.
;; Once the SDK owns failure-reports, exercise that actual public function.
(ns reload.ward-reports-test (:require [reload.ward :as ward]))
(defn collector []
 (let [entry (try (BeamLisp.Env/fetch_exact! "reload.ward" "failure-reports") (catch _ nil))]
  (if entry
   {:mode :actual-sdk-helper :collect (fn [reports] (BeamLisp.Ns.Rt/invoke entry (list reports)))}
   (let [source (BeamLisp.Loader/source_content "reload.ward")
         expression "failures (filter #(contains? #{:fail :error} (:type %)) (:reports result))"]
    (when-not (and (string? source) (String/contains? source expression))
     (throw (ex-info "The control must match the installed collector exactly" {})))
    {:mode :extracted-current-algorithm-control
     :collect (fn [reports] (vec (filter #(contains? #{:fail :error} (:type %)) reports)))}))))
(defn without-cache [compute]
 (let [previous (Application/get_env :beam_lisp :lazy_cache_budget_bytes)]
  (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
  (try {:value (compute)} (catch cause {:error (ex-message cause)})
   (finally (if (nil? previous) (Application/delete_env :beam_lisp :lazy_cache_budget_bytes)
              (Application/put_env :beam_lisp :lazy_cache_budget_bytes previous))))))
(deftest finite-report-collection-needs-no-optional-memo
 (let [payload (vec (repeat 256 {:actual "retained quantity and source graph"}))
       failed {:type :fail :test "late" :expected false :actual payload}
       errored {:type :error :test "broken" :actual {:cause "original"}}
       reports [{:type :pass :actual payload} failed {:type :pass :actual false} errored {:type :pass :actual nil}]
       adapter (collector) collect (:collect adapter)
       actual (without-cache #(collect reports)) passed (without-cache #(collect [{:type :pass :actual payload}]))]
  (println :finite-report-mode (:mode adapter))
  (when (:error actual) (println :finite-report-failure actual))
  (is (nil? (:error actual)))
  (is (= [failed errored] (:value actual)) "Keep full diagnostic values in their original order")
  (is (nil? (:error passed)))
  (is (= [] (:value passed)) "Successful reports cannot become an incoherent suite")))
