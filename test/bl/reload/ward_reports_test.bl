;; Large successful assertions must not consume optional lazy admission while
;; the runner discards them, or become a fictitious source-loading failure.
(ns reload.ward-reports-test (:require [reload.ward :as ward]))

(defn without-cache [compute]
  (let [previous (Application/get_env :beam_lisp :lazy_cache_budget_bytes)]
    (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
    (try {:value (compute)}
      (catch cause {:error (ex-message cause)})
      (finally
        (if (nil? previous) (Application/delete_env :beam_lisp :lazy_cache_budget_bytes)
          (Application/put_env :beam_lisp :lazy_cache_budget_bytes previous))))))

(deftest finite-report-collection-needs-no-optional-memo
  (let [payload (vec (repeat 256 {:actual "retained quantity and source graph"}))
        failed {:type :fail :test "late" :expected false :actual payload}
        errored {:type :error :test "broken" :actual {:cause "original"}}
        reports [{:type :pass :actual payload} failed {:type :pass :actual false}
                 errored {:type :pass :actual nil}]
        expected [failed errored]
        _ (ward/failure-reports reports)
        actual (without-cache #(ward/failure-reports reports))
        passed (without-cache #(ward/failure-reports [{:type :pass :actual payload}]))]
    (when (:error actual) (println :finite-report-failure actual))
    (is (nil? (:error actual)))
    (is (= expected (:value actual)) "Keep full diagnostic values and order")
    (is (nil? (:error passed)))
    (is (= [] (:value passed)) "A successful assertion cannot become incoherent")))
