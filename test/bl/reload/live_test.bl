(ns reload.live-test
 (:require [reload] [proc.evolve :as ev] [reload.generation :as generation]
           [reload.state :as state]))

(def SOURCE
 "(ns live.business)
  (defn handle [message state]
    (let [value (if (= message :inc) (inc state) state)] {:reply value :state value}))
  (defn accepts [message] (and (erlang/is_atom message) (contains? #{:inc :read} message)))
  (defn state-valid [state] (int? state))
  (defn unchanged [value] value)
  (defn spec [version digest]
    {:version version :digest digest :handler handle :accept? accepts
     :check-state state-valid :migrate-state unchanged :upcast unchanged})")
(defn- graph [app n]
 (generation/prepare! {:application-id app :native-modules #{"erlang"} :fixed-runtime true
                      :resources {:fixture-version n} :sources {"live.business" SOURCE}}))
(defn- spec [g n]
 (generation/with! g #(ev/prepare-spec (generation/invoke! g "live.business/spec" [n (:digest g)]))))
(defn- fixture [app action]
 (let [old (graph app 1) fresh (graph app 2) pid (atom nil)]
  (try
   (generation/with! old #(state/bind! {}))
   (generation/inherit-runtime! fresh old)
   (reset! pid (generation/with! old #(ev/start! (spec old 1) 0 {:managed true})))
   (action @pid old fresh)
   (finally
    (reload/abort) (reload/set-enabled! nil)
    (when (and @pid (Process/alive? @pid)) (GenServer/stop @pid))
    (generation/retire! old) (generation/retire! fresh)))))

(deftest production-generation-switch-keeps-owner-and-old-message-contract
 (fixture "live-admitted-upgrade"
  (fn [pid old fresh]
   (reload/set-enabled! true)
   (is (= 1 (ev/request! pid 1 :inc)))
   (is (= :applied (:status (generation/with! fresh #(reload/activate! pid 1 (spec fresh 2))))))
   (is (= pid (:pid (ev/status pid))))
   (is (= 2 (ev/request! pid 1 :inc)))
   (is (= 3 (ev/request! pid 2 :inc)))
   (is (= :already-applied (:status (generation/with! fresh #(reload/activate! pid 1 (spec fresh 2))))))
   (is (= :waiting (:status (generation/retire! old))))
   (is (= 3 (ev/request! pid 1 :read))))))

(deftest unsafe-candidates-and-disabled-policy-preserve-serving-generation
 (fixture "live-admission-refusals"
  (fn [pid old fresh]
   (let [candidate (spec fresh 2) calls (atom 0)
         ns (str "live.refused.g" (erlang/unique_integer (list :positive)))
         legacy {:digest (:digest fresh)
                 :sources {ns (str "(ns " ns ") (defn answer [] 42)")}
                 :resolve (fn [] (swap! calls inc) candidate)}]
    (reload/set-enabled! false)
    (is (= :held (:status (reload/activate! pid 1 candidate))))
    (reload/set-enabled! true)
    (is (= {:status :blocked :reason :verified-candidate-required} (reload/activate! pid 1 legacy)))
    (is (= 0 @calls))
    (is (not (BeamLisp.Env/loaded_ns? ns)))
    (is (= :refused (:status (reload/activate! pid 1 candidate))))
    (is (= 1 (:version (ev/status pid))))
    (is (= :stale (:status (generation/with! fresh #(reload/activate! pid 9 candidate)))))
    (is (= 1 (ev/request! pid 1 :inc)))))))

(deftest attached-preview-cannot-silently-authorize-message-publication
 (try
  (reload/set-enabled! true)
  (reload/abort)
  (reload/stage (str "(ns live.preview.g" (erlang/unique_integer (list :positive)) ") (defn answer [] 1)"))
  (reload/attach {:strategy :quiesce :modules ["busy"] :mailbox-count (fn [_] 10)})
  (is (= :held (:status (reload/commit))))
  (is (some (fn [e] (= :message-migration (:kind e))) (:errors (reload/status))))
  (finally (reload/abort) (reload/set-enabled! nil))))

(deftest identity-refusal-retains-the-original-prepared-graph
 (fixture "live-refused-migration"
  (fn [pid old fresh]
   (reload/set-enabled! true)
   ;; The spec is owned actual Source; a changed digest cannot borrow that
   ;; candidate's admission, and refusal never mutates the old owner.
   (let [bad (assoc (spec fresh 2) :digest "unverified")]
    (is (= :refused (:status (generation/with! fresh #(reload/activate! pid 1 bad)))))
    (is (= 1 (:version (ev/status pid))))
    (is (= 1 (ev/request! pid 1 :inc)))
    (is (erlang/== fresh (generation/attested-prepared! fresh)))))))
