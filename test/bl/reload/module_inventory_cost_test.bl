(ns reload.module-inventory-cost-test (:require [reload.generation]))

(deftest compiler-inventory-does-not-register-lazy-resource-captures
 (let [namespace "core"
       definitions (BeamLisp.Env/ns_defs namespace)
       expected (cons (BeamLisp.Emit/module_for namespace)
                      (keys (BeamLisp.Emit/body_modules definitions)))
       inventory (BeamLisp.Env/fetch_exact! "reload.generation" "namespace-modules")
       pattern (tuple :Elixir.BeamLisp.LazyMemo :create 1)]
  (try
   (erlang/trace_pattern pattern true (list :local :call_count))
   (let [actual (inventory namespace)
         count (elem (erlang/trace_info pattern :call_count) 1)]
    (erlang/trace_pattern pattern false (list :local :call_count))
    (is (= (set expected) (set actual)))
    (is (= 0 count)))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
