(ns reload.sdk-sealed-initialization-test)

(deftest actual-sealed-sdk-first-initialization-requires-image-aware-recognition
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       sdk (System/fetch_env! "BL_SDK_PRODUCT")
       out (Path/join (System/tmp_dir!)
             (str "sdk-sealed-initialization-" (erlang/unique_integer (list :positive))))]
  (try
   (let [[output status] (System/cmd "python3"
                          (list (Path/join root "test/scripts/check_sdk_sealed_initialization.py")
                                "--root" root "--sdk" sdk "--out" out)
                          (list (tuple :stderr_to_stdout true)))]
    (doseq [line (String/split output "\n")]
     (when (or (String/starts_with? line ":sealed-sdk-loading-context-observation")
               (String/starts_with? line ":sealed-sdk-loader-control-source"))
      (println line)))
    (is (= 0 status) output)
    (is (String/contains? output "SDK_SEALED_INITIALIZATION_CONTROLS_READY") output))
   (finally (File/rm_rf! out)))))
