(ns reload.sdk-loading-context-control-test
 (:require [test.support.source-fixtures :as fixtures]))

(defn- restore-env! [name value]
 (if (nil? value) (System/delete_env name) (System/put_env name value)))

(defn- child [mode]
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (File/cwd!))
       prior-root (System/get_env "BL_TEST_SOURCE_ROOT")
       prior-mode (System/get_env "BL_TEST_SDK_LOADING_CONTEXT_CONTROL")]
  (try
   (System/put_env "BL_TEST_SOURCE_ROOT" root)
   (System/put_env "BL_TEST_SDK_LOADING_CONTEXT_CONTROL" mode)
   (let [[output status] (fixtures/cold! "test/fixtures/sdk_loading_context_control.bl")]
    ;; Keep bounded first-order observations even when ordinary assertions pass.
    ;; Otherwise a refusal before the intended load could look like causality.
    (doseq [line (String/split output "\n")]
     (when (or (String/starts_with? line ":sdk-loading-control-source")
               (String/starts_with? line ":sdk-loading-context-observation"))
      (println line)))
    [output status])
   (finally
    (restore-env! "BL_TEST_SOURCE_ROOT" prior-root)
    (restore-env! "BL_TEST_SDK_LOADING_CONTEXT_CONTROL" prior-mode)))))

(deftest fresh-sdk-initialization-restores-actual-application-caller-context
 (let [[output status] (child "original")]
  (is (= 0 status) output)
  (is (String/contains? output "SDK_LOADING_CONTEXT_ORIGINAL_READY") output)))

(deftest unmodified-source-derived-loader-preserves-the-same-lifetime-boundary
 (let [[output status] (child "copied-original")]
  (is (= 0 status) output)
  (is (String/contains? output "SDK_LOADING_CONTEXT_COPIED_ORIGINAL_READY") output)))

(deftest source-derived-loader-without-sdk-redirect-must-fail-the-same-invariant
 ;; A distinct fresh VM is essential: no namespace flags, SDK Vars or receipts
 ;; are cleared to manufacture another first initialization.
 (let [[output status] (child "without-redirect")]
  (is (= 0 status) output)
  (is (String/contains? output "SDK_LOADING_CONTEXT_REDIRECT_CONTROL_CAUGHT") output)))
