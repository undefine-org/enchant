(ns reload.sdk-prelease-publication-control-test
 (:require [test.support.source-fixtures :as fixtures]))

(deftest real-image-before-first-lease-protects-seed-only-code-and-detects-the-image-only-mutation
 (let [prior (System/get_env "BL_TEST_SOURCE_ROOT")
       root (or prior (BeamLisp/cwd))]
  (try
   (System/put_env "BL_TEST_SOURCE_ROOT" root)
   (let [[output status] (fixtures/cold! "test/fixtures/sdk_prelease_publication_control.bl")]
    (doseq [line (String/split output "\n")]
     (when (or (String/starts_with? line ":sdk-prelease-source")
               (String/starts_with? line ":sdk-prelease-custody")
               (String/starts_with? line ":sdk-prelease-publication-control"))
      (println line)))
    (is (= 0 status) output)
    (is (String/contains? output "SDK_PRELEASE_PUBLICATION_CONTROL_READY") output))
   (finally
    (if (nil? prior) (System/delete_env "BL_TEST_SOURCE_ROOT")
      (System/put_env "BL_TEST_SOURCE_ROOT" prior))))))

(deftest corrupt-image-row-cannot-fall-through-to-absent-seed-evidence
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       sdk (System/fetch_env! "BL_SDK_PRODUCT")
       out (Path/join (System/tmp_dir!)
             (str "sdk-prelease-image-" (erlang/unique_integer (list :positive))))]
  (try
   (let [[output status] (System/cmd "python3"
                          (list (Path/join root "test/scripts/check_sdk_prelease_publication.py")
                                "--root" root "--sdk" sdk "--out" out)
                          (list (tuple :stderr_to_stdout true)))]
    (doseq [line (String/split output "\n")]
     (when (String/starts_with? line ":sdk-prelease-image-corruption") (println line)))
    (is (= 0 status) output)
    (is (String/contains? output "SDK_PRELEASE_IMAGE_CONTROLS_READY") output))
   (finally (File/rm_rf! out)))))

(deftest real-source-only-sdk-receipts-are-selected-before-seed-fallback
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       sdk (System/fetch_env! "BL_SDK_PRODUCT")
       out (Path/join (System/tmp_dir!)
             (str "sdk-source-only-guard-" (erlang/unique_integer (list :positive))))]
  (try
   (let [[output status] (System/cmd "python3"
                          (list (Path/join root "test/scripts/check_sdk_prelease_publication.py")
                                "--root" root "--sdk" sdk "--out" out "--source-only")
                          (list (tuple :stderr_to_stdout true)))]
    (doseq [line (String/split output "\n")]
     (when (String/starts_with? line ":sdk-prelease-source-only") (println line)))
    (is (= 0 status) output)
    (is (String/contains? output "SDK_PRELEASE_SOURCE_ONLY_CONTROLS_READY") output))
   (finally (File/rm_rf! out)))))
