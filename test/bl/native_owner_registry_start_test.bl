(ns native-owner-registry-start-test)

(deftest actual-bootstrap-registry-uses-admitted-native-start-without-managed-recursion
 (let [registry (Process/whereis :beam_lisp_owner_registry)
       supervisor (Process/whereis :Elixir.BeamLisp.Supervisor)
       spec (elem (erlang/apply :supervisor :get_childspec (list supervisor :beam_lisp_owner_registry)) 1)
       receipt (BeamLisp.Env/native_process_start_evidence! registry supervisor)]
  (is (and registry (Process/alive? registry)))
  (is (and supervisor (Process/alive? supervisor)))
  (is (= [:Elixir.BeamLisp.Supervisor :start_server] [(elem (:start spec) 0) (elem (:start spec) 1)]))
  (is (= 1 (count (:receipts receipt))))
  (is (= :unmanaged-native-class (:custody-kind (first (:receipts receipt)))))
  (is (= supervisor (:creator (first (:receipts receipt)))))
  (is (nil? (Process/get :bl_generation)))
  (is (= {:status :refused :kind :unknown-owner-registry-message}
         (GenServer/call registry [:startup-probe])))))
