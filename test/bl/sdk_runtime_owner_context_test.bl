(ns sdk-runtime-owner-context-test
 (:require [data.bounded-cache :as cache] [data.cache-pool :as pool] [env]))

(defn- ambient-context [pid]
 (let [dictionary (first (elem (erlang/apply :sys :get_status (list pid)) 3))]
  {:generation (Keyword/get dictionary :bl_generation)
   :env (Keyword/get dictionary :bl_env)}))

(defn- ready-owner? [name]
 ;; Optional cache startup has a 25ms budget and may decline a cold touch.
 ;; Observe eventual readiness through its existing idempotent named API;
 ;; never change SDK policy, manufacture a PID or skip the lifetime checks.
 (let [deadline (+ (System/monotonic_time :millisecond) 5000)]
  (loop []
   (if (cache/ready! name) true
    (if (>= (System/monotonic_time :millisecond) deadline) false
     (do (receive (after 10 nil)) (recur)))))))

(deftest fixed-sdk-cache-owner-does-not-inherit-an-unmanaged-starter-environment
 (BeamLisp.Env/ensure_sdk_runtime!)
 (let [name (keyword (str "sdk_runtime_owner_" (erlang/unique_integer (list :positive))))
       scope (env/fork) prior-pool (Process/whereis pool/NAME)]
  (try
   (is (nil? (Process/get :bl_generation)))
   (is (env/with-env scope #(ready-owner? name)))
   (let [pid (Process/whereis name)]
    (is (= {:env :global :generation nil} (ambient-context pid)))
    (env/destroy scope)
    (is (Process/alive? pid))
    (is (cache/put! name :answer :revision 42))
    (is (= 42 (:value (cache/lookup name :answer :revision)))))
   (finally
    (when-let [pid (Process/whereis name)] (GenServer/stop pid))
    (when-not prior-pool
     (when-let [pid (Process/whereis pool/NAME)] (GenServer/stop pid)))
    (env/destroy scope)))))

(deftest runtime-adoption-without-a-generation-still-requires-the-real-sdk-init
 (is (= :framework_adoption_requires_generated_init
        (try (BeamLisp.Env/adopt_sdk_runtime!) :unexpected-adoption
         (catch error (BeamLisp.ExInfo/ex_original error))))))
