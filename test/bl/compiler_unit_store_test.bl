(ns compiler-unit-store-test)

;; Exercise the current helper with the retained immutable compiler. This
;; private namespace never replaces the selected SDK's build/runtime modules.
(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/build/unit-store.bl"))]
 (BeamLisp/eval (String/replace source "(ns unit-store " "(ns compiler-unit-store-under-test ")))

(ns compiler-unit-store-test)

(defn- artifact! [prepared directory previous]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" "artifact!")
                       (list prepared directory previous)))

(defn- prepare [file module action]
 (let [handle (BeamLisp.AOT/open_workspace
               {:version 2 :phase-imports (list 'core 'sugar)
                :sources (list {:namespace 'compiler.cache.fixture :file file})} {})]
  (try (action (BeamLisp.AOT/prepare_host_unit handle {:namespace 'compiler.cache.fixture :module module}))
       (finally (BeamLisp.AOT/close_workspace! handle)))))

(deftest complete-units-reuse-without-publication-and-input-or-target-changes-miss
 (let [root (Path/join (System/tmp_dir!) (str "compiler-unit-cache-" (System/unique_integer (list :positive))))
       file (Path/join root "fixture.bl")
       a (Path/join root "a") b (Path/join root "b") c (Path/join root "c") d (Path/join root "d")
       module :Elixir.BeamLisp.CompilerCacheFixture]
  (File/mkdir_p! root)
  (try
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 42)")
   (prepare file module
    (fn [prepared]
     (let [first (artifact! prepared a nil)
           again (artifact! prepared b a)]
      (is (= true (:compiled first)))
      (is (= false (:compiled again)))
      (is (= (:key first) (:key again)))
      (is (= (get-in first [:verified :beams]) (get-in again [:verified :beams])))
      (is (= false (erlang/module_loaded module)))
      (is (= false (get-in again [:verified :native-admission])))
      ;; A real independent compilation remains available to the reproduction
      ;; stage; it must not consult the preceding stage's new cache entries.
      (let [fresh (artifact! prepared c nil)]
       (is (= true (:compiled fresh)))
       (is (= (get-in first [:verified :beams]) (get-in fresh [:verified :beams])))))))
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 99)")
   (prepare file module
    (fn [prepared]
     (let [changed (artifact! prepared d a)]
      (is (= true (:compiled changed)))
      (is (= false (erlang/module_loaded module))))))
   (prepare file :Elixir.BeamLisp.CompilerCacheOtherFixture
    (fn [prepared]
     (is (= true (:compiled (artifact! prepared (Path/join root "other") d))))))
   (finally (File/rm_rf! root)))))

(deftest corrupt-complete-unit-is-rejected-before-it-can-be-restored
 (let [root (Path/join (System/tmp_dir!) (str "compiler-unit-corrupt-" (System/unique_integer (list :positive))))
       file (Path/join root "fixture.bl") a (Path/join root "a") b (Path/join root "b")]
  (File/mkdir_p! root)
  (try
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 42)")
   (prepare file :Elixir.BeamLisp.CompilerCacheCorruptionFixture
    (fn [prepared]
     (let [result (artifact! prepared a nil)
           unit (Path/join a (:key result))
           beam (first (remove #(= "artifact-unit.term" %) (File/ls! unit)))]
      (File/write! (Path/join unit beam) "corrupted")
      (is (= :artifact-bytes-changed
             (try (artifact! prepared b a) nil (catch error (:kind (ex-data error))))))
      (is (= false (File/exists? b))))))
   (finally (File/rm_rf! root)))))

(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/build/seed.bl"))]
 (BeamLisp/eval (String/replace source "(ns seed\n" "(ns compiler-seed-under-test\n")))
(ns compiler-unit-store-test)

(deftest qualified-flat-floor-import-resolves-the-physical-sdk-root
 (let [directory (Path/join (System/tmp_dir!) (str "compiler-flat-import-" (System/unique_integer (list :positive))))
       sdk (System/fetch_env! "BL_SDK_PRODUCT")
       compiler (get (Jason/decode! (File/read! (Path/join sdk "artifact.json"))) "compiler")
       root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
       file (Path/join root "host/compiler_data.bl")
       prefix (first (String/split (File/read! (Path/join root "build/seed.bl"))
                                   ";; Artifact production owns preparation"))
       baseline {"version" 1 "compiler_key" (BeamLisp.AOTCache/compiler_key)
                 "abi_prefix_sha256" (Base/encode16 (crypto/hash :sha256 prefix) (list (tuple :case :lower)))
                 "floor" (Path/join compiler "seed")
                 "inputs" (Jason/decode! (File/read! (Path/join compiler "qualification/inputs.json")))}
       handle (BeamLisp.AOT/open_workspace
                {:version 2 :phase-imports (list 'core 'sugar)
                 :sources (list {:namespace 'host.compiler-data :file file})} {})]
  (try
   (let [prepared (BeamLisp.AOT/prepare_host_unit handle
                    {:namespace 'host.compiler-data :module :Elixir.BeamLisp.CompilerData})
         result (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "compiler-seed-under-test" "generation-import!")
                  (list prepared baseline directory))
         unit (BeamLisp.AOT/verify_unit directory)]
    (is (= true result))
    (is (= 1 (count (:beams unit))))
    (is (= (File/read! (Path/join compiler "seed/Elixir.BeamLisp.CompilerData.beam"))
           (second (first (:beams unit))))))
   (finally (BeamLisp.AOT/close_workspace! handle) (File/rm_rf! directory)))))

(deftest different-boot-targets-with-the-same-input-closure-have-distinct-cache-addresses
 (let [root (BeamLisp.Tiers/priv_root)
       handle (BeamLisp.AOT/open_workspace
                {:version 2 :phase-imports (list 'core 'sugar)
                 :sources (list {:namespace 'core :file (Path/join root "boot/core.bl")}
                                {:namespace 'sugar :file (Path/join root "boot/sugar.bl")})} {})]
  (try
   (let [core (BeamLisp.AOT/prepare_unit handle 'core)
         sugar (BeamLisp.AOT/prepare_unit handle 'sugar)
         key (fn [prepared] (BeamLisp.Ns.Rt/invoke
                             (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" "artifact-key")
                             (list prepared)))]
    (is (not= (:namespace core) (:namespace sugar)))
    (is (not= (key core) (key sugar))))
   (finally (BeamLisp.AOT/close_workspace! handle)))))

(deftest captured-input-reuse-skips-preparation-and-keeps-independent-reproduction
 (let [directory (Path/join (System/tmp_dir!) (str "compiler-input-cache-" (System/unique_integer (list :positive))))
       root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
       file (Path/join root "host/compiler_data.bl")
       a (Path/join directory "a") b (Path/join directory "b")
       phase (str (String/duplicate "a" 64))
       spec {:namespace 'host.compiler-data :module :Elixir.BeamLisp.CompilerData}
       selection {:namespace 'host.compiler-data :file file :host-spec spec}
       handle (BeamLisp.AOT/open_workspace
                {:version 2 :phase-imports (list 'core 'sugar)
                 :sources (list {:namespace 'host.compiler-data :file file})} {})
       invoke (fn [name args] (BeamLisp.Ns.Rt/invoke
                               (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" name) args))
       before (BeamLisp.CompilerData/module_info :md5)]
  (try
   (let [prepared (BeamLisp.AOT/prepare_host_unit handle spec)
         captured (artifact! prepared a nil)
         baseline {"compiler_key" (BeamLisp.AOTCache/current_compiler_key)
                   "abi_prefix_sha256" (Base/encode16 (crypto/hash :sha256
                     (first (String/split (File/read! (Path/join root "build/seed.bl"))
                              ";; Artifact production owns preparation"))) (list (tuple :case :lower)))
                   "modules" (into {} (map (fn [[module bytes]]
                      [(str (Atom/to_string module) ".beam")
                       (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower)))])
                      (get-in captured [:verified :beams])))}
         _ (invoke "record-compiler-unit!" (list prepared (assoc captured :compiled false) a phase))
         restore (fn [out seen-phase old]
                   (invoke "restore-compiler-unit!" (list selection out a seen-phase true old)))
         reused (restore b phase baseline)]
    (is (= false (:compiled reused)))
    (is (= (get-in captured [:verified :beams]) (:beams reused)))
    (is (nil? (restore (Path/join directory "wrong-phase") "different" baseline)))
    (is (nil? (restore (Path/join directory "wrong-floor") phase {"modules" {}})))
    (let [context (System/get_env "BL_COMPILER_EMITTER_CONTEXT")]
     (try
      (System/put_env "BL_COMPILER_EMITTER_CONTEXT" "changed-emitter")
      (is (nil? (restore (Path/join directory "wrong-emitter") phase baseline)))
      (finally
       (if context (System/put_env "BL_COMPILER_EMITTER_CONTEXT" context)
                   (System/delete_env "BL_COMPILER_EMITTER_CONTEXT")))))
    ;; Even matching bytes must not let a planning stage claim its own newly
    ;; emitted unit as independently reproduced output.
    (invoke "record-compiler-unit!" (list prepared captured a phase))
    (is (nil? (restore (Path/join directory "new-output") phase baseline)))
    (invoke "record-compiler-unit!" (list prepared (assoc captured :compiled false) a phase))
    (let [other (assoc spec :module :Elixir.BeamLisp.OtherCompilerDataCacheTarget)]
     (invoke "record-compiler-unit!" (list (assoc prepared :host-spec other) (assoc captured :compiled false) a phase))
     ;; A second target for the same Source namespace has a separate record.
     (is (= (:beams reused) (:beams (restore (Path/join directory "multiple-targets") phase baseline))))
     ;; Even a forged matching target label cannot adopt different module bytes.
     (is (nil? (invoke "restore-compiler-unit!"
                 (list (assoc selection :host-spec other) (Path/join directory "forged-target")
                       a phase true baseline)))))
    (is (= before (BeamLisp.CompilerData/module_info :md5))))
   (finally (BeamLisp.AOT/close_workspace! handle) (File/rm_rf! directory)))))
