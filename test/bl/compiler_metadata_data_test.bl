(ns compiler-metadata-data-test)

(defn- refused [value options]
 (try (BeamLisp.CompilerData/check_first_order! value options) nil
      (catch error (:reason (ex-data error)))))

(deftest form-metadata-preserves-passive-collection-data-and-its-bounds
 (doseq [form ['x (list) (list 'inc 4) {:x 1} [1 2] #{1} 1.23M]]
  (let [marked (tuple :meta form {:line 1})]
   (is (= marked (BeamLisp.CompilerData/check_first_order! marked)))
   (is (= :node-limit (refused marked {:max-nodes 1})))
   (is (= :byte-limit (refused marked {:max-bytes 1}))))))

(deftest form-metadata-cannot-carry-native-resources-or-execute-payloads
 (let [calls (atom 0) callback (fn [] (swap! calls inc))
       marked #(tuple :meta % {:line 1})]
  (doseq [value [(marked 7) (marked (tuple :native 1)) (marked (list callback))
                (marked {:hidden (erlang/make_ref)})
                (marked (maps/put :__struct__ :foreign {}))
                (tuple :meta 'x {:hidden callback})]]
   (is (some? (refused value {}))))
  (is (= 0 @calls))))
