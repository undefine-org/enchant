(ns aot-constructor-boolean-test)

(deftest source-runtime-boolean-predicate-keeps-exact-erlang-shape-semantics
 (doseq [value [true false nil 0 1 "true" () [] {} :other]]
  (is (= (erlang/is_boolean value)
       (BeamLisp.AOT/interpret_constructor!
        {:op :remote :mod :erlang :fun :is_boolean :args (list {:op :lit :val value})} {} {})))))

(deftest source-runtime-sorted-set-predicate-stays-in-the-first-order-domain
 (doseq [value [nil true 1 "x" () [] {} #{} 'syntax]]
  (is (= (BeamLisp.Ns.Rt/sorted_set? value)
       (BeamLisp.AOT/interpret_constructor!
        {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :sorted_set?
         :args (list {:op :lit :val value})} {} {})))))
