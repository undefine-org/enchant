;; Reuse actual Python regression methods through strict unittest discovery.
;; Three outer assertions describe adapter transport/coverage, not the number
;; of Python assertions. Each child receipt reports its own tests_run inventory.
(ns execution.qualification-test)

(defn- python-controls [file names]
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       driver (Path/join root "test/scripts/execution-qualification-driver.py")
       [output status] (System/cmd "python3" (to-list (concat [driver file] names))
                         (list (tuple :cd root) (tuple :stderr_to_stdout true)))
       rows (filterv #(String/starts_with? % "BL-HISTORY-UNITTEST ") (String/split output "\n"))]
  (when-not (and (= 0 status) (= 1 (count rows)))
   (throw (ex-info "Historical Python control failed" {:file file :output output :status status})))
  (let [report (Jason/decode! (String/replace_prefix (first rows) "BL-HISTORY-UNITTEST " "")
                             (list (tuple :keys :atoms)))]
   (println :history-python report)
   (is (= names (:selected report) (:passed report)))
   (is (= (count names) (:tests_run report)))
   (is (= true (:complete report))))))

(deftest E11-runtime-projection-preserves-prepared-native-products
 (python-controls "scripts/tests/test_ci_runtime_package.py"
  ["TestRuntimePackage.test_runtime_projection_keeps_the_prepared_inputs_and_modes"
   "TestRuntimePackage.test_native_products_restore_without_their_cargo_link_targets"]))

(deftest E25-embedded-test-library-drift-is-detected-read-only
 (python-controls "scripts/tests/test_embed_test_library.py"
  ["EmbeddedLibrary.test_round_trip_and_read_only_drift_check"])
 (is (= (File/read! (Path/join (BeamLisp.Tiers/priv_root) "std/test.bl"))
        (BeamLisp.TestRT/test_lib_source))))

(deftest E40-runtime-reuse-binds-producer-and-toolchain-inputs
 (python-controls "scripts/tests/test_ci_runtime_reuse.py"
  ["ProducerConfigurationTests.test_orchestration_can_change_but_native_steps_and_version_cannot"
   "RuntimeReuseTests.test_every_runtime_and_unknown_input_requires_a_new_producer"]))

(deftest E42-direct-vms-are-counted-without-counting-parents
 (python-controls "scripts/tests/test_bl_mem.py"
  ["TestVmDiscovery.test_launcher_and_direct_component_vms_both_own_memory"
   "TestVmDiscovery.test_packed_drop_entry_owns_memory_and_keeps_its_command"
   "TestVmDiscovery.test_parents_and_unrelated_elixir_vms_are_not_counted"]))

(deftest E52-shard-inventory-is-complete-and-duration-balanced
 (python-controls "scripts/tests/test_ci_test_shard.py"
  ["TestPartitions.test_every_conventional_test_appears_exactly_once"
   "TestPartitions.test_long_suites_are_spread_by_duration_without_losing_files"]))

(deftest E53-empty-or-interrupted-candidate-runs-cannot-pass
 (python-controls "scripts/tests/test_qualify_candidate.py"
  ["Receipts.test_declared_test_file_with_no_discovered_tests_cannot_pass"
   "Receipts.test_later_success_cannot_hide_an_earlier_failed_process"
   "Receipts.test_successful_files_do_not_hide_a_failed_worker_or_missing_batch_end"
   "Receipts.test_handover_finishes_remaining_files_and_retains_isolated_processes"]))

(deftest E82-candidate-and-source-identities-do-not-inherit-old-green-results
 (python-controls "test/scripts/test_execution_history.py"
  ["ParentFailureControls.test_input_drift_is_rejected_before_accepting_child_receipt"
   "CaptureControls.test_workflow_launcher_and_toolchain_edits_invalidate_the_snapshot"])
 (python-controls "scripts/tests/test_qualify_candidate.py"
  ["Receipts.test_resume_rejects_other_artifacts_and_preserves_latest_failures"])
 (python-controls "test/scripts/test_artifact_generation_inputs.py"
  ["ArtifactGenerationInputsTest.test_compiler_copy_corruption_refuses_even_when_original_is_unchanged"
   "ArtifactGenerationInputsTest.test_application_code_copy_is_checked_independently"
   "ArtifactGenerationInputsTest.test_copied_source_is_checked_before_code_starts"
   "ArtifactGenerationInputsTest.test_copied_native_product_is_checked_before_code_starts"]))

(deftest E84-incomplete-or-failed-producer-backends-never-authorize-reuse
 (python-controls "scripts/tests/test_ci_runtime_reuse.py"
  ["ProducerGateTests.test_complete_backend_proof_is_required"
   "ProducerGateTests.test_a_failed_backend_cannot_be_hidden_by_other_successes"]))

(deftest E83-publication-ranges-refuse-missing-bases-and-scan-new-history
 (python-controls "scripts/tests/test_public_evidence.py"
  ["CommitRanges.test_missing_base_and_invalid_hook_input_refuse"
   "CommitRanges.test_new_branch_scans_unpublished_history"]))
