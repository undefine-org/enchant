(ns contextual-identifier-spans-test
 (:require [syntax :as s] [expand :as x]))

(defn- context []
 {:world (crypto/hash :sha256 "spans") :namespace 'example :space 'value :scopes {}})

(deftest contextual-reader-positions-physical-symbols-without-changing-the-ordinary-reader
 (let [forms (s/read "α β" "unicode.bl" (context))]
  (is (= '(0 2) (Enum/map forms #(get-in % [:origin :offset]))))
  (is (= '(1 3) (Enum/map forms #(get-in % [:origin :end-offset]))))
  (is (= (list (tuple :symbol "α") (tuple :symbol "β"))
         (BeamLisp.Reader/read_string "α β" "unicode.bl")))))

(deftest metadata-preserves-the-target-symbols-own-token-span
 (let [node (first (s/read "^String x" "metadata.bl" (context)))]
  (is (= 'x (:value node)))
  (is (= 8 (get-in node [:origin :offset])))
  (is (= 9 (get-in node [:origin :end-offset])))
  (is (= 'String (get-in node [:origin :tag])))))

(deftest declaration-and-import-provenance-comes-from-actual-reader-symbols
 (let [library "(ns library) (defn answer [] 42)"
       client "(ns client) (import-world 'library 'old :only [answer]) (answer)"
       program (x/program [{:namespace 'library :revision 'old :file "library.bl" :source library}
                           {:namespace 'client :revision 'current :file "client.bl" :source client}]
                          ['client 'current])
       declaration (first (Map/values (get-in program [:provenance :declarations])))
       origin (:origin declaration)
       imported (first (get-in program [:provenance :imports]))
       import-origin (get-in imported [:only-origins 'answer])
       slice (fn [source span]
               (Enum/join (Enum/slice (String/codepoints source) (:offset span)
                                     (- (:end-offset span) (:offset span))) ""))]
  (is (= "answer" (slice library origin)))
  (is (= "answer" (slice client import-origin)))
  (is (= (list 'library 'old) (:unit declaration)))))
