(ns contextual-class-activation-test
 (:require [compile.world :as world] [reload.execution :as execution] [reload.generation :as generation]))
(defn- reason [action]
 (try (action) :unexpected-success
  (catch error (or (BeamLisp.ExInfo/ex_original error) (:kind (ex-data error))))))
(defn- fixture [sources entry action]
 (let [suffix (str "R" (erlang/unique_integer (list :positive)))
       dir (Path/join (System/tmp_dir!) (str "class-activation-" suffix))
       module (Module/concat :Elixir.ContextualClassActivation suffix)
       rows (mapv (fn [[namespace text]]
                    {:namespace namespace :text (String/replace text "REVISION" suffix) :file (str namespace ".bl")}) sources)]
  (File/mkdir_p! dir)
  (try
   (doseq [row rows] (File/write! (Path/join dir (:file row)) (:text row)))
   (File/write! (Path/join dir "world.bl")
    (str "{:version 1 :profile 'syntax-v1 :entry ['" entry " '" suffix "] :sources ["
      (Enum/join (mapv #(str "{:namespace '" (:namespace %) " :revision '" suffix " :file \"" (:file %) "\"}") rows) " ")
      "] :libraries []}"))
   (let [prepared (world/prepare (Path/join dir "world.bl"))
         artifact (world/prepare-unit prepared module)
         verified (BeamLisp.AOT/compile_unit artifact)
         g (execution/prepare-captured-unit! verified)]
    (try (action g prepared verified)
     (finally (generation/retire! g))))
   (finally (File/rm_rf! dir)))))
(defn- initialize [g]
 (execution/initialize-instance! g)
 (execution/complete-preparation! (:cache-key g) g))
(defn- reference [prepared name]
 (:reference (first (filter #(and (= name (get-in % [:declaration :name]))
                                  (not= :local (get-in % [:declaration :visibility])))
                            (vals (get-in prepared [:program :references]))))))

(deftest actual-contextual-record-and-type-freeze-initialize-and-retire-without-compiling
 (fixture [["activation" "(ns activation) (defrecord Packet [payload]) (deftype Opaque [payload])
                          (defn make [x] [(->Packet x) (->Opaque x)]) (make 42)"]]
  "activation"
  (fn [g prepared verified]
   (let [classes (BeamLisp.Set/to_list (:classes g))
         schemas (Map/new (Enum/map classes (fn [module]
                   (tuple module (elem (first (ets/lookup :beam_lisp_source_extent_heads
                     (tuple :source_owned_class (:scope g) module))) 1)))))
         target (tuple :Elixir.BeamLisp.Emit :compile_descriptor 1)]
    (is (= 2 (count classes) (count schemas)))
    (is (every? #(contains? schemas %) classes))
    (is (every? #(nil? (BeamLisp.Record/info %)) classes))
    (erlang/trace_pattern target true (list :call_count))
    (try
     (initialize g)
     (let [[packet opaque] (execution/invoke-instance-entry! g)]
      (is (= 42 (:payload packet)))
      (is (contains? (:classes g) (erlang/map_get :__struct__ packet)))
      (is (= :bl_deftype (elem opaque 0)))
      (is (contains? (:classes g) (elem opaque 1)))
      (is (= (tuple 42) (elem opaque 2))))
     (is (= (tuple :call_count 0) (erlang/trace_info target :call_count)))
     (is (= [(Map/put {:payload 7} :__struct__ (first (filter #(= :record (elem (BeamLisp.Record/info %) 0)) classes)))
             (tuple :bl_deftype (first (filter #(= :deftype (elem (BeamLisp.Record/info %) 0)) classes)) (tuple 7))]
            (execution/invoke-instance-binding! g (reference prepared 'make) [7])))
     (is (every? BeamLisp.Env/class_schema_held? classes))
     (is (= :retired (:status (generation/retire! g))))
     (is (every? #(not (BeamLisp.Env/class_schema_held? %)) classes))
     (is (= :unready-prepared-generation (reason #(execution/invoke-instance-entry! g))))
     (finally (erlang/trace_pattern target false (list :call_count))))))))

(deftest actual-cross-world-class-imports-use-the-same-native-factory-owner
 (fixture [["provider" "(ns provider) (defrecord Packet [payload]) (deftype Opaque [payload])"]
           ["consumer" "(ns consumer) (import-world 'provider 'REVISION :only [->Packet ->Opaque])
                         [(->Packet 41) (->Opaque 42)]"]]
  "consumer"
  (fn [g prepared verified]
   (initialize g)
   (let [[packet opaque] (execution/invoke-instance-entry! g)]
    (is (= 2 (count (:classes g))))
    (is (= 41 (:payload packet)))
    (is (contains? (:classes g) (erlang/map_get :__struct__ packet)))
    (is (= (tuple 42) (elem opaque 2)))
    (is (contains? (:classes g) (elem opaque 1)))))))

(deftest explicit-source-publication-cannot-name-the-compiler-replay-boundary
 (is (= :unbound-identifier
        (reason #(fixture [["activation" "(ns activation) (defrecord Packet [payload])
                                         (BeamLisp.Env/replay_source_class! {} nil)"]]
                  "activation" (fn [g prepared verified] (erlang/error :unexpected-source-admission)))))))
