(ns native-execution-actor-grant-pin-test (:require [reload.generation :as generation]))

(deftest actor-pin-protects-explicit-native-grants-before-any-replacement
 ;; A real explicitly granted native fixture, never an SDK declaration/receipt.
 ;; Keep its actual emitted bytes because OTP's dynamic staging file is absent.
 (let [original (first (Code/compile_string
                         "defmodule ActorPinGrantFixture do\n def value, do: 1\nend"))
       module (elem original 0)
       g (generation/prepare!
          {:application-id "actor-native-grant-pin"
           :native-modules #{"ActorPinGrantFixture"}
           :sources {"actor.pin.grant"
            (str "(ns actor.pin.grant) "
                 "(defserver owner (init [_] (ok nil)) "
                 " (handle-call :value [_ st] (reply (ActorPinGrantFixture/value) st))) "
                 "(defn start-owner [] (start owner nil))")}})
       pid (generation/invoke! g "actor.pin.grant/start-owner" [])
       replacement (BeamLisp.Emit/compile_descriptor
                     (BeamLisp.Emit/descriptor_for module
                       (list (BeamLisp.Emit/function_clause :value (BeamLisp.Emit/lit 2)))))]
  (try
   (is (= 1 (call pid :value)))
   (is (= :refused
          (try (BeamLisp.Env/publish_binaries! (list replacement) "actor-native-grant-replacement")
               :published (catch _ :refused))))
   (is (= 1 (erlang/apply module :value (list))))
   (is (= 1 (try (call pid :value) (catch _ :late-refusal))))
   (finally
    (when (Process/alive? pid) (stop pid))
    (generation/retire! g)
    (BeamLisp.Env/publish_binaries! (list original) "actor-native-grant-restoration")))))
