; Native product contracts. Nix owns compilation and complete source identity;
; the language retains destination custody, loading names and failure behavior.
; Per-crate derivation identities and prepared-input provenance are additionally
; exercised by scripts/tests/test_native_product_derivations.py and
; test/bl/artifact_provider_test.bl. Legacy native-key/cargo-verdict checks below
; cover compatibility helpers, not authoritative production identities.

(ns test.native
  (:require [build :as b] [store :as st] [vm.native :as n]))

(def root (str (System/tmp_dir!) "/beam_lisp_native_stage-" (System/pid) "-" (erlang/unique_integer (list :positive))))
(def crate (str root "/native/tiny"))

(defn setup! []
  (File/rm_rf! root)
  (File/mkdir_p! (str crate "/src"))
  (File/write! (str crate "/Cargo.toml")
               (str "[package]\nname = \"tiny\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
                    "\n[lib]\ncrate-type = [\"cdylib\"]\n"))
  (File/write! (str crate "/Cargo.lock") "version = 4\n\n[[package]]\nname = \"tiny\"\nversion = \"0.1.0\"\n")
  (File/write! (str crate "/src/lib.rs")
               ; `#[no_mangle] extern "C"` so the symbol REACHES the cdylib.
               ; A plain `pub fn` in a cdylib crate is mangled and dropped, so
               ; the linker emits identical bytes whatever the body says —
               ; measured: two different sources, one md5. Tests that change the
               ; source to provoke a rebuild depend on this actually working.
               "#[no_mangle]\npub extern \"C\" fn tiny_answer() -> i32 { 42 }\n"))

(defn- nix? []
  (when-not (System/find_executable "nix") (throw (ex-info "Nix is required for native product tests" {})))
  true)

(deftest the-key-is-content
  (setup!)
  (let [k1 (b/native-key crate)]
    (is (= 32 (count k1)))
    (is (= k1 (b/native-key crate)) "the same inputs name the same key")
    (File/write! (str crate "/src/lib.rs") "// a different source\n")
    (is (not= k1 (b/native-key crate))
        "a changed source is a different key: a stale native cache is worse than none")))

(deftest a-missing-lock-refuses-without-mutating-project-inputs
  (setup!)
  (File/rm! (str crate "/Cargo.lock"))
  (let [result (b/build-native root nil)]
    (is (= 0 (:built result)))
    (is (= 1 (count (:errors result))))
    (is (includes? (first (:errors result)) "Cargo.lock"))
    (is (not (File/exists? (str crate "/Cargo.lock"))))))

(deftest the-stage-builds-once-then-finds-it
  (setup!)
  (if (nix?)
    (let [r1 (b/build-native root println)]
      (is (empty? (:errors r1)))
      (is (= 1 (:built r1)) "the crate is built")
      (is (File/exists? (n/project-installed-path root "tiny"))
          "the artefact lands where vm.native loads it from")
      (is (= (Path/basename (n/installed-path "tiny"))
             (Path/basename (n/project-installed-path root "tiny")))
          "the build installs the name the loader asks for — one spelling or none")
      (let [r2 (b/build-native root nil)]
        (is (= 0 (:built r2)) "an unchanged crate is not rebuilt")
        (is (= 1 (:cached r2)) "it is found by the key its inputs name"))
      (let [r3 (b/build-native root nil)]
        (is (= 1 (:cached r3)) "and found again — the key is a fixpoint, not a coin")))
    (is true "Nix prerequisite unavailable")))

; ── the contract across the build barrier ─────────────────────────────────
;
; A toolchain source may not require an ordinary one, so `build.bl` cannot
; reach `vm.native` — and the reverse edge is declined rather than forbidden:
; the runtime must not depend on the driver that produces it. One spelling per
; layer, and this is what holds the two together. BUG-070 is the failure it
; prevents: they disagreed in silence, `bl build` installed
; `priv/native/<crate>` while `BeamLisp.Native` asked for
; `priv/native/<crate>.so`, and so every crate was reported "built" and none
; was loadable, on any machine with no stale `.so` from an earlier naming to
; answer in its place.

(deftest the-installer-and-the-loader-agree-on-the-name
  (doseq [c ["tiny" "lazy_memo" "datom_fjall" "wry_webview"]]
    (is (= (b/nif-artifact-name c) (n/artifact-name c))
        (str "the build and the loader spell " c " the same")))
  (is (= (Path/basename (b/nif-artifact-name "tiny"))
         (Path/basename (n/installed-path "tiny")))
      "and the loader's own path ends in it"))


; ── the install invariant, across the barrier ────────────────────────────
;
; BUG-074 was not a wrong path; it was a wrong WRITE. `native-one` copied
; straight over an artefact the running VM had mmap'ed, the kernel dropped the
; mapped pages, the next read came from the NEW file, and a `.got` slot on disk
; is zero — so the next indirect call jumped to address 0.
;
; The rule is therefore behavioural, and it is the same rule in both layers:
; installing an artefact REPLACES the file, it never rewrites it in place. The
; two installers (`build/install-artifact!` and `vm.native/build!`) sit on
; opposite sides of the toolchain barrier and cannot share an implementation,
; so the rule is asserted as a behaviour.
;
; The observable is the inode, and it is a sound one — verified against `stat`
; before being relied on: `cp` over an existing file leaves the inode alone,
; `cp` to a temp then rename gives a new one. An in-place rewrite keeps the
; inode, which is exactly the thing that killed the VM.
;
; Coverage note: this exercises the BUILD's installer. The runtime's is the
; same two-step shape but installs into the live app's priv, which a test
; cannot retarget at a temp root — so it is asserted by inspection here, not
; by execution. Said plainly rather than implied by a green run.

(defn- inode-of
  "The inode of `path`, or nil. `:file.read_file_info` returns
   `{:ok, #file_info{}}`, and inode is element 11 of that record — read off a
   real file and matched against `stat`, not recited from the record layout."
  [path]
  (let [i (erlang/apply :file :read_file_info (list (erlang/binary_to_list path)))]
    (if (= :ok (elem i 0)) (elem (elem i 1) 11) nil)))

(deftest reinstalling-replaces-the-artefact-never-rewrites-it
  (setup!)
  (if (nix?)
    (let [_ (b/build-native root nil)
          dest (n/project-installed-path root "tiny")
          before (inode-of dest)]
      (is (some? before) "the artefact is installed to begin with")
      ; Genuinely different bytes, not a bumped constant. `{ 42 }` -> `{ 43 }`
      ; compiled to a byte-identical cdylib until `setup!` started emitting the
      ; symbol with `#[no_mangle] extern "C"` — measured: two different sources,
      ; one md5. The installer's skip branch then fired — correctly — and the
      ; file was legitimately untouched. A test that mistook that for a rewrite
      ; would have been green on the wrong thing forever.
      (File/write! (str crate "/src/lib.rs")
                   "#[no_mangle]\npub extern \"C\" fn tiny_answer() -> i32 { 43 }\n")
      (let [r2 (b/build-native root nil)
            after (inode-of dest)]
        (is (some? after) "and still there after a changed crate is reinstalled")
        (is (not= before after)
            (str "a reinstall REPLACES the file (new inode). Inode " before
                 " survived, which means it was written in place — and writing "
                 "a file the VM has mapped is BUG-074."
                 " r2=" (pr-str (select-keys r2 [:built :cached :errors :artifacts]))))))
    (is true "Nix prerequisite unavailable")))


; ── the verdict on a cargo run (FUP-100) ─────────────────────────────────
;
; The decision is a PURE function of (exit, cargo's output, the release dir
; cargo was told to write, the invocation) and the filesystem, so it is driven
; here directly rather than by shelling out. The two cases that matter most are
; exactly the ones a real cargo will not produce on demand — a ZERO exit with
; nothing on disk, and a NON-ZERO exit whose only evidence is cargo's own words
; — and a test that had to provoke them from cargo would be slower and prove
; less. The integrated case (a crate that yields no cdylib end to end) is beside
; them, guarded by `cargo?`.

(def verdict-root (str (System/tmp_dir!) "/bl_verdict_" (erlang/unique_integer (list :positive))))
(def verdict-none (str verdict-root "/nothing"))   ; never created: nothing to find

(deftest a-run-that-produced-nothing-names-the-crate-and-the-path
  (let [v (b/cargo-verdict "tiny" verdict-none 0 ""
                           "cargo build --release --target-dir D  (in /x/native/tiny)")]
    (is (:error v) "an exit of 0 with no artefact is still a failure")
    (is (includes? (:error v) "tiny") "names the CRATE")
    (is (includes? (:error v) (Path/join verdict-none "libtiny.so"))
        "names the artefact path it looked for")
    (is (includes? (:error v) "cargo build --release") "names the INVOCATION")))

(deftest a-failed-run-carries-cargos-own-words
  (let [v (b/cargo-verdict "tiny" verdict-none 101
                           "error[E0425]: cannot find value `x`" "cargo build --release")]
    (is (:error v))
    (is (includes? (:error v) "tiny"))
    (is (includes? (:error v) "101") "names cargo's exit code")
    (is (includes? (:error v) "error[E0425]") "and discards nothing cargo said — the point")))

(deftest only-a-zero-exit-with-the-artefact-is-ok
  (File/mkdir_p! verdict-root)
  (File/write! (Path/join verdict-root "libtiny.so") "not really an elf")
  (is (= (Path/join verdict-root "libtiny.so")
         (:ok (b/cargo-verdict "tiny" verdict-root 0 "" "cargo build --release")))
      "a zero exit WITH the artefact is the success case")
  (is (:error (b/cargo-verdict "tiny" verdict-root 1 "" "cargo build --release"))
      "a failed run is an error even with a stale artefact present: it is not this run's output"))

(deftest a-crate-that-yields-no-artefact-is-not-reported-built
  (setup!)
  (if (nix?)
    (do
      ; `crate-type = ["rlib"]`: cargo SUCCEEDS and writes no cdylib. This is the
      ; zero-exit-no-artefact case through the REAL step, so it also pins that
      ; the step does not report `:built` for a run that made nothing.
      (File/write! (str crate "/Cargo.toml")
                   (str "[package]\nname = \"tiny\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
                        "\n[lib]\ncrate-type = [\"rlib\"]\n"))
      (File/write! (str crate "/src/lib.rs") "pub fn tiny_answer() -> i32 { 42 }\n")
      (let [r (b/build-native root nil)]
        (is (= 0 (:built r)))
        (is (= 1 (count (:errors r))))
        (let [e (first (:errors r))]
          (is (includes? e "tiny"))
          (is (includes? e "Nix preparation failed"))
          (is (not (File/exists? (n/project-installed-path root "tiny")))))))
    (is true "Nix prerequisite unavailable")))

; ── the fresh-skip is a filesystem decision, not a cargo run ─────────────

(deftest a-fabricated-legacy-cache-does-not-establish-provenance
  ; A mutable legacy target and an ambient Cargo shim cannot supply provenance.
  ; The current recipe must select verified immutable bytes instead.
  (setup!)
  (let [orig (System/get_env "PATH")
        bin (str root "/shim")
        shim (str bin "/cargo")]
    (try
      (File/mkdir_p! bin)
      (File/write! shim (str "#!/bin/sh\n"
                             "case \"$1\" in\n"
                             "  --version) echo 'cargo 0.0.0 (shim)' ;;\n"
                             "  *) exit 1 ;;\n"
                             "esac\n"))
      (File/chmod! shim 493)
      (System/put_env "PATH" (str bin ":" orig))
      (let [dir (Path/join root "priv/native")]
        (File/mkdir_p! dir)
        (File/write! (Path/join dir "tiny.so") "fabricated")
        (let [r (b/build-native root nil)]
          (is (= 0 (:cached r)) "a mutable legacy cache supplies no product provenance")
          (is (= 1 (:built r)) "the verified Nix product is selected instead")
          (is (empty? (:errors r)) "ambient Cargo is unnecessary")
          (is (not= "fabricated" (File/read! (n/project-installed-path root "tiny"))))))
      (finally (System/put_env "PATH" orig)))))


; ── cargo's artefact names, on every platform erl_ddll runs ──────────────
;
; Ported from the ExUnit `test/beam_lisp/native_compiler_test.exs`. The macOS
; leg of the release matrix can only be BUILT on macOS, so the naming arm —
; cargo's `.dylib` output vs the `.so` the BEAM loads — is asserted here, where
; a Linux host still reaches it. Two arms are RETIRED, not ported:
;
;   * `Cargo.built_bin` (a tool cargo built with no extension, and `.exe` on
;     windows): the build installs CDYLIBS only, and the one binary it used to
;     name (`drop`) is now a codec module (`priv/build/drop.bl`), not a cargo
;     crate — there is no bin build path left to cover.
;   * "a changed lockfile requires rebuilding": superseded by design. A lock
;     naming only its own crate is a function of the manifest and carries
;     nothing, so it is no longer a key input — pinned inversely in
;     `a-generated-lock-does-not-move-the-key`.

; `cargo-verdict` is where the search and the report are one spelling
; (`cdylib-in` reads `cdylib-names`), so driving it directly covers BOTH the
; discovery and the verdict on what was found. Pure in the exit, cargo's words
; and the filesystem — no cargo run.
(deftest finds-cargos-platform-cdylib-names
  (let [dir (str (System/tmp_dir!) "/bl_cdylib_" (erlang/unique_integer (list :positive)))
        inv "cargo build --release  (in native/probe)"]
    (File/mkdir_p! dir)
    (is (:error (b/cargo-verdict "probe" dir 0 "" inv))
        "no artefact on disk is the zero-exit-no-artefact failure")
    (File/write! (Path/join dir "libprobe.dylib") "fixture; never loaded")
    (is (= (Path/join dir "libprobe.dylib") (:ok (b/cargo-verdict "probe" dir 0 "" inv)))
        "cargo's darwin cdylib name is found")
    (File/write! (Path/join dir "libprobe.so") "fixture")
    (is (= (Path/join dir "libprobe.so") (:ok (b/cargo-verdict "probe" dir 0 "" inv)))
        "linux's name wins when both are present (they never are in practice)")
    (File/rm_rf! dir)
    (File/mkdir_p! dir)
    (File/write! (Path/join dir "probe.dll") "fixture")
    (is (= (Path/join dir "probe.dll") (:ok (b/cargo-verdict "probe" dir 0 "" inv)))
        "and cargo's windows cdylib, whose name carries no `lib` prefix")
    (File/rm_rf! dir)))

(deftest installs-under-the-extension-the-beam-asks-for
  ; Every unix — darwin included — takes the `.so` arm: erl_ddll appends `.so`
  ; for a module on unix, and the loader asks `priv/native/<crate>.so`. cargo's
  ; own `lib` prefix is DROPPED: the installed path is `<crate>.so`, never
  ; `lib<crate>.so`. The old `BeamLisp.NativeTask.nif_ext` is `vm.native`'s
  ; private `nif-ext`, so the observable is the installed path both agree on.
  (is (= "lazy_memo.so" (Path/basename (n/installed-path "lazy_memo"))))
  (is (= (b/nif-artifact-name "lazy_memo") (n/artifact-name "lazy_memo"))
      "the build and the loader spell the name the same — one spelling, checked"))

; ── the runtime's own build: no cargo when the artefact is current ────────
;
; `vm.native/build!` folds the old `BeamLisp.NativeTask.run`: a crate whose
; installed `.so` is newer than its sources is CURRENT, and the check is a
; filesystem stat, never a cargo run. The cheapest honest proof is a cargo that
; CANNOT build — a shim answering `--version` (the key's toolchain qualifier)
; and exiting 1 otherwise, the same device as
; `the-fresh-path-reports-current-without-cargo`, one layer down.

(defn- with-cargo-shim [root f]
  (let [orig (System/get_env "PATH")
        bin (str root "/shim")]
    (try
      (File/mkdir_p! bin)
      (File/write! (str bin "/cargo")
                   (str "#!/bin/sh\n"
                        "case \"$1\" in\n"
                        "  --version) echo 'cargo 0.0.0 (shim)' ;;\n"
                        "  *) exit 1 ;;\n"
                        "esac\n"))
      (File/chmod! (str bin "/cargo") 493)
      (System/put_env "PATH" bin)
      (f)
      (finally (System/put_env "PATH" orig)))))

(defn- scratch-root [label]
  (str (System/tmp_dir!) "/bl_native_" label "_" (erlang/unique_integer (list :positive))))

(deftest an-installed-runtime-is-current-without-cargo
  (let [root (scratch-root "fresh")]
    (File/mkdir_p! (Path/join root "native/lazy_memo"))
    (File/mkdir_p! (Path/join root "priv/native"))
    (File/write! (Path/join root "native/lazy_memo/Cargo.toml")
                 "[package]\nname = \"lazy_memo\"\n")
    (File/write! (Path/join root "priv/native/lazy_memo.so")
                 "fixture artifact; this test does not load it")
    ; the artefact is NEWER than every source, so it is current
    (File/touch! (Path/join root "native/lazy_memo/Cargo.toml")
                 (tuple (tuple 2000 1 1) (tuple 0 0 0)))
    (with-cargo-shim root
      (fn []
        (File/cd! root
          (fn []
            (is (thrown-with-msg? "Native preparation failed for lazy_memo" (n/build! "lazy_memo"))
                "newer installed bytes cannot substitute for a locked immutable product")))))
    (File/rm_rf! root)))

(deftest a-crate-that-must-build-but-cannot-fails-loudly
  ; Ported from "missing required runtime fails before AOT when cargo is
  ; absent". The boot path (`build-all!`) is deliberately BOOT-SAFE and reports
  ; rather than raising — a broken toolchain must not kill `bl eval` — but the
  ; explicit per-crate build still fails LOUD, naming the crate.
  (let [root (scratch-root "broken")]
    (File/mkdir_p! (Path/join root "native/lazy_memo"))
    (File/write! (Path/join root "native/lazy_memo/Cargo.toml")
                 "[package]\nname = \"lazy_memo\"\n")
    (with-cargo-shim root
      (fn []
        (File/cd! root
          (fn []
            (is (thrown-with-msg? "Native preparation failed for lazy_memo"
                  (n/build! "lazy_memo"))
                "a crate with no artefact and a cargo that cannot build it is a LOUD failure")))))
    (File/rm_rf! root)))


(deftest a-changed-lockfile-makes-the-runtime-stale
  ; Ported from "a changed lockfile requires rebuilding the runtime". At the
  ; RUNTIME layer a crate's freshness reads its sources AND its lock: a lock
  ; newer than the installed .so decides the artefact is not current, so the
  ; build is attempted (it fails loudly here, since the shim cannot build).
  ; The TOOLCHAIN layer's key deliberately ignores a self-only lock — see
  ; `a-generated-lock-does-not-move-the-key`. Different questions: what to
  ; rebuild now vs what names the cached artefact.
  (let [root (scratch-root "lock")]
    (File/mkdir_p! (Path/join root "native/lazy_memo"))
    (File/mkdir_p! (Path/join root "priv/native"))
    (File/write! (Path/join root "native/lazy_memo/Cargo.toml")
                 "[package]\nname = \"lazy_memo\"\n")
    (File/write! (Path/join root "native/lazy_memo/Cargo.lock") "changed dependency lock")
    (File/write! (Path/join root "priv/native/lazy_memo.so")
                 "fixture artifact; this test does not load it")
    (File/touch! (Path/join root "native/lazy_memo/Cargo.toml")
                 (tuple (tuple 2000 1 1) (tuple 0 0 0)))
    (File/touch! (Path/join root "native/lazy_memo/Cargo.lock")
                 (tuple (tuple 2001 1 1) (tuple 0 0 0)))
    (File/touch! (Path/join root "priv/native/lazy_memo.so")
                 (tuple (tuple 1999 1 1) (tuple 0 0 0)))
    (with-cargo-shim root
      (fn []
        (File/cd! root
          (fn []
            (is (thrown-with-msg? "Native preparation failed for lazy_memo"
                  (n/build! "lazy_memo"))
                "a lock newer than the artefact makes the crate stale — the build is attempted")))))
    (File/rm_rf! root)))

