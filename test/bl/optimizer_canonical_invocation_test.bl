(ns optimizer.canonical-invocation-test
 (:require [optimize :as o] [anf :as a] [compiler :as c]))

(deftest native-call-specialization-respects-the-canonical-boundary
 (let [function (a/fnn (list (a/clause (list (a/pvar "x")) nil (a/var "x"))))
       packed (a/cons-cell (a/lit 42) a/enil)
       callable (a/lett "f" function (a/invoke (a/var "f") packed))
       native (a/lett "f" function
                (a/remote :Elixir.BeamLisp.Ns.Rt :invoke (list (a/var "f") packed)))
       computed (a/lett "f" function (a/invoke (a/var "f") (a/var "arguments")))]
  (is (= :apply (get-in (o/node callable) [:body :op])))
  (is (= native (o/node native)))
  (is (= computed (o/node computed)))))

(deftest ordinary-canonical-filter-invocation-reaches-the-checked-consumer-rule
 (let [node (c/compile
              (BeamLisp.Reader/read_one "(first (filter (fn [x] (> x 3)) (lists/seq 0 9)))")
              (c/new-env "user"))
       descriptor (a/module :Elixir.OptimizerCanonicalInvocation
                    (list {:op :defn-clause :fname :run :params (list) :guard nil :body node :ann {}})
                    (list [:run 0]) (list))]
  (is (some #(= :strict-first-filter (:rule %)) (:evidence (o/explain descriptor))))))
