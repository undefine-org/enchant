(ns contextual-world-staging-test)

(deftest sdk-staging-reuses-the-authenticated-lazy-compiler-floor
 ;; Run before contextual_world_cli_test.bl. The real SDK producer must not
 ;; re-emit a boot unit or initialize it just to compile this new CLI adapter.
 (let [names ["syntax" "binding" "expand-source" "expand"]
       loaded (Enum/map names #(BeamLisp.Env/loaded_ns? %))
       identities (Enum/map names
                    (fn [name]
                     (let [module (BeamLisp.Emit/module_for name)]
                      (Code/ensure_loaded? module)
                      (erlang/apply module :module_info (list :md5)))))
       receipts (Enum/map names #(BeamLisp.AOT/source_sdk_receipt (BeamLisp.Emit/module_for %)))
       source (BeamLisp.Loader/source_path "bl.world")
       module (BeamLisp.Emit/module_for "bl.world")
       receipt (BeamLisp.Loader/without_initialization
                 (fn [] (BeamLisp.AOT/stage_sdk_dependency! "bl.world" source module)))]
  (is (some #(= false %) loaded) "the gate actually starts with a lazy boot dependency")
  (is (= loaded (Enum/map names #(BeamLisp.Env/loaded_ns? %))))
  (is (= identities (Enum/map names
                     #(erlang/apply (BeamLisp.Emit/module_for %) :module_info (list :md5)))))
  (is (= receipts (Enum/map names #(BeamLisp.AOT/source_sdk_receipt (BeamLisp.Emit/module_for %)))))
  (is (= true (BeamLisp.AOT/sdk_unit_compiled? "bl.world")))
  (is (= false (BeamLisp.Env/loaded_ns? "bl.world")))
  (is (= (:md5 receipt) (erlang/apply module :module_info (list :md5))))))
