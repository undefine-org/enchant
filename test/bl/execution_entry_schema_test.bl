(ns execution.entry-schema-test (:require [anf :as anf]))

(defn fields []
 {:id [:module :function 0] :definition "example/function"
  :body-identity [:module :compiler-input :source-digest]
  :kind :source :arity {:kind :fixed :count 0}})

(deftest entry-construction-is-finite-and-missing-dependency-evidence-stays-incomplete
 (let [entry (anf/execution-entry (assoc (fields) :edges
               [{:kind :captured-value :evidence [:capture :unknown]}]))]
  (is (erlang/is_list (:edges entry)))
  (is (= false (:dependencies-complete entry)))
  (is (= nil (:target (first (:edges entry)))))
  (is (= entry (anf/validate-execution-entry! entry)))))

(deftest a-declaration-cannot-extend-the-schema-with-trust-flags
 (is (thrown? (anf/execution-entry (assoc (fields) :trusted true))))
 (is (thrown? (anf/execution-entry (assoc (fields) :version 2))))
 (is (thrown? (anf/execution-entry (assoc (fields) :kind :invented)))))

(deftest executable-or-resource-payloads-are-not-entry-identities
 (is (thrown? (anf/execution-entry (assoc (fields) :id (fn [] :effect)))))
 (is (thrown? (anf/execution-entry (assoc (fields) :body-identity (erlang/self)))))
 (is (thrown? (anf/execution-entry (assoc (fields) :edges
                 [{:kind :captured-value :evidence (erlang/make_ref)}])))))

(deftest arity-and-edge-collection-shapes-are-enforced-at-construction
 (is (thrown? (anf/execution-entry (assoc (fields) :arity {:kind :fixed :count -1}))))
 (is (thrown? (anf/execution-entry (assoc (fields) :arity {:kind :fixed :count 256}))))
 (is (thrown? (anf/execution-entry (assoc (fields) :edges {:not :a-sequence})))))
