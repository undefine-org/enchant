(ns source-deftype-field-test
 (:require [reload.generation :as generation] [proc.callback :as callback]))
(defn- kind [action]
 (try (action) :unexpected-success (catch error (:kind (ex-data error)))))

(deftest compiler-field-access-retains-the-original-schema-and-value
 (let [g (generation/prepare!
          {:application-id "compiler-deftype-fields"
           :sources {"field.unit" "(ns field.unit) (deftype Value [payload])
                                  (defn make [n] (->Value n))
                                  (defn read [value] (.-payload value))
                                  (defn method [value] (.payload value))
                                  (defn retain [value] (fn [] (.-payload value)))"}})
       value (generation/invoke! g "field.unit/make" [42]) held (atom nil)]
  (try
   (is (= 42 (generation/invoke! g "field.unit/read" [value])))
   (is (= 42 (generation/invoke! g "field.unit/method" [value])))
   (reset! held (generation/with! g #(callback/register! (generation/invoke! g "field.unit/retain" [value]))))
   (is (= :waiting (:status (generation/retire! g))))
   (is (= 42 (callback/invoke! @held [])))
   (callback/unregister! @held)
   (is (= :cancelled (callback/invoke! @held [])))
   (is (= :retired (:status (generation/retire! g))))
   (finally (when @held (callback/unregister! @held)) (generation/retire! g)))))

(deftest explicit-native-accessor-spellings-do-not-acquire-a-native-grant
 (doseq [module ["BeamLisp.Record" "Elixir.BeamLisp.Record"]]
  (is (= :dynamic-code-dependency
         (kind #(generation/prepare!
                 {:application-id "raw-deftype-fields"
                  :sources {"field.raw" (str "(ns field.raw) (defn read [value] (" module "/deftype_field value :payload))")}}))))))
