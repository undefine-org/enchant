(ns compiler-lexical-consumers-test
 (:require [connector.google.gdrive :as drive] [connector.microsoft.graph :as graph] [bl.cli :as cli] [bl.profile :as profile]))

(deftest drive-changes-separates-the-request-callback-from-map-lookup
 (let [requests (atom [])
       request (fn [url]
                 (swap! requests conj url)
                 {:ok {"changes" [{"removed" true "fileId" "gone"}]
                       "nextPageToken" "page" "newStartPageToken" "cursor"}})
       result ((:changes (drive/feed "account")) request "previous")]
  (is (= [{:key [:gdrive "account" "gone"] :removed true}] (get-in result [:ok :items])))
  (is (= ["page" "cursor"] [(get-in result [:ok :next]) (get-in result [:ok :cursor])]))
  (is (= 1 (count @requests)))))

(deftest drive-directory-can-map-fields-inside-the-request-callback-scope
 (let [directory (drive/directory-fn "account" "example.com")
       result (directory (fn [_]
                           {:ok {"users" [{"id" "person" "primaryEmail" "A@EXAMPLE.COM"
                                           "name" {"fullName" "A Person"}}]}}) {})
       person (first (get-in result [:ok :people]))]
  (is (= {:id "person" :email "a@example.com" :name "A Person"}
         (select-keys person [:id :email :name])))
  (is (nil? (get-in result [:ok :next])))))

(deftest graph-members-can-map-fields-inside-the-request-callback-scope
 (let [members (graph/members-fn "https://graph.invalid" "tenant")
       result (members (fn [_]
                         {:ok {"value" [{"@odata.type" "#microsoft.graph.user" "id" "person"
                                         "mail" "a@example.com" "displayName" "A Person"}]}})
                       [:graph "tenant" :group "group"])
       person (first (get-in result [:ok :members]))]
  (is (= {:email "a@example.com" :name "A Person"} (select-keys person [:email :name])))
  (is (= true (get-in result [:ok :complete?])))))

(deftest doc-build-walks-multiple-targets-without-shadowing-rest
 (let [root (Path/join (System/tmp_dir!) (str "bl-lexical-doc-" (erlang/unique_integer (list :positive))))
       out (Path/join root "out") one (Path/join root "one.bl.md") two (Path/join root "two.bl.md")]
  (File/mkdir_p! root)
  (try
   (File/write! one "# One\n") (File/write! two "# Two\n")
   (is (= 0 (cli/cmd-doc (list "build" one two) {:out out})))
   (is (File/exists? (Path/join out "one.html")))
   (is (File/exists? (Path/join out "two.html")))
   (finally (File/rm_rf! root)))))


(deftest profile-module-segments-do-not-shadow-the-list-operation
 (doseq [module [:Elixir.BeamLisp.Ns.Body.Example.Module
                 :Elixir.BeamLisp.Ns.Init.Example.Module
                 :Elixir.BeamLisp.Ns.Fn.Example.Module]]
  (is (= {:ns "example.module" :runtime? false} (profile/demangle-module module)))))
