(ns vector-get-default-test)

(defmacro missing-vector-slot [] (get [nil false] 9 :missing))
(defmacro present-vector-nil [] (get [nil false] 0 :missing))
(defmacro present-vector-false [] (get [nil false] 1 :missing))

(deftest compile-time-values-use-the-same-vector-lookup-contract
 (is (= :missing (missing-vector-slot)))
 (is (= nil (present-vector-nil)))
 (is (= false (present-vector-false))))

(deftest vector-get-distinguishes-missing-indices-from-present-nil-and-false
 (doseq [values [[] [nil false 42] (vec (concat [nil false] (range 70)))
                 (vec (concat [nil false] (range 1100)))]]
  (doseq [key [-1 (count values) (+ 10 (count values)) :absent "0" nil]]
   (is (= :missing (get values key :missing)) (pr-str [(count values) key]))
   (is (= nil (get values key))))
  (when (pos? (count values))
   (is (= nil (get values 0 :missing)))
   (is (= false (get values 1 :missing)))
   (is (= (nth values (dec (count values))) (get values (dec (count values)) :missing))))))

(deftest nested-vector-lookup-propagates-absence-through-the-shared-get-contract
 (let [data {:rows [{:value nil} {:value false}]}]
  (is (= nil (get-in data [:rows 0 :value] :missing)))
  (is (= false (get-in data [:rows 1 :value] :missing)))
  (is (= :missing (get-in data [:rows 2 :value] :missing)))
  (is (= :missing (get-in data [:rows -1 :value] :missing)))
  (is (= :missing (get-in data [:rows :invalid] :missing)))))
