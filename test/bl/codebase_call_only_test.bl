(ns codebase.call-only-test (:require [codebase :as cb]))

(def source
 "(ns calls.demo (:require [lib.data :as data]))
  (defn literal [] 42)
  (defn use-it [value] (data/format-row value) (literal))
  (defn dynamic [literal] (literal))")

(deftest call-only-retains-qualified-definitions-and-dynamic-edges
 (let [full (cb/index-source {} "calls.demo" source)
       calls (cb/index-source {} "calls.demo" source {:mode :calls})
       names (fn [facts] (set (map :fn/qualified (:fn facts))))
       edges (fn [facts] (mapv #(select-keys % [:call/caller-qualified
                                              :call/callee-qualified
                                              :call/callee :call/arity :call/line]) (:calls facts)))]
  (is (= (names full) (names calls)))
  (is (= (edges full) (edges calls)))
  (is (= (:requires full) (:requires calls)))
  (is (every? vector? (map #(get calls %) [:fn :calls :instr :requires])))
  (is (every? vector? (map #(get full %) [:fn :calls :instr :requires])))
  (is (= :not-requested (get-in calls [:coverage :returns])))
  (is (some #(= "lib.data/format-row" (:call/callee-qualified %)) (:calls calls)))
  (is (some #(and (= "dynamic" (:call/caller %)) (= "literal" (:call/callee %))
                  (nil? (:call/callee-qualified %))) (:calls calls)))))

(deftest call-only-does-not-run-return-inference
 (let [_ (BeamLisp.Loader/ensure_loaded "typed")
       entry (first (BeamLisp.Env/ns_definition "typed" "walk"))
       pattern (tuple (elem entry 4) (elem entry 2) (elem entry 1))]
  (is (not (nil? entry)))
  (erlang/trace_pattern pattern true (list :local :call_count))
  (try
   (let [calls (cb/index-source {} "calls.demo" source {:mode :calls})
         skipped (elem (erlang/trace_info pattern :call_count) 1)
         full (cb/index-source {} "calls.demo" source)
         inferred (elem (erlang/trace_info pattern :call_count) 1)]
    (is (= 0 skipped))
    (is (> inferred 0))
    (is (empty? (filter :fn/ret-source (:fn calls))))
    (is (some #(= "inferred" (:fn/ret-source %)) (:fn full))))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))

(defn refused? [f] (try (f) false (catch _ true)))
(deftest unknown-indexing-modes-and-unreadable-sources-refuse
 (is (refused? #(cb/index-source {} "calls.demo" source {:mode :typo})))
 (is (refused? #(cb/index-source {} "calls.demo" "(defn broken [" {:mode :calls}))))
