(ns sdk-pipeline-identity-test)

(defn original [action]
 (try (action) :accepted (catch error (BeamLisp.ExInfo/ex_original error))))

(deftest pipeline-identity-rejects-invalid-roots-before-discovery
 (is (= :invalid_sdk_pipeline_namespace (original #(BeamLisp.AOT/sdk_pipeline_identity! nil))))
 (is (= :invalid_sdk_pipeline_namespace (original #(BeamLisp.AOT/sdk_pipeline_identity! ""))))
 (is (= :invalid_sdk_pipeline_namespace
         (original #(BeamLisp.AOT/sdk_pipeline_identity! (String/duplicate "x" 513))))))

(deftest source-checkouts-do-not-invent-sealed-image-identity
 (if (File/exists? (Path/join (BeamLisp.Tiers/priv_root) "sdk-code.term"))
  (is (not= :accepted (original #(BeamLisp.AOT/sdk_pipeline_identity! "missing.pipeline.fixture"))))
  (is (= :sdk_pipeline_image_missing (original #(BeamLisp.AOT/sdk_pipeline_identity! "compile.world"))))))
