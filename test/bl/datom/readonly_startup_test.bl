(ns datom.readonly-startup-test
 (:require [datom :as d] [datom.conn :as conn] [datom.store :as s]
           [datom.store-ets :as ets] [datom.store-fjall :as fj]
           [datom.blob :as blob] [datom.blob-ets :as memory] [datom.profile :as profile]
           [datom.offline.fs :as fs] [datom.offline.engine :as engine]))
(defn kind [f] (try (f) nil (catch error (:kind (ex-data error)))))
(defrecord Gate [inner admitted attempts])
(defn effect! [gate]
 (swap! (:attempts gate) inc)
 (when-not @(:admitted gate) (throw (ex-info "probe write refused" {:kind :probe-write-refused}))))
(extend-type Gate
 s/WriteAdmission
 (-write-admitted? [gate] @(:admitted gate))
 s/Store
 (-get [gate key] (s/-get (:inner gate) key))
 (-range [gate lo hi] (s/-range (:inner gate) lo hi))
 (-put [gate key value] (effect! gate) (s/-put (:inner gate) key value) gate)
 (-delete [gate key] (effect! gate) (s/-delete (:inner gate) key) gate)
 (-update [gate key f] (effect! gate) [gate (second (s/-update (:inner gate) key f))])
 (-commit [gate ops] (effect! gate) (s/-commit (:inner gate) ops) gate)
 s/Closeable
 (-close [gate] (s/close (:inner gate))))
(def definitions [{:db/ident :probe/value :db/valueType :db.type/string
                   :db/cardinality :db.cardinality/one :db/index true}])
(defn refused-writers! [connection]
 (let [effects (atom 0) before (vec (s/-range (:store connection) nil nil))]
  (doseq [action [#(d/transact! connection [[:db/add -1 :db/doc "denied"]])
                  #(d/load-facts! connection [[:db/add 41 :db/doc "denied"]])
                  #(d/excise! connection [[:entity 41]])
                  #(d/install-schema! connection definitions)
                  #(d/sync-schema! connection definitions)
                  #(d/with connection [[:db/add -1 :db/doc "denied"]])
                  #(conn/serialized! connection (fn [] (swap! effects inc)))
                  #(d/put-file! connection "denied")
                  #(d/put-file-path! connection "/absent/read-only-input")
                  #(d/gc-files! connection)]]
   (is (= :store-write-admission-required (kind action))))
  (is (= 0 @effects))
  (is (= before (vec (s/-range (:store connection) nil nil))))
  (is (= [] (blob/-blob-shas (:blobs connection))))))

(deftest readonly-startup-defers-every-initializer-and-reopens-the-same-lifetime-after-grant
 (let [admitted (atom false) attempts (atom 0) gate (->Gate (ets/open) admitted attempts)
       observed (profile/watch gate) connection (d/connect-with observed definitions {:blobs (memory/open)})]
  (try
   (is (not (s/write-admitted? observed)))
   (is (= 0 @attempts))
   (is (= [] (vec (s/-range gate nil nil))))
   (is (nil? (get (:schema (d/db connection)) :probe/value)))
   (refused-writers! connection)
   (is (= 0 @attempts))
   (reset! admitted true)
   (let [reopened (d/connect-with observed definitions)]
    (is (= (:lifetime connection) (:lifetime reopened)))
    (is (= (:schema connection) (:schema reopened)))
    (is (s/write-admitted? observed))
    (is (pos? @attempts))
    (d/transact! connection [{:db/id -1 :probe/value "accepted"}])
    (is (= #{["accepted"]} (d/q '[:find ?v :where [_ :probe/value ?v]] (d/db reopened)))))
   (finally (d/close! connection) (profile/release-store! observed)))))

(deftest an-actual-native-extraction-recovers-readable-data-without-coverage-or-schema-writes
 (let [base (fj/open-fresh) seeded (d/connect-with base definitions)
       parent (s/fresh-path ".readonly-connection") job (fs/claim! parent {:create true})
       extraction (fs/child! job "extract" {:create true}) marker "readonly-connection-fixture"]
  (try
   (d/transact! seeded [{:db/id 41 :probe/value "retained"}])
   (conn/release! seeded)
   (s/checkpoint! base (str (:path extraction) "/store.fjall"))
   (fs/put! job ".bl-offline-job" nil marker)
   (let [scope (engine/scope! job marker) store (engine/open! scope "extract/store.fjall")
         before (vec (s/-range store nil nil))
         connection (d/connect-with store
                      (conj definitions {:db/ident :probe/deferred :db/valueType :db.type/string
                                         :db/cardinality :db.cardinality/one}) {:blobs (memory/open)})]
    (try
     (is (not (s/write-admitted? store)))
     (is (= before (vec (s/-range store nil nil))))
     (is (nil? (get (:schema (d/db connection)) :probe/deferred)))
     (is (= #{["retained"]} (d/q '[:find ?v :where [_ :probe/value ?v]] (d/db connection))))
     (refused-writers! connection)
     (is (= before (vec (s/-range store nil nil))))
     (finally (d/close! connection))))
   (finally (s/close base) (fs/close! job)))))
