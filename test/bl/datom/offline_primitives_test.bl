(ns datom.offline-primitives-test
 (:require [datom.codec :as codec] [datom.value-codec :as slot]
           [datom.store :as s] [datom.store-fjall :as fj]))

(defn fails? [f] (try (f) false (catch _ true)))

(deftest raw-pages-preserve-mixed-slot-bytes-and-resume-at-exact-keys
 (let [st (fj/open-fresh)
       legacy (erlang/term_to_binary [42 :x/value (list 1 [2]) 1000000 false])
       packed (slot/encode-slot [43 :x/value [1 (list 2)] 1000001 true])]
  (try
   (fj/commit-raw! st [[:put "a" legacy] [:put "b" packed] [:put "c" "opaque-slot"]])
   (let [first (fj/raw-page st nil nil nil 1 4096)
         second (fj/raw-page st nil (:last first) nil 2 4096)
         end (fj/raw-page st nil (:last second) nil 2 4096)]
    (is (= [["a" legacy]] (:entries first)))
    (is (= "a" (:last first)))
    (is (not (:done? first)))
    (is (= [["b" packed] ["c" "opaque-slot"]] (:entries second)))
    (is (= [] (:entries end)))
    (is (:done? end))
    (is (= legacy (fj/raw-get st "a")))
    (is (= packed (fj/raw-get st "b")))
    (is (nil? (fj/raw-get st "absent")))
    (is (= [42 :x/value (list 1 [2]) 1000000 false] (s/-get st "a")))
    (is (= [43 :x/value [1 (list 2)] 1000001 true] (s/-get st "b"))))
   (doseq [[rows bytes] [[0 4096] [4097 4096] [1 0] [1 16777217] [1 1]]]
    (is (fails? #(fj/raw-page st nil nil nil rows bytes))))
   (is (fails? #(fj/raw-page st "a" "a" nil 1 4096)))
   (let [before (fj/raw-get st "a")]
    (is (fails? #(fj/commit-raw! st [[:put "a" "changed"] [:unknown "b"]])))
    (is (fails? #(fj/commit-raw! st [[:put "a" "changed"] [:put "b" nil]])))
    (is (= before (fj/raw-get st "a"))))
   (finally (s/close st)))))

(deftest byte-bound-pages-do-not-skip-an-unconsumed-row
 (let [st (fj/open-fresh)]
  (try
   (fj/commit-raw! st [[:put "a" "12"] [:put "b" "34"]])
   (let [p (fj/raw-page st nil nil nil 10 3)
         q (fj/raw-page st nil (:last p) nil 10 3)]
    (is (= [["a" "12"]] (:entries p)))
    (is (not (:done? p)))
    (is (= [["b" "34"]] (:entries q)))
    (is (:done? q)))
   (finally (s/close st)))))

(deftest explicit-offline-encoder-does-not-enable-the-format-cutover
 (is (= 1 codec/INDEX-VERSION))
 (is (not= (codec/encode-for-format 1 (list 1)) (codec/encode-for-format 1 [1])))
 (doseq [[a b] [[(list 1 [2]) [1 (list 2)]]
                [(with-meta [1] {:note true}) (list 1)]
                [{:x (list 1)} {:x [1]}]
                [(tuple (list 1)) (tuple [1])]
                [10000000000000000 1.0e16]
                [-10000000000000000 -1.0e16]]]
  (is (= (codec/encode-for-format 2 a) (codec/encode-for-format 2 b))))
 (doseq [[a b] [[9007199254740995 9007199254740996]
                [-9007199254740996 -9007199254740995]
                [9007199254740992.0 9007199254740993]]]
  (is (< (codec/encode-for-format 2 a) (codec/encode-for-format 2 b))))
 (doseq [v [(list 1 [2]) [1 (list 2)] 10000000000000000 9007199254740995]]
  (is (= (codec/encode-identity-v1 v) (codec/encode-for-format 1 v)))
  (is (= (codec/encode-value v) (codec/encode-for-format 1 v)))))
