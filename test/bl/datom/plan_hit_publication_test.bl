;; Literal-query hits are reads of a bounded plan map. Publishing its complete
;; retained value for a counter caused live readers to pay its full CAS cost.
(ns datom.plan-hit-publication-test
 (:require [datom] [datom.time :as time] [datom.query.engine :as engine]))
(deftest repeated-point-query-hits-do-not-republish-the-plan-map
 (let [conn (datom/connect [{:db/ident :probe/n :db/valueType :db.type/long}])
       reports (atom 0) query '[:find ?n :in $ ?e :where [?e :probe/n ?n]]
       report (datom/transact! conn [{:db/id -1 :probe/n 1}])
       e (get (:tempids report) -1) db (datom/db conn)
       _ (engine/q query db e)
       cache (BeamLisp.Env/fetch! "datom.query.engine" "PLAN-CACHE")
       before (engine/plan-cache-stats)]
  (add-watch cache :hit-publication (fn [_ _ _ _] (swap! reports inc)))
  (try
   (is (= #{[1]} (engine/q query db e)))
   (is (= #{[1]} (engine/q query db e)))
   (is (= 2 (- (:hits (engine/plan-cache-stats)) (:hits before))))
   (is (= (:misses before) (:misses (engine/plan-cache-stats))))
   (is (= 0 @reports))
   (finally (remove-watch cache :hit-publication) (datom/close! conn)))))


(deftest a-learned-history-plan-hint-is-not-republished-on-every-read
 (let [conn (datom/connect [{:db/ident :probe/n :db/valueType :db.type/long}
                           {:db/ident :probe/tag :db/valueType :db.type/keyword}])
       _ (datom/transact! conn (mapv (fn [n] {:db/id (- -1 n) :probe/n n :probe/tag :row}) (range 64)))
       db (time/history (datom/db conn))
       query '[:find ?e ?n :where [?e :probe/tag :row] [?e :probe/n ?n]]
       expected (engine/q query db)
       reports (atom 0) cache (BeamLisp.Env/fetch! "datom.query.engine" "PLAN-CACHE")
       before (engine/plan-cache-stats)]
  (add-watch cache :history-hit-publication (fn [_ _ _ _] (swap! reports inc)))
  (try
   (is (= 64 (count expected)))
   (is (= expected (engine/q query db)))
   (is (= expected (engine/q query db)))
   (is (= 2 (- (:hits (engine/plan-cache-stats)) (:hits before))))
   (is (= 0 @reports))
   (finally (remove-watch cache :history-hit-publication) (datom/close! conn)))))
