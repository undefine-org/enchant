;; Finite composite keys retain the old bytes without optional lazy admission.
(ns datom.codec-finite-test (:require [datom.codec :as codec] [interop]))

(def cases
  {"plain" {:empty {} :nil nil :false false :number 37 :text "a\u0000é"}
   "nested" {:source {:kind :entered :value [1 2 3]} :inputs [{:v 10 :u :mm} {:v false :u :flag}]}
   "sorted" (sorted-map :z [3 2] :a (sorted-set 9 2 1))
   "shared" (let [leaf {:v 42 :unit :piece :source {:kind :entered :label "fixture"}}]
              {:left leaf :right leaf :list (list leaf false nil) :tuple (tuple leaf "x")})
   "sequence" [nil false true -1 0 1 1.5 "" "é" :a]
   "sets" #{:z :a :b}})

(defn hex [value] (String/downcase (binary/encode_hex (codec/encode-value value))))
(defn without-cache [compute]
  (let [previous (Application/get_env :beam_lisp :lazy_cache_budget_bytes)]
    (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
    (try {:value (compute)} (catch cause {:error (ex-message cause)})
      (finally
        (if (nil? previous) (Application/delete_env :beam_lisp :lazy_cache_budget_bytes)
          (Application/put_env :beam_lisp :lazy_cache_budget_bytes previous))))))

(deftest finite-composite-keys-preserve-the-independent-byte-oracle
  (let [normal (reduce (fn [out [label value]] (assoc out label (hex value))) {} cases)
        fixture (or (System/get_env "BL_CODEC_GOLDEN_PATH") "test/fixtures/datom/finite-codec-golden.json")
        output (System/get_env "BL_CODEC_GOLDEN_OUT")]
    ;; Only the explicit pre-fix invocation may create the independent oracle.
    (when output
      (when (File/exists? output) (throw (ex-info "Refusing to replace the codec byte oracle" {})))
      (File/write! output (interop/->json normal)))
    (is (= normal (interop/json-> (File/read! fixture))))
    (doseq [[label value] cases]
      (let [actual (without-cache #(hex value))]
        (when (:error actual) (println :finite-codec-failure label actual))
        (is (nil? (:error actual)) (str label " needs no optional memo"))
        (is (= (get normal label) (:value actual)) (str label " keeps its exact key bytes"))))))
