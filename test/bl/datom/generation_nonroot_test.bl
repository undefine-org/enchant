(ns datom.generation-nonroot-test
 (:require [datom.generation :as generation] [datom.codec :as codec] [datom.offline.root :as root]
           [datom.offline.fs :as fs] [datom.offline.journal :as journal]
           [datom.offline.layout :as l] [datom.store :as s]))
(def spec {:version 1 :application "fixture.app" :key-format 2 :data-version 1
           :stores [{:id "control" :path "control.fjall" :blobs {:kind :fs :path "control.fjall.blobs"}}
                    {:id "library/one" :path "libraries/a.fjall" :blobs {:kind :fs :path "libraries/a.fjall.blobs"}}]
           :files ["config.json"] :directories ["empty"]})
(defn kind [f] (try (f) nil (catch error (:kind (ex-data error)))))
(defn native-refused? [value]
 (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value)) (= :error (elem value 0))))
(defn close [directory] (try (fs/close! directory) (catch _ nil)))
(defn fixture-at [parent populate]
 (let [original (str parent "/original")
       evidence (Jason/decode! (File/read! "test/fixtures/datom/legacy-root-v1.json"))]
  (File/mkdir_p! original)
  (doseq [part (get evidence "archives")]
   (let [result (System/cmd "tar" (list "-xzf" (Path/expand (str "test/fixtures/datom/" (get part "file"))) "-C" original))]
    (when-not (= 0 (elem result 1)) (throw (ex-info "fixture extraction failed" {})))))
  (populate original)
  (root/prepare! original (str parent "/job") (str parent "/generation")
   (get-in evidence ["producer_receipt" "sdk_descriptor_sha256"]) (l/digest :fixture-release) (assoc spec :key-format 1))
  {:app (fs/claim! (str parent "/writer") {:create true})
   :root (fs/claim! (str parent "/generation"))}))
(defn fixture
 ([] (fixture (fn [_] nil)))
 ([populate] (fixture-at (s/fresh-path ".generation-owner") populate)))
(defn activation [app root]
 (let [ready (Jason/decode! (journal/read-file root "READY.json" journal/LIMIT))
       marker (Jason/decode! (journal/read-file root ".bl-generation" 1048576))]
  {"version" 1 "phase" "write-admitted" "journalRevision" 1 "writesAdmitted" true
   "candidateReleaseId" (get ready "code") "dataVersion" 1
   "dataGeneration" {"version" 1 "application" "fixture.app" "writerRoot" (:path app)
                     "root" (:path root) "generation" (get marker "generation") "ready" (get marker "ready")
                     "keyFormat" 2 "dataVersion" 1 "code" (get ready "code") "runtime" (get ready "tool")}}))
(defn save-activation! [app value]
 (let [state (fs/claim! (Path/dirname (:path app)))]
  (try
   (let [old (journal/read-file state "activation.json" 1048576)]
    (when-not (fs/put! state "activation.json" old (if (string? value) value (Jason/encode! value)) {:read-group 65534})
     (throw (ex-info "fixture journal CAS failed" {}))))
   (finally (close state)))))

(deftest root-owned-host-selection-admits-an-actual-unprivileged-candidate
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".nonroot-admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))]
  (try
   (let [state (fs/claim! parent)]
    (try (fs/group-readable! state 65534) (finally (close state))))
   (fs/group-readable! app 65534)
   (save-activation! app (activation app root))
   (finally (close root) (close app)))
  (let [result (System/cmd "python3"
                (list "test/support/datom-generation-nonroot.py" (Path/expand ".bl/ci-candidate")
                      (Path/expand "test/fixtures/datom/generation-nonroot.bl") parent))]
   (is (= 0 (elem result 1)) (elem result 0))
   (is (String/contains? (elem result 0) "NONROOT-GENERATION-ADMITTED")))))



(deftest selection-opens-the-ready-inventory-and-observes-only-real-native-state
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".selected-generation")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))
       selected (assoc (activation app root) "phase" "starting" "writesAdmitted" false)]
  (try
   (let [state (fs/claim! parent)]
    (try (fs/group-readable! state 65534) (finally (close state))))
   (fs/group-readable! app 65534)
   (save-activation! app selected)
   (finally (close root) (close app)))
  (let [owner (generation/open-selected! parent)]
   (try
    (let [observed (generation/status! owner) ready (generation/readiness! owner)]
     (is (= (get selected "dataGeneration") (get observed "dataGeneration")))
     (is (= false (get observed "writesAdmitted")))
     (is (= observed (generation/status! (assoc owner :root {} :app {} :writesAdmitted true))))
     (is (= (l/digest (get selected "dataGeneration")) (get ready "selection")))
     (is (= codec/INDEX-VERSION (get ready "runtimeKeyFormat")))
     (is (= (if (= 2 codec/INDEX-VERSION) "read-only-ready" "read-only") (get ready "status"))))
    (save-activation! (:app owner) (assoc selected "phase" "write-admitted" "writesAdmitted" true "journalRevision" 2))
    (generation/admit! owner)
    (is (= true (get (generation/status! owner) "writesAdmitted")))
    (is (= "write-admitted" (get (generation/readiness! owner) "status")))
    (finally
     (generation/release! owner) (close (:root owner)) (close (:app owner)))))
  (File/rm_rf! parent)))

(defn admit-bootstrap! [parent selected observation]
 (is (= "read-only-ready" (get observation "status")))
 (is (= false (get observation "writesAdmitted")))
 (let [state (fs/claim! parent)]
  (try
   (let [before (journal/read-file state "activation.json" 1048576)]
    (is (= selected (Jason/decode! before)))
    (fs/put! state "activation.json" before
     (Jason/encode! (assoc selected "phase" "write-admitted" "writesAdmitted" true "journalRevision" 2))
     {:read-group 65534}))
   (finally (close state)))))

(deftest bootstrap-defers-application-loading-and-initialization-until-native-admission
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".nonroot-admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))
       selected (assoc (activation app root) "phase" "starting" "writesAdmitted" false)
       original (fs/claim! (str parent "/original") {:readonly true})
       before (try (fs/tree-digest original) (finally (close original)))]
  (try
   (let [state (fs/claim! parent)]
    (try (fs/group-readable! state 65534) (finally (close state))))
   (fs/group-readable! app 65534)
   (save-activation! app selected)
   (finally (close root) (close app)))
  (let [mode (if (= 2 codec/INDEX-VERSION) "boot" "incompatible")
         command (fn [] (System/cmd "python3"
                      (list "test/support/datom-generation-nonroot.py" (Path/expand ".bl/ci-candidate")
                       (Path/expand "test/fixtures/datom/generation-boot.bl") parent mode)))
         task (Task/async command)]
   (try
    (when (= 2 codec/INDEX-VERSION)
     (let [deadline (+ (System/monotonic_time :millisecond) 60000)
           path (str parent "/readiness.json")]
      (loop []
       (when-not (File/exists? path)
        (when-let [finished (Task/yield task 0)]
         (throw (ex-info "Candidate exited before read-only readiness" {:result finished})))
        (when (>= (System/monotonic_time :millisecond) deadline)
         (throw (ex-info "Candidate never reached read-only readiness" {})))
        (Process/sleep 50) (recur)))
      (is (not (File/exists? (str parent "/child/application-loaded"))))
      (is (not (File/exists? (str parent "/child/initialized"))))
      (admit-bootstrap! parent selected (Jason/decode! (File/read! path)))))
    (let [result (Task/await task 100000)]
     (is (= 0 (elem result 1)) (elem result 0))
     (is (String/contains? (elem result 0)
           (if (= 2 codec/INDEX-VERSION) "NONROOT-GENERATION-BOOTSTRAPPED" "NONROOT-GENERATION-BOOT-REFUSED"))))
   (let [original (fs/claim! (str parent "/original") {:readonly true})]
    (try (is (= before (fs/tree-digest original))) (finally (close original))))
   (when (= 1 codec/INDEX-VERSION)
    (is (= selected (Jason/decode! (File/read! (str parent "/activation.json"))))))
   (finally
    (when (Process/alive? (:pid task))
     (File/write! (str parent "/stop") "stop fixture")
     (try (Task/await task 10000) (catch _ nil)))
    (let [removed (File/rm_rf parent)]
     (is (= :ok (elem removed 0)) (Kernel/inspect removed))))))))

(deftest a-stale-release-launch-cannot-start-on-a-new-journal-selection
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".nonroot-admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))
       selected (assoc (activation app root) "phase" "starting" "writesAdmitted" false)]
  (try
   (let [state (fs/claim! parent)]
    (try (fs/group-readable! state 65534) (finally (close state))))
   (fs/group-readable! app 65534)
   (save-activation! app selected)
   (finally (close root) (close app)))
  (try
   (let [result (System/cmd "python3"
                 (list "test/support/datom-generation-nonroot.py" (Path/expand ".bl/ci-candidate")
                       (Path/expand "test/fixtures/datom/generation-boot.bl") parent "mismatch"))]
    (is (= 0 (elem result 1)) (elem result 0))
    (is (String/contains? (elem result 0) "Selected generation requires another release"))
    (is (= selected (Jason/decode! (File/read! (str parent "/activation.json")))))
    (is (not (File/exists? (str parent "/child/application-loaded")))))
   (finally (File/rm_rf! parent)))))

(deftest an-unadmitted-offline-task-cannot-load-its-namespace
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".nonroot-admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))
       selected (assoc (activation app root) "phase" "starting" "writesAdmitted" false)]
  (try
   (let [state (fs/claim! parent)]
    (try (fs/group-readable! state 65534) (finally (close state))))
   (fs/group-readable! app 65534)
   (save-activation! app selected)
   (finally (close root) (close app)))
  (try
   (let [result (System/cmd "python3"
                 (list "test/support/datom-generation-nonroot.py" (Path/expand ".bl/ci-candidate")
                       (Path/expand "test/fixtures/datom/generation-task.bl") parent "task-unadmitted"))]
    (is (= 0 (elem result 1)) (elem result 0))
    (is (String/contains? (elem result 0) "NONROOT-GENERATION-TASK-REFUSED"))
    (is (= selected (Jason/decode! (File/read! (str parent "/activation.json")))))
    (is (not (File/exists? (str parent "/child/task-loaded")))))
   (finally (File/rm_rf! parent)))))

(deftest a-real-service-user-creates-an-on-demand-store-and-blob-sibling-under-admitted-custody
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".nonroot-admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))]
  (try
   (let [state (fs/claim! parent)]
    (try (fs/group-readable! state 65534) (finally (close state))))
   (fs/group-readable! app 65534)
   (save-activation! app (assoc-in (activation app root) ["dataGeneration" "dynamicStores"] 1))
   (finally (close root) (close app)))
  (let [result (System/cmd "python3"
                (list "test/support/datom-generation-nonroot.py" (Path/expand ".bl/ci-candidate")
                      (Path/expand "test/fixtures/datom/generation-dynamic-nonroot.bl") parent "dynamic"))]
   (is (= 0 (elem result 1)) (elem result 0))
   (is (String/contains? (elem result 0) "NONROOT-DYNAMIC-GENERATION-ADMITTED")))
  (File/rm_rf! parent)))
