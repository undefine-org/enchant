(ns datom.identity-v1-compatibility-test
 (:require [datom.identity :as identity] [credential.seal :as seal] [interop]))

(def cases
 {"empty-list" (list) "empty-vector" []
  "list" (list 1 2) "vector" [1 2]
  "nested-list" {:context (list "tenant" {:ids (list 1 2)})}
  "nested-vector" {:context ["tenant" {:ids [1 2]}]}
  "metadata" (with-meta [1 "tenant"] {:source :ignored})
  "large-exact" 9007199254740994 "large-rounded-up" 9007199254740995
  "large-rounded-down" 9007199254740993 "large-negative" -9007199254740995
  "large-float" 9007199254740994.0
  "map-and-set" {:flags #{:read :write} :active false :optional nil}})

(def context {:tenant "synthetic" :items (list 1 [2 9007199254740994])})
(def key (erlang/list_to_binary (to-list (range 32))))
(def key-id "synthetic-fixture-key")
(def plain "Datom identity v1 compatibility fixture")

(defn golden []
 (interop/json-> (File/read! "test/fixtures/datom/identity-v1-golden.json")))
(defn unhex [value] (binary/decode_hex (String/upcase value)))

(deftest retained-v1-identities-keep-their-exact-digests
 (let [fixture (golden) expected (get fixture "digests")]
  (is (= 1 (get fixture "version")))
  (is (= (set (keys cases)) (set (keys expected))))
  (doseq [[label value] cases]
   (is (= (get expected label) (identity/digest value)) label))))

(deftest old-v2-credentials-authenticate-without-resealing
 (let [stored (get (golden) "credential")
       envelope {:format :credential.seal/v2 :key-id key-id
                 :iv (unhex (get stored "iv")) :ct (unhex (get stored "ct"))
                 :tag (unhex (get stored "tag"))}]
  (is (= plain (seal/open key key-id context envelope)))
  (is (thrown? (seal/open key key-id (assoc context :tenant "other") envelope)))
  (is (thrown? (seal/open key "other-key" context envelope)))
  (is (thrown? (seal/open key key-id context (assoc envelope :format :credential.seal/unknown))))
  (is (thrown? (seal/open key key-id context (assoc envelope :tag (binary/copy "x" 16)))))
  ;; V2 authentication keeps its old representation binding even when index
  ;; equality changes. A new context contract needs its own envelope version.
  (is (thrown? (seal/open key key-id
                (assoc context :items [1 [2 9007199254740994]]) envelope)))))
