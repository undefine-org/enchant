(ns datom.source-writer-handoff-test
 (:require [reload.generation :as g] [datom :as d]))

(deftest actual-source-can-initialize-a-schema-and-use-its-serialized-writer
 (let [graph (g/prepare!
              {:application-id "source-writer-handoff"
               :stable-namespaces #{"datom"}
               :sources {"handoff.writer"
                "(ns handoff.writer (:require [datom :as d]))
                 (defn open [] (d/connect [{:db/ident :fixture/value :db/valueType :db.type/string :db/cardinality :db.cardinality/one}]))
                 (defn write [connection] (d/transact! connection [{:db/id -1 :fixture/value \"accepted\"}]))
                 (defn read [connection] (d/q '[:find ?value :where [_ :fixture/value ?value]] (d/db connection)))"}})
       connection (atom nil)]
  (try
   (reset! connection (g/invoke! graph "handoff.writer/open" []))
   (is (some? @connection))
   (is (some? (g/invoke! graph "handoff.writer/write" [@connection])))
   (is (= #{["accepted"]} (g/invoke! graph "handoff.writer/read" [@connection])))
   (finally (when @connection (d/close! @connection)) (g/retire! graph)))))
(deftest actual-source-can-use-legacy-filesystem-blobs-without-gaining-generation-authority
 (let [graph (g/prepare!
              {:application-id "source-blob-handoff"
               :stable-namespaces #{"datom.blob" "datom.blob-fs" "datom.file" "datom.store"}
               :sources {"handoff.blobs"
                "(ns handoff.blobs (:require [datom.blob :as blob] [datom.blob-fs :as fs] [datom.file :as file] [datom.store :as store]))
                 (defn roundtrip []
                  (let [bs (fs/open :tmp) sha (file/sha256 \"source blob\")]
                   (try (blob/-blob-put bs sha \"source blob\")
                        (blob/-blob-get bs sha)
                        (finally (store/close bs)))))"}})]
  (try
   (is (= "source blob" (g/invoke! graph "handoff.blobs/roundtrip" [])))
   (finally (g/retire! graph)))))

(run-tests)
