(ns datom.generation-owner-test
 (:require [datom.generation :as generation] [datom.offline.root :as root]
           [datom.offline.fs :as fs] [datom.offline.journal :as journal]
           [datom.offline.layout :as l] [datom.store-fjall :as fj]
           [datom.blob-fs :as blob-fs] [datom.blob :as blob] [datom.file :as file]
           [datom.store :as s] [reload.generation :as source]))
(def spec {:version 1 :application "fixture.app" :key-format 2 :data-version 1
           :stores [{:id "control" :path "control.fjall" :blobs {:kind :fs :path "control.fjall.blobs"}}
                    {:id "library/one" :path "libraries/a.fjall" :blobs {:kind :fs :path "libraries/a.fjall.blobs"}}]
           :files ["config.json"] :directories ["empty"]})
(defn kind [f] (try (f) nil (catch error (:kind (ex-data error)))))
(defn native-refused? [value]
 (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value)) (= :error (elem value 0))))
(defn close [directory] (try (fs/close! directory) (catch _ nil)))
(defn fixture-at [parent populate]
 (let [original (str parent "/original")
       evidence (Jason/decode! (File/read! "test/fixtures/datom/legacy-root-v1.json"))]
  (File/mkdir_p! original)
  (doseq [part (get evidence "archives")]
   (let [result (System/cmd "tar" (list "-xzf" (Path/expand (str "test/fixtures/datom/" (get part "file"))) "-C" original))]
    (when-not (= 0 (elem result 1)) (throw (ex-info "fixture extraction failed" {})))))
  (populate original)
  (root/prepare! original (str parent "/job") (str parent "/generation")
   (get-in evidence ["producer_receipt" "sdk_descriptor_sha256"]) (l/digest :fixture-release) (assoc spec :key-format 1))
  {:app (fs/claim! (str parent "/writer") {:create true})
   :root (fs/claim! (str parent "/generation"))}))
(defn fixture
 ([] (fixture (fn [_] nil)))
 ([populate] (fixture-at (s/fresh-path ".generation-owner") populate)))
(defn release-closed! [owner]
 (loop [left 100]
  (let [error (kind #(generation/release! owner))]
   (when error
    (when (= 0 left) (throw (ex-info "generation engine did not retire" {:kind error})))
    (erlang/garbage_collect) (Process/sleep 10) (recur (dec left))))))

(defn activation [app root]
 (let [ready (Jason/decode! (journal/read-file root "READY.json" journal/LIMIT))
       marker (Jason/decode! (journal/read-file root ".bl-generation" 1048576))]
  {"version" 1 "phase" "write-admitted" "journalRevision" 1 "writesAdmitted" true
   "candidateReleaseId" (get ready "code") "dataVersion" 1
   "dataGeneration" {"version" 1 "application" "fixture.app" "writerRoot" (:path app)
                     "root" (:path root) "generation" (get marker "generation") "ready" (get marker "ready")
                     "keyFormat" 2 "dataVersion" 1 "code" (get ready "code") "runtime" (get ready "tool")}}))
(defn save-activation! [app value]
 (let [state (fs/claim! (Path/dirname (:path app)))]
  (try
   (let [old (journal/read-file state "activation.json" 1048576)]
    (when-not (fs/put! state "activation.json" old (if (string? value) value (Jason/encode! value)))
     (throw (ex-info "fixture journal CAS failed" {}))))
   (finally (close state)))))

(deftest only-the-actual-durable-host-journal-admits-existing-db-and-blob-handles
 ;; The VM runs this synthetic fixture as root, with protected /tmp ancestry.
 ;; /build is deliberately not authority: its worker directory is writable.
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil))
       owner (generation/claim! app root spec) record (activation app root)
       bs (blob-fs/open (str (:path root) "/control.fjall.blobs"))
       sha (file/sha256 "admitted") hex (file/sha-hex sha)
       input (str parent "/input") bytes (String/duplicate "bounded input\n" 16000)
       native (:generation bs)]
  (try
   ((fn []
    (let [store (fj/open (str (:path root) "/control.fjall")) before (fs/tree-digest root)]
     (try
   (File/write! input bytes)
   (is (not (BeamLisp.Native.Datom.StoreFjall/fjall_write_admitted (:handle store))))
   (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
   (doseq [value [(assoc record "phase" "candidate-ready") (assoc record "writesAdmitted" false)
                  (assoc record "version" 2) (assoc record "journalRevision" 0)
                  (assoc record "dataVersion" 2) (assoc record "candidateReleaseId" (l/digest :wrong-code))
                  (assoc-in record ["dataGeneration" "generation"] (l/digest :other))
                  (assoc-in record ["dataGeneration" "writerRoot"] (str parent "/other"))
                  (assoc-in record ["dataGeneration" "root"] (str parent "/other"))
                  (assoc-in record ["dataGeneration" "runtime"] (l/digest :other))
                  (assoc-in record ["dataGeneration" "keyFormat"] 1)
                  (assoc-in record ["dataGeneration" "application"] "other")
                  (str "{\"version\":1," (String/trim_leading (Jason/encode! record) "{"))]]
    (save-activation! app value)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (is (not (BeamLisp.Native.Datom.StoreFjall/fjall_write_admitted (:handle store)))))
   (doseq [result [(BeamLisp.Native.Datom.StoreFjall/fjall_generation_blob_put native hex "admitted")
                   (BeamLisp.Native.Datom.StoreFjall/fjall_generation_blob_delete native hex)
                   (BeamLisp.Native.Datom.StoreFjall/fjall_generation_blob_import native input)
                   (BeamLisp.Native.Datom.StoreFjall/fjall_put (:handle store) "new" "value")
                   (BeamLisp.Native.Datom.StoreFjall/fjall_delete (:handle store) "new")
                   (BeamLisp.Native.Datom.StoreFjall/fjall_cas (:handle store) "new" nil "value")
                   (BeamLisp.Native.Datom.StoreFjall/fjall_commit (:handle store) (list (tuple :put "new" "value")))]]
    (is (native-refused? result)))
   (is (= before (fs/tree-digest root)))
   (is (not (File/exists? (:dir bs))))
   (save-activation! app record)
   ;; The JSON contents alone are never authority. The host-owned file and
   ;; ancestry must exclude application writers, and aliases must refuse.
   (let [journal-path (str parent "/activation.json") alias (str parent "/journal-alias")]
    (File/chmod! journal-path 438)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (File/chmod! journal-path 384)
    (File/ln! journal-path alias)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (File/rm! alias)
    (File/chmod! (:path app) 511)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (File/chmod! (:path app) 448)
    (File/chmod! (:path root) 511)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (File/chmod! (:path root) 1023)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (File/chmod! (:path root) 448)
    (File/chown! journal-path 1)
    (is (= :generation-ownership-refused (kind #(generation/admit! owner))))
    (File/chown! journal-path 0)
    (is (not (BeamLisp.Native.Datom.StoreFjall/fjall_write_admitted (:handle store)))))
   (is (generation/admit! owner))
   (is (generation/admit! owner))
   (is (BeamLisp.Native.Datom.StoreFjall/fjall_write_admitted (:handle store)))
   (is (= :ok (BeamLisp.Native.Datom.StoreFjall/fjall_put (:handle store) "new" "first")))
   (is (= (tuple true "second") (BeamLisp.Native.Datom.StoreFjall/fjall_cas (:handle store) "new" "first" "second")))
   (is (= :ok (BeamLisp.Native.Datom.StoreFjall/fjall_commit (:handle store)
                (list (tuple :delete "new") (tuple :put "new" "third")))))
   (is (= "third" (fj/raw-get store "new")))
   (is (= :ok (BeamLisp.Native.Datom.StoreFjall/fjall_delete (:handle store) "new")))
   (is (nil? (fj/raw-get store "new")))
   (is (= bs (blob/-blob-put bs sha "admitted")))
   (is (= bs (blob/-blob-put bs sha "admitted")))
   (is (= "admitted" (blob/-blob-get bs sha)))
   (is (= :generation-blob-write-refused (kind #(blob/-blob-put bs sha "different"))))
   (let [alias (str input "-alias")]
    (File/ln_s! input alias)
    (try (is (= :generation-blob-write-refused (kind #(blob/-blob-import bs alias {}))))
     (finally (File/rm! alias))))
   (let [f (blob/-blob-import bs input {:media-type "text/plain"}) pin (blob/retain! bs)]
    (try
     (is (= (file/sha256 bytes) (:sha f)))
     (is (= (erlang/byte_size bytes) (:size f)))
     (is (= "text/plain" (:media-type f)))
     (is (= bytes (erlang/iolist_to_binary (to-list (blob/stream bs (:sha f))))))
     (is (= :blob-retention-active (kind #(blob/-blob-delete bs sha))))
     (finally (blob/release! bs pin)))
    (is (= f (blob/-blob-import bs input {:media-type "text/plain"})))
    (is (= #{sha (:sha f)} (set (blob/-blob-shas bs)))))
   (is (= bs (blob/-blob-delete bs sha)))
   (is (not (blob/-blob-has? bs sha)))
   (is (= [] (into [] (File/ls! (str (:dir bs) "/.tmp")))))
   (is (= :offline-filesystem-refused (kind #(fs/put! root "bypass" nil "bad"))))
   (is (= :generation-blob-ownership-required
          (kind #(blob/-blob-put (blob-fs/->BlobFs (:dir bs) false) sha "admitted"))))
   (let [ready (str (:path root) "/READY.json")]
    (File/rename! ready (str ready "-original")) (File/cp! (str ready "-original") ready)
    (is (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_put (:handle store) "new" "changed")))
    (is (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_generation_blob_put native hex "admitted"))))
      (finally (try (s/close store) (catch _ nil)))))))
   (finally (s/close bs) (release-closed! owner) (close root) (close app)))))

(deftest actual-source-borrows-admitted-blob-writers-without-host-authority
 (let [parent (str "/tmp/" (Path/basename (s/fresh-path ".source-admission")))
       {:keys [app root]} (fixture-at parent (fn [_] nil)) owner (generation/claim! app root spec)
       input (str parent "/input") path (str (:path root) "/control.fjall.blobs")
       graph (source/prepare!
              {:application-id "generation-blob-writer"
               :stable-namespaces #{"datom.blob" "datom.blob-fs" "datom.file" "datom.store" "datom.generation"}
               :sources {"fixture.blob-writer"
                "(ns fixture.blob-writer (:require [datom.blob :as b] [datom.blob-fs :as fs] [datom.file :as f] [datom.store :as s] [datom.generation :as g]))
                 (defn write [path input]
                  (let [bs (fs/open path) sha (f/sha256 \"Source content\")]
                   (try (b/-blob-put bs sha \"Source content\")
                        [(b/-blob-get bs sha) (:sha (b/-blob-import bs input {}))]
                        (catch error (:kind (ex-data error)))
                        (finally (s/close bs)))))
                 (defn write-store [store]
                   (try (s/-put store \"source-writer\" :source)
                        (let [value (s/-get store \"source-writer\")] (s/-delete store \"source-writer\") value)
                        (catch error (:kind (ex-data error)))))
                 (defn admit [] (try (g/admit! nil) false (catch _ true)))"}})]
  (try
   (File/write! input "Source import")
   (is (= :generation-write-admission-required (source/invoke! graph "fixture.blob-writer/write" [path input])))
   (is (source/invoke! graph "fixture.blob-writer/admit" []))
   (is (not (File/exists? path)))
   ((fn []
     (let [store (fj/open (str (:path root) "/control.fjall"))]
      (try
       (is (= :native-store-operation-failed (source/invoke! graph "fixture.blob-writer/write-store" [store])))
       (save-activation! app (activation app root))
       (is (generation/admit! owner))
       (is (= ["Source content" (file/sha256 "Source import")]
              (source/invoke! graph "fixture.blob-writer/write" [path input])))
       (is (= :source (source/invoke! graph "fixture.blob-writer/write-store" [store])))
       (is (source/invoke! graph "fixture.blob-writer/admit" []))
       (finally (s/close store))))))
   (release-closed! owner)
   (finally (source/retire! graph) (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest enrolled-roots-reject-unowned-engine-blob-and-generic-file-mutations
 (let [{:keys [app root]} (fixture) alias (str (:path root) "-alias")
       before (fs/tree-digest root) sha (file/sha256 "attempt")]
  (try
   (File/ln_s! (:path root) alias)
   (doseq [path [(str (:path root) "/control.fjall") (str alias "/control.fjall")
                 (str alias "/new.fjall")]]
    (is (try (fj/open path) false (catch _ true))))
   (is (not (File/exists? (str (:path root) "/new.fjall"))))
   (is (= :offline-filesystem-refused (kind #(fs/put! root "unowned" nil "changed"))))
   (is (= :offline-filesystem-refused (kind #(fs/claim! (str (:path root) "/unowned") {:create true}))))
   (is (= :generation-blob-ownership-required (kind #(blob-fs/open (str alias "/new.blobs")))))
   ;; A caller-constructed record and a handle opened before enrollment cannot
   ;; bypass a guard placed only in open. Every mutator rechecks protection.
   (let [forged (blob-fs/->BlobFs (str (:path root) "/libraries/a.fjall.blobs") false)]
    (is (= :generation-blob-ownership-required (kind #(blob/-blob-put forged sha "attempt"))))
    (is (= :generation-blob-ownership-required (kind #(blob/-blob-delete forged sha))))
    (is (= :generation-blob-ownership-required
           (kind #(blob/-blob-import forged (str (:path root) "/config.json") {})))))
   (is (= before (fs/tree-digest root)))
   (finally (File/rm alias) (close root) (close app)))))

(deftest application-and-every-closed-store-remain-owned-through-native-worker-retirement
 (let [{:keys [app root]} (fixture) owner (generation/claim! app root spec)
       parent (erlang/self) tag (erlang/make_ref) path (str (:path root) "/control.fjall")
       monitored (erlang/spawn_monitor
        (fn []
         (let [store (fj/open path) before (fj/raw-get store l/TX-KEY)]
          (erlang/send parent [tag :opened (s/-get store l/TX-KEY)])
          (receive [reply :finish] :when (= reply tag) nil)
          (erlang/send parent [tag :readonly
           [(kind #(s/-put store l/TX-KEY 2000000))
            (kind #(s/-delete store l/TX-KEY))
            (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_put (:handle store) l/TX-KEY before))
            (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_delete (:handle store) l/TX-KEY))
            (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_cas (:handle store) l/TX-KEY before before))
            (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_commit (:handle store) (list (tuple :delete l/TX-KEY))))
            (s/-get store l/TX-KEY)]]))))
       pid (elem monitored 0) monitor (elem monitored 1)]
  (try
   (receive [reply :opened value] :when (= reply tag) (is (= 1000031 value))
    (after 30000 (throw (ex-info "generation worker did not open" {}))))
   (is (= :generation-ownership-refused (kind #(generation/release! owner))))
   (is (= :offline-filesystem-refused (kind #(fs/close! app))))
   (is (= :offline-filesystem-refused (kind #(fs/close! root))))
   ;; Even an engine not opened by the candidate is already kernel-claimed.
   (is (= :offline-filesystem-refused
          (kind #(fs/child! (fs/child! root "libraries") "a.fjall" {:lock true}))))
   (is (= :offline-filesystem-refused (kind #(fs/put! root "readonly" nil "changed"))))
   (erlang/send pid [tag :finish])
   (receive [reply :readonly values] :when (= reply tag)
    (is (= [:native-store-operation-failed :native-store-operation-failed true true true true 1000031] values))
    (after 30000 (throw (ex-info "generation worker did not report" {}))))
   (receive [:DOWN ref :process worker reason] :when (and (= ref monitor) (= worker pid))
    (is (= :normal reason)) (after 30000 (throw (ex-info "generation worker did not exit" {}))))
   (release-closed! owner)
   (is (try (fj/open path) false (catch _ true)))
   (is (fs/close! root)) (is (fs/close! app))
   (finally (erlang/send pid [tag :finish]) (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest copied-flags-or-derived-capabilities-cannot-substitute-for-independent-root-claims
 (let [{:keys [app root]} (fixture)
       raw (journal/read-file root ".bl-generation" 1048576)
       ready-raw (journal/read-file root "READY.json" journal/LIMIT)
       derived (fs/child! root "libraries")]
  (try
   (is (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_generation_claim
                         (:handle root) (:handle root) raw ready-raw (list "control.fjall") (list "control.fjall.blobs"))))
   (is (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_generation_claim
                         (:handle app) (:handle derived) raw ready-raw (list "a.fjall") (list "a.fjall.blobs"))))
   (is (= :generation-identity-mismatch
          (kind #(generation/claim! app root (assoc spec :application "other")))))
   (let [owner (generation/claim! app root spec)]
    (try
     (is (= :generation-ownership-refused (kind #(generation/claim! app root spec))))
     (finally (generation/release! owner))))
   (finally (close root) (close app)))))

(deftest a-checkpoint-retains-generation-custody-after-the-opening-worker-exits
 (let [{:keys [app root]} (fixture) owner (generation/claim! app root spec)
       parent (erlang/self) tag (erlang/make_ref) path (str (:path root) "/control.fjall")
       monitored (erlang/spawn_monitor
        (fn [] (let [store (fj/open path)]
                 (erlang/send parent [tag (s/capture-checkpoint! store)]))))
       pid (elem monitored 0) monitor (elem monitored 1)]
  (try
   (receive [reply cursor] :when (= reply tag)
    (try
     (receive [:DOWN ref :process worker reason] :when (and (= ref monitor) (= worker pid))
      (is (= :normal reason)) (after 30000 (throw (ex-info "checkpoint worker did not exit" {}))))
     (is (= :generation-ownership-refused (kind #(generation/release! owner))))
     (is (= :offline-filesystem-refused (kind #(fs/close! app))))
     (is (= :offline-filesystem-refused (kind #(fs/close! root))))
     (finally (s/release-checkpoint! cursor)))
    (after 30000 (throw (ex-info "checkpoint worker did not report" {}))))
   (release-closed! owner)
   (is (fs/close! root)) (is (fs/close! app))
   (finally (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest ordinary-blob-opens-borrow-readonly-custody-without-creating-empty-tiers
 (let [{:keys [app root]} (fixture) owner (generation/claim! app root spec)
       before (fs/tree-digest root) alias (str (:path root) "-alias")
       bs (blob-fs/open (str (:path root) "/libraries/a.fjall.blobs"))
       empty (blob-fs/open (str (:path root) "/control.fjall.blobs"))
       missing (file/sha256 "missing") sha (file/sha256 "current attachment")]
  (try
   (File/ln_s! (:path root) alias)
   (let [same (blob-fs/open (str alias "/libraries/a.fjall.blobs")) pin (blob/retain! empty)]
    (try
     (is (= "current attachment" (blob/-blob-get bs sha)))
     (is (= "historical attachment" (blob/-blob-get same (file/sha256 "historical attachment"))))
     (is (blob/-blob-has? bs sha))
     (is (= #{(file/sha256 "current attachment") (file/sha256 "historical attachment")}
            (set (blob/-blob-shas bs))))
     (is (= "current attachment" (erlang/iolist_to_binary (to-list (blob/stream same sha)))))
     (is (nil? (blob/-blob-get bs missing)))
     (is (nil? (blob/stream bs missing)))
     (is (not (blob/-blob-has? empty missing)))
     (is (= [] (blob/-blob-shas empty)))
     (is (not (File/exists? (str (:path root) "/control.fjall.blobs"))))
     (is (= :released (blob/release! empty pin)))
     ;; Native custody, rather than mutable record fields, binds reads and URLs.
     (is (= "current attachment" (blob/-blob-get (assoc bs :dir "/absent") sha)))
     (is (= (blob/-blob-url bs sha {}) (blob/-blob-url (assoc bs :dir "/absent") sha {})))
     (is (= :generation-blob-ownership-required (kind #(blob-fs/open (str (:path root) "/undeclared.blobs")))))
     (doseq [write [#(blob/-blob-put bs missing "missing") #(blob/-blob-delete bs sha)
                    #(blob/-blob-import empty (str (:path root) "/config.json") {})]]
      (is (= :generation-write-admission-required (kind write))))
     (is (= :generation-ownership-refused (kind #(generation/release! owner))))
     (is (= before (fs/tree-digest root)))
     (finally (s/close same) (blob/release! empty pin))))
   (s/close bs) (s/close empty)
   (is (= :generation-blob-ownership-required (kind #(blob/-blob-get bs sha))))
   (is (nil? (s/close bs)))
   (generation/release! owner)
   (is (fs/close! root)) (is (fs/close! app))
   (finally (s/close bs) (s/close empty) (File/rm alias)
    (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest a-blob-stream-retains-custody-after-close-and-releases-it-at-eof
 (let [bytes (String/duplicate "x" 150000) sha (file/sha256 bytes)
       {:keys [app root]} (fixture
        (fn [original]
         (let [bs (blob-fs/open (str original "/libraries/a.fjall.blobs"))]
          (blob/-blob-put bs sha bytes) (blob/-blob-put bs (file/sha256 "") "") (s/close bs))))
       owner (generation/claim! app root spec)
       bs (blob-fs/open (str (:path root) "/libraries/a.fjall.blobs"))
       stream (blob/stream bs sha) empty (blob/stream bs (file/sha256 ""))]
  (try
   (s/close bs)
   (is (= :generation-ownership-refused (kind #(generation/release! owner))))
   (is (= [65536 65536 18928] (mapv erlang/byte_size stream)))
   (is (= bytes (erlang/iolist_to_binary (to-list stream))))
   (is (= [] (into [] empty)))
   ;; Even retained memo cells and the closed BlobFs no longer own the root.
   (is (generation/release! owner))
   (is (fs/close! root)) (is (fs/close! app))
   (finally (s/close bs) (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest actual-source-uses-ordinary-owned-blobs-without-gaining-write-admission
 (let [{:keys [app root]} (fixture) owner (generation/claim! app root spec)
       graph (source/prepare!
              {:application-id "generation-blob-reader"
               :stable-namespaces #{"datom.blob" "datom.blob-fs" "datom.file" "datom.store"}
               :sources {"fixture.blob-reader"
                "(ns fixture.blob-reader (:require [datom.blob :as b] [datom.blob-fs :as fs] [datom.file :as f] [datom.store :as s]))
                 (defn read [path]
                  (let [bs (fs/open path) sha (f/sha256 \"current attachment\")]
                   (try [(b/-blob-get bs sha)
                         (into [] (b/stream bs sha))
                         (try (b/-blob-put bs sha \"current attachment\") :unexpected
                              (catch error (:kind (ex-data error))))]
                        (finally (s/close bs)))))"}})]
  (try
   (is (= ["current attachment" ["current attachment"] :generation-write-admission-required]
          (source/invoke! graph "fixture.blob-reader/read" [(str (:path root) "/libraries/a.fjall.blobs")])))
   (is (generation/release! owner))
   (is (fs/close! root)) (is (fs/close! app))
   (finally (source/retire! graph) (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest owned-blob-reads-refuse-file-aliases-and-replaced-generation-markers
 (let [{:keys [app root]} (fixture) owner (generation/claim! app root spec)
       store (fj/open (str (:path root) "/control.fjall"))
       bs (blob-fs/open (str (:path root) "/libraries/a.fjall.blobs"))
       sha (file/sha256 "current attachment") hex (file/sha-hex sha)
       path (str (:dir bs) "/" (String/slice hex 0 2) "/" (String/slice hex 2 2) "/" hex)
       moved (str path "-original") marker (str (:path root) "/.bl-generation")]
  (try
   (File/rename! path moved) (File/ln_s! moved path)
   (is (= :generation-blob-ownership-required (kind #(blob/-blob-get bs sha))))
   (is (= :generation-blob-ownership-required (kind #(blob/-blob-has? bs sha))))
   (is (= :generation-blob-ownership-required (kind #(blob/-blob-shas bs))))
   (File/rm! path) (File/ln! moved path)
   (is (= :generation-blob-ownership-required (kind #(blob/stream bs sha))))
   (File/rm! path) (File/rename! moved path)
   (is (= "current attachment" (blob/-blob-get bs sha)))
   (let [stream (blob/stream bs sha)]
    (File/rename! marker (str marker "-original"))
    (is (try (fj/open (str (:path root) "/unexpected.fjall")) false (catch _ true)))
    (is (= :generation-blob-ownership-required (kind #(blob-fs/open (str (:path root) "/unexpected.blobs")))))
    (is (= :offline-filesystem-refused (kind #(fs/put! root "unexpected" nil "changed"))))
    (is (not (File/exists? (str (:path root) "/unexpected.fjall"))))
    (is (not (File/exists? (str (:path root) "/unexpected.blobs"))))
    (is (not (File/exists? (str (:path root) "/unexpected"))))
    (is (native-refused? (BeamLisp.Native.Datom.StoreFjall/fjall_checkpoint_capture (:handle store))))
    (File/cp! (str marker "-original") marker)
    (is (= :generation-blob-ownership-required (kind #(blob/-blob-get bs sha))))
    (is (= :generation-blob-ownership-required (kind #(first stream)))))
   (finally (s/close bs) (try (generation/release! owner) (catch _ nil)) (close root) (close app)))))

(deftest enrollment-cannot-be-escaped-by-replacing-a-declared-directory
 (let [{:keys [app root]} (fixture) tier (str (:path root) "/libraries/a.fjall.blobs")
       path (str (:path root) "/control.fjall") outside (str (:path app) "-outside")]
  (File/mkdir_p! outside)
  (try
   (File/rename! tier (str tier "-original")) (File/ln_s! outside tier)
   ;; Even BEFORE an owner is acquired, a marked lexical root cannot become
   ;; writable legacy storage through a link out to an unrelated directory.
   (is (= :generation-blob-ownership-required (kind #(blob-fs/open tier))))
   (is (= [] (into [] (File/ls! outside))))
   (File/rm! tier) (File/rename! (str tier "-original") tier)
   (let [owner (generation/claim! app root spec)]
    (try
     (File/rename! tier (str tier "-original")) (File/ln_s! outside tier)
     (is (= :generation-blob-ownership-required (kind #(blob-fs/open tier))))
     (is (= [] (into [] (File/ls! outside))))
     (File/rm! tier) (File/rename! (str tier "-original") tier)
     (File/rename! path (str path "-original")) (File/ln_s! outside path)
     (is (try (fj/open path) false (catch _ true)))
     (is (= [] (into [] (File/ls! outside))))
     (File/rm! path) (File/cp_r! (str path "-original") path)
     ;; The same pathname cannot substitute a fresh inode for the directory
     ;; whose actual flock the owner acquired. Use a valid CLOSED engine copy,
     ;; so a missing header cannot accidentally satisfy this refusal control.
     (let [copy (fs/child! root "control.fjall") before (fs/tree-digest copy)]
      (is (try (fj/open path) false (catch _ true)))
      (is (= before (fs/tree-digest copy))))
     (is (generation/release! owner))
     (finally (try (generation/release! owner) (catch _ nil)))))
   (is (fs/close! root)) (is (fs/close! app))
   (finally (close root) (close app)))))
