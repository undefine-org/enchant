(ns datom.read-only-query-test
 (:require [datom :as d] [datom.query.read-only :as readonly]
           [datom.query.functions :as functions] [datom.conn :as conn]))
(def QUERY '[:find ?id ?amount :where [?e :observation/id ?id] [?e :observation/amount ?amount]])
(defn- refusal [action] (try (action) nil (catch error (:kind (ex-data error)))))
(deftest fixed-reader-reads-current-native-data-and-keeps-closed-policy-scoped
 (let [c (d/connect [{:db/ident :observation/id :db/valueType :db.type/string}
                     {:db/ident :observation/amount :db/valueType :db.type/long}])]
  (try
   (is (not (functions/restricted?)))
   (is (= #{} (readonly/read! QUERY c)))
   (d/transact! c [{:db/id -1 :observation/id "one" :observation/amount 1599}
                   {:db/id -2 :observation/id "two" :observation/amount 1599}])
   (is (= #{["one" 1599] ["two" 1599]} (readonly/read! QUERY c)))
   (is (= (d/q QUERY (d/db c)) (readonly/read! QUERY c)))
   (is (= 2 (count (:attributes (readonly/plan! QUERY)))))
   (is (not (functions/restricted?)))
   (finally (d/close! c)))))
(deftest callback-query-raw-database-and-forged-connection-never-become-read-authority
 (let [c (d/connect [{:db/ident :observation/id :db/valueType :db.type/string}]) effects (atom 0)]
  (try
   (doseq [query ['[:find ?x :where [(callback) ?x]]
                  '[:find (pull ?e [*]) :where [?e :observation/id _]]
                  '[:find ?e :in $ % :where (rule ?e)]]]
    (is (= :unproved-state-observation (refusal #(readonly/read! query c)))))
   (let [forged (assoc c :basis (atom 999))]
    (is (some? (refusal #(readonly/read! '[:find ?e :where [?e :observation/id _]] forged)))))
   (is (some? (refusal #(readonly/read! QUERY (d/query-context (d/db c) (fn [_] (swap! effects inc) {}))))))
   (is (= 0 @effects))
   (is (not (functions/restricted?)))
   (finally (d/close! c)))))
