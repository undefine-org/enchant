(ns datom.offline-unique-test
 (:require [datom.offline.unique :as u] [datom.offline.layout :as l]))

(defn check [events]
 (u/complete (reduce u/advance (u/initial) (sort-by u/event-key events))))
(defn kind [events]
 (try (check events) nil (catch error (:kind (ex-data error)))))

(deftest canonical-identity-collisions-refuse-even-when-the-final-state-is-clean
 (doseq [[left right] [[(list 1 [2]) [1 (list 2)]]
                       [10000000000000000 1.0e16]
                       [{:x (list 1)} {:x [1]}]]]
  (is (= :offline-canonical-unique-collision
         (kind [[101 :person/key left l/FIRST-TX true]
                [102 :person/key right (+ l/FIRST-TX 1) true]
                [101 :person/key left (+ l/FIRST-TX 2) false]])))))

(deftest a-legal-transfer-applies-all-retractions-before-checking-the-next-owner
 (let [result (check [[102 :person/key (list 1) l/FIRST-TX true]
                      [101 :person/key [1] (+ l/FIRST-TX 1) true]
                      [102 :person/key [1] (+ l/FIRST-TX 1) false]])]
  (is (= #{101} (:owners result)))
  (is (= {} (:changes result)))))

(deftest same-turn-retraction-wins-over-an-assertion-for-the-same-entity
 (let [events [[101 :person/key [1] l/FIRST-TX true]
               [101 :person/key (list 1) l/FIRST-TX false]
               [102 :person/key (list 1) l/FIRST-TX true]]]
  (is (= #{102} (:owners (check events))))
  (is (= #{102} (:owners (check (vec (reverse events))))))))

(deftest claims-of-distinct-values-or-attributes-do-not-conflict
 (is (nil? (kind [[101 :person/key [1] l/FIRST-TX true]
                   [102 :person/key [2] l/FIRST-TX true]
                   [103 :other/key [1] l/FIRST-TX true]])))
 (is (nil? (kind [[101 :person/key [1] l/FIRST-TX false]]))))

(deftest streaming-across-an-arbitrary-page-cut-retains-the-same-policy
 (let [events (vec (sort-by u/event-key
                    [[102 :person/key [1] l/FIRST-TX true]
                     [102 :person/key [1] (+ l/FIRST-TX 1) false]
                     [101 :person/key (list 1) (+ l/FIRST-TX 1) true]]))]
  (doseq [cut (range 4)]
   (let [saved (reduce u/advance (u/initial) (subvec events 0 cut))
         restored (BeamLisp.Env/decode_data_term! (erlang/term_to_binary saved))
         finished (u/complete (reduce u/advance restored (subvec events cut)))]
    (is (= #{101} (:owners finished)))))))
