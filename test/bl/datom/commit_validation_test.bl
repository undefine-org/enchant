;; Invalid batch input must never become a deletion or a partial transaction.
(ns datom.commit-validation-test
 (:require [datom.store :as s] [datom.store-ets :as se] [datom.store-map :as sm]
           [datom.store-fjall :as fj] [datom.store-overlay :as overlay]))

(def factories [se/open sm/open fj/open-fresh #(overlay/open (sm/open))])
(defn refusal [compute]
 (try (compute) nil (catch error (ex-data error))))

(deftest malformed-operations-refuse-before-publishing-any-row
 (doseq [open factories]
  (let [st (open)]
   (try
    (s/-put st "keep" :original)
    (s/-put st "first" :unchanged)
    (doseq [bad [[:unknown "keep"] [:unknown "keep" :ignored]
                [:put "keep"] [:put "keep" :replacement :extra]
                [:delete "keep" :extra] [] nil 42 {:kind :delete :key "keep"}]]
     (let [before (vec (s/-range st nil nil))
           error (refusal #(s/-commit st [[:put "first" :changed] bad]))]
      (is (= :invalid-store-operation (:kind error)))
      (is (= before (vec (s/-range st nil nil))))))
    (finally (s/close st))))))

(deftest valid-operations-preserve-their-order-and-nil-payloads
 (doseq [open factories]
  (let [st (open)]
   (try
    (s/-commit st [[:put "value" :one] [:delete "value"] [:put "value" :two]
                  [:put "nil-value" nil]])
    (is (= :two (s/-get st "value")))
    (is (= [["nil-value" nil] ["value" :two]] (vec (s/-range st nil nil))))
    (s/-commit st (list (tuple :put "host" :accepted) (list :delete "value")))
    (is (= :accepted (s/-get st "host")))
    (is (nil? (s/-get st "value")))
    (finally (s/close st))))))
