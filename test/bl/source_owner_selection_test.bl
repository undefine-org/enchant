(ns source-owner-selection-test)

;; Exercise the actual host selector on a private table, without changing the
;; running Env or permitting Source to read its private custody tables.
(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/host/env.bl"))
      function (first (String/split
                 (str "(defn- source_owner_cleanup_rows"
                   (second (String/split source "(defn- source_owner_cleanup_rows")))
                 "(defn- source_owner_departed!"))]
  (BeamLisp/eval (str "(ns source-owner-selection-test)\n"
    (-> function
      (String/replace "(defn- source_owner_cleanup_rows" "(defn select-rows")
      (String/replace ":beam_lisp_source_lease_domains" "(Process/get :selection-table)")))))
(ns source-owner-selection-test)

(deftest owner-death-selection-preserves-owned-rows-and-every-handoff
  (let [table (ets/new :selection-test (list :private :set))
        owner (erlang/self) other (Process/whereis :Elixir.BeamLisp.Env)
        owned (tuple (tuple owner :callback) {:kind :callback :context :owned})
        scalar (tuple (tuple owner :lease) :scope)
        overlap (tuple (tuple owner :pending) {:kind :execution-handoff :source :malformed})
        handoff (tuple (tuple other :pending) {:kind :execution-handoff :source (tuple [] owner :ticket)})
        foreign (tuple :foreign-handoff {:kind :execution-handoff :source (tuple [] other :ticket)})
        malformed (tuple :malformed-handoff {:kind :execution-handoff :source :malformed})
        expected (set [owned scalar overlap handoff foreign malformed])]
    (Process/put :selection-table table)
    (try
      (doseq [row expected] (ets/insert table row))
      (ets/insert table (tuple (tuple other :callback) {:kind :callback :context :foreign}))
      (ets/insert table (tuple (tuple owner :not :a-two-tuple) {:kind :callback}))
      (doseq [i (range 2048)]
        (ets/insert table (tuple (tuple :sdk_inventory_row i) {:sha256 "digest" :data (list i i i)})))
      (is (= expected (set (select-rows owner))))
      (is (= (count expected) (count (select-rows owner))) "overlap is selected exactly once")
      (is (= 2056 (ets/info table :size)) "selection leaves inert metadata and other owners untouched")
      (ets/delete table (elem owned 0))
      (is (= (disj expected owned) (set (select-rows owner))) "each owner turn observes current rows")
      (finally (Process/delete :selection-table) (ets/delete table)))))
