; namespace_readiness_fast_path_test.bl — the steady-state cost of the
; cross-namespace readiness guard.
;
; The compiler emits `BeamLisp.Loader/ensure_ready(ns)` ahead of every DIRECT
; call into another namespace. The guard's answer for an already-initialized
; namespace must be O(1) and must not walk the env chain or ask `whereis`:
; `priv/host/env.bl`'s `ns_ready?/1` therefore reads a `persistent_term` fact
; first — set once, when the namespace's init completes IN THE GLOBAL ENV —
; and only falls back to the `{env, :ns_ready, ns}` ETS mirror plus the chain
; walk when that fact is absent.
;
; A fresh receiver uses this exact candidate or selected immutable SDK. Its
; Env/Loader executable digests must match the parent. Recompiling host beams
; over the production atoms would correctly fail the SDK's preinit proof;
; the canonical compiler producer owns Source-to-floor qualification.
;
; Run: bin/bl test test/bl/namespace_readiness_fast_path_test.bl

(ns namespace-readiness-fast-path-test)

(defn- source-root []
  (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))

(defn- child-tool []
  (or (System/get_env "BL_QUALIFY_CANDIDATE")
      (let [sdk (System/fetch_env! "BL_SDK_PRODUCT")]
        (assert (= (Path/expand (Path/join sdk "image/priv"))
                   (Path/expand (BeamLisp.Tiers/priv_root))))
        (Path/join sdk "bin/bl"))))

(deftest the-readiness-guard-is-o-1-once-a-namespace-is-ready
  (let [script (Path/join (Path/join (source-root) "test/fixtures") "ns_guard_child.bl")]
      (is (File/exists? script) "the child fixture is in the tree")
      (let [r (System/cmd (child-tool)
                          (to-list (list "--cold" "run" script))
                          (to-list [(tuple :stderr_to_stdout true)]))
            text (elem r 0)
            status (elem r 1)]
        (is (zero? status) (str "the child VM exited " status ":\n" text))
        (is (String/contains? text (str "env-md5="
              (Base/encode16 (erlang/apply :Elixir.BeamLisp.Env :module_info (list :md5)))))
            (str "Env differs from this exact SDK:\n" text))
        (is (String/contains? text (str "loader-md5="
              (Base/encode16 (erlang/apply :Elixir.BeamLisp.Loader :module_info (list :md5)))))
            (str "Loader differs from this exact SDK:\n" text))
        ; (a) A deferred namespace still initializes exactly once, on the first
        ; direct call, and the guard is a no-op afterwards.
        (is (String/contains? text "check-declared-is-not-ready=ok") text)
        (is (String/contains? text "check-direct-call-initializes=ok") text)
        (is (String/contains? text "check-init-ran-once=ok") text)
        (is (String/contains? text "check-ready-after-init=ok") text)
        (is (String/contains? text "check-guard-is-a-no-op-when-ready=ok") text)
        ; (b) The fast path is a global-env fact read BEFORE the chain.
        (is (String/contains? text "check-global-flag-set=ok") text)
        (is (String/contains? text "check-fast-path-skips-chain=ok") text)
        (is (String/contains? text "check-unknown-namespace-stays-false=ok") text)
        ; (c) A namespace initialized in a child env is not globally ready.
        (is (String/contains? text "check-child-env-load-is-ready-in-child=ok") text)
        (is (String/contains? text "check-fast-fact-agrees-with-global-mirror=ok") text)
        ; The cost bound: the old chain walk was ~600 reductions per guard.
        (is (String/contains? text "check-guard-reduction-bound=ok") text)
        (is (String/contains? text "semantics=ok")
            (str "the child VM reported a failed check:\n" text)))))
