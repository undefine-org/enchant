(ns typed.analysis-boundary-test (:require [typed :as types]))

(deftest unknown-syntax-does-not-load-a-provider-or-run-a-transformer
 (let [root (Path/join (System/tmp_dir!) (str "typed-analysis-boundary-" (erlang/unique_integer (list :positive))))
       effect (Path/join root "effect")
       provider "typed-analysis-boundary-provider"
       source (str "(ns " provider ") (File/write! " (pr-str effect) " \"init\") "
                   "(defmacro expand [body] (File/write! " (pr-str effect) " \"macro\") body)")]
  (File/mkdir_p! root)
  (try
   (File/write! (Path/join root (str provider ".bl")) source)
   (BeamLisp.Loader/with_load_path root
    (fn []
     (let [result (types/check-source-result
                    "(defn f [] (typed-analysis-boundary-provider/expand (+ :bad 1)))"
                    "typed.analysis-boundary-fixture")]
      (is (= :unknown (:status result)))
      (is (empty? (:diagnostics result)))
      (is (some #(= :signature-unavailable (:reason %)) (:obligations result)))
      (is (not (File/exists? effect)))
      (is (not (BeamLisp.Env/loaded_ns? provider))))))
   (finally (File/rm_rf! root)))))

(deftest unselected-syntax-operands-do-not-produce-runtime-type-errors
 (let [result (types/check-source-result
                "(defmacro discard [body] 42) (defn f [] (discard (+ :bad 1)))"
                "typed.analysis-boundary-fixture")]
  (is (= :unknown (:status result)))
  (is (empty? (:diagnostics result)))
  (is (= false (get-in result [:coverage :complete])))))

(deftest known-runtime-and-lexical-calls-still-check-their-operands
 (let [known (types/check-source-result "(defn f [] (+ :bad 1))" "typed.analysis-boundary-fixture")
       lexical (types/check-source-result "(defn f [invoke] (invoke (+ :bad 1)))" "typed.analysis-boundary-fixture")]
  (is (= :refused (:status known)))
  (is (= :refused (:status lexical)))
  (is (some #(= :type-mismatch (:kind %)) (:diagnostics known)))
  (is (some #(= :type-mismatch (:kind %)) (:diagnostics lexical)))))
