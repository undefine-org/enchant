;; A portable receiver must admit and execute native bytes without Nix paths.
(ns portable.runtime-control
  (:require [bl.json :as json] [bl.json-native :as native]))
(assert (not (File/dir? "/nix/store")))
(assert (native/loaded?))
(assert (= "[20,22]" (native/json-encode [20 22])))
(assert (= [20 22] (json/decode "[20,22]")))
(println (+ 20 22))
