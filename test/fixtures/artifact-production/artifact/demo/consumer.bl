(ns artifact.demo.consumer
 (:require [artifact.demo.values :as values]))

(values/define-answer answer)
(def computed (+ 1 2))
(def initialization
 (Process/put :artifact-demo-initialized
   (inc (or (Process/get :artifact-demo-initialized) 0))))
(defn value [] computed)
(defn adder [x] (fn [y] (+ x y)))
