(ns fixture.generation-application
 (:require [datom :as d] [datom.store :as store] [datom.generation.boot :as boot] [web]))
;; A namespace body is an application effect too: it must be deferred.
(File/write! "application-loaded" "loaded after admission")
(defn start! [opts]
 (let [control (:control-conn opts)]
  (when-not (and control (store/write-admitted? (:store control)))
   (throw (ex-info "Bootstrap must lend an admitted control connection" {})))
  (d/transact! control [{:db/ident :bootstrap/after-admission :db/doc "initializer ran"}])
  (store/sync! (:store control))
  (File/write! "initialized" "initialized after admission")
  (web/serve {:port (:port opts) :ip (tuple 127 0 0 1) :log :off
              :plug (fn [request]
                      (web/json request {"status" "ready" "borrowed" true
                       "rootSelected" (= (:data-root opts) (System/get_env "DATOM_BOOTSTRAP_ROOT"))
                       "generation" (boot/active-readiness)}))})))
