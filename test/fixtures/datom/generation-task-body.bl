(ns fixture.generation-task-body (:require [datom :as d] [datom.store-fjall :as fjall] [datom.store :as store]))
(File/write! "task-loaded" "task namespace ran")
(let [connection (d/connect-with (fjall/open (str (System/fetch_env! "DATOM_BOOTSTRAP_ROOT") "/control.fjall")))]
 (when-not (store/write-admitted? (:store connection)) (throw (ex-info "Task has no native admission" {})))
 (d/transact! connection [{:db/id -1 :db/ident :bootstrap/task :db/doc "admitted task"}])
 (store/sync! (:store connection))
 (println "GENERATION-TASK-WROTE"))
