(ns fixture.generation-dynamic-nonroot
 (:require [datom.generation :as generation] [datom.store-fjall :as fj] [datom.store :as s]
           [datom.blob-fs :as blobs] [datom.blob :as b] [datom.file :as f]))
(defn require! [condition message] (when-not condition (throw (ex-info message {}))))
(let [parent (first (BeamLisp/argv)) owner (generation/open-selected! parent)
      path (str (:path (:root owner)) "/firm/new.fjall") sha (f/sha256 "dynamic nonroot")]
 (require! (= (tuple "65534\n" 0) (System/cmd "id" (list "-u"))) "real service identity required")
 (require! (try (fj/open path) false (catch _ true)) "new stores require admission")
 (require! (not (File/exists? (str (:path (:root owner)) "/firm"))) "read-only creation had effects")
 (generation/admit! owner)
 (let [store (fj/open path) second (fj/open path) bs (blobs/open (str path ".blobs"))]
  (try
   (require! (= {:version 2} (s/-get store (erlang/list_to_binary (list 0 107)))) "fresh store header must be format2")
   (s/-put store "created-by" 65534)
   (require! (= 65534 (s/-get second "created-by")) "same-process claims must share the native engine")
   (b/-blob-put bs sha "dynamic nonroot")
   (require! (= "dynamic nonroot" (b/-blob-get bs sha)) "dynamic blob sibling must work")
   (require! (= 65534 (:uid (File/stat! path))) "new store must belong to the actual writer")
   (require! (= 448 (erlang/band (:mode (File/stat! path)) 511)) "new store must remain private")
   (require! (not (File/exists? (str path "/.bl-datom-create"))) "pending creation marker must retire")
   (println "NONROOT-DYNAMIC-GENERATION-ADMITTED")
   (finally
    (s/close bs) (s/close second) (s/close store)
    ;; This disposable VM lacks DAC override. Return directory traversal to
    ;; its test controller only after checking actual private writer ownership.
    (let [result (System/cmd "python3" (list "-c"
                  "import os,sys; root=sys.argv[1]\nfor directory,children,files in os.walk(root): os.chmod(directory,0o755)"
                  (str (:path (:root owner)) "/firm")))]
     (require! (= 0 (elem result 1)) "synthetic cleanup traversal failed"))))))
