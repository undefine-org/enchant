(ns fixture.generation-nonroot
 (:require [datom.generation :as generation] [datom.offline.fs :as fs]
           [datom.store-fjall :as fj] [datom.store :as s]
           [datom.blob-fs :as blobs] [datom.blob :as b] [datom.file :as f]))
(def spec {:version 1 :application "fixture.app" :key-format 2 :data-version 1
           :stores [{:id "control" :path "control.fjall" :blobs {:kind :fs :path "control.fjall.blobs"}}
                    {:id "library/one" :path "libraries/a.fjall" :blobs {:kind :fs :path "libraries/a.fjall.blobs"}}]
           :files ["config.json"] :directories ["empty"]})
(defn require! [condition message] (when-not condition (throw (ex-info message {}))))
(defn claim! [path]
 (try (fs/claim! path)
  (catch error
   (throw (ex-info (str "Unprivileged claim refused at " path ": "
                    (BeamLisp.Native.Datom.StoreFjall/fjall_directory_open path false false)) {})))))
(println "NONROOT-CANDIDATE" (BeamLisp/argv) (System/cmd "id" (list)))
(let [parent (first (BeamLisp/argv)) app (claim! (str parent "/writer"))
      root (claim! (str parent "/generation")) owner (generation/claim! app root spec)
      store (fj/open (str (:path root) "/control.fjall"))
      bs (blobs/open (str (:path root) "/control.fjall.blobs")) sha (f/sha256 "unprivileged content")]
 (try
  (require! (= (tuple "65534\n" 0) (System/cmd "id" (list "-u"))) "worker must really be nonroot")
  (require! (not (BeamLisp.Native.Datom.StoreFjall/fjall_write_admitted (:handle store))) "candidate starts read-only")
  (require! (try (s/-put store "nonroot" :value) false (catch _ true)) "pre-admission DB write must refuse")
  (require! (try (b/-blob-put bs sha "unprivileged content") false (catch _ true)) "pre-admission blob write must refuse")
  (require! (not (File/exists? (:dir bs))) "read-only open must not create a tier")
  (generation/admit! owner)
  (require! (BeamLisp.Native.Datom.StoreFjall/fjall_write_admitted (:handle store)) "native grant must be visible")
  (s/-put store "nonroot" :value)
  (require! (= :value (s/-get store "nonroot")) "admitted DB writes must work")
  (s/-delete store "nonroot")
  (b/-blob-put bs sha "unprivileged content")
  (require! (= "unprivileged content" (b/-blob-get bs sha)) "admitted lazy blob tier must work")
  (b/-blob-delete bs sha)
  (println "NONROOT-GENERATION-ADMITTED")
  (finally (s/close bs) (s/close store))))
