(ns fixture.generation-boot (:require [datom.generation.boot :as boot]))
(let [[state port] (BeamLisp/argv)]
 (boot/run! {:state-dir state :port (String/to_integer port)
             :data-env "DATOM_BOOTSTRAP_ROOT" :control-id "control" :timeout-ms 60000
             :start-ref "fixture.generation-application/start!"
             :start-options {:port (String/to_integer port)}})
 (Process/sleep :infinity))
