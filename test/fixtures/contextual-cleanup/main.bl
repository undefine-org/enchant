(ns showcase)
(import-world 'control 'current :only [ensuring])
(let [marker 2]
 [(ensuring [resource 40]
    (erlang/+ resource marker)
    (erlang/put :contextual-cleanup-log 100))
  (erlang/get :contextual-cleanup-log)
  (try
   (ensuring [resource 40]
    (erlang/throw resource)
    (erlang/put :contextual-cleanup-log 200))
   (catch error error))
  (erlang/get :contextual-cleanup-log)])
