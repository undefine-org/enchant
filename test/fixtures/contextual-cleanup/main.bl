(ns showcase)
(import-world 'control 'current :only [ensuring])
(import-world 'core 'selected :only [atom deref reset!])
(let [marker 2 log (atom 0)]
 [(ensuring [resource 40]
    (erlang/+ resource marker)
    (reset! log 100))
  (deref log)
  (try
   (ensuring [resource 40]
    (erlang/throw resource)
    (reset! log 200))
   (catch error error))
  (deref log)])
