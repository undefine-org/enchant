(ns control)
(begin-for-syntax
 (defn- binding-pair? [node]
  (if (erlang/== (:tag node) :vector)
   (if (erlang/== (erlang/length (:children node)) 2)
    (let [name (erlang/hd (:children node))]
     (if (erlang/== (:tag name) :symbol)
      (if (erlang/== (:value name) '_) false
       (if (erlang/== (:value name) '&) false true)) false)) false) false)))

(defsyntax ensuring [form context]
 (if (erlang/== (erlang/length (:children form)) 4)
 (let [binding (syntax-arg form 1)]
  (if (binding-pair? binding)
   (syntax-template
    (let [user initial] (try body (finally cleanup)))
    {'user (syntax-arg binding 0) 'initial (syntax-arg binding 1)
     'body (syntax-arg form 2) 'cleanup (syntax-arg form 3)})
   (throw :ensuring-requires-a-binding-pair)))
 (throw :ensuring-arity)))
