(ns unit-instance-observer-fixture)
;; Explicit native test observation, outside Source/SDK authority. One owned
;; Atom records body entry across a bounded child; it grants no execution lease.
(defn reset! [gate]
 (persistent_term/put :unit-instance-observer (atom {:calls 0 :gate gate})))
(defn calls [] (:calls @(persistent_term/get :unit-instance-observer)))
(defn before! []
 (let [cell (persistent_term/get :unit-instance-observer)]
  (swap! cell update :calls inc)
  (when-let [gate (:gate @cell)]
   (erlang/send gate (tuple :factory-entered (erlang/self) (BeamLisp.Env/execution_frame_observation)))
   (receive :finish-factory :ok (after 15000 (erlang/error :factory-gate-timeout))))))
(defn clear! [] (persistent_term/erase :unit-instance-observer))
