(ns forms)

(begin-for-syntax
 (def offset (erlang/+ 1 1)))

(defsyntax computed [form context]
 (syntax-literal offset))

;; The user's binder is intentionally shared with the user's body. The
;; implementation temporary keeps its own definition/introduction scopes.
(defsyntax bind [form context]
 (syntax-template
  (let [tmp initial user tmp] body)
  {'initial (syntax-arg (syntax-arg form 1) 1)
   'user (syntax-arg (syntax-arg form 1) 0)
   'body (syntax-arg form 2)}))
