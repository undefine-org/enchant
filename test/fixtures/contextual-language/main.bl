(ns showcase)

(import-world 'library 'old :as old :only [answer])
(import-world 'library 'new :as new :only [answer])
(import-world 'forms 'current :only [bind computed])

(let [tmp 2 helper (fn [x] 0)]
 [(old/answer tmp)
  (new/answer tmp)
  (bind [answer 40] (erlang/+ answer tmp))
  (erlang/+ 40 (computed))])
