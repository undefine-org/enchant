;; Bare native bootstrap only. Never delete a live lease to manufacture coldness.
(assert (= (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
(ns execution.publication-before-lease)
(let [module :Elixir.BeamLisp.Ns.Body.Core
      original (code/get_object_code module)
      before (erlang/apply module :module_info (list :md5))
      forms (list (tuple :attribute 1 :module module)
                  (tuple :attribute 1 :export (list (tuple :history_changed 0)))
                  (tuple :function 1 :history_changed 0
                    (list (tuple :clause 1 (list) (list) (list (tuple :atom 1 :changed))))))
      changed (compile/forms forms (list :binary :return))]
 (assert (= module (elem original 0)))
 (assert (= :ok (elem changed 0)))
 ;; Exact existing bytes remain a permissible idempotent publication.
 (BeamLisp.Env/publish_binaries! (list (tuple module (elem original 1))) "<history-identical>")
 (assert (= before (erlang/apply module :module_info (list :md5))))
 (assert (= (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
 (let [refusal (try
                (BeamLisp.Env/publish_binaries! (list (tuple module (elem changed 2))) "<history-changed>")
                :unexpected-success
                (catch error (BeamLisp.ExInfo/ex_original error)))]
  (assert (= :sdk_runtime_replacement_requires_handover refusal)))
 (assert (= before (erlang/apply module :module_info (list :md5))))
 (assert (= (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
 (assert (= 42 (BeamLisp.Compiler/eval_string "(+ 20 22)"))))
(println "HISTORY_PUBLICATION_BEFORE_LEASE_READY")
