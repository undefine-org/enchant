(ns execution.cold-cli-fixture)
(deftest first-assertion-does-not-require-the-reload-evolution-solver-graph
 (let [names ["reload" "proc.evolve" "system.smt"]
       loaded (mapv BeamLisp.Env/loaded_ns? names)]
  (println :history-cold-cli {:namespaces names :loaded loaded})
  (is (= [false false false] loaded))
  (println "HISTORY_COLD_CLI_READY")))
