(ns query)

(begin-for-syntax
 (defn- vector-arity? [node arity]
  (if (erlang/== (:tag node) :vector)
   (erlang/== (erlang/length (:children node)) arity)
   false))

 (defn- binding? [node]
  (if (vector-arity? node 2)
   (let [binder (syntax-arg node 0)]
    (if (erlang/== (:tag binder) :symbol)
     (if (erlang/== (:value binder) '_) false
      (if (erlang/== (:value binder) '&) false true))
     false))
   false))

 (defn- clause? [node label]
  (if (vector-arity? node 2)
   (let [head (syntax-arg node 0)]
    (if (erlang/== (:tag head) :keyword)
     (erlang/== (:value head) label)
     false))
   false)))

;; A source-level grammar over existing Reader vectors, not another parser.
;; Validation and helpers exist only at phase one. Runtime code is one native
;; filtermap pass; rows are evaluated once and the user's binder stays scoped
;; with both predicate and projection. Implementation names remain hygienic.
(defsyntax query [form context]
 (if (erlang/== (erlang/length (:children form)) 4)
  (let [binding (syntax-arg form 1)
        where (syntax-arg form 2)
        select (syntax-arg form 3)]
   (if (binding? binding)
    (if (clause? where "where")
     (if (clause? select "select")
      (syntax-template
       (let [input rows
             filtermap (fn filtermap [remaining]
                        (if (erlang/== remaining '()) '()
                         (let [user (erlang/hd remaining)]
                          (if predicate
                           (erlang/++ (erlang/tuple_to_list (erlang/make_tuple 1 projection))
                                      (filtermap (erlang/tl remaining)))
                           (filtermap (erlang/tl remaining))))))]
        (filtermap input))
       {'rows (syntax-arg binding 1)
        'user (syntax-arg binding 0)
        'predicate (syntax-arg where 1)
        'projection (syntax-arg select 1)})
      (throw :query-select-clause))
     (throw :query-where-clause))
    (throw :query-binding)))
  (throw :query-arity)))
