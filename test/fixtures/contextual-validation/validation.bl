(ns validation)
(begin-for-syntax
 (def bias
  (try (erlang/div 1 0) (catch ArithmeticError error 2)))
 (defn- integer-node? [node]
  (if (erlang/== (:tag node) :scalar) (erlang/is_integer (:value node)) false))
 (defn- ratio-binding? [node]
  (if (erlang/== (:tag node) :vector)
   (if (erlang/== (erlang/length (:children node)) 2)
    (if (integer-node? (erlang/hd (:children node)))
     (integer-node? (erlang/hd (erlang/tl (:children node)))) false) false) false))
 ;; A compile-time closure captures the configured bias once. The phase
 ;; archive transports this recipe, never the interpreter's live function.
 (def checked-ratio
  (let [offset bias]
   (fn [numerator denominator fallback]
    (try (erlang/+ (erlang/div numerator denominator) offset)
     (catch ArithmeticError error fallback)
     (finally nil))))))

(defsyntax ratio [form context]
 (if (erlang/== (erlang/length (:children form)) 3)
  (let [pair (syntax-arg form 1) fallback (syntax-arg form 2)]
   (if (ratio-binding? pair)
    (if (integer-node? fallback)
     (syntax-literal
      (checked-ratio (:value (syntax-arg pair 0)) (:value (syntax-arg pair 1)) (:value fallback)))
     (throw :ratio-fallback-must-be-an-integer))
    (throw :ratio-requires-two-integer-literals)))
  (throw :ratio-arity)))
