(ns mailbox)

(begin-for-syntax
 (defn- vector-arity?
  ([node arity] :when (int? arity)
   (if (erlang/== (:tag node) :vector)
    (erlang/== (erlang/length (:children node)) arity)
    false))
  ([node arity] false))

 (defn- reply-binding? [node]
  (if (vector-arity? node 2)
    (let [label (syntax-arg node 0) binder (syntax-arg node 1)]
     (if (erlang/== (:tag label) :keyword)
      (if (erlang/== (:tag binder) :symbol)
       (if (erlang/== (:value binder) '_) false
        (if (erlang/== (:value binder) '&) false true))
       false)
      false))
   false)))

;; The bracket is a small compile-time grammar over the actual Reader. Its
;; binder is deliberately shared with the user's body; implementation names
;; retain definition-site scope. No runtime parser or matcher is installed.
(defsyntax await-reply [form context]
 (if (erlang/== (erlang/length (:children form)) 5)
  (let [binding (syntax-arg form 1)]
   (if (reply-binding? binding)
    (syntax-template
     (let [timeout wait]
      (receive [label user] body (after timeout fallback)))
     {'label (syntax-arg binding 0) 'user (syntax-arg binding 1)
      'body (syntax-arg form 2) 'wait (syntax-arg form 3)
      'fallback (syntax-arg form 4)})
    (throw :mailbox-reply-binding)))
  (throw :mailbox-reply-arity)))
