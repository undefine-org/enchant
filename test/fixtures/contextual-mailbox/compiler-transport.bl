;; Compiler-only transport for lower/eval-anf tests. It supplies an application
;; Source definition, not SDK evidence or Source runtime admission. Raw sends
;; here are deliberately outside the admitted Source path; production uses
;; proc.mailbox's native frame/data checks. Keep runtime claims in separate tests.
(ns proc.mailbox)
(defn context [] :compiler-inbox)
(defn post-self! [value]
 (erlang/send (erlang/self)
  (erlang/setelement 3
   (erlang/setelement 2 (erlang/make_tuple 3 :bl_source_mailbox_data) :compiler-inbox)
   value)))
