(ns showcase)
(import-world 'mailbox 'current :only [await-reply])
(import-world 'proc.mailbox 'selected :only [post-self!])

(let [timeout 2 user 100]
 (do
  ;; Selective receive leaves this unrelated message for the second clause.
  (post-self! [:other 7])
  (post-self! [:answer 40])
  [(await-reply [:answer answer] (erlang/+ answer timeout) 0 :missing)
   (await-reply [:other answer] (erlang/+ answer user) 0 :missing)
   (await-reply [:absent answer] answer 0 99)]))
