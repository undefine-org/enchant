(ns sdk.artifact.java-projection (:require [java.manifest :as j]))

(defmacro projections []
  (list 'quote [(j/static-target "java.lang.Math" "max")
               (j/ctor-target "java.math.BigDecimal")
               (j/method-target "length")
               (j/type-target "java.lang.Long")
               (j/exception-match "java.lang.RuntimeException")
               (j/known-class? "not.a.Class")]))

(defn answers [] (projections))
(defn answer [] (java.lang.Math/max 20 42))
