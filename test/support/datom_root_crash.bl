;; Fixed synthetic fixture entry point for external SIGKILL/power-cut controls.
(ns datom.root-crash-fixture
 (:require [datom.offline.root :as root] [datom.offline.fs :as fs]
           [datom.offline.layout :as l]))
(def spec {:version 1 :application "fixture.app" :key-format 1 :data-version 1
           :stores [{:id "control" :path "control.fjall" :blobs {:kind :fs :path "control.fjall.blobs"}}
                    {:id "library/one" :path "libraries/a.fjall" :blobs {:kind :fs :path "libraries/a.fjall.blobs"}}]
           :files ["config.json"] :directories ["empty"]})
(def parent (System/get_env "DATOM_CRASH_ROOT"))
(def source-runtime (get-in (Jason/decode! (File/read! "test/fixtures/datom/legacy-root-v1.json"))
                     ["producer_receipt" "sdk_descriptor_sha256"]))
(when-let [boundary (System/get_env "DATOM_CRASH_RECOVER")]
 (let [state (try (l/checked-slot (File/read! (str parent "/job/job.etf")))
              (catch error
               (println "DATOM-CRASH-JOURNAL-REFUSAL" (:kind (ex-data error)) (:reason (ex-data error)))
               (throw error)))
       expected (get {"converting" :converting "store-complete" :converting
                      "ready" :verifying "renamed" :publishing} boundary)]
  (when-not (and expected (= expected (:phase state)))
   (throw (ex-info (str "fault injector expected " expected " but found " (:phase state)) {})))
  (when (and (= boundary "store-complete") (empty? (:proofs state)))
   (throw (ex-info "fault injector stopped before store proof was durable" {})))
  (when (and (contains? #{"ready" "renamed"} boundary)
             (not (File/regular? (str parent (if (= boundary "ready") "/job/target" "/generation") "/.bl-generation"))))
   (throw (ex-info "fault injector stopped before protocol publication" {})))))
(def receipt
 (try (root/prepare! (str parent "/original") (str parent "/job") (str parent "/generation")
        source-runtime (l/digest :fixture-release) spec)
  (catch error
   (println "DATOM-CRASH-REFUSAL" (:kind (ex-data error)))
   (throw error))))
(when-not (and (= 2 (get receipt "keyFormat")) (= 2 (count (get receipt "stores"))))
 (throw (ex-info "whole-root crash recovery failed" {})))
(println "DATOM-CRASH-RECOVERED")
