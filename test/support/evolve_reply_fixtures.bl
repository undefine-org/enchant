(ns test.support.evolve-reply-fixtures
 (:require [proc.evolve :as ev] [reload.generation :as g]
           [test.support.evolve-fixtures :as f]))
(defn source [mode]
 (let [map-reply? (contains? #{:map :wrong-downcast :throw-downcast :missing-downcast :new-request} mode)
       vector-reply? (contains? #{:vector :bad-handler} mode)
       request? (contains? #{:old-request :new-request} mode)
       accepts (cond (= :capability mode) "(erlang/is_reference message)"
                     (= :new-request mode) "(and (erlang/is_map message) (erlang/is_atom (maps/get :operation message nil)))"
                     request? "(erlang/is_atom message)" :else "(erlang/is_integer message)")
       check (cond (= :old-request mode) "(if (erlang/=:= request :read) (erlang/is_integer reply) (erlang/=:= true reply))"
                   map-reply? "(and (erlang/is_map reply) (erlang/is_integer (maps/get :value reply nil)))"
                   vector-reply? "(and (vector? reply) (= 1 (count reply)) (erlang/is_integer (first reply)))"
                   (= :capability mode) "true" :else "(erlang/is_integer reply)")
       downcast (cond (= :wrong-downcast mode) "\"wrong\""
                      (= :throw-downcast mode) "(throw (ex-info \"private detail\" {}))"
                      (= :new-request mode) "(if (erlang/=:= request :read) (maps/get :value reply nil) true)"
                      map-reply? "(maps/get :value reply nil)"
                      vector-reply? "{:value (first reply)}" :else "reply")]
  (str "(ns evolution.fixture)
   (defn accepts [message] " accepts ")
   (defn valid-state [value] (erlang/is_integer value))
   (defn migrate [value] value)
   (defn upcast [message] " (if (= :new-request mode) "{:operation message}" "message") ")
   (defn check-reply " (if request? "[reply request]" "[reply]") " " check ")
   (defn downcast " (if (= :new-request mode) "[reply request]" "[reply]") " " downcast ")
   (defn handler [message state] "
    (cond (= :capability mode) "{:reply message :state state}"
          (= :old-request mode) "{:reply (if (erlang/=:= message :read) state true) :state (if (erlang/=:= message :read) state (inc state))}"
          (= :new-request mode) "{:reply {:value state} :state (if (erlang/=:= (maps/get :operation message nil) :read) state (inc state))}"
          :else (str "{:reply " (cond (= :bad-handler mode) "\"wrong\"" vector-reply? "[message]" map-reply? "{:value message}" :else "message") " :state (+ message state)}")) ")
   (defn spec [version digest]
    {:version version :digest digest :accept? accepts :check-state valid-state :handler handler
     :migrate-state migrate :upcast upcast :check-reply " (if (= :capability mode) "nil" "check-reply")
     " :downcast " (if (= :missing-downcast mode) "nil" "downcast") "})")))
(defn spec [graph version] (f/spec graph version))
(defn upgrade! [graph p expected version]
 (g/with! graph #(ev/upgrade! p expected (spec graph version))))
(defn with-owner
 ([app modes action] (with-owner app modes {} action))
 ([app modes opts action]
  (f/with-owner app (mapv source modes) 0 (merge {:managed true :message-domain :bounded-first-order} opts) action)))
