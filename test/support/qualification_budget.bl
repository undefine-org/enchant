; One qualification policy for whole-file and exact-selector executors.
; Observations never reset native admission/retirement policy or grant custody.
(ns test.support.qualification-budget)

(defn usage []
 (erlang/apply :persistent_term :get (list :bl_sealed_generation_budget {})))

(defn handover-reason []
 ;; Retiring graphs does not replenish node-lifetime atoms or compact native
 ;; outcome records. Leave room for the next file and its real children.
 (let [used (usage)]
  (cond
   (or (>= (get used :preparations 0) 128) (>= (get used :namespaces 0) 2048)
       (>= (get used :source-bytes 0) 67108864)
       (>= (erlang/memory :total) 3221225472)) :native-lifetime-budget
   (not (try (= :public (BeamLisp.Loader/with_declaration_snapshot
                         #(BeamLisp.AOT/sdk_declaration_kind "datom" "connect")))
              (catch _ false))) :sdk-declaration-state
   :else nil)))
