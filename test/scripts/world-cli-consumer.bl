(ns contextual.world.cli.consumer)

(let [output (System/fetch_env! "BL_WORLD_OUTPUT")
      bytes (File/read! (Path/join output "program.beam"))
      expected (System/fetch_env! "BL_WORLD_BEAM_SHA256")
      module :Elixir.BeamLisp.World.Program]
 (assert (= false (File/exists? "test")))
 (assert (= expected (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower)))))
 (assert (= false (erlang/module_loaded module)))
 (assert (= (tuple :module module) (code/load_binary module (list) bytes)))
 (let [value (erlang/apply module :run (list))
       attrs (erlang/apply module :module_info (list :attributes))]
  (assert (= [42 99 42] value))
  (assert (Keyword/has_key? attrs :bl_contextual_bindings))
  (File/write! (Path/join output "consumer.json")
   (Jason/encode! {:status "passed" :value (to-list value) :project-sources-present false
                  :binding-attribute-present true :native-admission false}))
  (println "WORLD-CONSUMER" (pr-str value))))
