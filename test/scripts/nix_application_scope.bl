;; Exercise normal frontend composition under output custody. The initial
;; generation is a real verified fixture product, selected through the same API.
(ns application.scope-control
  (:require [application-product :as product] [claim :as claim]))
(let [root (System/fetch_env! "BL_SCOPE_SOURCE")
      out (System/fetch_env! "BL_SCOPE_OUTPUT")
      base (System/fetch_env! "BL_SCOPE_BASE")
      descriptor (Jason/decode! (File/read! (str base "/artifact.json")))
      options {:root root :out out :sources [(str root "/src/artifact/demo/values.bl")]
               :scope :scoped :jobs 1}]
  (claim/with-writer! out "scope control initial selection"
    (fn []
      (product/select! {:output base :sdk (get descriptor "sdk") :source (get descriptor "source")} out)
      (File/ln_s! base (str out "/.nix-product"))))
  (File/write! (str out "/foreign.txt") "unrelated output")
  (let [updated (product/build! options)]
    (println "SCOPED-RESULT" (pr-str (:errors updated)))
    (assert (empty? (:errors updated)))
    (assert (= 4 (get-in updated [:receipt :request "version"])))
    (assert (= "scoped" (get-in updated [:receipt :request "scope"])))
    (assert (= base (get-in updated [:receipt :request "base"])))
    (assert (= [] (get-in updated [:receipt :request "nativeProducts"])))
    (assert (= 2 (count (:manifest updated))))
    (assert (= 2 (count (:artifact-units updated))))
    (assert (= (tuple :ok (:product updated)) (File/read_link (str out "/.nix-product"))))
    (let [empty-result (product/build! (assoc options :sources []))]
      (assert (empty? (:errors empty-result)))
      (assert (= 2 (count (:manifest empty-result))))
      (assert (= 2 (count (:artifact-units empty-result))))))
  (let [full (product/build! (assoc options :scope :full))]
    (assert (empty? (:errors full)))
    (assert (= 1 (count (:manifest full))))
    (assert (= 1 (count (:artifact-units full))))
    (assert (not (File/exists? (str out "/units/artifact.demo.consumer"))))
    (assert (= "unrelated output" (File/read! (str out "/foreign.txt"))))
    (let [bad (product/build! (assoc options :scope :typo))]
      (assert (= 1 (count (:errors bad))))
      (assert (= (tuple :ok (:product full)) (File/read_link (str out "/.nix-product"))))))
  (let [path (first (:sources options)) original (File/read! path)
        before (File/read_link (str out "/.nix-product"))]
    (try
      (File/write! path "(ns artifact.demo.values) (def broken")
      (let [failed (product/build! options)]
        (assert (seq (:errors failed)))
        (assert (= before (File/read_link (str out "/.nix-product"))))
        (assert (= "unrelated output" (File/read! (str out "/foreign.txt")))))
      (finally (File/write! path original))))
  (assert (not (claim/owned? out)))
  (println "APPLICATION-SCOPE-PUBLICATION passed"))
