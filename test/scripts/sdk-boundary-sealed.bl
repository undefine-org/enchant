(ns sdk.boundary.sealed (:require [bl.cli :as cli]))
;; These tests have a Source fallback. Require an actual producer-sealed image
;; and actual inventory membership for both roots before invoking the CLI.
(let [root (BeamLisp.Tiers/priv_root)
      source (System/fetch_env! "BL_SDK_BOUNDARY_ROOT")
      inventory (BeamLisp.AOT/inventory_term (Path/join root "sdk-code.term"))
      tests ["test/bl/sdk_loading_batch_test.bl"]]
 (assert (File/regular? (Path/join root "std/bl/check.bl.md")))
 (doseq [namespace ["data.bounded-cache" "bl.check" "bl.cli" "bl.test" "reload.ward"]]
  (assert (contains? inventory (Atom/to_string (BeamLisp.Emit/module_for namespace)))))
 (assert (= 0 (cli/run-argv (into ["test"] (map #(Path/join source %) tests)))))
 (File/write! (Path/join (System/fetch_env! "BL_SDK_ARTIFACT_OUT") "sealed-source-consumers.json")
  (Jason/encode! {:status "passed" :actual-image true :source-present true :files (BeamLisp.Vector/to_list tests)})))
