(ns standalone.runtime.producer (:require [compile.world :as world]))
(let [output (System/fetch_env! "BL_RUNTIME_IMAGE_OUT")
      pair (Path/join output "paired")]
 (BeamLisp.AOT/emit_unit
  (world/prepare-unit (world/prepare (System/fetch_env! "BL_RUNTIME_IMAGE_WORLD")) :Elixir.StandaloneRuntime.Program) pair)
 (world/package-runtime! pair (Path/join output "program"))
 ;; A real foreign binary is a negative publication proposal, not an SDK
 ;; artifact. It carries no fabricated origin, declaration or admission data.
 (let [module :Elixir.BeamLisp.Ns.Body.Rt
       forms (list (tuple :attribute 1 :module module)
                   (tuple :attribute 1 :export (list (tuple :runtime_replacement_probe 0)))
                   (tuple :function 1 :runtime_replacement_probe 0
                    (list (tuple :clause 1 (list) (list) (list (tuple :atom 1 :foreign_runtime_body))))))
       compiled (erlang/apply :compile :forms (list forms (list :binary :return_errors)))]
  (assert (= :ok (elem compiled 0)))
  (File/write! (Path/join output "runtime-replacement.beam") (elem compiled 2)))
 (let [fixtures (Path/dirname (Path/dirname (System/fetch_env! "BL_RUNTIME_IMAGE_WORLD")))
       showcases (Path/join output "showcases")]
  (File/mkdir! showcases)
  (doseq [name ["language" "query" "mailbox" "cleanup"]]
   (let [pair (Path/join output (str name "-paired"))
         manifest (Path/join fixtures (str "contextual-" name "/world.bl"))
         module (Module/concat :Elixir.StandaloneRuntime.Showcase (Macro/camelize name))]
    (BeamLisp.AOT/emit_unit (world/prepare-unit (world/prepare manifest) module) pair)
    (world/package-runtime! pair (Path/join showcases name)))))
 (println "STANDALONE-PRODUCER passed"))
