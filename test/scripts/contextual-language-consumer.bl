(ns contextual.language.consumer)

(let [output (System/fetch_env! "BL_CONTEXTUAL_OUTPUT")
      receipt (Jason/decode! (File/read! (Path/join output "producer.json")))
      spec (Jason/decode! (System/fetch_env! "BL_CONTEXTUAL_SPEC"))
      bytes (File/read! (Path/join output "showcase.beam"))
      module :Elixir.Contextual.Showcase]
 (assert (= :error (System/fetch_env "BL_CONTEXTUAL_SOURCES")))
 (assert (= (get receipt "beam-sha256")
            (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower)))))
 (assert (= (tuple :module module) (code/load_binary module '() bytes)))
 (let [value (erlang/apply module :run (list))
       attrs (erlang/apply module :module_info (list :attributes))]
  (assert (= (get spec "expected") (to-list value)))
  (assert (if (= "vector" (get spec "result-kind")) (vector? value) (erlang/is_list value)))
  (assert (Keyword/has_key? attrs :bl_contextual_bindings))
  (File/write! (Path/join output "consumer.json")
   (Jason/encode! {:status "passed" :value (to-list value) :sources-present false
                  :binding-attribute-present true :native-admission false}))
  (when (= "yes" (System/get_env "BL_CONTEXTUAL_ARTIFACT_UNIT"))
   (let [package (Path/join output "runtime")]
    (assert (= (list "unit-import.beam" "unit-program.beam") (sort (File/ls! package))))
    (assert (not (erlang/module_loaded :Elixir.Contextual.UnitShowcase.PhaseLibrary)))
    (doseq [[target file] [[:Elixir.Contextual.UnitShowcase "unit-program.beam"]
                          [:Elixir.Contextual.UnitImport "unit-import.beam"]]]
     (assert (= (tuple :module target) (code/load_binary target '() (File/read! (Path/join package file)))))
     (assert (= (get spec "expected") (to-list (erlang/apply target :run (list))))))
    (assert (not (erlang/module_loaded :Elixir.Contextual.UnitShowcase.PhaseLibrary)))
    (File/write! (Path/join output "unit-consumer.json")
     (Jason/encode! {:status "passed" :runtime-members 2 :phase-provider-present false
                    :provider-loaded false :fresh-import-and-original-program true}))))
  (println "CONTEXTUAL-CONSUMER" (pr-str value))))
