(ns release.negative-control (:require [artifact :as artifact]))
(let [out (System/fetch_env! "BL_RELEASE_CONTROL_OUT")
      _ (File/write! out "previous release")
      refused (try
                (artifact/publish-release! (System/fetch_env! "BL_RELEASE_CONTROL_SDK") out)
                false
                (catch error
                  (assert (= :artifact-refused (:kind (ex-data error))))
                  (assert (String/contains? (ex-message error) "does not retain a managed Nix release"))
                  true))]
  (assert refused)
  (assert (= "previous release" (File/read! out)))
  (println "RELEASE REFUSAL PRESERVES DESTINATION"))
