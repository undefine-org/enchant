(ns application.world-publication-control
  (:require [application-product :as product] [claim :as claim]))
(let [out (System/fetch_env! "BL_WORLD_CONTROL_OUTPUT")
      receipt {:output (System/fetch_env! "BL_WORLD_CONTROL_PRODUCT")
               :sdk (System/fetch_env! "BL_WORLD_CONTROL_SDK")
               :source (System/fetch_env! "BL_WORLD_CONTROL_SOURCE")}]
  (claim/with-writer! out "World publication control"
    (fn []
      (let [selected (product/select! receipt out)]
        (assert (empty? (:units selected)))
        (assert (= (str (:output receipt) "/ebin/artifact-unit") (:world-unit selected)))
        (assert (= (tuple :ok (:world-unit selected)) (File/read_link (str out "/artifact-unit"))))
        (assert (= [42 102 42 42]
          (BeamLisp.Loader/run_artifact_unit (str out "/artifact-unit") (list)))))))
  (assert (not (claim/owned? out)))
  (println "WORLD-PUBLICATION passed"))
