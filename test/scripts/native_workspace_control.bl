(ns native.workspace-control (:require [artifact :as artifact] [artifact-jobs :as jobs]))
(let [receipt (Jason/decode! (File/read! (System/get_env "BL_NIX_ARTIFACT_TEST_RECEIPT")))
      request (get receipt "request") output (get receipt "output")
      result (artifact/verify! output request)]
  (assert (= (get receipt "library") (:library result)))
  (doseq [bad [(assoc request "abi" "wrong") (assoc request "member" "../escape")
               (assoc request "package" "wrong") (assoc request "command" "cargo build")]]
    (assert (try (artifact/verify! output bad) false (catch _ true))))
  (println "NATIVE-WORKSPACE Source verifier and artifact-jobs reader passed"))
