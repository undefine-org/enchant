(ns sdk.projection-control (:require [application-product :as product] [claim :as claim]))
(let [sdk (System/fetch_env! "BL_SDK_CONTROL_PRODUCT")
      out (System/fetch_env! "BL_SDK_CONTROL_OUTPUT")
      options {:out out}
      first (product/select-sdk! sdk options)
      second (product/select-sdk! sdk options)]
  (assert (= 1 (:built first))) (assert (= 0 (:built second)))
  (assert (= 1 (:cached second)))
  (assert (= (tuple :ok sdk) (File/read_link (str out "/.nix-sdk"))))
  (assert (not (claim/owned? out)))
  (assert (File/regular? (str out "/image/ebin/beam_lisp.app")))
  (File/write! (str out "/sentinel") "unrelated")
  (assert (= "unrelated" (File/read! (str out "/sentinel"))))
  (println "SDK PROJECTION AND REUSE PASSED"))
