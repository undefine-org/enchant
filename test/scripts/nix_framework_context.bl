;; Project overlays are command data; infrastructure is selected at startup.
(ns framework.context-control
  (:require [artifact :as artifact] [artifact-process :as process]
            [application-product :as product] [build :as build] [vm.osenv :as osenv]))
(let [before (artifact/framework-context)
      tools (into {} (Enum/map ["nix" "systemd-run" "setsid" "kill"]
                       (fn [name] [name (process/tool name)])))
      out (System/fetch_env! "BL_CONTEXT_OUTPUT")
      source (System/fetch_env! "BL_CONTEXT_SOURCE")
      native (get-in (Jason/decode! (File/read! (str (:natives before) "/artifacts.json")))
                     ["products" "lazy_memo"])
      native-root (str out "/native-project")]
  (File/mkdir_p! (str native-root "/native"))
  (File/cp_r! (get native "source") (str native-root "/native/lazy_memo"))
  (osenv/with-env
    {"BL_ARTIFACT_PLATFORM" "/project/fake" "BL_SDK_PRODUCT" "/project/fake"
     "BL_PREPARED_NATIVES" "/project/fake" "BL_ARTIFACT_TOOL_PATH" "/project/fake"
     "FOUNDRY_TOOL_PATH" "/project/fake" "BL_NATIVE_PROVIDER" "local"
     "XDG_RUNTIME_DIR" "/project/fake" "DBUS_SESSION_BUS_ADDRESS" "unix:path=/project/fake"
     "HOME" "/project/fake" "XDG_CACHE_HOME" "/project/fake" "BL_INTERNAL_PRODUCER" "0"}
    (fn []
      (assert (= "/project/fake" (System/get_env "BL_ARTIFACT_PLATFORM")))
      (assert (= before (artifact/framework-context)))
      (doseq [[name executable] tools]
        (assert (= executable (process/tool name)))
        (assert (string? executable)))
      (let [native-result (build/build-native-crate native-root "lazy_memo" nil)]
        (assert (empty? (:errors native-result)))
        (assert (= (tuple :ok (str (get native "output") "/lib/lazy_memo.so"))
                   (File/read_link (str native-root "/priv/native/lazy_memo.so")))))
      (let [result (product/build! {:root source :out (str out "/application") :jobs 1
                     :sources [(str source "/src/artifact/demo/values.bl")
                               (str source "/src/artifact/demo/consumer.bl")]})
            cache (or (:cache before) (str (:home before) "/.cache"))]
        (println "CONTEXT-BUILD" (pr-str (:errors result)))
        (assert (empty? (:errors result)))
        (assert (String/starts_with? (get-in result [:receipt :retention-root]) (str cache "/beam_lisp/artifacts/"))))))
  (println "PINNED-FRAMEWORK-ENVIRONMENT passed"))
