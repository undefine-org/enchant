(ns runtime.release.native.control (:require [release :as release]))

(let [library (Path/join (BeamLisp.Tiers/priv_root) "native/lazy_memo.so")
      saved (str library ".selected")
      selected (BeamLisp.LazyMemo/runtime_identity!)
      output (System/fetch_env! "BL_RUNTIME_RELEASE_CONTROL_OUT")]
 ;; The producer keeps executing its actual loaded native implementation.
 ;; Only the file the release assembler will capture changes.
 (File/rename! library saved)
 (try
  (File/cp! (System/fetch_env! "BL_RUNTIME_NATIVE_CONTROL") library)
  (assert (= selected (BeamLisp.LazyMemo/runtime_identity!)))
  (let [kind (try
              (release/assemble-runtime! (System/fetch_env! "BL_RUNTIME_RELEASE_CONTROL_UNIT") output)
              :unexpected-success
              (catch error (:kind (ex-data error))))]
   (assert (= :runtime-release-target-changed kind))
   (assert (not (File/exists? (Path/join output "runtime-image.term")))))
  (assert (not (File/exists? output)))
  (println "RUNTIME-RELEASE changed-native-file-refused-before-publication=true")
  (finally (File/rm! library) (File/rename! saved library))))
