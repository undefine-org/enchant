(ns artifact.replay-control (:require [artifact.replay :as replay]))
(def sdk "/nix/store/rmg3sc8npk0bkxg7ihbq34hm18axlpam-bl-drop-0.1.0-sdk")
(def product "/nix/store/zqfq6dg724lj6klc9c2f7x5m3mr97mds-beam-lisp-application")
(def source "/nix/store/7hlcin1c5gvy346cz0q63hahnyfpzcyi-source")
(def runtime {"compiler" (String/duplicate "a" 64) "build" (String/duplicate "b" 64) "loadedNative" (String/duplicate "c" 64)})
(def options {:sdk sdk :product product :source source :tests ["test/scripts/artifact-generation.bl"] :inputs ["env.bl"] :runtime runtime})
(let [capsule (replay/capture! options)
      plan (replay/plan! capsule {:sdk sdk :runtime runtime :tools []})]
  (assert (= capsule (replay/validate capsule)))
  (assert (= ["test" (str source "/test/scripts/artifact-generation.bl")] (get capsule "argv")))
  (assert (= (get capsule "argv") (get plan "argv")))
  (assert (try (replay/validate (assoc capsule "argv" ["eval" "anything"])) false (catch _ true)))
  (assert (try (replay/validate (assoc capsule "env" {"SECRET" "value"})) false (catch _ true)))
  (assert (try (replay/validate (assoc capsule "outcome" false)) false (catch _ true)))
  (assert (try (replay/plan! capsule {:sdk sdk :runtime (assoc runtime "build" (String/duplicate "d" 64)) :tools []}) false (catch _ true))))
(doseq [tests [[] ["../escape.bl"] ["test/scripts/artifact-generation.bl" "test/scripts/artifact-generation.bl"]]]
  (assert (try (replay/capture! (assoc options :tests tests)) false (catch _ true))))
(println "ARTIFACT-REPLAY passed: immutable capture and admission data; no execution")
