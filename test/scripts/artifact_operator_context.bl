(ns operator.context-control (:require [artifact :as artifact] [vm.osenv :as osenv]))
(let [before (artifact/framework-context)]
  (osenv/with-env {"BL_ARTIFACT_PLATFORM" "/project/fake" "BL_SDK_PRODUCT" "/project/fake" "BL_INTERNAL_PRODUCER" "project-value"}
    (fn []
      (assert (= "/project/fake" (System/get_env "BL_SDK_PRODUCT")))
      (assert (= "project-value" (System/get_env "BL_INTERNAL_PRODUCER")))
      (assert (= before (artifact/framework-context)))))
  (println "PINNED FRAMEWORK CONTEXT PASSED"))
