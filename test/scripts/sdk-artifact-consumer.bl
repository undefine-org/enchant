(ns sdk.artifact.consumer.proof)

(let [output (System/fetch_env! "BL_SDK_ARTIFACT_OUT")
      tampered? (= "yes" (System/get_env "BL_SDK_ARTIFACT_TAMPER"))
      expected (Integer/parse (or (System/get_env "BL_SDK_ARTIFACT_EXPECTED") "52"))]
 (assert (File/regular? (Path/join (BeamLisp.Tiers/priv_root) "sdk-code.term")))
 (assert (not (BeamLisp.Env/loaded_ns? "sdk.artifact.consumer")))
 (if tampered?
  (let [reason (try (BeamLisp.Loader/ensure_loaded "sdk.artifact.consumer") :unexpected
                   (catch error (:original error)))]
   (assert (= :sdk_runtime_artifact_changed reason))
   (assert (not (BeamLisp.Env/loaded_ns? "sdk.artifact.consumer")))
   (println "SDK-ARTIFACT-TAMPER refused-before-initialization=true"))
  (do
   (assert (= 1 (erlang/trace_pattern (tuple :Elixir.BeamLisp.AOT :compile_file 2) true (list :local :call_count))))
   (BeamLisp.Loader/ensure_loaded "sdk.artifact.consumer")
   (assert (BeamLisp.AOT/sdk_unit_compiled? "sdk.artifact.consumer"))
   (let [value (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "sdk.artifact.consumer" "answer") (list))
         count (elem (erlang/trace_info (tuple :Elixir.BeamLisp.AOT :compile_file 2) :call_count) 1)]
    (assert (= (elem expected 0) value))
    (assert (= 0 count))
    (erlang/trace_pattern (tuple :Elixir.BeamLisp.AOT :compile_file 2) false (list :local :call_count))
    (BeamLisp.Loader/ensure_loaded "proc.owner-registry")
    (let [module (BeamLisp.Env/fetch! "proc.owner-registry" "registry") proof (BeamLisp.Env/prepare_sdk_class! module)]
     (assert (= module (:module proof)))
     (assert (= true (:image? proof))))
    (File/write! (Path/join output "consumer.json")
      (Jason/encode! {:status "passed" :answer value :legacy-compiles count :actual-sealed-image true :class-image-proof true})))
   (println "SDK-ARTIFACT-CONSUMER passed legacy-compiles=0 class-image-proof=true"))))
