(ns sdk.artifact.consumer.proof)

(let [output (System/fetch_env! "BL_SDK_ARTIFACT_OUT")
      tampered? (= "yes" (System/get_env "BL_SDK_ARTIFACT_TAMPER"))
      missing? (= "yes" (System/get_env "BL_SDK_ARTIFACT_MISSING"))
      expected (Integer/parse (or (System/get_env "BL_SDK_ARTIFACT_EXPECTED") "52"))]
 (assert (File/regular? (Path/join (BeamLisp.Tiers/priv_root) "sdk-code.term")))
 (assert (not (BeamLisp.Env/loaded_ns? "sdk.artifact.consumer")))
 (when (= "yes" (System/get_env "BL_SDK_ARTIFACT_SOURCE_FREE"))
  (let [root (BeamLisp.Tiers/priv_root) manifest (BeamLisp.Bootstrap/manifest)]
   (assert (= [] (vec (Path/wildcard (Path/join root "**/*.bl")))))
   (assert (= [] (vec (Path/wildcard (Path/join root "**/*.bl.md")))))
   (assert (= (get manifest "compiler_key") (BeamLisp.AOTCache/compiler_key)))
   (assert (= (get manifest "build_key") (BeamLisp.AOTCache/build_key)))
   (assert (= (get manifest "compiler_key") (BeamLisp.AOTCache/current_compiler_key)))
   (assert (= (get manifest "build_key") (BeamLisp.AOTCache/current_build_key)))))
 (when missing?
  (let [path (Path/join (BeamLisp.Tiers/priv_root) "sdk-code.term")
        inventory (erlang/binary_to_term (File/read! path) (list :safe))]
   ;; Denial control only: retain every artifact byte, remove its ownership row.
   (File/write! path (erlang/term_to_binary
     (update inventory :modules dissoc "Elixir.BeamLisp.Ns.Sdk.Artifact.Consumer")))))
 (if (or tampered? missing?)
  (let [reason (try (BeamLisp.Loader/ensure_loaded "sdk.artifact.consumer") :unexpected
                   (catch error (:original error)))]
   (println "SDK-ARTIFACT-REFUSAL-REASON" (pr-str reason))
   (assert (= (if missing? (tuple :sdk_image_unit_missing "sdk.artifact.consumer")
                       (if (= "yes" (System/get_env "BL_SDK_ARTIFACT_SOURCE_FREE"))
                         :sdk_image_preload_artifact_changed :sdk_runtime_artifact_changed)) reason))
   (assert (not (BeamLisp.Env/loaded_ns? "sdk.artifact.consumer")))

   (println "SDK-ARTIFACT-REFUSAL before-initialization=true"))
  (do
   (assert (= 1 (erlang/trace_pattern (tuple :Elixir.BeamLisp.AOT :compile_file 2) true (list :local :call_count))))
   (BeamLisp.Loader/ensure_loaded "sdk.artifact.consumer")
   (assert (BeamLisp.AOT/sdk_unit_compiled? "sdk.artifact.consumer"))
   (let [value (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "sdk.artifact.consumer" "answer") (list))
         count (elem (erlang/trace_info (tuple :Elixir.BeamLisp.AOT :compile_file 2) :call_count) 1)]
    (assert (= (elem expected 0) value))
    (assert (= 0 count))
    (when (BeamLisp.AOT/sdk_unit_compiled? "sdk.artifact.java-projection")
      (BeamLisp.Loader/ensure_loaded "sdk.artifact.java-projection")
      (assert (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "sdk.artifact.java-projection" "answer") (list))))
      (assert (= [[:fn "core" "max"] [:fn "decimal" "of"] [:fn "core" "count"] [:lit :integer] :any false]
        (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "sdk.artifact.java-projection" "answers") (list)))))
    (when (= "yes" (System/get_env "BL_SDK_ARTIFACT_SOURCE_FREE"))
     ;; Compile a new project expression with the packaged macro provider.
     ;; This is new user Source; no SDK Source or precompiled answer is supplied.
     (assert (= (elem expected 0)
       (BeamLisp/eval "(ns sdk.artifact.fresh-project (:require [sdk.artifact.provider :as provider])) (+ 2 (provider/forty))"))))
    (erlang/trace_pattern (tuple :Elixir.BeamLisp.AOT :compile_file 2) false (list :local :call_count))
    (BeamLisp.Loader/ensure_loaded "proc.owner-registry")
    (let [module (BeamLisp.Env/fetch! "proc.owner-registry" "registry") proof (BeamLisp.Env/prepare_sdk_class! module)]
     (assert (= module (:module proof)))
     (assert (= true (:image? proof))))
    (File/write! (Path/join output "consumer.json")
      (Jason/encode! {:status "passed" :answer value :legacy-compiles count :actual-sealed-image true :class-image-proof true
                     :packaged-macro-new-project (= "yes" (System/get_env "BL_SDK_ARTIFACT_SOURCE_FREE"))
                     :sdk-source-absent (= "yes" (System/get_env "BL_SDK_ARTIFACT_SOURCE_FREE"))})))
   (println "SDK-ARTIFACT-CONSUMER passed legacy-compiles=0 class-image-proof=true"))))
