(ns artifact.impact-control (:require [artifact.impact :as impact]))
(defn receipt [output rows]
  {:output output :sdk "/unfollowed/sdk" :source "/unfollowed/source"
   :result {:built 1 :cached 0 :errors [] :impact rows}})
(defn node [name content key requires]
  {:namespace name :path (str "src/" name ".bl") :content content :interface "stable" :key key :requires requires})
(let [a (node "a" "old" "a-old" []) b (node "b" "same" "b-stable" ["a"])
      left (receipt "/unfollowed/A" [a b])
      right (receipt "/unfollowed/B" [(assoc a :content "new" :key "a-new") b])
      report (impact/explain left right)
      candidate (first (get report "dependency-impact-candidates"))]
  (assert (= 1 (get-in report ["summary" "changed"])))
  (assert (= 1 (get-in report ["summary" "same-recorded-facts"])))
  (assert (= "b" (get candidate "namespace")))
  (assert (= "a" (get candidate "cause")))
  (assert (= "same" (get candidate "recorded-closure-key-status")))
  (assert (= "not-established" (get candidate "rebuild")))
  (assert (= report (impact/explain (receipt "/unfollowed/A" [b a])
                    (receipt "/unfollowed/B" [b (assoc a :content "new" :key "a-new")])))))
(let [world (impact/explain (receipt "/A" nil) (receipt "/B" []))]
  (assert (= false (get-in world ["coverage" "comparable-namespace-graphs"])))
  (assert (nil? (get world "summary"))))
(let [cycle [(node "a" "same" "a" ["b"]) (node "b" "old" "b" ["a"])]]
  (assert (= 1 (count (get (impact/explain (receipt "/A" cycle)
                          (receipt "/B" [(first cycle) (assoc (second cycle) :content "new")]))
                           "dependency-impact-candidates")))))
(doseq [[left right] [[nil nil] [42 {}] [(receipt "/A" []) {}]
                     [(receipt "/A" [(node "a" "x" "y" []) (node "a" "x" "y" [])]) (receipt "/B" [])]]]
  (assert (try (impact/explain left right) false (catch _ true))))
(println "ARTIFACT-IMPACT passed")
