;; Real preparation control for the two-file artifact-production fixture.
(ns application.prepare-control (:require [artifact :as artifact]))
(let [receipt (artifact/prepare-application!
                {:sdk (System/fetch_env! "BL_APPLICATION_CONTROL_SDK")
                 :source (System/fetch_env! "BL_APPLICATION_CONTROL_SOURCE")
                 :roots ["env.bl" "src"]
                 :sources ["src/artifact/demo/consumer.bl" "src/artifact/demo/values.bl"]
                 :jobs 4 :timeout-ms 120000})]
  (assert (= 2 (get (:result receipt) "built")))
  (assert (= 2 (count (get (:result receipt) "units"))))
  (File/write! (System/fetch_env! "BL_APPLICATION_CONTROL_RESULT") (Jason/encode! receipt))
  (println (str "APPLICATION-API " (:output receipt))))
