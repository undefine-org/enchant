(ns contextual.language.recompiler
 (:require [expand :as x] [anf :as anf] [lower :as lower]
           [codebase.phase :as code] [system.phase :as phase] [bl.world :as world]))

(let [output (System/fetch_env! "BL_CONTEXTUAL_OUTPUT")
      _ (assert (= :error (System/fetch_env "BL_CONTEXTUAL_SOURCES")))
      library (x/decode-phase-library (File/read! (Path/join output "phase-library.term")))
      program (x/program [{:namespace 'showcase :revision 'current :file "main.bl"
                           :source (File/read! (Path/join output "main.source"))}]
                         ['showcase 'current] [library])
      facts (code/facts program)
      bindings {:version 1 :profile 'syntax-v1 :snapshot (:snapshot facts)
                :references (:references program) :expansions (:expansions program)}
      descriptor (anf/module :Elixir.Contextual.Showcase
                   (list {:op :defn-clause :fname :run :params (list) :guard nil :body (:node program) :ann {}})
                   (list [:run 0]) (list [:bl_contextual_bindings (erlang/term_to_binary bindings (list :deterministic))]))
      bytes (elem (lower/descriptor->beam descriptor {}) 1)]
 (assert (= :proved (:status (phase/check program))))
 (assert (= (File/read! (Path/join output "showcase.beam")) bytes))
 (assert (= false (erlang/module_loaded :Elixir.Contextual.Showcase)))
 (File/write! (Path/join output "recompiler.json")
  (Jason/encode! {:status "passed" :provider-source-text false :byte-identical true
                 :native-admission false :target-loaded false}))
 (when (= "yes" (System/get_env "BL_CONTEXTUAL_ARTIFACT_UNIT"))
  (let [verified (world/read-unit (Path/join output "artifact-unit"))
        source (String/replace (File/read! (Path/join output "main.source"))
                 "(ns showcase)" "(ns artifactconsumer)")
        imported (x/program [{:namespace 'artifactconsumer :revision 'current :file "unit-consumer.bl" :source source}]
                    ['artifactconsumer 'current] [(:phase-library verified)])
        descriptor (anf/module :Elixir.Contextual.UnitImport
                     (list {:op :defn-clause :fname :run :params (list) :guard nil :body (:node imported) :ann {}})
                     (list [:run 0]) (list))]
   (assert (= :proved (:status (phase/check imported))))
   (assert (not (erlang/module_loaded :Elixir.Contextual.UnitShowcase.PhaseLibrary)))
   (File/write! (Path/join output "runtime/unit-import.beam") (elem (lower/descriptor->beam descriptor {}) 1))
   (File/write! (Path/join output "unit-recompiler.json")
    (Jason/encode! {:status "passed" :provider-source-present false :provider-loaded false
                   :phase-companion-decoded true :native-admission false}))))
 (println "CONTEXTUAL-RECOMPILER byte-identical without provider source"))
