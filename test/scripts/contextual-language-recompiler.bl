(ns contextual.language.recompiler
 (:require [expand :as x] [anf :as anf] [lower :as lower]
           [system.phase :as phase] [bl.world :as world] [compiler :as compiler]))

(let [output (System/fetch_env! "BL_CONTEXTUAL_OUTPUT")
      _ (assert (= :error (System/fetch_env "BL_CONTEXTUAL_SOURCES")))
      prepared (world/prepare (Path/join output "world.bl"))
      program (:program prepared)
      bytes (elem (world/artifact prepared :Elixir.Contextual.Showcase) 1)]
 (assert (= :proved (get-in prepared [:phase :status])))
 (assert (= (File/read! (Path/join output "showcase.beam")) bytes))
 (assert (= false (erlang/module_loaded :Elixir.Contextual.Showcase)))
 (File/write! (Path/join output "recompiler.json")
  (Jason/encode! {:status "passed" :provider-source-text false :byte-identical true
                 :native-admission false :target-loaded false}))
 (when (= "yes" (System/get_env "BL_CONTEXTUAL_ARTIFACT_UNIT"))
  (let [verified (world/read-unit (Path/join output "artifact-unit"))
        source (String/replace (File/read! (Path/join output "main.source"))
                 "(ns showcase)" "(ns artifactconsumer)")
        source-path (Path/join output "unit-consumer.bl")
        library-path (Path/join output "unit-import.phase")
        manifest-path (Path/join output "unit-consumer-world.bl")]
   (File/write! source-path source)
   (File/write! library-path (x/encode-phase-library (:phase-library verified)))
   (File/write! manifest-path
    (str "'" (pr-str {:version 1 :profile 'syntax-v1 :entry ['artifactconsumer 'current]
                       :sources [{:namespace 'artifactconsumer :revision 'current :file "unit-consumer.bl"}]
                       :libraries ["unit-import.phase"]})))
   (let [prepared (world/prepare manifest-path)]
    (assert (= :proved (get-in prepared [:phase :status])))
    (assert (not (erlang/module_loaded :Elixir.Contextual.UnitShowcase.PhaseLibrary)))
    (BeamLisp.AOT/emit_unit (world/prepare-unit prepared :Elixir.Contextual.UnitImport) (Path/join output "unit-import-artifact"))
    (world/package-runtime! (Path/join output "unit-import-artifact") (Path/join output "runtime/unit-import")))
   (File/write! (Path/join output "unit-recompiler.json")
    (Jason/encode! {:status "passed" :provider-source-present false :provider-loaded false
                   :phase-companion-decoded true :native-admission false}))))
 (println "CONTEXTUAL-RECOMPILER byte-identical without provider source"))
