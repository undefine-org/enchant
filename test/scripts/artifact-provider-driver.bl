;; Private Source-component consumer gate. This does not mint SDK/floor authority.
(ns artifact.provider.driver)
(let [root (System/fetch_env! "BL_ARTIFACT_SOURCE_ROOT")
      output (System/fetch_env! "BL_ARTIFACT_OUTPUT_DIR")
      forms (BeamLisp.Reader/read_string (File/read! (Path/join root "test/scripts/execution-history-driver.bl")))
      helpers (Enum/filter forms #(and (= "defn-" (BeamLisp.AOT/stage-head %))
                                       (= "run-file" (BeamLisp.AOT/stage-symbol (second (BeamLisp.AOT/stage-items % :list))))))
      ns "artifact.provider.selectors"]
  (assert (= 1 (count helpers)))
  (BeamLisp.Compiler/eval_string (str "(ns " ns ")"))
  (BeamLisp.Compiler/eval_form (first helpers) (BeamLisp.Compiler/new_env ns))
  (let [request {:path "test/bl/artifact_provider_test.bl"
                 :selectors (map #(hash-map :namespace "artifact-provider.test" :test %)
                             ["request-refuses-unsupported-target-name-and-missing-inputs"
                              "product-refuses-mutable-and-traversing-output-addresses"
                              "actual-native-product-identity-and-byte-verification"
                              "exact-source-and-abi-binding-refuse-a-different-product"
                              "actual-nix-provider-retains-snapshot-and-build-consumer-selects-store-bytes"
                              "consumer-metadata-changes-reuse-the-compiled-native-product"
                              "checkout-executor-staging-authenticates-bytes-before-an-actual-command"])}
        result ((BeamLisp.Env/fetch_exact! ns "run-file") root request)]
    (File/write! (Path/join output "tests.json") (Jason/encode! result))
    (println (Jason/encode! result))
    (assert (= :passed (:status result)))))
