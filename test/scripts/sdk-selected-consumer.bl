(ns sdk.selected.consumer)
(let [output (System/fetch_env! "BL_SDK_ARTIFACT_OUT")
      source (System/fetch_env! "BL_SDK_CONTEXTUAL_ROOT")
      plan (Jason/decode! (File/read! (System/fetch_env! "BL_SDK_SEALED_PLAN"))
                          (list (tuple :keys :atoms)))
      rows (atom [])]
 (assert (= "yes" (System/get_env "BL_SDK_ARTIFACT_SOURCE_FREE")))
 (assert (BeamLisp.AOTCache/packaged_compiler?))
 (when (:pipeline plan)
  (BeamLisp/run_file (Path/join source "test/scripts/sdk-contextual-consumer.bl"))
  (assert (= "passed" (:status (Jason/decode! (File/read! (Path/join output "contextual-pipeline.json"))
                                             (list (tuple :keys :atoms)))))))
 (doseq [group (:groups plan) test (:tests group)]
  (let [started (System/monotonic_time :millisecond)
        result (BeamLisp.TestRT/run_suite (list (Path/join source (:path test))))]
   (assert (> (:tests result) 0))
   (assert (= (:assertions test) (:pass result)))
   (assert (= 0 (:fail result))) (assert (= 0 (:error result)))
   (swap! rows conj (assoc (select-keys result [:tests :pass :fail :error])
                     :group (:id group) :path (:path test)
                     :elapsed-ms (- (System/monotonic_time :millisecond) started)))))
 (File/write! (Path/join output "contextual-consumer.json")
  (Jason/encode! {:status "passed" :source-free true :boundaries (:boundaries plan)
                 :mode (:mode plan) :pipeline (:pipeline plan) :files (to-list @rows)
                 :assertions (reduce + 0 (map #(:pass %) @rows))})))
