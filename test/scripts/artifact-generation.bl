;; Actual complete producer. Each process starts from the selected candidate
;; floor; every target is newly emitted through AOT's artifact-only APIs.
(ns artifact.generation.proof (:require [seed]))

(defn- stable-identities []
 (into {} (keep (fn [pair]
                 (let [module (elem pair 0) name (Atom/to_string module)]
                  (when (and (String/starts_with? name "Elixir.BeamLisp.")
                             (not (String/starts_with? name "Elixir.BeamLisp.Eval"))
                             (not= (list :mutable-forwarder)
                                   (Keyword/get (erlang/apply module :module_info (list :attributes)) :bl_aot_artifact_role)))
                   [module (erlang/apply module :module_info (list :md5))])))
                (code/all_loaded))))

(let [before (stable-identities)
      captured (BeamLisp.Env/capture)
      started (erlang/monotonic_time :millisecond)
      result (seed/produce-artifacts
               (cond-> {:out (System/get_env "BL_GENERATION_OUTPUT")}
                 (System/get_env "BL_GENERATION_UNIT_STORE")
                 (assoc :unit-store (System/get_env "BL_GENERATION_UNIT_STORE"))
                 (System/get_env "BL_GENERATION_PREVIOUS_UNITS")
                 (assoc :previous-units (System/get_env "BL_GENERATION_PREVIOUS_UNITS"))
                 (System/get_env "BL_GENERATION_BASELINE")
                 (assoc :baseline (Jason/decode! (File/read! (System/get_env "BL_GENERATION_BASELINE"))))))
      after (stable-identities)]
 (assert (= false (:native-admission result)))
 (assert (= false (:fresh-boot-qualified result)))
 (assert (= false (:self-reproduction-qualified result)))
 (assert (= captured (BeamLisp.Env/capture)))
 (doseq [[module digest] before] (assert (= digest (get after module))))
 (File/write! (str (System/get_env "BL_GENERATION_OUTPUT") ".receipt.term") (erlang/term_to_binary result))
 (println "COMPILER-UNIT-RESULT" (Jason/encode! (select-keys result [:compiled :cached :modules])))
 (println "ARTIFACT-GENERATION" (pr-str {:modules (:modules result) :units (count (:units result))
                                       :producer-unchanged true
                                       :milliseconds (- (erlang/monotonic_time :millisecond) started)})))
