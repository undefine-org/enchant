;; Verify selection/pruning across real ordinary and World generations.
;; Fixture setup records the previous successfully verified selection; build!
;; owns the corresponding final pointer publication in normal commands.
(ns application.kind-transition-control
  (:require [application-product :as product] [claim :as claim]))
(defn select-fixture! [path out]
  (let [descriptor (Jason/decode! (File/read! (str path "/artifact.json")))
        selected (product/select! {:output path :sdk (get descriptor "sdk")
                                   :source (get descriptor "source")} out)]
    (File/rm (str out "/.nix-product"))
    (File/ln_s! path (str out "/.nix-product"))
    selected))
(let [out (System/fetch_env! "BL_KIND_OUTPUT")
      ordinary (System/fetch_env! "BL_KIND_ORDINARY")
      world (System/fetch_env! "BL_KIND_WORLD")]
  (claim/with-writer! out "application kind transition control"
    (fn []
      (File/write! (str out "/unrelated") "keep")
      (select-fixture! ordinary out)
      (assert (File/dir? (str out "/units/artifact.demo.consumer")))
      (select-fixture! world out)
      (assert (not (File/exists? (str out "/units"))))
      (assert (= [42 102 42 42] (BeamLisp.Loader/run_artifact_unit (str out "/artifact-unit") (list))))
      (select-fixture! ordinary out)
      (assert (File/dir? (str out "/units/artifact.demo.consumer")))
      (assert (not (File/exists? (str out "/artifact-unit"))))
      (assert (= "keep" (File/read! (str out "/unrelated"))))))
  (assert (not (claim/owned? out)))
  (println "APPLICATION-KIND-TRANSITION passed"))
