;; Actual compiler input provenance includes reads that a static require graph
;; cannot infer. A packaging shortcut must preserve those inputs.
(ns application.input-receipts-control (:require [application-product :as product]))
(let [root (System/fetch_env! "BL_INPUT_RECEIPT_SOURCE")
      out (System/fetch_env! "BL_INPUT_RECEIPT_OUTPUT")
      result (product/build! {:root root :out out :jobs 1
               :sources (Enum/map ["consumer" "factory" "hidden"]
                          (fn [name] (str root "/src/receipt/" name ".bl")))})]
  (assert (empty? (:errors result)))
  (let [unit (BeamLisp.AOT/verify_unit (str (:product result) "/units/receipt.consumer"))
        inputs (set (Enum/map (get-in unit [:manifest :inputs]) (fn [input] (:namespace input))))
        impact (get-in result [:receipt :result "impact"])
        consumer (some (fn [row] (when (= "receipt.consumer" (get row "namespace")) row)) impact)]
    (assert (contains? inputs "receipt.consumer"))
    (assert (contains? inputs "receipt.factory"))
    (assert (contains? inputs "receipt.hidden"))
    (assert (not (contains? (set (get consumer "requires")) "receipt.hidden")))
    (when-let [path (System/get_env "BL_INPUT_RECEIPT_RESULT")]
      (File/write! path (Jason/encode!
        {:status "passed" :product (:product result) :inputs (sort inputs)
         :declared-requires (get consumer "requires")}))))
  (println "APPLICATION-INPUT-RECEIPTS passed"))
