;; Exercise the actual global CLI and the real Rustler showcase in one VM.
(ns artifact.showcase-driver)
(let [root (System/fetch_env! "BL_ARTIFACT_SOURCE_ROOT")
      output (System/fetch_env! "BL_ARTIFACT_OUTPUT_DIR")
      previous (System/get_env "XDG_CACHE_HOME")]
  (try
    (System/put_env "XDG_CACHE_HOME" (Path/join output "showcase-cache"))
    (BeamLisp/run_file (Path/join root "examples/artifacts/showcase.bl"))
    (BeamLisp.Loader/ensure_loaded "bl.cli")
    (let [command (BeamLisp.Env/fetch_exact! "bl.cli" "run-argv")
          standalone (Path/join output "empty-project")
          _ (File/mkdir_p! standalone)
          listed (BeamLisp/with_cwd standalone #(command ["artifacts" "list"]))
          receipt (first (Path/wildcard (str (System/fetch_env! "XDG_CACHE_HOME")
                                            "/beam_lisp/artifacts/native-*/receipt.json")))
          _ (assert (some? receipt))
          compared (command ["artifacts" "compare" receipt receipt])
          capsule (command ["artifacts" "capsule" receipt (Path/join output "showcase-capsules")])
          prepared (command ["artifacts" "prepare" (Path/join root "examples/artifacts/native/artifact_demo")
                             "artifact_demo" "beam-lisp-native-artifact_demo-v1"])
          usage (command ["artifacts" "prepare"])
          answer ((BeamLisp.Env/fetch_exact! "artifact.showcase" "answer"))
          result {"answer" answer "library" (File/read_link! (Path/join root "examples/artifacts/priv/native/artifact_demo.so"))
                  "list" listed "compare" compared "capsule" capsule "prepare" prepared "usage" usage}]
      (assert (= 42 answer))
      (assert (every? #(= 0 %) [listed compared capsule prepared]))
      (assert (= 2 usage))
      (File/write! (Path/join output "showcase.json") (Jason/encode! result))
      (println "ARTIFACT-CLI-AND-SHOWCASE-PASSED"))
    (finally (if previous (System/put_env "XDG_CACHE_HOME" previous) (System/delete_env "XDG_CACHE_HOME")))))
