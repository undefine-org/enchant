(ns application.force-control (:require [application-product :as product]))
(let [root (System/fetch_env! "BL_FORCE_SOURCE") out (System/fetch_env! "BL_FORCE_OUTPUT")
      options {:root root :out out :force? true :jobs 1
               :sources [(str root "/src/artifact/demo/values.bl") (str root "/src/artifact/demo/consumer.bl")]}
      first-result (product/build! options)
      _ (println "FORCE-FIRST" (pr-str (:errors first-result)))
      _ (assert (empty? (:errors first-result)))
      second-result (product/build! options)]
  (println "FORCE-SECOND" (pr-str (:errors second-result)))
  (assert (empty? (:errors second-result)))
  (assert (= 2 (:built first-result))) (assert (= 2 (:built second-result)))
  (assert (not= (:product first-result) (:product second-result)))
  (doseq [result [first-result second-result]]
    (assert (= 2 (get-in result [:receipt :result "unit-compiled"])))
    (assert (= 0 (get-in result [:receipt :result "unit-restored"])))
    (assert (= 4 (get-in result [:receipt :request "version"])))
    (assert (= #{"version" "source" "sources" "world" "exclude" "ex"
                  "native" "jobs" "scope" "base" "force" "attempt" "nativeProducts"}
               (set (keys (get-in result [:receipt :request])))))
    (assert (= [] (get-in result [:receipt :request "nativeProducts"])))
    (assert (= false (get-in result [:receipt :request "native"])))
    (assert (= "full" (get-in result [:receipt :request "scope"])))
    (assert (nil? (get-in result [:receipt :request "base"])))
    (assert (= true (get-in result [:receipt :request "force"])))
    (assert (= 64 (String/length (get-in result [:receipt :request "attempt"])))))
  (assert (not= (get-in first-result [:receipt :request "attempt"])
                (get-in second-result [:receipt :request "attempt"])))
  (doseq [unit (:artifact-units first-result)]
    (let [relative (Path/relative_to unit (:product first-result))]
      (doseq [name (File/ls! unit)]
        (assert (= (File/read! (Path/join unit name))
                   (File/read! (Path/join (:product second-result) (str relative "/" name))))))))
  (let [invalid (product/build! (assoc options :force? :yes))]
    (assert (seq (:errors invalid)))
    (assert (= (tuple :ok (:product second-result)) (File/read_link (str out "/.nix-product")))))
  (File/write! (System/fetch_env! "BL_FORCE_RESULT")
    (Jason/encode! {:first (:receipt first-result) :second (:receipt second-result)}))
  (println "APPLICATION-FORCE-REMOTE passed"))
