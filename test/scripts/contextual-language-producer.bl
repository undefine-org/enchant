(ns contextual.language.producer
 (:require [expand :as x] [bl.world :as world]))

(let [fixtures (System/fetch_env! "BL_CONTEXTUAL_SOURCES")
      output (System/fetch_env! "BL_CONTEXTUAL_OUTPUT")
      descriptor (fn [namespace revision file]
                   {:namespace namespace :revision revision :file file
                    :source (File/read! (Path/join fixtures file))})
      spec (Jason/decode! (System/fetch_env! "BL_CONTEXTUAL_SPEC"))
      providers (mapv (fn [row] (descriptor (symbol (nth row 0)) (symbol (nth row 1)) (nth row 2)))
                      (get spec "providers"))
      sources (conj providers (descriptor 'showcase 'current "main.bl"))
      started (erlang/monotonic_time :millisecond)
      library (x/phase-library providers)
      _ (File/write! (Path/join output "phase-library.term") (x/encode-phase-library library))
      _ (File/write! (Path/join output "main.bl") (:source (last sources)))
      _ (File/write! (Path/join output "world.bl")
          "{:version 1 :profile 'syntax-v1 :entry ['showcase 'current] :sources [{:namespace 'showcase :revision 'current :file \"main.bl\"}] :libraries [\"phase-library.term\"]}")
      prepared (world/prepare (Path/join output "world.bl"))
      program (:program prepared) report (:phase prepared)
      module :Elixir.Contextual.Showcase
      _ (assert (= false (erlang/module_loaded module)))
      beam (world/artifact prepared module)
      bytes (elem beam 1)
      receipt {:status "passed" :profile "syntax-v1" :native-admission false
               :compiler-key (BeamLisp.AOTCache/compiler_key)
               :worlds (count (get-in program [:selection :worlds]))
               :expansions (count (:expansions program)) :references (:references report)
               :phase-check (name (:status report)) :target-loaded (erlang/module_loaded module)
               :constructor-calls (get-in program [:constructor :calls])
               :constructor-closed (= :closed (get-in program [:constructor :status]))
               :milliseconds (- (erlang/monotonic_time :millisecond) started)
               :beam-sha256 (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower)))}]
 (assert (= :proved (:status report)))
 (assert (= (get spec "expansions") (count (:expansions program))))
 (assert (= false (erlang/module_loaded module)))
 (File/write! (Path/join output "showcase.beam") bytes)
 (BeamLisp.AOT/emit_unit (world/prepare-unit prepared module) (Path/join output "showcase-unit"))
 (File/write! (Path/join output "main.source") (:source (last sources)))
 (File/write! (Path/join output "producer.json") (Jason/encode! receipt))
 (when (= "yes" (System/get_env "BL_CONTEXTUAL_ARTIFACT_UNIT"))
  (let [prepared (world/prepare (Path/join fixtures "world.bl"))
        artifact (world/prepare-unit prepared :Elixir.Contextual.UnitShowcase)
        directory (Path/join output "artifact-unit")]
   (BeamLisp.AOT/emit_unit artifact directory)
   (let [verified (world/read-unit directory) runtime (first (:runtime-beams verified))
         package (Path/join output "runtime")]
    (File/mkdir_p! package)
    (world/package-runtime! directory (Path/join package "unit-program"))
    (assert (not (erlang/module_loaded :Elixir.Contextual.UnitShowcase)))
    (assert (not (erlang/module_loaded :Elixir.Contextual.UnitShowcase.PhaseLibrary)))
    (File/write! (Path/join output "unit-producer.json")
     (Jason/encode! {:status "passed" :complete-members 2 :runtime-members 1
                    :provider-loaded false :constructor-calls (get-in prepared [:program :constructor :calls])})))))
 (println "CONTEXTUAL-PRODUCER" (pr-str receipt)))
