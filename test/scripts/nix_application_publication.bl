(ns application.publication-control (:require [application-product :as product] [claim :as claim]))
(let [root (System/fetch_env! "BL_APPLICATION_CONTROL_SOURCE")
      out (System/fetch_env! "BL_APPLICATION_CONTROL_OUTPUT")
      options {:root root :out out :sources [(str root "/src/artifact/demo/consumer.bl")
                                             (str root "/src/artifact/demo/values.bl")] :jobs 4}
      result (product/build! options)]
  (println (str "PUBLICATION-RESULT " (pr-str (:errors result))))
  (assert (empty? (:errors result)))
  (assert (= 2 (:built result)))
  (assert (= 2 (count (:artifact-units result))))
  (assert (not (claim/owned? out)))
  (assert (File/regular? (str out "/compile.beam_lisp")))
  (File/write! (System/fetch_env! "BL_APPLICATION_CONTROL_RESULT")
    (Jason/encode! {:product (:product result) :built (:built result)
                   :units (Enum/map (:artifact-units result) identity)}))
  (println (str "APPLICATION-PUBLICATION " (:product result))))
