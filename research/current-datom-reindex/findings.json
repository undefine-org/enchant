      "sources": [
        "priv/lib/datom/broadcast.bl:1",
        "priv/lib/datom/conn.bl:2381"
      ]
    },
    {
      "id": "snapshot_not_blob_or_multistore_boundary",
      "severity": "activation_blocker",
      "finding": "Per-store MVCC checkpoint does not capture independent blobs/stores at one app boundary.",
      "evidence": "source_inspection",
      "sources": [
        "priv/lib/datom/store.bl:601",
        "priv/lib/datom/blob-retention.bl:1"
      ]
    },
    {
      "id": "rollback_after_new_writes",
      "severity": "rollback_blocker",
      "finding": "Selecting the retained old generation after acknowledged new writes omits those writes.",
      "policy": "prewrite_rollback_only_until_reverse_replay_or_forward_repair_is_qualified",
      "evidence": "design_inference"
    },
    {
      "id": "opening_source_can_have_effects",
