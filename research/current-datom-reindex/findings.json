  "hazards": [
    {
      "id": "canonical_full_key_payload_collision",
      "severity": "activation_blocker",
      "finding": "Distinct legacy rows may map to one target key while payload bytes differ; ordinary puts overwrite.",
      "examples": [
        "same_e_a_tx_op_list_vs_vector",
        "same_e_a_tx_op_exact_large_integer_vs_equal_float"
      ],
      "policy": "refuse_no_automatic_dedup_or_winner",
      "evidence": "synthetic_plus_source",
      "sources": [
        "priv/lib/datom/index.bl:156",
        "priv/lib/datom/index.bl:411",
        "test/bl/datom/reindex_research_test.bl"
      ]
    },
    {
      "id": "canonical_unique_claim_collision",
      "severity": "activation_blocker",
      "finding": "Different entities retain different full keys but can violate canonical identity/value uniqueness.",
      "policy": "evaluate_live_claims_at_supported_history_boundaries_with_retractions_no_entity_merges",
      "evidence": "synthetic_plus_source",
      "sources": [
        "priv/lib/datom/tx.bl:773",
        "priv/lib/datom/current.bl:24",
        "test/bl/datom/reindex_research_test.bl"
      ]
    },
    {
      "id": "tx_watermark_misses_excision",
