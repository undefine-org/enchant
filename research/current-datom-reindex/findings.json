      "evidence": "synthetic_plus_source",
      "sources": [
        "priv/lib/datom/conn.bl:1310",
        "test/bl/datom/reindex_research_test.bl"
      ]
    },
    {
      "id": "volatile_reports_are_not_cdc",
      "severity": "online_blocker",
      "finding": "Commit-to-send crash window, no durable offset acknowledgement; raw/internal/blob writes outside report.",
