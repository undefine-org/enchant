(ns cutover.sdk-plan-preflight (:require [build :as build] [build-plan :as plan]))
(let [root (BeamLisp.Tiers/priv_root)
      sources (filter (fn [path] (and (not (BeamLisp.AOT/floor_file? path))
                                     (not (String/ends_with? path "-fixture.bl"))))
                (build/namespace-sources root))
      graph (plan/plan-paths sources)
      partition (build/partition-plan graph root)]
  (println (Jason/encode! {:sources (count sources) :toolchain (count (:toolchain partition))
                          :cycles (count (:cycles graph)) :errors (to-list (:errors partition))}))
  (assert (empty? (:errors partition)))
  (assert (empty? (:cycles graph)))
  (println "SDK-PLAN passed: complete source graph preserves the toolchain barrier"))
