(ns cutover.component-control (:require [bl.test :as tests] [bl.native-declarations :as native] [bl.env :as env] [artifact.replay-runner :as runner] [artifact :as artifact] [artifact.json :as json]))
(doseq [path ["/home/othman/code/undefine/beam-lisp--execution-protocol/priv/build/artifact-jobs.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/build/artifact.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/build/build.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/application-product.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/artifact/replay.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/bl/env.bl.md", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/bl/test.bl.md", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/vm/native.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/artifact/replay-runner.bl", "/home/othman/code/undefine/beam-lisp--execution-protocol/priv/std/bl/native-declarations.bl"]] (BeamLisp.Reader/read_all (BeamLisp.Loader/read_source path)))
(def root "/home/othman/code/undefine/beam-lisp--execution-protocol/.local/authoritative-nix/component-control")
(let [[normalized errors] (native/normalize [{:source "workspace" :member "crates/demo" :package "workspace-demo" :crate "demo_alias" :abi "v1"}] root)]
 (assert (empty? errors))
 (assert (= (str root "/workspace") (:source (first normalized)))))
(doseq [invalid [[{:source "." :member "../bad" :package "x" :crate "x" :abi "v1"}]
                  [{:source "." :member "." :package "x" :crate "../bad" :abi "v1"}]
                  false]]
 (assert (seq (second (native/normalize invalid root)))))
(let [pass (tests/run-selected-data! [(str root "/pass.bl")])
      fail (tests/run-selected-data! [(str root "/fail.bl")])
      empty (tests/run-selected-data! [(str root "/empty.bl")])]
 (assert (= {:tests 1 :pass 1 :fail 0 :error 0 :files 1 :ok true :exit 0} pass))
 (assert (= 1 (:fail fail))) (assert (= 1 (:exit fail)))
 (assert (= 0 (:tests empty)))
 (assert (try (tests/run-selected-data! []) false (catch _ true)))
 (assert (try (tests/run-selected-data! [(str root "/pass.bl") (str root "/pass.bl")]) false (catch _ true))))
(assert (try (runner/observe!) false (catch _ true)))
(println "CUTOVER-COMPONENTS passed: declaration validation; admitted test aggregates; mutable floor refused")

(let [decoded (json/read! (str root "/valid.json"))
      output (str root "/published-" (erlang/unique_integer (list :positive)) ".json")]
 (assert (= 4 (count (get decoded "a")))))
(doseq [name ["duplicate.json" "nested-duplicate.json" "deep.json" "large.json" "nodes.json"]]
 (assert (try (json/read! (str root "/" name)) false (catch _ true))))
(let [output (str root "/published-" (System/system_time :microsecond) ".json") value {"one" 1 "array" [true nil "data"]}]
 (json/write-new! output value)
 (assert (= {"one" 1 "array" (list true nil "data")} (json/read! output)))
 (assert (= 0 (erlang/band (:mode (File/stat! output)) 63)))
 (assert (try (json/write-new! output {"changed" true}) false (catch _ true)))
 (assert (= 1 (get (json/read! output) "one"))))
(let [project (env/project root)]
 (assert (empty? (:errors project)))
 (assert (= "demo_alias" (:crate (first (get-in project [:build :native]))))))
(let [inventory (BeamLisp.Env/fetch_exact! "vm.native" "native-refresh-inputs")
      support (str root "/workspace/support.txt")
      before (inventory root "producer-control" nil)]
 (File/write! support "after")
 (let [after (inventory root "producer-control" nil)]
  (assert (not= before after))
  (File/mkdir_p! (str root "/workspace/target"))
  (File/write! (str root "/workspace/target/noise") "ignored")
  (assert (= after (inventory root "producer-control" nil)))
  (File/ln_s! support (str root "/workspace/linked"))
  (assert (try (inventory root "producer-control" nil) false (catch _ true)))
  (File/rm! (str root "/workspace/linked"))))
(println "CUTOVER-JSON/INVENTORY passed: strict ingress, private publication, complete support closure")
