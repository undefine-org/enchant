(ns foundry.spawn-control)
(BeamLisp/run_file "/home/othman/code/undefine/foundry--artifact-worker-race/src/foundry/operations/deployment-runner.bl")
(let [record-spawn (BeamLisp.Env/fetch_exact! "deployment-runner" "record-spawn!")
      read-job (BeamLisp.Env/fetch_exact! "deployment-runner" "read-job")
      state "/home/othman/code/undefine/beam-lisp--execution-protocol/.local/authoritative-nix/foundry-spawn-state"
      id "job_aaaaaaaaaaaaaaaa"
      path (str state "/ledger/jobs/" id ".json")
      pid (String/to_integer (System/pid))]
 (File/mkdir_p! (str state "/ledger/jobs"))
 (doseq [status ["running" "succeeded" "interrupted" "failed" "cancelled"]]
  (let [row {"id" id "status" status "worker_pid" 1234567 "worker_ticks" 99 "spawn_count" 1 "updated_at" "before"}]
   (File/write! path (Jason/encode! row))
   (record-spawn state id pid)
   (assert (= row (read-job state id)))))
 (File/write! path (Jason/encode! {"id" id "status" "queued" "worker_pid" nil "worker_ticks" nil "spawn_count" 0}))
 (record-spawn state id pid)
 (let [row (read-job state id)]
  (assert (= "queued" (get row "status")))
  (assert (= pid (get row "worker_pid")))
  (assert (int? (get row "worker_ticks")))
  (assert (= 1 (get row "spawn_count")))))
(println "FOUNDRY-SPAWN passed: queued observation and running/terminal identity preservation")
