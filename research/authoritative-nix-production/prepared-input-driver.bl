(ns authoritative.prepared-input.check)
(let [root (System/fetch_env! "BL_ARTIFACT_SOURCE_ROOT")
      output (System/fetch_env! "BL_ARTIFACT_OUTPUT_DIR")
      forms (BeamLisp.Reader/read_string (File/read! (Path/join root "test/scripts/execution-history-driver.bl")))
      helpers (Enum/filter forms #(and (= "defn-" (BeamLisp.AOT/stage-head %))
                                       (= "run-file" (BeamLisp.AOT/stage-symbol (second (BeamLisp.AOT/stage-items % :list))))))
      ns "authoritative.prepared.selectors"]
 (assert (= 1 (count helpers)))
 (BeamLisp.Compiler/eval_string (str "(ns " ns ")"))
 (BeamLisp.Compiler/eval_form (first helpers) (BeamLisp.Compiler/new_env ns))
 (let [result ((BeamLisp.Env/fetch_exact! ns "run-file") root
               {:path "test/bl/artifact_provider_test.bl"
                :selectors [{:namespace "artifact-provider.test"
                             :test "prepared-native-inputs-require-complete-source-and-final-byte-identity"}]})]
  (File/write! (Path/join output "result.json") (Jason/encode! result))
  (println (Jason/encode! result))
  (assert (= :passed (:status result)))))
