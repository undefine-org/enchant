(ns authoritative.native-cutover.check)
(let [root (System/fetch_env! "BL_ROOT")
      output (System/fetch_env! "BL_NATIVE_CHECK_OUTPUT")
      forms (BeamLisp.Reader/read_string (File/read! (Path/join root "test/scripts/execution-history-driver.bl")))
      helper (first (filter #(and (= "defn-" (BeamLisp.AOT/stage-head %))
                                 (= "run-file" (BeamLisp.AOT/stage-symbol (second (BeamLisp.AOT/stage-items % :list))))) forms))
      ns "authoritative.native-cutover.selectors"]
 (BeamLisp.Compiler/eval_string (str "(ns " ns ")"))
 (BeamLisp.Compiler/eval_form helper (BeamLisp.Compiler/new_env ns))
 (let [results (Enum/map
                [["test/bl/native_test.bl" "test.native"] ["test/bl/native_runtime_custody_test.bl" "native-runtime-custody.test"]]
                (fn [[path namespace]]
                 (let [declarations (BeamLisp.Reader/read_string (File/read! (Path/join root path)))
                       selectors (Enum/map (Enum/filter declarations #(= "deftest" (BeamLisp.AOT/stage-head %)))
                                    #(hash-map :namespace namespace :test (BeamLisp.AOT/stage-symbol (second (BeamLisp.AOT/stage-items % :list)))) )]
                  ((BeamLisp.Env/fetch_exact! ns "run-file") root {:path path :selectors selectors}))))]
  (File/write! (Path/join output "result.json") (Jason/encode! results))
  (println (Jason/encode! results))
  (assert (every? #(= :passed (:status %)) results))))
