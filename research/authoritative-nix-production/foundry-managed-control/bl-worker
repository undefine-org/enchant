#!/bin/sh
set -eu
job=
previous=
for argument do
  if [ "$previous" = --id ]; then job=$argument; fi
  previous=$argument
done
case "$job" in job_*) ;; *) echo 'worker job id required' >&2; exit 64 ;; esac
case "$job" in *[!A-Za-z0-9_]*) exit 64 ;; esac
exec /run/current-system/sw/bin/systemd-run --user --quiet --collect --wait --pipe \
  --working-directory="$PWD" --unit="foundry-artifact-$job.service" --property=MemoryMax=2G \
  --property=MemorySwapMax=0 --property=RuntimeMaxSec=240 --property=KillMode=control-group \
  -- /usr/bin/env -i "HOME=$HOME" "PATH=$PATH" \
    "BEAM_LISP_PATH=${BEAM_LISP_PATH:-}" "FOUNDRY_ROOT=${FOUNDRY_ROOT:-}" \
    "FOUNDRY_BL=$0" "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}" \
    "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-}" \
    'ELIXIR_ERL_OPTIONS=+S 4:4 +SDcpu 2:2 +SDio 1:1' BL_DAEMON=off \
    /nix/store/ymhxa6j1bsmp366zmnc48v7y9lj2y4as-beam-lisp-sdk-selection/bin/bl --cold "$@"
