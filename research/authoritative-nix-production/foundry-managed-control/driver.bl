(ns artifact.foundry-managed-reconnect (:require [deployment-runner :as runner]))
(let [root (System/fetch_env! "BL_FOUNDRY_LEDGER_CONTROL") state (str root "/state")
      result (runner/invoke! ["--state" state "submit" "--request-file" (str root "/request.json")])]
  (assert (:ok result))
  (let [id (get-in result [:value :id])]
    (loop [attempt 0]
      (let [result (runner/invoke! ["--state" state "status" "--id" id])]
        (assert (:ok result))
        (if (= "running" (get-in result [:value :status]))
          (File/write! (str root "/ready.json") (Jason/encode! (:value result)))
          (do (assert (< attempt 900)) (Process/sleep 100) (recur (inc attempt)))))))
  (println "FOUNDRY-PARENT-EXIT while-job-running"))
