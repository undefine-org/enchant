(ns artifact.foundry-reconnect-observer (:require [deployment-runner :as runner]))
(let [root (System/fetch_env! "BL_FOUNDRY_LEDGER_CONTROL")
      id (get (Jason/decode! (File/read! (str root "/ready.json"))) "id")
      state (str root "/state")]
  (loop [attempt 0]
    (let [result (runner/invoke! ["--state" state "status" "--id" id]) value (:value result)]
      (assert (:ok result))
      (if (contains? #{"succeeded" "failed" "interrupted" "cancelled"} (:status value))
        (do
          (File/write! (str root "/observed-result.json") (Jason/encode! value))
          (println "FOUNDRY-RECONNECTED" (pr-str value))
          (assert (= "succeeded" (:status value))))
        (do (assert (< attempt 600)) (Process/sleep 100) (recur (inc attempt))))))
  (let [events (runner/invoke! ["--state" state "events" "--id" id "--cursor" "0" "--limit" "100"])]
    (assert (:ok events)) (File/write! (str root "/observed-events.json") (Jason/encode! (:value events))))
  (assert (File/dir? (str root "/retained")))
  (println "FOUNDRY-MANAGED-RECONNECT passed"))
