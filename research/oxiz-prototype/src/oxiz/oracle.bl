(ns oxiz.oracle
 (:require [oxiz.worker :as worker] [oracle] [smt]))

(defn ask
 "Send the obligation's original forms, bypassing oracle's shared memo.
  Obligation creation still computes text identity; worker/check avoids that
  construction too. Returns explicitly untrusted experimental data."
 [handle obligation]
 (when (or (string? (:cmds obligation))
           (some string? (:cmds obligation)))
  (throw (ex-info "OxiZ direct path requires command forms" {})))
 (worker/check handle (:cmds obligation)))

(defn compare
 "Z3 makes the decision. OxiZ is observed independently, never promoted.
  Compare statuses, not model equality: distinct models can both be valid."
 [handle obligation]
 (let [z3 (oracle/with-memo false
            (fn [] (oracle/with-oracle oracle/pool-handler (fn [] (oracle/ask obligation true)))))
       candidate (try (ask handle obligation)
                   (catch error {:status :error :error (ex-message error) :trusted false}))]
  {:label (:label obligation) :authoritative :z3 :decision z3 :candidate candidate
   :agreement (and (contains? #{:sat :unsat} (:status z3))
                   (= (:status z3) (:status candidate)))}))

(defn- raw-model [model]
 (smt/emit
  (to-list (map (fn [[name value]] (list 'define-fun (symbol name) (list)
     (cond (int? value) 'Int (string? value) 'String :else 'Bool) value)) model))))

(defn with-oracle
 "Compatibility probe for existing verifiers. Their handler ABI takes text,
  so this path reads text back into forms in BL. It is not the direct path
  and must not be used to claim removal of the compiler's text boundary.
  Memo is disabled for the complete dynamic extent, including sessions."
 [handle f]
 (oracle/with-memo false
  (fn [] (oracle/with-oracle
    (fn [text model?]
     (let [result (worker/check handle (smt/read-terms text))]
      {:status (name (:status result))
       :model (when (and model? (= :sat (:status result))) (raw-model (:model result)))
       :core (smt/emit (to-list (map symbol (:core result))))
       :why (when (= :unknown (:status result)) "unspecified")})) f))))
