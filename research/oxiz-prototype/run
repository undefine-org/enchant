#!/usr/bin/env bash
set -euo pipefail
prototype=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
root=$(CDPATH='' cd "$prototype/../.." && pwd -P)
python3 - "$prototype/sdk-pin.json" <<'PY'
import hashlib,json,pathlib,sys
pin=json.loads(pathlib.Path(sys.argv[1]).read_text())
descriptor=(pathlib.Path(pin['sdk'])/'artifact.json').read_bytes()
assert hashlib.sha256(descriptor).hexdigest()==pin['descriptor_sha256'], 'SDK descriptor changed'
assert json.loads(descriptor)['source']==pin['source'], 'SDK Source changed'
PY
pinned=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sdk"])' "$prototype/sdk-pin.json")
worker="$prototype/worker/target/release/enchant-oxiz-worker"
[[ -x "$worker" ]] || { echo "build first: $prototype/build" >&2; exit 69; }
runtime=$(mktemp -d /tmp/enchant-oxiz-runtime-XXXXXXXX)
trap 'rm -rf -- "$runtime"' EXIT
systemd-run --user --quiet --collect --wait --pipe \
  --working-directory="$root" --property=MemoryMax=3G --property=MemorySwapMax=0 \
  --property=RuntimeMaxSec=180 --property=KillMode=control-group \
  --setenv=ENCHANT_OXIZ_WORKER="$worker" --setenv=XDG_RUNTIME_DIR="$runtime" \
  "$pinned/bin/bl" --cold -p "$prototype/src" "$@"
