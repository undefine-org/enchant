;; Real Foundry executor. Keep JSON stdout separate from Nix progress stderr.
(ns nix-experiment (:require [deployment-exec :as x]))
(defn request! [token index]
  (let [private "/home/othman/projects/nix-execution-prototype/bridge-private"
        _ (File/mkdir_p! private)
        _ (File/chmod! private 448)
        output-file (str private "/" token "-" index ".json")
        start (System/monotonic_time :millisecond)
        result (x/run "/run/current-system/sw/bin/nix"
                 ["build" "--file" "/home/othman/projects/nix-execution-prototype/request.nix"
                  "--argstr" "requestJson" (Jason/encode! {"answer" 42})
                  "--argstr" "token" token
                  "--json" "--no-link" "--offline" "--max-jobs" "1" "--cores" "1"
                  "--option" "builders" ""]
                 {:timeout-ms 30000 :limit 65536 :stdout-file output-file})]
    (try
      (when-not (x/ok? result) (throw (ex-info "Nix request failed" result)))
      (let [rows (Jason/decode! (File/read! output-file))
            output (get-in (first rows) ["outputs" "out"])
            manifest (Jason/decode! (File/read! (str output "/manifest.json")))]
        (when-not (and (= 1 (get manifest "schema")) (= 42 (get manifest "answer")))
          (throw (ex-info "Artifact manifest refused" manifest)))
        {"output" output "manifest" manifest
         "milliseconds" (- (System/monotonic_time :millisecond) start)})
      (finally (File/rm output-file)))))
(let [token (str "bridge-" (System/system_time :millisecond))
      first (request! token 1)
      second (request! token 2)
      _ (when-not (= (get first "output") (get second "output"))
          (throw (ex-info "Warm identity changed" {})))
      receipt {"status" "passed" "first" first "warm" second
               "foundryExecutor" true "requestTransport" "JSON"
               "runtime" "/nix/store/75j6xxsklvz2rvjf94lwp5zz1h5bs1xl-bl/bin/bl"}]
  (File/write! "/home/othman/projects/nix-execution-prototype/bridge-result.json" (Jason/encode! receipt))
  (println (Jason/encode! receipt)))
