(ns execution-protocol.preflight)
(println "AUDIT-PREFLIGHT started")
(def ready (atom true))
(doseq [namespace ["typed" "errors" "diag" "codebase" "system.model"
                  "system.step" "system.analyze" "system.publication"
                  "system.evidence" "system.knowledge"]]
 (try
  (BeamLisp.Loader/ensure_loaded namespace)
  (println (str "AUDIT-PREFLIGHT ready " namespace))
  (catch error
   (reset! ready false)
   (println (str "AUDIT-PREFLIGHT failed " namespace " " (ex-message error))))))
(when @ready
 (BeamLisp/run_file
  (or (System/get_env "BL_EXECUTION_AUDIT_PROGRAM")
      "/home/user/code/undefine/beam-lisp/.local/execution-protocol-audit/audit.bl")))
(println "AUDIT-PREFLIGHT finished")
(when-not @ready (erlang/halt 1))
