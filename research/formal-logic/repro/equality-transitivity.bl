(ns formal.equality-transitivity-reproducer
 (:require [formal.equality-coherence :as equality] [bl.json :as json]))

;; <pinned-sdk>/bin/bl -p research/formal-logic/src run \
;;   research/formal-logic/repro/equality-transitivity.bl
;;
;; Reports an explicit known-failing observation without silently accepting
;; transitivity as false or causing unrelated prototype tests to fail.
(println (json/encode (equality/witness) {:pretty 2}))
:ok
