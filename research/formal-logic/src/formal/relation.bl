(ns formal.relation (:require [formal.term :as t] [formal.value :as v]))

;; A finite graph/order/permission relation is exact over its declared universe.
;; No transitive-closure axiom or quantifier is hidden in these encodings.
(defn symbolic [name universe]
 (let [universe (vec universe) n (count universe)]
  (when-not (and (= n (count (distinct universe))) (<= n 8))
   (throw (ex-info "Finite relation requires distinct universe of size <= 8" {})))
  (v/make {:edges (mapv (fn [i]
                 (mapv (fn [j] (t/variable (str name "." i "." j) t/Bool)) (range n))) (range n))}
   {:scope {:mode :finite-universe :values universe}
    :domain {:kind :finite-relation :keys universe :profile :formal/finite-relation-v1}})))

(defn empty [name universe]
 (let [r (symbolic name universe)]
  (assoc r :value {:edges (mapv (fn [_] (mapv (fn [_] (t/bool false)) universe)) universe)})))

(defn- index [relation label]
 (let [keys (get-in relation [:domain :keys])
       at (first (keep (fn [i] (when (= label (nth keys i)) i)) (range (count keys))))]
  (when (= at nil) (throw (ex-info "Relation label is outside its declared universe" {:label label :universe keys})))
  at))
(defn- edge-term [relation i j] (get-in relation [:value :edges i j]))
(defn edge [relation from to]
 (v/scalar (edge-term relation (index relation from) (index relation to)) [relation] {}))
(defn put [relation from to value]
 (let [i (index relation from) j (index relation to) value (v/lift value)
       _ (when-not (= t/Bool (t/sort-of (v/term value)))
           (throw (ex-info "Relation edge must be Bool" {})))
       edges (get-in relation [:value :edges])]
  (v/make {:edges (assoc edges i (assoc (nth edges i) j (v/term value)))}
   (merge (v/context [relation value]) {:domain (:domain relation)}))))

(defn closure
 "Positive transitive closure by finite Floyd–Warshall. Reflexivity is added
  only when requested. Acyclicity always uses the positive closure."
 ([relation] (closure relation {}))
 ([relation opts]
  (let [keys (get-in relation [:domain :keys]) n (count keys)
        before (get-in relation [:value :edges])
        initial (if (:reflexive opts)
                  (mapv (fn [i] (mapv (fn [j] (t/any [(get-in before [i j]) (t/bool (= i j))])) (range n))) (range n))
                  before)
        after (reduce (fn [matrix k]
                 (mapv (fn [i]
                  (mapv (fn [j]
                   (t/any [(get-in matrix [i j])
                           (t/all [(get-in matrix [i k]) (get-in matrix [k j])])])) (range n))) (range n)))
                initial (range n))]
   (v/make {:edges after} (merge (v/context [relation]) {:domain (:domain relation)})))))

(defn reflexive? [relation]
 (v/scalar (t/all (map (fn [i] (edge-term relation i i)) (range (count (get-in relation [:domain :keys]))))) [relation] {}))
(defn irreflexive? [relation]
 (v/scalar (t/all (map (fn [i] (t/not (edge-term relation i i))) (range (count (get-in relation [:domain :keys]))))) [relation] {}))
(defn transitive? [relation]
 (let [indices (range (count (get-in relation [:domain :keys])))]
  (v/scalar (t/all (for [i indices j indices k indices]
                   (t/implies (t/all [(edge-term relation i j) (edge-term relation j k)])
                              (edge-term relation i k)))) [relation] {})))
(defn antisymmetric? [relation]
 (let [indices (range (count (get-in relation [:domain :keys])))]
  (v/scalar (t/all (for [i indices j indices :when (not= i j)]
                   (t/not (t/all [(edge-term relation i j) (edge-term relation j i)])))) [relation] {})))
(defn total? [relation]
 (let [indices (range (count (get-in relation [:domain :keys])))]
  (v/scalar (t/all (for [i indices j indices :when (not= i j)]
                   (t/any [(edge-term relation i j) (edge-term relation j i)]))) [relation] {})))
(defn partial-order? [relation]
 (v/scalar (t/all [(v/term (reflexive? relation)) (v/term (transitive? relation))
                   (v/term (antisymmetric? relation))]) [relation] {}))
(defn strict-order? [relation]
 (v/scalar (t/all [(v/term (irreflexive? relation)) (v/term (transitive? relation))]) [relation] {}))
(defn acyclic? [relation] (irreflexive? (closure relation)))
(defn equal [a b] (v/equal a b))
