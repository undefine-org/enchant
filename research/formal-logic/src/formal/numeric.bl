(ns formal.numeric (:require [formal.term :as t] [formal.value :as v]))

;; The solver primitives are Euclidean. These are explicitly named language
;; profiles: neither negative operands nor division by zero may disappear.
(defn- integer-operands! [a b]
 (when-not (and (= t/Int (t/sort-of (v/term a))) (= t/Int (t/sort-of (v/term b))))
  (throw (ex-info "Integer arithmetic requires Int terms" {}))))

(defn quotient
 "BEAM/Enchant integer quotient: round toward zero; zero divisor raises."
 [a b]
 (integer-operands! a b)
 (let [x (v/term a) y (v/term b)
       nonzero (t/not (t/eq y (t/int 0)))
       correction (t/ite (t/all [(t/lt x (t/int 0)) (t/gt (t/mod x y) (t/int 0))])
                         (t/ite (t/gt y (t/int 0)) (t/int 1) (t/int -1)) (t/int 0))]
  (v/scalar (t/add (t/div x y) correction) [a b]
   {:defined (t/all [(v/defined a) (v/defined b) nonzero])
    :domain {:kind :scalar :profile :bl/quot-toward-zero-v1}
    :errors {:zero-divisor (t/not nonzero)}})))

(defn remainder
 "BEAM/Enchant rem: remainder sign follows the dividend."
 [a b]
 (let [q (quotient a b)]
  (v/scalar (t/sub (v/term a) (t/mul (v/term b) (v/term q))) [a b q]
   {:domain {:kind :scalar :profile :bl/rem-dividend-sign-v1}
    :errors (:errors q)})))

(defn modulus
 "Current BL mod: floor modulus, with the divisor's sign. This is distinct
  from SMT-LIB mod for negative divisors."
 [a b]
 (let [r (remainder a b) x (v/term a) y (v/term b) m (v/term r)
       unchanged (t/any [(t/eq m (t/int 0))
                         (t/eq (t/gt x (t/int 0)) (t/gt y (t/int 0)))])]
  (v/scalar (t/ite unchanged m (t/add m y)) [a b r]
   {:domain {:kind :scalar :profile :bl/mod-divisor-sign-v1}
    :errors (:errors r)})))

(defn euclidean-remainder
 "Explicit proposed mathematical profile: nonnegative remainder."
 [a b]
 (integer-operands! a b)
 (let [nonzero (t/not (t/eq (v/term b) (t/int 0)))]
  (v/scalar (t/mod (v/term a) (v/term b)) [a b]
   {:defined (t/all [(v/defined a) (v/defined b) nonzero])
    :domain {:kind :scalar :profile :math/mod-euclidean-v1}
    :errors {:zero-divisor (t/not nonzero)}})))

(defn decimal
 "An exact fixed-scale Decimal model: coefficient * 10^(-scale).
  Scale is a literal representation choice, not an unconstrained exponent."
 [coefficient scale]
 (when-not (and (int? scale) (<= 0 scale) (<= scale 18)
                (= t/Int (t/sort-of (v/term coefficient))))
  (throw (ex-info "Decimal prototype requires Int coefficient and scale 0..18" {})))
 (v/make {:coefficient (v/term coefficient)}
  (merge (v/context [coefficient])
   {:domain {:kind :decimal :scale scale :profile :formal/fixed-scale-decimal-v1}})))

(defn- power-ten [n] (reduce * 1 (repeat n 10)))
(defn decimal-numeric-eq
 "Proposed value equality, preserving exact arithmetic across scales."
 [a b]
 (let [sa (get-in a [:domain :scale]) sb (get-in b [:domain :scale])
       ca (get-in a [:value :coefficient]) cb (get-in b [:value :coefficient])]
  (when-not (and (= :decimal (get-in a [:domain :kind])) (= :decimal (get-in b [:domain :kind])))
   (throw (ex-info "Expected fixed-scale Decimal descriptors" {})))
  (v/scalar (t/eq (t/mul ca (t/int (power-ten sb)))
                  (t/mul cb (t/int (power-ten sa)))) [a b]
   {:domain {:kind :scalar :profile :formal/decimal-numeric-equality-v1}})))

(defn decimal-representation-eq
 "An explicitly separate representation equality: coefficient and scale."
 [a b]
 (v/scalar (t/all [(t/bool (= (get-in a [:domain :scale]) (get-in b [:domain :scale])))
                  (t/eq (get-in a [:value :coefficient]) (get-in b [:value :coefficient]))]) [a b]
  {:domain {:kind :scalar :profile :formal/decimal-representation-equality-v1}}))
