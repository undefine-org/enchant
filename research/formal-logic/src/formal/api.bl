(ns formal.api
 (:require [formal.term :as t] [formal.value :as v] [formal.data :as data]
           [formal.collections :as collections] [formal.numeric :as numeric]
           [formal.relation :as relation] [formal.query :as query]
           [formal.logic :as logic] [formal.backend :as backend]))

;; One functional BL facade. Declarations, callbacks and questions stay pure
;; ordinary language data until check/compare. Callbacks construct a model;
;; evaluating a builder does not prove an arbitrary callback implementation.
(declare symbolic)
(defn- item-factory [spec] (fn [prefix] (symbolic prefix spec)))
(defn symbolic [prefix spec]
 (cond
  (t/sort? spec) (v/lift (t/variable prefix spec))
  (map? spec)
   (case (:kind spec)
    :nullable (data/nullable prefix (:sort spec))
    :option (data/option (t/variable (str prefix ".present") t/Bool)
                        (symbolic (str prefix ".item") (:item spec)))
    :key (data/finite-key prefix (:universe spec))
    :map (collections/map-symbolic prefix (:keys spec) (item-factory (:item spec)))
    :vector (collections/vector-symbolic prefix (:capacity spec) (item-factory (:item spec)))
    :set (collections/set-symbolic prefix (:universe spec))
    :bag (collections/bag-symbolic prefix (:universe spec))
    :bytes (collections/bytes-symbolic prefix (:capacity spec))
    :sum (data/sum prefix (into {} (map (fn [[tag fields]]
                  [tag (into {} (map (fn [[field item]] [field (item-factory item)]) fields))]) (:arms spec))))
    :relation (relation/symbolic prefix (:universe spec))
    :decimal (numeric/decimal (t/variable (str prefix ".coefficient") t/Int) (:scale spec))
    (throw (ex-info "Unknown formal declaration" {:spec spec})))
  :else (throw (ex-info "A formal declaration needs a sort or a semantic schema" {:spec spec}))))

(defn symbols
 "Declare typed symbols with a caller-owned prefix. Reusing a prefix denotes
  the same inputs; distinct model instances need distinct prefixes."
 [prefix schema]
 (when-not (and (string? prefix) (map? schema))
  (throw (ex-info "Symbol declarations need a prefix and field map" {})))
 (into {} (map (fn [[name spec]] [name (symbolic (str prefix "." (str name)) spec)]) schema)))

(defn- build [value symbols] (if (fn? value) (value symbols) value))
(defn question
 "Construct a portable proof/SAT question. :claim, :assumptions and :observe
  can be pure BL builders over the declared symbols or already-built data."
 [symbols specification]
 (query/make (merge specification
               {:inputs (vec (vals symbols))
                :claim (when (contains? specification :claim) (build (:claim specification) symbols))
                :assumptions (build (get specification :assumptions []) symbols)
                :observe (build (get specification :observe symbols) symbols)})))

(defn check [options question] (logic/run options question))
(defn compare
 ([question] (logic/compare question))
 ([question options] (logic/compare question options)))
(defn describe [question]
 (let [roots (query/roots question) nodes (t/walk roots)]
  {:id (:id question) :mode (:mode question) :scope (:scope question)
   :profile (:profile question) :profiles (:profiles question)
   :assumptions (:assumptions question) :question-sha256 (t/digest roots)
   :terms (count nodes) :operations (frequencies (map :op nodes))
   :variables (mapv (fn [term] {:name (:data term) :sort (:sort term)}) (t/variables roots))}))
(defn construction-capabilities [options]
 (backend/with-session options
  (fn [session]
   {:identity (:identity session) :native-advertisement (backend/hello session)
    :qualification :requires-retained-per-fragment-evidence
    :certificate :not-checked :promotion :disabled})))
