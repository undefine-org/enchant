(ns formal.native-cases
 (:require [formal.term :as t] [formal.query :as q]))

;; Pure native-theory fixtures. Construction performs no solver I/O. These
;; exercise mathematical primitives directly, separately from the finite BL
;; collection encodings in formal.feature-cases.
;;
;; :expected is the mathematical proof verdict, not a backend prediction.
;; :expectations records each adapter's acceptable observed evidence. A gap
;; permits only unknown/unsupported; it never counts as matching a theorem.
;; :candidate is allowed only when SAT replay lacks that domain's interpreter.
;; Errors, invalid models, vacuous proofs and opposing decisive statuses are
;; absent from every mathematical case's accepted evidence.
(defn- case-of [id family property expected observations]
 (let [status (if (= expected :proved) :unsat :sat)
       evidence {:solver-statuses #{status} :verdicts #{expected}}]
  {:id id :family family :property property :assumptions []
   :observations observations :expected expected
   :scope {:mode :exact :theory family}
   :profile :smt/native-mathematical-v1
   :expectations {:z3 evidence :oxiz evidence}}))

(defn- assume [case terms] (assoc case :assumptions (vec terms)))
(defn- unknown-ok [case backend reason]
 (-> case
     (update-in [:expectations backend :solver-statuses] conj :unknown)
     (update-in [:expectations backend :verdicts] conj :unknown)
     (assoc-in [:expectations backend :incompleteness] reason)))
(defn- gap [case backend reason]
 (assoc-in case [:expectations backend]
  {:solver-statuses #{:unsupported :unknown} :verdicts #{:unsupported :unknown}
   :capability-gap reason}))
(defn- incomplete-replay [case]
 (-> case
     (update-in [:expectations :z3 :verdicts] conj :candidate)
     (update-in [:expectations :oxiz :verdicts] conj :candidate)
     (assoc :replay :native-sat-is-only-a-candidate-until-domain-replay)))
(defn- note [case text] (assoc case :semantic-note text))
(defn- op [name sort args] (t/app name sort args nil))
(defn- bv [width bits] (t/literal (t/bv-sort width) bits))
(defn- fp [bits] (t/literal (t/fp-sort 5 11) bits))
(defn- rounding [name] (t/literal t/Rounding name))
(defn- text-length [text] (op :str-len t/Int [text]))

(defn scalar-cases []
 (let [p (t/variable "native.bool.p" t/Bool)
       a (t/variable "native.int.a" t/Int)
       b (t/variable "native.int.b" t/Int)
       huge (t/int (erlang/bsl 1 100))
       flag (t/variable "native.track-flag" t/Bool)]
  [(case-of :native-bool/de-morgan :native-booleans
    (t/eq (t/not (t/all [p (t/bool true)]))
          (t/any [(t/not p) (t/bool false)])) :proved {"p" p})
   (case-of :native-bool/xor-truth-table :native-booleans
    (t/eq (op :xor t/Bool [p (t/bool true)]) (t/not p)) :proved {"p" p})
   (case-of :native-bool/ite-selects-arithmetic :native-booleans
    (t/eq (t/ite p a a) a) :proved {"p" p "a" a})
   (case-of :native-bool/distinct-is-not-inequality-chain :native-booleans
    (t/not (t/distinct [(t/int 1) (t/int 2) (t/int 1)])) :proved {})
   (case-of :native-int/unbounded-add-cancel :native-integers
    (t/eq (t/sub (t/add a b) b) a) :proved {"a" a "b" b})
   (case-of :native-int/beyond-machine-integer :native-integers
    (t/eq (t/sub (t/add huge (t/int 1)) huge) (t/int 1)) :proved {"huge" huge})
   (case-of :native-int/negation-and-order :native-integers
    (t/eq (t/lt (t/neg a) (t/neg b)) (t/gt a b)) :proved {"a" a "b" b})
   (case-of :native-int/addition-is-not-always-increasing :native-integers
    (t/gt (t/add a b) a) :refuted {"a" a "b" b})
   (case-of :native-int/euclidean-negative-dividend :native-integers
    (t/all [(t/eq (t/div (t/int -7) (t/int 3)) (t/int -3))
            (t/eq (t/mod (t/int -7) (t/int 3)) (t/int 2))]) :proved {})
   (case-of :native-int/euclidean-negative-divisor :native-integers
    (t/all [(t/eq (t/div (t/int 7) (t/int -3)) (t/int -2))
            (t/eq (t/mod (t/int 7) (t/int -3)) (t/int 1))
            (t/eq (t/mod (t/int -7) (t/int -3)) (t/int 2))]) :proved {})
   (assume
    (case-of :native-int/guarded-euclidean-decomposition :native-integers
     (t/all [(t/eq a (t/add (t/mul b (t/div a b)) (t/mod a b)))
             (t/ge (t/mod a b) (t/int 0))
             (t/lt (t/mod a b) (t/ite (t/lt b (t/int 0)) (t/neg b) b))])
     :proved {"dividend" a "divisor" b}) [(t/not (t/eq b (t/int 0)))])
   (assume
    (case-of :native-identity/assertion-label-does-not-force-source-variable :native-symbols
     (t/not flag) :proved {"flag" flag})
    [(q/assertion "formal.var.native.track-flag" (t/not flag))])
   (case-of :native-identity/punctuation-is-a-symbol :native-symbols
    (let [x (t/variable ") (assert false) ; λ" t/Int)]
     (t/eq (t/sub (t/add x (t/int 1)) x) (t/int 1))) :proved {})]))

(defn real-cases []
 (let [x (t/variable "native.real.x" t/Real)
       third (t/real 1 3) sixth (t/real 1 6)
       large (t/real (erlang/bsl 1 80) 3)]
  [(case-of :native-real/exact-rational-addition :native-reals
    (t/eq (t/add third sixth) (t/real 1 2)) :proved
    {"third" third "sixth" sixth "sum" (t/add third sixth)})
   (case-of :native-real/normalized-denominator-sign :native-reals
    (t/eq (t/add (t/real 2 -6) third) (t/real 0 1)) :proved {})
   (case-of :native-real/exact-multiply-and-negate :native-reals
    (t/eq (t/mul (t/neg (t/real 2 3)) (t/real 9 4)) (t/real -3 2)) :proved {})
   (case-of :native-real/exact-rational-division :native-reals
    (t/eq (t/div third (t/real 2 5)) (t/real 5 6)) :proved {})
   (case-of :native-real/linear-dense-witness :native-reals
    (t/eq x (t/real 0 1)) :refuted {"x" x})
   (assume
    (case-of :native-real/guarded-division-restores-value :native-reals
     (t/eq (t/mul (t/div (t/real 1 1) x) x) (t/real 1 1)) :proved {"x" x})
    [(t/not (t/eq x (t/real 0 1)))])
   (gap
    (case-of :native-real/large-rational-literal :native-reals
     (t/eq (t/sub (t/add large third) large) third) :proved {"large" large})
    :oxiz "OxiZ 0.3.4 RealConst uses normalized i64 numerator/denominator")
   (-> (case-of :native-real/nonlinear-square-nonnegative :nonlinear-real-arithmetic
        (t/ge (t/mul x x) (t/real 0 1)) :proved {"x" x})
       (unknown-ok :oxiz "Native nonlinear solving is incomplete; unknown is not proof"))
   (-> (case-of :native-int/nonlinear-square-nonnegative :nonlinear-integer-arithmetic
        (let [i (t/variable "native.nonlinear.i" t/Int)]
         (t/ge (t/mul i i) (t/int 0))) :proved {})
       (unknown-ok :oxiz "Native nonlinear integer solving is incomplete"))
   (-> (case-of :native-int/no-integer-square-root-of-two :nonlinear-integer-arithmetic
        (let [i (t/variable "native.nonlinear.root" t/Int)]
         (t/not (t/eq (t/mul i i) (t/int 2)))) :proved {})
       (unknown-ok :oxiz "Integer nonlinearity must not be silently relaxed to Real"))]))

(defn conversion-cases []
 (let [i (t/variable "native.convert.i" t/Int)
       as-real (op :to-real t/Real [i])
       integral (t/real 9 3) fraction (t/real -3 2)]
  (mapv (fn [case] (gap case :oxiz "OxiZ has no exposed native Int/Real conversion constructors"))
   [(case-of :native-conversion/int-real-roundtrip :mixed-integer-real
     (t/eq (op :to-int t/Int [as-real]) i) :proved {"integer" i "real" as-real})
    (case-of :native-conversion/to-int-floors-negative-rational :mixed-integer-real
     (t/eq (op :to-int t/Int [fraction]) (t/int -2)) :proved {})
    (case-of :native-conversion/is-int-separates-rationals :mixed-integer-real
     (t/all [(op :is-int t/Bool [integral]) (t/not (op :is-int t/Bool [fraction]))]) :proved {})
    (case-of :native-conversion/floor-is-not-truncation :mixed-integer-real
     (t/eq (op :to-int t/Int [fraction]) (t/int -1)) :refuted {})])))

(defn array-cases []
 (let [sort (t/array-sort t/Int t/Int)
       a (t/variable "native.array.a" sort) b (t/variable "native.array.b" sort)
       i (t/variable "native.array.i" t/Int) j (t/variable "native.array.j" t/Int)
       x (t/variable "native.array.x" t/Int)
       zero (t/const-array t/Int (t/int 0))
       after (t/store a i x)]
  [(case-of :native-array/read-after-write :native-arrays
    (t/eq (t/select after i) x) :proved {"array" a "key" i "value" x})
   (assume
    (case-of :native-array/other-key-preserved :native-arrays
     (t/eq (t/select after j) (t/select a j)) :proved {"array" a "written" i "other" j})
    [(t/not (t/eq i j))])
   (case-of :native-array/write-back-is-extensional-identity :native-arrays
    (t/eq (t/store a i (t/select a i)) a) :proved {"array" a "key" i})
   (case-of :native-array/last-write-wins :native-arrays
    (t/eq (t/select (t/store (t/store zero i (t/int 1)) i (t/int 2)) i) (t/int 2)) :proved {})
   (case-of :native-array/constant-array-has-total-reads :native-arrays
    (t/eq (t/select zero i) (t/int 0)) :proved {"key" i})
   (case-of :native-array/ground-store-replay :native-arrays
    (t/eq (t/select (t/store zero (t/int 5) (t/int 9)) (t/int 5)) (t/int 0))
    :refuted {"read" (t/select (t/store zero (t/int 5) (t/int 9)) (t/int 5))})
   (-> (assume
        (case-of :native-array/one-read-does-not-prove-extensional-equality :native-arrays
         (t/eq a b) :refuted {"left" a "right" b "same-at" i})
        [(t/eq (t/select a i) (t/select b i))])
       incomplete-replay
       (unknown-ok :oxiz "Context array honesty gate may refuse a nonmaterialized array witness"))
   (-> (case-of :native-array/all-indices-extensionality :quantified-arrays
        (let [k (t/bound "native.array.extensional.k" t/Int)]
         (t/implies (t/forall [k] (t/eq (t/select a k) (t/select b k))) (t/eq a b)))
        :proved {"left" a "right" b})
       (unknown-ok :oxiz "Quantified array extensionality requires a supported combination"))
   (case-of :native-array/boolean-index-extensionality :native-arrays
    (let [sort (t/array-sort t/Bool t/Int)
          left (t/variable "native.array.bool-left" sort)
          right (t/variable "native.array.bool-right" sort)]
     (t/implies (t/all [(t/eq (t/select left (t/bool false)) (t/select right (t/bool false)))
                       (t/eq (t/select left (t/bool true)) (t/select right (t/bool true)))])
                (t/eq left right))) :proved {})
   (-> (case-of :native-array/opaque-array-does-not-erase-sat :native-model-observations
        (t/bool false) :refuted {"full-array" zero "scalar-read" (t/select zero (t/int 4))})
       (assoc :expected-model-statuses #{:partial})
       (note "The whole array is opaque; its scalar read is concrete. SAT remains SAT."))]))

(defn enum-and-uf-cases []
 (let [color (t/enum-sort "NativeColor" ["red" "green" "blue"])
       c (t/variable "native.enum.color" color)
       red (t/literal color "red") green (t/literal color "green") blue (t/literal color "blue")
       u (t/uninterpreted-sort "NativeEntity")
       x (t/variable "native.uf.x" u) y (t/variable "native.uf.y" u)
       f (fn [arg] (t/uf "native.score" [u] t/Int [arg]))]
  [(case-of :native-enum/constructors-are-distinct :native-enumerations
    (t/distinct [red green blue]) :proved {})
   (case-of :native-enum/domain-is-exhaustive :native-enumerations
    (t/any [(t/eq c red) (t/eq c green) (t/eq c blue)]) :proved {"color" c})
   (case-of :native-enum/not-every-value-is-red :native-enumerations
    (t/eq c red) :refuted {"color" c})
   (case-of :native-uf/congruence :native-uninterpreted-functions
    (t/implies (t/eq x y) (t/eq (f x) (f y))) :proved {"x" x "y" y})
   (-> (assume
        (case-of :native-uf/injectivity-is-not-automatic :native-uninterpreted-functions
         (t/not (t/eq (f x) (f y))) :refuted {"x" x "y" y "f-x" (f x) "f-y" (f y)})
        [(t/not (t/eq x y))])
       incomplete-replay)
   (case-of :native-uf/zero-arity-declaration :native-uninterpreted-functions
    (let [constant (t/uf "native.zero-arity" [] t/Int [])]
     (t/eq (t/sub (t/add constant (t/int 1)) constant) (t/int 1))) :proved {})
   (-> (case-of :native-sort/uninterpreted-domain-need-not-be-singleton :native-uninterpreted-sorts
        (t/eq x y) :refuted {"x" x "y" y})
       incomplete-replay)
   (case-of :native-sort/model-local-values-do-not-erase-ground-sat :native-model-observations
    (t/bool false) :refuted {"opaque-entity" x})]))

(defn quantifier-cases []
 (let [x (t/bound "native.quantifier.x" t/Int)
       y (t/bound "native.quantifier.y" t/Int)
       a (t/variable "native.quantifier.free-a" t/Int)]
  [(-> (case-of :native-quantifier/integer-successor-order :native-quantifiers
        (t/forall [x] (t/gt (t/add x (t/int 1)) x)) :proved {})
       (unknown-ok :oxiz "Quantifier instantiation is incomplete"))
   (-> (case-of :native-quantifier/predecessor-exists-below-free-value :native-quantifiers
        (t/exists [x] (t/lt x a)) :proved {"free-value" a})
       (unknown-ok :oxiz "An existential mathematical law may exceed native instantiation"))
   (-> (case-of :native-quantifier/nested-alternation-preserves-binder-identity :native-quantifiers
        (t/forall [x] (t/exists [y] (t/eq y (t/add x (t/int 1))))) :proved {})
       (unknown-ok :oxiz "Alternating quantifiers have no completeness guarantee"))
   (-> (case-of :native-quantifier/integers-are-not-all-nonnegative :native-quantifiers
        (t/forall [x] (t/ge x (t/int 0))) :refuted {})
       incomplete-replay
       (unknown-ok :oxiz "A SAT quantifier answer requires separate quantified replay"))
   (-> (case-of :native-quantifier/bound-and-free-namespaces-are-distinct :native-quantifiers
        (let [free (t/variable "native.quantifier.x" t/Int)]
         (t/forall [x] (t/eq x free))) :refuted {})
       incomplete-replay
       (unknown-ok :oxiz "Native quantification must not capture a same-spelled free variable"))]))

(defn bv-cases []
 (let [s8 (t/bv-sort 8) s16 (t/bv-sort 16)
       x (t/variable "native.bv.x" s8)
       plus-one (op :bv-add s8 [x (bv 8 1)])
       word (op :bv-concat s16 [(bv 8 18) (bv 8 52)])]
  [(case-of :native-bv/addition-wraps :native-bitvectors
    (t/eq (op :bv-add s8 [(bv 8 255) (bv 8 1)]) (bv 8 0)) :proved {})
   (case-of :native-bv/subtraction-and-negation-wrap :native-bitvectors
    (t/all [(t/eq (op :bv-sub s8 [(bv 8 0) (bv 8 1)]) (bv 8 255))
            (t/eq (op :bv-neg s8 [(bv 8 1)]) (bv 8 255))]) :proved {})
   (case-of :native-bv/multiplication-wraps :native-bitvectors
    (t/eq (op :bv-mul s8 [(bv 8 32) (bv 8 8)]) (bv 8 0)) :proved {})
   (case-of :native-bv/bitwise-operations :native-bitvectors
    (t/all [(t/eq (op :bv-and s8 [(bv 8 170) (bv 8 15)]) (bv 8 10))
            (t/eq (op :bv-or s8 [(bv 8 160) (bv 8 15)]) (bv 8 175))
            (t/eq (op :bv-xor s8 [(bv 8 170) (bv 8 255)]) (bv 8 85))
            (t/eq (op :bv-not s8 [(bv 8 170)]) (bv 8 85))]) :proved {})
   (case-of :native-bv/shifts-distinguish-arithmetic-sign :native-bitvectors
    (t/all [(t/eq (op :bv-shl s8 [(bv 8 1) (bv 8 7)]) (bv 8 128))
            (t/eq (op :bv-lshr s8 [(bv 8 128) (bv 8 1)]) (bv 8 64))
            (t/eq (op :bv-ashr s8 [(bv 8 128) (bv 8 1)]) (bv 8 192))]) :proved {})
   (case-of :native-bv/overshift-is-total :native-bitvectors
    (t/all [(t/eq (op :bv-shl s8 [(bv 8 1) (bv 8 8)]) (bv 8 0))
            (t/eq (op :bv-lshr s8 [(bv 8 255) (bv 8 9)]) (bv 8 0))
            (t/eq (op :bv-ashr s8 [(bv 8 128) (bv 8 8)]) (bv 8 255))]) :proved {})
   (case-of :native-bv/signed-and-unsigned-order-differ :native-bitvectors
    (t/all [(op :bv-slt t/Bool [(bv 8 255) (bv 8 0)])
            (t/not (op :bv-ult t/Bool [(bv 8 255) (bv 8 0)]))
            (op :bv-sle t/Bool [(bv 8 128) (bv 8 128)])
            (op :bv-ule t/Bool [(bv 8 255) (bv 8 255)])]) :proved {})
   (case-of :native-bv/concat-declares-high-byte-first :native-bitvectors
    (t/eq word (bv 16 4660)) :proved {"word" word})
   (case-of :native-bv/extract-has-inclusive-bit-indices :native-bitvectors
    (t/all [(t/eq (t/app :bv-extract s8 [word] [15 8]) (bv 8 18))
            (t/eq (t/app :bv-extract s8 [word] [7 0]) (bv 8 52))]) :proved {})
   (case-of :native-bv/extensions-preserve-signedness :native-bitvectors
    (t/all [(t/eq (t/app :bv-zero-extend s16 [(bv 8 128)] 8) (bv 16 128))
            (t/eq (t/app :bv-sign-extend s16 [(bv 8 128)] 8) (bv 16 65408))]) :proved {})
   (case-of :native-bv/symbolic-overflow-is-a-counterexample :native-bitvectors
    (op :bv-ult t/Bool [x plus-one]) :refuted {"x" x "x-plus-one" plus-one})]))

(defn text-cases []
 (let [nul (erlang/list_to_binary (list 0))
       embedded (erlang/list_to_binary (list 65 0 66))
       escape-looking (erlang/list_to_binary (list 92 117 123 52 49 125))
       high (unicode/characters_to_binary (list 196607))
       outside (unicode/characters_to_binary (list 196608))
       x (t/variable "native.text.x" t/String) y (t/variable "native.text.y" t/String)]
  [(case-of :native-text/codepoints-are-not-utf8-bytes :native-unicode-text
    (t/all [(t/eq (text-length (t/text "é")) (t/int 1))
            (t/eq (text-length (t/text "🙂")) (t/int 1))]) :proved {})
   (case-of :native-text/codepoints-are-not-graphemes :native-unicode-text
    (t/eq (text-length (t/text "é")) (t/int 1)) :refuted {})
   (case-of :native-text/nul-is-an-ordinary-character :native-unicode-text
    (t/all [(t/eq (text-length (t/text embedded)) (t/int 3))
            (t/eq (op :str-at t/String [(t/text embedded) (t/int 1)]) (t/text nul))
            (op :str-contains t/Bool [(t/text embedded) (t/text nul)])]) :proved {})
   (case-of :native-text/escape-looking-data-is-not-parsed :native-unicode-text
    (t/eq (text-length (t/text escape-looking)) (t/int 6)) :proved {"literal" (t/text escape-looking)})
   (case-of :native-text/alphabet-upper-bound-is-supported :native-unicode-text
    (t/eq (text-length (t/text high)) (t/int 1)) :proved {"text" (t/text high)})
   (-> (case-of :native-text/beyond-smt-alphabet-is-explicitly-unsupported :native-boundaries
        (t/eq (text-length (t/text outside)) (t/int 1)) :proved {})
       (gap :z3 "SMT Unicode alphabet ends at U+2FFFF; no byte or grapheme coercion")
       (gap :oxiz "SMT Unicode alphabet ends at U+2FFFF; no byte or grapheme coercion"))
   (case-of :native-text/prefix-suffix-and-contains :native-unicode-text
    (t/all [(op :str-prefix t/Bool [(t/text "é") (t/text "éab")])
            (op :str-suffix t/Bool [(t/text "ab") (t/text "éab")])
            (op :str-contains t/Bool [(t/text "aébc") (t/text "éb")])]) :proved {})
   (case-of :native-text/index-is-codepoint-offset :native-unicode-text
    (t/all [(t/eq (op :str-index t/Int [(t/text "éaé") (t/text "é") (t/int 1)]) (t/int 2))
            (t/eq (op :str-index t/Int [(t/text "abc") (t/text "z") (t/int 0)]) (t/int -1))]) :proved {})
   (case-of :native-text/substring-and-outside-at-are-total :native-unicode-text
    (t/all [(t/eq (op :str-substr t/String [(t/text "a🙂bc") (t/int 1) (t/int 2)]) (t/text "🙂b"))
            (t/eq (op :str-at t/String [(t/text "abc") (t/int -1)]) (t/text ""))
            (t/eq (op :str-substr t/String [(t/text "abc") (t/int -1) (t/int 2)]) (t/text ""))]) :proved {})
   (case-of :native-text/replace-changes-first-occurrence :native-unicode-text
    (t/eq (op :str-replace t/String [(t/text "aba") (t/text "a") (t/text "z")]) (t/text "zba")) :proved {})
   (-> (case-of :native-text/symbolic-concat-length :native-unicode-text
        (t/eq (text-length (op :str-concat t/String [x y])) (t/add (text-length x) (text-length y)))
        :proved {"left" x "right" y})
       (unknown-ok :oxiz "String solving and arithmetic combination may remain incomplete"))]))

(defn sequence-cases []
 (let [s (t/seq-sort t/Int)
       empty (op :seq-empty s [])
       one (op :seq-unit s [(t/int 10)])
       two (op :seq-concat s [one (op :seq-unit s [(t/int 20)])])]
  (mapv (fn [case] (gap case :oxiz "OxiZ has no native generic Seq sort or constructor route"))
   [(case-of :native-seq/empty-and-unit-length :native-sequences
     (t/all [(t/eq (op :seq-len t/Int [empty]) (t/int 0))
             (t/eq (op :seq-len t/Int [one]) (t/int 1))]) :proved {})
    (case-of :native-seq/concat-preserves-order :native-sequences
     (t/all [(t/eq (op :seq-len t/Int [two]) (t/int 2))
             (t/eq (op :seq-nth t/Int [two (t/int 0)]) (t/int 10))
             (t/eq (op :seq-nth t/Int [two (t/int 1)]) (t/int 20))]) :proved {})
    (case-of :native-seq/extract-is-a-sequence :native-sequences
     (t/eq (op :seq-extract s [two (t/int 1) (t/int 1)]) (op :seq-unit s [(t/int 20)])) :proved {})
    (case-of :native-seq/scalar-nth-can-be-observed :native-model-observations
     (t/bool false) :refuted {"sequence" two "element" (op :seq-nth t/Int [two (t/int 1)])})])))

(defn fp-cases []
 (let [s (t/fp-sort 5 11) rne (rounding "RNE")
       plus-zero (fp 0) minus-zero (fp 32768)
       half (fp 14336) one (fp 15360) two (fp 16384)
       infinity (fp 31744) nan-a (fp 32256) nan-b (fp 31745)
       symbolic-rm (t/variable "native.fp.rounding" t/Rounding)]
  [(case-of :native-fp/signed-zero-structural-distinction :native-floating-point
    (t/eq plus-zero minus-zero) :refuted {"plus-zero" plus-zero "minus-zero" minus-zero})
   (case-of :native-fp/signed-zero-ieee-equality :native-floating-point
    (op :fp-eq t/Bool [plus-zero minus-zero]) :proved {})
   (case-of :native-fp/negation-flips-zero-sign :native-floating-point
    (t/eq (op :fp-neg s [plus-zero]) minus-zero) :proved {})
   (case-of :native-fp/nan-is-not-ieee-reflexive :native-floating-point
    (t/not (op :fp-eq t/Bool [nan-a nan-a])) :proved {})
   (-> (case-of :native-fp/nan-payloads-collapse-in-smt-sort :native-floating-point
        (t/eq nan-a nan-b) :proved {})
       (note "SMT FP has one NaN. Equality of source IEEE payload bitvectors is a separate BV question."))
   (-> (case-of :native-fp/nan-sign-is-not-smt-identity :native-floating-point
        (t/eq nan-a (fp 65024)) :proved {})
       (note "NaN literal import normalizes sign and payload only; non-NaN bit patterns retain their meaning."))
   (-> (case-of :native-fp/negating-nan-retains-smt-identity :native-floating-point
        (t/eq (op :fp-neg s [nan-a]) nan-a) :proved {})
       (unknown-ok :oxiz "Symbolic/derived FP operations remain incomplete beyond literal normalization"))
   (case-of :native-fp/uf-congruence-respects-single-nan :native-uninterpreted-functions
    (let [f (fn [arg] (t/uf "native.fp.nan-function" [s] t/Int [arg]))]
     (t/eq (f nan-a) (f nan-b))) :proved {})
   (-> (assume
        (case-of :native-fp/nan-equality-must-replay-as-smt-equality :native-floating-point
         (t/bool false) :refuted {"nan-predicate" (op :fp-is-nan t/Bool [nan-a])})
        [(t/eq nan-a nan-b)])
       (note "A NaN-payload equality assumption is satisfiable. Raw-bit equality must not invalidate the model."))
   (case-of :native-fp/nan-and-infinity-classifications :native-floating-point
    (t/all [(op :fp-is-nan t/Bool [nan-a])
            (t/not (op :fp-is-inf t/Bool [nan-a]))
            (op :fp-is-inf t/Bool [infinity])
            (t/not (op :fp-is-nan t/Bool [infinity]))]) :proved {})
   (case-of :native-fp/order-treats-signed-zero-as-equal :native-floating-point
    (t/all [(t/not (op :fp-lt t/Bool [minus-zero plus-zero]))
            (op :fp-le t/Bool [plus-zero minus-zero])]) :proved {})
   (case-of :native-fp/literal-rounding-arithmetic :native-floating-point
    (t/all [(t/eq (op :fp-add s [rne one one]) two)
            (t/eq (op :fp-sub s [rne one one]) plus-zero)
            (t/eq (op :fp-mul s [rne two half]) one)
            (t/eq (op :fp-div s [rne one plus-zero]) infinity)]) :proved {})
   (-> (assume
        (case-of :native-fp/symbolic-rounding-is-a-native-domain :native-floating-point
         (t/eq (op :fp-add s [symbolic-rm one one]) two) :proved {"rounding" symbolic-rm})
        [(t/eq symbolic-rm rne)])
       (gap :oxiz "OxiZ FP arithmetic constructors take literal RoundingMode enums"))
   (-> (case-of :native-fp/ieee-bit-observation-preserves-zero-sign :native-floating-point
        (t/eq (op :fp-to-ieee-bv (t/bv-sort 16) [minus-zero]) (bv 16 32768)) :proved {})
       (gap :oxiz "OxiZ does not expose a native FP-to-IEEE-BV constructor"))
   (-> (case-of :native-fp/nan-observation-availability-is-separate-from-sat :native-model-observations
        (t/bool false) :refuted {"nan" nan-a "is-nan" (op :fp-is-nan t/Bool [nan-a])})
       (assoc :expected-model-statuses #{:partial})
       (note "NaN has no stable model IEEE payload; its classification can still be concrete."))
   (-> (case-of :native-fp/oversized-format-is-explicitly-unsupported :native-boundaries
        (let [wide (t/literal (t/fp-sort 32 97) 0)] (t/eq wide wide)) :proved {})
       (gap :z3 "Adapter's explicit FP format bound is 128 total bits")
       (gap :oxiz "Adapter's explicit FP format bound is 128 total bits"))
   (-> (case-of :native-rounding/array-contained-rounding-domain :native-boundaries
        (let [array (t/const-array t/Int rne)] (t/eq (t/select array (t/int 0)) rne)) :proved {})
       (gap :oxiz "Native RM finite-domain closure is only exposed for scalar constants"))
   (-> (case-of :native-rounding/quantified-domain-has-five-values :native-boundaries
        (let [r (t/bound "native.rm.bound" t/Rounding)]
         (t/forall [r] (t/any (mapv (fn [name] (t/eq r (rounding name))) ["RNE" "RNA" "RTP" "RTN" "RTZ"]))))
        :proved {})
       (gap :oxiz "Native RM quantification requires domain-relativization machinery"))
   (-> (case-of :native-rounding/uf-domain-retains-rounding-sort :native-boundaries
        (let [f (fn [r] (t/uf "native.rm.function" [t/Rounding] t/Int [r]))]
         (t/implies (t/eq symbolic-rm rne) (t/eq (f symbolic-rm) (f rne)))) :proved {})
       (gap :oxiz "Native RM-containing UF signatures need finite-domain closure machinery"))]))

(defn cases []
 (vec (concat (scalar-cases) (real-cases) (conversion-cases) (array-cases)
              (enum-and-uf-cases) (quantifier-cases) (bv-cases) (text-cases)
              (sequence-cases) (fp-cases))))

(defn problem [case] (q/from-case case))

(defn frontend-boundaries
 "Pure construction/export checks. These are invalid inputs, not mathematical
  disagreements, and must be run separately from cases by the host harness."
 []
 [{:id :native-boundary/escaped-binder :expected :rejected
   :reason :free-bound-variable :scope {:mode :protocol-validation}
   :construct (fn []
               (let [x (t/bound "native.invalid.escaped" t/Int)]
                (t/export (t/registry) [(t/eq x (t/int 0))])))}
  {:id :native-boundary/zero-width-bv :expected :rejected
   :reason :invalid-sort :scope {:mode :frontend-validation}
   :construct (fn [] (t/bv-sort 0))}
  {:id :native-boundary/negative-bv-literal :expected :rejected
   :reason :literal-outside-sort :scope {:mode :frontend-validation}
   :construct (fn [] (bv 8 -1))}
  {:id :native-boundary/mismatched-uf-arguments :expected :rejected
   :reason :argument-sort-mismatch :scope {:mode :frontend-validation}
   :construct (fn [] (t/uf "native.invalid.uf" [t/Int] t/Bool [(t/bool true)]))}
  {:id :native-boundary/mixed-real-int-without-conversion :expected :rejected
   :reason :explicit-conversion-required :scope {:mode :frontend-validation}
   :construct (fn [] (t/add (t/int 1) (t/real 1 2)))}])
