(ns formal.presentation (:require [dossier.ui :as ui]))

;; Pure public renderers shared by /views and the discovered /explorer.
(defn ^{:ui {:id "formal-answer" :family "Evidence" :title "An answer with its meaning"
 :use "Distinguish a theorem, a counterexample and an incomplete candidate."
 :examples [{:state "Proved" :args [{:engine "Z3" :state "proved" :detail "No counterexample exists under the stated assumptions."}]}
            {:state "Refuted" :args [{:engine "Z3" :state "refuted" :detail "A counterexample was independently replayed."}]}
            {:state "Unknown" :args [{:engine "OxiZ" :state "unknown" :detail "This run did not decide the question."}]}
            {:state "Candidate" :args [{:engine "Z3" :state "candidate" :detail "SAT; independent replay does not cover this domain yet."}]}]}}
 answer-card [{:keys [engine state detail]}]
 [:section {:class (str "fl-answer " state) :data-ui-component "formal-answer"}
  [:div.fl-eyebrow (ui/ico "seal") engine]
  [:strong.fl-answer-state state] [:p detail]])

(defn ^{:ui {:id "formal-comparison" :family "Comparison" :title "Read the same recorded questions"
 :use "Compare a retained corpus without implying a general solver ranking."
 :examples [{:state "Language models" :args [{:title "Language models" :questions 61 :z3 61 :oxiz 56}]}
            {:state "Native probes" :args [{:title "Native probes" :questions 95 :z3 88 :oxiz 55}]}]}}
 comparison-card [{:keys [title questions z3 oxiz]}]
 [:section.fl-comparison {:data-ui-component "formal-comparison"}
  [:div.fl-eyebrow (ui/ico "eye") "Recorded experiment"] [:h3 title]
  [:p (str questions " identical questions · interpreted expected answers")]
  [:div.fl-measures
   (for [[engine n] [["Z3" z3] ["OxiZ" oxiz]]]
    [:div [:strong n] [:span engine] [:small (str "of " questions)]] )]
  [:p.fl-foot "Unknown, unsupported and incomplete replay stay separate. These counts are not a performance benchmark."]])

(defn ^{:ui {:id "formal-trust" :family "Evidence" :title "The promise a result may carry"
 :use "Make the current authority boundary readable beside the result."
 :examples [{:state "Current prototype" :args [{:heading "Inspectable evidence" :body "All experiment results remain untrusted by the compiler. A proof checker is future work."}]}
            {:state "Proposed foundation" :args [{:heading "A proof object, checked" :body "Proposed: validate an explicit proof for this exact claim and its assumptions."}]}]}}
 trust-card [{:keys [heading body]}]
 [:aside.fl-trust {:data-ui-component "formal-trust"}
  (ui/ico "eye") [:div [:strong heading] [:p body]]])

(def topics
 {"maps" {:title "Missing is different from nil" :tag "Language values" :corpus "features"
          :case "map/absence-is-not-present-nil"
          :intro "An absent entry and a present entry holding nil should not become the same value by accident."
          :question "Are an absent lookup and a lookup of present nil equal?"
          :lesson "The claim is refuted. Lookup needs a presence bit as well as a payload."}
  "accounts" {:title "Show where the balance breaks" :tag "State safety" :corpus "features"
              :case "account/missing-guard-counterexample"
              :intro "A state model can expose the input that an unguarded withdrawal forgot."
              :question "Does the unguarded step always preserve a nonnegative balance?"
              :lesson "The counterexample belongs to the explicit integer state model. Add the modeled guard and check the preservation obligation again."}
  "bits" {:title "Byte order is part of the contract" :tag "Binary codecs" :corpus "advanced"
          :case "bits/wrong-byte-order-changes-value"
          :intro "The same bytes can name different values when encoder and decoder choose different byte order."
          :question "Does reading little-endian bytes as big-endian preserve the word?"
          :lesson "The wrong-order identity is refuted. Matching pack/unpack and byte-order laws are proved in the retained codec cases."}
  "fp" {:title "A finite result can fail" :tag "Declared floating point" :corpus "advanced"
        :case "fp/division-zero-is-failed-finite-outcome"
        :intro "A raw IEEE result and a language outcome are different questions."
        :question "Does division by zero fail the declared finite-result profile?"
        :lesson "Z3 proves this binary16 model obligation. OxiZ reports unknown. This does not qualify all BEAM binary64 arithmetic."}})
(def topic-order ["maps" "accounts" "bits" "fp" "evidence"])
(def meanings
 {"proved" "No counterexample was found because the solver established UNSAT for the negated claim, under its assumptions. Certificates remain unchecked."
  "refuted" "A satisfying counterexample was independently replayed for the supported domain."
  "unknown" "This run did not decide the question."
  "unsupported" "The adapter explicitly refused the requested fragment."
  "candidate" "SAT; the available independent replay does not yet cover this domain."})
(defn lab-view [view corpora]
 (let [topic (get topics view) summary (get-in corpora ["features" "summary"])
       row (when topic (first (filter #(= (:case topic) (get % "id")) (get-in corpora [(:corpus topic) "cases"]))))]
  [:div.fl-app {:data-ui-composition view}
   [:header.fl-top [:a.fl-brand {:href "/views?view=maps"} (ui/ico "seal") "Beam Lisp / logic lab"]
    [:span.fl-chip "Recorded research"] [:a {:href "/#s-could-beam-lisp-be-fully-formal" :target "_top"} "The bigger idea ↗"]]
   [:nav.fl-tabs {:aria-label "Explore the experiment"}
    (for [id topic-order]
     [:a {:href (str "/views?view=" id) :aria-current (when (= view id) "page")}
      (get {"maps" "Presence" "accounts" "Account" "bits" "Bytes" "fp" "Floats" "evidence" "Evidence"} id)])]
   [:main.fl-main
    (if (= view "evidence")
     [:div [:div.fl-eyebrow "What we can say today"] [:h1 "A result should explain itself"]
      (comparison-card {:title "Language values and state models" :questions 61
                        :z3 (get-in summary ["z3" "matches"]) :oxiz (get-in summary ["oxiz" "matches"])})
      [:div.fl-answer-grid
       (answer-card {:engine "A concrete witness" :state "refuted" :detail "Replay the original constraints from variable assignments."})
       (answer-card {:engine "A proof candidate" :state "candidate" :detail "An opaque model or an unchecked certificate needs more work."})]
      (trust-card {:heading "Where the stronger foundation begins" :body "A small proof checker and a specified core are proposals. Backend agreement does not give compiler authority."})]
     (if row
      [:div [:div.fl-eyebrow (:tag topic)] [:h1 (:title topic)] [:p.fl-lede (:intro topic)]
       [:section.fl-question [:span "The question"] [:h2 (:question topic)] [:code (get row "id")]]
       [:div.fl-answer-grid
        (for [[key label] [["z3" "Z3"] ["oxiz" "OxiZ"]]]
         (let [answer (get row key) verdict (get answer "verdict")]
          (answer-card {:engine label :state verdict :detail (get meanings verdict "Inspect the retained record.")})))]
       [:section.fl-lesson [:h3 "What this teaches the language"] [:p (:lesson topic)]]
       [:details.fl-record [:summary "Inspect the retained scope and witness"]
        [:dl [:dt "Profile"] [:dd (or (get row "profile") "Recorded on the query")]
         [:dt "Scope"] [:dd [:code (pr-str (get row "scope"))]]]
        [:pre (pr-str (get-in row ["z3" "witness"]))]
        [:a {:href (str "/evidence/" (:corpus topic) ".json") :target "_blank"} "Open the full recorded corpus ↗"]]
       (trust-card {:heading "Meaning stays with the question" :body "Both engines received the same typed claim. The presentation does not run a solver or promote an answer."})]
      [:p "Unknown view."]))]]))
