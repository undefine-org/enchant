(ns formal.matrix
 (:require [formal.term :as t] [formal.query :as q] [formal.logic :as logic]
           [bl.json :as json]))

(defn- receipt [result]
 (merge (select-keys result [:verdict :solver-status :model-status :phase :why :error :wall-us
                            :trusted :witness :identity :core :nodes-imported :scope :profile])
        {:replay (select-keys (:validation result) [:status :kind :checked])}))
(defn- run-case [case engine]
 (let [result (try (logic/run {:backend engine :solver-ms 500 :hard-ms 2000} (q/from-case case))
                (catch error {:verdict :error :solver-status :not-run :error (ex-message error)}))
       expected (:expected case)
       gap (get-in case [:expectations engine])]
  (merge (receipt result)
    {:backend engine :expected expected :matches (= expected (:verdict result))
     :declared-gap gap :accepted (contains? (get gap :accept #{expected}) (:verdict result))})))

(defn run
 "Execute identical pure fixtures on both workers. Retain unknown, incomplete
  model replay and semantic contradictions as distinct observable outcomes."
 [cases]
 (let [rows (mapv (fn [case]
                  (let [z3 (run-case case :z3) oxiz (run-case case :oxiz)
                        decisive (fn [result] (contains? #{:sat :unsat} (:solver-status result)))
                        row {:id (:id case) :family (:family case) :expected (:expected case)
                             :scope (:scope case) :profile (:profile case)
                             :question-sha256 (t/digest (q/roots (q/from-case case)))
                             :z3 z3 :oxiz oxiz
                             :disagreement (and (decisive z3) (decisive oxiz)
                                               (not= (:solver-status z3) (:solver-status oxiz)))}]
                   (println (str (:id case) " z3=" (:verdict z3) " oxiz=" (:verdict oxiz))) row)) cases)
       summary (into {} (map (fn [engine]
                     [engine {:total (count rows)
                              :matches (count (filter #(get-in % [engine :matches]) rows))
                              :verdicts (frequencies (map #(get-in % [engine :verdict]) rows))}]) [:z3 :oxiz]))]
  {:schema 1 :promotion :disabled :summary summary
   :disagreements (mapv :id (filter :disagreement rows))
   :invalid-models (mapv :id (filter #(or (= :invalid-model (get-in % [:z3 :verdict]))
                                       (= :invalid-model (get-in % [:oxiz :verdict]))) rows))
   :cases rows}))

(defn write! [path result]
 (File/write! path (json/encode result {:pretty 2}))
 (println (json/encode (select-keys result [:summary :disagreements :invalid-models]) {:pretty 2}))
 :ok)
