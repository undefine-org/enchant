(ns formal.equality-coherence (:require [decimal]))

;; Minimal permanent reproducer for a law violated by the qualified historical
;; SDK. This is an observation fixture, not an acceptance test that blesses the
;; defect. Requiring it runs nothing. A runtime fix may call assert-coherent!
;; from a focused regression suite; the prototype does not make that suite red.
(defn witness []
 (let [a (decimal/of "1.5") b 1.5 c (decimal/of "1.50")
       ab (= a b) bc (= b c) ac (= a c)
       coherent (or (not (and ab bc)) ac)]
  {:law :equality-transitivity :expected true :observed coherent
   :status (if coherent :coherent-on-this-example :known-failing-observation)
   :sample ["1.5M" "1.5 (binary64)" "1.50M"]
   :comparisons {:a=b ab :b=c bc :a=c ac}
   :violation (and ab bc (not ac))
   :scope "This concrete triple only; success alone does not prove the law."
   :source "priv/boot/rt.bl:2070 k-eqv"
   :historical-evidence "research/formal-logic/evidence/semantic-canaries.json#decimal-float-equality-bridge"}))

(defn assert-coherent! []
 (let [result (witness)]
  (when-not (:observed result)
   (throw (ex-info "Generic equality violates transitivity" result)))
  :ok))
