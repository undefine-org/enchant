+(ns numeric.equality-test (:require [decimal :as d]))
+
+;; Algebraic laws and representation boundaries, rather than a second copy
+;; of the rational comparison implementation. Run on the proposed SDK.
+(def finite-numbers
+ [0 -0.0 0M 0.00M 1 1.0 1M 1.00M 1.5 1.5M 1.50M
+  0.1 0.1M 0.5 0.50M 9007199254740992 9007199254740992.0
+  9007199254740993 -9007199254740993])
+
+(deftest finite-numeric-equality-is-an-equivalence-relation
+ (doseq [a finite-numbers]
+  (is (= a a)))
+ (doseq [a finite-numbers b finite-numbers]
+  (is (= (= a b) (= b a)))
+  (is (= (= a b) (zero? (compare a b)))))
+ (doseq [a finite-numbers b finite-numbers c finite-numbers]
+  (when (and (= a b) (= b c)) (is (= a c)))))
+
