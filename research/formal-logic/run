#!/usr/bin/env bash
set -euo pipefail
project=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
root=$(CDPATH='' cd "$project/../.." && pwd -P)
sdk=$(python3 - "$project/sdk-pin.json" <<'PY'
import hashlib,json,pathlib,sys
pin=json.loads(pathlib.Path(sys.argv[1]).read_text())
descriptor=(pathlib.Path(pin['sdk'])/'artifact.json').read_bytes()
assert hashlib.sha256(descriptor).hexdigest()==pin['descriptor_sha256']
assert json.loads(descriptor)['source']==pin['source']
print(pin['sdk'])
PY
)
worker="$root/research/oxiz-prototype/worker/target/release/formal-worker"
library=$(readlink -f "$sdk/image/priv/z3/bin/libz3.so")
runtime=$(mktemp -d /tmp/enchant-formal-runtime-XXXXXXXX)
trap 'rm -rf -- "$runtime"' EXIT
systemd-run --user --quiet --collect --wait --pipe \
  --working-directory="$root" --property=MemoryMax=4G --property=MemorySwapMax=0 \
  --property=RuntimeMaxSec=900 --property=KillMode=control-group \
  --setenv=ENCHANT_FORMAL_WORKER="$worker" --setenv=ENCHANT_Z3_LIBRARY="$library" \
  --setenv=XDG_RUNTIME_DIR="$runtime" \
  "$sdk/bin/bl" --cold -p "$project/src" -p "$project/test" "$@"
