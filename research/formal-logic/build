#!/usr/bin/env bash
set -euo pipefail
project=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
root=$(CDPATH='' cd "$project/../.." && pwd -P)
exec systemd-run --user --quiet --collect --wait --pipe \
  --working-directory="$root" --property=MemoryMax=4G --property=MemorySwapMax=0 \
  --property=RuntimeMaxSec=1800 --property=KillMode=control-group \
  nix shell --inputs-from "$root" nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc \
  --command cargo build --release --locked -j 1 --bin formal-worker \
  --manifest-path "$root/research/oxiz-prototype/worker/Cargo.toml"
