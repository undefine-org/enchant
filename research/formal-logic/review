#!/usr/bin/env bash
set -euo pipefail
project=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
root=$(CDPATH='' cd "$project/../.." && pwd -P)
sdk=$(python3 - "$project/sdk-pin.json" <<'PY'
import hashlib,json,pathlib,sys
p=json.loads(pathlib.Path(sys.argv[1]).read_text())
assert hashlib.sha256((pathlib.Path(p['sdk'])/'artifact.json').read_bytes()).hexdigest()==p['descriptor_sha256']
print(p['sdk'])
PY
)
kit=/home/othman/projects/enchanted-skills/bl-org-dossier/kit
review_kit=/home/othman/projects/enchanted-skills/codebase-review/kit
mode=${1:-check}
case "$mode" in
  cells)
    exec "$project/run" -p "$kit" -p "$review_kit" doc run "$project/ATLAS.bl.org"
    ;;
  check)
    exec "$project/run" -p "$kit" -p "$review_kit" doc run "$project/ATLAS.bl.org" --check
    ;;
  serve)
    exec systemd-run --user --quiet --collect --wait --pipe \
      --working-directory="$root" --property=MemoryMax=2G --property=MemorySwapMax=0 \
      --property=RuntimeMaxSec=180 --setenv=WORK_BL="$sdk/bin/bl" \
      /home/othman/.nix-profile/bin/work serve enchant-formal-review --http auto \
      --cwd "$root" --env-file /home/othman/.config/baton-dossier/service.env \
      --memory 1G --ready-timeout 120 -- \
      "$sdk/bin/bl" --cold -p "$project/src" -p "$kit" -p "$review_kit" \
      serve "$project/review-serve.bl" -- "$project/ATLAS.bl.org"
    ;;
  url) exec /home/othman/.nix-profile/bin/work url enchant-formal-review ;;
  stop) exec env WORK_BL="$sdk/bin/bl" /home/othman/.nix-profile/bin/work stop enchant-formal-review ;;
  *) echo 'Usage: review cells|check|serve|url|stop' >&2; exit 2 ;;
esac
