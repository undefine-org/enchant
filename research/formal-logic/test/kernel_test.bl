(ns formal.kernel-test (:require [formal.term :as t] [formal.evaluate :as ev]))

(deftest sorts-are-explicit-and-mixing-refuses-before-a-backend
 (is (thrown? (t/add (t/int 1) (t/real 1 1))))
 (is (thrown? (t/eq (t/int 1) (t/bool true))))
 (is (thrown? (t/literal (t/bv-sort 8) 256)))
 (is (thrown? (t/ite (t/int 0) (t/int 1) (t/int 2))))
 (is (= [1 2] (:data (t/real 2 4))))
 (is (= [-1 2] (:data (t/real 1 -2))))
 (is (= [0 1] (:data (t/real 0 -7)))))

(deftest portable-term-dags-share-expressions-and-import-only-new-nodes
 (let [x (t/variable "x" t/Int) a (t/add x (t/int 1))
       first (t/export (t/registry) [(t/eq a a)])
       repeated (t/export (:registry first) [(t/eq a a)])]
  (is (= 4 (count (:nodes first))))
  (is (= 0 (count (:nodes repeated))))
  (is (= (:ids first) (:ids repeated)))
  (is (= 1 (count (t/variables [a]))))
  (is (= (t/digest [a]) (t/digest [(t/add (t/variable "x" t/Int) (t/int 1))])))))

(deftest quantifier-boundaries-and-substitution-remain-typed
 (let [x (t/bound "quant.x" t/Int) body (t/eq x x)
       quantified (t/forall [x] body)]
  (is (= #{"quant.x"} (t/free-bound body)))
  (is (= #{} (t/free-bound quantified)))
  (is (thrown? (t/export (t/registry) [body])))
  (is (pos? (count (:nodes (t/export (t/registry) [quantified]))))))
 (let [x (t/variable "x" t/Int)]
  (is (= (t/add (t/int 2) (t/int 1))
         (t/substitute (t/add x (t/int 1)) {x (t/int 2)})))))

(deftest model-replay-uses-mathematical-primitives-without-solver-evaluation
 (is (= -2 (ev/value (t/div (t/int 7) (t/int -3)) {})))
 (is (= 1 (ev/value (t/mod (t/int 7) (t/int -3)) {})))
 (is (= 3 (ev/value (t/div (t/int -7) (t/int -3)) {})))
 (is (= 2 (ev/value (t/mod (t/int -7) (t/int -3)) {})))
 (is (= {:formal/real [1 3]} (ev/value (t/div (t/real 1 1) (t/real 3 1)) {})))
 (is (= 2 (ev/value (t/app :str-len t/Int [(t/text "é")] nil) {})))
 (is (= "́" (ev/value (t/app :str-at t/String [(t/text "é") (t/int 1)] nil) {})))
 (is (= true (ev/value (t/ite (t/bool true) (t/bool true)
                (t/eq (t/div (t/int 1) (t/int 0)) (t/int 9))) {})))
 (is (ev/unavailable? (ev/value (t/uf "unknown" [t/Int] t/Bool [(t/int 1)]) {}))))

(deftest replay-classifies-an-incorrect-assignment-independently
 (let [x (t/variable "x" t/Int) assertions [{:label "x-positive" :term (t/gt x (t/int 0))}]]
  (is (= :invalid (:status (ev/validate assertions {"x" -1}))))
  (is (= :valid (:status (ev/validate assertions {"x" 1}))))
  (is (= :incomplete (:status (ev/validate assertions {}))))))

(deftest export-validates-forged-data-and-binder-identity
 (let [x (t/variable "x" t/Int) b (t/bound "b" t/Int)]
  (is (thrown? (t/export (t/registry) [(assoc (t/add x (t/int 1)) :sort t/Bool)])))
  (is (thrown? (t/export (t/registry) [(t/eq x x) (t/variable "x" t/Bool)])))
  (is (thrown? (t/export (t/registry) [(t/forall [b b] (t/eq b b))])))
  (is (thrown? (t/export (t/registry) [(t/forall [b] (t/forall [b] (t/eq b b)))])))
  (is (thrown? (t/export (t/registry) [(t/forall [b] (t/eq (t/bound "b" t/Bool) (t/bool true)))])))
  (is (thrown? (t/substitute (t/forall [b] (t/eq x b)) {x b})))
  (is (thrown? (t/substitute x {x (t/bool true)})))
  (is (thrown? (t/substitute b {b (t/int 1)})))))

(deftest fp-model-semantics-respect-smt-nan-and-ieee-zero
 (let [s (t/fp-sort 8 24) nan-a (t/literal s 2143289345) nan-b (t/literal s 2143289346)
       plus-zero (t/literal s 0) minus-zero (t/literal s 2147483648)]
  (is (= true (ev/value (t/eq nan-a nan-b) {})))
  (is (= false (ev/value (t/app :fp-eq t/Bool [nan-a nan-b] nil) {})))
  (is (= false (ev/value (t/eq plus-zero minus-zero) {})))
  (is (= true (ev/value (t/app :fp-eq t/Bool [plus-zero minus-zero] nil) {})))
  (is (ev/unavailable? (ev/value (t/app :fp-to-ieee-bv (t/bv-sort 32) [nan-a] nil) {})))))
