(ns formal.api-test
 (:require [formal.api :as formal] [formal.term :as t] [formal.value :as v]
           [formal.collections :as c] [formal.data :as d]
           [formal.query :as q] [formal.logic :as logic] [formal.backend :as backend]
           [formal.source :as source]))

(deftest one-declaration-and-question-interface-for-language-values
 (let [inputs (formal/symbols "api.example"
                {:ledger {:kind :map :keys [:alice :bob] :item t/Int}
                 :account {:kind :key :universe [:alice :bob]}
                 :amount t/Int})
       problem (formal/question inputs
                 {:id :api/read-after-write
                  :claim (fn [{:keys [ledger account amount]}]
                           (v/equal (d/unwrap (c/map-lookup (c/map-assoc ledger account amount) account)) amount))})]
  (is (= :finite-universe (get-in (formal/describe problem) [:scope :mode])))
  (is (pos? (:terms (formal/describe problem))))
  (doseq [engine [:z3 :oxiz]]
   (is (= :proved (:verdict (formal/check {:backend engine} problem)))))))

(deftest persistent-context-is-visible-in-meaning-replay-and-cache
 (let [x (t/variable "context.x" t/Int) problem (q/prove (t/gt x (t/int 0)))
       fresh (logic/run {:backend :z3} problem)]
  (is (= :refuted (:verdict fresh)))
  (backend/with-session {:backend :z3}
   (fn [session]
    (is (:ok (backend/load! session [(q/assertion "positive" (t/gt x (t/int 0)))])))
    (let [conditional (logic/solve-in session problem)
          witness (logic/solve-in session (q/sat {}))]
     (is (= :proved (:verdict conditional)))
     (is (= ["context/0/positive"] (get-in conditional [:context :assertions])))
     (is (not= (:cache-key fresh) (:cache-key conditional)))
     (is (= :valid (get-in witness [:validation :status])))
     (is (pos? (get (:assignments witness) "context.x"))))))))

(deftest closed-labels-and-source-bindings-use-reviewed-relations
 (is (thrown? (d/finite-key "bad" [1 1.0])))
 (is (thrown? (d/finite-key "bad" [:a :a])))
 (is (thrown? (c/map-symbolic "bad" [1 1.0] t/Int)))
 (is (= :unsupported (:status (source/prepare "(- x)" {"x" (t/variable "x" t/Real)}))))
 (is (= :unsupported (:status (source/prepare "(= x x)" {"x" (t/variable "x" (t/fp-sort 8 24))})))))

(deftest shared-synthesis-and-explanation-have-explicit-finite-contracts
 (doseq [engine [:z3 :oxiz]]
  (let [x (t/variable "grammar.x" t/Int)
        synthesis (logic/synthesize {:backend engine}
                    [[:bad (t/gt x (t/int 0))] [:good (t/gt (t/add x (t/int 1)) x)]] {})
        explanation (logic/explain-unsat {:backend engine}
                       [(q/assertion "positive" (t/gt x (t/int 0)))
                        (q/assertion "negative" (t/lt x (t/int 0)))
                        (q/assertion "irrelevant" (t/bool true))])]
   (is (= :candidate-proved (:status synthesis)) (pr-str synthesis))
   (is (= :good (:candidate synthesis)))
   (is (= :subset-minimal (:status explanation)) (pr-str explanation))
   (is (= #{"positive" "negative"} (set (map :label (:assertions explanation))))))))
