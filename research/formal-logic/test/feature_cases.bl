(ns formal.feature-cases
 (:require [formal.term :as t] [formal.value :as v] [formal.data :as d]
           [formal.collections :as c] [formal.numeric :as n]
           [formal.relation :as relation] [formal.transition :as transition]))

;; Pure fixtures. The root harness chooses the backend, checks the model and
;; records the exact finite/bounded domain. Loading this file performs no I/O.
(defn- case-of [id family inputs property expected observations]
 {:id id :family family
  :assumptions (vec (distinct (concat (mapcat v/constraints inputs)
                              (map v/defined inputs) (map v/within inputs))))
  :property property :observations observations :expected expected
  :scope (v/join-scope inputs)})
(defn- assume [case terms] (update case :assumptions #(vec (concat % terms))))
(defn- nullable-int [prefix] (d/nullable prefix t/Int))

(defn map-cases []
 (let [keys [:a :b :c] m (c/map-symbolic "map.m" keys t/Int)
       k (d/finite-key "map.k" keys) other (d/finite-key "map.other" keys)
       x (t/variable "map.x" t/Int) after (c/map-assoc m k x)
       nil-map (c/map-empty "map.nil" keys nullable-int)
       with-nil (c/map-assoc nil-map :a (d/nil-of t/Int))
       empty-a (c/map-empty "map.emptyA" keys t/Int)
       empty-b (c/map-empty "map.emptyB" keys t/Int)]
  [(case-of :map/assoc-read :finite-maps [m k x]
     (v/equal (d/unwrap (c/map-lookup after k)) x) :proved
     {"before" m "key" k "value" x "after" after})
   (assume
    (case-of :map/other-key-preserved :finite-maps [m k other x]
     (v/equal (c/map-lookup after other) (c/map-lookup m other)) :proved
     {"before" m "written-key" k "other-key" other "after" after})
    [(t/not (t/eq (v/term k) (v/term other)))])
   (assume
    (case-of :map/insert-cardinality :finite-maps [m k x]
     (v/equal (c/map-count after) (t/add (v/term (c/map-count m)) (t/int 1))) :proved
     {"before" m "key" k "after" after})
    [(t/not (v/term (c/map-contains? m k)))])
   (case-of :map/present-nil-is-present :nil-and-presence [nil-map]
     (t/all [(v/term (c/map-contains? with-nil :a))
             (v/term (d/nil? (d/unwrap (c/map-lookup with-nil :a))))
             (t/eq (v/term (c/map-count with-nil)) (t/int 1))]) :proved
     {"absent" (c/map-lookup nil-map :a) "present-nil" (c/map-lookup with-nil :a)})
   (case-of :map/absence-is-not-present-nil :nil-and-presence [nil-map]
     (v/equal (c/map-lookup nil-map :a) (c/map-lookup with-nil :a)) :refuted
     {"absent" (c/map-lookup nil-map :a) "present-nil" (c/map-lookup with-nil :a)})
   (case-of :map/equality-ignores-absent-payload :finite-maps [empty-a empty-b]
     (c/map-equal empty-a empty-b) :proved {"left" empty-a "right" empty-b})
   (case-of :map/outside-universe-is-model-limit :model-boundaries [nil-map]
     (t/all [(v/defined (c/map-assoc nil-map :outside (d/nil-of t/Int)))
             (t/not (v/within (c/map-assoc nil-map :outside (d/nil-of t/Int))))]) :proved
     {"outside-update" (c/map-assoc nil-map :outside (d/nil-of t/Int))})]))

(defn vector-cases []
 (let [xs (c/vector-symbolic "vec.xs" 3 t/Int) x (t/variable "vec.x" t/Int)
       appended (c/vector-conj xs x)
       full (c/vector-symbolic "vec.full" 2 t/Int)
       empty (c/vector-empty "vec.empty" 2 nullable-int)
       with-nil (c/vector-conj empty (d/nil-of t/Int))
       default (d/non-nil (t/int 99))
       present-nil (c/vector-nth-or with-nil (t/int 0) default)
       missing (c/vector-nth-or with-nil (t/int 1) default)
       past-capacity (c/vector-conj full (t/int 4))]
  [(assume
    (case-of :vector/pop-conj-inverse :bounded-vectors [xs x]
     (c/vector-equal (c/vector-pop appended) xs) :proved
     {"before" xs "appended" appended "restored" (c/vector-pop appended)})
    [(t/lt (v/term (c/vector-length xs)) (t/int 3))])
   (assume
    (case-of :vector/assoc-at-count-appends :bounded-vectors [xs x]
     (v/equal (c/vector-length appended) (t/add (v/term (c/vector-length xs)) (t/int 1))) :proved
     {"before" xs "after" appended})
    [(t/lt (v/term (c/vector-length xs)) (t/int 3))])
   (case-of :vector/nth-default-preserves-present-nil :nil-and-presence [empty]
     (t/all [(v/term (d/nil? present-nil)) (v/term (v/equal missing default))]) :proved
     {"present-nil" present-nil "absent-default" missing})
   (case-of :vector/current-negative-nth-is-nil :semantic-profiles [with-nil]
     (d/nil? (c/vector-nth with-nil (t/int -1))) :proved
     {"current-nth" (c/vector-nth with-nil (t/int -1))})
   (case-of :vector/proposed-negative-at-is-undefined :semantic-profiles [with-nil]
     (t/not (v/defined (c/vector-at with-nil (t/int -1)))) :proved
     {"strict-at" (c/vector-at with-nil (t/int -1))})
   (case-of :vector/pop-empty-raises :partial-results [empty]
     (t/not (v/defined (c/vector-pop empty))) :proved {"result" (c/vector-pop empty)})
   (case-of :vector/contains-is-index-membership :semantic-profiles [with-nil]
     (c/vector-contains? with-nil (t/int 0)) :proved {"vector" with-nil})
   (assume
    (case-of :vector/valid-conj-can-exceed-model :model-boundaries [full]
     (t/all [(v/defined past-capacity) (t/not (v/within past-capacity))]) :proved
     {"before" full "after" past-capacity})
    [(t/eq (v/term (c/vector-length full)) (t/int 2))])
   (case-of :vector/all-indices-present-is-false :bounded-vectors [xs]
     (c/vector-contains? xs (t/int 2)) :refuted {"vector" xs})]))

(defn set-bag-cases []
 (let [keys [:read :write :send]
       a (c/set-symbolic "sets.a" keys) b (c/set-symbolic "sets.b" keys)
       bag-a (c/bag-symbolic "bags.a" keys) bag-b (c/bag-symbolic "bags.b" keys)]
  [(case-of :set/union-commutes :finite-sets [a b]
     (c/set-equal (c/set-union a b) (c/set-union b a)) :proved {"left" a "right" b})
   (case-of :set/union-idempotent :finite-sets [a]
     (c/set-equal (c/set-union a a) a) :proved {"set" a})
   (case-of :set/intersection-subset :finite-sets [a b]
     (c/set-subset? (c/set-intersection a b) a) :proved {"left" a "right" b})
   (case-of :set/cardinality-is-not-always-additive :finite-sets [a b]
     (v/equal (c/set-cardinality (c/set-union a b))
       (t/add (v/term (c/set-cardinality a)) (v/term (c/set-cardinality b)))) :refuted
     {"left" a "right" b "union" (c/set-union a b)})
   (case-of :bag/union-cardinality-adds :finite-bags [bag-a bag-b]
     (v/equal (c/bag-cardinality (c/bag-union bag-a bag-b))
       (t/add (v/term (c/bag-cardinality bag-a)) (v/term (c/bag-cardinality bag-b)))) :proved
     {"left" bag-a "right" bag-b})
   (case-of :bag/union-is-not-idempotent :finite-bags [bag-a]
     (c/bag-equal (c/bag-union bag-a bag-a) bag-a) :refuted {"bag" bag-a})]))

(defn data-cases []
 (let [sum (d/sum "result" {:ok {:value t/Int} :error {:code t/Int}})
       null-a (assoc (d/nil-of t/Int) :value {:nil? (t/bool true) :item (t/variable "nil.a" t/Int)})
       null-b (assoc (d/nil-of t/Int) :value {:nil? (t/bool true) :item (t/variable "nil.b" t/Int)})
       exhaustive (d/match sum {:ok (fn [fields] (:value fields)) :error (fn [fields] (:code fields))})
       partial (d/match sum {:ok (fn [fields] (:value fields))})]
  [(case-of :option/none-differs-from-some-nil :options []
     (v/equal (d/none (d/nil-of t/Int)) (d/some (d/nil-of t/Int))) :refuted
     {"none" (d/none (d/nil-of t/Int)) "some-nil" (d/some (d/nil-of t/Int))})
   (case-of :nil/equality-ignores-inactive-number :options [null-a null-b]
     (v/equal null-a null-b) :proved {"left" null-a "right" null-b})
   (case-of :sum/all-constructors-covered :pattern-coverage [sum]
     (d/coverage sum [:ok :error]) :proved {"result" sum})
   (case-of :sum/missing-constructor-witness :pattern-coverage [sum]
     (d/coverage sum [:ok]) :refuted {"result" sum})
   (case-of :sum/strict-selector-needs-constructor :tagged-sums [sum]
     (v/defined (d/field sum :ok :value)) :refuted {"result" sum})
   (case-of :sum/exhaustive-match-defined :pattern-coverage [sum]
     (v/defined exhaustive) :proved {"result" sum "matched" exhaustive})
   (case-of :sum/partial-match-can-fail :pattern-coverage [sum]
     (v/defined partial) :refuted {"result" sum "matched" partial})]))

(defn numeric-cases []
 (let [a (t/variable "numbers.a" t/Int) q (n/quotient a (t/int 3)) r (n/remainder a (t/int 3))
       wrong-mod (n/euclidean-remainder (t/int 7) (t/int -3))
       bl-mod (n/modulus (t/int 7) (t/int -3))
       d100 (n/decimal (t/int 100) 2) d10 (n/decimal (t/int 10) 1)
       raises (n/quotient (t/int 7) (t/int 0))]
  [(case-of :integer/quot-rem-decomposition :integer-semantics [a]
     (v/equal a (t/add (t/mul (t/int 3) (v/term q)) (v/term r))) :proved
     {"input" a "quotient" q "remainder" r})
   (case-of :integer/bl-mod-negative-divisor :integer-semantics []
     (v/equal bl-mod (t/int -2)) :proved {"result" bl-mod})
   (case-of :integer/euclidean-and-bl-mod-differ :semantic-profiles []
     (v/equal bl-mod wrong-mod) :refuted {"bl-mod" bl-mod "euclidean-mod" wrong-mod})
   (case-of :integer/division-zero-is-undefined :partial-results []
     (t/not (v/defined raises)) :proved {"result" raises})
   (case-of :integer/value-only-rewrite-misses-raising :partial-results []
     (v/equivalent raises (t/int 0)) :refuted {"raising" raises "constant" (t/int 0)})
   (case-of :decimal/numeric-equality-cross-scale :exact-decimals [d100 d10]
     (n/decimal-numeric-eq d100 d10) :proved {"left" d100 "right" d10})
   (case-of :decimal/representation-equality-cross-scale :semantic-profiles [d100 d10]
     (n/decimal-representation-eq d100 d10) :refuted {"left" d100 "right" d10})]))

(defn byte-cases []
 (let [bytes (c/bytes-symbolic "bytes" 3) first-byte (c/vector-at bytes (t/int 0))
       nonempty (t/gt (v/term (c/vector-length bytes)) (t/int 0))]
  [(assume
    (case-of :bytes/unsigned-range :bounded-bytes [bytes]
     (t/all [(t/le (t/int 0) (v/term first-byte)) (t/le (v/term first-byte) (t/int 255))]) :proved
     {"bytes" bytes "first" first-byte}) [nonempty])
   (assume
    (case-of :bytes/ascii-is-not-all-bytes :bounded-bytes [bytes]
     (t/le (v/term first-byte) (t/int 127)) :refuted {"bytes" bytes "first" first-byte}) [nonempty])]))

(defn cases []
 (vec (concat (map-cases) (vector-cases) (set-bag-cases) (data-cases) (numeric-cases) (byte-cases))))

(defn relation-cases []
 (let [universe [:alice :bob :carol]
       graph (relation/symbolic "graph" universe)
       chain (-> (relation/empty "chain" universe)
                 (relation/put :alice :bob (t/bool true))
                 (relation/put :bob :carol (t/bool true)))
       cycle (relation/put chain :carol :alice (t/bool true))
       closed (relation/closure graph)]
  [(case-of :relation/closure-is-transitive :finite-relations [graph]
     (relation/transitive? closed) :proved {"edges" graph "closure" closed})
   (case-of :relation/delegation-chain-reaches-carol :permission-relations [chain]
     (relation/edge (relation/closure chain) :alice :carol) :proved {"direct" chain "delegated" (relation/closure chain)})
   (case-of :relation/direct-is-not-transitive-delegation :permission-relations [chain]
     (relation/edge chain :alice :carol) :refuted {"direct" chain})
   (case-of :relation/chain-has-no-cycle :finite-relations [chain]
     (relation/acyclic? chain) :proved {"chain" chain})
   (case-of :relation/cycle-is-detected :finite-relations [cycle]
     (relation/acyclic? cycle) :refuted {"cycle" cycle})
   (case-of :relation/positive-closure-is-not-necessarily-reflexive :finite-relations [chain]
     (relation/reflexive? (relation/closure chain)) :refuted {"closure" (relation/closure chain)})
   (case-of :relation/reflexive-closure-is-reflexive :finite-orders [graph]
     (relation/reflexive? (relation/closure graph {:reflexive true})) :proved {"graph" graph})
   (assume (case-of :relation/partial-order-is-antisymmetric :finite-orders [graph]
             (relation/antisymmetric? graph) :proved {"order" graph})
           [(v/term (relation/partial-order? graph))])]))

(defn- account-model [name guarded]
 (transition/machine name {:balance t/Int}
  {:init (fn [state] (t/eq (:balance state) (t/int 10)))
   :invariant (fn [state] (t/ge (:balance state) (t/int 0)))
   :transitions [{:name :withdraw :inputs {:amount t/Int}
     :guard (fn [state input]
              (t/all (cond-> [(t/ge (:amount input) (t/int 0))]
                       guarded (conj (t/le (:amount input) (:balance state))))))
     :next (fn [state input] {:balance (t/sub (:balance state) (:amount input))})}]}))

(defn- capacity-model [name guarded]
 (transition/machine name {:pending t/Int}
  {:init (fn [state] (t/eq (:pending state) (t/int 0)))
   :invariant (fn [state] (t/all [(t/le (t/int 0) (:pending state)) (t/le (:pending state) (t/int 2))]))
   :transitions [{:name :enqueue :inputs {}
     :guard (fn [state _] (if guarded (t/lt (:pending state) (t/int 2)) (t/bool true)))
     :next (fn [state _] {:pending (t/add (:pending state) (t/int 1))})}]}))

(defn- procedure-case [id family procedure expected]
 (merge procedure {:id id :family family :expected expected}))

(defn transition-cases []
 (let [good (account-model "account.good" true) bad (account-model "account.bad" false)
       good-induction (transition/induction good)
       bad-induction (transition/induction bad)
       bounded (capacity-model "queue.bounded" true) overflow (capacity-model "queue.overflow" false)
       abstract (transition/machine "abstract" {:count t/Int}
                  {:init (fn [state] (t/eq (:count state) (t/int 0)))
                   :transitions [{:name :tick :next (fn [state _] {:count (t/add (:count state) (t/int 1))})}]})
       concrete (transition/machine "concrete" {:twice t/Int}
                  {:init (fn [state] (t/eq (:twice state) (t/int 0)))
                   :transitions [{:name :tick :next (fn [state _] {:twice (t/add (:twice state) (t/int 2))})}]})
       coupled (fn [a b] (t/eq (:twice b) (t/mul (t/int 2) (:count a))))
       inputs (fn [_ _] (t/bool true))]
  [(procedure-case :account/initialization :inductive-invariants (:base good-induction) :proved)
   (procedure-case :account/initial-state-exists :inductive-invariants (:init-feasibility good-induction) :refuted)
   (procedure-case :account/guarded-step-preserves-balance :inductive-invariants (first (:steps good-induction)) :proved)
   (procedure-case :account/missing-guard-counterexample :inductive-invariants (first (:steps bad-induction)) :refuted)
   (procedure-case :account/bounded-safe :bounded-protocols (transition/safety good 2 "account.safe.trace") :proved)
   (procedure-case :account/bounded-overdraft-witness :bounded-protocols (transition/safety bad 1 "account.bad.trace") :refuted)
   (procedure-case :queue/guarded-capacity :bounded-protocols (transition/safety bounded 3 "queue.safe.trace") :proved)
   (procedure-case :queue/overflow-trace :bounded-protocols (transition/safety overflow 3 "queue.bad.trace") :refuted)
   (procedure-case :queue/negative-state-unreachable :bounded-reachability
     (transition/unreachable bounded 3 "queue.reach.trace" (fn [state] (t/lt (:pending state) (t/int 0)))) :proved)
   (procedure-case :simulation/initial-relatedness :transition-simulation
     (transition/simulation-init abstract concrete coupled) :proved)
   (procedure-case :simulation/counter-representation-step :transition-simulation
     (transition/simulation-step abstract :tick concrete :tick coupled inputs) :proved)]))

(defn abstraction-cases []
 (let [a (-> (c/vector-empty "fifo.a" 2 t/Int) (c/vector-conj (t/int 1)) (c/vector-conj (t/int 2)))
       b (-> (c/vector-empty "fifo.b" 2 t/Int) (c/vector-conj (t/int 2)) (c/vector-conj (t/int 1)))
       bag-a (assoc (c/bag-symbolic "fifo.bagA" [1 2]) :value {:counts [(t/int 1) (t/int 1)]} :constraints [])
       bag-b (assoc (c/bag-symbolic "fifo.bagB" [1 2]) :value {:counts [(t/int 1) (t/int 1)]} :constraints [])]
  [(case-of :abstraction/bag-equality-does-not-prove-fifo :abstraction-boundaries [a b bag-a bag-b]
     (t/implies (v/term (c/bag-equal bag-a bag-b)) (v/term (c/vector-equal a b))) :refuted
     {"fifo-a" a "fifo-b" b "bag-a" bag-a "bag-b" bag-b})]))

(defn all-cases []
 (vec (concat (cases) (relation-cases) (transition-cases) (abstraction-cases))))
