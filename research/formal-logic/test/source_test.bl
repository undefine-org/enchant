(ns formal.source-test
 (:require [formal.source :as source] [formal.term :as t] [formal.logic :as logic]
           [formal.query :as q]))

(deftest compiler-anf-expressions-enter-the-same-term-interface
 (let [x (t/variable "source.x" t/Int) y (t/variable "source.y" t/Int)
       bindings {"x" x "y" y}
       samples [["(+ x 1)" "(inc x)"]
                ["(if (< x 0) (- x) x)" "(if (neg? x) (- x) x)"]
                ["(let [a (+ x 1)] (+ a 2))" "(+ x 3)"]
                ["(rem x y)" "(- x (* y (quot x y)))"]]]
  (doseq [[left right] samples]
   (let [prepared (source/equivalence-problem left right bindings {})]
    (is (= :translated (:status prepared)) (pr-str prepared))
    (when (= :translated (:status prepared))
     (doseq [engine [:z3 :oxiz]]
      (let [result (logic/run {:backend engine} (:problem prepared))]
       (is (= :proved (:verdict result)) (pr-str result)))))))))

(deftest source-profile-refuses-effects-and-unsupported-semantics
 (let [bindings {"x" (t/variable "source.x" t/Int)}]
  (is (= :unsupported (:status (source/prepare "(do (println x) x)" bindings))))
  (is (= :unsupported (:status (source/prepare "(mystery x)" bindings))))
  (is (= :unsupported (:status (source/prepare "(+ x 1) (+ x 2)" bindings))))
  (is (= :unsupported (:status (source/prepare "(+ x 0.5)" bindings))))))

(deftest runtime-floor-modulus-is-not-smt-euclidean-modulus
 (let [prepared (source/prepare "(>= (mod x -3) 0)" {"x" (t/int 7)})]
  (is (= :translated (:status prepared)) (pr-str prepared))
  (when (= :translated (:status prepared))
   (is (= :refuted (:verdict (logic/run {:backend :z3} (q/prove (:value prepared))))))
   (is (contains? #{:refuted :unknown}
         (:verdict (logic/run {:backend :oxiz} (q/prove (:value prepared))))))))))
