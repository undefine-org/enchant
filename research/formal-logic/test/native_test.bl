(ns formal.native-test
 (:require [formal.native-cases :as native] [formal.matrix :as matrix]))

(deftest native-theory-probes-keep-semantic-and-capability-evidence-separate
 (let [cases (native/cases) result (matrix/run cases)]
  (matrix/write! "research/formal-logic/evidence/native.json" result)
  (doseq [row (:cases result)]
   (is (get-in row [:z3 :accepted]) (str (:id row) " " (pr-str (:z3 row))))
   (doseq [engine [:z3 :oxiz]]
    (is (not (contains? #{:error :invalid-model :vacuous} (get-in row [engine :verdict])))
        (str (:id row) " " engine " " (pr-str (get row engine)))))
   (is (not (:disagreement row)) (str (:id row) " opposing decisive statuses")))))

(deftest invalid-frontends-refuse-before-native-construction
 (doseq [boundary (native/frontend-boundaries)]
  (is (thrown? ((:construct boundary))) (str (:id boundary)))))
