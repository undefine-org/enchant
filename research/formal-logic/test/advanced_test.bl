(ns formal.advanced-test
 (:require [formal.advanced-cases :as advanced] [formal.matrix :as matrix]))

(deftest bit-layouts-and-declared-float-outcomes-use-the-common-interface
 (let [cases (advanced/cases) result (matrix/run cases)]
  (matrix/write! "research/formal-logic/evidence/advanced.json" result)
  (is (= 31 (count cases)))
  (doseq [row (:cases result)]
   (is (get-in row [:z3 :matches]) (str (:id row) " " (pr-str (:z3 row))))
   (is (not (:disagreement row)) (str (:id row) " opposing decisive statuses"))
   (is (not (contains? #{:error :invalid-model :vacuous} (get-in row [:oxiz :verdict])))
       (str (:id row) " " (pr-str (:oxiz row)))))))
