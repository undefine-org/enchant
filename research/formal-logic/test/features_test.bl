(ns formal.features-test
 (:require [formal.feature-cases :as features] [formal.matrix :as matrix]))

(deftest language-native-features-on-both-native-backends
 (let [cases (features/all-cases) result (matrix/run cases)]
  (matrix/write! "research/formal-logic/evidence/features.json" result)
  (is (= 61 (count cases)))
  (doseq [row (:cases result)]
   (is (get-in row [:z3 :matches]) (str (:id row) " " (pr-str (:z3 row))))
   ;; Missing candidate capabilities are research evidence. A decisive
   ;; contradiction or invalid replay is a qualification failure.
   (is (not (:disagreement row)) (str (:id row) " solver disagreement"))
   (is (not= :invalid-model (get-in row [:oxiz :verdict])) (str (:id row) " invalid OxiZ witness")))))
