(ns formal.semantic-canary-runner
 (:require [formal.semantic-canaries :as canary] [bl.json :as json]))

;; Observation-only entry point. The integration owner runs this once with the
;; exact sdk-pin.json artifact and retains its invocation receipt. It does not
;; start the Enchant application, a server, solver or native worker.
;;
;; <pinned-sdk>/bin/bl -p research/formal-logic/src run \
;;   research/formal-logic/semantic-canaries.bl -- . research/formal-logic/evidence/semantic-canaries.json

(let [args (vec (BeamLisp/argv))
      root (Path/expand (or (get args 0) "."))
      output (get args 1)
      pin (json/decode (File/read! (Path/join root "research/formal-logic/sdk-pin.json")))
      result (assoc (canary/snapshot) :declared-sdk-pin pin
                    :pin-verification :launcher-receipt-required)
      encoded (json/encode result {:pretty 2})]
 (if (some? output)
  (let [target (Path/join root output)]
   (File/mkdir_p! (Path/dirname target))
   (File/write! target (str encoded "\n")))
  (println encoded))
 :ok)
