-; rt/call.bl — function invocation and callability.
-
-(ns rt.call
-  (:require [rt.raw :as raw]
-            [rt.kind :as k]))
-
-(def BLFN-TAG   :"$blfn")
-(def REMOTE-TAG :"$remote")
-
-;; Multi-fn construction
-(defn multi-fn
-  ([clauses]
-   (raw/tuple3 BLFN-TAG clauses nil))
-  ([clauses variadic]
-   (raw/tuple3 BLFN-TAG clauses variadic)))
-
-;; Helper to convert seq to args list
-(defn- seq-to-args [s]
-  (cond
-    (erlang/== s nil) ()
-    (erlang/is_list s) s
-    :else ()))
-
-;; Error message
-(defn- plural [n]
-  (cond (erlang/== n 1) "" :else "s"))
-
-(defn call-shape-error [v arity]
-  (str "cannot call " (pr-str v :limit 3 :printable_limit 40)))
-
-;; ── the call protocol ──────────────────────────────────────────────────────
-
-(def ^:private FACADE-MOD
-  "The runtime's own public module.
-
-   `invoke` needs `get` for its keyword and map clauses, and `rt.coll/get` is
-   VARIADIC — a computed call cannot reach a variadic definition by arity
-   (measured: `erlang/apply` `Rt.Coll` `:get` with `[m k]` is
-   `UndefinedFunctionError`). The facade is not variadic at `get/2`,`get/3`, and
-   it is the module this cutover PRODUCES, so this is a real edge to the layer
-   above rather than a forwarder to the layer being deleted."
-  :"Elixir.BeamLisp.Ns.Rt")
-
-(defn- facade-get
-  "`(rt/get m k)` / `(rt/get m k default)` by computed call. One implementation of
-   indexing, reached through the module atom rather than a static import, which
-   is what keeps rt.call below rt.coll instead of in a cycle with it."
-  ([m k] (erlang/apply FACADE-MOD :get (raw/cons m (raw/cons k ()))))
-  ([m k d] (erlang/apply FACADE-MOD :get (raw/cons m (raw/cons k (raw/cons d ()))))))
-
-(defn- bad-call [f arity]
-  (erlang/error (raw/tuple2 :"ArgumentError" (call-shape-error f arity))))
-
-(defn- invoke-multi
-  "The multi-fn tag tuple: `fixed` is the arity→fn map, `variadic` is `{min, f}`
-   or nil. RT's own clause, one for one — including the shape of the variadic
-   call, which passes the first `min` arguments followed by the REST AS ONE
-   LIST. That is what makes `str`'s `{0, fn args -> … end}` receive its whole
-   argument list in a single parameter."
-  [f args]
-  (let [fixed (erlang/element 2 f)
-        variadic (erlang/element 3 f)
-        arity (erlang/length args)]
-    (cond
-      (erlang/is_map_key arity fixed)
-      (erlang/apply (maps/get arity fixed) args)
-
-      (erlang/== variadic nil)
-      (bad-call f arity)
-
-      :else
-      (let [mn (erlang/element 1 variadic)
-            vf (erlang/element 2 variadic)]
-        (cond
-          (erlang/>= arity mn)
-          (erlang/apply vf
-            (erlang/apply :lists :append
-              (list (erlang/apply :lists :sublist (list args mn))
-                    (raw/cons (erlang/apply :lists :nthtail (list mn args)) ()))))
-          :else (bad-call f arity))))))
-
-(defn invoke
-  "Call `f` with the argument LIST `args`.
-
-   Dispatched on `rt.kind/kind`, so the whole question \"what is this and how do
-   I call it\" is one read of the one classifier rather than a chain of `is_*`
-   tests that has to be kept in the same order as the classifier's clauses.
-
-   The clauses mirror `BeamLisp.RT.invoke/2`: a plain fn, a multi-fn, a dynamic
-   remote handle, a keyword (a function of maps), a vector (of its indices), a
-   set (of its members), a sorted collection, and a plain map (of its keys).
-   The port had the first three and treated a plain map as callable — both too
-   permissive (a struct is a map, so a Vector was callable as a lookup) and too
-   narrow (a keyword, a vector and a set were all uncallable). Nothing else is
-   callable, and the last clause says so in a sentence rather than leaving the
-   reader a host stack frame naming the wrong function."
-  ([f] (invoke f ()))
-  ([f args]
-   (let [kd (k/kind f)
-         n (erlang/length args)]
-     (cond
-       ;; A plain fn: the overwhelmingly common case.
-       (erlang/== kd :fn) (erlang/apply f args)
-
-       (erlang/== kd :blfn) (invoke-multi f args)
-
-       ;; Dynamic invocation of a host-module handle: the runtime half of the
-       ;; capability gate, whose static half the compiler enforces.
-       (erlang/== kd :remote)
-       (erlang/apply (erlang/element 2 f) (erlang/element 3 f) args)
-
-       ;; Keywords are functions of maps: `(:a m)` is `(get m :a)`.
-       (erlang/== kd :atom)
-       (cond
-         (erlang/== n 1) (facade-get (erlang/hd args) f)
-         (erlang/== n 2) (facade-get (erlang/hd args) f (erlang/hd (erlang/tl args)))
-         :else (bad-call f n))
-
-       ;; Vectors are functions of their indices: `([a b] 1)` is `(nth [a b] 1)`.
-       (erlang/== kd :vector)
-       (cond
-         (and (erlang/== n 1) (erlang/is_integer (erlang/hd args)))
-         (BeamLisp.Vector/nth f (erlang/hd args))
-         :else (bad-call f n))
-
-       ;; Sets are functions of their members: the member, or the default.
-       (erlang/== kd :set)
-       (cond
-         (erlang/== n 1)
-         (cond (BeamLisp.Set/member? f (erlang/hd args)) (erlang/hd args) :else nil)
-         (erlang/== n 2)
-         (cond (BeamLisp.Set/member? f (erlang/hd args)) (erlang/hd args)
-               :else (erlang/hd (erlang/tl args)))
-         :else (bad-call f n))
-
-       (erlang/== kd :sorted-set)
-       (cond
-         (erlang/== n 1)
-         (cond (BeamLisp.Sorted/set_member? f (erlang/hd args)) (erlang/hd args) :else nil)
-         (erlang/== n 2)
-         (cond (BeamLisp.Sorted/set_member? f (erlang/hd args)) (erlang/hd args)
-               :else (erlang/hd (erlang/tl args)))
-         :else (bad-call f n))
-
-       (erlang/== kd :sorted-map)
-       (cond
-         (erlang/== n 1) (facade-get f (erlang/hd args))
-         (erlang/== n 2) (facade-get f (erlang/hd args) (erlang/hd (erlang/tl args)))
-         :else (bad-call f n))
-
-       ;; A plain map is a function of its keys. A struct never reaches here:
-       ;; each has its own kind, which is the ordering hazard the classifier
-       ;; removes for every protocol at once.
-       (erlang/== kd :map)
-       (cond
-         (erlang/== n 1) (facade-get f (erlang/hd args))
-         (erlang/== n 2) (facade-get f (erlang/hd args) (erlang/hd (erlang/tl args)))
-         :else (bad-call f n))
-
-       :else (bad-call f n)))))
-
-;; invocable? checks if a value can be called with a specific arity.
-;;
-;; The clauses mirror `BeamLisp.RT.invocable?/2` one for one, because the
-;; compiler's call-head dispatch is the caller: it lets a local shadow a linked
-;; global only when the local's value is actually callable, so a wrong answer
-;; here silently re-routes a call. Three of the four defects this port had are
-;; the kind a probe cannot see — a probe asks about the cases its author
-;; thought of.
-(defn invocable? [value arity]
-  (cond
-    ;; A plain fn: EXACT arity. (`fun_info(f, :arity)` returns the 2-tuple
-    ;; `{:arity, n}`, so comparing it to an integer was always false — every
-    ;; plain fn answered "not invocable". `is_function/2` is the question.)
-    (erlang/is_function value)
-    (erlang/is_function value arity)
-
-    ;; An atom — which INCLUDES nil, true and false: RT's clause is
-    ;; `when is_atom(kw)`, and `is_atom(nil)` is true.
-    (erlang/is_atom value)
-    (or (erlang/== arity 1) (erlang/== arity 2))
-
-    ;; A multi-fn: the tag tuple built by multi-fn/1,2. `fixed` is the
-    ;; arity→fn map; `variadic` is `{min, f}` or nil. RT has this clause and the
-    ;; port simply did not, so every multi-fn answered false.
-    (and (erlang/is_tuple value)
-         (erlang/== 3 (erlang/tuple_size value))
-         (erlang/== BLFN-TAG (erlang/element 1 value))
-         (erlang/is_map (erlang/element 2 value)))
-    (or (erlang/is_map_key arity (erlang/element 2 value))
-        (and (let [v (erlang/element 3 value)]
-               (and (erlang/is_tuple v)
-                    (erlang/== 2 (erlang/tuple_size v))))
-             (erlang/>= arity (erlang/element 1 (erlang/element 3 value)))))
-
-    ;; A dynamic remote handle is invocable at ANY arity.
-    (and (erlang/is_tuple value)
-         (erlang/== 3 (erlang/tuple_size value))
-         (erlang/== REMOTE-TAG (erlang/element 1 value)))
-    true
-
-    :else false))
-
-;; apply-to: apply with seq argument
-(defn apply-to [f args]
-  (invoke f (seq-to-args args)))
-
-;; apply-variadic: variadic apply
-(defn apply-variadic [f arg1 rest-list]
-  (let [all-args (erlang/++ (list arg1) rest-list)
-        reversed (erlang/apply :lists :reverse (raw/cons all-args ()))
-        seq-arg (erlang/hd reversed)
-        leading-rev (erlang/tl reversed)
-        leading (erlang/apply :lists :reverse (raw/cons leading-rev ()))]
-    (invoke f (erlang/++ leading (seq-to-args seq-arg)))))
-
-;; remote-fun: create a remote function handle
-(defn remote-fun [module fun]
-  (cond
-    (erlang/== false (BeamLisp.Env/caps_allowed? module (BeamLisp.Env/op_of module fun)))
-    (erlang/error (raw/tuple2 :"error" "module not granted"))
-
-    (erlang/== false (Code/ensure_loaded? module))
-    (erlang/error (raw/tuple2 :"error" "module not loaded"))
-
-    :else (raw/tuple3 REMOTE-TAG module fun)))
-
-;; Type predicates
-(defn seq? [x]
-  (cond
-    (and (erlang/is_map x)
-         (erlang/is_map_key :"__struct__" x)
-         (erlang/== (erlang/map_get :"__struct__" x) :"Elixir.BeamLisp.LazySeq"))
-    true
-    (erlang/is_list x) (erlang/== false (erlang/== () x))
-    :else false))
-
-(defn list? [x]
-  (erlang/is_list x))
-
-(defn struct?
-  "A user/foreign BEAM struct — a bl record OR a foreign struct. FALSE for
-   beam-lisp's own collection structs and for its reference types.
-
-   The set is exactly what `kind` already knows: `:record` and `:opaque` (a
-   foreign struct), plus `:decimal`, which RT also calls a struct. It is NOT
-   \"everything carrying a `__struct__`\" — Vector, Set, SortedMap, SortedSet,
-   LazySeq, Reduced and the four reference cells all carry one and are none of
-   them a struct a program inspects.
-
-   This used to be an exclusion LIST of module atoms: a second table beside the
-   classifier's, and it had already drifted. It excluded Decimal (RT includes
-   it, and the oracle caught the disagreement) and said nothing at all about the
-   reference cells, which only the classifier knows."
-  [x]
-  (cond
-    (erlang/== false (erlang/is_map x)) false
-    (erlang/== false (erlang/is_map_key :"__struct__" x)) false
-    :else
-    (let [kd (k/kind x)]
-      (cond
-        (erlang/== kd :decimal) true
-        (erlang/== kd :record) true
-        (erlang/== kd :opaque) true
-        :else false))))
-
-(defn map?
-  "RT's `map?`: a plain map, a sorted map, or a bl record — in RT a record is a
-   user-facing map. NOT the classifier's `map?`, which answers for the plain map
-   alone. Two different questions; this file answers RT's."
-  [x]
-  (let [kd (k/kind x)]
-    (cond
-      (erlang/== kd :map) true
-      (erlang/== kd :sorted-map) true
-      (erlang/== kd :record) true
-      :else false)))
-
-(defn set?
-  "RT's `set?`: a set — hashed or ordered."
-  [x]
-  (let [kd (k/kind x)]
-    (cond
-      (erlang/== kd :set) true
-      (erlang/== kd :sorted-set) true
-      :else false)))
-
-(defn associative?
-  "RT's `associative?`: a value fields can be read from by key or index — a bl
-   map, a record, a foreign struct, or a vector. Written as one read of the
-   classifier, so the non-associative structs (Set, SortedSet, LazySeq, the
-   reference cells) are excluded by not being listed."
-  [x]
-  (let [kd (k/kind x)]
-    (cond
-      (erlang/== kd :map) true
-      (erlang/== kd :sorted-map) true
-      (erlang/== kd :vector) true
-      (erlang/== kd :decimal) true
-      (erlang/== kd :record) true
-      (erlang/== kd :opaque) true
-      :else false)))
-
-(defn transientable? [x]
-  (cond
-    (and (erlang/is_map x)
-         (erlang/is_map_key :"__struct__" x))
-    (let [mod (erlang/map_get :"__struct__" x)]
-      (cond
-        (erlang/== mod :"Elixir.BeamLisp.Vector") true
-        (erlang/== mod :"Elixir.BeamLisp.Set") true
-        :else false))
-    :else false))
-
-(defn sorted? [x]
-  (cond
-    (and (erlang/is_map x)
-         (erlang/is_map_key :"__struct__" x))
-    (let [mod (erlang/map_get :"__struct__" x)]
-      (cond
-        (erlang/== mod :"Elixir.BeamLisp.Sorted.SortedMap") true
-        (erlang/== mod :"Elixir.BeamLisp.Sorted.SortedSet") true
-        :else false))
-    :else false))
-
-(defn identical? [a b]
-  (erlang/=:= a b))
-
-(defn not-
-  ([] true)
-  ([x] (or (erlang/== x false) (erlang/== x nil)))
-  ([x & more]
-   (cond
-     (or (erlang/== x false) (erlang/== x nil)) true
-     :else (erlang/apply not- more))))
