+++ /dev/null
@@ -1,112 +0,0 @@
-; rt/number.bl — the ONE exact rational projection for finite numbers.
-;
-; WHY. The first prototype ordered numbers with a MIXTURE: `Num.cmp/2` for
-; int/float, `Decimal.compare/2` (through `Decimal.from_float/1`) for
-; decimal/float. `from_float/1` is the shortest decimal that ROUND-TRIPS, not
-; the float's exact value, so the two halves disagree about the same pair and
-; `=` stops being transitive at the boundaries — a float beside the integer it
-; rounded from, and beside a decimal with more digits than the float can hold.
-; The key projection had the same split, so values the order called equal could
-; produce different keys (and values it called different could collide).
-;
-; THE PROJECTION. Every finite number becomes one EXACT rational
-; `{numerator, denominator}`:
-;
-;   int      n        -> n / 1
-;   float    f        -> Float.ratio/1          (the IEEE value, exactly)
-;   decimal  U/10^S   -> unscaled / 10^scale
-;
-; then reduced by gcd with a POSITIVE denominator and zero canonicalised to
-; 0/1. There is NO approximation anywhere: no shortest-decimal, no
-; float-to-string round-trip. `0.1` (the float) is
-; 3602879701896397/36028797018963968 while `0.1M` is 1/10 — the order says so,
-; and so does the key.
-;
-; BOTH CONSUMERS read this one projection: `rt.eq` orders numbers with
-; `num-cmp` (cross-multiplication `na*db` vs `nb*da`, exact for arbitrary
-; precision integers, no common denominator materialised) and `rt.key` builds
-; `{:num, numerator, denominator}` with `num-key`. Because both read the SAME
-; reduced rational, "the order says 0" and "the keys are equal" are one
-; predicate over numbers.
-;
-; Construction uses `rt.raw` and BIFs plus `Float.ratio/1`; no
-; `BeamLisp.RT` and no `Decimal` module — a decimal's `:unscaled`/`:scale`
-; fields are read directly. `erlang/gcd/2` is not a BIF; gcd is Euclid below.
-
-(ns rt.number
-  (:require [rt.kind :as k]
-            [rt.raw :as raw]))
-
-(defn- refuse [x why]
-  (erlang/error (raw/tuple3 :"$krt-number/unsupported" why x)))
-
-;; ── exact integer helpers ──────────────────────────────────────────────────
-(defn- gcd
-  "Euclid on non-negative integers. `erlang/gcd/2` is not a BIF."
-  [a b]
-  (loop [x a y b]
-    (cond
-      (erlang/== y 0) x
-      :else (recur y (erlang/rem x y)))))
-
-(defn- pow10 [n]
-  (loop [i n acc 1]
-    (cond
-      (erlang/== i 0) acc
-      :else (recur (erlang/- i 1) (erlang/* acc 10)))))
-
-(defn- reduce-ratio
-  "`{n, d}` in lowest terms with a positive denominator; zero is 0/1."
-  [n d]
-  (cond
-    (erlang/== n 0) (raw/tuple2 0 1)
-    :else
-    (let [neg (erlang/< d 0)
-          nn (cond neg (erlang/- 0 n) :else n)
-          dd (cond neg (erlang/- 0 d) :else d)
-          g (gcd (erlang/abs nn) dd)]
-      (raw/tuple2 (erlang/div nn g) (erlang/div dd g)))))
-
-;; ── the projection ─────────────────────────────────────────────────────────
-(defn ratio
-  "The exact reduced rational `{numerator, denominator}` of a finite number:
-   int -> n/1, float -> the IEEE value via `Float.ratio/1`, decimal ->
-   unscaled/10^scale. The denominator is positive. Raises for a non-number."
-  [x]
-  (let [kd (k/kind x)]
-    (cond
-      (erlang/== kd :int) (raw/tuple2 x 1)
-      (erlang/== kd :float)
-      (let [r (Float/ratio x)]
-        (reduce-ratio (erlang/element 1 r) (erlang/element 2 r)))
-      (erlang/== kd :decimal)
-      (let [u (erlang/map_get :unscaled x)
-            s (erlang/map_get :scale x)]
-        (cond
-          (erlang/== s 0) (raw/tuple2 u 1)
-          (erlang/< s 0) (raw/tuple2 (erlang/* u (pow10 (erlang/- 0 s))) 1)
-          :else (reduce-ratio u (pow10 s))))
-      :else (refuse x :not-a-finite-number))))
-
-(defn num-cmp
-  "Three-way compare of two finite numbers on their EXACT rational values, by
-   cross-multiplication. Exact for arbitrary precision integers and identical
-   for every int/float/decimal triple, so the order is transitive."
-  [a b]
-  (let [ra (ratio a) rb (ratio b)
-        l (erlang/* (erlang/element 1 ra) (erlang/element 2 rb))
-        r (erlang/* (erlang/element 1 rb) (erlang/element 2 ra))]
-    (cond
-      (erlang/< l r) -1
-      (erlang/> l r) 1
-      :else 0)))
-
-(defn num-key
-  "The canonical hash key of a finite number: `{:num, numerator, denominator}`
-   over the same reduced rational `num-cmp` orders by. Hence equal numbers
-   always produce equal keys. (Keys are canonical, NOT injective: a lookup must
-   still compare values, and an order-preserving codec is a separate, unimplemented
-   concern — see rt.key.)"
-  [x]
-  (let [r (ratio x)]
-    (raw/tuple3 :num (erlang/element 1 r) (erlang/element 2 r))))
diff --git a/research/rt-cutover/rt/print.bl b/research/rt-cutover/rt/print.bl
