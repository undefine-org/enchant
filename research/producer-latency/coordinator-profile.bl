(ns producer.coordinator-profile)
(def program (System/fetch_env! "PRODUCER_PROFILE_PROGRAM"))
(def source (File/read! program))
(def marker "\n(try\n  (let [value (dispatch! (BeamLisp/argv))]")
(def offset (elem (binary/match source marker) 0))
(def definitions (binary/part source 0 offset))
(def patterns [(tuple :Elixir.BeamLisp.Reader :read_string 2)
               (tuple :Elixir.BeamLisp.BuildPlan :build-content-parts 1)
               (tuple :Elixir.BeamLisp.AOT :source_node_cached 2)
               (tuple :Elixir.BeamLisp.AOT :ns_closure_hash 1)
               (tuple :Elixir.BeamLisp.AOT :source_resolution_context 0)
               (tuple :Elixir.BeamLisp.PackageAuthority :sdk_unit_evidence 2)
               (tuple :Elixir.BeamLisp.AOT :sdk_inventory_input 0)
               (tuple :Elixir.BeamLisp.Env :with_env 2)
               (tuple :Elixir.File :read! 1)
               (tuple :crypto :hash 2)])
(doseq [pattern patterns] (erlang/trace_pattern pattern true (list :local :call_count)))
(try
 (let [started (erlang/monotonic_time :microsecond)]
  (BeamLisp/eval definitions)
  (let [elapsed (- (erlang/monotonic_time :microsecond) started)
        counts (Enum/map (to-list patterns) (fn [pattern]
                 (let [info (erlang/trace_info pattern :call_count)]
                   (list (pr-str pattern) (if (and (erlang/is_tuple info) (erlang/is_integer (elem info 1))) (elem info 1) 0)))))]
   (println (str "COORDINATOR-PROFILE " (Jason/encode! {:elapsed-us elapsed :counts counts :memory (erlang/memory :total)})))))
 (finally (doseq [pattern patterns] (erlang/trace_pattern pattern false (list :local :call_count)))))
