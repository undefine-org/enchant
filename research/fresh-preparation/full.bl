(ns tooling.full-preparation-probe (:require [build :as build]))
(when (System/get_env "PERF_COMPILED")
 (Code/eval_string "for m <- [BeamLisp.Loader,BeamLisp.AOT] do p=Path.join(System.fetch_env!(\"PERF_COMPILED\"),Atom.to_string(m) <> \".beam\"); {:module,^m}=:code.load_binary(m,String.to_charlist(p),File.read!(p)) end"))
(let [root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
      sources (->> (build/namespace-sources root)
                (remove #(BeamLisp.AOT/floor_file? %))
                (remove #(String/ends_with? % "-fixture.bl")) vec)
      out (System/fetch_env! "PERF_OUT")
      _ (when-not (= (String/to_integer (System/fetch_env! "PERF_EXPECT_UNITS")) (count sources))
          (throw (ex-info "Full Source selection changed" {:sources (count sources)})))
      _ (Code/eval_file (System/fetch_env! "PERF_FULL_TRACE_START"))
      started (erlang/monotonic_time :microsecond)
      result (build/produce! {:root root :sources sources :out out :jobs 2 :force? true
                             :sdk-artifacts? true :previous (str out ".absent") :log println})
      ended (erlang/monotonic_time :microsecond)]
 (Code/eval_file (System/fetch_env! "PERF_FULL_TRACE_FINISH"))
 (when-not (and (= (count sources) (:compiled result)) (= 0 (:cached result)) (empty? (:errors result)))
  (throw (ex-info "Fresh production did not compile the complete SDK" (select-keys result [:compiled :cached :errors]))))
 (Code/eval_string "memory=File.read!(\"/proc/self/status\") |> String.split(\"\\n\") |> Enum.filter(&String.starts_with?(&1,[\"VmHWM:\",\"VmRSS:\",\"VmSwap:\"])); IO.puts(\"PREPARATION-MEMORY \" <> Jason.encode!(memory))")
 (println (str "FULL-PRODUCTION " (Jason/encode! (assoc (select-keys result [:compiled :cached :built :errors])
                                                        :elapsed-us (- ended started))))))
