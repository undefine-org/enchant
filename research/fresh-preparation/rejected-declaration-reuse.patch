+(deftest reused-reader-forms-preserve-declaration-privacy-and-namespace-boundaries
+ (let [source (str "(ns artifact.form-declarations) "
+                  "(defn answer [] 42) (defn- hidden [] 1) "
+                  "(defmacro ^:private hidden-macro [] 1) "
+                  "(defrecord Item [value]) (defprotocol Shape (area [self])) "
+                  "(in-ns 'elsewhere) (defn ignored [] 0) "
+                  "(ns artifact.other-declarations) (defn other [] 7)")
+       forms (BeamLisp.Reader/read_string source "attributed.bl")
+       declarations (BeamLisp.Loader/source_decls_from_forms "artifact.form-declarations" forms)]
+  (is (= :public (get declarations "answer")))
+  (is (= :private (get declarations "hidden")))
+  (is (= :private (get declarations "hidden-macro")))
+  (is (= :public (get declarations "Item")))
+  (is (= :public (get declarations "->Item")))
+  (is (= :public (get declarations "map->Item")))
+  (is (= :public (get declarations "Shape")))
+  (is (= :public (get declarations "area")))
+  (is (not (contains? declarations "ignored")))
+  (is (not (contains? declarations "other")))
+  (is (= {"other" :public}
+         (BeamLisp.Loader/source_decls_from_forms "artifact.other-declarations" forms)))))
