(ns tooling.compile-preparation-pilot)
(let [root (System/fetch_env! "PERF_CANDIDATE") out (System/fetch_env! "PERF_COMPILED")]
 (File/mkdir_p! out)
 (doseq [[file module] [["loader.bl" :Elixir.BeamLisp.Loader] ["aot.bl" :Elixir.BeamLisp.AOT]]]
  (let [started (erlang/monotonic_time :microsecond)]
   (println (BeamLisp.AOT/compile_host_file (Path/join root file)
             (list (tuple :module module) (tuple :output_dir out) (tuple :load? false))))
   (println (str "PILOT-COMPILE " file " " (- (erlang/monotonic_time :microsecond) started))))))
