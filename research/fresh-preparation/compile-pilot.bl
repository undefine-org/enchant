(ns tooling.compile-preparation-pilot)
(let [root (System/fetch_env! "PERF_CANDIDATE") out (System/fetch_env! "PERF_COMPILED")]
 (File/mkdir_p! out)
 (doseq [[file module] [["atom_guard.bl" :Elixir.BeamLisp.AtomGuard] ["loader.bl" :Elixir.BeamLisp.Loader] ["aot.bl" :Elixir.BeamLisp.AOT]]]
  (when (or (nil? (System/get_env "PERF_FILES"))
            (Enum/member? (String/split (System/get_env "PERF_FILES") ",") file))
  (let [started (erlang/monotonic_time :microsecond)]
   (println (BeamLisp.AOT/compile_host_file (Path/join root file)
             (list (tuple :module module) (tuple :output_dir out) (tuple :load? false) (tuple :file (str "priv/host/" file)))))
   (println (str "PILOT-COMPILE " file " " (- (erlang/monotonic_time :microsecond) started)))))))
