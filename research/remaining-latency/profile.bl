(ns latency.profile)
(BeamLisp.Loader/ensure_loaded "build-inputs")
(BeamLisp.Loader/ensure_loaded "proc.server")
(def patterns [(tuple :Elixir.BeamLisp.AOT :sdk_inventory_input 0)
               (tuple :Elixir.BeamLisp.AOT :sdk_compiler_row 2)
               (tuple :Elixir.BeamLisp.AOT :image_sdk_entry! 3)
               (tuple :Elixir.BeamLisp.AOT :sdk_source_current? 3)
               (tuple :Elixir.BeamLisp.AOT :source_resolution_key 1)
               (tuple :Elixir.BeamLisp.AOT :source_resolution_key 2)
               (tuple :Elixir.BeamLisp.AOT :source_resolution_context 0)
               (tuple :Elixir.BeamLisp.Loader :search_dirs 0)
               (tuple :Elixir.BeamLisp.Loader :realm_context 0)
               (tuple :Elixir.BeamLisp.Env :with_env 2)
               (tuple :Elixir.Path :relative_to 2)
               (tuple :Elixir.File :read! 1)
               (tuple :crypto :hash 2)])
(defn measure [name run]
 (doseq [mfa patterns] (erlang/trace_pattern mfa true (list :local :call_count)))
 (let [started (erlang/monotonic_time :microsecond)
       result (run)
       elapsed (- (erlang/monotonic_time :microsecond) started)
       counts (Enum/map patterns (fn [mfa]
                 (let [info (erlang/trace_info mfa :call_count)]
                   (list (pr-str mfa) (if (and (erlang/is_tuple info) (erlang/is_integer (elem info 1)))
                                       (elem info 1) 0)))))]
  (doseq [mfa patterns] (erlang/trace_pattern mfa false (list :local :call_count)))
  (println (str "LATENCY-PROFILE " (Jason/encode! {:stage name :elapsed-us elapsed :counts counts :result result
                :memory (erlang/memory :total)})))))
(measure "callable-cold" (fn [] (BeamLisp.Env/sdk_callable! "proc.server" "clause-extension-form" 2) true))
(measure "callable-20" (fn [] (dotimes [_ 20] (BeamLisp.Env/sdk_callable! "proc.server" "clause-extension-form" 2)) true))
(def root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root)))
(def sdk (System/fetch_env! "BL_SDK_PRODUCT"))
(def units (vals (get (Jason/decode! (File/read! (Path/join sdk "unit-store/unit-index.json"))) "units")))
(def receipts (vec (mapcat #(get % "inputs") units)))
(def capture (BeamLisp.Env/fetch_exact! "build-inputs" "capture"))
(def current (BeamLisp.Env/fetch_exact! "build-inputs" "current?"))
(def snapshot (atom nil))
(measure "input-snapshot" (fn [] (reset! snapshot (capture root {} receipts)) (:reads @snapshot)))
(measure "input-validation" (fn [] (count (filter true? (map #(boolean (current @snapshot (get % "inputs"))) units)))))
(measure "closure-100" (fn [] (BeamLisp.AOT/with_source_snapshot
  (fn [] (count (mapv #(BeamLisp.AOT/ns_closure_hash (get % "namespace")) (take 100 receipts)))))))
