(ns latency.inventory-profile)
(def sdk (System/fetch_env! "BL_SDK_PRODUCT"))
(def root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root)))
(def ebin (Path/join sdk "image/ebin"))
(def units (get (Jason/decode! (File/read! (Path/join sdk "unit-store/unit-index.json"))) "units"))
(def manifest
  (into {} (map (fn [[namespace unit]]
                 (let [shim (BeamLisp.Emit/module_for namespace)
                       bytes (File/read! (Path/join ebin (str (Atom/to_string shim) ".beam")))
                       attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
                       members (BeamLisp.AOT/normalized_attribute attrs :bl_aot_unit_members)]
                   [(Path/join root (get unit "file")) {:modules (cons shim (elem members 1))}])) units)))
(def patterns [(tuple :Elixir.BeamLisp.AOT :physical_sdk_path 1)
               (tuple :Elixir.BeamLisp.Loader :read_source 1)
               (tuple :beam_lib :chunks 2)
               (tuple :beam_disasm :file 1)
               (tuple :crypto :hash 2)])
(def output (Path/join (System/tmp_dir!) (str "latency-inventory-" (erlang/unique_integer (list :positive)))))
(doseq [pattern patterns] (erlang/trace_pattern pattern true (list :local :call_count)))
(try
  (let [started (erlang/monotonic_time :microsecond)
        modules (BeamLisp.AOT/write_sdk_inventory! root manifest ebin output)
        elapsed (- (erlang/monotonic_time :microsecond) started)
        counts (Enum/map patterns (fn [pattern]
                 (list (pr-str pattern) (elem (erlang/trace_info pattern :call_count) 1))))]
    (println (str "LATENCY-INVENTORY " (Jason/encode!
      {:elapsed-us elapsed :counts counts :modules modules :units (count manifest)
       :sha256 (Base/encode16 (crypto/hash :sha256 (File/read! output))) :memory (erlang/memory :total)}))))
  (finally
    (doseq [pattern patterns] (erlang/trace_pattern pattern false (list :local :call_count)))
    (File/rm output)))
