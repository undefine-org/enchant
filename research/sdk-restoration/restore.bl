;; Real immutable SDK unit restoration. Instrumentation is inserted by profile.py.
(ns restoration.probe (:require [unit-store :as units]))
(when-let [source (System/get_env "BL_UNIT_SOURCE_OVERRIDE")]
  (BeamLisp/eval (String/replace (File/read! source)
    "(ns unit-store " "(ns restoration-unit-store ")))
(ns restoration.probe)
(let [sdk (System/fetch_env! "BL_SDK_PRODUCT")
      root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
      index (get (Jason/decode! (File/read! (Path/join sdk "unit-store/unit-index.json"))) "units")
      sources (Enum/map index (fn [[_ row]] (Path/join root (get row "file"))))
      output (System/fetch_env! "BL_UNIT_PROBE_OUTPUT")
      options {:root root :sources sources :previous (Path/join sdk "unit-store")
               :out output :jobs 4}]
  ;; PROFILE-START
  (let [started (System/monotonic_time :microsecond)
        result (if (System/get_env "BL_UNIT_SOURCE_OVERRIDE")
                 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "restoration-unit-store" "produce!")
                   (list options))
                 (units/produce! options))
        elapsed (- (System/monotonic_time :microsecond) started)]
    ;; PROFILE-FINISH
    (when-not (and (= 0 (:compiled result)) (= (count sources) (:cached result)))
      (throw (ex-info "Unchanged SDK unit restoration did not reuse every unit" result)))
    (File/write! (Path/join output "probe-manifest.term")
      (erlang/term_to_binary (:manifest result) (list :deterministic)))
    (println (str "RESTORE-RESULT " (Jason/encode!
      {:elapsed-us elapsed :compiled (:compiled result) :cached (:cached result)
       :memory (erlang/memory :total)})))))
