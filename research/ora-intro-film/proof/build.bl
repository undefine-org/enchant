(ns ora-film.layers-build
  (:require [ora-film.layers :as art] [scene.core :as scene] [interop]))
;; Capture sources, then evaluate every frame of the layers proof into one plan.
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(def root "research/ora-intro-film/proof/")
(def sources (into (mapv (fn [p] (str root p))
  ["build.bl" "ora_film/layers.bl" "worker.py" "shaders/flat.vert" "shaders/floor.vert" "shaders/floor.frag"
   "shaders/box.vert" "shaders/box.frag" "shaders/mote.vert" "shaders/mote.frag" "shaders/post.frag"])
  ["examples/scene-renderer/showcase_worker.py" "priv/lib/scene/score.bl" "priv/lib/scene/camera.bl" "priv/lib/scene/core.bl"]))
(let [args (clojure.io/current-command-line-args) out (Path/expand (or (first args) "/tmp/ora-layers"))
      captured (mapv (fn [p] [p (File/read! p)]) sources)
      identity {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                :clock [900 60 1] :kind "ORA Ventures intro film / proof shot 03 / five layers"}
      revision (digest (interop/->json identity)) dir (str out "/" revision)]
  (File/mkdir_p! (str dir "/sources")) (File/mkdir_p! (str dir "/shaders"))
  (doseq [[p bytes] captured]
    (File/write! (str dir "/sources/" (replace-str p "/" "__")) bytes)
    (when (or (String/ends_with? p ".vert") (String/ends_with? p ".frag")) (File/write! (str dir "/shaders/" (Path/basename p)) bytes)))
  (let [plan {:version 1 :viewport [1920 1080] :fps [60 1] :duration 15 :audio (art/score)
              :frames (mapv (fn [k] (assoc (art/sample (/ k 60)) :frame k)) (range 900))}]
    (when (not= (art/sample 7.3) (last (mapv art/sample [14 0 9.5 4.69 7.3]))) (scene/fail "Layers proof has seek history" {}))
    (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources)) (scene/fail "Sources changed during capture" {}))
    (File/write! (str dir "/plan.json.tmp") (interop/->json plan)) (File/rename! (str dir "/plan.json.tmp") (str dir "/plan.json"))
    (File/write! (str dir "/provenance.json") (interop/->json (assoc identity :revision revision)))
    (File/write! (str out "/manifest.json.tmp") (interop/->json {:revision revision :directory dir :frames 900 :fps [60 1] :duration 15}))
    (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
    (println (str "Captured ORA layers proof: " dir))))
