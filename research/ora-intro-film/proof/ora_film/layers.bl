(ns ora-film.layers
  (:require [scene.core :as s] [scene.score :as score] [scene.camera :as camera]))
;; "The Common Block", proof shot 03: five layers assemble bottom-up, then coral
;; lines run from the playbooks layer to every team. 15 s, 60 fps, 128 BPM.
;; Every channel is a pure function of time; nothing replays history.
(def duration 15)
(def fps 60)
(def beat (/ 60 128))
(defn at-beat [n] (* n beat))
(defn clamp [x a b] (max a (min b x)))
(defn blend [t at d] (camera/ease (s/progress t at d)))
(defn curve [keys] (score/track (mapv (fn [[t v]] {:at t :value v}) keys)))

;; Material codes understood by box.frag.
(def stone 0) (def channel 1) (def core 2) (def glass 3) (def ceramic 4) (def beam 5)

(def lanes [0 1 2 3 4])
(defn lane-x [i] (* (- i 2) 0.95))

;; Landing times sit on the beat grid. The common block lands on beat 10.
(def foundation-land (at-beat 3))
(def connector-land (at-beat 6))
(def core-land (at-beat 10))
(defn assistant-land [i] (at-beat (+ 12 (* 0.5 i))))
(defn team-land [i] (at-beat (+ 15 (* 0.5 i))))
(def line-start 8.4)
(def line-run 0.7)
(def line-rise 0.45)
(defn line-reach [i] (+ line-start (* line-run (/ (abs (lane-x i)) 1.9))))
(defn team-lit [i] (+ (line-reach i) line-rise))

(defn fall
  "Height above rest. Gravity-shaped fall from `height`, then a short damped rebound
   that never passes below rest."
  [t land seconds height rebound]
  (cond (< t land) (let [p (clamp (/ (- t (- land seconds)) seconds) 0 1)] (* height (- 1 (* p p))))
        :else (let [u (- t land)] (* rebound (math/exp (* -9 u)) (abs (math/sin (* 17 u)))))))

(defn core-fall
  "The common block hovers into view, hesitates, then commits on the beat."
  [t]
  (cond (< t core-land)
        (let [hover (s/lerp 11 2.4 (blend t 2.9 1.25))
              slam (math/pow (s/progress t 4.22 (- core-land 4.22)) 3)]
          (s/lerp hover 0 slam))
        :else (fall t core-land 1 0 0.05)))

(def landings
  (into [[foundation-land 0.55] [connector-land 0.4] [core-land 1.0]]
        (into (mapv (fn [i] [(assistant-land i) 0.18]) lanes) (mapv (fn [i] [(team-land i) 0.1]) lanes))))

(defn shake [t]
  (reduce + 0 (mapv (fn [[at amp]]
    (if (< t at) 0 (let [u (- t at)] (* amp 0.06 (math/exp (* -11 u)) (math/sin (* 46 u)))))) landings)))

(defn shock
  "Radius and strength of the most recent landing's floor ring."
  [t]
  (let [past (filter (fn [[at _]] (<= at t)) landings)]
    (if (empty? past) [0 0]
      (let [[at amp] (last past) u (- t at)] [(* u 8.5) (* amp (math/exp (* -2.4 u)))]))))

(defn box [id center size material glow visible]
  {:id id :center center :size size :material material :glow glow :visible (if visible 1 0)})

(defn line-glow [t] (+ 1 (* 1.4 (math/exp (* -4 (max 0 (- t 13.55)))) (if (< t 13.55) 0 1))))

(defn boxes [t]
  (let [hold 11
        f1 (fall t foundation-land 0.55 hold 0.05)
        f2 (fall t connector-land 0.5 hold 0.035)
        f3 (core-fall t)
        flash (if (< t core-land) 0 (math/exp (* -2.8 (- t core-land))))
        pulse (math/pow (max 0 (math/cos (* (/ t beat) (math/pi)))) 10)
        core-glow (+ (if (< t core-land) 0.35 0.55) (* 1.3 flash) (* 0.22 pulse (blend t 10 1)) (* 0.5 (- (line-glow t) 1)))
        run (* 1.9 (blend t line-start line-run))]
    (into
      [(box "foundation" [0 (+ 0.25 f1) 0] [6.2 0.5 3.8] stone (blend t foundation-land 2.5) (> t (- foundation-land 0.55)))
       (box "connectors" [0 (+ 0.78 f2) 0] [5.6 0.32 3.3] channel (* (blend t connector-land 1.2) (+ 0.4 (* 0.6 (blend t core-land 1.5)))) (> t (- connector-land 0.5)))
       (box "playbooks" [0 (+ 1.37 f3) 0] [4.8 0.62 2.8] core core-glow (> t 2.9))
       (box "line/left" [(* -0.5 run) 1.705 1.13] [(max 0.001 run) 0.05 0.05] beam (line-glow t) (> run 0.001))
       (box "line/right" [(* 0.5 run) 1.705 1.13] [(max 0.001 run) 0.05 0.05] beam (line-glow t) (> run 0.001))]
      (mapcat (fn [i]
        (let [x (lane-x i) rise (* 0.86 (blend t (line-reach i) line-rise))
              a (fall t (assistant-land i) 0.42 hold 0.03) b (fall t (team-land i) 0.42 hold 0.02)
              lit (blend t (team-lit i) 0.35)]
          [(box (str "assistant/" i) [x (+ 2.11 a) 0] [0.8 0.62 2.2] glass (* (blend t (line-reach i) line-rise) (line-glow t)) (> t (- (assistant-land i) 0.42)))
           (box (str "team/" i) [x (+ 2.61 b) 0] [0.8 0.14 0.8] ceramic (* lit (+ 0.4 (* 0.6 (- (line-glow t) 1)))) (> t (- (team-land i) 0.42)))
           (box (str "line/up/" i) [x (+ 1.68 (/ rise 2)) 1.13] [0.05 (max 0.001 rise) 0.05] beam (line-glow t) (> rise 0.001))]))
        lanes))))

;; Distance / yaw / pitch / target height. Asymmetric intervals; tangents carry through keys.
(def lens (curve [[0 [5.4 -0.55 0.34 0.0]] [1.4 [7.6 -0.38 0.2 0.45]] [3.4 [9.4 -0.16 0.24 1.4]]
  [4.69 [10.2 0.0 0.27 1.1]] [7.2 [10.6 0.38 0.37 1.35]] [9.6 [9.0 0.68 0.45 1.55]]
  [12.0 [11.0 0.92 0.53 1.25]] [15 [11.8 1.04 0.56 1.2]]]))

(defn dot [a b] (reduce + 0 (mapv * a b)))
(defn minus [a b] (mapv - a b))
(defn norm [v] (let [d (math/sqrt (dot v v))] (mapv (fn [x] (/ x d)) v)))
(defn cross [[a b c] [d e f]] [(- (* b f) (* c e)) (- (* c d) (* a f)) (- (* a e) (* b d))])
(defn mul4 [a b]
  (mapv (fn [k] (let [col (quot k 4) row (mod k 4)]
    (reduce + 0 (mapv (fn [i] (* (nth a (+ (* i 4) row)) (nth b (+ (* col 4) i)))) (range 4))))) (range 16)))

(defn camera3 [t]
  (let [[d yaw pitch ty] (score/sample lens t) k (shake t)
        eye [(* d (math/sin yaw) (math/cos pitch)) (+ (* d (math/sin pitch)) k) (* d (math/cos yaw) (math/cos pitch))]
        target [0 (+ ty (* 0.6 k)) 0] f (norm (minus target eye))
        r (norm (cross f [0 1 0])) u (cross r f)
        [rx ry rz] r [ux uy uz] u [fx fy fz] f
        view [rx ux (- 0 fx) 0 ry uy (- 0 fy) 0 rz uz (- 0 fz) 0 (- 0 (dot r eye)) (- 0 (dot u eye)) (dot f eye) 1]
        q (/ 1 (math/tan (* 20 (/ (math/pi) 180)))) n 0.1 far 120
        projection [(/ q (/ 16 9)) 0 0 0 0 q 0 0 0 0 (/ (+ far n) (- n far)) -1 0 0 (/ (* 2 far n) (- n far)) 0]]
    {:eye eye :view-projection (mul4 projection view)}))

(defn sample [t]
  (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Ora layers time outside [0,15)" {:time t}))
  (let [[radius strength] (shock t)
        order (blend t core-land 1.8)
        footprint (blend t (- foundation-land 0.9) 0.9)
        flash (if (< t core-land) 0 (math/exp (* -5 (- t core-land))))]
    (merge (camera3 t)
      {:time t :boxes (boxes t)
       :floor [radius strength footprint t]
       :motes [order t 0 0]
       :finish [(+ 0.3 (* 0.5 flash)) 0.25 (+ 1 (* 0.35 flash)) 0]})))

(defn score
  "Original event score: weight lands on the beat; order arrives as harmony."
  []
  (let [steady (filter (fn [i] (>= (at-beat i) core-land)) (range 32))]
    (vec (concat
      [{:at 2.6 :voice "swell" :duration 2.08 :frequency 110 :gain 0.2}]
      (mapv (fn [[at amp]] {:at at :voice "thud" :duration 0.6 :frequency (if (= amp 1.0) 42 (+ 52 (* 30 (- 0.6 amp)))) :gain (min 0.95 (+ 0.3 (* 0.6 amp)))}) landings)
      [{:at core-land :voice "chord" :duration 3.6 :frequency 220 :gain 0.2}
       {:at line-start :voice "chord" :duration 3.8 :frequency 246.94 :gain 0.16}
       {:at 13.55 :voice "chord" :duration 1.4 :frequency 329.63 :gain 0.14}]
      (mapv (fn [i] {:at (team-lit i) :voice "tick" :duration 0.12 :frequency (+ 1320 (* 110 i)) :gain 0.14}) lanes)
      (mapv (fn [i] {:at (+ (at-beat i) (* 0.5 beat)) :voice "hat" :duration 0.07 :frequency 7000 :gain 0.05}) steady)
      (mapv (fn [i] {:at (at-beat i) :voice "bass" :duration (* 0.8 beat) :frequency (nth [55 55 65.41 49] (mod (quot i 4) 4)) :gain 0.14}) steady)))))
