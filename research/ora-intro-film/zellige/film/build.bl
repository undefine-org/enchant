(ns ora-zellige.build
  (:require [ora-zellige.film :as art] [scene.core :as scene] [interop]))
;; Capture sources and fonts, shape the words once, then evaluate all 2,700 frames.
(defn digest [bytes] (String/downcase (binary/encode_hex (crypto/hash :sha256 bytes))))
(def root "research/ora-intro-film/zellige/film/")
(def sources (into (mapv (fn [p] (str root p))
  ["build.bl" "ora_zellige/film.bl" "worker.py" "shaders/flat.vert" "shaders/zellige.frag" "shaders/post.frag"
   "shaders/type.vert" "shaders/type.frag"])
  ["examples/scene-renderer/showcase_worker.py" "priv/lib/scene/text_worker.py" "priv/lib/scene/text.bl"
   "priv/lib/scene/geometry.bl" "priv/lib/scene/score.bl" "priv/lib/scene/camera.bl" "priv/lib/scene/core.bl"]))
(def font-names ["DMSans.ttf" "InstrumentSerif-Regular.ttf" "InstrumentSerif-Italic.ttf" "PatrickHand-Regular.ttf"
                 "SchibstedGrotesk.ttf" "SchibstedGrotesk-OFL.txt" "SchibstedGrotesk-source.json"])
(let [args (clojure.io/current-command-line-args) out (Path/expand (or (first args) "/tmp/ora-zellige"))
      captured (mapv (fn [p] [p (File/read! p)]) sources)
      fonts (mapv (fn [n] [n (File/read! (str "examples/scene-renderer/assets/fonts/" n))]) font-names)
      identity {:sources (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) captured)
                :fonts (mapv (fn [[p bytes]] {:path p :sha256 (digest bytes)}) fonts)
                :clock [2700 60 1] :kind "ORA Ventures intro film / Zellige / full 45 s"}
      revision (digest (interop/->json identity)) dir (str out "/" revision)]
  (File/mkdir_p! (str dir "/sources")) (File/mkdir_p! (str dir "/shaders")) (File/mkdir_p! (str dir "/font"))
  (doseq [[p bytes] captured]
    (File/write! (str dir "/sources/" (replace-str p "/" "__")) bytes)
    (when (or (String/ends_with? p ".vert") (String/ends_with? p ".frag")) (File/write! (str dir "/shaders/" (Path/basename p)) bytes)))
  (doseq [[n bytes] fonts] (File/write! (str dir "/font/" n) bytes))
  (let [prepared (art/prepare {:font-dir (str dir "/font") :worker (str dir "/sources/priv__lib__scene__text_worker.py")})
        track (art/lens prepared)
        plan {:version 1 :viewport [1920 1080] :fps [60 1] :duration 45 :typography (:specs prepared) :audio (art/score)
              :frames (mapv (fn [k] (assoc (art/sample prepared track (/ k 60)) :frame k)) (range 2700))}]
    (when (not= (art/sample prepared track 20.5) (last (mapv (fn [t] (art/sample prepared track t)) [44 0 30.1 18.2 20.5])))
      (scene/fail "Zellige film has seek history" {}))
    (when (not= captured (mapv (fn [p] [p (File/read! p)]) sources)) (scene/fail "Sources changed during capture" {}))
    (File/write! (str dir "/plan.json.tmp") (interop/->json plan)) (File/rename! (str dir "/plan.json.tmp") (str dir "/plan.json"))
    (File/write! (str dir "/provenance.json") (interop/->json (assoc identity :revision revision :shaping (:shaping prepared))))
    (File/write! (str out "/manifest.json.tmp") (interop/->json {:revision revision :directory dir :frames 2700 :fps [60 1] :duration 45}))
    (File/rename! (str out "/manifest.json.tmp") (str out "/manifest.json"))
    (println (str "Captured ORA Zellige film: " dir))))
