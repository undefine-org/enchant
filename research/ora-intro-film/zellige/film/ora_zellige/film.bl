(ns ora-zellige.film
  (:require [scene.core :as s] [scene.score :as score] [scene.camera :as camera] [scene.text :as text] [scene.geometry :as geometry]))
;; ORA Ventures — "Zellige". 45 s, 60 fps, 128 BPM (96 beats).
;; For the founder who already works with agents: their own piece becomes the
;; pattern the whole company shares. Every tile keeps its own clock until then.
;; BL owns the story clock: camera, construction, fit wave, refinement, finale,
;; words and sound. zellige.frag owns the per-pixel tile geometry and glaze.
(def duration 45)
(def fps 60)
(def beat (/ 60 128))
(defn at-beat [n] (* n beat))
(defn clamp [x a b] (max a (min b x)))
(defn blend [t at d] (camera/ease (s/progress t at d)))
(defn window [t in out fade] (clamp (* (blend t in fade) (- 1 (blend t (- out fade) fade))) 0 1))
(defn curve [keys] (score/track (mapv (fn [[t v]] {:at t :value v}) keys)))

;; ---------- Words: the whole script ----------
(def family "Schibsted Grotesk")
(def lines
  [{:id "w1" :text "You already work with agents." :in 1.2 :out 4.8}
   {:id "w2" :text "But they only know you." :in 6.0 :out 10.8}
   {:id "w3" :text "Your way of working becomes the pattern." :in 13.0 :out 17.6}
   {:id "w4" :text "Now the whole company shares it." :in 19.6 :out 24.8}
   {:id "w5" :text "Every lesson is kept and passed on." :in 27.0 :out 31.2}
   {:id "w6" :text "Built to last. Yours to keep." :in 33.2 :out 37.8}])
(def typography
  (into (mapv (fn [l] {:id (:id l) :text (:text l) :family family :size 66 :weight 500}) lines)
        [{:id "ra" :text "RA" :family family :size 280 :weight 700}
         {:id "ventures" :text "Ventures" :family family :size 140 :weight 400}
         {:id "tag" :text "From personal agents to a company brain." :family family :size 44 :weight 500}]))

(defn prepare [opts]
  (let [shaped (text/measure! typography opts)
        runs (:runs shaped)]
    {:runs runs :shaping (dissoc shaped :runs)
     :specs (mapv (fn [spec] (let [run (get runs (:id spec))]
              (assoc spec :path (geometry/path-data (:commands run)) :ink-bounds (:ink run)))) typography)}))

;; ---------- The closing lockup, measured ----------
;; The ring's outer diameter equals the cap height of "RA" (200 px) so the ring reads as the O.
(def ring-px 200)
(def tan-half (math/tan (* 20 (/ (math/pi) 180))))
(def lockup-height (/ 540 (* (/ ring-px 1.0) tan-half)))   ; camera height where 1 world unit = 200 px

(defn ink [prepared id] (:ink (get (:runs prepared) id)))
(defn lockup [prepared]
  (let [[_ _ raw _] (ink prepared "ra") [_ _ vw _] (ink prepared "ventures")
        gap-o 26 gap-v 46 total (+ ring-px gap-o raw gap-v vw)
        left (/ (- 1920 total) 2)]
    {:ring-x (+ left (/ ring-px 2)) :ring-y 520 :ra-x (+ left ring-px gap-o) :v-x (+ left ring-px gap-o raw gap-v)
     :baseline 620 :left left}))

(defn place
  "Pixel rect for a shaped run whose ink box starts at x and whose baseline is y."
  [prepared id x y]
  (let [run (get (:runs prepared) id) [ix iy iw ih] (:ink run) pad 8]
    [(- x pad) (+ (- y (:baseline run)) iy (- 0 pad)) (+ iw (* 2 pad)) (+ ih (* 2 pad))]))

(defn type-items [prepared t]
  (let [lk (lockup prepared) cream [0.984 0.918 0.808] muted [0.80 0.76 0.70]
        words (mapv (fn [l]
                (let [o (window t (:in l) (:out l) 0.45) rise (* 16 (- 1 (blend t (:in l) 0.6)))
                      [x y w h] (place prepared (:id l) 128 (+ 952 rise))]
                  {:id (:id l) :rect [x y w h] :opacity o :ink cream})) lines)
        o1 (clamp (blend t 41.0 0.7) 0 1) o2 (clamp (blend t 41.9 0.6) 0 1) slide (* 34 (- 1 o1))
        [rx ry rw rh] (place prepared "ra" (- (:ra-x lk) slide) (:baseline lk))
        [vx vy vw vh] (place prepared "ventures" (- (:v-x lk) slide) (:baseline lk))
        [tx ty tw th] (place prepared "tag" (+ (:left lk) 4) (+ (:baseline lk) 118))]
    (into words [{:id "ra" :rect [rx ry rw rh] :opacity o1 :ink cream}
                 {:id "ventures" :rect [vx vy vw vh] :opacity o1 :ink cream}
                 {:id "tag" :rect [tx ty tw th] :opacity o2 :ink muted}])))

;; ---------- Camera: target x/z, distance, yaw, pitch ----------
(defn lens [prepared]
  (let [lk (lockup prepared) end-x (/ (- 960 (:ring-x lk)) ring-px) end-z (/ (- 540 (:ring-y lk)) ring-px)
        two-pi (* 2 (math/pi)) down (- 0 (/ (math/pi) 2))]
    {:track (curve [[0 [0 0 1.25 0.3 -0.4]] [1.6 [0.1 0.15 2.0 0.36 -0.62]] [4.6 [0.6 0.7 6.2 0.52 -0.78]]
            [8.4 [1.6 1.2 7.4 0.78 -0.64]] [11.2 [1.2 0.6 6.6 0.94 -0.8]] [13.4 [0.1 0.05 4.6 1.02 -1.32]]
            [17.6 [0 0 5.0 1.08 -1.5]] [21.4 [0 0 9.6 1.22 -1.22]] [25.4 [1.4 -0.4 8.2 1.34 -1.0]]
            [27.4 [3 -1 3.0 1.44 -0.92]] [30.6 [1.6 -0.4 9.0 1.66 -0.82]] [33.0 [-1 -3 6.0 1.92 -0.34]]
            [37.4 [-7 -12 4.6 2.3 -0.17]] [39.6 [0.8 0.2 9.4 2.9 -1.18]] [45 [end-x end-z lockup-height two-pi down]]])
     :end [end-x end-z lockup-height two-pi down]}))

(defn pose
  "The free camera until 39.6 s, then an eased landing that stops exactly on the lockup."
  [lens t]
  (let [free (score/sample (:track lens) t) p (blend t 39.6 2.0)]
    (mapv (fn [a b] (s/lerp a b p)) free (:end lens))))

(defn camera3 [track t]
  (let [[tx tz d yaw pitch] (pose track t)
        pitch (clamp pitch -1.5707963 -0.05) d (max 0.3 d)
        f [(* (math/cos pitch) (math/sin yaw)) (math/sin pitch) (- 0 (* (math/cos pitch) (math/cos yaw)))]
        r [(math/cos yaw) 0 (math/sin yaw)]
        [fx fy fz] f [rx ry rz] r
        u [(- (* ry fz) (* rz fy)) (- (* rz fx) (* rx fz)) (- (* rx fy) (* ry fx))]
        eye [(- tx (* d fx)) (- 0 (* d fy)) (- tz (* d fz))]]
    {:eye eye :right r :up u :forward f :tan-half tan-half}))

;; ---------- The pattern's clock ----------
(def fit-start 18.0)
(def fit-beats 16)
(defn wave-radius
  "Ring by ring on the beat: each beat lands a new ring; growth accelerates."
  [t]
  (if (< t fit-start) -1
    (let [k (/ (- t fit-start) beat)]
      (if (< k fit-beats)
        (let [whole (math/floor k) part (camera/ease (- k whole))]
          (* 1.6 (math/pow (+ whole part 0.35) 1.18)))
        (min 400 (* 1.6 (math/pow (+ fit-beats 0.35) 1.18) (math/exp (* 0.32 (- t (+ fit-start (* fit-beats beat)))))))))))

(defn sample [prepared track t]
  (when (not (and (s/finite? t) (<= 0 t) (< t duration))) (s/fail "Zellige time outside [0,45)" {:time t}))
  (let [yaw (nth (pose track t) 3)
        build [(blend t 12.8 1.0) (blend t 13.9 1.3) (* 14 (blend t 15.3 2.6)) (* (blend t 12.6 0.4) (- 1 (blend t 19.0 2.2)))]
        flash (if (< t fit-start) 0 (math/exp (* -3 (- t fit-start))))
        fit [(wave-radius t) 1.3 (* (blend t 12.0 0.8) (- 1 (blend t 18.0 1.6))) (* (blend t 17.8 0.4) (- 1 (* 0.85 (blend t 25 2.5))))]
        refine [3 -1 (* 34 (math/pow (s/progress t 27.2 4.0) 1.4)) (blend t 26.9 0.3)]
        ;; The key light sits beyond the field, facing the lens, so the glaze always answers it.
        light [(+ yaw (/ (math/pi) -2) (* 0.28 (math/sin (* t 0.37)))) (+ 0.5 (* 0.1 (math/sin (* t 0.21)))) 1 (+ 1 (* 0.25 flash))]
        finale [(blend t 39.8 1.5) (* 0.97 (blend t 39.4 2.0)) 0.42 (blend t 40.6 1.2)]
        scrim (max (reduce max 0 (mapv (fn [l] (window t (:in l) (:out l) 0.5)) lines)) 0)]
    (merge (camera3 track t)
      {:time t :clock [t (/ t beat) 0 0] :build build :fit fit :refine refine :light light :finale finale
       :grade [scrim 0 0 0] :finish [(+ 0.35 (* 0.4 flash)) 0.2 1 0] :types (type-items prepared t)})))

;; ---------- Sound: Gnawa-inspired, played on the film's own beat ----------
;; Guembri (bass lute) on a minor pentatonic, qraqeb (iron castanets) in threes,
;; hand claps and a tbel drum. Three subdivisions to each 128 BPM beat.
(def trip (/ beat 3))
(def low-g 49.0)
(def notes {:a 55.0 :c 65.41 :d 73.42 :e 82.41 :g 98.0})
(def riff [[0 :a 0.30] [2 :a 0.18] [3 :c 0.24] [5 :a 0.18] [6 :low-g 0.28] [8 :a 0.18] [9 :c 0.22] [10 :d 0.2] [11 :c 0.16]])
(defn hz [k] (if (= k :low-g) low-g (get notes k)))
(def groove-end 39.4)
(defn grid [b] (+ fit-start (* b beat)))
(defn score []
  (let [beats (filter (fn [b] (< (grid b) groove-end)) (range 0 46))
        bars (filter (fn [b] (= 0 (mod b 4))) beats)
        own (mapcat (fn [[period phase gain]] (mapv (fn [k] {:at (+ phase (* k period)) :voice "qraqeb" :duration 0.12 :frequency (+ 2200 (* 40 k)) :gain gain})
                                     (range (int (/ (- 12.2 phase) period)))))
             [[0.61 0.4 0.05] [0.83 0.15 0.045] [1.13 0.9 0.04]])
        loose (mapv (fn [k] {:at (+ 0.7 (* k 1.07) (* 0.21 (math/sin (* k 2.3)))) :voice "guembri" :duration 1.2
                             :frequency (* (nth [55.0 65.41 73.42 82.41 98.0] (mod (* k 3) 5)) (+ 1 (* 0.025 (math/sin (* k 1.7))))) :gain 0.2})
                    (range 10))]
    (vec (concat
      own loose
      [{:at 12.8 :voice "guembri" :duration 3.6 :frequency 55.0 :gain 0.34}
       {:at 13.9 :voice "qraqeb" :duration 0.12 :frequency 2300 :gain 0.16}
       {:at 15.2 :voice "qraqeb" :duration 0.12 :frequency 2300 :gain 0.16}]
      (mapv (fn [n] {:at (grid (- 0 n)) :voice "qraqeb" :duration 0.12 :frequency 2300 :gain (* 0.03 (- 6 n))}) [1 2 3 4 5])
      (mapcat (fn [bar] (mapv (fn [[pos k gain]] {:at (+ (grid bar) (* pos trip)) :voice "guembri" :duration 0.9 :frequency (hz k) :gain gain}) riff)) bars)
      (mapcat (fn [b] (into [{:at (grid b) :voice "qraqeb" :duration 0.12 :frequency 2300 :gain 0.15}
                             {:at (+ (grid b) (* 2 trip)) :voice "qraqeb" :duration 0.12 :frequency 2300 :gain 0.1}]
                            (if (>= (grid b) 27.0) [{:at (+ (grid b) trip) :voice "qraqeb" :duration 0.1 :frequency 2300 :gain 0.05}] []))) beats)
      (mapv (fn [b] {:at (grid b) :voice "tbel" :duration 0.6 :frequency (if (= 0 (mod b 4)) 72 88) :gain (if (= 0 (mod b 4)) 0.34 0.18)})
            (filter (fn [b] (contains? #{0 3} (mod b 4))) beats))
      (mapv (fn [b] {:at (grid b) :voice "clap" :duration 0.25 :frequency 1200 :gain 0.16})
            (filter (fn [b] (and (= 1 (mod b 2)) (>= (grid b) 27.0))) beats))
      (mapv (fn [k] {:at (grid k) :voice "tap" :duration 0.12 :frequency 1900 :gain (- 0.12 (* 0.005 k))}) (range fit-beats))
      [{:at 39.5 :voice "guembri" :duration 3.8 :frequency 55.0 :gain 0.36}
       {:at 41.3 :voice "qraqeb" :duration 0.12 :frequency 2300 :gain 0.17}
       {:at 41.3 :voice "tbel" :duration 0.9 :frequency 66 :gain 0.3}]))))
