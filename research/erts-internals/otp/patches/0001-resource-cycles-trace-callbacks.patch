diff --git a/erts/emulator/beam/erl_nif_trace.c b/erts/emulator/beam/erl_nif_trace.c
new file mode 100644
index 0000000..7d07f3f
--- /dev/null
+++ b/erts/emulator/beam/erl_nif_trace.c
@@ -0,0 +1,1418 @@
+/*
+ * erl_nif_trace.c -- resource cycle collector (PROTOTYPE v2, not part of OTP).
+ *
+ * See erl_nif_trace.h for the contract a traced resource type honours. This
+ * file is #included at the end of erl_nif.c so it can see that file's static
+ * types (ErtsResource, enif_msg_environment_t) without widening any header.
+ *
+ * ── What v2 changes (v1 kept a global registry behind one mutex) ─────────────
+ *  cost              v1                               v2
+ *  untraced resource 2 extra words in every resource  nothing (link only on
+ *                                                     traced types)
+ *  alloc (traced)    global mutex + hash insert       per-scheduler shard lock
+ *                                                     (uncontended) + list link
+ *  release           nothing                          one flag test on every
+ *                                                     binary release; traced
+ *                                                     objects: one atomic OR +
+ *                                                     one CAS push, deduplicated
+ *  destroy           global mutex + hash delete       shard lock + list unlink
+ *  a round           O(every traced object)           O(candidates + what they
+ *                                                     reach), bounded by a
+ *                                                     budget; full rounds only
+ *                                                     after an overflow,
+ *                                                     amortised
+ *  observability     NIF entry points                 erlang:system_info/1 and
+ *                                                     erlang:system_flag/2:
+ *                                                     no NIF needed
+ *
+ * ── Candidates (Bacon & Rajan, "Concurrent Cycle Collection in Reference
+ *    Counted Systems", 2001) ────────────────────────────────────────────────
+ * A garbage cycle is created by the LAST external decrement of one of its
+ * members, and that decrement leaves the count above zero (the cycle's own
+ * edges hold it). So every decrement that leaves a traced object's count > 0
+ * records the object as a candidate ("purple"); a round only examines
+ * candidates and what they reach. Every count ERTS drops goes through
+ * erts_bin_release() (process GC sweep, message and env cleanup, ETS,
+ * enif_release_resource) or through the three raw sites this patch routes
+ * there (iref storage, io queues, iovecs) plus driver_binary_dec_refc; the
+ * binary carries BIN_FLAG_RC_TRACED, so the test is one flag load.
+ *
+ * Recording happens WHILE the releaser still holds its count (flag first,
+ * then decrement), so the object cannot be freed under the push. An object
+ * whose count reaches zero while recorded keeps its memory until the
+ * collector drains it (RC_ST_BUFFERED / RC_ST_DEAD, decided by one atomic
+ * read-modify-write on each side, so exactly one party frees).
+ *
+ * ── A round (trial deletion, concurrent; unchanged in substance) ─────────────
+ *  1. DRAIN     take every shard's candidate stack (one xchg each); pin each
+ *               candidate (refc++ unless 0 = dying: never resurrected).
+ *  2. EXPAND    BFS: trace(node) -> edges; a traced, tracked target not yet in
+ *               the round is pinned (its holder's count keeps it alive while
+ *               the holder is locked in trace) and added. Past the budget, no
+ *               new nodes are added and untraced queue entries become opaque
+ *               roots: always sound, maybe incomplete -> `overflow`, and a
+ *               full round (census snapshot, no budget) is scheduled once
+ *               enough candidates have passed to pay for it.
+ *  3. OUTSIDE   outside = refc - 1 (pin) - internal. > 0 = root: held by a
+ *               process, ETS, a native handle, or a traced object outside the
+ *               round. Opaque = root. Treating too much as root is always
+ *               safe; it only delays collection.
+ *  4. MARK      BFS from roots; unreached = candidate garbage G.
+ *  5. VALIDATE  A: every g re-reads outside == 0; then B: every g's epoch is
+ *               unchanged. (A before B: a new reference into G needs a read
+ *               of a G cell by someone holding a pre-trace reference; A proves
+ *               none remains, so the read preceded B and bumped the epoch.)
+ *               On failure nothing is cleared and G is re-recorded as
+ *               candidates, so the next round retries.
+ *  6. BREAK     mark G doomed (their own releases are not re-recorded),
+ *               clear(g) each, unpin all. Counts fall to zero in ERTS's order
+ *               and the ordinary destructors run (aux work, as always).
+ *
+ * The collector runs on its own unmanaged thread: it never occupies a
+ * scheduler and never blocks one.
+ */
+
+#include "erl_nif_trace.h"
+
+/* ---- per-object link (traced types only; lives at the end of the block) --- */
+
+#define RC_ST_TRACKED   (1 << 0)   /* enif_resource_cycles_track was called  */
+#define RC_ST_CENSUS    (1 << 1)   /* on its shard's census list             */
+#define RC_ST_BUFFERED  (1 << 2)   /* on a candidate stack                   */
+#define RC_ST_DEAD      (1 << 3)   /* destructor ran; memory kept for stack  */
+#define RC_ST_DOOMED    (1 << 4)   /* being cleared by the collector         */
+
+struct rc_type_;
+
+typedef struct RcLink_ RcLink;
+struct RcLink_ {
+    RcLink *cnext, *cprev;      /* census list of its shard (shard lock)     */
+    RcLink *pnext;              /* candidate stack link                      */
+    ErtsResource *self;
+    struct rc_type_ *t;         /* permanent                                 */
+    erts_atomic32_t state;
+    Uint32 shard;               /* census shard (valid while RC_ST_CENSUS)   */
+    UWord data_sz;              /* user data size (enif_sizeof_resource)     */
+};
+
+#define RC_ALIGN(X) (((X) + 7) & ~((size_t) 7))
+
+static ERTS_INLINE Binary *rc_bin(ErtsResource *r)
+{
+    return &ERTS_MAGIC_BIN_FROM_UNALIGNED_DATA(r)->binary;
+}
+
+static ERTS_INLINE RcLink *rc_link_of_bin(Binary *b)
+{
+    ErtsResource *r = (ErtsResource *) ERTS_MAGIC_BIN_UNALIGNED_DATA(b);
+    return (RcLink *) ((char *) r + ERTS_MAGIC_BIN_UNALIGNED_DATA_SIZE(b)
+                       - sizeof(RcLink));
+}
+
+static ERTS_INLINE RcLink *rc_link(ErtsResource *r)
+{
+    return rc_link_of_bin(rc_bin(r));
+}
+
+/* ---- per-type hooks + counters ------------------------------------------- */
+
+typedef struct {
+    erts_atomic_t live;        /* tracked objects not yet destroyed */
+    erts_atomic_t collected;   /* objects cleared by the collector   */
+    char pad[ERTS_CACHE_LINE_SIZE - 2 * sizeof(erts_atomic_t)];
+} RcTypeSlot;
+
+typedef struct rc_type_ {
+    struct rc_type_ *next;
+    Eterm module, name;                   /* atoms: permanent */
+    erts_atomic_t hooks;                  /* ErlNifResourceCycleHooks*: swapped
+                                             on takeover, old copy kept */
+    RcTypeSlot *slot;                     /* [rc_nshards] */
+} RcType;
+
+static ERTS_INLINE const ErlNifResourceCycleHooks *rc_hooks(RcType *t)
+{
+    return (const ErlNifResourceCycleHooks *) erts_atomic_read_acqb(&t->hooks);
+}
+
+/* ---- shards: one per scheduler (normal, dirty cpu, dirty io) + one shared -- */
+
+typedef struct {
+    erts_mtx_t lock;           /* census list only                          */
+    RcLink head;               /* census sentinel                           */
+    RcLink cursor;             /* snapshot position (self == NULL)          */
+    erts_atomic_t live;        /* census length                             */
+    erts_atomic_t stack;       /* RcLink*: candidate stack (Treiber)        */
+    erts_atomic_t pending;     /* pushes since last drain                   */
+    erts_atomic_t inflight;    /* releases between "check" and "decrement"  */
+} RcShardData;
+
+typedef union {
+    RcShardData d;
+    char align[ERTS_ALC_CACHE_LINE_ALIGN_SIZE(sizeof(RcShardData))];
+} RcShard;
+
+static RcShard *rc_shards;
+static Uint rc_nshards;
+static int rc_initialized;
+
+/* shard 0: unmanaged threads; 1..N normal; then dirty cpu; then dirty io */
+static ERTS_INLINE Uint rc_shard_ix(void)
+{
+    ErtsSchedulerData *esdp = erts_get_scheduler_data();
+    if (!esdp)
+        return 0;
+    switch (esdp->type) {
+    case ERTS_SCHED_NORMAL:
+        return esdp->no;
+    case ERTS_SCHED_DIRTY_CPU:
+        return erts_no_schedulers + esdp->dirty_no;
+    default:
+        return erts_no_schedulers + erts_no_dirty_cpu_schedulers
+            + esdp->dirty_no;
+    }
+}
+
+/* ---- control: policy, stats, types, requests, subscribers (cold paths) ---- */
+
+typedef enum { RC_REQ_COLLECT, RC_REQ_FULL, RC_REQ_GRAPH } RcReqKind;
+
+typedef struct rc_req_ {
+    struct rc_req_ *next;
+    RcReqKind kind;
+    ErlNifPid to;
+    ErlNifEnv *env;            /* owns `ref` */
+    ERL_NIF_TERM ref;
+} RcReq;
+
+#define RC_MAX_SUBSCRIBERS 16
+
+static erts_mtx_t rc_ctl;
+static RcType *rc_types;
+static RcReq *rc_reqs;
+static ErlNifPid rc_subs[RC_MAX_SUBSCRIBERS];
+static int rc_nsubs;
+static int rc_thread_started;
+static ethr_event rc_event;    /* wakes the collector */
+
+#define RC_DEFAULT_THRESHOLD 4096      /* candidates on one shard -> round */
+#define RC_DEFAULT_INTERVAL_MS 100     /* else: round if anything pending */
+#define RC_DEFAULT_BUDGET 65536        /* nodes a partial round may add    */
+
+static erts_atomic_t rc_threshold, rc_interval, rc_budget, rc_auto;
+
+static erts_atomic_t rc_rounds, rc_full_rounds, rc_collected, rc_aborted,
+                     rc_overflows, rc_candidates_total, rc_scanned_total,
+                     rc_since_full, rc_need_full;
+
+typedef struct {
+    Uint round, candidates, nodes, roots, garbage, collected, aborted,
+         opaque, usec;
+    int full, overflow;
+} RcStats;
+static RcStats rc_last;        /* written by the collector under rc_ctl */
+
+static void rc_ensure_thread(void);
+static ERTS_INLINE void rc_list_unlink(RcLink *l);
+static ERTS_INLINE void rc_list_insert_after(RcLink *at, RcLink *l);
+
+/* ---- allocation / destruction hooks called from erl_nif.c ----------------- */
+
+static size_t rc_resource_size(size_t magic_sz)
+{
+    /* resource->data is 8-aligned, the ErtsResource header is not: align the
+     * link relative to data. */
+    size_t off = offsetof(ErtsResource, data);
+    return off + RC_ALIGN(magic_sz - off) + sizeof(RcLink);
+}
+
+static void rc_init_resource(Binary *bin, ErtsResource *r,
+                             ErlNifResourceType *type, size_t data_sz)
+{
+    RcLink *l;
+    bin->intern.flags |= BIN_FLAG_RC_TRACED;   /* before publication */
+    l = rc_link_of_bin(bin);
+    l->cnext = l->cprev = NULL;
+    l->pnext = NULL;
+    l->self = r;
+    l->t = (RcType *) type->rc;
+    erts_atomic32_init_nob(&l->state, 0);
+    l->shard = 0;
+    l->data_sz = data_sz;
+}
+
+static size_t rc_sizeof_resource(ErtsResource *r)
+{
+    return rc_link(r)->data_sz;
+}
+
+/* run_resource_dtor, before the user destructor: leave the census.
+ * Idempotent (the monitor path can run the prologue twice). */
+static void rc_on_dtor(ErtsResource *r)
+{
+    RcLink *l;
+    erts_aint32_t old;
+    RcShardData *sh;
+    if (!(rc_bin(r)->intern.flags & BIN_FLAG_RC_TRACED))
+        return;
+    l = rc_link(r);
+    old = erts_atomic32_read_band_mb(&l->state, ~RC_ST_CENSUS);
+    if (!(old & RC_ST_CENSUS))
+        return;
+    sh = &rc_shards[l->shard].d;
+    erts_mtx_lock(&sh->lock);
+    rc_list_unlink(l);
+    erts_mtx_unlock(&sh->lock);
+    erts_atomic_dec_nob(&sh->live);
+    erts_atomic_dec_nob(&l->t->slot[l->shard].live);
+}
+
+/* After the user destructor: 1 = a candidate stack still points here, the
+ * collector frees the memory when it drains it. */
+static int rc_dtor_keep_memory(Binary *bin)
+{
+    erts_aint32_t old;
+    if (!(bin->intern.flags & BIN_FLAG_RC_TRACED))
+        return 0;
+    old = erts_atomic32_read_bor_mb(&rc_link_of_bin(bin)->state, RC_ST_DEAD);
+    return !!(old & RC_ST_BUFFERED);
+}
+
+/* ---- candidates ------------------------------------------------------------ */
+
+static void rc_push(RcLink *l)
+{
+    Uint ix = rc_shard_ix();
+    RcShardData *sh = &rc_shards[ix].d;
+    erts_aint_t head = erts_atomic_read_nob(&sh->stack), seen;
+    for (;;) {
+        l->pnext = (RcLink *) head;
+        seen = erts_atomic_cmpxchg_relb(&sh->stack, (erts_aint_t) l, head);
+        if (seen == head)
+            break;
+        head = seen;
+    }
+    {
+        erts_aint_t p = erts_atomic_inc_read_nob(&sh->pending);
+        /* 1: the collector may be asleep with no timeout; threshold: cut
+         * its batching interval short. Nothing else wakes it. */
+        if ((p == 1 || p == erts_atomic_read_nob(&rc_threshold))
+            && erts_atomic_read_nob(&rc_auto))
+            ethr_event_set(&rc_event);
+    }
+}
+
+/* Record a traced object whose count is about to drop and stay > 0. The
+ * caller still holds its count. */
+static ERTS_INLINE void rc_record(Binary *bp)
+{
+    RcLink *l = rc_link_of_bin(bp);
+    erts_aint32_t st = erts_atomic32_read_nob(&l->state);
+    if (st & (RC_ST_BUFFERED | RC_ST_DOOMED) || !(st & RC_ST_TRACKED))
+        return;
+    st = erts_atomic32_read_bor_mb(&l->state, RC_ST_BUFFERED);
+    if (!(st & RC_ST_BUFFERED))
+        rc_push(l);
+}
+
+/*
+ * The release protocol. A release that finds the object already BUFFERED
+ * skips the push -- but the drain may clear BUFFERED and the round may read
+ * the count BEFORE this release's decrement lands, and would then keep the
+ * object as a root with no candidate left to revisit it. So each release is
+ * bracketed by its shard's `inflight` counter, and a round, before it
+ * re-checks counts at its end, waits until it has seen every shard at zero
+ * (rc_quiesce): every release that could have skipped has then decremented.
+ * The counter is the releasing scheduler's own (cache-local) line.
+ */
+static ERTS_INLINE erts_aint_t rc_release_dec(Binary *bp, erts_aint_t min)
+{
+    RcShardData *sh = &rc_shards[rc_shard_ix()].d;
+    erts_aint_t v;
+    erts_atomic_inc_mb(&sh->inflight);
+    /* A count of 1 is the caller's own: this release frees it. (A racing
+     * revival by binary_to_term leaves it held by that outside holder, whose
+     * own release is recorded later.) */
+    if (erts_refc_read(&bp->intern.refc, 1) > 1)
+        rc_record(bp);
+    v = erts_refc_dectest(&bp->intern.refc, min);
+    erts_atomic_dec_relb(&sh->inflight);
+    return v;
+}
+
+/* erts_bin_release() for a traced resource. */
+void erts_rc_release(Binary *bp)
+{
+    if (rc_release_dec(bp, 0) == 0)
+        erts_bin_free(bp);
+}
+
+/* driver_binary_dec_refc() for a traced resource: same, caller frees. */
+erts_aint_t erts_rc_dec_refc(Binary *bp)
+{
+    return rc_release_dec(bp, 1);
+}
+
+/* Wait until every release in flight when this is called has finished.
+ * Releases hold no lock and never block between the brackets, so this is
+ * short; it yields rather than spins when a releaser is descheduled. */
+static void rc_quiesce(void)
+{
+    Uint s;
+    for (s = 0; s < rc_nshards; s++) {
+        erts_atomic_t *f = &rc_shards[s].d.inflight;
+        int spins = 0;
+        while (erts_atomic_read_acqb(f) != 0) {
+            if (++spins < 64)
+                ERTS_SPIN_BODY;
+            else
+                erts_thr_yield();
+        }
+    }
+}
+
+/* The collector's own pins: never recorded (they net to zero). */
+static void rc_unpin(Binary *bp)
+{
+    if (erts_refc_dectest(&bp->intern.refc, 0) == 0)
+        erts_bin_free(bp);
+}
+
+/* ---- public: registration + trace-callback helpers ------------------------ */
+
+int enif_set_resource_cycle_hooks(ErlNifResourceType *type,
+                                  const ErlNifResourceCycleHooks *hooks)
+{
+    RcType *t;
+    ErlNifResourceCycleHooks *copy;
+    struct opened_resource_type *ort;
+    if (!rc_initialized || !type || !hooks || !hooks->trace
+        || !hooks->clear || !hooks->epoch)
+        return 1;
+    for (ort = opened_rt_list; ort && ort->type != type; ort = ort->next)
+        ;
+    if (!ort || !ort->new_callbacks.dtor)
+        return 1;   /* not in load/upgrade, or no dtor to pin the library */
+    copy = erts_alloc(ERTS_ALC_T_NIF, sizeof(*copy));
+    *copy = *hooks;
+    erts_mtx_lock(&rc_ctl);
+    t = (RcType *) type->rc;
+    if (!t) {
+        Uint i;
+        t = erts_alloc(ERTS_ALC_T_NIF, sizeof(RcType));
+        t->module = type->module;
+        t->name = type->name;
+        t->slot = erts_alloc_permanent_cache_aligned(
+            ERTS_ALC_T_NIF, rc_nshards * sizeof(RcTypeSlot));
+        for (i = 0; i < rc_nshards; i++) {
+            erts_atomic_init_nob(&t->slot[i].live, 0);
+            erts_atomic_init_nob(&t->slot[i].collected, 0);
+        }
+        erts_atomic_init_nob(&t->hooks, (erts_aint_t) copy);
+        t->next = rc_types;
+        rc_types = t;
+        /* schedulers may already allocate this type (takeover): publish t
+         * fully initialised */
+        ERTS_THR_WRITE_MEMORY_BARRIER;
+        type->rc = t;
+    }
+    else {
+        /* Takeover (module upgrade): swap the hooks. The old copy is leaked
+         * on purpose: a round may still be reading it (a few bytes per
+         * upgrade). */
+        erts_atomic_set_relb(&t->hooks, (erts_aint_t) copy);
+    }
+    erts_mtx_unlock(&rc_ctl);
+    rc_ensure_thread();
+    return 0;
+}
+
+/* Like CPython's PyObject_GC_Track: the object is fully constructed, the
+ * collector may now call its hooks. */
+int enif_resource_cycles_track(void *obj)
+{
+    ErtsResource *r;
+    RcLink *l;
+    Uint ix;
+    RcShardData *sh;
+    if (!rc_initialized || !obj)
+        return 1;
+    r = DATA_TO_RESOURCE(obj);
+    if (!(rc_bin(r)->intern.flags & BIN_FLAG_RC_TRACED))
+        return 1;
+    l = rc_link(r);
+    if (erts_atomic32_read_nob(&l->state) & RC_ST_TRACKED)
+        return 0;
+    ix = rc_shard_ix();
+    sh = &rc_shards[ix].d;
+    l->shard = (Uint32) ix;
+    erts_mtx_lock(&sh->lock);
+    rc_list_insert_after(&sh->head, l);
+    erts_mtx_unlock(&sh->lock);
+    erts_atomic_inc_nob(&sh->live);
+    erts_atomic_inc_nob(&l->t->slot[ix].live);
+    erts_atomic32_read_bor_mb(&l->state, RC_ST_TRACKED | RC_ST_CENSUS);
+    return 0;
+}
+
+/* ---- the round -------------------------------------------------------------- */
+
+typedef struct {
+    ErtsResource *r;
+    RcLink *l;
+    Uint64 epoch;
+    Sint internal, outside, parent;
+    Sint refc;                   /* as read for `outside` (incl. our pin) */
+    Uint e0, en;                 /* edges[e0 .. e0+en) */
+    byte opaque, live, traced;
+} RcNode;
+
+typedef struct {
+    RcNode *n;
+    Uint len, cap;
+    Uint *edges;
+    Uint elen, ecap;
+    ErtsResource **ixk;          /* open addressing: resource -> node ix */
+    Uint *ixv;
+    Uint ixsize;
+    Uint budget;
+    int full, overflow;
+    Uint candidates, roots, garbage, opaque;
+} RcRound;
+
+static ERTS_INLINE Uint rc_hash(ErtsResource *r)
+{
+    UWord x = (UWord) r;
+    x ^= x >> 33; x *= (UWord) 0xff51afd7ed558ccdULL; x ^= x >> 33;
+    return (Uint) x;
+}
+
+static Sint rc_ix_get(RcRound *rd, ErtsResource *r)
+{
+    Uint m = rd->ixsize - 1, i = rc_hash(r) & m;
+    while (rd->ixk[i]) {
+        if (rd->ixk[i] == r)
+            return (Sint) rd->ixv[i];
+        i = (i + 1) & m;
+    }
+    return -1;
+}
+
+static void rc_ix_put_raw(RcRound *rd, ErtsResource *r, Uint v)
+{
+    Uint m = rd->ixsize - 1, i = rc_hash(r) & m;
+    while (rd->ixk[i])
+        i = (i + 1) & m;
+    rd->ixk[i] = r;
+    rd->ixv[i] = v;
+}
+
+static void rc_ix_grow(RcRound *rd, Uint want)
+{
+    ErtsResource **ok = rd->ixk;
+    Uint *ov = rd->ixv, os = rd->ixsize, i, size = 64;
+    while (size < 2 * want)
+        size *= 2;
+    rd->ixsize = size;
+    rd->ixk = erts_alloc(ERTS_ALC_T_NIF, size * sizeof(*rd->ixk));
+    rd->ixv = erts_alloc(ERTS_ALC_T_NIF, size * sizeof(*rd->ixv));
+    sys_memzero(rd->ixk, size * sizeof(*rd->ixk));
+    for (i = 0; i < os; i++)
+        if (ok[i])
+            rc_ix_put_raw(rd, ok[i], ov[i]);
+    if (ok) {
+        erts_free(ERTS_ALC_T_NIF, ok);
+        erts_free(ERTS_ALC_T_NIF, ov);
+    }
+}
+
+static void rc_round_init(RcRound *rd, int full)
+{
+    sys_memzero(rd, sizeof(*rd));
+    rd->full = full;
+    rd->budget = full ? ~((Uint) 0)
+                      : (Uint) erts_atomic_read_nob(&rc_budget);
+    rc_ix_grow(rd, 256);
+}
+
+/* Add a PINNED resource. */
+static Uint rc_add(RcRound *rd, ErtsResource *r)
+{
+    RcNode *nd;
+    if (rd->len == rd->cap) {
+        Uint cap = rd->cap ? 2 * rd->cap : 256;
+        RcNode *n = erts_alloc(ERTS_ALC_T_NIF, cap * sizeof(RcNode));
+        if (rd->n) {
+            sys_memcpy(n, rd->n, rd->len * sizeof(RcNode));
+            erts_free(ERTS_ALC_T_NIF, rd->n);
+        }
+        rd->n = n;
+        rd->cap = cap;
+    }
+    if (4 * (rd->len + 1) > 3 * rd->ixsize)
+        rc_ix_grow(rd, rd->len + 1);
+    nd = &rd->n[rd->len];
+    sys_memzero(nd, sizeof(*nd));
+    nd->r = r;
+    nd->l = rc_link(r);
+    nd->parent = -1;
+    rc_ix_put_raw(rd, r, rd->len);
+    return rd->len++;
+}
+
+static void rc_add_edge(RcRound *rd, Uint to)
+{
+    if (rd->elen == rd->ecap) {
+        Uint cap = rd->ecap ? 2 * rd->ecap : 256;
+        Uint *e = erts_alloc(ERTS_ALC_T_NIF, cap * sizeof(Uint));
+        if (rd->edges) {
+            sys_memcpy(e, rd->edges, rd->elen * sizeof(Uint));
+            erts_free(ERTS_ALC_T_NIF, rd->edges);
+        }
+        rd->edges = e;
+        rd->ecap = cap;
+    }
+    rd->edges[rd->elen++] = to;
+}
+
+/* Edge sink handed to a trace callback. */
+struct enif_trace_ctx_t {
+    RcRound *rd;
+    int opaque;
+};
+
+static void rc_ctx_push(ErlNifTraceCtx *ctx, ErtsResource *to)
+{
+    RcRound *rd = ctx->rd;
+    Binary *b = rc_bin(to);
+    Sint ix;
+    if (!(b->intern.flags & BIN_FLAG_RC_TRACED)
+        || !(erts_atomic32_read_nob(&rc_link_of_bin(b)->state)
+             & RC_ST_TRACKED))
+        return;                 /* cannot close a cycle through the round */
+    ix = rc_ix_get(rd, to);
+    if (ix < 0) {
+        if (rd->full)
+            return;             /* tracked after the snapshot: outside */
+        if (rd->len >= rd->budget) {
+            rd->overflow = 1;
+            return;
+        }
+        /* The holder being traced owns a count and is locked by its trace
+         * callback, so `to` is alive: a plain increment is safe. */
+        erts_refc_inc(&b->intern.refc, 2);
+        ix = (Sint) rc_add(rd, to);
+    }
+    rc_add_edge(rd, (Uint) ix);
+}
+
+static ERTS_INLINE ErtsResource *rc_resource_of_bin(Binary *b)
+{
+    if (!(b->intern.flags & BIN_FLAG_MAGIC)
+        || ERTS_MAGIC_BIN_DESTRUCTOR(b) != NIF_RESOURCE_DTOR)
+        return NULL;
+    return (ErtsResource *) ERTS_MAGIC_BIN_UNALIGNED_DATA(b);
+}
+
+static void rc_trace_offheap(ErlNifTraceCtx *ctx, struct erl_off_heap_header *h)
+{
+    union erl_off_heap_ptr u;
+    for (u.hdr = h; u.hdr; u.hdr = u.hdr->next) {
+        ErtsResource *r = NULL;
+        switch (thing_subtag(u.hdr->thing_word)) {
+        case REF_SUBTAG:
+            r = rc_resource_of_bin((Binary *) u.mref->mb);
+            break;
+        case BIN_REF_SUBTAG:   /* enif_make_resource_binary */
+            r = rc_resource_of_bin(u.br->val);
+            break;
+        default:               /* external pids/ports/refs: no resource */
+            break;
+        }
+        if (r)
+            rc_ctx_push(ctx, r);
+    }
+}
+
+void enif_trace_env(ErlNifTraceCtx *ctx, ErlNifEnv *env)
+{
+    struct enif_msg_environment_t *menv = (struct enif_msg_environment_t *) env;
+    ErlHeapFragment *bp;
+    if (!ctx || !env)
+        return;
+    /* Process-independent env: every magic ref / resource binary it holds is
+     * linked on the phony process's off-heap list or on a heap fragment's. */
+    rc_trace_offheap(ctx, MSO(&menv->phony_proc).first);
+    for (bp = MBUF(&menv->phony_proc); bp; bp = bp->next)
+        rc_trace_offheap(ctx, bp->off_heap.first);
+}
+
+void enif_trace_resource(ErlNifTraceCtx *ctx, void *obj)
+{
+    if (ctx && obj)
+        rc_ctx_push(ctx, DATA_TO_RESOURCE(obj));
+}
+
+void enif_trace_opaque(ErlNifTraceCtx *ctx)
+{
+    if (ctx)
+        ctx->opaque = 1;
+}
+
+/* A NIF env for callbacks that runs without a process. */
+static void rc_callback_env(struct enif_msg_environment_t *menv, ErtsResource *r)
+{
+    pre_nif_noproc(menv, r->type->owner, NULL);
+}
+
+/* Free a drained link whose destructor already ran. */
+static void rc_free_dead(RcLink *l)
+{
+    erts_magic_binary_free(rc_bin(l->self));
+}
+
+/* 1. candidates: take every stack; pin the living ones. */
+static void rc_drain(RcRound *rd)
+{
+    Uint s;
+    for (s = 0; s < rc_nshards; s++) {
+        RcShardData *sh = &rc_shards[s].d;
+        RcLink *l;
+        /* reset the count BEFORE taking the stack: a push in between is
+         * drained now and counted again (a spurious wakeup, never a lost
+         * one) */
+        erts_atomic_set_mb(&sh->pending, 0);
+        l = (RcLink *) erts_atomic_xchg_acqb(&sh->stack, 0);
+        while (l) {
+            RcLink *next = l->pnext;
+            Binary *b = rc_bin(l->self);
+            int pinned = erts_refc_inc_unless(&b->intern.refc, 0, 0) != 0;
+            erts_aint32_t old = erts_atomic32_read_band_mb(&l->state,
+                                                           ~RC_ST_BUFFERED);
+            if (!pinned) {
+                if (old & RC_ST_DEAD)
+                    rc_free_dead(l);     /* its destructor left it to us */
+                /* else: dying; its destructor frees it */
+            }
+            else if (rc_ix_get(rd, l->self) >= 0) {
+                rc_unpin(b);             /* already a node */
+            }
+            else {
+                rc_add(rd, l->self);
+                rd->candidates++;
+            }
+            l = next;
+        }
+    }
+}
+
+#define RC_SNAPSHOT_BATCH 256
+
+static ERTS_INLINE void rc_list_unlink(RcLink *l)
+{
+    l->cprev->cnext = l->cnext;
+    l->cnext->cprev = l->cprev;
+}
+
+static ERTS_INLINE void rc_list_insert_after(RcLink *at, RcLink *l)
+{
+    l->cnext = at->cnext;
+    l->cprev = at;
+    at->cnext->cprev = l;
+    at->cnext = l;
+}
+
+/* full round: every tracked object, pinned. The shard lock is dropped every
+ * RC_SNAPSHOT_BATCH objects (a cursor keeps the place), so a full round
+ * never stalls a scheduler's track/destroy for more than a batch. Objects
+ * tracked meanwhile are simply outside this round (edges to them are
+ * ignored: safe). */
+static void rc_snapshot(RcRound *rd)
+{
+    Uint s;
+    for (s = 0; s < rc_nshards; s++) {
+        RcShardData *sh = &rc_shards[s].d;
+        RcLink *l, *cur = &sh->cursor;
+        int more = 1;
+        erts_mtx_lock(&sh->lock);
+        rc_list_insert_after(&sh->head, cur);
+        while (more) {
+            Uint k = 0;
+            for (l = cur->cnext; l != &sh->head && k < RC_SNAPSHOT_BATCH;
+                 l = l->cnext, k++) {
+                Binary *b;
+                if (!l->self)
+                    continue;
+                b = rc_bin(l->self);
+                if (rc_ix_get(rd, l->self) >= 0)
+                    continue;
+                if (erts_refc_inc_unless(&b->intern.refc, 0, 0) == 0)
+                    continue;            /* dying: never resurrect */
+                rc_add(rd, l->self);
+            }
+            rc_list_unlink(cur);
+            more = l != &sh->head;
+            if (more) {
+                rc_list_insert_after(l->cprev, cur);
+                erts_mtx_unlock(&sh->lock);
+                erts_mtx_lock(&sh->lock);
+            }
+        }
+        erts_mtx_unlock(&sh->lock);
+    }
+}
+
+/* 2-4. expand/trace, outside counts, mark. */
+static void rc_analyse(RcRound *rd)
+{
+    Uint i, j, head = 0, tail = 0, *queue;
+
+    for (i = 0; i < rd->len; i++) {      /* rd->len grows while we go */
+        RcNode *nd = &rd->n[i];
+        const ErlNifResourceCycleHooks *h;
+        struct enif_msg_environment_t menv;
+        ErlNifTraceCtx ctx;
+        Uint64 e;
+        if (!(erts_atomic32_read_nob(&nd->l->state) & RC_ST_TRACKED)) {
+            nd->opaque = 1;
+            continue;
+        }
+        if (!rd->full && i >= rd->budget) {
+            nd->opaque = 1;              /* past the budget: not traced, */
+            rd->overflow = 1;            /* so a root; retried next round */
+            rc_record(rc_bin(nd->r));
+            continue;
+        }
+        h = rc_hooks(nd->l->t);
+        ctx.rd = rd;
+        ctx.opaque = 0;
+        rc_callback_env(&menv, nd->r);
+        e = h->epoch(nd->r->data);
+        rd->n[i].e0 = rd->elen;
+        h->trace(&menv.env, nd->r->data, &ctx);
+        post_nif_noproc(&menv);
+        nd = &rd->n[i];                  /* rd->n may have moved */
+        nd->epoch = e;
+        nd->traced = 1;
+        nd->opaque = (byte) ctx.opaque;
+        nd->en = rd->elen - nd->e0;
+    }
+    for (i = 0; i < rd->elen; i++)
+        rd->n[rd->edges[i]].internal++;
+
+    queue = erts_alloc(ERTS_ALC_T_NIF, (rd->len + 1) * sizeof(Uint));
+    for (i = 0; i < rd->len; i++) {
+        RcNode *nd = &rd->n[i];
+        Sint refc = (Sint) erts_refc_read(&rc_bin(nd->r)->intern.refc, 1);
+        nd->refc = refc;
+        nd->outside = refc - 1 - nd->internal;
+        if (nd->outside > 0 || nd->opaque) {
+            nd->live = 1;
+            queue[tail++] = i;
+            rd->roots++;
+            rd->opaque += nd->opaque;
+        }
+    }
+    while (head < tail) {
+        Uint self = queue[head++];
+        RcNode *nd = &rd->n[self];
+        for (j = 0; j < nd->en; j++) {
+            Uint to = rd->edges[nd->e0 + j];
+            if (!rd->n[to].live) {
+                rd->n[to].live = 1;
+                rd->n[to].parent = (Sint) self;
+                queue[tail++] = to;
+            }
+        }
+    }
+    erts_free(ERTS_ALC_T_NIF, queue);
+    rd->garbage = rd->len - tail;
+}
+
+/* 5-6. validate and break. Returns the number of objects cleared. */
+static Uint rc_break(RcRound *rd, Uint *aborted)
+{
+    Uint i, cleared = 0;
+    *aborted = 0;
+    if (!rd->garbage)
+        return 0;
+    for (i = 0; i < rd->len; i++) {      /* A: still no outside holder */
+        RcNode *nd = &rd->n[i];
+        if (!nd->live
+            && (Sint) erts_refc_read(&rc_bin(nd->r)->intern.refc, 1)
+               - 1 - nd->internal != 0)
+            goto reject;
+    }
+    for (i = 0; i < rd->len; i++) {      /* B: nobody looked -- after A */
+        RcNode *nd = &rd->n[i];
+        if (!nd->live && rc_hooks(nd->l->t)->epoch(nd->r->data) != nd->epoch)
+            goto reject;
+    }
+    for (i = 0; i < rd->len; i++)
+        if (!rd->n[i].live)
+            erts_atomic32_read_bor_mb(&rd->n[i].l->state, RC_ST_DOOMED);
+    for (i = 0; i < rd->len; i++) {
+        RcNode *nd = &rd->n[i];
+        struct enif_msg_environment_t menv;
+        if (nd->live)
+            continue;
+        rc_callback_env(&menv, nd->r);
+        rc_hooks(nd->l->t)->clear(&menv.env, nd->r->data);
+        post_nif_noproc(&menv);
+        erts_atomic_inc_nob(&nd->l->t->slot[nd->l->shard].collected);
+        cleared++;
+    }
+    return cleared;
+reject:
+    /* A racing reader or writer touched the candidate set: clear nothing,
+     * and record G again so the next round retries (we hold pins). */
+    for (i = 0; i < rd->len; i++)
+        if (!rd->n[i].live) {
+            rc_record(rc_bin(rd->n[i].r));
+            (*aborted)++;
+        }
+    return 0;
+}
+
+static void rc_round_free(RcRound *rd)
+{
+    Uint i;
+    /* Clearing is over: a doomed object revived meanwhile (binary_to_term of
+     * an old encoding) must be recordable again. We still hold the pins. */
+    for (i = 0; i < rd->len; i++)
+        erts_atomic32_read_band_mb(&rd->n[i].l->state, ~RC_ST_DOOMED);
+    /* A release that raced the drain (it saw the node still on a stack and
+     * skipped recording) may have landed after `outside` was read: the round
+     * saw a holder that is gone. Once every such release has finished
+     * (rc_quiesce), any count below what the round saw marks such a node;
+     * record it again (we still hold its pin). */
+    rc_quiesce();
+    for (i = 0; i < rd->len; i++) {
+        RcNode *nd = &rd->n[i];
+        if (nd->live && nd->refc
+            && (Sint) erts_refc_read(&rc_bin(nd->r)->intern.refc, 1) < nd->refc)
+            rc_record(rc_bin(nd->r));
+    }
+    for (i = 0; i < rd->len; i++)
+        rc_unpin(rc_bin(rd->n[i].r));    /* doomed ones die here */
+    if (rd->n) erts_free(ERTS_ALC_T_NIF, rd->n);
+    if (rd->edges) erts_free(ERTS_ALC_T_NIF, rd->edges);
+    erts_free(ERTS_ALC_T_NIF, rd->ixk);
+    erts_free(ERTS_ALC_T_NIF, rd->ixv);
+}
+
+/* ---- terms ---------------------------------------------------------------- */
+
+static Eterm rc_map(ErlNifEnv *env, int n, const char **keys, Eterm *vals)
+{
+    ERL_NIF_TERM m = enif_make_new_map(env);
+    int i;
+    for (i = 0; i < n; i++)
+        enif_make_map_put(env, m, enif_make_atom(env, keys[i]), vals[i], &m);
+    return m;
+}
+
+#define RC_U(env, x) enif_make_uint64((env), (ErlNifUInt64) (x))
+#define RC_A(x) erts_atomic_read_nob(&(x))
+
+static Eterm rc_stats_term(ErlNifEnv *env, const RcStats *s)
+{
+    const char *k[] = {"round", "kind", "candidates", "nodes", "roots",
+                       "garbage", "collected", "aborted", "opaque",
+                       "overflow", "usec"};
+    Eterm v[11];
+    v[0] = RC_U(env, s->round);
+    v[1] = enif_make_atom(env, s->full ? "full" : "partial");
+    v[2] = RC_U(env, s->candidates);
+    v[3] = RC_U(env, s->nodes);
+    v[4] = RC_U(env, s->roots);
+    v[5] = RC_U(env, s->garbage);
+    v[6] = RC_U(env, s->collected);
+    v[7] = RC_U(env, s->aborted);
+    v[8] = RC_U(env, s->opaque);
+    v[9] = s->overflow ? am_true : am_false;
+    v[10] = RC_U(env, s->usec);
+    return rc_map(env, 11, k, v);
+}
+
+static Eterm rc_graph_term(ErlNifEnv *env, RcRound *rd)
+{
+    Uint i, j;
+    ERL_NIF_TERM nodes = enif_make_list(env, 0), edges = enif_make_list(env, 0),
+                 parents = enif_make_list(env, 0);
+    const char *nk[] = {"resource", "address", "type", "refc", "internal",
+                        "outside", "epoch", "verdict", "traced"};
+    const char *gk[] = {"nodes", "edges", "parent", "kind"};
+    Eterm gv[4];
+    for (i = rd->len; i-- > 0;) {
+        RcNode *nd = &rd->n[i];
+        Eterm v[9];
+        v[0] = enif_make_resource(env, nd->r->data);
+        v[1] = RC_U(env, (UWord) rc_bin(nd->r));
+        v[2] = enif_make_tuple2(env, nd->l->t->module, nd->l->t->name);
+        v[3] = enif_make_int64(env, (ErlNifSInt64)
+                   erts_refc_read(&rc_bin(nd->r)->intern.refc, 1) - 1);
+        v[4] = enif_make_int64(env, (ErlNifSInt64) nd->internal);
+        v[5] = enif_make_int64(env, (ErlNifSInt64) nd->outside);
+        v[6] = RC_U(env, nd->epoch);
+        v[7] = enif_make_atom(env, !nd->live ? "garbage"
+                                  : nd->parent < 0 ? "root" : "live");
+        v[8] = nd->traced ? am_true : am_false;
+        nodes = enif_make_list_cell(env, rc_map(env, 9, nk, v), nodes);
+        parents = enif_make_list_cell(env, enif_make_int64(env, nd->parent),
+                                      parents);
+        for (j = nd->en; j-- > 0;)
+            edges = enif_make_list_cell(
+                env, enif_make_tuple2(env, RC_U(env, i),
+                                      RC_U(env, rd->edges[nd->e0 + j])),
+                edges);
+    }
+    gv[0] = nodes; gv[1] = edges; gv[2] = parents;
+    gv[3] = enif_make_atom(env, "full");
+    return rc_map(env, 4, gk, gv);
+}
+
+static Eterm rc_info_term(ErlNifEnv *env)
+{
+    const char *k[] = {"enabled", "auto", "rounds", "full_rounds",
+                       "collected", "aborted", "overflows", "candidates",
+                       "scanned", "live", "pending", "threshold",
+                       "interval_ms", "budget", "shards", "last", "types"};
+    Eterm v[17];
+    ERL_NIF_TERM types = enif_make_list(env, 0);
+    RcType *t;
+    Uint live = 0, pending = 0, s;
+    RcStats last;
+
+    for (s = 0; s < rc_nshards; s++) {
+        live += RC_A(rc_shards[s].d.live);
+        pending += RC_A(rc_shards[s].d.pending);
+    }
+    erts_mtx_lock(&rc_ctl);
+    last = rc_last;
+    for (t = rc_types; t; t = t->next) {
+        const char *tk[] = {"module", "name", "live", "collected"};
+        Eterm tv[4];
+        Sint tl = 0, tc = 0;
+        for (s = 0; s < rc_nshards; s++) {
+            tl += RC_A(t->slot[s].live);
+            tc += RC_A(t->slot[s].collected);
+        }
+        tv[0] = t->module;
+        tv[1] = t->name;
+        tv[2] = enif_make_int64(env, tl);
+        tv[3] = enif_make_int64(env, tc);
+        types = enif_make_list_cell(env, rc_map(env, 4, tk, tv), types);
+    }
+    erts_mtx_unlock(&rc_ctl);
+
+    v[0] = rc_types ? am_true : am_false;   /* some type is traced */
+    v[1] = RC_A(rc_auto) ? am_true : am_false;
+    v[2] = RC_U(env, RC_A(rc_rounds));
+    v[3] = RC_U(env, RC_A(rc_full_rounds));
+    v[4] = RC_U(env, RC_A(rc_collected));
+    v[5] = RC_U(env, RC_A(rc_aborted));
+    v[6] = RC_U(env, RC_A(rc_overflows));
+    v[7] = RC_U(env, RC_A(rc_candidates_total));
+    v[8] = RC_U(env, RC_A(rc_scanned_total));
+    v[9] = RC_U(env, live);
+    v[10] = RC_U(env, pending);
+    v[11] = RC_U(env, RC_A(rc_threshold));
+    v[12] = RC_U(env, RC_A(rc_interval));
+    v[13] = RC_U(env, RC_A(rc_budget));
+    v[14] = RC_U(env, rc_nshards);
+    v[15] = rc_stats_term(env, &last);
+    v[16] = types;
+    return rc_map(env, 17, k, v);
+}
+
+static void rc_send(const ErlNifPid *to, ErlNifEnv *env, Eterm msg)
+{
+    enif_send(NULL, to, env, msg);   /* unmanaged thread: caller env NULL */
+}
+
+/* ---- the collector thread ------------------------------------------------- */
+
+static erts_tid_t rc_tid;
+
+static Uint rc_live_total(void)
+{
+    Uint s, live = 0;
+    for (s = 0; s < rc_nshards; s++)
+        live += RC_A(rc_shards[s].d.live);
+    return live;
+}
+
+static void rc_run_round(int full, RcStats *out)
+{
+    RcRound rd;
+    Uint cleared, aborted;
+    ErtsMonotonicTime t0 = erts_get_monotonic_time(NULL);
+
+    rc_round_init(&rd, full);
+    rc_drain(&rd);
+    if (full)
+        rc_snapshot(&rd);
+    rc_analyse(&rd);
+    cleared = rc_break(&rd, &aborted);
+
+    out->round = (Uint) erts_atomic_inc_read_nob(&rc_rounds);
+    out->full = full;
+    out->candidates = rd.candidates;
+    out->nodes = rd.len;
+    out->roots = rd.roots;
+    out->garbage = rd.garbage;
+    out->collected = cleared;
+    out->aborted = aborted;
+    out->opaque = rd.opaque;
+    out->overflow = rd.overflow;
+    rc_round_free(&rd);                  /* unpin AFTER clear: dtors now */
+    out->usec = (Uint) ERTS_MONOTONIC_TO_USEC(erts_get_monotonic_time(NULL) - t0);
+
+    erts_atomic_add_nob(&rc_collected, (erts_aint_t) cleared);
+    erts_atomic_add_nob(&rc_aborted, (erts_aint_t) aborted);
+    erts_atomic_add_nob(&rc_candidates_total, (erts_aint_t) rd.candidates);
+    erts_atomic_add_nob(&rc_scanned_total, (erts_aint_t) rd.len);
+    if (full) {
+        erts_atomic_inc_nob(&rc_full_rounds);
+        erts_atomic_set_nob(&rc_since_full, 0);
+        erts_atomic_set_nob(&rc_need_full, 0);
+    }
+    else {
+        erts_atomic_add_nob(&rc_since_full, (erts_aint_t) rd.candidates);
+        if (rd.overflow) {
+            erts_atomic_inc_nob(&rc_overflows);
+            erts_atomic_set_nob(&rc_need_full, 1);
+        }
+    }
+}
+
+static void rc_publish(const RcStats *s, RcReq *served)
+{
+    ErlNifPid subs[RC_MAX_SUBSCRIBERS];
+    int n, i;
+    erts_mtx_lock(&rc_ctl);
+    rc_last = *s;
+    n = rc_nsubs;
+    for (i = 0; i < n; i++)
+        subs[i] = rc_subs[i];
+    erts_mtx_unlock(&rc_ctl);
+    for (i = 0; i < n; i++) {
+        ErlNifEnv *env = enif_alloc_env();
+        rc_send(&subs[i], env,
+                enif_make_tuple3(env, enif_make_atom(env, "resource_cycles"),
+                                 enif_make_atom(env, "round"),
+                                 rc_stats_term(env, s)));
+        enif_free_env(env);
+    }
+    for (; served; served = served->next)
+        rc_send(&served->to, served->env,
+                enif_make_tuple4(served->env,
+                                 enif_make_atom(served->env, "resource_cycles"),
+                                 served->ref,
+                                 enif_make_atom(served->env, "collected"),
+                                 rc_stats_term(served->env, s)));
+}
+
+static void rc_req_free(RcReq *q)
+{
+    while (q) {
+        RcReq *next = q->next;
+        enif_free_env(q->env);
+        erts_free(ERTS_ALC_T_NIF, q);
+        q = next;
+    }
+}
+
+static void rc_serve_graph(RcReq *q)
+{
+    RcRound rd;
+    rc_round_init(&rd, 1);               /* candidates stay on their stacks */
+    rc_snapshot(&rd);
+    rc_analyse(&rd);                     /* dry: nothing is cleared */
+    rc_send(&q->to, q->env,
+            enif_make_tuple4(q->env, enif_make_atom(q->env, "resource_cycles"),
+                             q->ref, enif_make_atom(q->env, "graph"),
+                             rc_graph_term(q->env, &rd)));
+    rc_round_free(&rd);
+}
+
+static Uint rc_pending_total(void)
+{
+    Uint s, p = 0;
+    for (s = 0; s < rc_nshards; s++)
+        p += RC_A(rc_shards[s].d.pending);
+    return p;
+}
+
+static RcReq *rc_take_reqs(void)
+{
+    RcReq *reqs;
+    erts_mtx_lock(&rc_ctl);
+    reqs = rc_reqs;
+    rc_reqs = NULL;
+    erts_mtx_unlock(&rc_ctl);
+    return reqs;
+}
+
+/*
+ * Sleeps with no timeout while nothing is pending (an idle node pays
+ * nothing). The first candidate wakes it; it then batches for `interval`
+ * ms, unless a shard reaches `threshold` or a request arrives first.
+ * Everything that sets rc_event does so AFTER publishing its work, and the
+ * loop resets the event BEFORE looking, so no wakeup is lost.
+ */
+static void *rc_thread_main(void *unused)
+{
+    int batched = 0;
+    (void) unused;
+    ethr_event_prepare_timed(&rc_event);
+    for (;;) {
+        RcReq *reqs, *q, *collect = NULL, *graph = NULL;
+        int want_full = 0, autorun, need_full, full;
+        Uint pending;
+        RcStats st;
+
+        ethr_event_reset(&rc_event);
+        reqs = rc_take_reqs();
+        pending = rc_pending_total();
+        autorun = (int) erts_atomic_read_nob(&rc_auto);
+        need_full = (int) erts_atomic_read_nob(&rc_need_full);
+        if (!reqs) {
+            if (!autorun || (!pending && !need_full)) {
+                ethr_event_wait(&rc_event);
+                continue;
+            }
+            if (!batched && pending
+                && pending < (Uint) erts_atomic_read_nob(&rc_threshold)) {
+                batched = 1;
+                ethr_event_twait(&rc_event,
+                                 (ethr_sint64_t)
+                                 erts_atomic_read_nob(&rc_interval)
+                                 * 1000 * 1000);
+                continue;
+            }
+        }
+        batched = 0;
+
+        while (reqs) {
+            q = reqs;
+            reqs = reqs->next;
+            if (q->kind == RC_REQ_GRAPH) { q->next = graph; graph = q; }
+            else {
+                want_full |= q->kind == RC_REQ_FULL;
+                q->next = collect; collect = q;
+            }
+        }
+        for (q = graph; q; q = q->next)
+            rc_serve_graph(q);
+        rc_req_free(graph);
+        if (!collect && !pending && !need_full)
+            continue;
+
+        /* A full round is O(live): run one only when asked, when idle, or
+         * once the candidates that passed since the last one paid for it. */
+        full = want_full
+            || (need_full
+                && (!pending
+                    || (Uint) erts_atomic_read_nob(&rc_since_full)
+                       >= rc_live_total()));
+        rc_run_round(full, &st);
+        if (!full && st.overflow && collect) {
+            rc_publish(&st, NULL);       /* explicit request: be complete */
+            rc_run_round(1, &st);
+        }
+        rc_publish(&st, collect);
+        rc_req_free(collect);
+    }
+    return NULL;
+}
+
+static void rc_ensure_thread(void)
+{
+    /* Started lazily, from the first set_resource_cycle_hooks, so a node that
+     * never traces pays nothing. */
+    int start;
+    erts_mtx_lock(&rc_ctl);
+    start = !rc_thread_started;
+    rc_thread_started = 1;
+    erts_mtx_unlock(&rc_ctl);
+    if (start) {
+        erts_thr_opts_t opts = ERTS_THR_OPTS_DEFAULT_INITER;
+        opts.detached = 1;
+        opts.name = "resource_cycles";
+        erts_thr_create(&rc_tid, rc_thread_main, NULL, &opts);
+    }
+}
+
+/* ---- Erlang surface: system_info / system_flag ---------------------------- */
+
+ERL_NIF_TERM erts_resource_cycles_info_term(Process *c_p);
+Eterm erts_resource_cycles_flag(Process *c_p, Eterm arg);
+
+static Eterm rc_copy_out(Process *c_p, ErlNifEnv *env, Eterm t)
+{
+    Uint sz = size_object(t);
+    Eterm *hp = HAlloc(c_p, sz);
+    Eterm res = copy_struct(t, sz, &hp, &MSO(c_p));
+    enif_free_env(env);
+    return res;
+}
+
+/* erlang:system_info(resource_cycles) */
+ERL_NIF_TERM erts_resource_cycles_info_term(Process *c_p)
+{
+    ErlNifEnv *env = enif_alloc_env();
+    return rc_copy_out(c_p, env, rc_info_term(env));
+}
+
+static Eterm rc_request(Process *c_p, RcReqKind kind, Eterm pid)
+{
+    RcReq *q;
+    Eterm ref;
+    if (!is_internal_pid(pid))
+        return THE_NON_VALUE;
+    rc_ensure_thread();                  /* an explicit ask always answers */
+    q = erts_alloc(ERTS_ALC_T_NIF, sizeof(RcReq));
+    q->kind = kind;
+    q->to.pid = pid;
+    q->env = enif_alloc_env();
+    ref = erts_make_ref(c_p);
+    q->ref = enif_make_copy(q->env, ref);
+    erts_mtx_lock(&rc_ctl);
+    q->next = rc_reqs;
+    rc_reqs = q;
+    erts_mtx_unlock(&rc_ctl);
+    ethr_event_set(&rc_event);
+    return ref;
+}
+
+static Eterm rc_subscribe(Eterm pid, int on)
+{
+    int i;
+    if (!is_internal_pid(pid))
+        return THE_NON_VALUE;
+    erts_mtx_lock(&rc_ctl);
+    for (i = 0; i < rc_nsubs && rc_subs[i].pid != pid; i++)
+        ;
+    if (on && i == rc_nsubs && rc_nsubs < RC_MAX_SUBSCRIBERS)
+        rc_subs[rc_nsubs++].pid = pid;
+    else if (!on && i < rc_nsubs)
+        rc_subs[i] = rc_subs[--rc_nsubs];
+    erts_mtx_unlock(&rc_ctl);
+    return am_ok;
+}
+
+static Eterm rc_set_uint(Process *c_p, erts_atomic_t *var, Eterm val, Uint min)
+{
+    Uint new;
+    erts_aint_t old;
+    if (!term_to_Uint(val, &new) || new < min)
+        return THE_NON_VALUE;
+    old = erts_atomic_xchg_nob(var, (erts_aint_t) new);
+    ethr_event_set(&rc_event);
+    return erts_make_integer((Uint) old, c_p);
+}
+
+/*
+ * erlang:system_flag(resource_cycles, Op):
+ *   {collect, Pid} | {collect, Pid, full} -> Ref
+ *        a round that starts after this call; then
+ *        Pid ! {resource_cycles, Ref, collected, RoundMap}
+ *   {graph, Pid} -> Ref
+ *        a dry full round (nothing cleared); then
+ *        Pid ! {resource_cycles, Ref, graph, GraphMap}
+ *   {subscribe, Pid} | {unsubscribe, Pid} -> ok
+ *        after every round: Pid ! {resource_cycles, round, RoundMap}
+ *   {auto, Bool} -> Old          automatic rounds on/off
+ *   {threshold, N} | {interval, Ms} | {budget, N} -> Old
+ */
+Eterm erts_resource_cycles_flag(Process *c_p, Eterm arg)
+{
+    Eterm *tp, tag;
+    Uint arity;
+    if (!is_tuple(arg))
+        return THE_NON_VALUE;
+    tp = tuple_val(arg);
+    arity = arityval(*tp);
+    if (arity < 2)
+        return THE_NON_VALUE;
+    tag = tp[1];
+    if (ERTS_IS_ATOM_STR("collect", tag)) {
+        if (arity == 2)
+            return rc_request(c_p, RC_REQ_COLLECT, tp[2]);
+        if (arity == 3 && ERTS_IS_ATOM_STR("full", tp[3]))
+            return rc_request(c_p, RC_REQ_FULL, tp[2]);
+        return THE_NON_VALUE;
+    }
+    if (arity != 2)
+        return THE_NON_VALUE;
+    if (ERTS_IS_ATOM_STR("graph", tag))
+        return rc_request(c_p, RC_REQ_GRAPH, tp[2]);
+    if (ERTS_IS_ATOM_STR("subscribe", tag))
+        return rc_subscribe(tp[2], 1);
+    if (ERTS_IS_ATOM_STR("unsubscribe", tag))
+        return rc_subscribe(tp[2], 0);
+    if (ERTS_IS_ATOM_STR("auto", tag)) {
+        erts_aint_t old;
+        if (tp[2] != am_true && tp[2] != am_false)
+            return THE_NON_VALUE;
+        old = erts_atomic_xchg_nob(&rc_auto, tp[2] == am_true);
+        ethr_event_set(&rc_event);
+        return old ? am_true : am_false;
+    }
+    if (ERTS_IS_ATOM_STR("threshold", tag))
+        return rc_set_uint(c_p, &rc_threshold, tp[2], 1);
+    if (ERTS_IS_ATOM_STR("interval", tag))
+        return rc_set_uint(c_p, &rc_interval, tp[2], 1);
+    if (ERTS_IS_ATOM_STR("budget", tag))
+        return rc_set_uint(c_p, &rc_budget, tp[2], 1);
+    return THE_NON_VALUE;
+}
+
+/* ---- init ----------------------------------------------------------------- */
+
+static void erts_nif_rcycles_init(void)
+{
+    Uint s;
+    rc_nshards = 1 + erts_no_schedulers + erts_no_dirty_cpu_schedulers
+        + erts_no_dirty_io_schedulers;
+    rc_shards = erts_alloc_permanent_cache_aligned(ERTS_ALC_T_NIF,
+                                                   rc_nshards * sizeof(RcShard));
+    for (s = 0; s < rc_nshards; s++) {
+        RcShardData *sh = &rc_shards[s].d;
+        erts_mtx_init(&sh->lock, "resource_cycles_census", make_small(s),
+                      ERTS_LOCK_FLAGS_PROPERTY_STATIC
+                      | ERTS_LOCK_FLAGS_CATEGORY_GENERIC);
+        sh->head.cnext = sh->head.cprev = &sh->head;
+        sh->head.self = sh->cursor.self = NULL;
+        erts_atomic_init_nob(&sh->live, 0);
+        erts_atomic_init_nob(&sh->stack, 0);
+        erts_atomic_init_nob(&sh->pending, 0);
+        erts_atomic_init_nob(&sh->inflight, 0);
+    }
+    erts_mtx_init(&rc_ctl, "resource_cycles", NIL,
+                  ERTS_LOCK_FLAGS_PROPERTY_STATIC
+                  | ERTS_LOCK_FLAGS_CATEGORY_GENERIC);
+    if (ethr_event_init(&rc_event) != 0)
+        erts_exit(ERTS_ABORT_EXIT, "resource_cycles: event init failed\n");
+    rc_types = NULL;
+    rc_reqs = NULL;
+    rc_nsubs = 0;
+    rc_thread_started = 0;
+    sys_memzero(&rc_last, sizeof(rc_last));
+    erts_atomic_init_nob(&rc_threshold, RC_DEFAULT_THRESHOLD);
+    erts_atomic_init_nob(&rc_interval, RC_DEFAULT_INTERVAL_MS);
+    erts_atomic_init_nob(&rc_budget, RC_DEFAULT_BUDGET);
+    erts_atomic_init_nob(&rc_auto, 1);
+    erts_atomic_init_nob(&rc_rounds, 0);
+    erts_atomic_init_nob(&rc_full_rounds, 0);
+    erts_atomic_init_nob(&rc_collected, 0);
+    erts_atomic_init_nob(&rc_aborted, 0);
+    erts_atomic_init_nob(&rc_overflows, 0);
+    erts_atomic_init_nob(&rc_candidates_total, 0);
+    erts_atomic_init_nob(&rc_scanned_total, 0);
+    erts_atomic_init_nob(&rc_since_full, 0);
+    erts_atomic_init_nob(&rc_need_full, 0);
+    rc_initialized = 1;
+}
diff --git a/erts/emulator/beam/erl_nif_trace.h b/erts/emulator/beam/erl_nif_trace.h
new file mode 100644
index 0000000..a49683b
--- /dev/null
+++ b/erts/emulator/beam/erl_nif_trace.h
@@ -0,0 +1,116 @@
+/*
+ * erl_nif_trace.h -- resource cycle collection for NIF resources (PROTOTYPE).
+ *
+ * Not part of OTP. A proposal carried by beam-lisp's research tree
+ * (research/erts-internals/). Mirrors CPython's tp_traverse / tp_clear.
+ *
+ * WHY. ERTS reference counts NIF resources. A resource that stores terms
+ * (an atom cell, a memo cell, a lazy node) can hold a reference to itself,
+ * directly or through other resources. Such a cycle never reaches refcount
+ * zero, and the per-process garbage collector can never see it: a garbage
+ * cycle is, by definition, referenced from NO process heap.
+ *
+ * HOW. A resource type registers three hooks. Every release that leaves a
+ * traced object's count above zero records it as a possible cycle root
+ * (Bacon & Rajan). A round examines only those candidates and what they
+ * reach: it counts the references each receives from OTHER traced resources
+ * ("internal") and treats refcount - internal > 0 as a root. Everything a
+ * root reaches is live; the rest is a garbage cycle, which ERTS breaks by
+ * calling `clear` on each member. Mutators are never stopped; `epoch` makes
+ * the concurrent round sound. Untraced resource types pay nothing.
+ *
+ * THE CONTRACT a traced type must honour:
+ *   trace(env, obj, ctx)  report EVERY count obj holds on a resource:
+ *                         enif_trace_env()      for each process-independent
+ *                                               env it owns (enif_alloc_env).
+ *                                               ERTS reads the env's off-heap
+ *                                               list -- exactly the counts the
+ *                                               env holds, found wherever they
+ *                                               sit (tuples, maps, fun
+ *                                               closures, resource binaries,
+ *                                               garbage terms still in the env)
+ *                                               at O(#refs), not O(term size).
+ *                         enif_trace_resource() for each counted native handle
+ *                                               (enif_keep_resource'd pointer).
+ *                         enif_trace_opaque()   when it cannot enumerate: the
+ *                                               object then counts as a root.
+ *                         Hold the object's own lock while tracing.
+ *   clear(env, obj)       drop every reference reported by trace. Called only
+ *                         on members of a validated garbage cycle. The object
+ *                         is later destroyed by its ordinary destructor.
+ *   epoch(obj)            a counter the object bumps on EVERY mutation and on
+ *                         EVERY read that hands a held term to a caller. Must
+ *                         be lock-free. Unchanged epoch == "nobody looked".
+ *
+ * Every function below is exported by a patched beam.smp only. A NIF that
+ * wants to run on stock ERTS as well resolves them with dlsym(RTLD_DEFAULT,
+ * ...) and degrades when they are absent.
+ */
+#ifndef ERL_NIF_TRACE_H__
+#define ERL_NIF_TRACE_H__
+
+#include "erl_nif.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define ERL_NIF_RCYCLES_VSN 2
+
+typedef struct enif_trace_ctx_t ErlNifTraceCtx;
+
+typedef void ErlNifResourceTrace(ErlNifEnv* env, void* obj, ErlNifTraceCtx* ctx);
+typedef void ErlNifResourceClear(ErlNifEnv* env, void* obj);
+typedef unsigned long long ErlNifResourceEpoch(void* obj);
+
+typedef struct {
+    ErlNifResourceTrace* trace;
+    ErlNifResourceClear* clear;
+    ErlNifResourceEpoch* epoch;
+} ErlNifResourceCycleHooks;
+
+/* Register hooks for a resource type. Call from the load/upgrade callback,
+ * right after opening the type (ERL_NIF_RT_CREATE or _TAKEOVER); the type
+ * must have a destructor. Only objects allocated after this call are
+ * traced (they carry the collector's link). Returns 0 on success. */
+typedef int  ErlNifSetResourceCycleHooksFn(ErlNifResourceType* type,
+                                           const ErlNifResourceCycleHooks* hooks);
+/* Enter a fully constructed object into the collector's registry (like
+ * PyObject_GC_Track). Returns 0 if its type has hooks. */
+typedef int  ErlNifResourceCyclesTrackFn(void* obj);
+/* Inside a trace callback. */
+typedef void ErlNifTraceEnvFn(ErlNifTraceCtx* ctx, ErlNifEnv* owned_env);
+typedef void ErlNifTraceResourceFn(ErlNifTraceCtx* ctx, void* obj);
+typedef void ErlNifTraceOpaqueFn(ErlNifTraceCtx* ctx);
+
+/* ---- observability: no NIF entry points ---------------------------------
+ *
+ * Everything is surfaced through the emulator itself, so Erlang, Elixir and
+ * beam-lisp code can observe and steer the collector without any NIF:
+ *
+ *   erlang:system_info(resource_cycles) -> #{enabled, auto, rounds,
+ *       full_rounds, collected, aborted, overflows, candidates, scanned,
+ *       live, pending, threshold, interval_ms, budget, shards, last, types}
+ *   erlang:system_flag(resource_cycles, Op), Op ::
+ *       {collect, Pid} | {collect, Pid, full}  -> Ref
+ *            Pid ! {resource_cycles, Ref, collected, RoundMap}
+ *       {graph, Pid}                           -> Ref
+ *            Pid ! {resource_cycles, Ref, graph, #{nodes, edges, parent}}
+ *       {subscribe, Pid} | {unsubscribe, Pid}  -> ok
+ *            Pid ! {resource_cycles, round, RoundMap}   after every round
+ *       {auto, Bool} | {threshold, N} | {interval, Ms} | {budget, N} -> Old
+ * ------------------------------------------------------------------------ */
+
+#ifdef ERL_NIF_TRACE_DECLARE_EXPORTS
+ERL_NAPI_EXPORT extern ErlNifSetResourceCycleHooksFn enif_set_resource_cycle_hooks;
+ERL_NAPI_EXPORT extern ErlNifResourceCyclesTrackFn   enif_resource_cycles_track;
+ERL_NAPI_EXPORT extern ErlNifTraceEnvFn              enif_trace_env;
+ERL_NAPI_EXPORT extern ErlNifTraceResourceFn         enif_trace_resource;
+ERL_NAPI_EXPORT extern ErlNifTraceOpaqueFn           enif_trace_opaque;
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ERL_NIF_TRACE_H__ */
