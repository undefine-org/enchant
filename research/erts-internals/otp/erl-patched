#!/bin/sh
# Run the locally patched beam.smp with the SYSTEM OTP libraries.
#
# Only the emulator is rebuilt (see build.sh); OTP's .beam libraries are
# version-matched to it (29.0.1 / erts 17.0.1), so they are used as installed.
# BINDIR must also hold erlexec/epmd/heart/inet_gethost: build.sh symlinks
# the system's copies next to the patched beam.smp.
ROOTDIR=${ERTS_ROOTDIR:-/usr/lib/erlang}
BINDIR=${ERTS_TRACE_BINDIR:-$HOME/.cache/bl/otp/otp-OTP-29.0.1/bin/x86_64-pc-linux-gnu}
EMU=beam
PROGNAME=erl
export EMU ROOTDIR BINDIR PROGNAME
exec "$BINDIR/erlexec" "$@"
